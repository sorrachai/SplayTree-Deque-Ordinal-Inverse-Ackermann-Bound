            have h2 : (2 * (2 * q) + 1) * D * (D * 2 ^ (2 * q)) = (4 * q + 1) * D * (D * M) := by
              dsimp (config := { failIfUnchanged := false }) only [M]
              ring
            omega
          have hc := h_step_comb 2 M S (4 * (D + 2) * (j0 + 1) * S) ((4 * q + 1) * D * (D * M))
            (by omega) hM1 hSD h_blk h_glb u seq hu_MS hv
          have h_glb_le : (4 * q + 1) * D * (D * M) ≤ 2 * D * (M * S) := by
            have h4q : 4 * q + 1 ≤ 8 * q := by omega
            have h1 : (4 * q + 1) * (D * D * M) ≤ (8 * q) * (D * D * M) :=
              Nat.mul_le_mul_right _ h4q
            have h2 : (4 * q + 1) * D * (D * M) = (4 * q + 1) * (D * D * M) := by ring
            have h3 : (8 * q) * (D * D * M) = 2 * D * (M * S) := by dsimp (config := { failIfUnchanged := false }) [S]; ring
            omega
          change countGappedCascades seq ≤ 4 * (D + 2) * (j0 + 2) * (4 * D * (2 ^ (2 * q) * q))
          have h_tot_eq : 4 * D * (2 ^ (2 * q) * q) = M * S := by dsimp (config := { failIfUnchanged := false }) [M, S]; ring
          rw [h_tot_eq]
