/-!
# Ordinal-`ω` Inverse-Ackermann Hierarchy and Epoch Contraction (`OmegaAckermann`)

This module proves all pure-`ℕ` properties of Sundar's inverse Ackermann function, the finite
star-iterate hierarchy `α_r`, the diagonal ordinal-`ω` inverse Ackermann function `α_ω`
(including universal `o(α_r)` separation for every `r ≥ 1`), Pass-1 / terminal-bisection numeric
bounds, and the existence of shrinking scale sequences over an Epoch Grouping Tree achieving
degree-`6` contraction at arbitrary depth `r ≥ 1`.
-/

open SplayTree

/-!
================================================================================
1. Foundational Ackermann and `invAckermann` Properties
================================================================================
-/

private lemma two_mul_le_two_pow : ∀ j : ℕ, 1 ≤ j → 2 * j ≤ 2 ^ j := by
  intro j
  induction j with
  | zero => intro h; omega
  | succ j ih =>
    intro _
    rcases j with _ | m
    · norm_num
    · have hm := ih (by omega)
      have hpow : 2 ^ (m + 2) = 2 * 2 ^ (m + 1) := by rw [pow_succ]; ring
      omega

private lemma ack_ge_two_mul : ∀ i j : ℕ, 1 ≤ j → 2 * j ≤ ackermann i j := by
  intro i
  induction i with
  | zero => intro j _; simp [ackermann]
  | succ i ih_i =>
    rcases i with _ | r
    · intro j hj; simpa [ackermann] using two_mul_le_two_pow j hj
    · intro j
      induction j with
      | zero => intro h; omega
      | succ j ih_j =>
        intro _
        rcases j with _ | m
        · have h2 := ih_i 2 (by omega)
          change 2 * 1 ≤ ackermann (r + 1) 2; omega
        · have hm : 2 * (m + 1) ≤ ackermann (r + 2) (m + 1) := ih_j (by omega)
          have hx : 2 * ackermann (r + 2) (m + 1) ≤ ackermann (r + 1) (ackermann (r + 2) (m + 1)) :=
            ih_i (ackermann (r + 2) (m + 1)) (by omega)
          change 2 * (m + 2) ≤ ackermann (r + 1) (ackermann (r + 2) (m + 1)); omega

private lemma ack_strictMono_j : ∀ i : ℕ, StrictMono (ackermann i) := by
  intro i
  apply strictMono_nat_of_lt_succ
  intro j
  rcases i with _ | _ | r
  · simp [ackermann]
  · simp only [ackermann]; exact Nat.pow_lt_pow_right (by omega) (by omega)
  · rcases j with _ | m
    · have h2 := ack_ge_two_mul (r + 1) 2 (by omega)
      change 1 < ackermann (r + 1) 2; omega
    · have hm := ack_ge_two_mul (r + 2) (m + 1) (by omega)
      have hx := ack_ge_two_mul (r + 1) (ackermann (r + 2) (m + 1)) (by omega)
      change ackermann (r + 2) (m + 1) < ackermann (r + 1) (ackermann (r + 2) (m + 1)); omega

private lemma ack_mono_i_step : ∀ i j : ℕ, 1 ≤ j → ackermann i j ≤ ackermann (i + 1) j := by
  intro i
  induction i with
  | zero => intro j hj; simpa [ackermann] using two_mul_le_two_pow j hj
  | succ i ih_i =>
    rcases i with _ | r
    · intro j hj
      rcases j with _ | _ | m
      · omega
      · change 2 ^ 1 ≤ 2 ^ 2; norm_num
      · have hm := ack_ge_two_mul 2 (m + 1) (by omega)
        change 2 ^ (m + 2) ≤ 2 ^ (ackermann 2 (m + 1))
        exact Nat.pow_le_pow_right (by omega) (by omega)
    · intro j
      induction j with
      | zero => intro h; omega
      | succ j ih_j =>
        intro _
        rcases j with _ | m
        · change ackermann (r + 2) 1 ≤ ackermann (r + 2) 2
          exact (ack_strictMono_j (r + 2)).monotone (by omega)
        · have hm := ack_ge_two_mul (r + 2) (m + 1) (by omega)
          have h1 := ih_i (ackermann (r + 2) (m + 1)) (by omega)
          have h2 := (ack_strictMono_j (r + 2)).monotone (ih_j (by omega))
          change ackermann (r + 1) (ackermann (r + 2) (m + 1)) ≤
            ackermann (r + 2) (ackermann (r + 3) (m + 1))
          exact le_trans h1 h2

private lemma ack_mono_i : ∀ j : ℕ, 1 ≤ j → Monotone (fun i => ackermann i j) :=
  fun j hj => monotone_nat_of_le_succ (fun i => ack_mono_i_step i j hj)

private lemma ack_col1_double : ∀ k : ℕ, 1 ≤ k → 2 * ackermann k 1 ≤ ackermann (k + 1) 1 := by
  intro k hk
  rcases k with _ | _ | r
  · omega
  · change 2 * 2 ≤ 4; omega
  · have h1 := ack_ge_two_mul (r + 2) 1 (by omega)
    exact ack_ge_two_mul (r + 1) (ackermann (r + 2) 1) (by omega)

private lemma ack_col1_exp : ∀ k : ℕ, 1 ≤ k → 2 ^ k ≤ ackermann k 1 := by
  intro k
  induction k with
  | zero => intro h; omega
  | succ k ih =>
    intro _
    rcases k with _ | m
    · change 2 ^ 1 ≤ 2; omega
    · have hm := ih (by omega)
      have hd := ack_col1_double (m + 1) (by omega)
      have hpow : 2 ^ (m + 2) = 2 * 2 ^ (m + 1) := by rw [pow_succ]; ring
      omega

private lemma ack2_tower : ∀ j : ℕ, 1 ≤ j → 2 ^ (2 ^ j) ≤ ackermann 2 j := by
  intro j
  induction j with
  | zero => intro h; omega
  | succ j ih =>
    intro _
    rcases j with _ | m
    · change 2 ^ (2 ^ 1) ≤ 4; norm_num
    · have hm := ih (by omega)
      have hlt : m + 1 < 2 ^ (m + 1) := Nat.lt_two_pow_self
      have h2 := two_mul_le_two_pow (2 ^ (m + 1)) (by omega)
      have hpow : 2 ^ (m + 2) = 2 * 2 ^ (m + 1) := by rw [pow_succ]; ring
      change 2 ^ (2 ^ (m + 2)) ≤ 2 ^ (ackermann 2 (m + 1))
      exact Nat.pow_le_pow_right (by omega) (by omega)

private lemma invAck_nonempty : ∀ n : ℕ, {k : ℕ | 1 ≤ k ∧ n ≤ ackermann k 1}.Nonempty := by
  intro n
  have hlt : n + 1 < 2 ^ (n + 1) := Nat.lt_two_pow_self
  have hexp := ack_col1_exp (n + 1) (by omega)
  exact ⟨n + 1, by omega, by omega⟩

private lemma invAck_spec :
    ∀ n : ℕ, 1 ≤ invAckermann n ∧ n ≤ ackermann (invAckermann n) 1 ∧
      ∀ k : ℕ, 1 ≤ k → k < invAckermann n → ackermann k 1 < n := by
  intro n
  obtain ⟨h1, h2⟩ := Nat.sInf_mem (invAck_nonempty n)
  refine ⟨h1, h2, ?_⟩
  intro k hk1 hklt
  by_contra hle
  push_neg at hle
  have hinv_le : invAckermann n ≤ k := Nat.sInf_le ⟨hk1, hle⟩
  omega

private lemma invAck_galois : ∀ n k : ℕ, 1 ≤ k → (invAckermann n ≤ k ↔ n ≤ ackermann k 1) := by
  intro n k hk
  constructor
  · intro hle; exact le_trans (invAck_spec n).2.1 (ack_mono_i 1 (by omega) hle)
  · intro hle; exact Nat.sInf_le ⟨hk, hle⟩

private lemma invAck_mono : Monotone invAckermann := fun a b hab =>
  (invAck_galois a (invAckermann b) (invAck_spec b).1).mpr (le_trans hab (invAck_spec b).2.1)

private lemma invAck_shift : ∀ n : ℕ, invAckermann (n + 2) ≤ invAckermann n + 1 := by
  intro n
  set k := invAckermann n
  have hk1 : 1 ≤ k := (invAck_spec n).1
  have hn : n ≤ ackermann k 1 := (invAck_spec n).2.1
  have hexp : 2 ^ 1 ≤ ackermann k 1 :=
    le_trans (Nat.pow_le_pow_right (by omega) hk1) (ack_col1_exp k hk1)
  have hd := ack_col1_double k hk1
  exact (invAck_galois (n + 2) (k + 1) (by omega)).mpr (by omega)

private lemma linear_le_pow17 : ∀ d : ℕ, 20 + 6 * (d + 17) ≤ 2 ^ (d + 17) := by
  intro d
  induction d with
  | zero => norm_num
  | succ d ih =>
    have hpow : 2 ^ (d + 1 + 17) = 2 * 2 ^ (d + 17) := by
      have : d + 1 + 17 = (d + 17) + 1 := by omega
      rw [this, pow_succ]; ring
    omega

private lemma invAck_poly : ∀ u : ℕ, 5 ≤ u → invAckermann (2 ^ 20 * u ^ 6) ≤ invAckermann u + 1 := by
  intro u hu5
  have h_ack_step1 : ∀ i : ℕ, ackermann (i + 2) 1 = ackermann (i + 1) 2 := fun _ => rfl
  have h_ack_step2 : ∀ i m : ℕ,
      ackermann (i + 2) (m + 2) = ackermann (i + 1) (ackermann (i + 2) (m + 1)) := fun _ _ => rfl
  have h_ack21 : ackermann 2 1 = 4 := rfl
  have h_ack31 : ackermann 3 1 = 16 := rfl
  set r := invAckermann u
  have hu_le : u ≤ ackermann r 1 := (invAck_spec u).2.1
  have hr_not2 : ¬ (r ≤ 2) := by
    intro hr2
    have := (invAck_galois u 2 (by omega)).mp hr2
    rw [h_ack21] at this
    omega
  by_cases hr3 : r = 3
  · have hu16 : u ≤ 16 := by
      have := (invAck_galois u 3 (by omega)).mp (by omega)
      rw [h_ack31] at this
      exact this
    have hu6 : u ^ 6 ≤ 16 ^ 6 := Nat.pow_le_pow_left hu16 6
    have h1 : 2 ^ 20 * u ^ 6 ≤ 2 ^ 44 := by
      have h44 : 2 ^ 20 * 16 ^ 6 = 2 ^ 44 := by norm_num
      omega
    have h2 : 2 ^ 44 ≤ 2 ^ (2 ^ 16) :=
      Nat.pow_le_pow_right (by omega) (show 44 ≤ 65536 by omega)
    have h3 : 2 ^ (2 ^ 16) ≤ ackermann 2 16 := ack2_tower 16 (by omega)
    have h4 : ackermann 4 1 = ackermann 2 16 := by
      rw [h_ack_step1 2, h_ack_step2 1 0, h_ack31]
    have h5 : invAckermann (2 ^ 20 * u ^ 6) ≤ 4 :=
      (invAck_galois (2 ^ 20 * u ^ 6) 4 (by omega)).mpr (by omega)
    omega
  · have hr4 : 4 ≤ r := by omega
    have hu17 : 17 ≤ u := by
      by_contra hlt
      have hu16 : u ≤ ackermann 3 1 := by rw [h_ack31]; omega
      have := (invAck_galois u 3 (by omega)).mpr hu16
      omega
    have hu_pow : u ≤ 2 ^ u := Nat.le_of_lt Nat.lt_two_pow_self
    have hu6 : 2 ^ 20 * u ^ 6 ≤ 2 ^ (20 + 6 * u) := by
      have hpow6 : u ^ 6 ≤ (2 ^ u) ^ 6 := Nat.pow_le_pow_left hu_pow 6
      have hmul := Nat.mul_le_mul_left (2 ^ 20) hpow6
      have hexp6 : 2 ^ 20 * (2 ^ u) ^ 6 = 2 ^ (20 + 6 * u) := by
        rw [← pow_mul, ← pow_add]; congr 1; omega
      omega
    have hlin : 20 + 6 * u ≤ 2 ^ u := by
      have hd := linear_le_pow17 (u - 17)
      have hsub : u - 17 + 17 = u := by omega
      rw [hsub] at hd
      exact hd
    have h_u_tower : 2 ^ 20 * u ^ 6 ≤ 2 ^ (2 ^ u) :=
      le_trans hu6 (Nat.pow_le_pow_right (by omega) hlin)
    have h_r_tower : 2 ^ (2 ^ u) ≤ 2 ^ (2 ^ (ackermann r 1)) :=
      Nat.pow_le_pow_right (by omega) (Nat.pow_le_pow_right (by omega) hu_le)
    have h_ack2 : 2 ^ (2 ^ (ackermann r 1)) ≤ ackermann 2 (ackermann r 1) :=
      ack2_tower (ackermann r 1) (by omega)
    set m := r - 2
    have hm_eq : r = m + 2 := by omega
    have hm2 : 2 ≤ m + 1 := by omega
    have h_step_i : ackermann 2 (ackermann (m + 2) 1) ≤
        ackermann (m + 1) (ackermann (m + 2) 1) :=
      ack_mono_i (ackermann (m + 2) 1) (by rw [← hm_eq]; omega) hm2
    have h_def : ackermann (m + 1) (ackermann (m + 2) 1) = ackermann (m + 3) 1 := by
      rw [h_ack_step1 (m + 1), h_ack_step2 m 0]
    have h_r1 : m + 3 = r + 1 := by omega
    have h_tot : 2 ^ 20 * u ^ 6 ≤ ackermann (r + 1) 1 := by
      rw [h_def, h_r1, ← hm_eq] at h_step_i
      exact le_trans h_u_tower (le_trans h_r_tower (le_trans h_ack2 h_step_i))
    exact (invAck_galois (2 ^ 20 * u ^ 6) (r + 1) (by omega)).mpr h_tot

private lemma invAck_at4 : invAckermann 4 ≤ 2 :=
  (invAck_galois 4 2 (by omega)).mpr (by change 4 ≤ 4; omega)

private lemma invAck_at2 : invAckermann 2 ≤ 2 :=
  le_trans (invAck_mono (by omega)) invAck_at4

private lemma invAck_lt : ∀ n : ℕ, 2 < n → invAckermann n < n := by
  intro n hn
  set k := invAckermann n
  have hk2 : 2 ≤ k := by
    by_contra hk1
    have := (invAck_galois n 1 (by omega)).mp (by omega)
    change n ≤ 2 at this; omega
  have hnot : ¬ (n ≤ ackermann (k - 1) 1) := fun hle =>
    absurd ((invAck_galois n (k - 1) (by omega)).mpr hle) (by omega)
  have hexp := ack_col1_exp (k - 1) (by omega)
  have hpow : k - 1 < 2 ^ (k - 1) := Nat.lt_two_pow_self
  omega

theorem ackermann_row1_spec :
    ∀ M : ℕ, 2 ≤ SplayTree.invAckermann M + 1 ∧
      M ≤ SplayTree.ackermann (SplayTree.invAckermann M + 1) 1 := by
  intro M
  have hpos := (invAck_spec M).1
  have hle : M ≤ ackermann (invAckermann M + 1) 1 :=
    (invAck_galois M (invAckermann M + 1) (by omega)).mp (by omega)
  exact ⟨by omega, hle⟩


/-!
================================================================================
2. Finite Star-Iterate Hierarchy `α_r` and Diagonal `α_ω`
================================================================================
-/

private lemma iterOp_props (g : ℕ → ℕ)
    (hg_mono : Monotone g) (hg2 : g 2 ≤ 2) (hg_lt : ∀ n, 2 < n → g n < n) :
    let f := fun n => sInf {i : ℕ | 1 ≤ i ∧ (g^[i] n) ≤ 2}
    (∀ n, {i : ℕ | 1 ≤ i ∧ (g^[i] n) ≤ 2}.Nonempty) ∧
    (∀ n, 1 ≤ f n ∧ (g^[f n] n) ≤ 2 ∧ (∀ i, 1 ≤ i → i < f n → 2 < (g^[i] n))) ∧
    Monotone f ∧
    f 2 ≤ 2 ∧
    (∀ n, f n = 1 ↔ g n ≤ 2) ∧
    (∀ n, 2 < g n → f n = 1 + f (g n)) ∧
    (∀ n, 2 < n → f n < n) := by
  intro f
  have h_desc : ∀ k n : ℕ, (g^[k] n) ≤ 2 ∨ (g^[k] n) + k ≤ n := by
    intro k
    induction k with
    | zero => intro n; exact Or.inr (by simp)
    | succ k ih =>
      intro n
      rw [Function.iterate_succ_apply']
      rcases ih n with hle | hsum
      · exact Or.inl (le_trans (hg_mono hle) hg2)
      · by_cases hgt : (g^[k] n) ≤ 2
        · exact Or.inl (le_trans (hg_mono hgt) hg2)
        · have hlt := hg_lt (g^[k] n) (by omega)
          exact Or.inr (by omega)
  have hne : ∀ n, {i : ℕ | 1 ≤ i ∧ (g^[i] n) ≤ 2}.Nonempty := by
    intro n
    have hd := h_desc (n + 1) n
    exact ⟨n + 1, by omega, by rcases hd with h1 | h2 <;> omega⟩
  have hspec : ∀ n, 1 ≤ f n ∧ (g^[f n] n) ≤ 2 ∧ (∀ i, 1 ≤ i → i < f n → 2 < (g^[i] n)) := by
    intro n
    obtain ⟨h1, h2⟩ := Nat.sInf_mem (hne n)
    refine ⟨h1, h2, ?_⟩
    intro i hi1 hilt
    by_contra hle
    push_neg at hle
    have hfn_le : f n ≤ i := Nat.sInf_le ⟨hi1, hle⟩
    omega
  have hmono : Monotone f := by
    intro a b hab
    obtain ⟨hi1, hib, _⟩ := hspec b
    exact Nat.sInf_le ⟨hi1, le_trans (hg_mono.iterate (f b) hab) hib⟩
  have heq1 : ∀ n, f n = 1 ↔ g n ≤ 2 := by
    intro n
    constructor
    · intro h1
      have hm := (hspec n).2.1
      rw [h1, Function.iterate_one] at hm
      exact hm
    · intro hgn
      have hle : f n ≤ 1 := Nat.sInf_le ⟨by omega, by simpa [Function.iterate_one] using hgn⟩
      have hge := (hspec n).1
      omega
  have hf2 : f 2 ≤ 2 := by
    have := (heq1 2).mpr hg2
    omega
  have hstep : ∀ n, 2 < g n → f n = 1 + f (g n) := by
    intro n hgn
    obtain ⟨hj1, hjb, _⟩ := hspec (g n)
    have h_up : f n ≤ f (g n) + 1 :=
      Nat.sInf_le ⟨by omega, by rw [Function.iterate_succ_apply]; exact hjb⟩
    obtain ⟨hi1, hib, _⟩ := hspec n
    have hi_ne1 : f n ≠ 1 := fun h1 => absurd ((heq1 n).mp h1) (by omega)
    have h_lo : f (g n) ≤ f n - 1 := by
      apply Nat.sInf_le
      refine ⟨by omega, ?_⟩
      have hsub : (f n - 1).succ = f n := by omega
      rw [← Function.iterate_succ_apply g (f n - 1) n, hsub]
      exact hib
    omega
  have hlt : ∀ n, 2 < n → f n < n := by
    intro n
    induction n using Nat.strong_induction_on with
    | h n ih =>
      intro hn
      by_cases hgn : g n ≤ 2
      · have := (heq1 n).mpr hgn; omega
      · have hgt : 2 < g n := by omega
        have hgn_lt := hg_lt n hn
        have h_ih := ih (g n) hgn_lt hgt
        have hs := hstep n hgt
        omega
  exact ⟨hne, hspec, hmono, hf2, heq1, hstep, hlt⟩

private lemma hierarchy_good :
    ∀ r : ℕ,
      (∀ n : ℕ, 1 ≤ iteratedInvAckermannHierarchy r n) ∧
      Monotone (iteratedInvAckermannHierarchy r) ∧
      iteratedInvAckermannHierarchy r 2 ≤ 2 ∧
      (∀ n : ℕ, 2 < n → iteratedInvAckermannHierarchy r n < n) := by
  intro r
  induction r with
  | zero =>
    exact ⟨fun n => (invAck_spec n).1, invAck_mono, invAck_at2, invAck_lt⟩
  | succ r ih =>
    obtain ⟨_, hmono, hat2, hlt⟩ := ih
    obtain ⟨_, hspec, hmono', hat2', _, _, hlt'⟩ :=
      iterOp_props (iteratedInvAckermannHierarchy r) hmono hat2 hlt
    exact ⟨fun n => (hspec n).1, hmono', hat2', hlt'⟩

private lemma hierarchy_succ_props (r : ℕ) :
    (∀ n, {i : ℕ | 1 ≤ i ∧ ((iteratedInvAckermannHierarchy r)^[i] n) ≤ 2}.Nonempty) ∧
    (∀ n, 1 ≤ iteratedInvAckermannHierarchy (r + 1) n ∧
      ((iteratedInvAckermannHierarchy r)^[iteratedInvAckermannHierarchy (r + 1) n] n) ≤ 2 ∧
      (∀ i, 1 ≤ i → i < iteratedInvAckermannHierarchy (r + 1) n →
        2 < ((iteratedInvAckermannHierarchy r)^[i] n))) ∧
    (∀ n, iteratedInvAckermannHierarchy (r + 1) n = 1 ↔
      iteratedInvAckermannHierarchy r n ≤ 2) ∧
    (∀ n, 2 < iteratedInvAckermannHierarchy r n →
      iteratedInvAckermannHierarchy (r + 1) n =
        1 + iteratedInvAckermannHierarchy (r + 1) (iteratedInvAckermannHierarchy r n)) := by
  obtain ⟨_, hmono, hat2, hlt⟩ := hierarchy_good r
  obtain ⟨hne, hspec, _, _, heq1, hstep, _⟩ :=
    iterOp_props (iteratedInvAckermannHierarchy r) hmono hat2 hlt
  exact ⟨hne, hspec, heq1, hstep⟩

private lemma hierarchy_step_le (r n : ℕ) :
    iteratedInvAckermannHierarchy (r + 1) n ≤
      1 + iteratedInvAckermannHierarchy (r + 1) (iteratedInvAckermannHierarchy r n) := by
  obtain ⟨_, _, heq1, hstep⟩ := hierarchy_succ_props r
  have hpos := (hierarchy_good (r + 1)).1 (iteratedInvAckermannHierarchy r n)
  by_cases hle : iteratedInvAckermannHierarchy r n ≤ 2
  · have h1 := (heq1 n).mpr hle
    omega
  · have hs := hstep n (by omega)
    omega

private lemma hierarchy_le4_eq1 :
    ∀ r n : ℕ, n ≤ 4 → iteratedInvAckermannHierarchy (r + 1) n = 1 := by
  intro r
  induction r with
  | zero =>
    intro n hn
    have hle : invAckermann n ≤ 2 := le_trans (invAck_mono hn) invAck_at4
    exact ((hierarchy_succ_props 0).2.2.1 n).mpr hle
  | succ r ih =>
    intro n hn
    have h1 := ih n hn
    exact ((hierarchy_succ_props (r + 1)).2.2.1 n).mpr (by omega)

private lemma hierarchy_le_sub_two :
    ∀ r m : ℕ, 3 ≤ m → iteratedInvAckermannHierarchy (r + 1) m ≤ m - 2 := by
  intro r m
  induction m using Nat.strong_induction_on with
  | h m ih =>
    intro hm3
    by_cases hm4 : m ≤ 4
    · have h1 := hierarchy_le4_eq1 r m hm4
      omega
    · obtain ⟨_, _, heq1, hstep⟩ := hierarchy_succ_props r
      by_cases hle2 : iteratedInvAckermannHierarchy r m ≤ 2
      · have h1 := (heq1 m).mpr hle2
        omega
      · have hgt2 : 2 < iteratedInvAckermannHierarchy r m := by omega
        have hlt_m : iteratedInvAckermannHierarchy r m < m :=
          (hierarchy_good r).2.2.2 m (by omega)
        have h_ih := ih (iteratedInvAckermannHierarchy r m) hlt_m (by omega)
        have hs := hstep m hgt2
        omega

private lemma hierarchy_strict_drop_level (r n : ℕ)
    (hgt : 2 < iteratedInvAckermannHierarchy r n) :
    iteratedInvAckermannHierarchy (r + 1) n + 1 ≤ iteratedInvAckermannHierarchy r n := by
  have hs := (hierarchy_succ_props r).2.2.2 n hgt
  have hsub := hierarchy_le_sub_two r (iteratedInvAckermannHierarchy r n) (by omega)
  omega

private lemma hierarchy_anti_step (r n : ℕ) :
    iteratedInvAckermannHierarchy (r + 1) n ≤ iteratedInvAckermannHierarchy r n := by
  by_cases hle : iteratedInvAckermannHierarchy r n ≤ 2
  · have h1 := ((hierarchy_succ_props r).2.2.1 n).mpr hle
    have hpos := (hierarchy_good r).1 n
    omega
  · have hd := hierarchy_strict_drop_level r n (by omega)
    omega

private lemma hierarchy_anti_level {r s : ℕ} (hrs : r ≤ s) (n : ℕ) :
    iteratedInvAckermannHierarchy s n ≤ iteratedInvAckermannHierarchy r n :=
  (antitone_nat_of_succ_le (f := fun k => iteratedInvAckermannHierarchy k n)
    (fun k => hierarchy_anti_step k n)) hrs

theorem hierarchy_sInf_nonempty_and_spec :
    SplayTree.iteratedInvAckermannHierarchy 0 = SplayTree.invAckermann ∧
    SplayTree.iteratedInvAckermannHierarchy 1 = SplayTree.iteratedInvAckermann ∧
    SplayTree.iteratedInvAckermannHierarchy 2 = SplayTree.doubleIteratedInvAckermann ∧
    (∀ r n : ℕ, 1 ≤ SplayTree.iteratedInvAckermannHierarchy r n) ∧
    (∀ r : ℕ, Monotone (SplayTree.iteratedInvAckermannHierarchy r)) ∧
    (∀ r n : ℕ, SplayTree.iteratedInvAckermannHierarchy (r + 1) n ≤
      SplayTree.iteratedInvAckermannHierarchy r n) := by
  refine ⟨rfl, ?_, ?_, fun r n => (hierarchy_good r).1 n, fun r => (hierarchy_good r).2.1,
    hierarchy_anti_step⟩
  · funext n; rfl
  · funext n; rfl

private lemma hierarchy_level_descent (r : ℕ) :
    ∀ d n : ℕ,
      iteratedInvAckermannHierarchy (r + d) n ≤ 2 ∨
      iteratedInvAckermannHierarchy (r + d) n + d ≤ iteratedInvAckermannHierarchy r n := by
  intro d
  induction d with
  | zero => intro n; exact Or.inr (by simp)
  | succ d ih =>
    intro n
    have h_idx : r + (d + 1) = (r + d) + 1 := by omega
    rw [h_idx]
    rcases ih n with hle | hsum
    · have h1 := ((hierarchy_succ_props (r + d)).2.2.1 n).mpr hle
      exact Or.inl (by omega)
    · by_cases hle2 : iteratedInvAckermannHierarchy (r + d) n ≤ 2
      · have h1 := ((hierarchy_succ_props (r + d)).2.2.1 n).mpr hle2
        exact Or.inl (by omega)
      · have hd := hierarchy_strict_drop_level (r + d) n (by omega)
        exact Or.inr (by omega)

private lemma hierarchy_reach_two (r n : ℕ) :
    iteratedInvAckermannHierarchy (r + 1 + iteratedInvAckermannHierarchy (r + 1) n) n ≤ 2 := by
  have hd := hierarchy_level_descent (r + 1) (iteratedInvAckermannHierarchy (r + 1) n) n
  have hpos := (hierarchy_good (r + 1 + iteratedInvAckermannHierarchy (r + 1) n)).1 n
  rcases hd with h1 | h2
  · exact h1
  · omega

private lemma omega_nonempty (n : ℕ) :
    {r : ℕ | 1 ≤ r ∧ iteratedInvAckermannHierarchy r n ≤ 2}.Nonempty := by
  refine ⟨1 + iteratedInvAckermannHierarchy 1 n, ?_, ?_⟩
  · have := (hierarchy_good 1).1 n; omega
  · simpa using hierarchy_reach_two 0 n

private lemma omega_le_mul_succ (r n : ℕ) :
    ordinalOmegaInvAckermann n ≤ (r + 2) * iteratedInvAckermannHierarchy (r + 1) n := by
  have hpos := (hierarchy_good (r + 1)).1 n
  have hle : ordinalOmegaInvAckermann n ≤ r + 1 + iteratedInvAckermannHierarchy (r + 1) n :=
    Nat.sInf_le ⟨by omega, hierarchy_reach_two r n⟩
  have hmul : r + 1 + iteratedInvAckermannHierarchy (r + 1) n ≤
      (r + 2) * iteratedInvAckermannHierarchy (r + 1) n := by
    calc r + 1 + iteratedInvAckermannHierarchy (r + 1) n
        = (r + 1) * 1 + iteratedInvAckermannHierarchy (r + 1) n := by ring
      _ ≤ (r + 1) * iteratedInvAckermannHierarchy (r + 1) n +
          iteratedInvAckermannHierarchy (r + 1) n :=
          Nat.add_le_add_right (Nat.mul_le_mul_left (r + 1) hpos) _
      _ = (r + 2) * iteratedInvAckermannHierarchy (r + 1) n := by ring
  exact le_trans hle hmul

private noncomputable def stepUp : ℕ → ℕ → ℕ
  | 0 => fun x => ackermann (max 2 x) 1 + 1
  | r + 1 => fun d => (stepUp r)^[max 3 d] 0

private lemma stepUp_iter_ge :
    ∀ r k : ℕ, k ≤ iteratedInvAckermannHierarchy (r + 1) ((stepUp r)^[k] 0) := by
  intro r
  induction r with
  | zero =>
    have h_one : ∀ x : ℕ,
        1 + iteratedInvAckermannHierarchy 1 x ≤
          iteratedInvAckermannHierarchy 1 (stepUp 0 x) := by
      intro x
      have hnot : ¬ (invAckermann (stepUp 0 x) ≤ max 2 x) := by
        intro hle
        have := (invAck_galois (stepUp 0 x) (max 2 x) (by omega)).mp hle
        dsimp (config := { failIfUnchanged := false }) [stepUp] at this; omega
      have hgt2 : 2 < iteratedInvAckermannHierarchy 0 (stepUp 0 x) := by
        change 2 < invAckermann (stepUp 0 x); omega
      have hrec := (hierarchy_succ_props 0).2.2.2 (stepUp 0 x) hgt2
      simp only [Nat.zero_add] at hrec
      have hmono_x : iteratedInvAckermannHierarchy 1 x ≤
          iteratedInvAckermannHierarchy 1 (iteratedInvAckermannHierarchy 0 (stepUp 0 x)) :=
        (hierarchy_good 1).2.1 (show x ≤ invAckermann (stepUp 0 x) by omega)
      omega
    intro k
    simp only [Nat.zero_add]
    induction k with
    | zero => omega
    | succ k ih_k =>
      rw [Function.iterate_succ_apply']
      have hs := h_one ((stepUp 0)^[k] 0)
      omega
  | succ r ih =>
    have h_one : ∀ d : ℕ,
        1 + iteratedInvAckermannHierarchy (r + 1 + 1) d ≤
          iteratedInvAckermannHierarchy (r + 1 + 1) (stepUp (r + 1) d) := by
      intro d
      have hge : max 3 d ≤ iteratedInvAckermannHierarchy (r + 1) (stepUp (r + 1) d) :=
        ih (max 3 d)
      have hgt2 : 2 < iteratedInvAckermannHierarchy (r + 1) (stepUp (r + 1) d) := by omega
      have hrec := (hierarchy_succ_props (r + 1)).2.2.2 (stepUp (r + 1) d) hgt2
      have hmono_d : iteratedInvAckermannHierarchy (r + 1 + 1) d ≤
          iteratedInvAckermannHierarchy (r + 1 + 1)
            (iteratedInvAckermannHierarchy (r + 1) (stepUp (r + 1) d)) :=
        (hierarchy_good (r + 1 + 1)).2.1 (by omega)
      omega
    intro k
    induction k with
    | zero => omega
    | succ k ih_k =>
      rw [Function.iterate_succ_apply']
      have hs := h_one ((stepUp (r + 1))^[k] 0)
      omega

theorem ordinal_omega_spec_and_universal_little_o :
    (∀ n : ℕ, {r : ℕ | 1 ≤ r ∧ SplayTree.iteratedInvAckermannHierarchy r n ≤ 2}.Nonempty) ∧
    (∀ n : ℕ, 1 ≤ SplayTree.ordinalOmegaInvAckermann n ∧
      SplayTree.iteratedInvAckermannHierarchy (SplayTree.ordinalOmegaInvAckermann n) n ≤ 2 ∧
      ∀ r : ℕ, 1 ≤ r → r < SplayTree.ordinalOmegaInvAckermann n →
        2 < SplayTree.iteratedInvAckermannHierarchy r n) ∧
    Monotone SplayTree.ordinalOmegaInvAckermann ∧
    (∀ B : ℕ, ∃ n : ℕ, B ≤ SplayTree.ordinalOmegaInvAckermann n) ∧
    (∀ r : ℕ, 1 ≤ r → ∀ C : ℕ, ∃ N : ℕ, ∀ n : ℕ, N ≤ n →
      C * SplayTree.ordinalOmegaInvAckermann n < SplayTree.iteratedInvAckermannHierarchy r n) := by
  have hspec : ∀ n : ℕ, 1 ≤ ordinalOmegaInvAckermann n ∧
      iteratedInvAckermannHierarchy (ordinalOmegaInvAckermann n) n ≤ 2 ∧
      ∀ r : ℕ, 1 ≤ r → r < ordinalOmegaInvAckermann n →
        2 < iteratedInvAckermannHierarchy r n := by
    intro n
    obtain ⟨h1, h2⟩ := Nat.sInf_mem (omega_nonempty n)
    refine ⟨h1, h2, ?_⟩
    intro r hr1 hrlt
    by_contra hle
    push_neg at hle
    have h_om : ordinalOmegaInvAckermann n ≤ r := Nat.sInf_le ⟨hr1, hle⟩
    omega
  have hmono : Monotone ordinalOmegaInvAckermann := by
    intro a b hab
    obtain ⟨hr1, hrb, _⟩ := hspec b
    exact Nat.sInf_le ⟨hr1, le_trans ((hierarchy_good _).2.1 hab) hrb⟩
  have hunb : ∀ B : ℕ, ∃ n : ℕ, B ≤ ordinalOmegaInvAckermann n := by
    intro B
    let n := (stepUp B)^[3] 0
    refine ⟨n, ?_⟩
    have h3 : 3 ≤ iteratedInvAckermannHierarchy (B + 1) n := stepUp_iter_ge B 3
    by_contra hlt
    have hle : ordinalOmegaInvAckermann n ≤ B + 1 := by omega
    have h_anti := hierarchy_anti_level hle n
    have h_om2 := (hspec n).2.1
    omega
  have h2u : ∀ d : ℕ, 2 * (d + 5) < 2 ^ (d + 5) := by
    intro d
    induction d with
    | zero => norm_num
    | succ d ih =>
      have : d + 1 + 5 = (d + 5) + 1 := by omega
      rw [this, pow_succ]; omega
  have h_pow_dom : ∀ K u : ℕ, 2 * K + 6 ≤ u → K * (u + 2) < 2 ^ u := by
    intro K u hu
    have hK1 : K + 1 ≤ 2 ^ (K + 1) := le_of_lt Nat.lt_two_pow_self
    set d := u - (K + 1) - 5
    have hd_eq : u - (K + 1) = d + 5 := by omega
    have h2 : u + 2 < 2 ^ (u - (K + 1)) := by
      calc u + 2 ≤ 2 * (d + 5) := by omega
        _ < 2 ^ (d + 5) := h2u d
        _ = 2 ^ (u - (K + 1)) := by rw [hd_eq]
    have hpos : 0 < 2 ^ (K + 1) := Nat.two_pow_pos (K + 1)
    calc K * (u + 2) ≤ (K + 1) * (u + 2) := Nat.mul_le_mul_right _ (by omega)
      _ < 2 ^ (K + 1) * 2 ^ (u - (K + 1)) := Nat.mul_lt_mul_of_le_of_lt hK1 h2 hpos
      _ = 2 ^ u := by rw [← pow_add]; congr 1; omega
  refine ⟨omega_nonempty, hspec, hmono, hunb, ?_⟩
  intro r hr1 C
  set K := C * (r + 2)
  set k := 2 * K + 6
  refine ⟨(stepUp (r - 1))^[2 ^ k] 0, ?_⟩
  intro n hn
  have hr_eq : (r - 1) + 1 = r := by omega
  have h_ge_pow : 2 ^ k ≤ iteratedInvAckermannHierarchy r n := by
    have h1 := stepUp_iter_ge (r - 1) (2 ^ k)
    rw [hr_eq] at h1
    exact le_trans h1 ((hierarchy_good r).2.1 hn)
  have h_pos : 0 < iteratedInvAckermannHierarchy r n := by
    have : 1 ≤ 2 ^ k := Nat.one_le_two_pow
    omega
  set u := Nat.log 2 (iteratedInvAckermannHierarchy r n)
  have hu_ge : k ≤ u := Nat.le_log_of_pow_le (by decide) h_ge_pow
  have h2u_le : 2 ^ u ≤ iteratedInvAckermannHierarchy r n := Nat.pow_log_le_self 2 (by omega)
  have h_lt_2u1 : iteratedInvAckermannHierarchy r n < 2 ^ (u + 1) :=
    Nat.lt_pow_succ_log_self (by decide) _
  have h_inv_2u1 : invAckermann (2 ^ (u + 1)) ≤ u + 1 :=
    (invAck_galois (2 ^ (u + 1)) (u + 1) (by omega)).mpr (ack_col1_exp (u + 1) (by omega))
  have h_ar1_sub :
      iteratedInvAckermannHierarchy (r + 1) (iteratedInvAckermannHierarchy r n) ≤ u + 1 := by
    calc iteratedInvAckermannHierarchy (r + 1) (iteratedInvAckermannHierarchy r n)
        ≤ iteratedInvAckermannHierarchy (r + 1) (2 ^ (u + 1)) :=
          (hierarchy_good (r + 1)).2.1 (le_of_lt h_lt_2u1)
      _ ≤ iteratedInvAckermannHierarchy 0 (2 ^ (u + 1)) :=
          hierarchy_anti_level (Nat.zero_le _) _
      _ ≤ u + 1 := h_inv_2u1
  have h_ar1_n : iteratedInvAckermannHierarchy (r + 1) n ≤ u + 2 := by
    have hs := hierarchy_step_le r n
    omega
  have h_om_le : C * ordinalOmegaInvAckermann n ≤ K * (u + 2) := by
    have hom := omega_le_mul_succ r n
    calc C * ordinalOmegaInvAckermann n
        ≤ C * ((r + 2) * iteratedInvAckermannHierarchy (r + 1) n) := Nat.mul_le_mul_left C hom
      _ = K * iteratedInvAckermannHierarchy (r + 1) n := by dsimp (config := { failIfUnchanged := false }) [K]; ring
      _ ≤ K * (u + 2) := Nat.mul_le_mul_left K h_ar1_n
  exact lt_of_le_of_lt h_om_le (lt_of_lt_of_le (h_pow_dom K u hu_ge) h2u_le)


