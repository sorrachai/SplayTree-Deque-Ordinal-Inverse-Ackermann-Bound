module

public import Solution.TreeFacts

set_option maxHeartbeats 4000000
set_option synthInstance.maxHeartbeats 200000

-- Preserve the elaboration and simplification behavior used by the supplied proof.
-- These options affect tactic execution; the resulting terms are still kernel-checked.
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.types false
set_option backward.whnf.reducibleClassField false
set_option backward.dsimp.proofs true
set_option backward.dsimp.instances true

/-!
Direct proof of the deque bound using AlgoLib's `BinaryTree`, BST invariant,
splay operations, and the shared challenge definitions. The combinatorial
argument is expressed entirely on those types, without a legacy tree model
or any conversion of the input tree.
-/

@[expose] public section
namespace SplayDeque.Direct
open _root_.SplayTree
open _root_.BinaryTree

-- === BEGIN SolPart1 ===
def leftSpineLen : _root_.BinaryTree Unit → ℕ
  | .nil => 0
  | .node _ l _ => 1 + leftSpineLen l

def rightSpineLen : _root_.BinaryTree Unit → ℕ
  | .nil => 0
  | .node _ _ r => 1 + rightSpineLen r

def descendLeft : _root_.BinaryTree Unit → List (_root_.BinaryTree Unit) →
    _root_.BinaryTree Unit × List (_root_.BinaryTree Unit)
  | .nil, acc => (.nil, acc)
  | .node _ .nil r, acc => (r, acc)
  | .node _ l@(.node _ _ _) r, acc => descendLeft l (r :: acc)

def splayLeftSpine : _root_.BinaryTree Unit → List (_root_.BinaryTree Unit) → _root_.BinaryTree Unit
  | c, [] => c
  | c, [r1] => .node () c r1
  | c, r1 :: r2 :: rest => splayLeftSpine (.node () c (.node () r1 r2)) rest

def popUnlabeled (t : _root_.BinaryTree Unit) : _root_.BinaryTree Unit :=
  let (c, path) := descendLeft t []
  splayLeftSpine c path

def rotateLeftAtRightDepth : _root_.BinaryTree Unit → ℕ → _root_.BinaryTree Unit
  | t, 0 => _root_.BinaryTree.rotateLeft t
  | .nil, _ + 1 => .nil
  | .node u l r, d + 1 => .node u l (rotateLeftAtRightDepth r d)

inductive CoreOp where
  | push : CoreOp
  | pop : CoreOp
  | rslr (d : ℕ) : CoreOp
  deriving DecidableEq, Repr

def execCoreOp (t : _root_.BinaryTree Unit) : CoreOp → _root_.BinaryTree Unit
  | .push => .node () .nil t
  | .pop => popUnlabeled t
  | .rslr d => rotateLeftAtRightDepth t d

def coreCascadeStepCost (t : _root_.BinaryTree Unit) : CoreOp → ℕ
  | .pop => (leftSpineLen t - 1) / 2
  | .push => 0
  | .rslr _ => 0

def coreCascadeCostAux : _root_.BinaryTree Unit → List CoreOp → ℕ
  | _, [] => 0
  | t, op :: rest => coreCascadeStepCost t op + coreCascadeCostAux (execCoreOp t op) rest

def coreCascadeCost (ops : List CoreOp) : ℕ :=
  coreCascadeCostAux .nil ops

def countCorePush : List CoreOp → ℕ
  | [] => 0
  | .push :: rest => 1 + countCorePush rest
  | _ :: rest => countCorePush rest

def countCorePop : List CoreOp → ℕ
  | [] => 0
  | .pop :: rest => 1 + countCorePop rest
  | _ :: rest => countCorePop rest

def ValidCoreSeqAux : _root_.BinaryTree Unit → List CoreOp → Prop
  | t, [] => t = .nil
  | t, .push :: rest => ValidCoreSeqAux (.node () .nil t) rest
  | t, .pop :: rest => t ≠ .nil ∧ ValidCoreSeqAux (popUnlabeled t) rest
  | t, .rslr d :: rest =>
      d + 2 ≤ rightSpineLen t ∧ ValidCoreSeqAux (rotateLeftAtRightDepth t d) rest

def ValidCoreSeq (P : ℕ) (ops : List CoreOp) : Prop :=
  countCorePush ops = P ∧ countCorePop ops = P ∧ ValidCoreSeqAux .nil ops

def subtreeAtLeftDepth : _root_.BinaryTree Unit → ℕ → _root_.BinaryTree Unit
  | t, 0 => t
  | .nil, _ + 1 => .nil
  | .node _ l _, d + 1 => subtreeAtLeftDepth l d

def applyAtLeftDepth (f : _root_.BinaryTree Unit → _root_.BinaryTree Unit) :
    _root_.BinaryTree Unit → ℕ → _root_.BinaryTree Unit
  | t, 0 => f t
  | .nil, _ + 1 => .nil
  | .node u l r, d + 1 => .node u (applyAtLeftDepth f l d) r

def validGappedCascadeAtRoot (Δ' : ℕ) : _root_.BinaryTree Unit → List ℕ → Prop
  | t, [] => 2 ≤ leftSpineLen t
  | .node _ (.node _ a _) _, g :: rest =>
      g ≤ Δ' ∧ validGappedCascadeAtRoot Δ' (subtreeAtLeftDepth a g) rest
  | _, _ :: _ => False

def execGappedCascadeAtRoot : _root_.BinaryTree Unit → List ℕ → _root_.BinaryTree Unit
  | t, [] => _root_.BinaryTree.rotateRight t
  | .node u2 (.node u1 a b) c, g :: rest =>
      let a' := applyAtLeftDepth (fun s => execGappedCascadeAtRoot s rest) a g
      .node u1 a' (.node u2 b c)
  | t, _ :: _ => t

def subtreeAtPos : _root_.BinaryTree Unit → List Dir → _root_.BinaryTree Unit
  | t, [] => t
  | .nil, _ :: _ => .nil
  | .node _ l _, .L :: rest => subtreeAtPos l rest
  | .node _ _ r, .R :: rest => subtreeAtPos r rest

def applyAtPos (f : _root_.BinaryTree Unit → _root_.BinaryTree Unit) :
    _root_.BinaryTree Unit → List Dir → _root_.BinaryTree Unit
  | t, [] => f t
  | .nil, _ :: _ => .nil
  | .node u l r, .L :: rest => .node u (applyAtPos f l rest) r
  | .node u l r, .R :: rest => .node u l (applyAtPos f r rest)

inductive RightRotOp where
  | single (pos : List Dir) : RightRotOp
  | cascade (pos : List Dir) (gaps : List ℕ) : RightRotOp
  deriving DecidableEq, Repr

def validRightRotOp (Δ' k : ℕ) (t : _root_.BinaryTree Unit) : RightRotOp → Prop
  | .single pos => 2 ≤ leftSpineLen (subtreeAtPos t pos)
  | .cascade pos gaps =>
      gaps.length + 1 = k ∧ validGappedCascadeAtRoot Δ' (subtreeAtPos t pos) gaps

def execRightRotOp (t : _root_.BinaryTree Unit) : RightRotOp → _root_.BinaryTree Unit
  | .single pos => applyAtPos _root_.BinaryTree.rotateRight t pos
  | .cascade pos gaps =>
      applyAtPos (fun s => execGappedCascadeAtRoot s gaps) t pos

def ValidRightRotSeq (Δ' k : ℕ) : _root_.BinaryTree Unit → List RightRotOp → Prop
  | _, [] => True
  | t, op :: rest =>
      validRightRotOp Δ' k t op ∧ ValidRightRotSeq Δ' k (execRightRotOp t op) rest

def countGappedCascades : List RightRotOp → ℕ
  | [] => 0
  | .single _ :: rest => countGappedCascades rest
  | .cascade _ _ :: rest => 1 + countGappedCascades rest

def GappedCascadeBoundProp : Prop :=
  ∀ (i Δ' N : ℕ) (init : _root_.BinaryTree Unit) (seq : List RightRotOp),
    2 ≤ i →
    1 ≤ N →
    N ≤ ackermann i 1 →
    init.num_nodes = N →
    ValidRightRotSeq Δ' (2 * i) init seq →
    countGappedCascades seq ≤ 8 * (Δ' + 4) * N

noncomputable def scaleSize (P : ℕ) : ℕ → ℕ
  | 0 => P
  | ℓ + 1 => 13000 * (ℓ + 1) ^ 4 * (invAckermann (2 * scaleSize P ℓ) + 1) ^ 2

noncomputable def contractionBound (P : ℕ) : ℕ :=
  max (2 ^ 42) (12000000 * (iteratedInvAckermann P + 7) ^ 6)
def eraseNatKeys : _root_.BinaryTree ℕ → _root_.BinaryTree Unit
  | .nil => .nil
  | .node _ l r => .node () (eraseNatKeys l) (eraseNatKeys r)

def inorderNat : _root_.BinaryTree ℕ → List ℕ
  | .nil => []
  | .node k l r => inorderNat l ++ [k] ++ inorderNat r

def leftSpineBottomUpAux : _root_.BinaryTree ℕ → List ℕ → List ℕ
  | .nil, acc => acc
  | .node k l _, acc => leftSpineBottomUpAux l (k :: acc)

def leftSpineBottomUpNat (t : _root_.BinaryTree ℕ) : List ℕ :=
  leftSpineBottomUpAux t []

def rightSpineTopDownNat : _root_.BinaryTree ℕ → List ℕ
  | .nil => []
  | .node k _ r => k :: rightSpineTopDownNat r

def descendLeftNat : _root_.BinaryTree ℕ → List (ℕ × _root_.BinaryTree ℕ) →
    _root_.BinaryTree ℕ × List (ℕ × _root_.BinaryTree ℕ)
  | .nil, acc => (.nil, acc)
  | .node _ .nil r, acc => (r, acc)
  | .node k l@(.node _ _ _) r, acc => descendLeftNat l ((k, r) :: acc)

def splayLeftSpineNat : _root_.BinaryTree ℕ → List (ℕ × _root_.BinaryTree ℕ) → _root_.BinaryTree ℕ
  | c, [] => c
  | c, [(k1, r1)] => .node k1 c r1
  | c, (k1, r1) :: (k2, r2) :: rest =>
      splayLeftSpineNat (.node k1 c (.node k2 r1 r2)) rest

def popNat (t : _root_.BinaryTree ℕ) : _root_.BinaryTree ℕ :=
  let (c, path) := descendLeftNat t []
  splayLeftSpineNat c path

def rotateLeftAtRightDepthNat : _root_.BinaryTree ℕ → ℕ → _root_.BinaryTree ℕ
  | t, 0 => _root_.BinaryTree.rotateLeft t
  | .nil, _ + 1 => .nil
  | .node k l r, d + 1 => .node k l (rotateLeftAtRightDepthNat r d)

inductive KeyedCoreOp where
  | push (w : ℕ) : KeyedCoreOp
  | pop (s : ℕ) : KeyedCoreOp
  | rslr (d : ℕ) : KeyedCoreOp
  deriving DecidableEq, Repr, Inhabited

def eraseKeyedOp : KeyedCoreOp → CoreOp
  | .push _ => .push
  | .pop _ => .pop
  | .rslr d => .rslr d

def execKeyedOp (H : _root_.BinaryTree ℕ) : KeyedCoreOp → _root_.BinaryTree ℕ
  | .push w => .node w .nil H
  | .pop _ => popNat H
  | .rslr d => rotateLeftAtRightDepthNat H d

def execKeyedList : _root_.BinaryTree ℕ → List KeyedCoreOp → _root_.BinaryTree ℕ
  | H, [] => H
  | H, op :: rest => execKeyedList (execKeyedOp H op) rest

def keyedState (kops : List KeyedCoreOp) (t : ℕ) : _root_.BinaryTree ℕ :=
  execKeyedList .nil (kops.take t)

def countKeyedRslr : List KeyedCoreOp → ℕ
  | [] => 0
  | .rslr _ :: rest => 1 + countKeyedRslr rest
  | _ :: rest => countKeyedRslr rest

def isKeyedPop : KeyedCoreOp → Bool
  | .pop _ => true
  | _ => false

def popIdx (kops : List KeyedCoreOp) (t : ℕ) : ℕ :=
  (kops.take t).countP isKeyedPop

def pushKeys : List KeyedCoreOp → List ℕ
  | [] => []
  | .push w :: rest => w :: pushKeys rest
  | _ :: rest => pushKeys rest

def popKeys : List KeyedCoreOp → List ℕ
  | [] => []
  | .pop s :: rest => s :: popKeys rest
  | _ :: rest => popKeys rest

def birthStep (kops : List KeyedCoreOp) (w : ℕ) : ℕ :=
  kops.findIdx (fun op => op == .push w)

def popStep (kops : List KeyedCoreOp) (w : ℕ) : ℕ :=
  kops.findIdx (fun op => op == .pop w)

structure ValidKeyedCoreSeq (P : ℕ) (kops : List KeyedCoreOp) : Prop where
  end_empty : keyedState kops kops.length = .nil
  push_perm : (pushKeys kops).Perm (List.range P)
  pop_eq : popKeys kops = List.range P
  birth_lt_pop : ∀ w < P, birthStep kops w < popStep kops w ∧ popStep kops w < kops.length
  birth_op : ∀ w < P, kops[birthStep kops w]? = some (.push w)
  pop_op : ∀ w < P, kops[popStep kops w]? = some (.pop w)
  popStep_mono : ∀ u v, u < v → v < P → popStep kops u < popStep kops v
  mem_inorder_iff : ∀ t ≤ kops.length, ∀ w,
    (w ∈ inorderNat (keyedState kops t) ↔ w < P ∧ birthStep kops w < t ∧ t ≤ popStep kops w)
  popIdx_at_popStep : ∀ s < P, popIdx kops (popStep kops s) = s
  popIdx_after_popStep : ∀ s < P, popIdx kops (popStep kops s + 1) = s + 1
  popIdx_bound : ∀ t ≤ kops.length, ∀ w ∈ inorderNat (keyedState kops t),
    popIdx kops t ≤ w ∧ w < P
  isBST_state : ∀ t ≤ kops.length, _root_.BinaryTree.IsBST (keyedState kops t)
  inorder_strictMono : ∀ t ≤ kops.length,
    List.Pairwise (· < ·) (inorderNat (keyedState kops t))
  step_valid : ∀ t (ht : t < kops.length),
    match kops[t] with
    | .push w =>
        w < P ∧ birthStep kops w = t ∧
          _root_.SplayDeque.Direct.ForallTree (fun k => w < k) (keyedState kops t)
    | .pop s =>
        s < P ∧ popStep kops s = t ∧ s = popIdx kops t ∧
          keyedState kops t ≠ .nil ∧
          (leftSpineBottomUpNat (keyedState kops t)).head? = some s
    | .rslr d =>
        d + 2 ≤ (rightSpineTopDownNat (keyedState kops t)).length

def foldRightSpine (acc : _root_.BinaryTree ℕ) (k : ℕ) : _root_.BinaryTree ℕ → _root_.BinaryTree ℕ
  | .nil => .node k acc .nil
  | .node k2 l2 r2 => foldRightSpine (.node k acc l2) k2 r2

def foldBST (P : ℕ) : _root_.BinaryTree ℕ → _root_.BinaryTree ℕ × ℕ
  | .nil => (.nil, P)
  | .node b0 l0 r0 => (foldRightSpine l0 b0 r0, b0)

def insertPushFolded (b0 w : ℕ) : _root_.BinaryTree ℕ → _root_.BinaryTree ℕ
  | .nil => .node w .nil .nil
  | .node k l r =>
      if k = b0 then .node k (.node w .nil l) r
      else .node k (insertPushFolded b0 w l) r

def rotateRightOnLeftSpine (u : ℕ) : _root_.BinaryTree ℕ → _root_.BinaryTree ℕ
  | .node y (.node x a b) c =>
      if x = u then .node x a (.node y b c)
      else .node y (rotateRightOnLeftSpine u (.node x a b)) c
  | t => t

def spliceMinNat : _root_.BinaryTree ℕ → _root_.BinaryTree ℕ
  | .nil => .nil
  | .node _ .nil r => r
  | .node k l@(.node _ _ _) r => .node k (spliceMinNat l) r

def lcrsParentAux (P curP v : ℕ) : _root_.BinaryTree ℕ → ℕ
  | .nil => P
  | .node k l r =>
      if v < k then lcrsParentAux P k v l
      else if k < v then lcrsParentAux P curP v r
      else curP

def lcrsParent (P : ℕ) (t : _root_.BinaryTree ℕ) (v : ℕ) : ℕ :=
  lcrsParentAux P P v t

structure JumpRecord where
  id : ℕ
  step : ℕ
  s : ℕ
  j : ℕ
  m : ℕ
  x : ℕ
  y : ℕ
  z : ℕ
  deriving DecidableEq, Repr, Inhabited

def popJumpsAt (nextId step s : ℕ) (ls : List ℕ) : List JumpRecord :=
  let m := (ls.length - 2) / 2
  (List.range m).map (fun j =>
    { id := nextId + j
      step := step
      s := s
      j := j
      m := m
      x := ls.getD (2 * j + 1) 0
      y := ls.getD (2 * j + 2) 0
      z := ls.getD (2 * j + 3) 0 })

def jumpsAux : ℕ → ℕ → _root_.BinaryTree ℕ → List KeyedCoreOp → List JumpRecord
  | _, _, _, [] => []
  | nextId, step, H, op :: rest =>
      match op with
      | .pop s =>
          let js := popJumpsAt nextId step s (leftSpineBottomUpNat H)
          js ++ jumpsAux (nextId + js.length) (step + 1) (execKeyedOp H op) rest
      | _ =>
          jumpsAux nextId (step + 1) (execKeyedOp H op) rest

def jumps (kops : List KeyedCoreOp) : List JumpRecord :=
  jumpsAux 0 0 .nil kops

def prevWinOpt (kops : List KeyedCoreOp) (id : ℕ) : Option JumpRecord :=
  match (jumps kops)[id]? with
  | none => none
  | some e => ((jumps kops).take id).reverse.find? (fun e' => e'.x == e.x)

def prevWin (kops : List KeyedCoreOp) (id : ℕ) : ℕ :=
  match prevWinOpt kops id with
  | none => 0
  | some eL => eL.id

def upperPrevWin (kops : List KeyedCoreOp) (id : ℕ) : ℕ :=
  prevWin kops id + 1

def isRmergeOnAt (kops : List KeyedCoreOp) (t x : ℕ) : Bool :=
  match kops[t]? with
  | some (.rslr (d + 1)) =>
      (rightSpineTopDownNat (keyedState kops t)).getD d (x + 1) == x
  | _ => false

def isMBase (kops : List KeyedCoreOp) (id : ℕ) : Bool :=
  match (jumps kops)[id]? with
  | none => false
  | some e =>
      match prevWinOpt kops id with
      | none => true
      | some eL =>
          decide (eL.j + 1 = eL.m) ||
            (List.Ico (eL.step + 1) e.step).any (fun t => isRmergeOnAt kops t e.x)

def MBaseSet (kops : List KeyedCoreOp) : Finset ℕ :=
  (Finset.range (jumps kops).length).filter (fun id => isMBase kops id = true)

structure FoldedCoreLaws (P : ℕ) (kops : List KeyedCoreOp) : Prop where
  fold_bst_inorder : ∀ t ≤ kops.length,
    _root_.BinaryTree.IsBST (foldBST P (keyedState kops t)).1 ∧
      inorderNat (foldBST P (keyedState kops t)).1 = inorderNat (keyedState kops t)
  fold_cursor : ∀ t ≤ kops.length,
    (keyedState kops t = .nil ∧ (foldBST P (keyedState kops t)).2 = P) ∨
      (keyedState kops t ≠ .nil ∧
        (rightSpineTopDownNat (keyedState kops t)).head? =
          some (foldBST P (keyedState kops t)).2 ∧
        (leftSpineBottomUpNat (keyedState kops t)).getLast? =
          some (foldBST P (keyedState kops t)).2)
  fold_leftSpine : ∀ t ≤ kops.length,
    leftSpineBottomUpNat (foldBST P (keyedState kops t)).1 =
      leftSpineBottomUpNat (keyedState kops t) ++
        (rightSpineTopDownNat (keyedState kops t)).tail
  fold_step_push : ∀ t (ht : t < kops.length) (w : ℕ),
    kops[t] = .push w →
      (foldBST P (keyedState kops (t + 1))).1 =
        insertPushFolded (foldBST P (keyedState kops t)).2 w
          (foldBST P (keyedState kops t)).1 ∧
      lcrsParent P (foldBST P (keyedState kops (t + 1))).1 w =
        (foldBST P (keyedState kops t)).2 ∧
      ∀ v, v ≠ w →
        lcrsParent P (foldBST P (keyedState kops (t + 1))).1 v =
          lcrsParent P (foldBST P (keyedState kops t)).1 v
  fold_step_rslr_zero : ∀ t (ht : t < kops.length),
    kops[t] = .rslr 0 →
      (foldBST P (keyedState kops (t + 1))).1 = (foldBST P (keyedState kops t)).1
  fold_step_rslr_succ : ∀ t (ht : t < kops.length) (d : ℕ),
    kops[t] = .rslr (d + 1) →
      let rs := rightSpineTopDownNat (keyedState kops t)
      let u := rs.getD d 0
      let p := rs.getD (d + 1) 0
      u ∈ inorderNat (keyedState kops t) ∧
        p ∈ inorderNat (keyedState kops t) ∧
        u < p ∧
        (foldBST P (keyedState kops (t + 1))).1 =
          rotateRightOnLeftSpine u (foldBST P (keyedState kops t)).1 ∧
        lcrsParent P (foldBST P (keyedState kops t)).1 u = p ∧
        lcrsParent P (foldBST P (keyedState kops (t + 1))).1 u =
          lcrsParent P (foldBST P (keyedState kops t)).1 p ∧
        ∀ w, w ≠ u →
          lcrsParent P (foldBST P (keyedState kops (t + 1))).1 w =
            lcrsParent P (foldBST P (keyedState kops t)).1 w
  fold_step_pop : ∀ t (ht : t < kops.length) (s : ℕ),
    kops[t] = .pop s →
      (foldBST P (keyedState kops (t + 1))).1 =
        (popJumpsAt 0 t s (leftSpineBottomUpNat (keyedState kops t))).foldl
          (fun T e => rotateRightOnLeftSpine e.x T)
          (spliceMinNat (foldBST P (keyedState kops t)).1) ∧
      ∀ v ∈ inorderNat (keyedState kops (t + 1)),
        (∀ id (hid : id < (jumps kops).length),
          ((jumps kops)[id]).step = t → v ≠ ((jumps kops)[id]).x) →
        lcrsParent P (foldBST P (keyedState kops (t + 1))).1 v =
          lcrsParent P (foldBST P (keyedState kops t)).1 v
  pop_step_jumps : ∀ t (ht : t < kops.length) (s : ℕ),
    kops[t] = .pop s →
      ∃ baseId,
        let m := ((leftSpineBottomUpNat (keyedState kops t)).length - 2) / 2
        baseId + m ≤ (jumps kops).length ∧
          ∀ id (hid : id < (jumps kops).length),
            (((jumps kops)[id]).step = t ↔ baseId ≤ id ∧ id < baseId + m)
  jump_props : ∀ id (hid : id < (jumps kops).length),
    let e := (jumps kops)[id]
    e.id = id ∧
      e.step < kops.length ∧ kops[e.step]? = some (.pop e.s) ∧
      e.j < e.m ∧ e.s < e.x ∧ e.x < e.y ∧ e.y < e.z ∧ e.z < P ∧
      (let ls := leftSpineBottomUpNat (keyedState kops e.step)
       e.m = (ls.length - 2) / 2 ∧
         ls[0]? = some e.s ∧
         ls[2 * e.j + 1]? = some e.x ∧
         ls[2 * e.j + 2]? = some e.y ∧
         ls[2 * e.j + 3]? = some e.z) ∧
      lcrsParent P (foldBST P (keyedState kops e.step)).1 e.x = e.y ∧
      lcrsParent P (foldBST P (keyedState kops e.step)).1 e.y = e.z ∧
      lcrsParent P (foldBST P (keyedState kops (e.step + 1))).1 e.x = e.z ∧
      (e.j + 1 < e.m →
        ∃ hid' : id + 1 < (jumps kops).length,
          let e' := (jumps kops)[id + 1]
          e'.step = e.step ∧ e'.s = e.s ∧ e'.j = e.j + 1 ∧ e'.m = e.m ∧ e'.x = e.z)
  lcrs_bounds : ∀ t ≤ kops.length, ∀ v ∈ inorderNat (keyedState kops t),
    v < lcrsParent P (foldBST P (keyedState kops t)).1 v ∧
      lcrsParent P (foldBST P (keyedState kops t)).1 v ≤ P ∧
      (lcrsParent P (foldBST P (keyedState kops t)).1 v = P ∨
        lcrsParent P (foldBST P (keyedState kops t)).1 v ∈ inorderNat (keyedState kops t))
  lcrs_top : ∀ t ≤ kops.length, lcrsParent P (foldBST P (keyedState kops t)).1 P = P
  lcrs_mono : ∀ t < kops.length, ∀ v ∈ inorderNat (keyedState kops t),
    v ∈ inorderNat (keyedState kops (t + 1)) →
      lcrsParent P (foldBST P (keyedState kops t)).1 v ≤
        lcrsParent P (foldBST P (keyedState kops (t + 1))).1 v
  spine_lock : ∀ id (hid : id < (jumps kops).length),
    let e := (jumps kops)[id]
    ∀ t, e.step + 1 ≤ t → t ≤ popStep kops e.x →
      e.x ∈ leftSpineBottomUpNat (foldBST P (keyedState kops t)).1 ∧
        (∀ u ∈ leftSpineBottomUpNat (foldBST P (keyedState kops t)).1,
          ¬(e.x < u ∧ u < e.z)) ∧
        (∀ w, kops[t]? = some (.push w) → w < e.x)
  outside_mbase : ∀ id (hid : id < (jumps kops).length),
    id ∉ MBaseSet kops →
      ∃ (hidL : prevWin kops id < (jumps kops).length)
        (hidR : upperPrevWin kops id < (jumps kops).length),
        prevWin kops id + 1 = upperPrevWin kops id ∧
          upperPrevWin kops id < id ∧
          let e := (jumps kops)[id]
          let eL := (jumps kops)[prevWin kops id]
          let eR := (jumps kops)[upperPrevWin kops id]
          eL.x = e.x ∧ eL.z = e.y ∧ eR.x = e.y ∧
            eL.step = eR.step ∧ eL.s = eR.s ∧ eL.step < e.step ∧
            (∀ id' (hid' : id' < id),
              ((jumps kops)[id']'(lt_trans hid' hid)).x = e.x → id' ≤ prevWin kops id)
  prevWin_inj : ∀ id1 < (jumps kops).length, id1 ∉ MBaseSet kops →
    ∀ id2 < (jumps kops).length, id2 ∉ MBaseSet kops →
      prevWin kops id1 = prevWin kops id2 → id1 = id2
  upperPrevWin_inj : ∀ id1 < (jumps kops).length, id1 ∉ MBaseSet kops →
    ∀ id2 < (jumps kops).length, id2 ∉ MBaseSet kops →
      upperPrevWin kops id1 = upperPrevWin kops id2 → id1 = id2

def splitBlock (S_next lo hi : ℕ) : List (ℕ × ℕ) :=
  let K := (hi - lo) / S_next
  if K ≤ 1 then [(lo, hi)]
  else
    (List.range (K - 1)).map (fun c => (lo + c * S_next, lo + (c + 1) * S_next)) ++
      [(lo + (K - 1) * S_next, hi)]

def scaleBlocks (S : ℕ → ℕ) (P : ℕ) : ℕ → List (ℕ × ℕ)
  | 0 => [(0, P)]
  | ℓ + 1 => (scaleBlocks S P ℓ).flatMap (fun b => splitBlock (S (ℓ + 1)) b.1 b.2)

def blockIdx (S : ℕ → ℕ) (P ℓ u : ℕ) : ℕ :=
  (scaleBlocks S P ℓ).findIdx (fun b => decide (b.1 ≤ u ∧ u < b.2))

def blockOf (S : ℕ → ℕ) (P ℓ u : ℕ) : ℕ × ℕ :=
  (scaleBlocks S P ℓ).getD (blockIdx S P ℓ u) (0, 0)

def sepScale (S : ℕ → ℕ) (P L u v : ℕ) : ℕ :=
  if P ≤ u ∨ P ≤ v then 0
  else
    match (List.Ico 1 (L + 1)).find? (fun ℓ => blockIdx S P ℓ u != blockIdx S P ℓ v) with
    | some ℓ => ℓ
    | none => L + 1

def tEmpty (kops : List KeyedCoreOp) (lo_p hi_p : ℕ) : ℕ :=
  let ts := popStep kops lo_p
  let te := popStep kops (hi_p - 1) + 1
  match (List.Ico ts (te + 1)).find? (fun t =>
    (inorderNat (keyedState kops t)).all (fun v => decide (v < lo_p ∨ hi_p ≤ v))) with
  | some t => t
  | none => te

def isBFinPre (S : ℕ → ℕ) (P L : ℕ) (kops : List KeyedCoreOp) (id : ℕ) : Bool :=
  match (jumps kops)[id]? with
  | none => false
  | some e => decide (sepScale S P L e.x e.y = L + 1 ∧ e.s < (blockOf S P L e.x).1)

def B_fin_pre (S : ℕ → ℕ) (P L : ℕ) (kops : List KeyedCoreOp) : Finset ℕ :=
  (Finset.range (jumps kops).length).filter (fun id => isBFinPre S P L kops id = true)

def isBFinExit (S : ℕ → ℕ) (P L : ℕ) (kops : List KeyedCoreOp) (id : ℕ) : Bool :=
  match (jumps kops)[id]? with
  | none => false
  | some e =>
      decide (sepScale S P L e.x e.y = L + 1 ∧
        (blockOf S P L e.x).1 ≤ e.s ∧ (blockOf S P L e.x).2 ≤ e.z)

def B_fin_exit (S : ℕ → ℕ) (P L : ℕ) (kops : List KeyedCoreOp) : Finset ℕ :=
  (Finset.range (jumps kops).length).filter (fun id => isBFinExit S P L kops id = true)

def isBFinAct (S : ℕ → ℕ) (P L : ℕ) (kops : List KeyedCoreOp) (id : ℕ) : Bool :=
  match (jumps kops)[id]? with
  | none => false
  | some e =>
      decide (sepScale S P L e.x e.y = L + 1 ∧
        (blockOf S P L e.x).1 ≤ e.s ∧ e.z < (blockOf S P L e.x).2)

def B_fin_act (S : ℕ → ℕ) (P L : ℕ) (kops : List KeyedCoreOp) : Finset ℕ :=
  (Finset.range (jumps kops).length).filter (fun id => isBFinAct S P L kops id = true)

def isB1 (S : ℕ → ℕ) (P L : ℕ) (kops : List KeyedCoreOp) (id : ℕ) : Bool :=
  match (jumps kops)[id]? with
  | none => false
  | some e =>
      let ℓ := sepScale S P L e.x e.y
      decide (1 ≤ ℓ ∧ ℓ ≤ L ∧ sepScale S P L e.s e.x < ℓ)

def B_1 (S : ℕ → ℕ) (P L : ℕ) (kops : List KeyedCoreOp) : Finset ℕ :=
  (Finset.range (jumps kops).length).filter (fun id => isB1 S P L kops id = true)

def isB2 (S : ℕ → ℕ) (P L : ℕ) (kops : List KeyedCoreOp) (id : ℕ) : Bool :=
  match (jumps kops)[id]? with
  | none => false
  | some e =>
      let ℓ := sepScale S P L e.x e.y
      decide (1 ≤ ℓ ∧ ℓ ≤ L ∧ ℓ < sepScale S P L e.s e.x)

def B_2 (S : ℕ → ℕ) (P L : ℕ) (kops : List KeyedCoreOp) : Finset ℕ :=
  (Finset.range (jumps kops).length).filter (fun id => isB2 S P L kops id = true)

def isB3Intra (S : ℕ → ℕ) (P L : ℕ) (kops : List KeyedCoreOp) (id : ℕ) : Bool :=
  match (jumps kops)[id]? with
  | none => false
  | some e =>
      let ℓ := sepScale S P L e.x e.y
      decide (1 ≤ ℓ ∧ ℓ ≤ L ∧ sepScale S P L e.s e.x = ℓ ∧
        e.z < (blockOf S P ℓ e.y).2)

def B_3_intra (S : ℕ → ℕ) (P L : ℕ) (kops : List KeyedCoreOp) : Finset ℕ :=
  (Finset.range (jumps kops).length).filter (fun id => isB3Intra S P L kops id = true)

def isB3Post (S : ℕ → ℕ) (P L : ℕ) (kops : List KeyedCoreOp) (id : ℕ) : Bool :=
  match (jumps kops)[id]? with
  | none => false
  | some e =>
      let ℓ := sepScale S P L e.x e.y
      let bs := blockOf S P ℓ e.s
      decide (1 ≤ ℓ ∧ ℓ ≤ L ∧ sepScale S P L e.s e.x = ℓ ∧
        (blockOf S P ℓ e.y).2 ≤ e.z ∧ tEmpty kops bs.1 bs.2 ≤ e.step)

def B_3_post (S : ℕ → ℕ) (P L : ℕ) (kops : List KeyedCoreOp) : Finset ℕ :=
  (Finset.range (jumps kops).length).filter (fun id => isB3Post S P L kops id = true)

def isB3Act (S : ℕ → ℕ) (P L : ℕ) (kops : List KeyedCoreOp) (id : ℕ) : Bool :=
  match (jumps kops)[id]? with
  | none => false
  | some e =>
      let ℓ := sepScale S P L e.x e.y
      let bs := blockOf S P ℓ e.s
      decide (1 ≤ ℓ ∧ ℓ ≤ L ∧ sepScale S P L e.s e.x = ℓ ∧
        (blockOf S P ℓ e.y).2 ≤ e.z ∧ e.step < tEmpty kops bs.1 bs.2)

def B_3_act (S : ℕ → ℕ) (P L : ℕ) (kops : List KeyedCoreOp) : Finset ℕ :=
  (Finset.range (jumps kops).length).filter (fun id => isB3Act S P L kops id = true)

structure ScalePartitionLaws (S : ℕ → ℕ) (P L : ℕ) : Prop where
  blocks_sum : ∀ ℓ ≤ L, ((scaleBlocks S P ℓ).map (fun b => b.2 - b.1)).sum = P
  blocks_bounds : ∀ ℓ ≤ L, ∀ b ∈ scaleBlocks S P ℓ,
    b.1 < b.2 ∧ b.2 ≤ P ∧ S ℓ ≤ b.2 - b.1 ∧ b.2 - b.1 < 2 * S ℓ
  blocks_partition : ∀ ℓ ≤ L, ∀ u < P,
    blockIdx S P ℓ u < (scaleBlocks S P ℓ).length ∧
      (blockOf S P ℓ u).1 ≤ u ∧ u < (blockOf S P ℓ u).2 ∧
      (scaleBlocks S P ℓ)[blockIdx S P ℓ u]? = some (blockOf S P ℓ u)
  blocks_eq_iff : ∀ ℓ ≤ L, ∀ u < P, ∀ v < P,
    (blockIdx S P ℓ u = blockIdx S P ℓ v ↔
      (blockOf S P ℓ u).1 ≤ v ∧ v < (blockOf S P ℓ u).2)
  blocks_mono : ∀ ℓ ≤ L, ∀ u v, u ≤ v → v < P → blockIdx S P ℓ u ≤ blockIdx S P ℓ v
  child_blocks : ∀ ℓ, 1 ≤ ℓ → ℓ ≤ L → ∀ Xi < (scaleBlocks S P (ℓ - 1)).length,
    let X := (scaleBlocks S P (ℓ - 1)).getD Xi (0, 0)
    let subs := splitBlock (S ℓ) X.1 X.2
    2 ≤ subs.length ∧
      (subs.getD 0 (0, 0)).1 = X.1 ∧
      (subs.getD (subs.length - 1) (0, 0)).2 = X.2 ∧
      (∀ c < subs.length,
        let sc := subs.getD c (0, 0)
        X.1 ≤ sc.1 ∧ sc.1 < sc.2 ∧ sc.2 ≤ X.2 ∧ S ℓ ≤ sc.2 - sc.1 ∧ sc.2 - sc.1 < 2 * S ℓ) ∧
      (∀ c, c + 1 < subs.length →
        (subs.getD c (0, 0)).2 = (subs.getD (c + 1) (0, 0)).1) ∧
      (∀ u < P, (blockIdx S P (ℓ - 1) u = Xi ↔ X.1 ≤ u ∧ u < X.2)) ∧
      (∀ u, X.1 ≤ u → u < X.2 →
        let c := subs.findIdx (fun b => decide (b.1 ≤ u ∧ u < b.2))
        c < subs.length ∧ subs.getD c (0, 0) = blockOf S P ℓ u) ∧
      (∀ u1, X.1 ≤ u1 → u1 < X.2 → ∀ u2, X.1 ≤ u2 → u2 < X.2 →
        (subs.findIdx (fun b => decide (b.1 ≤ u1 ∧ u1 < b.2)) =
          subs.findIdx (fun b => decide (b.1 ≤ u2 ∧ u2 < b.2)) ↔
            blockIdx S P ℓ u1 = blockIdx S P ℓ u2))
  finest_count_bound : L * (scaleBlocks S P L).length ≤ P
  sep_symm : ∀ u v, sepScale S P L u v = sepScale S P L v u
  sep_top : ∀ u, sepScale S P L u P = 0 ∧ sepScale S P L P u = 0
  sep_range : ∀ u < P, ∀ v < P, u ≠ v → 1 ≤ sepScale S P L u v ∧ sepScale S P L u v ≤ L + 1
  sep_self : ∀ u < P, sepScale S P L u u = L + 1
  sep_gt_iff : ∀ m ≤ L, ∀ u < P, ∀ v < P,
    (m < sepScale S P L u v ↔ blockIdx S P m u = blockIdx S P m v)
  sep_ultrametric : ∀ a b c, a ≤ b → b ≤ c → c < P →
    sepScale S P L a c = min (sepScale S P L a b) (sepScale S P L b c)

def isVAct (S : ℕ → ℕ) (P L : ℕ) (kops : List KeyedCoreOp) (ℓ Xi p id : ℕ) : Bool :=
  let X := (scaleBlocks S P (ℓ - 1)).getD Xi (0, 0)
  let sp := (splitBlock (S ℓ) X.1 X.2).getD p (0, 0)
  match (jumps kops)[id]? with
  | none => false
  | some e =>
      decide (sepScale S P L e.x e.y = ℓ ∧
        blockIdx S P (ℓ - 1) e.x = Xi ∧
        sp.1 ≤ e.s ∧ e.s < sp.2)

def VActSet (S : ℕ → ℕ) (P L : ℕ) (kops : List KeyedCoreOp) (ℓ Xi p : ℕ) : Finset ℕ :=
  (B_3_act S P L kops).filter (fun id => isVAct S P L kops ℓ Xi p id = true)

def MMovSet (S : ℕ → ℕ) (P L : ℕ) (kops : List KeyedCoreOp) (ℓ Xi p : ℕ) : Finset ℕ :=
  let X := (scaleBlocks S P (ℓ - 1)).getD Xi (0, 0)
  (VActSet S P L kops ℓ Xi p).image (fun id =>
    match (jumps kops)[id]? with
    | none => 0
    | some e => (splitBlock (S ℓ) X.1 X.2).findIdx (fun b => decide (b.1 ≤ e.x ∧ e.x < b.2)))

def totalMMovCount (S : ℕ → ℕ) (P L : ℕ) (kops : List KeyedCoreOp) : ℕ :=
  (Finset.Icc 1 L).sum (fun ℓ =>
    (Finset.range (scaleBlocks S P (ℓ - 1)).length).sum (fun Xi =>
      let X := (scaleBlocks S P (ℓ - 1)).getD Xi (0, 0)
      let KX := (splitBlock (S ℓ) X.1 X.2).length
      (Finset.range (KX - 1)).sum (fun p =>
        (MMovSet S P L kops ℓ Xi p).card)))

def restrictRangeNat (lo hi : ℕ) : _root_.BinaryTree ℕ → _root_.BinaryTree ℕ
  | .nil => .nil
  | .node k l r =>
      if k < lo then restrictRangeNat lo hi r
      else if hi ≤ k then restrictRangeNat lo hi l
      else .node k (restrictRangeNat lo hi l) (restrictRangeNat lo hi r)

def minBirthKey (birth : ℕ → ℕ) (lo hi : ℕ) : ℕ :=
  (List.Ico (lo + 1) hi).foldl
    (fun best k => if birth k < birth best then k else best) lo

def cartesianRangeAux (birth : ℕ → ℕ) : ℕ → ℕ → ℕ → _root_.BinaryTree ℕ
  | 0, _, _ => .nil
  | fuel + 1, lo, hi =>
      if lo < hi then
        let w := min (max lo (minBirthKey birth lo hi)) (hi - 1)
        .node w (cartesianRangeAux birth fuel lo w) (cartesianRangeAux birth fuel (w + 1) hi)
      else
        .nil

def cartesianRangeNat (birth : ℕ → ℕ) (lo hi : ℕ) : _root_.BinaryTree ℕ :=
  cartesianRangeAux birth (hi - lo) lo hi

def plugUnbornNat (birth : ℕ → ℕ) (lo hi : ℕ) : _root_.BinaryTree ℕ → _root_.BinaryTree ℕ
  | .nil => cartesianRangeNat birth lo hi
  | .node k l r => .node k (plugUnbornNat birth lo k l) (plugUnbornNat birth (k + 1) hi r)

def rightmostKeyNat (cur : ℕ) : _root_.BinaryTree ℕ → ℕ
  | .nil => cur
  | .node k _ r => rightmostKeyNat k r

def subtreeMaxNat : _root_.BinaryTree ℕ → ℕ → ℕ
  | .nil, v => v
  | .node k l r, v =>
      if v < k then subtreeMaxNat l v
      else if k < v then subtreeMaxNat r v
      else rightmostKeyNat k r

structure BlockQuotientData where
  G_init : ℕ → _root_.BinaryTree ℕ
  G_end : ℕ → _root_.BinaryTree ℕ
  F_idx : ℕ → List ℕ
  u_gap : ℕ → List ℕ

instance : Inhabited BlockQuotientData :=
  ⟨⟨fun _ => .nil, fun _ => .nil, fun _ => [], fun _ => []⟩⟩

structure ValidBlockQuotientPkg (N_X : ℕ) (pkg : BlockQuotientData) : Prop where
  bst_init : ∀ p < N_X, _root_.BinaryTree.IsBST (pkg.G_init p)
  bst_end : ∀ p < N_X, _root_.BinaryTree.IsBST (pkg.G_end p)
  inorder_init : ∀ p < N_X, inorderNat (pkg.G_init p) = List.Ico (p + 1) (N_X + 1)
  inorder_end : ∀ p < N_X, inorderNat (pkg.G_end p) = List.Ico (p + 1) (N_X + 1)
  reach_mono : ∀ p < N_X, ∀ c, p + 1 ≤ c → c ≤ N_X →
    subtreeMaxNat (pkg.G_init p) c ≤ subtreeMaxNat (pkg.G_end p) c
  f_strictMono : ∀ p < N_X, List.Pairwise (· < ·) (pkg.F_idx p)
  f_lt_last : ∀ p < N_X, ∀ ia ∈ pkg.F_idx p,
    ia + 1 < (leftSpineBottomUpNat (pkg.G_init p)).length
  run_dom : ∀ p < N_X, ∀ ia ∈ pkg.F_idx p,
    subtreeMaxNat (pkg.G_init p) ((leftSpineBottomUpNat (pkg.G_init p)).getD (ia + 1) 0) ≤
      subtreeMaxNat (pkg.G_end p) ((leftSpineBottomUpNat (pkg.G_init p)).getD ia 0)
  u_gap_len : ∀ p < N_X, (pkg.u_gap p).length = (pkg.F_idx p).length - 1
  gap_bound : ∀ p < N_X, ∀ r, r + 1 < (pkg.F_idx p).length →
    (pkg.F_idx p).getD (r + 1) 0 - (pkg.F_idx p).getD r 0 - 1 ≤
      3 + (pkg.u_gap p).getD r 0
  phase_dom : ∀ p, p + 1 < N_X → ∀ c, p + 2 ≤ c → c ≤ N_X →
    subtreeMaxNat (restrictRangeNat (p + 2) (N_X + 1) (pkg.G_end p)) c ≤
      subtreeMaxNat (pkg.G_init (p + 1)) c

def totalGapWeight (S : ℕ → ℕ) (P L : ℕ) (pkgs : ℕ → ℕ → BlockQuotientData) : ℕ :=
  (Finset.Icc 1 L).sum (fun ℓ =>
    (Finset.range (scaleBlocks S P (ℓ - 1)).length).sum (fun Xi =>
      let X := (scaleBlocks S P (ℓ - 1)).getD Xi (0, 0)
      let NX := (splitBlock (S ℓ) X.1 X.2).length - 1
      (Finset.range NX).sum (fun p => ((pkgs ℓ Xi).u_gap p).sum)))

def totalPkgMovers (S : ℕ → ℕ) (P L : ℕ) (pkgs : ℕ → ℕ → BlockQuotientData) : ℕ :=
  (Finset.Icc 1 L).sum (fun ℓ =>
    (Finset.range (scaleBlocks S P (ℓ - 1)).length).sum (fun Xi =>
      let X := (scaleBlocks S P (ℓ - 1)).getD Xi (0, 0)
      let NX := (splitBlock (S ℓ) X.1 X.2).length - 1
      (Finset.range NX).sum (fun p => ((pkgs ℓ Xi).F_idx p).length)))
def execRightRotSeq : _root_.BinaryTree Unit → List RightRotOp → _root_.BinaryTree Unit
  | t, [] => t
  | t, op :: rest => execRightRotSeq (execRightRotOp t op) rest

def rightReachList : ℕ → _root_.BinaryTree Unit → List ℕ
  | _, .nil => []
  | a, .node _ l r =>
      let x := a + l.num_nodes
      rightReachList a l ++ [x + r.num_nodes] ++ rightReachList (x + 1) r

def eraseKeys {α : Type} : _root_.BinaryTree α → _root_.BinaryTree Unit
  | .nil => .nil
  | .node _ l r => .node () (eraseKeys l) (eraseKeys r)

def IsRangeBST : ℕ → _root_.BinaryTree ℕ → Prop
  | _, .nil => True
  | a, .node k l r =>
      k = a + l.num_nodes ∧ IsRangeBST a l ∧ IsRangeBST (k + 1) r

def labelRange : ℕ → _root_.BinaryTree Unit → _root_.BinaryTree ℕ
  | _, .nil => .nil
  | a, .node _ l r =>
      let k := a + l.num_nodes
      .node k (labelRange a l) (labelRange (k + 1) r)

def subtreeAtLeftDepthGen {α : Type} : _root_.BinaryTree α → ℕ → _root_.BinaryTree α
  | t, 0 => t
  | .nil, _ + 1 => .nil
  | .node _ l _, d + 1 => subtreeAtLeftDepthGen l d

def applyAtLeftDepthGen {α : Type} (f : _root_.BinaryTree α → _root_.BinaryTree α) :
    _root_.BinaryTree α → ℕ → _root_.BinaryTree α
  | t, 0 => f t
  | .nil, _ + 1 => .nil
  | .node k l r, d + 1 => .node k (applyAtLeftDepthGen f l d) r

def execGappedCascadeAtRootGen {α : Type} : _root_.BinaryTree α → List ℕ → _root_.BinaryTree α
  | t, [] => _root_.BinaryTree.rotateRight t
  | .node k2 (.node k1 a b) c, g :: rest =>
      let a' := applyAtLeftDepthGen (fun s => execGappedCascadeAtRootGen s rest) a g
      .node k1 a' (.node k2 b c)
  | t, _ :: _ => t

def subtreeAtPosGen {α : Type} : _root_.BinaryTree α → List Dir → _root_.BinaryTree α
  | t, [] => t
  | .nil, _ :: _ => .nil
  | .node _ l _, .L :: rest => subtreeAtPosGen l rest
  | .node _ _ r, .R :: rest => subtreeAtPosGen r rest

def applyAtPosGen {α : Type} (f : _root_.BinaryTree α → _root_.BinaryTree α) :
    _root_.BinaryTree α → List Dir → _root_.BinaryTree α
  | t, [] => f t
  | .nil, _ :: _ => .nil
  | .node k l r, .L :: rest => .node k (applyAtPosGen f l rest) r
  | .node k l r, .R :: rest => .node k l (applyAtPosGen f r rest)

def execRightRotOpGen {α : Type} (t : _root_.BinaryTree α) : RightRotOp → _root_.BinaryTree α
  | .single pos => applyAtPosGen _root_.BinaryTree.rotateRight t pos
  | .cascade pos gaps =>
      applyAtPosGen (fun s => execGappedCascadeAtRootGen s gaps) t pos

def restrictInterval (lo hi : ℕ) : _root_.BinaryTree ℕ → _root_.BinaryTree ℕ
  | .nil => .nil
  | .node k l r =>
      if k < lo then restrictInterval lo hi r
      else if hi ≤ k then restrictInterval lo hi l
      else .node k (restrictInterval lo hi l) (restrictInterval lo hi r)

def blockTree (S m : ℕ) (T : _root_.BinaryTree ℕ) : _root_.BinaryTree ℕ :=
  restrictInterval (m * S) ((m + 1) * S) T

def preorderList {α : Type} : _root_.BinaryTree α → List α
  | .nil => []
  | .node k l r => k :: (preorderList l ++ preorderList r)

def isGlobalKey (D S : ℕ) (T : _root_.BinaryTree ℕ) (k : ℕ) : Bool :=
  decide (k ∈ (preorderList (blockTree S (k / S) T)).take D)

def extractGlobalTree (isG : ℕ → Bool) : _root_.BinaryTree ℕ → _root_.BinaryTree ℕ
  | .nil => .nil
  | .node k l r =>
      let lG := extractGlobalTree isG l
      let rG := extractGlobalTree isG r
      if isG k then .node k lG rG
      else match lG with
        | .nil => rG
        | _ => lG

def globalTree (D S : ℕ) (T : _root_.BinaryTree ℕ) : _root_.BinaryTree Unit :=
  eraseKeys (extractGlobalTree (isGlobalKey D S T) T)

def allPairsInterblock (S : ℕ) : _root_.BinaryTree ℕ → List ℕ → Bool
  | .node y (.node x _ _) _, [] => decide (x / S < y / S)
  | .node y (.node x a _) _, g :: rest =>
      decide (x / S < y / S) && allPairsInterblock S (subtreeAtLeftDepthGen a g) rest
  | _, _ => false

def countPureInterblockCascades (S : ℕ) : _root_.BinaryTree ℕ → List RightRotOp → ℕ
  | _, [] => 0
  | T, .single pos :: rest =>
      countPureInterblockCascades S (execRightRotOpGen T (.single pos)) rest
  | T, .cascade pos gaps :: rest =>
      let hit := allPairsInterblock S (subtreeAtPosGen T pos) gaps
      (if hit then 1 else 0) +
        countPureInterblockCascades S (execRightRotOpGen T (.cascade pos gaps)) rest
def twMapTree {α β : Type} (f : α → β) : _root_.BinaryTree α → _root_.BinaryTree β
  | .nil => .nil
  | .node k l r => .node (f k) (twMapTree f l) (twMapTree f r)

def twEraseTree {α : Type} (t : _root_.BinaryTree α) : _root_.BinaryTree Unit :=
  twMapTree (fun _ => ()) t

def twMirrorTree {α : Type} : _root_.BinaryTree α → _root_.BinaryTree α
  | .nil => .nil
  | .node k l r => .node k (twMirrorTree r) (twMirrorTree l)

def twTreeMem {α : Type} (x : α) : _root_.BinaryTree α → Prop
  | .nil => False
  | .node k l r => x = k ∨ twTreeMem x l ∨ twTreeMem x r

def twDescendLeftPoly {α : Type} : _root_.BinaryTree α → List (α × _root_.BinaryTree α) →
    _root_.BinaryTree α × List (α × _root_.BinaryTree α)
  | .nil, acc => (.nil, acc)
  | .node _ .nil r, acc => (r, acc)
  | .node k l@(.node _ _ _) r, acc => twDescendLeftPoly l ((k, r) :: acc)

def twSplayLeftSpinePoly {α : Type} : _root_.BinaryTree α → List (α × _root_.BinaryTree α) → _root_.BinaryTree α
  | c, [] => c
  | c, [(k1, s1)] => .node k1 c s1
  | c, (k1, s1) :: (k2, s2) :: rest =>
      twSplayLeftSpinePoly (.node k1 c (.node k2 s1 s2)) rest

def twAttachPoly {α : Type} : _root_.BinaryTree α → List (α × _root_.BinaryTree α) → _root_.BinaryTree α
  | c, [] => c
  | c, (k, s) :: rest => twAttachPoly (.node k c s) rest

def twPopPoly {α : Type} (t : _root_.BinaryTree α) : _root_.BinaryTree α :=
  let (c, path) := twDescendLeftPoly t []
  twSplayLeftSpinePoly c path

def twEjectPoly {α : Type} (t : _root_.BinaryTree α) : _root_.BinaryTree α :=
  twMirrorTree (twPopPoly (twMirrorTree t))

def twToFrameL {α : Type} (p : α × _root_.BinaryTree α) : Frame α :=
  { dir := .L, key := p.1, sibling := p.2 }

def twMirrorDir : Dir → Dir
  | .L => .R
  | .R => .L

def twNegMirror {α : Type} (neg : α → α) (t : _root_.BinaryTree α) : _root_.BinaryTree α :=
  twMapTree neg (twMirrorTree t)

def twNegMirrorFrame {α : Type} (neg : α → α) (f : Frame α) : Frame α :=
  { dir := twMirrorDir f.dir, key := neg f.key, sibling := twNegMirror neg f.sibling }

inductive TwUDequeOp where
  | pop : TwUDequeOp
  | push : TwUDequeOp
  | eject : TwUDequeOp
  | inject : TwUDequeOp
  deriving DecidableEq, Repr

def twToUDequeOp {α : Type} : DequeOp α → TwUDequeOp
  | .pop => .pop
  | .push _ => .push
  | .eject => .eject
  | .inject _ => .inject

def twStepUDeque (t : _root_.BinaryTree Unit) : TwUDequeOp → _root_.BinaryTree Unit
  | .pop => popUnlabeled t
  | .push => .node () .nil t
  | .eject => twMirrorTree (popUnlabeled (twMirrorTree t))
  | .inject => .node () t .nil

def twCostUDeque (t : _root_.BinaryTree Unit) : TwUDequeOp → ℕ
  | .pop => leftSpineLen t - 1
  | .push => 0
  | .eject => rightSpineLen t - 1
  | .inject => 0

def TwValidUDequeSeq : _root_.BinaryTree Unit → List TwUDequeOp → Prop
  | _, [] => True
  | t, .pop :: rest => t ≠ .nil ∧ TwValidUDequeSeq (popUnlabeled t) rest
  | t, .push :: rest => TwValidUDequeSeq (.node () .nil t) rest
  | t, .eject :: rest =>
      t ≠ .nil ∧ TwValidUDequeSeq (twMirrorTree (popUnlabeled (twMirrorTree t))) rest
  | t, .inject :: rest => TwValidUDequeSeq (.node () t .nil) rest

def twUDequeSeqCost : _root_.BinaryTree Unit → List TwUDequeOp → ℕ
  | _, [] => 0
  | t, op :: rest => twCostUDeque t op + twUDequeSeqCost (twStepUDeque t op) rest

def twLabelInorderAux : _root_.BinaryTree Unit → ℕ → _root_.BinaryTree ℕ × ℕ
  | .nil, k => (.nil, k)
  | .node _ l r, k =>
      let (l', k1) := twLabelInorderAux l k
      let (r', k2) := twLabelInorderAux r (k1 + 1)
      (.node k1 l' r', k2)

inductive TwFate where
  | L : TwFate
  | M : TwFate
  | R : TwFate
  deriving DecidableEq, Repr

def twFateCode : TwFate → ℕ
  | .L => 0
  | .M => 1
  | .R => 2

def twMirrorFate : TwFate → TwFate
  | .L => .R
  | .M => .M
  | .R => .L

def twDualTree (C : _root_.BinaryTree TwFate) : _root_.BinaryTree TwFate :=
  twMapTree twMirrorFate (twMirrorTree C)

def twFateOf (Lm Rm x : ℚ) : TwFate :=
  if x ≤ Lm then .L else if x < Rm then .M else .R

def twFinalBounds : _root_.BinaryTree ℚ → ℚ → ℚ → List TwUDequeOp → ℚ × ℚ
  | _, L, R, [] => (L, R)
  | T, L, R, .push :: rest =>
      let q := match T.minKey? with | none => (L + R) / 2 | some x => (L + x) / 2
      twFinalBounds (.node q .nil T) L R rest
  | T, L, R, .inject :: rest =>
      let q := match T.maxKey? with | none => (L + R) / 2 | some z => (z + R) / 2
      twFinalBounds (.node q T .nil) L R rest
  | T, L, R, .pop :: rest =>
      twFinalBounds (twPopPoly T) (T.minKey?.getD L) R rest
  | T, L, R, .eject :: rest =>
      twFinalBounds (twEjectPoly T) L (T.maxKey?.getD R) rest

inductive TwCDequeOp where
  | pop : TwCDequeOp
  | push (f : TwFate) : TwCDequeOp
  | eject : TwCDequeOp
  | inject (f : TwFate) : TwCDequeOp
  deriving DecidableEq, Repr

def twEraseCDequeOp : TwCDequeOp → TwUDequeOp
  | .pop => .pop
  | .push _ => .push
  | .eject => .eject
  | .inject _ => .inject

def twBuildCops (Lm Rm : ℚ) : _root_.BinaryTree ℚ → ℚ → ℚ → List TwUDequeOp → List TwCDequeOp
  | _, _, _, [] => []
  | T, L, R, .push :: rest =>
      let q := match T.minKey? with | none => (L + R) / 2 | some x => (L + x) / 2
      .push (twFateOf Lm Rm q) :: twBuildCops Lm Rm (.node q .nil T) L R rest
  | T, L, R, .inject :: rest =>
      let q := match T.maxKey? with | none => (L + R) / 2 | some z => (z + R) / 2
      .inject (twFateOf Lm Rm q) :: twBuildCops Lm Rm (.node q T .nil) L R rest
  | T, L, R, .pop :: rest =>
      .pop :: twBuildCops Lm Rm (twPopPoly T) (T.minKey?.getD L) R rest
  | T, L, R, .eject :: rest =>
      .eject :: twBuildCops Lm Rm (twEjectPoly T) L (T.maxKey?.getD R) rest

def TwIsTriOrdered : _root_.BinaryTree TwFate → Prop
  | .nil => True
  | .node f l r =>
      _root_.SplayDeque.Direct.ForallTree (fun x => twFateCode x ≤ twFateCode f) l ∧
      _root_.SplayDeque.Direct.ForallTree (fun x => twFateCode f ≤ twFateCode x) r ∧
      TwIsTriOrdered l ∧ TwIsTriOrdered r

def twCountFate (target : TwFate) : _root_.BinaryTree TwFate → ℕ
  | .nil => 0
  | .node f l r => (if f = target then 1 else 0) + twCountFate target l + twCountFate target r

def TwValidCDequeSeq : _root_.BinaryTree TwFate → List TwCDequeOp → Prop
  | C, [] => TwIsTriOrdered C ∧ twCountFate .L C = 0 ∧ twCountFate .R C = 0
  | C, .pop :: rest =>
      TwIsTriOrdered C ∧ 1 ≤ twCountFate .L C ∧ TwValidCDequeSeq (twPopPoly C) rest
  | C, .push f :: rest =>
      TwIsTriOrdered C ∧ _root_.SplayDeque.Direct.ForallTree (fun x => twFateCode f ≤ twFateCode x) C ∧
      TwValidCDequeSeq (.node f .nil C) rest
  | C, .eject :: rest =>
      TwIsTriOrdered C ∧ 1 ≤ twCountFate .R C ∧ TwValidCDequeSeq (twEjectPoly C) rest
  | C, .inject f :: rest =>
      TwIsTriOrdered C ∧ _root_.SplayDeque.Direct.ForallTree (fun x => twFateCode x ≤ twFateCode f) C ∧
      TwValidCDequeSeq (.node f C .nil) rest

def twProjL : _root_.BinaryTree TwFate → _root_.BinaryTree Unit
  | .nil => .nil
  | .node .L l r => .node () (twProjL l) (twProjL r)
  | .node .M l _ => twProjL l
  | .node .R l _ => twProjL l

def twProjM : _root_.BinaryTree TwFate → _root_.BinaryTree Unit
  | .nil => .nil
  | .node .L _ r => twProjM r
  | .node .M l r => .node () (twProjM l) (twProjM r)
  | .node .R l _ => twProjM l

def twProjR : _root_.BinaryTree TwFate → _root_.BinaryTree Unit
  | .nil => .nil
  | .node .L _ r => twProjR r
  | .node .M _ r => twProjR r
  | .node .R l r => .node () (twProjR l) (twProjR r)

def twPhiMR (C : _root_.BinaryTree TwFate) : ℕ :=
  2 * leftSpineLen (twProjM C) + 2 * rightSpineLen (twProjM C) + 2 * leftSpineLen (twProjR C)

def twPhi2 (C : _root_.BinaryTree TwFate) : ℕ :=
  twPhiMR C + 2 * rightSpineLen (twProjL C)

def twLeftmostFate : _root_.BinaryTree TwFate → Option TwFate
  | .nil => none
  | .node k .nil _ => some k
  | .node _ l@(.node _ _ _) _ => twLeftmostFate l

def TwSortedPath : TwFate → List (TwFate × _root_.BinaryTree TwFate) → Prop
  | _, [] => True
  | cur, (k, _) :: rest => twFateCode cur ≤ twFateCode k ∧ TwSortedPath k rest

def twFilterProjL : List (TwFate × _root_.BinaryTree TwFate) → List (_root_.BinaryTree Unit)
  | [] => []
  | (.L, s) :: rest => twProjL s :: twFilterProjL rest
  | (.M, _) :: rest => twFilterProjL rest
  | (.R, _) :: rest => twFilterProjL rest

def twAttachUnit : _root_.BinaryTree Unit → List (_root_.BinaryTree Unit) → _root_.BinaryTree Unit
  | u, [] => u
  | u, r :: rest => twAttachUnit (.node () u r) rest

def twCountKeyM : List (TwFate × _root_.BinaryTree TwFate) → ℕ
  | [] => 0
  | (.M, _) :: rest => 1 + twCountKeyM rest
  | (.L, _) :: rest => twCountKeyM rest
  | (.R, _) :: rest => twCountKeyM rest

def twStepBudget : TwFate → ℕ
  | .R => 1
  | .M => 3
  | .L => 5

inductive TwExtCoreOp where
  | push : TwExtCoreOp
  | pop : TwExtCoreOp
  | rslr (d : ℕ) : TwExtCoreOp
  | inject : TwExtCoreOp
  deriving DecidableEq, Repr

def twExecExtCoreOp (u : _root_.BinaryTree Unit) : TwExtCoreOp → _root_.BinaryTree Unit
  | .push => .node () .nil u
  | .pop => popUnlabeled u
  | .rslr d => rotateLeftAtRightDepth u d
  | .inject => .node () u .nil

def twExtCascadeStepCost (u : _root_.BinaryTree Unit) : TwExtCoreOp → ℕ
  | .pop => (leftSpineLen u - 1) / 2
  | _ => 0

def TwValidExtCoreSeq : _root_.BinaryTree Unit → List TwExtCoreOp → Prop
  | u, [] => u = .nil
  | u, .push :: rest => TwValidExtCoreSeq (.node () .nil u) rest
  | u, .pop :: rest => u ≠ .nil ∧ TwValidExtCoreSeq (popUnlabeled u) rest
  | u, .rslr d :: rest =>
      d + 2 ≤ rightSpineLen u ∧ TwValidExtCoreSeq (rotateLeftAtRightDepth u d) rest
  | u, .inject :: rest => TwValidExtCoreSeq (.node () u .nil) rest

def TwValidExtSteps : _root_.BinaryTree Unit → List TwExtCoreOp → _root_.BinaryTree Unit → Prop
  | u, [], u' => u = u'
  | u, .push :: rest, u' => TwValidExtSteps (.node () .nil u) rest u'
  | u, .pop :: rest, u' => u ≠ .nil ∧ TwValidExtSteps (popUnlabeled u) rest u'
  | u, .rslr d :: rest, u' =>
      d + 2 ≤ rightSpineLen u ∧ TwValidExtSteps (rotateLeftAtRightDepth u d) rest u'
  | u, .inject :: rest, u' => TwValidExtSteps (.node () u .nil) rest u'

def twExtCoreCascadeCost : _root_.BinaryTree Unit → List TwExtCoreOp → ℕ
  | _, [] => 0
  | u, op :: rest => twExtCascadeStepCost u op + twExtCoreCascadeCost (twExecExtCoreOp u op) rest

def twCountExtPop : List TwExtCoreOp → ℕ
  | [] => 0
  | .pop :: rest => 1 + twCountExtPop rest
  | _ :: rest => twCountExtPop rest

def twCountExtPush : List TwExtCoreOp → ℕ
  | [] => 0
  | .push :: rest => 1 + twCountExtPush rest
  | _ :: rest => twCountExtPush rest

def twCountExtInject : List TwExtCoreOp → ℕ
  | [] => 0
  | .inject :: rest => 1 + twCountExtInject rest
  | _ :: rest => twCountExtInject rest

def twExtractPopRRslrs : List (TwFate × _root_.BinaryTree TwFate) → List TwExtCoreOp
  | [] => []
  | [_] => []
  | (k1, _) :: (k2, _) :: rest =>
      if k1 == .R && k2 == .R then
        .rslr rest.length :: twExtractPopRRslrs rest
      else
        twExtractPopRRslrs rest

def TwValidCoreSteps : _root_.BinaryTree Unit → List CoreOp → _root_.BinaryTree Unit → Prop
  | t, [], t' => t = t'
  | t, .push :: rest, t' => TwValidCoreSteps (.node () .nil t) rest t'
  | t, .pop :: rest, t' => t ≠ .nil ∧ TwValidCoreSteps (popUnlabeled t) rest t'
  | t, .rslr d :: rest, t' =>
      d + 2 ≤ rightSpineLen t ∧ TwValidCoreSteps (rotateLeftAtRightDepth t d) rest t'

def twRightChain : ℕ → _root_.BinaryTree Unit
  | 0 => .nil
  | k + 1 => .node () .nil (twRightChain k)

def twAppendRightmost : _root_.BinaryTree Unit → _root_.BinaryTree Unit → _root_.BinaryTree Unit
  | .nil, tl => tl
  | .node _ l r, tl => .node () l (twAppendRightmost r tl)

def twPullUpSeq : ℕ → List CoreOp
  | 0 => []
  | β + 1 => .rslr β :: twPullUpSeq β

def twShiftCoreOp : CoreOp → CoreOp
  | .rslr d => .rslr (d + 1)
  | op => op

def twBuildFromEmptyAux : ℕ → _root_.BinaryTree Unit → List CoreOp
  | 0, _ => []
  | _ + 1, .nil => []
  | fuel + 1, .node _ .nil r => twBuildFromEmptyAux fuel r ++ [.push]
  | fuel + 1, .node _ (.node _ a b) r =>
      twBuildFromEmptyAux fuel (.node () a (.node () b r)) ++ [.rslr 0]

def twBuildFromEmpty (t : _root_.BinaryTree Unit) : List CoreOp :=
  twBuildFromEmptyAux (2 * t.num_nodes - rightSpineLen t) t
def btbCascadeTopKey : _root_.BinaryTree ℕ → ℕ
  | .node y _ _ => y
  | .nil => 0

def btbCascadeBotKey : _root_.BinaryTree ℕ → List ℕ → ℕ
  | .node _ (.node x _ _) _, [] => x
  | .node _ (.node _ a _) _, g :: rest => btbCascadeBotKey (subtreeAtLeftDepthGen a g) rest
  | _, _ => 0

def btbIsIntrablock (S m : ℕ) (s : _root_.BinaryTree ℕ) (gaps : List ℕ) : Bool :=
  decide (btbCascadeBotKey s gaps / S = m ∧ btbCascadeTopKey s / S = m)

def btbCountIntrablock (S m : ℕ) : _root_.BinaryTree ℕ → List RightRotOp → ℕ
  | _, [] => 0
  | T, .single pos :: rest =>
      btbCountIntrablock S m (execRightRotOpGen T (.single pos)) rest
  | T, .cascade pos gaps :: rest =>
      (if btbIsIntrablock S m (subtreeAtPosGen T pos) gaps then 1 else 0) +
        btbCountIntrablock S m (execRightRotOpGen T (.cascade pos gaps)) rest

def btbIsTypeB (S : ℕ) (s : _root_.BinaryTree ℕ) (gaps : List ℕ) : Bool :=
  decide (btbCascadeBotKey s gaps / S < btbCascadeTopKey s / S) && !(allPairsInterblock S s gaps)

def btbCountTypeB (S : ℕ) : _root_.BinaryTree ℕ → List RightRotOp → ℕ
  | _, [] => 0
  | T, .single pos :: rest =>
      btbCountTypeB S (execRightRotOpGen T (.single pos)) rest
  | T, .cascade pos gaps :: rest =>
      (if btbIsTypeB S (subtreeAtPosGen T pos) gaps then 1 else 0) +
        btbCountTypeB S (execRightRotOpGen T (.cascade pos gaps)) rest

def btbSubtreeOffset (a : ℕ) : _root_.BinaryTree ℕ → List Dir → ℕ
  | _, [] => a
  | .nil, _ :: _ => a
  | .node _ l _, .L :: rest => btbSubtreeOffset a l rest
  | .node k _ r, .R :: rest => btbSubtreeOffset (k + 1) r rest

def btbProjectPos (lo hi : ℕ) : _root_.BinaryTree ℕ → List Dir → List Dir
  | _, [] => []
  | .nil, _ :: _ => []
  | .node k l _, .L :: rest =>
      if k < lo then []
      else if hi ≤ k then btbProjectPos lo hi l rest
      else .L :: btbProjectPos lo hi l rest
  | .node k _ r, .R :: rest =>
      if k < lo then btbProjectPos lo hi r rest
      else if hi ≤ k then []
      else .R :: btbProjectPos lo hi r rest

def btbCountDirL : List Dir → ℕ
  | [] => 0
  | .L :: rest => 1 + btbCountDirL rest
  | .R :: rest => btbCountDirL rest

def btbSumTruncLD (ld cap : ℕ) : _root_.BinaryTree ℕ → ℕ
  | .nil => 0
  | .node _ l r =>
      min ld cap + btbSumTruncLD (ld + 1) cap l + btbSumTruncLD ld cap r

def btbBlockPsi (D S m : ℕ) (T : _root_.BinaryTree ℕ) : ℕ :=
  let bt := blockTree S m T
  leftSpineLen (eraseKeys bt) + btbSumTruncLD 0 D bt

def btbTotalBlockPsi (D M S : ℕ) (T : _root_.BinaryTree ℕ) : ℕ :=
  (Finset.range M).sum (fun m => btbBlockPsi D S m T)
structure PrimalJumpLaws (P : ℕ) (kops : List KeyedCoreOp) : Prop where
  pop_step_jumps : ∀ t (ht : t < kops.length) (s : ℕ),
    kops[t] = .pop s →
      ∃ baseId,
        let m := ((leftSpineBottomUpNat (keyedState kops t)).length - 2) / 2
        baseId + m ≤ (jumps kops).length ∧
          ∀ id (hid : id < (jumps kops).length),
            (((jumps kops)[id]).step = t ↔ baseId ≤ id ∧ id < baseId + m)
  jump_order : ∀ id1 (hid1 : id1 < (jumps kops).length)
      id2 (hid2 : id2 < (jumps kops).length),
    id1 < id2 →
      ((jumps kops)[id1]).step < ((jumps kops)[id2]).step ∨
        (((jumps kops)[id1]).step = ((jumps kops)[id2]).step ∧
          ((jumps kops)[id1]).j < ((jumps kops)[id2]).j)
  jump_anatomies : ∀ id (hid : id < (jumps kops).length),
    let e := (jumps kops)[id]
    e.id = id ∧
      e.step < kops.length ∧ kops[e.step]? = some (.pop e.s) ∧
      e.j < e.m ∧ e.s < e.x ∧ e.x < e.y ∧ e.y < e.z ∧ e.z < P ∧
      (let ls := leftSpineBottomUpNat (keyedState kops e.step)
       e.m = (ls.length - 2) / 2 ∧
         ls[0]? = some e.s ∧
         ls[2 * e.j + 1]? = some e.x ∧
         ls[2 * e.j + 2]? = some e.y ∧
         ls[2 * e.j + 3]? = some e.z) ∧
      (e.j + 1 < e.m →
        ∃ hid' : id + 1 < (jumps kops).length,
          let e' := (jumps kops)[id + 1]
          e'.step = e.step ∧ e'.s = e.s ∧ e'.j = e.j + 1 ∧ e'.m = e.m ∧ e'.x = e.z)

structure ValidFoldedCoreLaws (P : ℕ) (kops : List KeyedCoreOp) : Prop where
  fold_bst_inorder : ∀ t ≤ kops.length,
    _root_.BinaryTree.IsBST (foldBST P (keyedState kops t)).1 ∧
      inorderNat (foldBST P (keyedState kops t)).1 = inorderNat (keyedState kops t)
  fold_cursor : ∀ t ≤ kops.length,
    (keyedState kops t = .nil ∧ (foldBST P (keyedState kops t)).2 = P) ∨
      (keyedState kops t ≠ .nil ∧
        (rightSpineTopDownNat (keyedState kops t)).head? =
          some (foldBST P (keyedState kops t)).2 ∧
        (leftSpineBottomUpNat (keyedState kops t)).getLast? =
          some (foldBST P (keyedState kops t)).2)
  fold_leftSpine : ∀ t ≤ kops.length,
    leftSpineBottomUpNat (foldBST P (keyedState kops t)).1 =
      leftSpineBottomUpNat (keyedState kops t) ++
        (rightSpineTopDownNat (keyedState kops t)).tail
  fold_step_push : ∀ t (ht : t < kops.length) (w : ℕ),
    kops[t] = .push w →
      (foldBST P (keyedState kops (t + 1))).1 =
        insertPushFolded (foldBST P (keyedState kops t)).2 w
          (foldBST P (keyedState kops t)).1 ∧
      lcrsParent P (foldBST P (keyedState kops (t + 1))).1 w =
        (foldBST P (keyedState kops t)).2 ∧
      ∀ v, v ≠ w →
        lcrsParent P (foldBST P (keyedState kops (t + 1))).1 v =
          lcrsParent P (foldBST P (keyedState kops t)).1 v
  fold_step_rslr_zero : ∀ t (ht : t < kops.length),
    kops[t] = .rslr 0 →
      (foldBST P (keyedState kops (t + 1))).1 = (foldBST P (keyedState kops t)).1
  fold_step_rslr_succ : ∀ t (ht : t < kops.length) (d : ℕ),
    kops[t] = .rslr (d + 1) →
      let rs := rightSpineTopDownNat (keyedState kops t)
      let u := rs.getD d 0
      let p := rs.getD (d + 1) 0
      u ∈ inorderNat (keyedState kops t) ∧
        p ∈ inorderNat (keyedState kops t) ∧
        u < p ∧
        (foldBST P (keyedState kops (t + 1))).1 =
          rotateRightOnLeftSpine u (foldBST P (keyedState kops t)).1 ∧
        lcrsParent P (foldBST P (keyedState kops t)).1 u = p ∧
        lcrsParent P (foldBST P (keyedState kops (t + 1))).1 u =
          lcrsParent P (foldBST P (keyedState kops t)).1 p ∧
        ∀ w, w ≠ u →
          lcrsParent P (foldBST P (keyedState kops (t + 1))).1 w =
            lcrsParent P (foldBST P (keyedState kops t)).1 w
  fold_step_pop : ∀ t (ht : t < kops.length) (s : ℕ),
    kops[t] = .pop s →
      (foldBST P (keyedState kops (t + 1))).1 =
        (popJumpsAt 0 t s (leftSpineBottomUpNat (keyedState kops t))).foldl
          (fun T e => rotateRightOnLeftSpine e.x T)
          (spliceMinNat (foldBST P (keyedState kops t)).1) ∧
      ∀ v ∈ inorderNat (keyedState kops (t + 1)),
        (∀ id (hid : id < (jumps kops).length),
          ((jumps kops)[id]).step = t → v ≠ ((jumps kops)[id]).x) →
        lcrsParent P (foldBST P (keyedState kops (t + 1))).1 v =
          lcrsParent P (foldBST P (keyedState kops t)).1 v
  jump_lcrs : ∀ id (hid : id < (jumps kops).length),
    let e := (jumps kops)[id]
    lcrsParent P (foldBST P (keyedState kops e.step)).1 e.x = e.y ∧
      lcrsParent P (foldBST P (keyedState kops e.step)).1 e.y = e.z ∧
      lcrsParent P (foldBST P (keyedState kops (e.step + 1))).1 e.x = e.z
  lcrs_bounds : ∀ t ≤ kops.length, ∀ v ∈ inorderNat (keyedState kops t),
    v < lcrsParent P (foldBST P (keyedState kops t)).1 v ∧
      lcrsParent P (foldBST P (keyedState kops t)).1 v ≤ P ∧
      (lcrsParent P (foldBST P (keyedState kops t)).1 v = P ∨
        lcrsParent P (foldBST P (keyedState kops t)).1 v ∈ inorderNat (keyedState kops t))
  lcrs_top : ∀ t ≤ kops.length, lcrsParent P (foldBST P (keyedState kops t)).1 P = P
  lcrs_mono : ∀ t < kops.length, ∀ v ∈ inorderNat (keyedState kops t),
    v ∈ inorderNat (keyedState kops (t + 1)) →
      lcrsParent P (foldBST P (keyedState kops t)).1 v ≤
        lcrsParent P (foldBST P (keyedState kops (t + 1))).1 v
  spine_lock : ∀ id (hid : id < (jumps kops).length),
    let e := (jumps kops)[id]
    e.x ∈ leftSpineBottomUpNat (foldBST P (keyedState kops (e.step + 1))).1 ∧
      ∀ t, e.step + 1 ≤ t → t ≤ popStep kops e.x →
        (∀ u ∈ leftSpineBottomUpNat (foldBST P (keyedState kops t)).1,
          ¬(e.x < u ∧ u < e.z)) ∧
        (∀ w, kops[t]? = some (.push w) → w < e.x)
  outside_mbase : ∀ id (hid : id < (jumps kops).length),
    id ∉ MBaseSet kops →
      ∃ (hidL : prevWin kops id < (jumps kops).length)
        (hidR : upperPrevWin kops id < (jumps kops).length),
        prevWin kops id + 1 = upperPrevWin kops id ∧
          upperPrevWin kops id < id ∧
          let e := (jumps kops)[id]
          let eL := (jumps kops)[prevWin kops id]
          let eR := (jumps kops)[upperPrevWin kops id]
          eL.x = e.x ∧ eL.z = e.y ∧ eR.x = e.y ∧
            eL.step = eR.step ∧ eL.s = eR.s ∧ eL.step < e.step ∧
            (∀ id' (hid' : id' < id),
              ((jumps kops)[id']'(lt_trans hid' hid)).x = e.x → id' ≤ prevWin kops id)
  prevWin_inj : ∀ id1 < (jumps kops).length, id1 ∉ MBaseSet kops →
    ∀ id2 < (jumps kops).length, id2 ∉ MBaseSet kops →
      prevWin kops id1 = prevWin kops id2 → id1 = id2
  upperPrevWin_inj : ∀ id1 < (jumps kops).length, id1 ∉ MBaseSet kops →
    ∀ id2 < (jumps kops).length, id2 ∉ MBaseSet kops →
      upperPrevWin kops id1 = upperPrevWin kops id2 → id1 = id2
def pgsdMaxSubtreeKey : _root_.BinaryTree ℕ → ℕ → ℕ
  | .nil, x => x
  | .node k l r, x =>
      if x < k then pgsdMaxSubtreeKey l x
      else if x = k then k + r.num_nodes
      else pgsdMaxSubtreeKey r x

def pgsdCountGlobalLt (isG : ℕ → Bool) (m : ℕ) : ℕ :=
  ((List.range m).filter isG).length

def pgsdNonSplitting (p : ℕ → Bool) : _root_.BinaryTree ℕ → Prop
  | .nil => True
  | .node k l r =>
      pgsdNonSplitting p l ∧
      pgsdNonSplitting p r ∧
      (extractGlobalTree p l ≠ .nil → extractGlobalTree p r ≠ .nil → p k = true)
def tocShiftDir (d : Dir) : RightRotOp → RightRotOp
  | .single pos => .single (d :: pos)
  | .cascade pos gaps => .cascade (d :: pos) gaps

def tocShiftLeft (d : ℕ) : RightRotOp → RightRotOp
  | .single pos => .single (List.replicate d Dir.L ++ pos)
  | .cascade pos gaps => .cascade (List.replicate d Dir.L ++ pos) gaps

def tocAgreeAboveLeftDepth : ℕ → _root_.BinaryTree ℕ → _root_.BinaryTree ℕ → Prop
  | 0, _, _ => True
  | m + 1, .node k1 l1 r1, .node k2 l2 r2 =>
      k1 = k2 ∧ r1 = r2 ∧ tocAgreeAboveLeftDepth m l1 l2
  | _ + 1, _, _ => False

def tocSplitByGap (Δ : ℕ) : List ℕ → List (List ℕ)
  | [] => []
  | [a] => [[a]]
  | a :: b :: rest =>
      match tocSplitByGap Δ (b :: rest) with
      | [] => [[a]]
      | p :: ps =>
          if b - a - 1 ≤ Δ then (a :: p) :: ps
          else [a] :: p :: ps

def tocTakeEven : List ℕ → List ℕ
  | [] => []
  | [x] => [x]
  | x :: _ :: rest => x :: tocTakeEven rest

def tocRevGaps : List ℕ → List ℕ
  | [] => []
  | [_] => []
  | y :: x :: rest => (y - x - 2) :: tocRevGaps (x :: rest)

def tocCascadeSpan : List ℕ → ℕ
  | [] => 2
  | g :: rest => g + 2 + tocCascadeSpan rest

def tocCascadeAsSingles : List ℕ → List RightRotOp
  | [] => [.single []]
  | g :: rest => (tocCascadeAsSingles rest).map (tocShiftLeft (g + 2)) ++ [.single []]

def tocSingleSeq (h_0 : ℕ) (idxs : List ℕ) : List RightRotOp :=
  idxs.map (fun idx => .single (List.replicate (h_0 - (idx + 2)) Dir.L))
def pklPathInorder : List (ℕ × _root_.BinaryTree ℕ) → List ℕ
  | [] => []
  | (k, r) :: rest => k :: (inorderNat r ++ pklPathInorder rest)

def pklBuildBirthOps : _root_.BinaryTree ℕ → ℕ → List CoreOp → List KeyedCoreOp
  | _, _, [] => []
  | T, b, .push :: rest => .push b :: pklBuildBirthOps (.node b .nil T) (b + 1) rest
  | T, b, .pop :: rest =>
      let s := (leftSpineBottomUpNat T).headD 0
      .pop s :: pklBuildBirthOps (popNat T) b rest
  | T, b, .rslr d :: rest =>
      .rslr d :: pklBuildBirthOps (rotateLeftAtRightDepthNat T d) b rest

def pklMapKeyedOp (f : ℕ → ℕ) : KeyedCoreOp → KeyedCoreOp
  | .push w => .push (f w)
  | .pop s => .pop (f s)
  | .rslr d => .rslr d

def pklValidTrace : _root_.BinaryTree ℕ → List KeyedCoreOp → Prop
  | H, [] => H = .nil
  | H, .push w :: rest => pklValidTrace (.node w .nil H) rest
  | H, .pop s :: rest =>
      H ≠ .nil ∧ (leftSpineBottomUpNat H).head? = some s ∧ pklValidTrace (popNat H) rest
  | H, .rslr d :: rest =>
      d + 2 ≤ (rightSpineTopDownNat H).length ∧
        pklValidTrace (rotateLeftAtRightDepthNat H d) rest

def pklCountCoreRslr : List CoreOp → ℕ
  | [] => 0
  | .rslr _ :: rest => 1 + pklCountCoreRslr rest
  | _ :: rest => pklCountCoreRslr rest
def puqPreEmbeddedState (P : ℕ) (kops : List KeyedCoreOp) (t : ℕ) : _root_.BinaryTree ℕ :=
  plugUnbornNat (birthStep kops) (popIdx kops t) P (foldBST P (keyedState kops t)).1

def puqBlockQuotient (subs : List (ℕ × ℕ)) (c_lo c_hi : ℕ) : _root_.BinaryTree ℕ → _root_.BinaryTree ℕ
  | .nil => .nil
  | .node k l r =>
      if c_hi ≤ c_lo then .nil
      else
        let lo_bound := (subs.getD c_lo (0, 0)).1
        let hi_bound := (subs.getD (c_hi - 1) (0, 0)).2
        if k < lo_bound then puqBlockQuotient subs c_lo c_hi r
        else if hi_bound ≤ k then puqBlockQuotient subs c_lo c_hi l
        else
          let c := subs.findIdx (fun b => decide (b.1 ≤ k ∧ k < b.2))
          .node c (puqBlockQuotient subs c_lo c l) (puqBlockQuotient subs (c + 1) c_hi r)

def puqConcretePkg (S : ℕ → ℕ) (P L : ℕ) (kops : List KeyedCoreOp) (ℓ Xi : ℕ) :
    BlockQuotientData :=
  let X := (scaleBlocks S P (ℓ - 1)).getD Xi (0, 0)
  let subs := splitBlock (S ℓ) X.1 X.2
  let KX := subs.length
  let gInit : ℕ → _root_.BinaryTree ℕ := fun p =>
    let sp := subs.getD p (0, 0)
    puqBlockQuotient subs (p + 1) KX (puqPreEmbeddedState P kops (popStep kops sp.1))
  let gEnd : ℕ → _root_.BinaryTree ℕ := fun p =>
    let sp := subs.getD p (0, 0)
    puqBlockQuotient subs (p + 1) KX (puqPreEmbeddedState P kops (tEmpty kops sp.1 sp.2))
  let fIdx : ℕ → List ℕ := fun p =>
    let pi0 := leftSpineBottomUpNat (gInit p)
    (List.range pi0.length).filter (fun ia =>
      decide (pi0.getD ia 0 ∈ MMovSet S P L kops ℓ Xi p))
  let uGap : ℕ → List ℕ := fun p =>
    let f := fIdx p
    (List.range (f.length - 1)).map (fun r => f.getD (r + 1) 0 - f.getD r 0 - 4)
  { G_init := gInit, G_end := gEnd, F_idx := fIdx, u_gap := uGap }

def puqIsClassA (S : ℕ → ℕ) (P : ℕ) (kops : List KeyedCoreOp)
    (ℓ Xi p c : ℕ) : Bool :=
  let X := (scaleBlocks S P (ℓ - 1)).getD Xi (0, 0)
  let subs := splitBlock (S ℓ) X.1 X.2
  let sp := subs.getD p (0, 0)
  let hi_p := (subs.getD (p + 1) (0, 0)).1
  let ts := popStep kops sp.1
  let te := tEmpty kops sp.1 sp.2
  (List.Ico ts te).any (fun tev =>
    match kops[tev]? with
    | some (.rslr (d + 1)) =>
        let rs := rightSpineTopDownNat (keyedState kops tev)
        let u := rs.getD d 0
        let v := rs.getD (d + 1) 0
        let cu := subs.findIdx (fun b => decide (b.1 ≤ u ∧ u < b.2))
        let cv := subs.findIdx (fun b => decide (b.1 ≤ v ∧ v < b.2))
        decide (d + 1 < rs.length ∧ hi_p ≤ u ∧ u < v ∧ v < X.2 ∧ cu < c ∧ cv = c)
    | _ => false)

def puqIsClassB4 (S : ℕ → ℕ) (P L : ℕ) (kops : List KeyedCoreOp)
    (ℓ Xi p c : ℕ) : Bool :=
  let X := (scaleBlocks S P (ℓ - 1)).getD Xi (0, 0)
  let subs := splitBlock (S ℓ) X.1 X.2
  let sp := subs.getD p (0, 0)
  let sc := subs.getD c (0, 0)
  let buckets := B_fin_pre S P L kops ∪ B_1 S P L kops ∪ B_3_intra S P L kops
  (List.range (jumps kops).length).any (fun jid =>
    decide (jid ∈ buckets) &&
      match (jumps kops)[jid]? with
      | some ej =>
          decide (sp.1 ≤ ej.s ∧ ej.s < sp.2 ∧
            ((sc.1 ≤ ej.x ∧ ej.x < sc.2) ∨ (sc.1 ≤ ej.y ∧ ej.y < sc.2)))
      | none => false)

def puqIsClassC1 (S : ℕ → ℕ) (P : ℕ) (kops : List KeyedCoreOp)
    (ℓ Xi p c : ℕ) : Bool :=
  let X := (scaleBlocks S P (ℓ - 1)).getD Xi (0, 0)
  let subs := splitBlock (S ℓ) X.1 X.2
  let sp := subs.getD p (0, 0)
  let sc := subs.getD c (0, 0)
  let ts := popStep kops sp.1
  let te := tEmpty kops sp.1 sp.2
  (List.Ico ts te).any (fun trem =>
    match kops[trem]? with
    | some (.rslr d) =>
        let H := keyedState kops trem
        let rs := rightSpineTopDownNat H
        let inord := inorderNat H
        let m0 := inord.headD 0
        let v := rs.getD d 0
        decide (d < rs.length ∧ inord ≠ [] ∧ sp.1 ≤ m0 ∧ m0 < sp.2 ∧ sc.1 ≤ v ∧ v < sc.2)
    | _ => false)

def puqIsClassC2 (S : ℕ → ℕ) (P : ℕ) (kops : List KeyedCoreOp)
    (ℓ Xi p c : ℕ) : Bool :=
  let X := (scaleBlocks S P (ℓ - 1)).getD Xi (0, 0)
  let subs := splitBlock (S ℓ) X.1 X.2
  let sp := subs.getD p (0, 0)
  let sc := subs.getD c (0, 0)
  (List.Ico sp.1 sp.2).any (fun spop =>
    let tadd := popStep kops spop
    let ls := leftSpineBottomUpNat (keyedState kops tadd)
    let madd := (ls.length - 2) / 2
    let v := ls.getD (2 * madd + 1) 0
    decide (ls.length = 2 * madd + 3 ∧ sc.1 ≤ v ∧ v < sc.2))

def puqIsChargedSubblock (S : ℕ → ℕ) (P L : ℕ) (kops : List KeyedCoreOp)
    (ℓ Xi p c : ℕ) : Bool :=
  puqIsClassA S P kops ℓ Xi p c ||
    puqIsClassB4 S P L kops ℓ Xi p c ||
    puqIsClassC1 S P kops ℓ Xi p c ||
    puqIsClassC2 S P kops ℓ Xi p c

def PuqIsSubblockPart (subs : List (ℕ × ℕ)) : Prop :=
  2 ≤ subs.length ∧
    (∀ c < subs.length, (subs.getD c (0, 0)).1 < (subs.getD c (0, 0)).2) ∧
    (∀ c, c + 1 < subs.length → (subs.getD c (0, 0)).2 = (subs.getD (c + 1) (0, 0)).1)

def PuqPlugUnbornLaws (P : ℕ) (kops : List KeyedCoreOp) : Prop :=
  (∀ t ≤ kops.length,
    popIdx kops t ≤ P ∧
      _root_.BinaryTree.IsBST (puqPreEmbeddedState P kops t) ∧
      inorderNat (puqPreEmbeddedState P kops t) = List.Ico (popIdx kops t) P) ∧
  (∀ t1 t2, t1 ≤ t2 → popIdx kops t1 ≤ popIdx kops t2) ∧
  (∀ t ≤ kops.length, ∀ v ∈ inorderNat (keyedState kops t),
    lcrsParent P (puqPreEmbeddedState P kops t) v =
      lcrsParent P (foldBST P (keyedState kops t)).1 v) ∧
  (∀ t < kops.length, ∀ v, popIdx kops (t + 1) ≤ v → v < P →
    lcrsParent P (puqPreEmbeddedState P kops t) v ≤
      lcrsParent P (puqPreEmbeddedState P kops (t + 1)) v) ∧
  (∀ t (ht : t < kops.length),
    kops[t]'ht = .rslr 0 →
      puqPreEmbeddedState P kops (t + 1) = puqPreEmbeddedState P kops t) ∧
  (∀ t (ht : t < kops.length) (d : ℕ),
    kops[t]'ht = .rslr (d + 1) →
      let rs := rightSpineTopDownNat (keyedState kops t)
      let u := rs.getD d 0
      let v := rs.getD (d + 1) 0
      d + 1 < rs.length ∧
        puqPreEmbeddedState P kops (t + 1) =
          rotateRightOnLeftSpine u (puqPreEmbeddedState P kops t) ∧
        ∃ pre suf, leftSpineBottomUpNat (puqPreEmbeddedState P kops t) = pre ++ u :: v :: suf) ∧
  (∀ t (ht : t < kops.length) (w : ℕ),
    kops[t]'ht = .push w →
      ∃ N : ℕ,
        puqPreEmbeddedState P kops (t + 1) =
          (rotateRightOnLeftSpine w)^[N] (puqPreEmbeddedState P kops t)) ∧
  (∀ t (ht : t < kops.length) (s : ℕ),
    kops[t]'ht = .pop s →
      let ls := leftSpineBottomUpNat (keyedState kops t)
      let js := popJumpsAt 0 t s ls
      s = popIdx kops t ∧
        leftSpineBottomUpNat (puqPreEmbeddedState P kops t) =
          leftSpineBottomUpNat (foldBST P (keyedState kops t)).1 ∧
        _root_.BinaryTree.IsBST (spliceMinNat (puqPreEmbeddedState P kops t)) ∧
        puqPreEmbeddedState P kops (t + 1) =
          js.foldl (fun T e => rotateRightOnLeftSpine e.x T)
            (spliceMinNat (puqPreEmbeddedState P kops t)) ∧
        ∀ j (hj : j < js.length),
          let Tj := (js.take j).foldl (fun T e => rotateRightOnLeftSpine e.x T)
            (spliceMinNat (puqPreEmbeddedState P kops t))
          _root_.BinaryTree.IsBST Tj ∧
            ∃ pre suf, leftSpineBottomUpNat Tj = pre ++ (js[j]'hj).x :: (js[j]'hj).y :: suf) ∧
  (∀ t (ht : t < kops.length) (s : ℕ),
    kops[t]'ht = .pop s →
      let ls := leftSpineBottomUpNat (keyedState kops t)
      let m := (ls.length - 2) / 2
      ∃ baseId,
        baseId + m ≤ (jumps kops).length ∧
          ∀ j < m,
            ∃ hid : baseId + j < (jumps kops).length,
              let ej := (jumps kops)[baseId + j]'hid
              ej.step = t ∧ ej.s = s ∧ ej.j = j ∧ ej.m = m ∧
                ej.x = ls.getD (2 * j + 1) 0 ∧
                ej.y = ls.getD (2 * j + 2) 0 ∧
                ej.z = ls.getD (2 * j + 3) 0) ∧
  (∀ t (ht : t < kops.length),
    let H := keyedState kops t
    let H' := keyedState kops (t + 1)
    let rs := rightSpineTopDownNat H
    let ls := leftSpineBottomUpNat H
    match kops[t]'ht with
    | .push w => rightSpineTopDownNat H' = w :: rs
    | .rslr d => d + 2 ≤ rs.length ∧ rightSpineTopDownNat H' = rs.eraseIdx d
    | .pop _ =>
        let m := (ls.length - 2) / 2
        (ls.length = 1 ∧ rightSpineTopDownNat H' = rs.tail) ∨
          (ls.length = 2 * m + 2 ∧ rightSpineTopDownNat H' = rs) ∨
          (ls.length = 2 * m + 3 ∧ rightSpineTopDownNat H' = ls.getD (2 * m + 1) 0 :: rs))

def PuqBlockQuotientLaws : Prop :=
  (∀ (subs : List (ℕ × ℕ)), PuqIsSubblockPart subs →
    ∀ c_lo c_hi, c_lo ≤ c_hi → c_hi ≤ subs.length →
    ∀ T, _root_.BinaryTree.IsBST T → _root_.BinaryTree.IsBST (puqBlockQuotient subs c_lo c_hi T)) ∧
  (∀ (subs : List (ℕ × ℕ)), PuqIsSubblockPart subs →
    ∀ c_lo c_hi, c_lo < c_hi → c_hi ≤ subs.length →
    ∀ T loT hiT, _root_.BinaryTree.IsBST T →
      inorderNat T = List.Ico loT hiT →
      loT ≤ (subs.getD c_lo (0, 0)).1 →
      (subs.getD (c_hi - 1) (0, 0)).2 ≤ hiT →
      inorderNat (puqBlockQuotient subs c_lo c_hi T) = List.Ico c_lo c_hi) ∧
  (∀ (subs : List (ℕ × ℕ)), PuqIsSubblockPart subs →
    ∀ c_lo c_hi, c_lo < c_hi → c_hi ≤ subs.length →
    ∀ T, _root_.BinaryTree.IsBST T →
      puqBlockQuotient subs c_lo c_hi T =
        puqBlockQuotient subs c_lo c_hi
          (restrictRangeNat (subs.getD c_lo (0, 0)).1 (subs.getD (c_hi - 1) (0, 0)).2 T)) ∧
  (∀ (subs : List (ℕ × ℕ)), PuqIsSubblockPart subs →
    ∀ c_lo c_lo' c_hi, c_lo ≤ c_lo' → c_lo' ≤ c_hi → c_hi ≤ subs.length →
    ∀ T, _root_.BinaryTree.IsBST T →
      restrictRangeNat c_lo' c_hi (puqBlockQuotient subs c_lo c_hi T) =
        puqBlockQuotient subs c_lo' c_hi T) ∧
  (∀ (subs : List (ℕ × ℕ)), PuqIsSubblockPart subs →
    ∀ c_lo c_hi, c_lo < c_hi → c_hi ≤ subs.length →
    ∀ T, _root_.BinaryTree.IsBST T →
      let lo_b := (subs.getD c_lo (0, 0)).1
      let hi_b := (subs.getD (c_hi - 1) (0, 0)).2
      let T' := restrictRangeNat lo_b hi_b T
      ∀ c, (c ∈ leftSpineBottomUpNat (puqBlockQuotient subs c_lo c_hi T) ↔
        c_lo ≤ c ∧ c < c_hi ∧
          ∃ r ∈ leftSpineBottomUpNat T',
            (subs.getD c (0, 0)).1 ≤ r ∧ r < (subs.getD c (0, 0)).2)) ∧
  (∀ lo_b hi_b (T : _root_.BinaryTree ℕ), _root_.BinaryTree.IsBST T →
    ∀ x0 ∈ leftSpineBottomUpNat T, lo_b ≤ x0 →
      ∀ r, x0 ≤ r → r < hi_b →
        (r ∈ leftSpineBottomUpNat (restrictRangeNat lo_b hi_b T) ↔
          r ∈ leftSpineBottomUpNat T)) ∧
  (∀ (subs : List (ℕ × ℕ)), PuqIsSubblockPart subs →
    ∀ c_lo c_hi, c_lo < c_hi → c_hi ≤ subs.length →
    ∀ (T : _root_.BinaryTree ℕ) (s : ℕ), _root_.BinaryTree.IsBST T →
      (inorderNat T).head? = some s →
      s < (subs.getD c_lo (0, 0)).1 →
      puqBlockQuotient subs c_lo c_hi (spliceMinNat T) = puqBlockQuotient subs c_lo c_hi T) ∧
  (∀ (subs : List (ℕ × ℕ)), PuqIsSubblockPart subs →
    ∀ c_lo c_hi, c_lo < c_hi → c_hi ≤ subs.length →
    ∀ (T : _root_.BinaryTree ℕ) (u : ℕ), _root_.BinaryTree.IsBST T →
      let G := puqBlockQuotient subs c_lo c_hi T
      let G' := puqBlockQuotient subs c_lo c_hi (rotateRightOnLeftSpine u T)
      let lo_b := (subs.getD c_lo (0, 0)).1
      let hi_b := (subs.getD (c_hi - 1) (0, 0)).2
      ((u < lo_b ∨ hi_b ≤ u) → G' = G) ∧
        (G' = G ∨
          G' = rotateRightOnLeftSpine (subs.findIdx (fun b => decide (b.1 ≤ u ∧ u < b.2))) G)) ∧
  (∀ (subs : List (ℕ × ℕ)), PuqIsSubblockPart subs →
    ∀ c_lo c_hi, c_lo < c_hi → c_hi ≤ subs.length →
    ∀ (T : _root_.BinaryTree ℕ) (u v c : ℕ), _root_.BinaryTree.IsBST T →
      (∃ pre suf, leftSpineBottomUpNat T = pre ++ u :: v :: suf) →
      c ∈ leftSpineBottomUpNat (puqBlockQuotient subs c_lo c_hi T) →
      c ∉ leftSpineBottomUpNat (puqBlockQuotient subs c_lo c_hi (rotateRightOnLeftSpine u T)) →
      (subs.getD c_lo (0, 0)).1 ≤ u ∧ u < v ∧ v < (subs.getD (c_hi - 1) (0, 0)).2 ∧
        subs.findIdx (fun b => decide (b.1 ≤ u ∧ u < b.2)) < c ∧
        subs.findIdx (fun b => decide (b.1 ≤ v ∧ v < b.2)) = c) ∧
  (∀ (G : _root_.BinaryTree ℕ) (a b u : ℕ),
    _root_.BinaryTree.IsBST G → inorderNat G = List.Ico a b →
      _root_.BinaryTree.IsBST (rotateRightOnLeftSpine u G) ∧
        inorderNat (rotateRightOnLeftSpine u G) = List.Ico a b ∧
        (∀ c ∈ leftSpineBottomUpNat (rotateRightOnLeftSpine u G),
          c ∈ leftSpineBottomUpNat G) ∧
        (∀ c, a ≤ c → c < b →
          subtreeMaxNat G c ≤ subtreeMaxNat (rotateRightOnLeftSpine u G) c)) ∧
  (∀ (G : _root_.BinaryTree ℕ), _root_.BinaryTree.IsBST G →
    List.Pairwise (· < ·) (leftSpineBottomUpNat G) ∧
      ∀ u ∈ leftSpineBottomUpNat G, u ∈ inorderNat G) ∧
  (∀ (G : _root_.BinaryTree ℕ) (a b : ℕ),
    _root_.BinaryTree.IsBST G → inorderNat G = List.Ico a b →
      (∀ c, a ≤ c → c < b → c ≤ subtreeMaxNat G c ∧ subtreeMaxNat G c < b) ∧
        (∀ u ∈ leftSpineBottomUpNat G, ∀ v ∈ leftSpineBottomUpNat G,
          u < v → subtreeMaxNat G u < v)) ∧
  (∀ (B : _root_.BinaryTree ℕ) (P_top x u : ℕ),
    _root_.BinaryTree.IsBST B → x ∈ inorderNat B → u ∈ leftSpineBottomUpNat B → x < u →
      lcrsParent P_top B x ≤ u) ∧
  (∀ (subs : List (ℕ × ℕ)), PuqIsSubblockPart subs →
    ∀ c_lo c_hi, c_lo < c_hi → c_hi ≤ subs.length →
    ∀ (T : _root_.BinaryTree ℕ) (loT hiT P_top c_y c_w : ℕ),
      _root_.BinaryTree.IsBST T →
      inorderNat T = List.Ico loT hiT →
      loT ≤ (subs.getD c_lo (0, 0)).1 →
      (subs.getD (c_hi - 1) (0, 0)).2 ≤ hiT →
      (subs.getD (c_hi - 1) (0, 0)).2 ≤ P_top →
      c_lo ≤ c_y → c_y < c_w → c_w < c_hi →
      (∀ r, (subs.getD c_y (0, 0)).1 ≤ r → r < (subs.getD c_y (0, 0)).2 →
        lcrsParent P_top T r < (subs.getD c_w (0, 0)).2) →
      subtreeMaxNat (puqBlockQuotient subs c_lo c_hi T) c_y < c_w) ∧
  (∀ (subs : List (ℕ × ℕ)), PuqIsSubblockPart subs →
    ∀ c_lo c_hi, c_lo < c_hi → c_hi ≤ subs.length →
    ∀ (T : _root_.BinaryTree ℕ) (loT hiT P_top c_a c_w : ℕ),
      _root_.BinaryTree.IsBST T →
      inorderNat T = List.Ico loT hiT →
      loT ≤ (subs.getD c_lo (0, 0)).1 →
      (subs.getD (c_hi - 1) (0, 0)).2 ≤ hiT →
      (subs.getD (c_hi - 1) (0, 0)).2 ≤ P_top →
      c_lo ≤ c_a → c_a < c_w → c_w ≤ c_hi →
      (∃ x, (subs.getD c_a (0, 0)).1 ≤ x ∧ x < (subs.getD c_a (0, 0)).2 ∧
        (subs.getD (c_w - 1) (0, 0)).2 ≤ lcrsParent P_top T x) →
      c_w ≤ subtreeMaxNat (puqBlockQuotient subs c_lo c_hi T) c_a + 1)
def psspContig (B lo hi : ℕ) (bs : List (ℕ × ℕ)) : Prop :=
  1 ≤ bs.length ∧
  (bs.getD 0 (0, 0)).1 = lo ∧
  (bs.getD (bs.length - 1) (0, 0)).2 = hi ∧
  (∀ c < bs.length,
    let sc := bs.getD c (0, 0)
    lo ≤ sc.1 ∧ sc.1 < sc.2 ∧ sc.2 ≤ hi ∧ B ≤ sc.2 - sc.1 ∧ sc.2 - sc.1 < 2 * B) ∧
  (∀ c, c + 1 < bs.length → (bs.getD c (0, 0)).2 = (bs.getD (c + 1) (0, 0)).1)

def psspHasKeyIn (lo hi : ℕ) : _root_.BinaryTree ℕ → Bool
  | .nil => false
  | .node k l r =>
      decide (lo ≤ k ∧ k < hi) || psspHasKeyIn lo hi l || psspHasKeyIn lo hi r

def psspHasAncDesc (lo_p hi_p lo_q hi_q : ℕ) : _root_.BinaryTree ℕ → Bool
  | .nil => false
  | .node k l r =>
      (decide (lo_q ≤ k ∧ k < hi_q) &&
        (psspHasKeyIn lo_p hi_p l || psspHasKeyIn lo_p hi_p r)) ||
      psspHasAncDesc lo_p hi_p lo_q hi_q l ||
      psspHasAncDesc lo_p hi_p lo_q hi_q r

def psspProjPath (hi : ℕ) : List (ℕ × _root_.BinaryTree ℕ) → List (ℕ × _root_.BinaryTree ℕ)
  | [] => []
  | (k, r) :: rest =>
      if k < hi then (k, restrictRangeNat 0 hi r) :: psspProjPath hi rest
      else []
def fdmRightSpineFrames : ℕ → _root_.BinaryTree ℕ → List (ℕ × _root_.BinaryTree ℕ)
  | k, .nil => [(k, .nil)]
  | k, .node k2 l2 r2 => (k, l2) :: fdmRightSpineFrames k2 r2


-- === BEGIN SolPart2 ===
theorem three_way_deque_to_core_reduction (n m : ℕ) (init : BST ℤ) (ops : Fin m → DequeOp ℤ)
    (hn : init.tree.num_nodes = n)
    (hvalid : ValidDequeSeq init.tree ops) :
    ∃ (d_L d_R : ℕ) (ops_L ops_R : List CoreOp),
      d_L + d_R ≤ m ∧
      ValidCoreSeq d_L ops_L ∧
      ValidCoreSeq d_R ops_R ∧
      dequeSequenceCost init.tree ops ≤
        ((2 * coreCascadeCost ops_L + 2 * coreCascadeCost ops_R + 2 * n + 13 * m : ℕ) : ℝ) :=
by
  have h_stage12 :
      ∀ (n m : ℕ) (init : BST ℤ) (ops : Fin m → DequeOp ℤ),
        init.tree.num_nodes = n →
        ValidDequeSeq init.tree ops →
        ∃ (C0 : _root_.BinaryTree TwFate) (cops : List TwCDequeOp),
          C0.num_nodes = n ∧
          cops.length = m ∧
          TwValidCDequeSeq C0 cops ∧
          dequeSequenceCost init.tree ops =
            ((twUDequeSeqCost (twEraseTree C0) (cops.map twEraseCDequeOp) : ℕ) : ℝ) := by
    clear n m init ops hn hvalid
    intro n m init ops hn hvalid
    have h_forall_mono : ∀ {α : Type} {p q : α → Prop} {t : _root_.BinaryTree α},
        (∀ x, p x → q x) → ForallTree p t → ForallTree q t := by
      intro α p q t hpq ht
      induction ht with
      | left => exact .left
      | node l k r _ hk _ ihl ihr => exact .node l k r ihl (hpq k hk) ihr

    have h_forall_and : ∀ {α : Type} {p q : α → Prop} {t : _root_.BinaryTree α},
        ForallTree p t → ForallTree q t → ForallTree (fun x => p x ∧ q x) t := by
      intro α p q t hp hq
      induction hp with
      | left => exact .left
      | node l k r _ hpk _ ihl ihr =>
        cases hq with
        | node _ _ _ hql hqk hqr =>
          exact .node l k r (ihl hql) ⟨hpk, hqk⟩ (ihr hqr)

    have h_mem_forall : ∀ {α : Type} (p : α → Prop) {t : _root_.BinaryTree α} {x : α},
        ForallTree p t → twTreeMem x t → p x := by
      intro α p t x hfor hmem
      induction hfor with
      | left => cases hmem
      | node l k r _ hk _ ihl ihr =>
        rcases hmem with rfl | hmem | hmem
        · exact hk
        · exact ihl hmem
        · exact ihr hmem

    have h_map_nodes : ∀ {α β : Type} (f : α → β) (t : _root_.BinaryTree α),
        (twMapTree f t).num_nodes = t.num_nodes := by
      intro α β f t
      induction t with
      | nil => rfl
      | node k l r ihl ihr => simp [twMapTree, _root_.BinaryTree.num_nodes, ihl, ihr]

    have h_map_map : ∀ {α β γ : Type} (g : β → γ) (f : α → β) (t : _root_.BinaryTree α),
        twMapTree g (twMapTree f t) = twMapTree (fun x => g (f x)) t := by
      intro α β γ g f t
      induction t with
      | nil => rfl
      | node k l r ihl ihr => simp [twMapTree, ihl, ihr]

    have h_map_id : ∀ {α : Type} (t : _root_.BinaryTree α), twMapTree (fun x => x) t = t := by
      intro α t
      induction t with
      | nil => rfl
      | node k l r ihl ihr => simp [twMapTree, ihl, ihr]

    have h_map_congr : ∀ {α β : Type} {f g : α → β} (t : _root_.BinaryTree α),
        (∀ x, f x = g x) → twMapTree f t = twMapTree g t := by
      intro α β f g t hfg
      induction t with
      | nil => rfl
      | node k l r ihl ihr => simp [twMapTree, hfg k, ihl, ihr]

    have h_erase_map : ∀ {α β : Type} (f : α → β) (t : _root_.BinaryTree α),
        twEraseTree (twMapTree f t) = twEraseTree t := by
      intro α β f t
      unfold twEraseTree
      rw [h_map_map]

    have h_mirror_mirror : ∀ {α : Type} (t : _root_.BinaryTree α),
        twMirrorTree (twMirrorTree t) = t := by
      intro α t
      induction t with
      | nil => rfl
      | node k l r ihl ihr => simp [twMirrorTree, ihl, ihr]

    have h_map_mirror : ∀ {α β : Type} (f : α → β) (t : _root_.BinaryTree α),
        twMapTree f (twMirrorTree t) = twMirrorTree (twMapTree f t) := by
      intro α β f t
      induction t with
      | nil => rfl
      | node k l r ihl ihr => simp [twMapTree, twMirrorTree, ihl, ihr]

    have h_forall_map : ∀ {α β : Type} (f : α → β) (p : β → Prop) (t : _root_.BinaryTree α),
        ForallTree p (twMapTree f t) ↔ ForallTree (fun x => p (f x)) t := by
      intro α β f p t
      induction t with
      | nil =>
        constructor <;> intro _ <;> exact .left
      | node k l r ihl ihr =>
        constructor
        · intro h
          cases h with
          | node _ _ _ hl hk hr =>
            exact .node l k r (ihl.mp hl) hk (ihr.mp hr)
        · intro h
          cases h with
          | node _ _ _ hl hk hr =>
            exact .node _ _ _ (ihl.mpr hl) hk (ihr.mpr hr)

    have h_forall_mirror : ∀ {α : Type} (p : α → Prop) (t : _root_.BinaryTree α),
        ForallTree p (twMirrorTree t) ↔ ForallTree p t := by
      intro α p t
      induction t with
      | nil =>
        constructor <;> intro _ <;> exact .left
      | node k l r ihl ihr =>
        constructor
        · intro h
          cases h with
          | node _ _ _ hr hk hl =>
            exact .node l k r (ihl.mp hl) hk (ihr.mp hr)
        · intro h
          cases h with
          | node _ _ _ hl hk hr =>
            exact .node _ _ _ (ihr.mpr hr) hk (ihl.mpr hl)

    have h_lsl_mirror : ∀ (u : _root_.BinaryTree Unit),
        leftSpineLen (twMirrorTree u) = rightSpineLen u := by
      intro u
      induction u with
      | nil => rfl
      | node _ l r _ ihr => simp [twMirrorTree, leftSpineLen, rightSpineLen, ihr]

    have h_descPoly_map : ∀ {α β : Type} (f : α → β) (t : _root_.BinaryTree α)
        (acc : List (α × _root_.BinaryTree α)),
        twDescendLeftPoly (twMapTree f t) (acc.map (fun p => (f p.1, twMapTree f p.2))) =
          (twMapTree f (twDescendLeftPoly t acc).1,
           (twDescendLeftPoly t acc).2.map (fun p => (f p.1, twMapTree f p.2))) := by
      intro α β f t
      induction t with
      | nil => intro acc; simp [twDescendLeftPoly, twMapTree]
      | node k l r ihl _ =>
        intro acc
        rcases l with _ | ⟨lk, ll, lr⟩
        · simp [twDescendLeftPoly, twMapTree]
        · simpa [twMapTree, twDescendLeftPoly] using ihl ((k, r) :: acc)

    have h_splayPoly_map : ∀ {α β : Type} (f : α → β) (n : ℕ) (c : _root_.BinaryTree α)
        (path : List (α × _root_.BinaryTree α)),
        path.length ≤ n →
        twMapTree f (twSplayLeftSpinePoly c path) =
          twSplayLeftSpinePoly (twMapTree f c) (path.map (fun p => (f p.1, twMapTree f p.2))) := by
      intro α β f n
      induction n with
      | zero =>
        intro c path hlen
        rcases path with _ | _
        · rfl
        · simp at hlen
      | succ n ih =>
        intro c path hlen
        rcases path with _ | ⟨⟨k1, s1⟩, _ | ⟨⟨k2, s2⟩, rest⟩⟩
        · rfl
        · rfl
        · have hrest : rest.length ≤ n := by simp at hlen; omega
          simpa [twSplayLeftSpinePoly, twMapTree] using ih (.node k1 c (.node k2 s1 s2)) rest hrest

    have h_popPoly_map : ∀ {α β : Type} (f : α → β) (t : _root_.BinaryTree α),
        twMapTree f (twPopPoly t) = twPopPoly (twMapTree f t) := by
      intro α β f t
      unfold twPopPoly
      have hd := h_descPoly_map f t []
      simp only [List.map_nil] at hd
      rw [hd, h_splayPoly_map f (twDescendLeftPoly t []).2.length _ _ le_rfl]

    have h_ejectPoly_map : ∀ {α β : Type} (f : α → β) (t : _root_.BinaryTree α),
        twMapTree f (twEjectPoly t) = twEjectPoly (twMapTree f t) := by
      intro α β f t
      unfold twEjectPoly
      rw [h_map_mirror, h_popPoly_map, h_map_mirror]

    have h_descPoly_erase : ∀ {α : Type} (t : _root_.BinaryTree α) (acc : List (α × _root_.BinaryTree α)),
        descendLeft (twEraseTree t) (acc.map (fun p => twEraseTree p.2)) =
          (twEraseTree (twDescendLeftPoly t acc).1,
           (twDescendLeftPoly t acc).2.map (fun p => twEraseTree p.2)) := by
      intro α t
      induction t with
      | nil => intro acc; simp [descendLeft, twDescendLeftPoly, twEraseTree, twMapTree]
      | node k l r ihl _ =>
        intro acc
        rcases l with _ | ⟨lk, ll, lr⟩
        · simp [descendLeft, twDescendLeftPoly, twEraseTree, twMapTree]
        · simpa [twEraseTree, twMapTree, descendLeft, twDescendLeftPoly] using ihl ((k, r) :: acc)

    have h_splayPoly_erase : ∀ {α : Type} (n : ℕ) (c : _root_.BinaryTree α)
        (path : List (α × _root_.BinaryTree α)),
        path.length ≤ n →
        twEraseTree (twSplayLeftSpinePoly c path) =
          splayLeftSpine (twEraseTree c) (path.map (fun p => twEraseTree p.2)) := by
      intro α n
      induction n with
      | zero =>
        intro c path hlen
        rcases path with _ | _
        · rfl
        · simp at hlen
      | succ n ih =>
        intro c path hlen
        rcases path with _ | ⟨⟨k1, s1⟩, _ | ⟨⟨k2, s2⟩, rest⟩⟩
        · rfl
        · rfl
        · have hrest : rest.length ≤ n := by simp at hlen; omega
          simpa [twSplayLeftSpinePoly, splayLeftSpine, twEraseTree, twMapTree] using
            ih (.node k1 c (.node k2 s1 s2)) rest hrest

    have h_popPoly_erase : ∀ {α : Type} (t : _root_.BinaryTree α),
        twEraseTree (twPopPoly t) = popUnlabeled (twEraseTree t) := by
      intro α t
      unfold twPopPoly popUnlabeled
      have hd := h_descPoly_erase t []
      simp only [List.map_nil] at hd
      rw [hd, h_splayPoly_erase (twDescendLeftPoly t []).2.length _ _ le_rfl]

    have h_ejectPoly_erase : ∀ {α : Type} (t : _root_.BinaryTree α),
        twEraseTree (twEjectPoly t) = twMirrorTree (popUnlabeled (twMirrorTree (twEraseTree t))) := by
      intro α t
      have h1 : twEraseTree (twEjectPoly t) = twMirrorTree (twEraseTree (twPopPoly (twMirrorTree t))) := by
        unfold twEjectPoly twEraseTree
        exact h_map_mirror (fun _ => ()) _
      have h2 : twMirrorTree (twEraseTree t) = twEraseTree (twMirrorTree t) := by
        unfold twEraseTree
        exact (h_map_mirror (fun _ => ()) t).symm
      rw [h1, h_popPoly_erase, h2]

    have h_descPoly_len : ∀ {α : Type} (t : _root_.BinaryTree α) (acc : List (α × _root_.BinaryTree α)),
        t ≠ .nil →
        (twDescendLeftPoly t acc).2.length + 1 = leftSpineLen (twEraseTree t) + acc.length := by
      intro α t
      induction t with
      | nil => intro _ h; exact absurd rfl h
      | node k l r ihl _ =>
        intro acc _
        rcases l with _ | ⟨lk, ll, lr⟩
        · simp [twDescendLeftPoly, twEraseTree, twMapTree, leftSpineLen]
          omega
        · have h1 := ihl ((k, r) :: acc) (by simp)
          simp only [twDescendLeftPoly, List.length_cons, twEraseTree, twMapTree, leftSpineLen] at h1 ⊢
          omega

    have h_minKey_none : ∀ {α : Type} (t : _root_.BinaryTree α), t.minKey? = none ↔ t = .nil := by
      intro α t
      cases t with
      | nil => simp [_root_.BinaryTree.minKey?]
      | node k l r =>
        simp only [_root_.BinaryTree.minKey?, reduceCtorEq, iff_false]
        cases l.minKey? <;> simp

    have h_minKey_mem : ∀ {α : Type} (t : _root_.BinaryTree α) (k : α),
        t.minKey? = some k → twTreeMem k t := by
      intro α t
      induction t with
      | nil => intro k h; simp [_root_.BinaryTree.minKey?] at h
      | node key l r ihl _ =>
        intro k h
        simp only [_root_.BinaryTree.minKey?] at h
        cases hl : l.minKey? with
        | none =>
          rw [hl] at h
          injection h with hEq
          exact Or.inl hEq.symm
        | some m =>
          rw [hl] at h
          injection h with hEq
          subst hEq
          exact Or.inr (Or.inl (ihl m hl))

    have h_minKey_le : ∀ {α : Type} [LinearOrder α] (t : _root_.BinaryTree α) (k : α),
        IsBST t → t.minKey? = some k → ForallTree (fun x => k ≤ x) t := by
      intro α _ t k hbst
      induction hbst using isBSTRec with
      | left => intro h; simp [_root_.BinaryTree.minKey?] at h
      | node key l r hl_lt hr_gt hl_bst _ ihl _ =>
        intro h
        simp only [_root_.BinaryTree.minKey?] at h
        cases hl : l.minKey? with
        | none =>
          rw [hl] at h
          injection h with hEq
          subst hEq
          have hl_empty : l = .nil := (h_minKey_none l).mp hl
          subst hl_empty
          exact .node .nil key r .left le_rfl (h_forall_mono (fun _ hx => le_of_lt hx) hr_gt)
        | some m =>
          rw [hl] at h
          injection h with hEq
          subst hEq
          have hm_mem : twTreeMem m l := h_minKey_mem l m hl
          have hm_lt_key : m < key := h_mem_forall (fun k => k < key) hl_lt hm_mem
          exact .node l key r (ihl hl) (le_of_lt hm_lt_key)
            (h_forall_mono (fun _ hx => le_of_lt (lt_trans hm_lt_key hx)) hr_gt)

    have h_minKey_node : ∀ {α : Type} (l : _root_.BinaryTree α) (k : α) (r : _root_.BinaryTree α),
        (_root_.BinaryTree.node k l r).minKey? = match l.minKey? with | none => some k | some m => some m :=
      fun _ _ _ => rfl

    have h_descPoly_attach : ∀ {α : Type} (t : _root_.BinaryTree α) (k : α) (acc : List (α × _root_.BinaryTree α)),
        t.minKey? = some k →
        twAttachPoly (.node k .nil (twDescendLeftPoly t acc).1) (twDescendLeftPoly t acc).2 =
          twAttachPoly t acc := by
      intro α t
      induction t with
      | nil => intro k _ h; simp [_root_.BinaryTree.minKey?] at h
      | node key l r ihl _ =>
        intro k acc h
        rcases l with _ | ⟨lk, ll, lr⟩
        · simp only [_root_.BinaryTree.minKey?] at h
          injection h with hEq
          subst hEq
          simp [twDescendLeftPoly]
        · have hl_ne : _root_.BinaryTree.node lk ll lr ≠ .nil := by simp
          cases hl : (_root_.BinaryTree.node lk ll lr).minKey? with
          | none => exact absurd ((h_minKey_none _).mp hl) hl_ne
          | some m =>
            rw [h_minKey_node, hl] at h
            injection h with hEq
            subst hEq
            simpa [twDescendLeftPoly, twAttachPoly] using ihl m ((key, r) :: acc) hl

    have h_forall_attach : ∀ {α : Type} (p : α → Prop) (c : _root_.BinaryTree α)
        (path : List (α × _root_.BinaryTree α)),
        ForallTree p (twAttachPoly c path) ↔
          ForallTree p c ∧ ∀ pair ∈ path, p pair.1 ∧ ForallTree p pair.2 := by
      intro α p c path
      induction path generalizing c with
      | nil => simp [twAttachPoly]
      | cons hd rest ih =>
        rcases hd with ⟨k, s⟩
        simp only [twAttachPoly, ih, List.mem_cons, forall_eq_or_imp]
        constructor
        · rintro ⟨hnode, hrest⟩
          cases hnode with
          | node _ _ _ hc hk hs => exact ⟨hc, ⟨hk, hs⟩, hrest⟩
        · rintro ⟨hc, ⟨hk, hs⟩, hrest⟩
          exact ⟨.node c k s hc hk hs, hrest⟩

    have h_forall_splayPoly : ∀ {α : Type} (n : ℕ) (p : α → Prop) (c : _root_.BinaryTree α)
        (path : List (α × _root_.BinaryTree α)),
        path.length ≤ n →
        (ForallTree p (twSplayLeftSpinePoly c path) ↔ ForallTree p (twAttachPoly c path)) := by
      intro α n
      induction n with
      | zero =>
        intro p c path hlen
        rcases path with _ | _
        · rfl
        · simp at hlen
      | succ n ih =>
        intro p c path hlen
        rcases path with _ | ⟨⟨k1, s1⟩, _ | ⟨⟨k2, s2⟩, rest⟩⟩
        · rfl
        · rfl
        · have hrest : rest.length ≤ n := by simp at hlen; omega
          simp only [twSplayLeftSpinePoly, twAttachPoly]
          rw [ih p (.node k1 c (.node k2 s1 s2)) rest hrest]
          rw [h_forall_attach, h_forall_attach]
          constructor
          · rintro ⟨h1, hrest_p⟩
            cases h1 with
            | node _ _ _ hc hk1 hs12 =>
              cases hs12 with
              | node _ _ _ hs1 hk2 hs2 =>
                exact ⟨.node (.node k1 c s1) k2 s2 (.node c k1 s1 hc hk1 hs1) hk2 hs2, hrest_p⟩
          · rintro ⟨h1, hrest_p⟩
            cases h1 with
            | node _ _ _ hcs1 hk2 hs2 =>
              cases hcs1 with
              | node _ _ _ hc hk1 hs1 =>
                exact ⟨.node c k1 (.node k2 s1 s2) hc hk1 (.node s1 k2 s2 hs1 hk2 hs2), hrest_p⟩

    have h_bst_attach_head : ∀ {α : Type} [LinearOrder α] (c : _root_.BinaryTree α)
        (path : List (α × _root_.BinaryTree α)),
        IsBST (twAttachPoly c path) → IsBST c := by
      intro α _ c path
      induction path generalizing c with
      | nil => exact id
      | cons hd rest ih =>
        intro h
        have hnode := ih (.node hd.1 c hd.2) h
        cases hnode using isBSTCases with
        | node _ _ _ _ _ hc _ => exact hc

    have h_bst_attach_gt : ∀ {α : Type} [LinearOrder α] (x : α) (c : _root_.BinaryTree α)
        (path : List (α × _root_.BinaryTree α)),
        IsBST (twAttachPoly c path) → twTreeMem x c →
        ∀ pair ∈ path, x < pair.1 ∧ ForallTree (fun y => x < y) pair.2 := by
      intro α _ x c path
      induction path generalizing c with
      | nil => intro _ _ _ hp; simp at hp
      | cons hd rest ih =>
        rcases hd with ⟨k, s⟩
        intro hbst hmem pair hpair
        have hnode : IsBST (.node k c s) := h_bst_attach_head (.node k c s) rest hbst
        cases hnode using isBSTCases with
        | node _ _ _ hc_lt hs_gt _ _ =>
          have hxk : x < k := h_mem_forall (fun y => y < k) hc_lt hmem
          rcases List.mem_cons.mp hpair with rfl | hrest
          · exact ⟨hxk, h_forall_mono (fun _ hy => lt_trans hxk hy) hs_gt⟩
          · exact ih (.node k c s) hbst (Or.inr (Or.inl hmem)) pair hrest

    have h_bst_attach_congr : ∀ {α : Type} [LinearOrder α] (c c' : _root_.BinaryTree α)
        (path : List (α × _root_.BinaryTree α)),
        IsBST (twAttachPoly c path) → IsBST c' →
        (∀ p : α → Prop, ForallTree p c → ForallTree p c') →
        IsBST (twAttachPoly c' path) := by
      intro α _ c c' path
      induction path generalizing c c' with
      | nil => intro _ hc' _; exact hc'
      | cons hd rest ih =>
        rcases hd with ⟨k, s⟩
        intro hbst hc' himp
        have hnode : IsBST (.node k c s) := h_bst_attach_head (.node k c s) rest hbst
        cases hnode using isBSTCases with
        | node _ _ _ hc_lt hs_gt _ hs_bst =>
          have hnode' : IsBST (.node k c' s) :=
            .node k c' s (himp _ hc_lt) hs_gt hc' hs_bst
          refine ih (.node k c s) (.node k c' s) hbst hnode' ?_
          intro p hp
          cases hp with
          | node _ _ _ hpc hpk hps =>
            exact .node c' k s (himp p hpc) hpk hps

    have h_bst_splayPoly : ∀ {α : Type} [LinearOrder α] (n : ℕ) (c : _root_.BinaryTree α)
        (path : List (α × _root_.BinaryTree α)),
        path.length ≤ n → IsBST (twAttachPoly c path) → IsBST (twSplayLeftSpinePoly c path) := by
      intro α _ n
      induction n with
      | zero =>
        intro c path hlen hbst
        rcases path with _ | _
        · exact hbst
        · simp at hlen
      | succ n ih =>
        intro c path hlen hbst
        rcases path with _ | ⟨⟨k1, s1⟩, _ | ⟨⟨k2, s2⟩, rest⟩⟩
        · exact hbst
        · exact hbst
        · have hrest : rest.length ≤ n := by simp at hlen; omega
          simp only [twAttachPoly] at hbst
          have hbef : IsBST (.node k2 (.node k1 c s1) s2) :=
            h_bst_attach_head (.node k2 (.node k1 c s1) s2) rest hbst
          have haft : IsBST (.node k1 c (.node k2 s1 s2)) := by
            cases hbef using isBSTCases with
            | node _ _ _ hcs1_lt hs2_gt hcs1_bst hs2_bst =>
              cases hcs1_bst using isBSTCases with
              | node _ _ _ hc_lt hs1_gt hc_bst hs1_bst =>
                cases hcs1_lt with
                | node _ _ _ _ hk12 hs1_lt2 =>
                  exact .node k1 c (.node k2 s1 s2) hc_lt
                    (.node s1 k2 s2 hs1_gt hk12 (h_forall_mono (fun _ hy => lt_trans hk12 hy) hs2_gt))
                    hc_bst (.node k2 s1 s2 hs1_lt2 hs2_gt hs1_bst hs2_bst)
          have hbst' : IsBST (twAttachPoly (.node k1 c (.node k2 s1 s2)) rest) := by
            refine h_bst_attach_congr (.node k2 (.node k1 c s1) s2) (.node k1 c (.node k2 s1 s2))
              rest hbst haft ?_
            intro p hp
            cases hp with
            | node _ _ _ hcs1 hpk2 hps2 =>
              cases hcs1 with
              | node _ _ _ hpc hpk1 hps1 =>
                exact .node _ _ _ hpc hpk1 (.node _ _ _ hps1 hpk2 hps2)
          exact ih (.node k1 c (.node k2 s1 s2)) rest hrest hbst'

    have h_desc_min : ∀ {α : Type} [LinearOrder α] (t : _root_.BinaryTree α) (k : α)
        (acc : List (α × _root_.BinaryTree α)),
        IsBST t → t.minKey? = some k →
        descend.go k t (acc.map twToFrameL) =
          (.node k .nil (twDescendLeftPoly t acc).1,
           (twDescendLeftPoly t acc).2.map twToFrameL) := by
      intro α _ t k acc hbst
      induction hbst using isBSTRec generalizing acc with
      | left => intro h; simp [_root_.BinaryTree.minKey?] at h
      | node key l r hl_lt _ _ _ ihl _ =>
        intro hmin
        rcases l with _ | ⟨lk, ll, lr⟩
        · simp only [_root_.BinaryTree.minKey?] at hmin
          injection hmin with hEq
          subst hEq
          simp [descend.go, twDescendLeftPoly]
        · have hl_ne : _root_.BinaryTree.node lk ll lr ≠ .nil := by simp
          cases hl : (_root_.BinaryTree.node lk ll lr).minKey? with
          | none => exact absurd ((h_minKey_none _).mp hl) hl_ne
          | some m =>
            rw [h_minKey_node, hl] at hmin
            injection hmin with hEq
            subst hEq
            have hm_lt : m < key := h_mem_forall (fun k => k < key) hl_lt (h_minKey_mem _ m hl)
            have hm_ne : m ≠ key := ne_of_lt hm_lt
            simp only [descend.go, if_neg hm_ne, if_pos hm_lt, twDescendLeftPoly]
            exact ihl ((key, r) :: acc) hl

    have h_splayUp_L : ∀ {α : Type} (n : ℕ) (k : α) (c : _root_.BinaryTree α)
        (path : List (α × _root_.BinaryTree α)),
        path.length ≤ n →
        splayUp (.node k .nil c) (path.map twToFrameL) =
          .node k .nil (twSplayLeftSpinePoly c path) := by
      intro α n
      induction n with
      | zero =>
        intro k c path hlen
        rcases path with _ | _
        · rfl
        · simp at hlen
      | succ n ih =>
        intro k c path hlen
        rcases path with _ | ⟨⟨k1, s1⟩, _ | ⟨⟨k2, s2⟩, rest⟩⟩
        · rfl
        · rfl
        · have hrest : rest.length ≤ n := by simp at hlen; omega
          simpa [splayUp, twToFrameL, Frame.attach, Dir.bringUp, _root_.BinaryTree.rotateRight,
            twSplayLeftSpinePoly] using ih k (.node k1 c (.node k2 s1 s2)) rest hrest

    have h_pop_spec : ∀ {α : Type} [LinearOrder α] (t : _root_.BinaryTree α),
        IsBST t → t ≠ .nil →
        ∃ k : α,
          t.minKey? = some k ∧
          twTreeMem k t ∧
          ForallTree (fun x => k ≤ x) t ∧
          SplayTree.pop t = twPopPoly t ∧
          popCost t = ((leftSpineLen (twEraseTree t) - 1 : ℕ) : ℝ) ∧
          IsBST (twPopPoly t) ∧
          ForallTree (fun x => k < x) (twPopPoly t) ∧
          (∀ p : α → Prop, ForallTree p t → ForallTree p (twPopPoly t)) := by
      intro α _ t hbst hne
      have h_splay_node : ∀ (u : _root_.BinaryTree α) (q : α)
          (l : _root_.BinaryTree α) (key : α) (r : _root_.BinaryTree α) (path : List (Frame α)),
          descend.go q u [] = (.node key l r, path) →
          splay u q = splayUp (.node key l r) path := by
        intro u q l key r path h
        unfold splay descend
        rw [h]
      cases hmin : t.minKey? with
      | none => exact absurd ((h_minKey_none t).mp hmin) hne
      | some k =>
        refine ⟨k, rfl, h_minKey_mem t k hmin, h_minKey_le t k hbst hmin, ?_, ?_, ?_, ?_, ?_⟩
        · have hd := h_desc_min t k [] hbst hmin
          simp only [List.map_nil] at hd
          unfold SplayTree.pop
          rw [hmin]
          dsimp (config := { failIfUnchanged := false }) only
          rw [h_splay_node t k .nil k _ _ hd, h_splayUp_L (twDescendLeftPoly t []).2.length k _ _ le_rfl]
          rfl
        · have hd := h_desc_min t k [] hbst hmin
          simp only [List.map_nil] at hd
          have hlen := h_descPoly_len t [] hne
          simp only [List.length_nil, Nat.add_zero] at hlen
          unfold popCost splay.cost descend
          rw [hmin]
          dsimp (config := { failIfUnchanged := false }) only
          rw [hd]
          simp only [List.length_map]
          have heq : (twDescendLeftPoly t []).2.length = leftSpineLen (twEraseTree t) - 1 := by omega
          rw [heq]
        · have hatt : twAttachPoly (.node k .nil (twDescendLeftPoly t []).1)
              (twDescendLeftPoly t []).2 = t := h_descPoly_attach t k [] hmin
          have hbst_att : IsBST (twAttachPoly (.node k .nil (twDescendLeftPoly t []).1)
              (twDescendLeftPoly t []).2) := by rw [hatt]; exact hbst
          have hhead := h_bst_attach_head _ _ hbst_att
          cases hhead using isBSTCases with
          | node _ _ _ _ _ _ hcr_bst =>
            have hbst_cr_att : IsBST (twAttachPoly (twDescendLeftPoly t []).1
                (twDescendLeftPoly t []).2) := by
              refine h_bst_attach_congr _ _ _ hbst_att hcr_bst ?_
              intro p hp
              cases hp with
              | node _ _ _ _ _ hpr => exact hpr
            exact h_bst_splayPoly (twDescendLeftPoly t []).2.length _ _ le_rfl hbst_cr_att
        · have hatt : twAttachPoly (.node k .nil (twDescendLeftPoly t []).1)
              (twDescendLeftPoly t []).2 = t := h_descPoly_attach t k [] hmin
          have hbst_att : IsBST (twAttachPoly (.node k .nil (twDescendLeftPoly t []).1)
              (twDescendLeftPoly t []).2) := by rw [hatt]; exact hbst
          have hhead := h_bst_attach_head _ _ hbst_att
          have hgt_path := h_bst_attach_gt k (.node k .nil (twDescendLeftPoly t []).1)
            (twDescendLeftPoly t []).2 hbst_att (Or.inl rfl)
          cases hhead using isBSTCases with
          | node _ _ _ _ hcr_gt _ _ =>
            unfold twPopPoly
            dsimp (config := { failIfUnchanged := false }) only
            rw [h_forall_splayPoly (twDescendLeftPoly t []).2.length _ _ _ le_rfl, h_forall_attach]
            exact ⟨hcr_gt, hgt_path⟩
        · intro p hpt
          have hatt : twAttachPoly (.node k .nil (twDescendLeftPoly t []).1)
              (twDescendLeftPoly t []).2 = t := h_descPoly_attach t k [] hmin
          rw [← hatt, h_forall_attach] at hpt
          rcases hpt with ⟨hnode, hpath⟩
          cases hnode with
          | node _ _ _ _ _ hpcr =>
            unfold twPopPoly
            dsimp (config := { failIfUnchanged := false }) only
            rw [h_forall_splayPoly (twDescendLeftPoly t []).2.length _ _ _ le_rfl, h_forall_attach]
            exact ⟨hpcr, hpath⟩


    have h_eject_spec : ∀ {α : Type} [LinearOrder α] (neg : α → α)
        (hinv : ∀ x, neg (neg x) = x) (hlt : ∀ x y, neg x < neg y ↔ y < x)
        (t : _root_.BinaryTree α),
        IsBST t → t ≠ .nil →
        ∃ k : α,
          t.maxKey? = some k ∧
          twTreeMem k t ∧
          ForallTree (fun x => x ≤ k) t ∧
          SplayTree.eject t = twEjectPoly t ∧
          ejectCost t = ((rightSpineLen (twEraseTree t) - 1 : ℕ) : ℝ) ∧
          IsBST (twEjectPoly t) ∧
          ForallTree (fun x => x < k) (twEjectPoly t) ∧
          (∀ p : α → Prop, ForallTree p t → ForallTree p (twEjectPoly t)) := by
      intro α _ neg hinv hlt t hbst hne
      have hinj : ∀ x y, neg x = neg y ↔ x = y := by
        intro x y
        constructor
        · intro h
          have := congrArg neg h
          simpa [hinv] using this
        · intro h; rw [h]
      have hle : ∀ x y, neg x ≤ neg y ↔ y ≤ x := by
        intro x y
        rw [← not_lt, ← not_lt, hlt]
      have hneg_inv : ∀ u : _root_.BinaryTree α, twNegMirror neg (twNegMirror neg u) = u := by
        intro u
        unfold twNegMirror
        rw [← h_map_mirror, h_mirror_mirror, h_map_map]
        calc twMapTree (fun x => neg (neg x)) u
          _ = twMapTree (fun x => x) u := h_map_congr u hinv
          _ = u := h_map_id u
      have hneg_bst_imp : ∀ u : _root_.BinaryTree α, IsBST u → IsBST (twNegMirror neg u) := by
        intro u hu
        induction hu using isBSTRec with
        | left => exact .left
        | node key l r hl_lt hr_gt _ _ ihl ihr =>
          refine .node (neg key) (twNegMirror neg r) (twNegMirror neg l) ?_ ?_ ihr ihl
          · unfold twNegMirror
            rw [h_forall_map, h_forall_mirror]
            exact h_forall_mono (fun x hx => (hlt x key).mpr hx) hr_gt
          · unfold twNegMirror
            rw [h_forall_map, h_forall_mirror]
            exact h_forall_mono (fun x hx => (hlt key x).mpr hx) hl_lt
      have hneg_min_max : ∀ u : _root_.BinaryTree α,
          (twNegMirror neg u).minKey? = Option.map neg u.maxKey? := by
        intro u
        induction u with
        | nil => rfl
        | node key l r _ ihr =>
          simp only [twNegMirror, twMirrorTree, twMapTree, _root_.BinaryTree.minKey?, _root_.BinaryTree.maxKey?]
          change (match (twNegMirror neg r).minKey? with | none => some (neg key) | some m => some m) = _
          rw [ihr]
          cases r.maxKey? <;> rfl
      have hneg_desc : ∀ (u : _root_.BinaryTree α) (q : α) (acc : List (Frame α)),
          descend.go (neg q) (twNegMirror neg u) (acc.map (twNegMirrorFrame neg)) =
            (twNegMirror neg (descend.go q u acc).1,
             (descend.go q u acc).2.map (twNegMirrorFrame neg)) := by
        intro u
        induction u with
        | nil => intro _ _; rfl
        | node key l r ihl ihr =>
          intro q acc
          simp only [twNegMirror, twMirrorTree, twMapTree, descend.go]
          by_cases hqk : q = key
          · subst hqk
            simp [twMirrorTree, twMapTree]
          · have hnq : neg q ≠ neg key := mt (hinj q key).mp hqk
            by_cases hqlt : q < key
            · have hnot : ¬(neg q < neg key) := by
                rw [hlt]
                exact not_lt_of_gt hqlt
              simp only [if_neg hqk, if_pos hqlt, if_neg hnq, if_neg hnot]
              exact ihl q ({ dir := .L, key := key, sibling := r } :: acc)
            · have hklt : key < q := lt_of_le_of_ne (le_of_not_gt hqlt) (Ne.symm hqk)
              have hyes : neg q < neg key := (hlt q key).mpr hklt
              simp only [if_neg hqk, if_neg hqlt, if_neg hnq, if_pos hyes]
              exact ihr q ({ dir := .R, key := key, sibling := l } :: acc)
      have hneg_rotR : ∀ u : _root_.BinaryTree α,
          twNegMirror neg (_root_.BinaryTree.rotateRight u) = _root_.BinaryTree.rotateLeft (twNegMirror neg u) := by
        rintro (_ | ⟨y, _ | ⟨x, a, b⟩, c⟩) <;> rfl
      have hneg_rotL : ∀ u : _root_.BinaryTree α,
          twNegMirror neg (_root_.BinaryTree.rotateLeft u) = _root_.BinaryTree.rotateRight (twNegMirror neg u) := by
        rintro (_ | ⟨x, a, _ | ⟨y, b, c⟩⟩) <;> rfl
      have hneg_bringUp : ∀ (d : Dir) (u : _root_.BinaryTree α),
          twNegMirror neg (d.bringUp u) = (twMirrorDir d).bringUp (twNegMirror neg u) := by
        rintro (_ | _) u
        · exact hneg_rotR u
        · exact hneg_rotL u
      have hneg_attach : ∀ (c : _root_.BinaryTree α) (f : Frame α),
          twNegMirror neg (f.attach c) = (twNegMirrorFrame neg f).attach (twNegMirror neg c) := by
        rintro c ⟨_ | _, k, sib⟩ <;> rfl
      have hneg_node : ∀ (l : _root_.BinaryTree α) (k : α) (r : _root_.BinaryTree α),
          twNegMirror neg (.node k l r) = .node (neg k) (twNegMirror neg r) (twNegMirror neg l) :=
        fun _ _ _ => rfl
      have hneg_empty : twNegMirror neg .nil = .nil := rfl
      have hneg_applyChild : ∀ (d1 d2 : Dir) (u : _root_.BinaryTree α),
          twNegMirror neg (applyChild d2 d1.bringUp u) =
            applyChild (twMirrorDir d2) (twMirrorDir d1).bringUp (twNegMirror neg u) := by
        rintro d1 (_ | _) (_ | ⟨k, l, r⟩) <;>
          simp [applyChild, hneg_node, hneg_empty, twMirrorDir, hneg_bringUp]
      have hneg_splayUp : ∀ (n : ℕ) (c : _root_.BinaryTree α) (path : List (Frame α)),
          path.length ≤ n →
          twNegMirror neg (splayUp c path) = splayUp (twNegMirror neg c) (path.map (twNegMirrorFrame neg)) := by
        intro n
        induction n with
        | zero =>
          intro c path hlen
          rcases path with _ | _
          · rfl
          · simp at hlen
        | succ n ih =>
          intro c path hlen
          rcases path with _ | ⟨f1, _ | ⟨f2, rest⟩⟩
          · rfl
          · simp [splayUp, hneg_bringUp, hneg_attach, twNegMirrorFrame]
          · have hrest : rest.length ≤ n := by simp at hlen; omega
            have hdir_iff : twMirrorDir f1.dir = twMirrorDir f2.dir ↔ f1.dir = f2.dir := by
              cases f1.dir <;> cases f2.dir <;> decide
            simp only [List.map_cons, splayUp, twNegMirrorFrame]
            by_cases hd : f1.dir = f2.dir
            · have hd' : twMirrorDir f1.dir = twMirrorDir f2.dir := hdir_iff.mpr hd
              simp only [if_pos hd, if_pos hd']
              rw [ih _ rest hrest, hneg_bringUp, hneg_bringUp, hneg_attach, hneg_attach]
              rfl
            · have hd' : ¬(twMirrorDir f1.dir = twMirrorDir f2.dir) := mt hdir_iff.mp hd
              simp only [if_neg hd, if_neg hd']
              rw [ih _ rest hrest, hneg_bringUp, hneg_applyChild, hneg_attach, hneg_attach]
              rfl
      have hneg_ne : twNegMirror neg t ≠ .nil := by
        cases t with
        | nil => exact absurd rfl hne
        | node k l r => simp [twNegMirror, twMirrorTree, twMapTree]
      obtain ⟨nk, hnmin, hnmem, hnle, hnpop, hncost, hnbst, hngt, hnfor⟩ :=
        h_pop_spec (twNegMirror neg t) (hneg_bst_imp t hbst) hneg_ne
      have hmax_eq : Option.map neg t.maxKey? = some nk := by
        rw [← hneg_min_max t]; exact hnmin
      cases hmax : t.maxKey? with
      | none => simp [hmax] at hmax_eq
      | some k =>
        simp only [hmax, Option.map_some, Option.some.injEq] at hmax_eq
        subst hmax_eq
        have hmem_map : ∀ (u : _root_.BinaryTree α) (x : α),
            twTreeMem (neg x) (twNegMirror neg u) → twTreeMem x u := by
          intro u x
          induction u with
          | nil => intro h; cases h
          | node key l r ihl ihr =>
            intro h
            rcases h with h1 | h2 | h3
            · exact Or.inl ((hinj x key).mp h1)
            · exact Or.inr (Or.inr (ihr h2))
            · exact Or.inr (Or.inl (ihl h3))
        have hpop_neg_eq : twPopPoly (twNegMirror neg t) = twNegMirror neg (twEjectPoly t) := by
          unfold twNegMirror twEjectPoly
          rw [← h_popPoly_map, h_mirror_mirror]
        refine ⟨k, rfl, hmem_map t k hnmem, ?_, ?_, ?_, ?_, ?_, ?_⟩
        · unfold twNegMirror at hnle
          rw [h_forall_map, h_forall_mirror] at hnle
          exact h_forall_mono (fun x hx => (hle k x).mp hx) hnle
        · have hsplay_eq : twNegMirror neg (splay t k) = splay (twNegMirror neg t) (neg k) := by
            unfold splay descend
            have hd := hneg_desc t k []
            simp only [List.map_nil] at hd
            rw [hd]
            rcases hdg : descend.go k t [] with ⟨c, path⟩
            cases c with
            | nil =>
              cases path with
              | nil => rfl
              | cons f rest =>
                simp only [hneg_empty, List.map_cons]
                rw [hneg_splayUp rest.length _ rest le_rfl, hneg_attach, hneg_empty]
            | node ck cl cr =>
              cases path with
              | nil => rfl
              | cons f rest =>
                simp only [hneg_node, List.map_cons]
                change twNegMirror neg (splayUp (.node ck cl cr) (f :: rest)) =
                  splayUp (.node (neg ck) (twNegMirror neg cr) (twNegMirror neg cl))
                    (twNegMirrorFrame neg f :: rest.map (twNegMirrorFrame neg))
                rw [← hneg_node]
                exact hneg_splayUp (f :: rest).length (.node ck cl cr) (f :: rest) le_rfl
          have hright_neg : ∀ u : _root_.BinaryTree α,
              (twNegMirror neg u).right = twNegMirror neg u.left := by
            rintro (_ | ⟨key, l, r⟩) <;> rfl
          have heject_neg : twNegMirror neg (SplayTree.eject t) = SplayTree.pop (twNegMirror neg t) := by
            unfold SplayTree.eject SplayTree.pop
            rw [hmax, hnmin]
            dsimp (config := { failIfUnchanged := false }) only
            rw [← hright_neg, hsplay_eq]
          have h1 : twNegMirror neg (SplayTree.eject t) = twNegMirror neg (twEjectPoly t) := by
            rw [heject_neg, hnpop, hpop_neg_eq]
          have h2 := congrArg (twNegMirror neg) h1
          simpa [hneg_inv] using h2
        · have hcost_eq : splay.cost t k = splay.cost (twNegMirror neg t) (neg k) := by
            unfold splay.cost descend
            have hd := hneg_desc t k []
            simp only [List.map_nil] at hd
            rw [hd]
            rcases descend.go k t [] with ⟨_ | _, _ | _⟩ <;>
              simp [twNegMirror, twMirrorTree, twMapTree]
          unfold ejectCost
          unfold popCost at hncost
          rw [hmax]
          dsimp (config := { failIfUnchanged := false }) only
          rw [hcost_eq]
          rw [hnmin] at hncost
          dsimp (config := { failIfUnchanged := false }) only at hncost
          rw [hncost]
          have herase_neg : twEraseTree (twNegMirror neg t) = twMirrorTree (twEraseTree t) := by
            unfold twNegMirror
            rw [h_erase_map]
            exact h_map_mirror (fun _ => ()) t
          rw [herase_neg, h_lsl_mirror]
        · rw [hpop_neg_eq] at hnbst
          have h1 := hneg_bst_imp _ hnbst
          rw [hneg_inv] at h1
          exact h1
        · rw [hpop_neg_eq] at hngt
          unfold twNegMirror at hngt
          rw [h_forall_map, h_forall_mirror] at hngt
          exact h_forall_mono (fun x hx => (hlt k x).mp hx) hngt
        · intro p hpt
          have hnpt : ForallTree (fun y => p (neg y)) (twNegMirror neg t) := by
            unfold twNegMirror
            rw [h_forall_map, h_forall_mirror]
            exact h_forall_mono (fun x hx => by simpa [hinv x] using hx) hpt
          have hres := hnfor (fun y => p (neg y)) hnpt
          rw [hpop_neg_eq] at hres
          unfold twNegMirror at hres
          rw [h_forall_map, h_forall_mirror] at hres
          exact h_forall_mono (fun x hx => by simpa [hinv x] using hx) hres


    have h_dequeSeq_succ : ∀ {m : ℕ} (t : _root_.BinaryTree ℤ) (ops : Fin (m + 1) → DequeOp ℤ)
        (i : Fin (m + 1)),
        dequeSeq t ops i.succ = dequeSeq ((ops 0).step t) (fun j => ops j.succ) i := by
      intro m t ops i
      have hrec : ∀ k : ℕ,
          (@Nat.recOn (fun _ => _root_.BinaryTree ℤ) (k + 1) t
            (fun j acc => if h : j < m + 1 then (ops ⟨j, h⟩).step acc else acc)) =
          (@Nat.recOn (fun _ => _root_.BinaryTree ℤ) k ((ops 0).step t)
            (fun j acc => if h : j < m then (ops (Fin.succ ⟨j, h⟩)).step acc else acc)) := by
        intro k
        induction k with
        | zero =>
          change (if h : 0 < m + 1 then (ops ⟨0, h⟩).step t else t) = (ops 0).step t
          have h0 : 0 < m + 1 := Nat.zero_lt_succ m
          rw [dif_pos h0]
          rfl
        | succ k ih =>
          dsimp (config := { failIfUnchanged := false }) only [Nat.recOn] at ih ⊢
          rw [ih]
          by_cases hk : k < m
          · have hk1 : k + 1 < m + 1 := Nat.succ_lt_succ hk
            rw [dif_pos hk1, dif_pos hk]
            rfl
          · have hk1 : ¬(k + 1 < m + 1) := fun h => hk (Nat.lt_of_succ_lt_succ h)
            rw [dif_neg hk1, dif_neg hk]
      exact hrec i.val

    have h_stage1_gen : ∀ (k : ℕ) (t : _root_.BinaryTree ℤ) (ops : Fin k → DequeOp ℤ),
        IsBST t → ValidDequeSeq t ops →
        let uops := List.ofFn (fun i => twToUDequeOp (ops i))
        TwValidUDequeSeq (twEraseTree t) uops ∧
        dequeSequenceCost t ops = ((twUDequeSeqCost (twEraseTree t) uops : ℕ) : ℝ) := by
      intro k
      induction k with
      | zero =>
        intro t ops _ _
        simp [dequeSequenceCost, twUDequeSeqCost, TwValidUDequeSeq]
      | succ k ih =>
        intro t ops hbst hval
        have h0 : (ops 0).Valid t := by
          simpa [dequeSeq] using hval 0
        have hval_tail : ValidDequeSeq ((ops 0).step t) (fun j => ops j.succ) := by
          intro j
          have hj := hval j.succ
          have hcast : (j.succ).castSucc = (j.castSucc).succ := by ext; rfl
          rw [hcast, h_dequeSeq_succ] at hj
          exact hj
        have hcost_split : dequeSequenceCost t ops =
            (ops 0).cost t + dequeSequenceCost ((ops 0).step t) (fun j => ops j.succ) := by
          unfold dequeSequenceCost
          rw [Fin.sum_univ_succ]
          congr 1
          refine Finset.sum_congr rfl (fun j _ => ?_)
          have hcast : (j.succ).castSucc = (j.castSucc).succ := by ext; rfl
          rw [hcast, h_dequeSeq_succ]
        dsimp (config := { failIfUnchanged := false }) only
        rw [List.ofFn_succ, hcost_split]
        cases hop0 : ops 0 with
        | pop =>
          rw [hop0] at h0 hval_tail
          have hne : t ≠ .nil := h0
          have he_ne : twEraseTree t ≠ .nil := by
            cases t with
            | nil => exact absurd rfl hne
            | node _ _ _ => simp [twEraseTree, twMapTree]
          obtain ⟨_, _, _, _, hpop_eq, hpop_cost, hpop_bst, _, _⟩ := h_pop_spec t hbst hne
          simp only [DequeOp.step] at hval_tail ⊢
          rw [hpop_eq] at hval_tail ⊢
          obtain ⟨hval_u, hcost_u⟩ := ih (twPopPoly t) (fun j => ops j.succ) hpop_bst hval_tail
          rw [h_popPoly_erase] at hval_u hcost_u
          refine ⟨⟨he_ne, hval_u⟩, ?_⟩
          rw [show twToUDequeOp (.pop : DequeOp ℤ) = .pop from rfl]
          simp only [DequeOp.cost, twUDequeSeqCost, twCostUDeque, twStepUDeque]
          rw [hpop_cost, hcost_u]
          push_cast
          ring
        | push x =>
          rw [hop0] at h0 hval_tail
          simp only [DequeOp.Valid, DequeOp.step, SplayTree.push] at h0 hval_tail ⊢
          have hpush_bst : IsBST (.node x .nil t) :=
            .node x .nil t .left ((forallTree_iff _ _).mpr h0) .left hbst
          obtain ⟨hval_u, hcost_u⟩ := ih (.node x .nil t) (fun j => ops j.succ) hpush_bst hval_tail
          have herase_push : twEraseTree (.node x .nil t) = .node () .nil (twEraseTree t) := rfl
          rw [herase_push] at hval_u hcost_u
          refine ⟨hval_u, ?_⟩
          rw [show twToUDequeOp (.push x) = .push from rfl]
          simp only [DequeOp.cost, twUDequeSeqCost, twCostUDeque, twStepUDeque, zero_add]
          exact hcost_u
        | eject =>
          rw [hop0] at h0 hval_tail
          have hne : t ≠ .nil := h0
          have he_ne : twEraseTree t ≠ .nil := by
            cases t with
            | nil => exact absurd rfl hne
            | node _ _ _ => simp [twEraseTree, twMapTree]
          obtain ⟨_, _, _, _, hej_eq, hej_cost, hej_bst, _, _⟩ :=
            h_eject_spec (fun z : ℤ => -z) (fun z => by ring)
              (fun a b => by dsimp (config := { failIfUnchanged := false }) only; omega) t hbst hne
          simp only [DequeOp.step] at hval_tail ⊢
          rw [hej_eq] at hval_tail ⊢
          obtain ⟨hval_u, hcost_u⟩ := ih (twEjectPoly t) (fun j => ops j.succ) hej_bst hval_tail
          rw [h_ejectPoly_erase] at hval_u hcost_u
          refine ⟨⟨he_ne, hval_u⟩, ?_⟩
          rw [show twToUDequeOp (.eject : DequeOp ℤ) = .eject from rfl]
          simp only [DequeOp.cost, twUDequeSeqCost, twCostUDeque, twStepUDeque]
          rw [hej_cost, hcost_u]
          push_cast
          ring
        | inject x =>
          rw [hop0] at h0 hval_tail
          simp only [DequeOp.Valid, DequeOp.step, SplayTree.inject] at h0 hval_tail ⊢
          have hinj_bst : IsBST (.node x t .nil) :=
            .node x t .nil ((forallTree_iff _ _).mpr h0) .left hbst .left
          obtain ⟨hval_u, hcost_u⟩ := ih (.node x t .nil) (fun j => ops j.succ) hinj_bst hval_tail
          have herase_inj : twEraseTree (.node x t .nil) = .node () (twEraseTree t) .nil := rfl
          rw [herase_inj] at hval_u hcost_u
          refine ⟨hval_u, ?_⟩
          rw [show twToUDequeOp (.inject x) = .inject from rfl]
          simp only [DequeOp.cost, twUDequeSeqCost, twCostUDeque, twStepUDeque, zero_add]
          exact hcost_u


    have h_label_spec : ∀ (u : _root_.BinaryTree Unit) (k : ℕ),
        (twLabelInorderAux u k).2 = k + u.num_nodes ∧
        twEraseTree (twLabelInorderAux u k).1 = u ∧
        ForallTree (fun x => k ≤ x ∧ x < k + u.num_nodes) (twLabelInorderAux u k).1 ∧
        IsBST (twLabelInorderAux u k).1 := by
      intro u
      induction u with
      | nil =>
        intro k
        simp only [twLabelInorderAux, _root_.BinaryTree.num_nodes]
        exact ⟨by omega, rfl, .left, .left⟩
      | node u0 l r ihl ihr =>
        intro k
        cases u0
        obtain ⟨hl2, hle, hlb, hlbst⟩ := ihl k
        obtain ⟨hr2, hre, hrb, hrbst⟩ := ihr ((twLabelInorderAux l k).2 + 1)
        simp only [twLabelInorderAux]
        refine ⟨?_, ?_, ?_, ?_⟩
        · simp only [_root_.BinaryTree.num_nodes]; omega
        · unfold twEraseTree at hle hre ⊢
          simp [twMapTree, hle, hre]
        · refine .node _ _ _ ?_ ?_ ?_
          · exact h_forall_mono (fun x hx => by simp [_root_.BinaryTree.num_nodes]; omega) hlb
          · simp [_root_.BinaryTree.num_nodes]; omega
          · exact h_forall_mono (fun x hx => by simp [_root_.BinaryTree.num_nodes]; omega) hrb
        · refine .node _ _ _ ?_ ?_ hlbst hrbst
          · exact h_forall_mono (fun x hx => by omega) hlb
          · exact h_forall_mono (fun x hx => by omega) hrb

    have h_bst_strictMono : ∀ {α β : Type} [LinearOrder α] [LinearOrder β]
        (f : α → β) (hf : StrictMono f) (t : _root_.BinaryTree α),
        IsBST t → IsBST (twMapTree f t) := by
      intro α β _ _ f hf t hbst
      induction hbst using isBSTRec with
      | left => exact .left
      | node key l r hl hr _ _ ihl ihr =>
        refine .node (f key) (twMapTree f l) (twMapTree f r) ?_ ?_ ihl ihr
        · rw [h_forall_map]; exact h_forall_mono (fun x hx => hf hx) hl
        · rw [h_forall_map]; exact h_forall_mono (fun x hx => hf hx) hr

    have h_fate_mono : ∀ (Lm Rm x y : ℚ),
        x ≤ y → twFateCode (twFateOf Lm Rm x) ≤ twFateCode (twFateOf Lm Rm y) := by
      intro Lm Rm x y hxy
      unfold twFateOf
      split_ifs with h1 h2 h3 h4 h5 <;> simp [twFateCode] <;> linarith

    have h_bst_tri : ∀ (Lm Rm : ℚ) (T : _root_.BinaryTree ℚ),
        IsBST T → TwIsTriOrdered (twMapTree (twFateOf Lm Rm) T) := by
      intro Lm Rm T hbst
      induction hbst using isBSTRec with
      | left => trivial
      | node key l r hl hr _ _ ihl ihr =>
        simp only [twMapTree, TwIsTriOrdered]
        refine ⟨?_, ?_, ihl, ihr⟩
        · rw [h_forall_map]
          exact h_forall_mono (fun x hx => h_fate_mono Lm Rm x key (le_of_lt hx)) hl
        · rw [h_forall_map]
          exact h_forall_mono (fun x hx => h_fate_mono Lm Rm key x (le_of_lt hx)) hr

    have h_mem_countFate : ∀ (f : ℚ → TwFate) (x : ℚ) (T : _root_.BinaryTree ℚ),
        twTreeMem x T → 1 ≤ twCountFate (f x) (twMapTree f T) := by
      intro f x T
      induction T with
      | nil => intro h; cases h
      | node k l r ihl ihr =>
        intro h
        simp only [twMapTree, twCountFate]
        rcases h with rfl | hl | hr
        · simp; omega
        · have := ihl hl; omega
        · have := ihr hr; omega

    have h_allM_counts : ∀ (Lm Rm : ℚ) (T : _root_.BinaryTree ℚ),
        ForallTree (fun y => Lm < y ∧ y < Rm) T →
        twCountFate .L (twMapTree (twFateOf Lm Rm) T) = 0 ∧
        twCountFate .R (twMapTree (twFateOf Lm Rm) T) = 0 := by
      intro Lm Rm T hfor
      induction hfor with
      | left => simp [twMapTree, twCountFate]
      | node l k r _ hk _ ihl ihr =>
        have hfk : twFateOf Lm Rm k = .M := by
          unfold twFateOf
          rw [if_neg (not_le_of_gt hk.1), if_pos hk.2]
        simp [twMapTree, twCountFate, hfk, ihl.1, ihl.2, ihr.1, ihr.2]

    have h_buildCops_erase : ∀ (Lm Rm : ℚ) (uops : List TwUDequeOp) (T : _root_.BinaryTree ℚ) (L R : ℚ),
        (twBuildCops Lm Rm T L R uops).map twEraseCDequeOp = uops := by
      intro Lm Rm uops
      induction uops with
      | nil => intro _ _ _; rfl
      | cons op rest ih =>
        intro T L R
        cases op <;> simp [twBuildCops, twEraseCDequeOp, ih]

    have h_stage2_loop : ∀ (Lm Rm : ℚ) (uops : List TwUDequeOp) (T : _root_.BinaryTree ℚ) (L R : ℚ),
        TwValidUDequeSeq (twEraseTree T) uops →
        IsBST T →
        L < R →
        ForallTree (fun y => L < y ∧ y < R) T →
        twFinalBounds T L R uops = (Lm, Rm) →
        L ≤ Lm ∧ Lm < Rm ∧ Rm ≤ R ∧
        TwValidCDequeSeq (twMapTree (twFateOf Lm Rm) T) (twBuildCops Lm Rm T L R uops) := by
      intro Lm Rm uops
      induction uops with
      | nil =>
        intro T L R _ hbst hLR hbnd hfin
        simp only [twFinalBounds, Prod.mk.injEq] at hfin
        rcases hfin with ⟨rfl, rfl⟩
        obtain ⟨hcL, hcR⟩ := h_allM_counts L R T hbnd
        exact ⟨le_rfl, hLR, le_rfl, h_bst_tri L R T hbst, hcL, hcR⟩
      | cons op rest ih =>
        intro T L R hval hbst hLR hbnd hfin
        cases op with
        | push =>
          simp only [twFinalBounds, twBuildCops] at hfin ⊢
          cases hmin : T.minKey? with
          | none =>
            have hT_emp : T = .nil := (h_minKey_none T).mp hmin
            subst hT_emp
            simp only [hmin] at hfin ⊢
            set q := (L + R) / 2
            have hLq : L < q := by dsimp (config := { failIfUnchanged := false }) [q]; linarith
            have hqR : q < R := by dsimp (config := { failIfUnchanged := false }) [q]; linarith
            have hbst' : IsBST (.node q .nil .nil) := .node q .nil .nil .left .left .left .left
            have hbnd' : ForallTree (fun y => L < y ∧ y < R) (.node q .nil .nil) :=
              .node .nil q .nil .left ⟨hLq, hqR⟩ .left
            obtain ⟨h1, h2, h3, hvc⟩ := ih (.node q .nil .nil) L R hval hbst' hLR hbnd' hfin
            exact ⟨h1, h2, h3, trivial, .left, hvc⟩
          | some x =>
            simp only [hmin] at hfin ⊢
            have hx_mem : twTreeMem x T := h_minKey_mem T x hmin
            have hx_bnd : L < x ∧ x < R := h_mem_forall (fun y => L < y ∧ y < R) hbnd hx_mem
            have hx_le : ForallTree (fun y => x ≤ y) T := h_minKey_le T x hbst hmin
            set q := (L + x) / 2
            have hLq : L < q := by dsimp (config := { failIfUnchanged := false }) [q]; linarith [hx_bnd.1]
            have hqx : q < x := by dsimp (config := { failIfUnchanged := false }) [q]; linarith [hx_bnd.1]
            have hqR : q < R := lt_trans hqx hx_bnd.2
            have hq_lt_T : ForallTree (fun y => q < y) T :=
              h_forall_mono (fun y hy => lt_of_lt_of_le hqx hy) hx_le
            have hbst' : IsBST (.node q .nil T) := .node q .nil T .left hq_lt_T .left hbst
            have hbnd' : ForallTree (fun y => L < y ∧ y < R) (.node q .nil T) :=
              .node .nil q T .left ⟨hLq, hqR⟩ hbnd
            obtain ⟨h1, h2, h3, hvc⟩ := ih (.node q .nil T) L R hval hbst' hLR hbnd' hfin
            refine ⟨h1, h2, h3, h_bst_tri Lm Rm T hbst, ?_, hvc⟩
            rw [h_forall_map]
            exact h_forall_mono (fun y hy => h_fate_mono Lm Rm q y (le_of_lt hy)) hq_lt_T
        | inject =>
          simp only [twFinalBounds, twBuildCops] at hfin ⊢
          by_cases hT_emp : T = .nil
          · subst hT_emp
            simp only [_root_.BinaryTree.maxKey?] at hfin ⊢
            set q := (L + R) / 2
            have hLq : L < q := by dsimp (config := { failIfUnchanged := false }) [q]; linarith
            have hqR : q < R := by dsimp (config := { failIfUnchanged := false }) [q]; linarith
            have hbst' : IsBST (.node q .nil .nil) := .node q .nil .nil .left .left .left .left
            have hbnd' : ForallTree (fun y => L < y ∧ y < R) (.node q .nil .nil) :=
              .node .nil q .nil .left ⟨hLq, hqR⟩ .left
            obtain ⟨h1, h2, h3, hvc⟩ := ih (.node q .nil .nil) L R hval hbst' hLR hbnd' hfin
            exact ⟨h1, h2, h3, trivial, .left, hvc⟩
          · obtain ⟨z, hmax, hz_mem, hz_ge, _, _, _, _, _⟩ :=
              h_eject_spec (fun q : ℚ => -q) (fun q => by ring)
                (fun a b => by dsimp (config := { failIfUnchanged := false }) only; constructor <;> intro h <;> linarith) T hbst hT_emp
            simp only [hmax] at hfin ⊢
            have hz_bnd : L < z ∧ z < R := h_mem_forall (fun y => L < y ∧ y < R) hbnd hz_mem
            set q := (z + R) / 2
            have hzq : z < q := by dsimp (config := { failIfUnchanged := false }) [q]; linarith [hz_bnd.2]
            have hqR : q < R := by dsimp (config := { failIfUnchanged := false }) [q]; linarith [hz_bnd.2]
            have hLq : L < q := lt_trans hz_bnd.1 hzq
            have hT_lt_q : ForallTree (fun y => y < q) T :=
              h_forall_mono (fun y hy => lt_of_le_of_lt hy hzq) hz_ge
            have hbst' : IsBST (.node q T .nil) := .node q T .nil hT_lt_q .left hbst .left
            have hbnd' : ForallTree (fun y => L < y ∧ y < R) (.node q T .nil) :=
              .node T q .nil hbnd ⟨hLq, hqR⟩ .left
            obtain ⟨h1, h2, h3, hvc⟩ := ih (.node q T .nil) L R hval hbst' hLR hbnd' hfin
            refine ⟨h1, h2, h3, h_bst_tri Lm Rm T hbst, ?_, hvc⟩
            rw [h_forall_map]
            exact h_forall_mono (fun y hy => h_fate_mono Lm Rm y q (le_of_lt hy)) hT_lt_q
        | pop =>
          rcases hval with ⟨he_ne, hval_rest⟩
          have hT_ne : T ≠ .nil := by
            intro h; subst h; exact he_ne rfl
          obtain ⟨x, hmin, hx_mem, _, _, _, hpop_bst, hpop_gt, hpop_for⟩ := h_pop_spec T hbst hT_ne
          simp only [twFinalBounds, twBuildCops, hmin, Option.getD_some] at hfin ⊢
          have hx_bnd : L < x ∧ x < R := h_mem_forall (fun y => L < y ∧ y < R) hbnd hx_mem
          have hbnd_pop : ForallTree (fun y => x < y ∧ y < R) (twPopPoly T) :=
            h_forall_mono (fun _ h => ⟨h.1, h.2.2⟩) (h_forall_and hpop_gt (hpop_for _ hbnd))
          rw [← h_popPoly_erase] at hval_rest
          obtain ⟨hx_Lm, hLm_Rm, hRm_R, hvc⟩ :=
            ih (twPopPoly T) x R hval_rest hpop_bst hx_bnd.2 hbnd_pop hfin
          rw [h_popPoly_map] at hvc
          have hfx : twFateOf Lm Rm x = .L := by
            unfold twFateOf; rw [if_pos hx_Lm]
          have hcntL : 1 ≤ twCountFate .L (twMapTree (twFateOf Lm Rm) T) := by
            have := h_mem_countFate (twFateOf Lm Rm) x T hx_mem
            rwa [hfx] at this
          exact ⟨le_trans (le_of_lt hx_bnd.1) hx_Lm, hLm_Rm, hRm_R,
            h_bst_tri Lm Rm T hbst, hcntL, hvc⟩
        | eject =>
          rcases hval with ⟨he_ne, hval_rest⟩
          have hT_ne : T ≠ .nil := by
            intro h; subst h; exact he_ne rfl
          obtain ⟨z, hmax, hz_mem, _, _, _, hej_bst, hej_lt, hej_for⟩ :=
            h_eject_spec (fun q : ℚ => -q) (fun q => by ring)
              (fun a b => by dsimp (config := { failIfUnchanged := false }) only; constructor <;> intro h <;> linarith) T hbst hT_ne
          simp only [twFinalBounds, twBuildCops, hmax, Option.getD_some] at hfin ⊢
          have hz_bnd : L < z ∧ z < R := h_mem_forall (fun y => L < y ∧ y < R) hbnd hz_mem
          have hbnd_ej : ForallTree (fun y => L < y ∧ y < z) (twEjectPoly T) :=
            h_forall_mono (fun _ h => ⟨h.2.1, h.1⟩) (h_forall_and hej_lt (hej_for _ hbnd))
          rw [← h_ejectPoly_erase] at hval_rest
          obtain ⟨hL_Lm, hLm_Rm, hRm_z, hvc⟩ :=
            ih (twEjectPoly T) L z hval_rest hej_bst hz_bnd.1 hbnd_ej hfin
          rw [h_ejectPoly_map] at hvc
          have hfz : twFateOf Lm Rm z = .R := by
            unfold twFateOf
            rw [if_neg (by linarith), if_neg (by linarith)]
          have hcntR : 1 ≤ twCountFate .R (twMapTree (twFateOf Lm Rm) T) := by
            have := h_mem_countFate (twFateOf Lm Rm) z T hz_mem
            rwa [hfz] at this
          exact ⟨hL_Lm, hLm_Rm, le_trans hRm_z (le_of_lt hz_bnd.2),
            h_bst_tri Lm Rm T hbst, hcntR, hvc⟩


    set t0 := twEraseTree init.tree
    set uops := List.ofFn (fun i => twToUDequeOp (ops i))
    obtain ⟨hval_u, hcost_eq⟩ := h_stage1_gen m init.tree ops init.hBST hvalid
    have ht0_nodes : t0.num_nodes = n := by
      dsimp (config := { failIfUnchanged := false }) [t0, twEraseTree]; rw [h_map_nodes, hn]
    obtain ⟨_, hl_erase, hl_bnd, hl_bst⟩ := h_label_spec t0 0
    set T0 : _root_.BinaryTree ℚ := twMapTree (fun x : ℕ => (x : ℚ) + 1) (twLabelInorderAux t0 0).1
    have hT0_erase : twEraseTree T0 = t0 := by
      dsimp (config := { failIfUnchanged := false }) [T0]; rw [h_erase_map, hl_erase]
    have hT0_bst : IsBST T0 := by
      refine h_bst_strictMono (fun x : ℕ => (x : ℚ) + 1) ?_ _ hl_bst
      intro a b hab
      dsimp (config := { failIfUnchanged := false }) only
      have hq : (a : ℚ) < (b : ℚ) := Nat.cast_lt.mpr hab
      linarith
    set L0 : ℚ := 0
    set R0 : ℚ := (t0.num_nodes : ℚ) + 1
    have hL0R0 : L0 < R0 := by dsimp (config := { failIfUnchanged := false }) [L0, R0]; positivity
    have hT0_bnd : ForallTree (fun y => L0 < y ∧ y < R0) T0 := by
      dsimp (config := { failIfUnchanged := false }) [T0, L0, R0]
      rw [h_forall_map]
      refine h_forall_mono (fun x hx => ⟨by positivity, ?_⟩) hl_bnd
      have hx' : x < t0.num_nodes := by omega
      have hq : (x : ℚ) < (t0.num_nodes : ℚ) := by exact_mod_cast hx'
      linarith
    set bounds := twFinalBounds T0 L0 R0 uops
    obtain ⟨_, _, _, hvc0⟩ := h_stage2_loop bounds.1 bounds.2 uops T0 L0 R0
      (by rwa [hT0_erase]) hT0_bst hL0R0 hT0_bnd (Prod.eta bounds).symm
    set C0 := twMapTree (twFateOf bounds.1 bounds.2) T0
    set cops := twBuildCops bounds.1 bounds.2 T0 L0 R0 uops
    have hC0_erase : twEraseTree C0 = t0 := by
      dsimp (config := { failIfUnchanged := false }) [C0]; rw [h_erase_map, hT0_erase]
    have hcops_erase : cops.map twEraseCDequeOp = uops :=
      h_buildCops_erase bounds.1 bounds.2 uops T0 L0 R0
    refine ⟨C0, cops, ?_, ?_, hvc0, ?_⟩
    · calc C0.num_nodes = (twMapTree (fun _ => ()) C0).num_nodes := (h_map_nodes _ C0).symm
        _ = (twEraseTree C0).num_nodes := rfl
        _ = t0.num_nodes := by rw [hC0_erase]
        _ = n := ht0_nodes
    · calc cops.length = (cops.map twEraseCDequeOp).length := (List.length_map _).symm
        _ = uops.length := by rw [hcops_erase]
        _ = m := List.length_ofFn
    · rw [hC0_erase, hcops_erase]
      exact hcost_eq

  have h_stage3 :
      ∀ (n m : ℕ) (C0 : _root_.BinaryTree TwFate) (cops : List TwCDequeOp),
        C0.num_nodes = n →
        cops.length = m →
        TwValidCDequeSeq C0 cops →
        ∃ (d_L d_R : ℕ) (eops_L eops_R : List TwExtCoreOp),
          d_L + d_R ≤ m ∧
          twCountExtPop eops_L = d_L ∧
          twCountExtPop eops_R = d_R ∧
          TwValidExtCoreSeq (twProjL C0) eops_L ∧
          TwValidExtCoreSeq (twMirrorTree (twProjR C0)) eops_R ∧
          twUDequeSeqCost (twEraseTree C0) (cops.map twEraseCDequeOp) ≤
            2 * twExtCoreCascadeCost (twProjL C0) eops_L +
            2 * twExtCoreCascadeCost (twMirrorTree (twProjR C0)) eops_R +
            2 * n + 13 * m := by
    clear h_stage12 n m init ops hn hvalid
    intro n m C0 cops hn hm hvc
    have h_forall_mono : ∀ {α : Type} {p q : α → Prop} {t : _root_.BinaryTree α},
        (∀ x, p x → q x) → ForallTree p t → ForallTree q t := by
      intro α p q t hpq ht
      induction ht with
      | left => exact .left
      | node l k r _ hk _ ihl ihr => exact .node l k r ihl (hpq k hk) ihr

    have h_map_map : ∀ {α β γ : Type} (g : β → γ) (f : α → β) (t : _root_.BinaryTree α),
        twMapTree g (twMapTree f t) = twMapTree (fun x => g (f x)) t := by
      intro α β γ g f t
      induction t with
      | nil => rfl
      | node k l r ihl ihr => simp [twMapTree, ihl, ihr]

    have h_map_id : ∀ {α : Type} (t : _root_.BinaryTree α), twMapTree (fun x => x) t = t := by
      intro α t
      induction t with
      | nil => rfl
      | node k l r ihl ihr => simp [twMapTree, ihl, ihr]

    have h_map_congr : ∀ {α β : Type} {f g : α → β} (t : _root_.BinaryTree α),
        (∀ x, f x = g x) → twMapTree f t = twMapTree g t := by
      intro α β f g t hfg
      induction t with
      | nil => rfl
      | node k l r ihl ihr => simp [twMapTree, hfg, ihl, ihr]

    have h_erase_map : ∀ {α β : Type} (f : α → β) (t : _root_.BinaryTree α),
        twEraseTree (twMapTree f t) = twEraseTree t := by
      intro α β f t
      unfold twEraseTree
      rw [h_map_map]

    have h_mirror_mirror : ∀ {α : Type} (t : _root_.BinaryTree α), twMirrorTree (twMirrorTree t) = t := by
      intro α t
      induction t with
      | nil => rfl
      | node k l r ihl ihr => simp [twMirrorTree, ihl, ihr]

    have h_map_mirror : ∀ {α β : Type} (f : α → β) (t : _root_.BinaryTree α),
        twMapTree f (twMirrorTree t) = twMirrorTree (twMapTree f t) := by
      intro α β f t
      induction t with
      | nil => rfl
      | node k l r ihl ihr => simp [twMapTree, twMirrorTree, ihl, ihr]

    have h_forall_map : ∀ {α β : Type} (f : α → β) (p : β → Prop) (t : _root_.BinaryTree α),
        ForallTree p (twMapTree f t) ↔ ForallTree (fun x => p (f x)) t := by
      intro α β f p t
      induction t with
      | nil =>
        constructor <;> intro _ <;> exact .left
      | node k l r ihl ihr =>
        constructor
        · intro h
          cases h with
          | node _ _ _ hl hk hr => exact .node l k r (ihl.mp hl) hk (ihr.mp hr)
        · intro h
          cases h with
          | node _ _ _ hl hk hr =>
            exact .node (twMapTree f l) (f k) (twMapTree f r) (ihl.mpr hl) hk (ihr.mpr hr)

    have h_forall_mirror : ∀ {α : Type} (p : α → Prop) (t : _root_.BinaryTree α),
        ForallTree p (twMirrorTree t) ↔ ForallTree p t := by
      intro α p t
      induction t with
      | nil => constructor <;> intro _ <;> exact .left
      | node k l r ihl ihr =>
        constructor
        · intro h
          cases h with
          | node _ _ _ hr hk hl => exact .node l k r (ihl.mp hl) hk (ihr.mp hr)
        · intro h
          cases h with
          | node _ _ _ hl hk hr =>
            exact .node (twMirrorTree r) k (twMirrorTree l) (ihr.mpr hr) hk (ihl.mpr hl)

    have h_lsl_mirror : ∀ u : _root_.BinaryTree Unit,
        leftSpineLen (twMirrorTree u) = rightSpineLen u := by
      intro u
      induction u with
      | nil => rfl
      | node _ l r _ ihr => simp [twMirrorTree, leftSpineLen, rightSpineLen, ihr]

    have h_rsl_mirror : ∀ u : _root_.BinaryTree Unit,
        rightSpineLen (twMirrorTree u) = leftSpineLen u := by
      intro u
      have h := h_lsl_mirror (twMirrorTree u)
      rw [h_mirror_mirror] at h
      exact h.symm

    have h_descPoly_map : ∀ {α β : Type} (f : α → β) (t : _root_.BinaryTree α)
        (acc : List (α × _root_.BinaryTree α)),
        twDescendLeftPoly (twMapTree f t) (acc.map (fun p => (f p.1, twMapTree f p.2))) =
          (twMapTree f (twDescendLeftPoly t acc).1,
           (twDescendLeftPoly t acc).2.map (fun p => (f p.1, twMapTree f p.2))) := by
      intro α β f t
      induction t with
      | nil => intro acc; simp [twMapTree, twDescendLeftPoly]
      | node k l r ihl _ =>
        intro acc
        rcases l with _ | ⟨lk, ll, lr⟩
        · simp [twMapTree, twDescendLeftPoly]
        · simpa [twMapTree, twDescendLeftPoly] using ihl ((k, r) :: acc)

    have h_splayPoly_map : ∀ {α β : Type} (f : α → β) (k : ℕ) (c : _root_.BinaryTree α)
        (path : List (α × _root_.BinaryTree α)),
        path.length ≤ k →
        twMapTree f (twSplayLeftSpinePoly c path) =
          twSplayLeftSpinePoly (twMapTree f c) (path.map (fun p => (f p.1, twMapTree f p.2))) := by
      intro α β f k
      induction k with
      | zero =>
        intro c path hlen
        rcases path with _ | _
        · rfl
        · simp at hlen
      | succ k ih =>
        intro c path hlen
        rcases path with _ | ⟨⟨k1, s1⟩, _ | ⟨⟨k2, s2⟩, rest⟩⟩
        · rfl
        · rfl
        · have hrest : rest.length ≤ k := by simp at hlen; omega
          simpa [twSplayLeftSpinePoly, twMapTree] using
            ih (.node k1 c (.node k2 s1 s2)) rest hrest

    have h_popPoly_map : ∀ {α β : Type} (f : α → β) (t : _root_.BinaryTree α),
        twMapTree f (twPopPoly t) = twPopPoly (twMapTree f t) := by
      intro α β f t
      unfold twPopPoly
      have hd := h_descPoly_map f t []
      simp only [List.map_nil] at hd
      rw [hd]
      exact h_splayPoly_map f (twDescendLeftPoly t []).2.length _ _ le_rfl

    have h_descPoly_erase : ∀ {α : Type} (t : _root_.BinaryTree α) (acc : List (α × _root_.BinaryTree α)),
        descendLeft (twEraseTree t) (acc.map (fun p => twEraseTree p.2)) =
          (twEraseTree (twDescendLeftPoly t acc).1,
           (twDescendLeftPoly t acc).2.map (fun p => twEraseTree p.2)) := by
      intro α t
      induction t with
      | nil => intro acc; simp [descendLeft, twDescendLeftPoly, twEraseTree, twMapTree]
      | node k l r ihl _ =>
        intro acc
        rcases l with _ | ⟨lk, ll, lr⟩
        · simp [descendLeft, twDescendLeftPoly, twEraseTree, twMapTree]
        · simpa [twEraseTree, twMapTree, descendLeft, twDescendLeftPoly] using ihl ((k, r) :: acc)

    have h_splayPoly_erase : ∀ {α : Type} (k : ℕ) (c : _root_.BinaryTree α) (path : List (α × _root_.BinaryTree α)),
        path.length ≤ k →
        twEraseTree (twSplayLeftSpinePoly c path) =
          splayLeftSpine (twEraseTree c) (path.map (fun p => twEraseTree p.2)) := by
      intro α k
      induction k with
      | zero =>
        intro c path hlen
        rcases path with _ | _
        · rfl
        · simp at hlen
      | succ k ih =>
        intro c path hlen
        rcases path with _ | ⟨⟨k1, s1⟩, _ | ⟨⟨k2, s2⟩, rest⟩⟩
        · rfl
        · rfl
        · have hrest : rest.length ≤ k := by simp at hlen; omega
          simpa [twSplayLeftSpinePoly, splayLeftSpine, twEraseTree, twMapTree] using
            ih (.node k1 c (.node k2 s1 s2)) rest hrest

    have h_popPoly_erase : ∀ {α : Type} (t : _root_.BinaryTree α),
        twEraseTree (twPopPoly t) = popUnlabeled (twEraseTree t) := by
      intro α t
      unfold twPopPoly popUnlabeled
      have hd := h_descPoly_erase t []
      simp only [List.map_nil] at hd
      rw [hd]
      exact h_splayPoly_erase (twDescendLeftPoly t []).2.length _ _ le_rfl

    have h_ejectPoly_erase : ∀ {α : Type} (t : _root_.BinaryTree α),
        twEraseTree (twEjectPoly t) = twMirrorTree (popUnlabeled (twMirrorTree (twEraseTree t))) := by
      intro α t
      have h1 : twEraseTree (twEjectPoly t) = twMirrorTree (twEraseTree (twPopPoly (twMirrorTree t))) := by
        unfold twEjectPoly twEraseTree
        exact h_map_mirror (fun _ => ()) _
      have h2 : twMirrorTree (twEraseTree t) = twEraseTree (twMirrorTree t) := by
        unfold twEraseTree
        exact (h_map_mirror (fun _ => ()) t).symm
      rw [h1, h_popPoly_erase, h2]

    have h_descPoly_len : ∀ {α : Type} (t : _root_.BinaryTree α) (acc : List (α × _root_.BinaryTree α)),
        t ≠ .nil →
        (twDescendLeftPoly t acc).2.length + 1 = leftSpineLen (twEraseTree t) + acc.length := by
      intro α t
      induction t with
      | nil => intro _ h; exact absurd rfl h
      | node k l r ihl _ =>
        intro acc _
        rcases l with _ | ⟨lk, ll, lr⟩
        · simp [twDescendLeftPoly, twEraseTree, twMapTree, leftSpineLen]; omega
        · have hl_ne : _root_.BinaryTree.node lk ll lr ≠ .nil := by simp
          have ih := ihl ((k, r) :: acc) hl_ne
          simp only [twDescendLeftPoly, twEraseTree, twMapTree, leftSpineLen, List.length_cons] at ih ⊢
          omega


    have h_projL_of_count0 : ∀ C : _root_.BinaryTree TwFate,
        twCountFate .L C = 0 → twProjL C = .nil := by
      intro C
      induction C with
      | nil => intro _; rfl
      | node f l r ihl _ =>
        intro h
        cases f with
        | L => simp [twCountFate] at h
        | M =>
          simp only [twCountFate, reduceCtorEq, ite_false] at h
          exact ihl (by omega)
        | R =>
          simp only [twCountFate, reduceCtorEq, ite_false] at h
          exact ihl (by omega)

    have h_projR_of_count0 : ∀ C : _root_.BinaryTree TwFate,
        twCountFate .R C = 0 → twProjR C = .nil := by
      intro C
      induction C with
      | nil => intro _; rfl
      | node f l r _ ihr =>
        intro h
        cases f with
        | L =>
          simp only [twCountFate, reduceCtorEq, ite_false] at h
          exact ihr (by omega)
        | M =>
          simp only [twCountFate, reduceCtorEq, ite_false] at h
          exact ihr (by omega)
        | R => simp [twCountFate] at h

    have h_countL_of_ge1 : ∀ C : _root_.BinaryTree TwFate,
        ForallTree (fun x => 1 ≤ twFateCode x) C → twCountFate .L C = 0 := by
      intro C h
      induction h with
      | left => rfl
      | node l k r _ hk _ ihl ihr =>
        cases k with
        | L => simp [twFateCode] at hk
        | M => simp [twCountFate, ihl, ihr]
        | R => simp [twCountFate, ihl, ihr]

    have h_lsl_le_nodes : ∀ u : _root_.BinaryTree Unit, leftSpineLen u ≤ u.num_nodes := by
      intro u
      induction u with
      | nil => simp [leftSpineLen, _root_.BinaryTree.num_nodes]
      | node _ l r ihl _ => simp [leftSpineLen, _root_.BinaryTree.num_nodes]; omega

    have h_rsl_le_nodes : ∀ u : _root_.BinaryTree Unit, rightSpineLen u ≤ u.num_nodes := by
      intro u
      induction u with
      | nil => simp [rightSpineLen, _root_.BinaryTree.num_nodes]
      | node _ l r _ ihr => simp [rightSpineLen, _root_.BinaryTree.num_nodes]; omega

    have h_lsl_rsl_le : ∀ u : _root_.BinaryTree Unit,
        leftSpineLen u + rightSpineLen u ≤ u.num_nodes + 1 := by
      intro u
      rcases u with _ | ⟨_, l, r⟩
      · simp [leftSpineLen, rightSpineLen, _root_.BinaryTree.num_nodes]
      · have hl := h_lsl_le_nodes l
        have hr := h_rsl_le_nodes r
        simp only [leftSpineLen, rightSpineLen, _root_.BinaryTree.num_nodes]
        omega

    have h_proj_nodes : ∀ C : _root_.BinaryTree TwFate,
        (twProjL C).num_nodes + (twProjM C).num_nodes + (twProjR C).num_nodes ≤ C.num_nodes := by
      intro C
      induction C with
      | nil => simp [twProjL, twProjM, twProjR, _root_.BinaryTree.num_nodes]
      | node f l r ihl ihr =>
        cases f <;>
          (simp only [twProjL, twProjM, twProjR, _root_.BinaryTree.num_nodes]; omega)

    have h_phi2_init_le : ∀ C : _root_.BinaryTree TwFate, twPhi2 C ≤ 2 * C.num_nodes + 2 := by
      intro C
      have hL := h_rsl_le_nodes (twProjL C)
      have hM := h_lsl_rsl_le (twProjM C)
      have hR := h_lsl_le_nodes (twProjR C)
      have hsum := h_proj_nodes C
      unfold twPhi2 twPhiMR
      omega

    have h_mirrorFate_inv : ∀ f : TwFate, twMirrorFate (twMirrorFate f) = f := by
      rintro (_ | _ | _) <;> rfl

    have h_dual_inv : ∀ C : _root_.BinaryTree TwFate, twDualTree (twDualTree C) = C := by
      intro C
      unfold twDualTree
      rw [← h_map_mirror, h_mirror_mirror, h_map_map]
      calc twMapTree (fun x => twMirrorFate (twMirrorFate x)) C
        _ = twMapTree (fun x => x) C := h_map_congr C h_mirrorFate_inv
        _ = C := h_map_id C

    have h_fateCode_mirror : ∀ a b : TwFate,
        twFateCode a ≤ twFateCode b → twFateCode (twMirrorFate b) ≤ twFateCode (twMirrorFate a) := by
      rintro (_ | _ | _) (_ | _ | _) <;> decide

    have h_dual_tri : ∀ C : _root_.BinaryTree TwFate, TwIsTriOrdered C → TwIsTriOrdered (twDualTree C) := by
      intro C
      induction C with
      | nil => intro _; trivial
      | node f l r ihl ihr =>
        rintro ⟨hl, hr, htl, htr⟩
        refine ⟨?_, ?_, ihr htr, ihl htl⟩
        · rw [h_forall_map, h_forall_mirror]
          exact h_forall_mono (fun x hx => h_fateCode_mirror f x hx) hr
        · rw [h_forall_map, h_forall_mirror]
          exact h_forall_mono (fun x hx => h_fateCode_mirror x f hx) hl

    have h_dual_countL : ∀ C : _root_.BinaryTree TwFate,
        twCountFate .L (twDualTree C) = twCountFate .R C := by
      intro C
      induction C with
      | nil => rfl
      | node f l r ihl ihr =>
        cases f <;>
          (simp [twDualTree, twMirrorTree, twMapTree, twMirrorFate, twCountFate] at ihl ihr ⊢;
           omega)

    have h_projL_dual : ∀ C : _root_.BinaryTree TwFate,
        twProjL (twDualTree C) = twMirrorTree (twProjR C) := by
      intro C
      induction C with
      | nil => rfl
      | node f l r ihl ihr =>
        unfold twDualTree at ihl ihr ⊢
        cases f <;>
          simp [twMirrorTree, twMapTree, twMirrorFate, twProjL, twProjR, ihl, ihr]

    have h_projM_dual : ∀ C : _root_.BinaryTree TwFate,
        twProjM (twDualTree C) = twMirrorTree (twProjM C) := by
      intro C
      induction C with
      | nil => rfl
      | node f l r ihl ihr =>
        unfold twDualTree at ihl ihr ⊢
        cases f <;>
          simp [twMirrorTree, twMapTree, twMirrorFate, twProjM, ihl, ihr]

    have h_projR_dual : ∀ C : _root_.BinaryTree TwFate,
        twProjR (twDualTree C) = twMirrorTree (twProjL C) := by
      intro C
      have h := h_projL_dual (twDualTree C)
      rw [h_dual_inv] at h
      have h2 := congrArg twMirrorTree h
      rw [h_mirror_mirror] at h2
      exact h2.symm

    have h_phi2_dual : ∀ C : _root_.BinaryTree TwFate, twPhi2 (twDualTree C) = twPhi2 C := by
      intro C
      unfold twPhi2 twPhiMR
      rw [h_projL_dual, h_projM_dual, h_projR_dual,
          h_lsl_mirror, h_rsl_mirror, h_lsl_mirror, h_rsl_mirror]
      omega

    have h_dual_eject : ∀ C : _root_.BinaryTree TwFate,
        twDualTree (twEjectPoly C) = twPopPoly (twDualTree C) := by
      intro C
      unfold twDualTree twEjectPoly
      rw [h_mirror_mirror, h_popPoly_map]


    have h_extSteps_seq : ∀ (u1 u2 : _root_.BinaryTree Unit) (s1 s2 : List TwExtCoreOp),
        TwValidExtSteps u1 s1 u2 → TwValidExtCoreSeq u2 s2 → TwValidExtCoreSeq u1 (s1 ++ s2) := by
      intro u1 u2 s1 s2 h1 h2
      induction s1 generalizing u1 with
      | nil => subst h1; exact h2
      | cons op rest ih =>
        cases op with
        | push => exact ih _ h1
        | pop => exact ⟨h1.1, ih _ h1.2⟩
        | rslr d => exact ⟨h1.1, ih _ h1.2⟩
        | inject => exact ih _ h1

    have h_extCost_append : ∀ (u1 u2 : _root_.BinaryTree Unit) (s1 s2 : List TwExtCoreOp),
        TwValidExtSteps u1 s1 u2 →
        twExtCoreCascadeCost u1 (s1 ++ s2) =
          twExtCoreCascadeCost u1 s1 + twExtCoreCascadeCost u2 s2 := by
      intro u1 u2 s1 s2 h1
      induction s1 generalizing u1 with
      | nil => subst h1; simp [twExtCoreCascadeCost]
      | cons op rest ih =>
        cases op with
        | push =>
          simp only [List.cons_append, twExtCoreCascadeCost, twExtCascadeStepCost, twExecExtCoreOp]
          rw [ih _ h1]; omega
        | pop =>
          simp only [List.cons_append, twExtCoreCascadeCost, twExecExtCoreOp]
          rw [ih _ h1.2]; omega
        | rslr d =>
          simp only [List.cons_append, twExtCoreCascadeCost, twExtCascadeStepCost, twExecExtCoreOp]
          rw [ih _ h1.2]; omega
        | inject =>
          simp only [List.cons_append, twExtCoreCascadeCost, twExtCascadeStepCost, twExecExtCoreOp]
          rw [ih _ h1]; omega

    have h_extPop_append : ∀ s1 s2 : List TwExtCoreOp,
        twCountExtPop (s1 ++ s2) = twCountExtPop s1 + twCountExtPop s2 := by
      intro s1 s2
      induction s1 with
      | nil => simp [twCountExtPop]
      | cons op rest ih =>
        cases op <;> (simp only [List.cons_append, twCountExtPop, ih]; try omega)


    have h_push_step : ∀ (C : _root_.BinaryTree TwFate) (f : TwFate),
        ForallTree (fun x => twFateCode f ≤ twFateCode x) C →
        ∃ (stepL stepR : List TwExtCoreOp),
          twCountExtPop stepL + twCountExtPop stepR = 0 ∧
          TwValidExtSteps (twProjL C) stepL (twProjL (.node f .nil C)) ∧
          TwValidExtSteps (twMirrorTree (twProjR C)) stepR
            (twMirrorTree (twProjR (.node f .nil C))) ∧
          twPhi2 (.node f .nil C) ≤
            2 * twExtCoreCascadeCost (twProjL C) stepL +
            2 * twExtCoreCascadeCost (twMirrorTree (twProjR C)) stepR +
            twPhi2 C + 9 := by
      intro C f hord
      cases f with
      | L =>
        refine ⟨[.push], [], rfl, rfl, rfl, ?_⟩
        simp only [twPhi2, twPhiMR, twProjL, twProjM, twProjR, rightSpineLen]
        omega
      | M =>
        have hL0 : twProjL C = .nil := h_projL_of_count0 C (h_countL_of_ge1 C hord)
        refine ⟨[], [], rfl, ?_, rfl, ?_⟩
        · simp [twProjL, hL0, TwValidExtSteps]
        · simp only [twPhi2, twPhiMR, twProjL, twProjM, twProjR, leftSpineLen, rightSpineLen, hL0]
          omega
      | R =>
        have hge1 : ForallTree (fun x => 1 ≤ twFateCode x) C :=
          h_forall_mono (fun x hx => by (cases x <;> simp [twFateCode] at hx); decide) hord
        have hL0 : twProjL C = .nil := h_projL_of_count0 C (h_countL_of_ge1 C hge1)
        refine ⟨[], [.inject], rfl, ?_, ?_, ?_⟩
        · simp [twProjL, hL0, TwValidExtSteps]
        · simp [twProjR, twMirrorTree, TwValidExtSteps]
        · simp only [twPhi2, twPhiMR, twProjL, twProjM, twProjR, leftSpineLen, rightSpineLen]
          omega


    have h_descLeft_acc : ∀ (v : _root_.BinaryTree Unit) (acc : List (_root_.BinaryTree Unit)),
        descendLeft v acc = ((descendLeft v []).1, (descendLeft v []).2 ++ acc) := by
      intro v
      induction v with
      | nil => intro acc; simp [descendLeft]
      | node _ l r ihl _ =>
        intro acc
        rcases l with _ | ⟨lk, ll, lr⟩
        · simp [descendLeft]
        · simp only [descendLeft]
          rw [ihl (r :: acc), ihl [r]]
          simp [List.append_assoc]

    have h_rsl_splay_last : ∀ (k : ℕ) (c : _root_.BinaryTree Unit) (p : List (_root_.BinaryTree Unit))
        (r : _root_.BinaryTree Unit),
        p.length ≤ k →
        rightSpineLen (splayLeftSpine c (p ++ [r])) ≤ 2 + rightSpineLen r := by
      intro k
      induction k with
      | zero =>
        intro c p r hlen
        rcases p with _ | _
        · simp [splayLeftSpine, rightSpineLen]
        · simp at hlen
      | succ k ih =>
        intro c p r hlen
        rcases p with _ | ⟨r1, _ | ⟨r2, p'⟩⟩
        · simp [splayLeftSpine, rightSpineLen]
        · simp [splayLeftSpine, rightSpineLen]; omega
        · have hp' : p'.length ≤ k := by simp at hlen; omega
          simpa [List.cons_append, splayLeftSpine] using
            ih (.node () c (.node () r1 r2)) p' r hp'

    have h_rsl_popUnlabeled : ∀ u : _root_.BinaryTree Unit,
        rightSpineLen (popUnlabeled u) ≤ rightSpineLen u + 1 := by
      intro u
      rcases u with _ | ⟨_, _ | ⟨lk, ll, lr⟩, r⟩
      · simp [popUnlabeled, descendLeft, splayLeftSpine, rightSpineLen]
      · simp [popUnlabeled, descendLeft, splayLeftSpine, rightSpineLen]; omega
      · unfold popUnlabeled
        simp only [descendLeft, rightSpineLen]
        rw [h_descLeft_acc (.node lk ll lr) [r]]
        dsimp (config := { failIfUnchanged := false }) only
        have hb := h_rsl_splay_last (descendLeft (.node lk ll lr) []).2.length
          (descendLeft (.node lk ll lr) []).1 (descendLeft (.node lk ll lr) []).2 r le_rfl
        omega

    have h_leftmost_some : ∀ C : _root_.BinaryTree TwFate,
        C ≠ .nil → ∃ f0, twLeftmostFate C = some f0 := by
      intro C
      induction C with
      | nil => intro h; exact absurd rfl h
      | node f l r ihl _ =>
        intro _
        rcases l with _ | ⟨lk, ll, lr⟩
        · exact ⟨f, by simp [twLeftmostFate]⟩
        · simp only [twLeftmostFate]; exact ihl (by simp)

    have h_leftmost_le : ∀ (C : _root_.BinaryTree TwFate) (f0 : TwFate),
        TwIsTriOrdered C → twLeftmostFate C = some f0 →
        ForallTree (fun x => twFateCode f0 ≤ twFateCode x) C := by
      intro C f0
      induction C with
      | nil => intro _ h; simp [twLeftmostFate] at h
      | node k l r ihl _ =>
        rintro ⟨hl_le, hr_ge, htl, _⟩ hlm
        rcases l with _ | ⟨lk, ll, lr⟩
        · simp only [twLeftmostFate, Option.some.injEq] at hlm
          subst hlm
          exact .node .nil k r .left (Nat.le_refl _) hr_ge
        · simp only [twLeftmostFate] at hlm
          have hl_f0 := ihl htl hlm
          have hf0_k : twFateCode f0 ≤ twFateCode k := by
            cases hl_f0 with
            | node _ _ _ _ hf0_lk _ =>
              cases hl_le with
              | node _ _ _ _ hlk_k _ => omega
          exact .node (.node lk ll lr) k r hl_f0 hf0_k
            (h_forall_mono (fun _ hx => le_trans hf0_k hx) hr_ge)

    have h_leftmost_attach : ∀ (C : _root_.BinaryTree TwFate) (f0 : TwFate)
        (acc : List (TwFate × _root_.BinaryTree TwFate)),
        twLeftmostFate C = some f0 →
        twAttachPoly (.node f0 .nil (twDescendLeftPoly C acc).1) (twDescendLeftPoly C acc).2 =
          twAttachPoly C acc := by
      intro C f0
      induction C with
      | nil => intro _ h; simp [twLeftmostFate] at h
      | node k l r ihl _ =>
        intro acc hlm
        rcases l with _ | ⟨lk, ll, lr⟩
        · simp only [twLeftmostFate, Option.some.injEq] at hlm
          subst hlm
          simp [twDescendLeftPoly]
        · simp only [twLeftmostFate] at hlm
          simpa [twDescendLeftPoly, twAttachPoly] using ihl ((k, r) :: acc) hlm

    have h_tri_attach_head : ∀ (u : _root_.BinaryTree TwFate)
        (path : List (TwFate × _root_.BinaryTree TwFate)),
        TwIsTriOrdered (twAttachPoly u path) → TwIsTriOrdered u := by
      intro u path
      induction path generalizing u with
      | nil => exact id
      | cons hd rest ih =>
        intro h
        exact (ih (.node hd.1 u hd.2) h).2.2.1

    have h_sorted_of_attach : ∀ (path : List (TwFate × _root_.BinaryTree TwFate))
        (cl : _root_.BinaryTree TwFate) (cur : TwFate) (cr : _root_.BinaryTree TwFate),
        TwIsTriOrdered (twAttachPoly (.node cur cl cr) path) → TwSortedPath cur path := by
      intro path
      induction path with
      | nil => intro _ _ _ _; trivial
      | cons hd rest ih =>
        rcases hd with ⟨k, s⟩
        intro cl cur cr htri
        have hhead := h_tri_attach_head (.node k (.node cur cl cr) s) rest htri
        have hcur_k : twFateCode cur ≤ twFateCode k := by
          cases hhead.1 with
          | node _ _ _ _ hk _ => exact hk
        exact ⟨hcur_k, ih (.node cur cl cr) k s htri⟩

    have h_projL_attach : ∀ (c : _root_.BinaryTree TwFate) (path : List (TwFate × _root_.BinaryTree TwFate)),
        twProjL (twAttachPoly c path) = twAttachUnit (twProjL c) (twFilterProjL path) := by
      intro c path
      induction path generalizing c with
      | nil => rfl
      | cons hd rest ih =>
        rcases hd with ⟨k, s⟩
        cases k <;> simp [twAttachPoly, twFilterProjL, twAttachUnit, twProjL, ih]

    have h_attachUnit_ne : ∀ (v : _root_.BinaryTree Unit) (rs : List (_root_.BinaryTree Unit)),
        v ≠ .nil → twAttachUnit v rs ≠ .nil := by
      intro v rs
      induction rs generalizing v with
      | nil => exact id
      | cons r rest ih =>
        intro _
        exact ih (.node () v r) (by simp)

    have h_lsl_attachUnit : ∀ (v : _root_.BinaryTree Unit) (rs : List (_root_.BinaryTree Unit)),
        leftSpineLen (twAttachUnit v rs) = leftSpineLen v + rs.length := by
      intro v rs
      induction rs generalizing v with
      | nil => simp [twAttachUnit]
      | cons r rest ih =>
        simp only [twAttachUnit, ih, leftSpineLen, List.length_cons]
        omega

    have h_descLeft_attachUnit : ∀ (v : _root_.BinaryTree Unit) (rs acc : List (_root_.BinaryTree Unit)),
        v ≠ .nil →
        descendLeft (twAttachUnit v rs) acc = descendLeft v (rs ++ acc) := by
      intro v rs
      induction rs generalizing v with
      | nil => intro acc _; rfl
      | cons r rest ih =>
        intro acc hv
        simp only [twAttachUnit]
        rw [ih (.node () v r) acc (by simp)]
        rcases v with _ | ⟨vk, vl, vr⟩
        · exact absurd rfl hv
        · simp [descendLeft]

    have h_filterProjL_empty : ∀ (cur : TwFate) (path : List (TwFate × _root_.BinaryTree TwFate)),
        1 ≤ twFateCode cur → TwSortedPath cur path → twFilterProjL path = [] := by
      intro cur path
      induction path generalizing cur with
      | nil => intro _ _; rfl
      | cons hd rest ih =>
        rcases hd with ⟨k, s⟩
        intro hcur ⟨hk, hrest⟩
        cases k with
        | L => simp [twFateCode] at hcur hk; omega
        | M => exact ih .M (by decide) hrest
        | R => exact ih .R (by decide) hrest

    have h_projL_splay : ∀ (k : ℕ) (cur : TwFate) (c : _root_.BinaryTree TwFate)
        (path : List (TwFate × _root_.BinaryTree TwFate)),
        path.length ≤ k → TwSortedPath cur path →
        twProjL (twSplayLeftSpinePoly c path) =
          splayLeftSpine (twProjL c) (twFilterProjL path) := by
      intro k
      induction k with
      | zero =>
        intro cur c path hlen _
        rcases path with _ | _
        · rfl
        · simp at hlen
      | succ k ih =>
        intro cur c path hlen hsort
        rcases path with _ | ⟨⟨k1, s1⟩, _ | ⟨⟨k2, s2⟩, rest⟩⟩
        · rfl
        · cases k1 <;> rfl
        · have hrest_len : rest.length ≤ k := by simp at hlen; omega
          rcases hsort with ⟨_, hk12, hsort_rest⟩
          cases k1 <;> cases k2
          · simpa [twSplayLeftSpinePoly, twFilterProjL, splayLeftSpine, twProjL] using
              ih .L (.node .L c (.node .L s1 s2)) rest hrest_len hsort_rest
          · have hnil := h_filterProjL_empty .M rest (by decide) hsort_rest
            simp only [twSplayLeftSpinePoly, twFilterProjL]
            rw [ih .M (.node .L c (.node .M s1 s2)) rest hrest_len hsort_rest, hnil]
            rfl
          · have hnil := h_filterProjL_empty .R rest (by decide) hsort_rest
            simp only [twSplayLeftSpinePoly, twFilterProjL]
            rw [ih .R (.node .L c (.node .R s1 s2)) rest hrest_len hsort_rest, hnil]
            rfl
          · simp [twFateCode] at hk12
          · simpa [twSplayLeftSpinePoly, twFilterProjL, twProjL] using
              ih .M (.node .M c (.node .M s1 s2)) rest hrest_len hsort_rest
          · simpa [twSplayLeftSpinePoly, twFilterProjL, twProjL] using
              ih .R (.node .M c (.node .R s1 s2)) rest hrest_len hsort_rest
          · simp [twFateCode] at hk12
          · simp [twFateCode] at hk12
          · simpa [twSplayLeftSpinePoly, twFilterProjL, twProjL] using
              ih .R (.node .R c (.node .R s1 s2)) rest hrest_len hsort_rest


    have h_projM_attach_congr : ∀ (rest : List (TwFate × _root_.BinaryTree TwFate))
        (w1 w2 : _root_.BinaryTree TwFate),
        twProjM w1 = twProjM w2 →
        twProjM (twAttachPoly w1 rest) = twProjM (twAttachPoly w2 rest) := by
      intro rest
      induction rest with
      | nil => intro _ _ h; exact h
      | cons hd rest' ih =>
        rcases hd with ⟨k, s⟩
        intro w1 w2 h
        apply ih
        cases k <;> simp [twProjM, h]

    have h_projR_attach_congr : ∀ (rest : List (TwFate × _root_.BinaryTree TwFate))
        (w1 w2 : _root_.BinaryTree TwFate),
        twProjR w1 = twProjR w2 →
        twProjR (twAttachPoly w1 rest) = twProjR (twAttachPoly w2 rest) := by
      intro rest
      induction rest with
      | nil => intro _ _ h; exact h
      | cons hd rest' ih =>
        rcases hd with ⟨k, s⟩
        intro w1 w2 h
        apply ih
        cases k <;> simp [twProjR, h]

    have h_lsl_projM_attach : ∀ (rest : List (TwFate × _root_.BinaryTree TwFate))
        (cur : TwFate) (w : _root_.BinaryTree TwFate),
        1 ≤ twFateCode cur → TwSortedPath cur rest →
        leftSpineLen (twProjM (twAttachPoly w rest)) =
          twCountKeyM rest + leftSpineLen (twProjM w) := by
      intro rest
      induction rest with
      | nil => intro _ _ _ _; simp [twAttachPoly, twCountKeyM]
      | cons hd rest' ih =>
        rcases hd with ⟨k, s⟩
        intro cur w hcur ⟨hk, hrest'⟩
        cases k with
        | L => simp [twFateCode] at hcur hk; omega
        | M =>
          simp only [twAttachPoly, twCountKeyM]
          rw [ih .M (.node .M w s) (by decide) hrest']
          simp only [twProjM, leftSpineLen]
          omega
        | R =>
          simp only [twAttachPoly, twCountKeyM]
          rw [ih .R (.node .R w s) (by decide) hrest']
          rfl

    have h_rsl_projM_congr : ∀ (rest : List (TwFate × _root_.BinaryTree TwFate))
        (cur : TwFate) (w1 w2 : _root_.BinaryTree TwFate),
        1 ≤ twFateCode cur → TwSortedPath cur rest →
        rightSpineLen (twProjM w1) = rightSpineLen (twProjM w2) →
        rightSpineLen (twProjM (twAttachPoly w1 rest)) =
          rightSpineLen (twProjM (twAttachPoly w2 rest)) := by
      intro rest
      induction rest with
      | nil => intro _ _ _ _ _ h; exact h
      | cons hd rest' ih =>
        rcases hd with ⟨k, s⟩
        intro cur w1 w2 hcur ⟨hk, hrest'⟩ hrsl
        cases k with
        | L => simp [twFateCode] at hcur hk; omega
        | M =>
          exact ih .M (.node .M w1 s) (.node .M w2 s) (by decide) hrest' rfl
        | R =>
          exact ih .R (.node .R w1 s) (.node .R w2 s) (by decide) hrest' hrsl

    have h_projM_attach_R : ∀ (rest : List (TwFate × _root_.BinaryTree TwFate))
        (w : _root_.BinaryTree TwFate),
        TwSortedPath .R rest → twProjM (twAttachPoly w rest) = twProjM w := by
      intro rest
      induction rest with
      | nil => intro _ _; rfl
      | cons hd rest' ih =>
        rcases hd with ⟨k, s⟩
        intro w ⟨hk, hrest'⟩
        cases k with
        | L => simp [twFateCode] at hk
        | M => simp [twFateCode] at hk
        | R => exact ih (.node .R w s) hrest'

    have h_lsl_projR_attach : ∀ (rest : List (TwFate × _root_.BinaryTree TwFate))
        (w : _root_.BinaryTree TwFate),
        TwSortedPath .R rest →
        leftSpineLen (twProjR (twAttachPoly w rest)) =
          rest.length + leftSpineLen (twProjR w) := by
      intro rest
      induction rest with
      | nil => intro _ _; simp [twAttachPoly]
      | cons hd rest' ih =>
        rcases hd with ⟨k, s⟩
        intro w ⟨hk, hrest'⟩
        cases k with
        | L => simp [twFateCode] at hk
        | M => simp [twFateCode] at hk
        | R =>
          simp only [twAttachPoly, List.length_cons]
          rw [ih (.node .R w s) hrest']
          simp only [twProjR, leftSpineLen]
          omega

    have h_rslr_attach_R : ∀ (rest : List (TwFate × _root_.BinaryTree TwFate)) (d : ℕ)
        (w1 w2 : _root_.BinaryTree TwFate),
        TwSortedPath .R rest →
        d + 2 ≤ rightSpineLen (twMirrorTree (twProjR w1)) →
        rotateLeftAtRightDepth (twMirrorTree (twProjR w1)) d = twMirrorTree (twProjR w2) →
        (rest.length + d) + 2 ≤ rightSpineLen (twMirrorTree (twProjR (twAttachPoly w1 rest))) ∧
        rotateLeftAtRightDepth (twMirrorTree (twProjR (twAttachPoly w1 rest))) (rest.length + d) =
          twMirrorTree (twProjR (twAttachPoly w2 rest)) := by
      intro rest
      induction rest with
      | nil =>
        intro d w1 w2 _ hd hrot
        simpa [twAttachPoly] using ⟨hd, hrot⟩
      | cons hd rest' ih =>
        rcases hd with ⟨k, s⟩
        intro d w1 w2 ⟨hk, hrest'⟩ hd_le hrot
        cases k with
        | L => simp [twFateCode] at hk
        | M => simp [twFateCode] at hk
        | R =>
          have hd1 : (d + 1) + 2 ≤ rightSpineLen (twMirrorTree (twProjR (.node .R w1 s))) := by
            simp only [twProjR, twMirrorTree, rightSpineLen]
            omega
          have hrot1 : rotateLeftAtRightDepth (twMirrorTree (twProjR (.node .R w1 s))) (d + 1) =
              twMirrorTree (twProjR (.node .R w2 s)) := by
            simp [twProjR, twMirrorTree, rotateLeftAtRightDepth, hrot]
          obtain ⟨h1, h2⟩ := ih (d + 1) (.node .R w1 s) (.node .R w2 s) hrest' hd1 hrot1
          have hidx : rest'.length + (d + 1) = ((.R, s) :: rest').length + d := by
            simp [List.length_cons]; omega
          rw [hidx] at h1 h2
          exact ⟨h1, h2⟩


    have h_pop_path_ind : ∀ (k : ℕ) (cur : TwFate) (c : _root_.BinaryTree TwFate)
        (path : List (TwFate × _root_.BinaryTree TwFate)),
        path.length ≤ k → TwSortedPath cur path →
        let rslrs := twExtractPopRRslrs path
        twCountExtPop rslrs = 0 ∧
        twExtCoreCascadeCost (twMirrorTree (twProjR (twAttachPoly c path))) rslrs = 0 ∧
        TwValidExtSteps (twMirrorTree (twProjR (twAttachPoly c path))) rslrs
          (twMirrorTree (twProjR (twSplayLeftSpinePoly c path))) ∧
        path.length + twPhiMR (twSplayLeftSpinePoly c path) ≤
          2 * ((twFilterProjL path).length / 2) + twPhiMR (twAttachPoly c path) +
          twStepBudget cur := by
      intro k
      induction k with
      | zero =>
        intro cur c path hlen _
        rcases path with _ | _
        · refine ⟨rfl, rfl, rfl, ?_⟩
          simp only [List.length_nil, twSplayLeftSpinePoly, twAttachPoly, twFilterProjL]
          omega
        · simp at hlen
      | succ k ih =>
        intro cur c path hlen hsort
        rcases path with _ | ⟨⟨k1, s1⟩, _ | ⟨⟨k2, s2⟩, rest⟩⟩
        · refine ⟨rfl, rfl, rfl, ?_⟩
          simp only [List.length_nil, twSplayLeftSpinePoly, twAttachPoly, twFilterProjL]
          omega
        · refine ⟨rfl, rfl, rfl, ?_⟩
          have hb : 1 ≤ twStepBudget cur := by cases cur <;> decide
          simp only [List.length_singleton, twSplayLeftSpinePoly, twAttachPoly]
          omega
        · have hrest_len : rest.length ≤ k := by simp at hlen; omega
          rcases hsort with ⟨hcur1, hk12, hsort_rest⟩
          set u_bef := _root_.BinaryTree.node k2 (.node k1 c s1) s2
          set u_aft := _root_.BinaryTree.node k1 c (.node k2 s1 s2)
          cases k1 <;> cases k2
          ·
            have hcurL : cur = .L := by (cases cur <;> simp [twFateCode] at hcur1); rfl
            subst hcurL
            have hphi_eq : twPhiMR (twAttachPoly u_aft rest) = twPhiMR (twAttachPoly u_bef rest) := by
              unfold twPhiMR
              rw [h_projM_attach_congr rest u_aft u_bef rfl,
                  h_projR_attach_congr rest u_aft u_bef rfl]
            have hR_eq : twProjR (twAttachPoly u_aft rest) = twProjR (twAttachPoly u_bef rest) :=
              h_projR_attach_congr rest u_aft u_bef rfl
            obtain ⟨hc1, hc2, hv, hbound⟩ := ih .L u_aft rest hrest_len hsort_rest
            dsimp (config := { failIfUnchanged := false }) only [twExtractPopRRslrs, beq_iff_eq, Bool.and_self, reduceCtorEq,
              decide_false, Bool.false_eq_true, ↓reduceIte]
            simp only [twAttachPoly, twSplayLeftSpinePoly]
            rw [← hR_eq]
            refine ⟨hc1, hc2, hv, ?_⟩
            simp only [List.length_cons, twFilterProjL]
            dsimp (config := { failIfUnchanged := false }) only [u_bef, u_aft] at hphi_eq hbound ⊢
            omega
          ·
            have hcurL : cur = .L := by (cases cur <;> simp [twFateCode] at hcur1); rfl
            subst hcurL
            have hphi_eq : twPhiMR (twAttachPoly u_aft rest) = twPhiMR (twAttachPoly u_bef rest) := by
              unfold twPhiMR
              rw [h_projM_attach_congr rest u_aft u_bef rfl,
                  h_projR_attach_congr rest u_aft u_bef rfl]
            have hR_eq : twProjR (twAttachPoly u_aft rest) = twProjR (twAttachPoly u_bef rest) :=
              h_projR_attach_congr rest u_aft u_bef rfl
            have hnil := h_filterProjL_empty .M rest (by decide) hsort_rest
            obtain ⟨hc1, hc2, hv, hbound⟩ := ih .M u_aft rest hrest_len hsort_rest
            dsimp (config := { failIfUnchanged := false }) only [twExtractPopRRslrs, beq_iff_eq, reduceCtorEq,
              decide_false, Bool.false_and, Bool.false_eq_true, ↓reduceIte]
            simp only [twAttachPoly, twSplayLeftSpinePoly]
            rw [← hR_eq]
            refine ⟨hc1, hc2, hv, ?_⟩
            simp only [List.length_cons, List.length_nil, twFilterProjL, hnil, twStepBudget] at hbound ⊢
            dsimp (config := { failIfUnchanged := false }) only [u_bef, u_aft] at hphi_eq hbound ⊢
            omega
          ·
            have hcurL : cur = .L := by (cases cur <;> simp [twFateCode] at hcur1); rfl
            subst hcurL
            have hphi_eq : twPhiMR (twAttachPoly u_aft rest) = twPhiMR (twAttachPoly u_bef rest) := by
              unfold twPhiMR
              rw [h_projM_attach_congr rest u_aft u_bef rfl,
                  h_projR_attach_congr rest u_aft u_bef rfl]
            have hR_eq : twProjR (twAttachPoly u_aft rest) = twProjR (twAttachPoly u_bef rest) :=
              h_projR_attach_congr rest u_aft u_bef rfl
            have hnil := h_filterProjL_empty .R rest (by decide) hsort_rest
            obtain ⟨hc1, hc2, hv, hbound⟩ := ih .R u_aft rest hrest_len hsort_rest
            dsimp (config := { failIfUnchanged := false }) only [twExtractPopRRslrs, beq_iff_eq, reduceCtorEq,
              decide_false, Bool.false_and, Bool.false_eq_true, ↓reduceIte]
            simp only [twAttachPoly, twSplayLeftSpinePoly]
            rw [← hR_eq]
            refine ⟨hc1, hc2, hv, ?_⟩
            simp only [List.length_cons, List.length_nil, twFilterProjL, hnil, twStepBudget] at hbound ⊢
            dsimp (config := { failIfUnchanged := false }) only [u_bef, u_aft] at hphi_eq hbound ⊢
            omega
          ·
            simp [twFateCode] at hk12
          ·
            have hcur_b : 3 ≤ twStepBudget cur := by
              cases cur <;> simp [twFateCode, twStepBudget] at hcur1 ⊢
            have hR_eq : twProjR (twAttachPoly u_aft rest) = twProjR (twAttachPoly u_bef rest) :=
              h_projR_attach_congr rest u_aft u_bef rfl
            have hlsl_bef := h_lsl_projM_attach rest .M u_bef (by decide) hsort_rest
            have hlsl_aft := h_lsl_projM_attach rest .M u_aft (by decide) hsort_rest
            have hlsl_diff : leftSpineLen (twProjM (twAttachPoly u_bef rest)) =
                leftSpineLen (twProjM (twAttachPoly u_aft rest)) + 1 := by
              rw [hlsl_bef, hlsl_aft]
              simp only [u_bef, u_aft, twProjM, leftSpineLen]
              omega
            dsimp (config := { failIfUnchanged := false }) only [twExtractPopRRslrs, beq_iff_eq, reduceCtorEq,
              decide_false, Bool.false_and, Bool.false_eq_true, ↓reduceIte]
            simp only [twAttachPoly, twSplayLeftSpinePoly]
            rw [← hR_eq]
            rcases rest with _ | ⟨⟨k3, s3⟩, rest'⟩
            ·
              obtain ⟨hc1, hc2, hv, hbound⟩ := ih .R u_aft [] hrest_len trivial
              refine ⟨hc1, hc2, hv, ?_⟩
              simp only [List.length_cons, List.length_nil, twFilterProjL, twAttachPoly,
                twSplayLeftSpinePoly, twPhiMR, u_aft, twProjM, twProjR,
                leftSpineLen, rightSpineLen] at hbound ⊢
              dsimp (config := { failIfUnchanged := false }) only [twStepBudget] at hbound
              omega
            · rcases hsort_rest with ⟨hk23, hsort_rest'⟩
              cases k3 with
              | L => simp [twFateCode] at hk23
              | M =>

                have hrsl_eq : rightSpineLen (twProjM (twAttachPoly u_aft ((.M, s3) :: rest'))) =
                    rightSpineLen (twProjM (twAttachPoly u_bef ((.M, s3) :: rest'))) :=
                  h_rsl_projM_congr rest' .M (.node .M u_aft s3) (.node .M u_bef s3)
                    (by decide) hsort_rest' rfl
                obtain ⟨hc1, hc2, hv, hbound⟩ :=
                  ih .M u_aft ((.M, s3) :: rest') hrest_len ⟨le_rfl, hsort_rest'⟩
                refine ⟨hc1, hc2, hv, ?_⟩
                simp only [List.length_cons, twFilterProjL] at hbound ⊢
                dsimp (config := { failIfUnchanged := false }) only [twStepBudget] at hbound
                unfold twPhiMR at hbound ⊢
                dsimp (config := { failIfUnchanged := false }) only [u_bef, u_aft] at hlsl_diff hrsl_eq hR_eq hbound ⊢
                rw [hR_eq, hrsl_eq] at hbound
                omega
              | R =>

                have hsortR : TwSortedPath .R ((.R, s3) :: rest') := ⟨le_rfl, hsort_rest'⟩
                have hm_bef := h_projM_attach_R ((.R, s3) :: rest') u_bef hsortR
                have hm_aft := h_projM_attach_R ((.R, s3) :: rest') u_aft hsortR
                have hrsl_diff : rightSpineLen (twProjM (twAttachPoly u_aft ((.R, s3) :: rest'))) =
                    rightSpineLen (twProjM (twAttachPoly u_bef ((.R, s3) :: rest'))) + 1 := by
                  rw [hm_bef, hm_aft]
                  simp only [u_bef, u_aft, twProjM, rightSpineLen]
                  omega
                obtain ⟨hc1, hc2, hv, hbound⟩ :=
                  ih .R u_aft ((.R, s3) :: rest') hrest_len hsortR
                refine ⟨hc1, hc2, hv, ?_⟩
                simp only [List.length_cons, twFilterProjL] at hbound ⊢
                dsimp (config := { failIfUnchanged := false }) only [twStepBudget] at hbound
                unfold twPhiMR at hbound ⊢
                dsimp (config := { failIfUnchanged := false }) only [u_bef, u_aft] at hlsl_diff hrsl_diff hR_eq hbound ⊢
                rw [hR_eq] at hbound
                omega
          ·
            have hcur_b : 3 ≤ twStepBudget cur := by
              cases cur <;> simp [twFateCode, twStepBudget] at hcur1 ⊢
            have hphi_eq : twPhiMR (twAttachPoly u_aft rest) = twPhiMR (twAttachPoly u_bef rest) := by
              unfold twPhiMR
              rw [h_projM_attach_congr rest u_aft u_bef rfl,
                  h_projR_attach_congr rest u_aft u_bef rfl]
            have hR_eq : twProjR (twAttachPoly u_aft rest) = twProjR (twAttachPoly u_bef rest) :=
              h_projR_attach_congr rest u_aft u_bef rfl
            obtain ⟨hc1, hc2, hv, hbound⟩ := ih .R u_aft rest hrest_len hsort_rest
            dsimp (config := { failIfUnchanged := false }) only [twExtractPopRRslrs, beq_iff_eq, reduceCtorEq,
              decide_false, Bool.false_and, Bool.false_eq_true, ↓reduceIte]
            simp only [twAttachPoly, twSplayLeftSpinePoly]
            rw [← hR_eq]
            refine ⟨hc1, hc2, hv, ?_⟩
            simp only [List.length_cons, twFilterProjL] at hbound ⊢
            dsimp (config := { failIfUnchanged := false }) only [twStepBudget] at hbound
            dsimp (config := { failIfUnchanged := false }) only [u_bef, u_aft] at hphi_eq hbound ⊢
            omega
          ·
            simp [twFateCode] at hk12
          ·
            simp [twFateCode] at hk12
          ·
            have hcur_b : 1 ≤ twStepBudget cur := by cases cur <;> decide
            have hM_eq : twProjM (twAttachPoly u_aft rest) = twProjM (twAttachPoly u_bef rest) :=
              h_projM_attach_congr rest u_aft u_bef rfl
            have hlslR_bef := h_lsl_projR_attach rest u_bef hsort_rest
            have hlslR_aft := h_lsl_projR_attach rest u_aft hsort_rest
            have hlslR_diff : leftSpineLen (twProjR (twAttachPoly u_bef rest)) =
                leftSpineLen (twProjR (twAttachPoly u_aft rest)) + 1 := by
              rw [hlslR_bef, hlslR_aft]
              simp only [u_bef, u_aft, twProjR, leftSpineLen]
              omega
            have hd0 : 0 + 2 ≤ rightSpineLen (twMirrorTree (twProjR u_bef)) := by
              simp only [u_bef, twProjR, twMirrorTree, rightSpineLen]
              omega
            have hrot0 : rotateLeftAtRightDepth (twMirrorTree (twProjR u_bef)) 0 =
                twMirrorTree (twProjR u_aft) := by
              rfl
            obtain ⟨hrsl_ge, hrot_rest⟩ := h_rslr_attach_R rest 0 u_bef u_aft hsort_rest hd0 hrot0
            simp only [Nat.add_zero] at hrsl_ge hrot_rest
            obtain ⟨hc1, hc2, hv, hbound⟩ := ih .R u_aft rest hrest_len hsort_rest
            change twCountExtPop (.rslr rest.length :: twExtractPopRRslrs rest) = 0 ∧
              twExtCoreCascadeCost (twMirrorTree (twProjR (twAttachPoly u_bef rest)))
                (.rslr rest.length :: twExtractPopRRslrs rest) = 0 ∧
              TwValidExtSteps (twMirrorTree (twProjR (twAttachPoly u_bef rest)))
                (.rslr rest.length :: twExtractPopRRslrs rest)
                (twMirrorTree (twProjR (twSplayLeftSpinePoly u_aft rest))) ∧ _
            refine ⟨hc1, ?_, ⟨hrsl_ge, ?_⟩, ?_⟩
            · simp only [twExtCoreCascadeCost, twExtCascadeStepCost, twExecExtCoreOp, hrot_rest]
              omega
            · rwa [hrot_rest]
            · simp only [twAttachPoly, twSplayLeftSpinePoly, List.length_cons, twFilterProjL]
              dsimp (config := { failIfUnchanged := false }) only [twStepBudget] at hbound
              unfold twPhiMR at hbound ⊢
              dsimp (config := { failIfUnchanged := false }) only [u_bef, u_aft] at hM_eq hlslR_diff hbound ⊢
              rw [hM_eq] at hbound
              omega


    have h_pop_step : ∀ C : _root_.BinaryTree TwFate,
        TwIsTriOrdered C → 1 ≤ twCountFate .L C →
        twEraseTree C ≠ .nil ∧
        ∃ (stepL stepR : List TwExtCoreOp),
          twCountExtPop stepL + twCountExtPop stepR = 1 ∧
          TwValidExtSteps (twProjL C) stepL (twProjL (twPopPoly C)) ∧
          TwValidExtSteps (twMirrorTree (twProjR C)) stepR
            (twMirrorTree (twProjR (twPopPoly C))) ∧
          (leftSpineLen (twEraseTree C) - 1) + twPhi2 (twPopPoly C) ≤
            2 * twExtCoreCascadeCost (twProjL C) stepL +
            2 * twExtCoreCascadeCost (twMirrorTree (twProjR C)) stepR +
            twPhi2 C + 9 := by
      intro C htri hcntL
      have hC_ne : C ≠ .nil := by
        intro h; subst h; simp [twCountFate] at hcntL
      have he_ne : twEraseTree C ≠ .nil := by
        cases C with
        | nil => exact absurd rfl hC_ne
        | node f l r => simp [twEraseTree, twMapTree]
      obtain ⟨f0, hlm⟩ := h_leftmost_some C hC_ne
      have hf0_all := h_leftmost_le C f0 htri hlm
      have hf0_L : f0 = .L := by
        cases f0 with
        | L => rfl
        | M =>
          have hc0 := h_countL_of_ge1 C hf0_all
          omega
        | R =>
          have hc0 := h_countL_of_ge1 C
            (h_forall_mono (fun x hx => by (cases x <;> simp [twFateCode] at hx); decide) hf0_all)
          omega
      subst hf0_L
      set cr := (twDescendLeftPoly C []).1
      set path := (twDescendLeftPoly C []).2
      have hatt : twAttachPoly (.node .L .nil cr) path = C := by
        simpa [twAttachPoly] using h_leftmost_attach C .L [] hlm
      have htri_att : TwIsTriOrdered (twAttachPoly (.node .L .nil cr) path) := by
        rwa [hatt]
      have hsort : TwSortedPath .L path := h_sorted_of_attach path .nil .L cr htri_att
      have hlen_C : path.length = leftSpineLen (twEraseTree C) - 1 := by
        have hl := h_descPoly_len C [] hC_ne
        simp only [List.length_nil, Nat.add_zero] at hl
        dsimp (config := { failIfUnchanged := false }) only [path]
        omega
      have hprojL_C : twProjL C = twAttachUnit (.node () .nil (twProjL cr)) (twFilterProjL path) := by
        rw [← hatt, h_projL_attach]
        rfl
      have hprojL_ne : twProjL C ≠ .nil := by
        rw [hprojL_C]
        exact h_attachUnit_ne (.node () .nil (twProjL cr)) (twFilterProjL path) (by simp)
      have hlsl_projL : leftSpineLen (twProjL C) - 1 = (twFilterProjL path).length := by
        rw [hprojL_C, h_lsl_attachUnit]
        simp [leftSpineLen]
      have hpop_projL : popUnlabeled (twProjL C) = twProjL (twPopPoly C) := by
        unfold popUnlabeled twPopPoly
        rw [hprojL_C, h_descLeft_attachUnit (.node () .nil (twProjL cr)) (twFilterProjL path) []
          (by simp)]
        simp only [List.append_nil, descendLeft]
        exact (h_projL_splay path.length .L cr path le_rfl hsort).symm
      have hrsl_popL : rightSpineLen (twProjL (twPopPoly C)) ≤ rightSpineLen (twProjL C) + 1 := by
        rw [← hpop_projL]
        exact h_rsl_popUnlabeled (twProjL C)
      have hM_cr : twProjM (twAttachPoly cr path) = twProjM C := by
        rw [← hatt]
        exact h_projM_attach_congr path cr (.node .L .nil cr) rfl
      have hR_cr : twProjR (twAttachPoly cr path) = twProjR C := by
        rw [← hatt]
        exact h_projR_attach_congr path cr (.node .L .nil cr) rfl
      have hphiMR_cr : twPhiMR (twAttachPoly cr path) = twPhiMR C := by
        unfold twPhiMR; rw [hM_cr, hR_cr]
      obtain ⟨hc1, hc2, hvR, hbound⟩ := h_pop_path_ind path.length .L cr path le_rfl hsort
      rw [hR_cr] at hc2 hvR
      refine ⟨he_ne, [.pop], twExtractPopRRslrs path, ?_, ?_, hvR, ?_⟩
      · simp only [twCountExtPop]; omega
      · exact ⟨hprojL_ne, hpop_projL⟩
      · have hcostL : twExtCoreCascadeCost (twProjL C) [.pop] = (twFilterProjL path).length / 2 := by
          simp [twExtCoreCascadeCost, twExtCascadeStepCost, hlsl_projL]
        rw [← hlen_C, hcostL, hc2]
        unfold twPhi2
        have hpop_def : twPopPoly C = twSplayLeftSpinePoly cr path := rfl
        rw [hpop_def] at hrsl_popL ⊢
        rw [hphiMR_cr] at hbound
        dsimp (config := { failIfUnchanged := false }) only [twStepBudget] at hbound
        omega


    have h_traj : ∀ (cops : List TwCDequeOp) (C : _root_.BinaryTree TwFate),
        TwValidCDequeSeq C cops →
        ∃ (eops_L eops_R : List TwExtCoreOp),
          twCountExtPop eops_L + twCountExtPop eops_R ≤ cops.length ∧
          TwValidExtCoreSeq (twProjL C) eops_L ∧
          TwValidExtCoreSeq (twMirrorTree (twProjR C)) eops_R ∧
          twUDequeSeqCost (twEraseTree C) (cops.map twEraseCDequeOp) ≤
            2 * twExtCoreCascadeCost (twProjL C) eops_L +
            2 * twExtCoreCascadeCost (twMirrorTree (twProjR C)) eops_R +
            twPhi2 C + 9 * cops.length := by
      intro cops
      induction cops with
      | nil =>
        rintro C ⟨_, hcL, hcR⟩
        refine ⟨[], [], by simp [twCountExtPop], ?_, ?_, ?_⟩
        · exact h_projL_of_count0 C hcL
        · simp [h_projR_of_count0 C hcR, twMirrorTree, TwValidExtCoreSeq]
        · simp [twUDequeSeqCost]
      | cons op rest ih =>
        intro C hval
        cases op with
        | push f =>
          rcases hval with ⟨_, hord, hval_rest⟩
          obtain ⟨sL, sR, hpop0, hvL, hvR, hstep⟩ := h_push_step C f hord
          obtain ⟨rL, rR, hpop_r, hseqL, hseqR, hcost_r⟩ := ih (.node f .nil C) hval_rest
          refine ⟨sL ++ rL, sR ++ rR, ?_, h_extSteps_seq _ _ _ _ hvL hseqL,
            h_extSteps_seq _ _ _ _ hvR hseqR, ?_⟩
          · rw [h_extPop_append, h_extPop_append, List.length_cons]; omega
          · rw [h_extCost_append _ _ _ _ hvL, h_extCost_append _ _ _ _ hvR]
            simp only [List.map_cons, twEraseCDequeOp, twUDequeSeqCost, twCostUDeque,
              twStepUDeque, List.length_cons]
            have herase : _root_.BinaryTree.node () .nil (twEraseTree C) =
                twEraseTree (.node f .nil C) := rfl
            rw [herase]
            omega
        | inject f =>
          rcases hval with ⟨_, hord, hval_rest⟩
          have hord_dual : ForallTree (fun x => twFateCode (twMirrorFate f) ≤ twFateCode x)
              (twDualTree C) := by
            unfold twDualTree
            rw [h_forall_map, h_forall_mirror]
            exact h_forall_mono (fun x hx => h_fateCode_mirror x f hx) hord
          obtain ⟨s1, s2, hpop0, hv1, hv2, hstep⟩ :=
            h_push_step (twDualTree C) (twMirrorFate f) hord_dual
          have hdual_next : _root_.BinaryTree.node (twMirrorFate f) .nil (twDualTree C) =
              twDualTree (.node f C .nil) := rfl
          simp only [hdual_next, h_projL_dual, h_projR_dual, h_mirror_mirror, h_phi2_dual]
            at hv1 hv2 hstep
          obtain ⟨rL, rR, hpop_r, hseqL, hseqR, hcost_r⟩ := ih (.node f C .nil) hval_rest
          refine ⟨s2 ++ rL, s1 ++ rR, ?_, h_extSteps_seq _ _ _ _ hv2 hseqL,
            h_extSteps_seq _ _ _ _ hv1 hseqR, ?_⟩
          · rw [h_extPop_append, h_extPop_append, List.length_cons]; omega
          · rw [h_extCost_append _ _ _ _ hv2, h_extCost_append _ _ _ _ hv1]
            simp only [List.map_cons, twEraseCDequeOp, twUDequeSeqCost, twCostUDeque,
              twStepUDeque, List.length_cons]
            have herase : _root_.BinaryTree.node () (twEraseTree C) .nil =
                twEraseTree (.node f C .nil) := rfl
            rw [herase]
            omega
        | pop =>
          rcases hval with ⟨htri, hcntL, hval_rest⟩
          obtain ⟨_, sL, sR, hpop1, hvL, hvR, hstep⟩ := h_pop_step C htri hcntL
          obtain ⟨rL, rR, hpop_r, hseqL, hseqR, hcost_r⟩ := ih (twPopPoly C) hval_rest
          refine ⟨sL ++ rL, sR ++ rR, ?_, h_extSteps_seq _ _ _ _ hvL hseqL,
            h_extSteps_seq _ _ _ _ hvR hseqR, ?_⟩
          · rw [h_extPop_append, h_extPop_append, List.length_cons]; omega
          · rw [h_extCost_append _ _ _ _ hvL, h_extCost_append _ _ _ _ hvR]
            simp only [List.map_cons, twEraseCDequeOp, twUDequeSeqCost, twCostUDeque,
              twStepUDeque, List.length_cons, ← h_popPoly_erase]
            omega
        | eject =>
          rcases hval with ⟨htri, hcntR, hval_rest⟩
          have htri_d : TwIsTriOrdered (twDualTree C) := h_dual_tri C htri
          have hcntL_d : 1 ≤ twCountFate .L (twDualTree C) := by rwa [h_dual_countL]
          obtain ⟨_, s1, s2, hpop1, hv1, hv2, hstep⟩ := h_pop_step (twDualTree C) htri_d hcntL_d
          simp only [← h_dual_eject, h_projL_dual, h_projR_dual, h_mirror_mirror, h_phi2_dual]
            at hv1 hv2 hstep
          have hlsl_d : leftSpineLen (twEraseTree (twDualTree C)) =
              rightSpineLen (twEraseTree C) := by
            unfold twDualTree
            rw [h_erase_map]
            have hm : twEraseTree (twMirrorTree C) = twMirrorTree (twEraseTree C) :=
              h_map_mirror (fun _ => ()) C
            rw [hm, h_lsl_mirror]
          rw [hlsl_d] at hstep
          obtain ⟨rL, rR, hpop_r, hseqL, hseqR, hcost_r⟩ := ih (twEjectPoly C) hval_rest
          refine ⟨s2 ++ rL, s1 ++ rR, ?_, h_extSteps_seq _ _ _ _ hv2 hseqL,
            h_extSteps_seq _ _ _ _ hv1 hseqR, ?_⟩
          · rw [h_extPop_append, h_extPop_append, List.length_cons]; omega
          · rw [h_extCost_append _ _ _ _ hv2, h_extCost_append _ _ _ _ hv1]
            simp only [List.map_cons, twEraseCDequeOp, twUDequeSeqCost, twCostUDeque,
              twStepUDeque, List.length_cons, ← h_ejectPoly_erase]
            omega


    subst hn hm
    rcases cops with _ | ⟨op0, rest⟩
    · rcases hvc with ⟨_, hcL, hcR⟩
      refine ⟨0, 0, [], [], by omega, rfl, rfl, h_projL_of_count0 C0 hcL, ?_, ?_⟩
      · simp [h_projR_of_count0 C0 hcR, twMirrorTree, TwValidExtCoreSeq]
      · simp [twUDequeSeqCost]
    · obtain ⟨eops_L, eops_R, hpop_le, hvL, hvR, hcost⟩ := h_traj (op0 :: rest) C0 hvc
      have hphi := h_phi2_init_le C0
      refine ⟨twCountExtPop eops_L, twCountExtPop eops_R, eops_L, eops_R, hpop_le,
        rfl, rfl, hvL, hvR, ?_⟩
      simp only [List.length_cons] at hcost ⊢
      omega

  have h_stage4 :
      ∀ (u0 : _root_.BinaryTree Unit) (P : ℕ) (eops : List TwExtCoreOp),
        twCountExtPop eops = P →
        TwValidExtCoreSeq u0 eops →
        ∃ ops : List CoreOp,
          ValidCoreSeq P ops ∧ coreCascadeCost ops = twExtCoreCascadeCost u0 eops := by
    clear h_stage12 h_stage3 n m init ops hn hvalid
    let listNodes : List (_root_.BinaryTree Unit) → ℕ := fun xs =>
      xs.foldr (fun x acc => 1 + x.num_nodes + acc) 0

    have h_rotL_nodes :
        ∀ (d : ℕ) (t : _root_.BinaryTree Unit), (rotateLeftAtRightDepth t d).num_nodes = t.num_nodes := by
      intro d
      induction d with
      | zero =>
        intro t
        rcases t with _ | ⟨u1, a, _ | ⟨u2, b, c⟩⟩ <;>
          (simp [rotateLeftAtRightDepth, _root_.BinaryTree.rotateLeft, _root_.BinaryTree.num_nodes]; try omega)
      | succ d ih =>
        intro t
        rcases t with _ | ⟨u, l, r⟩
        · rfl
        · simp only [rotateLeftAtRightDepth, _root_.BinaryTree.num_nodes, ih r]

    have h_descend_nodes :
        ∀ (u : _root_.BinaryTree Unit) (acc : List (_root_.BinaryTree Unit)),
          u ≠ .nil →
          (descendLeft u acc).1.num_nodes + listNodes (descendLeft u acc).2 + 1 =
            u.num_nodes + listNodes acc := by
      intro u
      induction u with
      | nil => intro _ h; exact absurd rfl h
      | node u0 l r ihl _ =>
        intro acc _
        rcases l with _ | ⟨lu, ll, lr⟩
        · simp only [descendLeft]
          change r.num_nodes + listNodes acc + 1 = (1 + 0 + r.num_nodes) + listNodes acc
          omega
        · have h1 := ihl (r :: acc) (by simp)
          simp only [descendLeft]
          change (descendLeft (.node lu ll lr) (r :: acc)).1.num_nodes +
            listNodes (descendLeft (.node lu ll lr) (r :: acc)).2 + 1 =
            (1 + (1 + ll.num_nodes + lr.num_nodes) + r.num_nodes) + listNodes acc
          change (descendLeft (.node lu ll lr) (r :: acc)).1.num_nodes +
            listNodes (descendLeft (.node lu ll lr) (r :: acc)).2 + 1 =
            (1 + ll.num_nodes + lr.num_nodes) + (1 + r.num_nodes + listNodes acc) at h1
          omega

    have h_splay_nodes :
        ∀ (n : ℕ) (c : _root_.BinaryTree Unit) (path : List (_root_.BinaryTree Unit)),
          path.length ≤ n →
          (splayLeftSpine c path).num_nodes = c.num_nodes + listNodes path := by
      intro n
      induction n with
      | zero =>
        intro c path hlen
        rcases path with _ | _
        · change c.num_nodes = c.num_nodes + 0; omega
        · simp at hlen
      | succ n ih =>
        intro c path hlen
        rcases path with _ | ⟨r1, _ | ⟨r2, rest⟩⟩
        · change c.num_nodes = c.num_nodes + 0; omega
        · change 1 + c.num_nodes + r1.num_nodes = c.num_nodes + (1 + r1.num_nodes + 0); omega
        · have hrest : rest.length ≤ n := by simp at hlen; omega
          have h1 := ih (.node () c (.node () r1 r2)) rest hrest
          change (splayLeftSpine (.node () c (.node () r1 r2)) rest).num_nodes =
            c.num_nodes + (1 + r1.num_nodes + (1 + r2.num_nodes + listNodes rest))
          simp only [_root_.BinaryTree.num_nodes] at h1
          omega

    have h_pop_nodes :
        ∀ t : _root_.BinaryTree Unit, t ≠ .nil → (popUnlabeled t).num_nodes + 1 = t.num_nodes := by
      intro t ht
      unfold popUnlabeled
      have hd := h_descend_nodes t [] ht
      have hs := h_splay_nodes (descendLeft t []).2.length (descendLeft t []).1
        (descendLeft t []).2 le_rfl
      change (descendLeft t []).1.num_nodes + listNodes (descendLeft t []).2 + 1 =
        t.num_nodes + 0 at hd
      dsimp (config := { failIfUnchanged := false }) only at hs ⊢
      omega

    have h_ext_conservation :
        ∀ (eops : List TwExtCoreOp) (u : _root_.BinaryTree Unit),
          TwValidExtCoreSeq u eops →
          u.num_nodes + twCountExtPush eops + twCountExtInject eops = twCountExtPop eops := by
      intro eops
      induction eops with
      | nil =>
        intro u h; subst h; simp [_root_.BinaryTree.num_nodes, twCountExtPush, twCountExtInject, twCountExtPop]
      | cons op rest ih =>
        intro u hval
        cases op with
        | push =>
          have h1 := ih (.node () .nil u) hval
          simp only [_root_.BinaryTree.num_nodes, twCountExtPush, twCountExtInject, twCountExtPop] at h1 ⊢
          omega
        | pop =>
          rcases hval with ⟨hne, hval⟩
          have hp := h_pop_nodes u hne
          have h1 := ih (popUnlabeled u) hval
          simp only [twCountExtPush, twCountExtInject, twCountExtPop] at h1 ⊢
          omega
        | rslr d =>
          rcases hval with ⟨_, hval⟩
          have hr := h_rotL_nodes d u
          have h1 := ih (rotateLeftAtRightDepth u d) hval
          simp only [twCountExtPush, twCountExtInject, twCountExtPop] at h1 ⊢
          omega
        | inject =>
          have h1 := ih (.node () u .nil) hval
          simp only [_root_.BinaryTree.num_nodes, twCountExtPush, twCountExtInject, twCountExtPop] at h1 ⊢
          omega

    let coreRun : _root_.BinaryTree Unit → List CoreOp → _root_.BinaryTree Unit → ℕ → ℕ → ℕ → Prop :=
      fun t1 ops t2 pushes pops cost =>
        TwValidCoreSteps t1 ops t2 ∧
        countCorePush ops = pushes ∧
        countCorePop ops = pops ∧
        ∀ tail : List CoreOp, coreCascadeCostAux t1 (ops ++ tail) = cost + coreCascadeCostAux t2 tail

    have h_steps_append :
        ∀ (a b : List CoreOp) (t1 t2 t3 : _root_.BinaryTree Unit),
          TwValidCoreSteps t1 a t2 → TwValidCoreSteps t2 b t3 →
          TwValidCoreSteps t1 (a ++ b) t3 := by
      intro a
      induction a with
      | nil => intro b t1 t2 t3 h1 h2; subst h1; exact h2
      | cons op rest ih =>
        intro b t1 t2 t3 h1 h2
        cases op with
        | push => exact ih b (.node () .nil t1) t2 t3 h1 h2
        | pop => exact ⟨h1.1, ih b (popUnlabeled t1) t2 t3 h1.2 h2⟩
        | rslr d => exact ⟨h1.1, ih b (rotateLeftAtRightDepth t1 d) t2 t3 h1.2 h2⟩

    have h_push_append : ∀ (a b : List CoreOp),
        countCorePush (a ++ b) = countCorePush a + countCorePush b := by
      intro a b
      induction a with
      | nil => simp [countCorePush]
      | cons op rest ih => cases op <;> (simp [countCorePush, ih]; try omega)

    have h_pop_append : ∀ (a b : List CoreOp),
        countCorePop (a ++ b) = countCorePop a + countCorePop b := by
      intro a b
      induction a with
      | nil => simp [countCorePop]
      | cons op rest ih => cases op <;> (simp [countCorePop, ih]; try omega)

    have h_run_trans :
        ∀ {t1 t2 t3 : _root_.BinaryTree Unit} {a b : List CoreOp} {pa pb qa qb ca cb : ℕ},
          coreRun t1 a t2 pa qa ca →
          coreRun t2 b t3 pb qb cb →
          coreRun t1 (a ++ b) t3 (pa + pb) (qa + qb) (ca + cb) := by
      rintro t1 t2 t3 a b pa pb qa qb ca cb ⟨hva, hpa, hqa, hca⟩ ⟨hvb, hpb, hqb, hcb⟩
      refine ⟨h_steps_append a b t1 t2 t3 hva hvb, ?_, ?_, ?_⟩
      · rw [h_push_append, hpa, hpb]
      · rw [h_pop_append, hqa, hqb]
      · intro tail
        rw [List.append_assoc, hca (b ++ tail), hcb tail, Nat.add_assoc]

    have h_steps_empty :
        ∀ (ops : List CoreOp) (t : _root_.BinaryTree Unit),
          TwValidCoreSteps t ops .nil → ValidCoreSeqAux t ops := by
      intro ops
      induction ops with
      | nil => intro t h; exact h
      | cons op rest ih =>
        intro t h
        cases op with
        | push => exact ih (.node () .nil t) h
        | pop => exact ⟨h.1, ih (popUnlabeled t) h.2⟩
        | rslr d => exact ⟨h.1, ih (rotateLeftAtRightDepth t d) h.2⟩

    have h_app_nodes :
        ∀ (u tl : _root_.BinaryTree Unit),
          (twAppendRightmost u tl).num_nodes = u.num_nodes + tl.num_nodes := by
      intro u tl
      induction u with
      | nil => simp [twAppendRightmost, _root_.BinaryTree.num_nodes]
      | node _ l r _ ihr => simp [twAppendRightmost, _root_.BinaryTree.num_nodes, ihr]; omega

    have h_chain_nodes : ∀ k : ℕ, (twRightChain k).num_nodes = k := by
      intro k
      induction k with
      | zero => rfl
      | succ k ih => simp [twRightChain, _root_.BinaryTree.num_nodes, ih]; omega

    have h_rsl_app :
        ∀ (u tl : _root_.BinaryTree Unit),
          rightSpineLen (twAppendRightmost u tl) = rightSpineLen u + rightSpineLen tl := by
      intro u tl
      induction u with
      | nil => simp [twAppendRightmost, rightSpineLen]
      | node _ l r _ ihr => simp [twAppendRightmost, rightSpineLen, ihr]; omega

    have h_rslr_app :
        ∀ (d : ℕ) (u tl : _root_.BinaryTree Unit),
          d + 2 ≤ rightSpineLen u →
          d + 2 ≤ rightSpineLen (twAppendRightmost u tl) ∧
          rotateLeftAtRightDepth (twAppendRightmost u tl) d =
            twAppendRightmost (rotateLeftAtRightDepth u d) tl := by
      intro d
      induction d with
      | zero =>
        intro u tl h
        rcases u with _ | ⟨_, a, _ | ⟨_, b, c⟩⟩
        · simp [rightSpineLen] at h
        · simp [rightSpineLen] at h
        · refine ⟨?_, rfl⟩
          simp [twAppendRightmost, rightSpineLen]; omega
      | succ d ih =>
        intro u tl h
        rcases u with _ | ⟨_, l, r⟩
        · simp [rightSpineLen] at h
        · simp only [rightSpineLen] at h
          obtain ⟨h1, h2⟩ := ih r tl (by omega)
          refine ⟨?_, ?_⟩
          · simp [twAppendRightmost, rightSpineLen]; omega
          · simp [twAppendRightmost, rotateLeftAtRightDepth, h2]

    have h_desc_append :
        ∀ (u : _root_.BinaryTree Unit) (a1 a2 : List (_root_.BinaryTree Unit)),
          u ≠ .nil →
          descendLeft u (a1 ++ a2) = ((descendLeft u a1).1, (descendLeft u a1).2 ++ a2) := by
      intro u
      induction u with
      | nil => intro _ _ h; exact absurd rfl h
      | node _ l r ihl _ =>
        intro a1 a2 _
        rcases l with _ | ⟨lu, ll, lr⟩
        · simp [descendLeft]
        · simp only [descendLeft]
          rw [← List.cons_append]
          exact ihl (r :: a1) a2 (by simp)

    have h_splay_app_tail :
        ∀ (n : ℕ) (c : _root_.BinaryTree Unit) (p : List (_root_.BinaryTree Unit)) (r tl : _root_.BinaryTree Unit),
          p.length ≤ n →
          splayLeftSpine c (p ++ [twAppendRightmost r tl]) =
            twAppendRightmost (splayLeftSpine c (p ++ [r])) tl := by
      intro n
      induction n with
      | zero =>
        intro c p r tl hlen
        rcases p with _ | _
        · rfl
        · simp at hlen
      | succ n ih =>
        intro c p r tl hlen
        rcases p with _ | ⟨r1, _ | ⟨r2, rest⟩⟩
        · rfl
        · rfl
        · have hrest : rest.length ≤ n := by simp at hlen; omega
          simpa [splayLeftSpine] using ih (.node () c (.node () r1 r2)) rest r tl hrest

    have h_pop_app :
        ∀ (u tl : _root_.BinaryTree Unit),
          u ≠ .nil →
          twAppendRightmost u tl ≠ .nil ∧
          leftSpineLen (twAppendRightmost u tl) = leftSpineLen u ∧
          popUnlabeled (twAppendRightmost u tl) = twAppendRightmost (popUnlabeled u) tl := by
      intro u tl hne
      rcases u with _ | ⟨_, l, r⟩
      · exact absurd rfl hne
      · refine ⟨by simp [twAppendRightmost], by simp [twAppendRightmost, leftSpineLen], ?_⟩
        rcases l with _ | ⟨lu, ll, lr⟩
        · simp [popUnlabeled, descendLeft, splayLeftSpine, twAppendRightmost]
        · unfold popUnlabeled
          have ha1 := h_desc_append (.node lu ll lr) [] [twAppendRightmost r tl] (by simp)
          have ha2 := h_desc_append (.node lu ll lr) [] [r] (by simp)
          simp only [List.nil_append] at ha1 ha2
          simp only [twAppendRightmost, descendLeft]
          rw [ha1, ha2]
          exact h_splay_app_tail (descendLeft (.node lu ll lr) []).2.length
            (descendLeft (.node lu ll lr) []).1 (descendLeft (.node lu ll lr) []).2 r tl le_rfl

    have h_pullUp_all_rslr :
        ∀ β : ℕ, ∀ op ∈ twPullUpSeq β, ∃ d : ℕ, op = .rslr d := by
      intro β
      induction β with
      | zero => intro _ h; simp [twPullUpSeq] at h
      | succ β ih =>
        intro op h
        rcases List.mem_cons.mp h with rfl | hrest
        · exact ⟨β, rfl⟩
        · exact ih op hrest

    have h_pullUp_shift :
        ∀ β : ℕ, (twPullUpSeq β).map twShiftCoreOp ++ [.rslr 0] = twPullUpSeq (β + 1) := by
      intro β
      induction β with
      | zero => rfl
      | succ β ih =>
        simp only [twPullUpSeq, List.map_cons, twShiftCoreOp, List.cons_append]
        rw [ih]
        rfl

    have h_shift_rslr_run :
        ∀ (ops : List CoreOp) (l r1 r2 : _root_.BinaryTree Unit),
          (∀ op ∈ ops, ∃ d : ℕ, op = .rslr d) →
          TwValidCoreSteps r1 ops r2 →
          coreRun (.node () l r1) (ops.map twShiftCoreOp) (.node () l r2) 0 0 0 := by
      intro ops
      induction ops with
      | nil =>
        rintro l r1 r2 _ rfl
        exact ⟨rfl, rfl, rfl, fun _ => by simp⟩
      | cons op rest ih =>
        rintro l r1 r2 hall hv
        obtain ⟨d, rfl⟩ := hall op (by simp)
        rcases hv with ⟨hd, hv_rest⟩
        have hall' : ∀ x ∈ rest, ∃ d' : ℕ, x = .rslr d' :=
          fun x hx => hall x (List.mem_cons_of_mem _ hx)
        obtain ⟨hvs, hps, hqs, hcs⟩ := ih l (rotateLeftAtRightDepth r1 d) r2 hall' hv_rest
        refine ⟨⟨?_, hvs⟩, hps, hqs, ?_⟩
        · simp [rightSpineLen]; omega
        · intro tail
          simpa [List.map_cons, twShiftCoreOp, List.cons_append, coreCascadeCostAux,
            coreCascadeStepCost, execCoreOp, rotateLeftAtRightDepth] using hcs tail

    have h_pullUp_run :
        ∀ (u tl : _root_.BinaryTree Unit),
          coreRun (twAppendRightmost u (.node () .nil tl))
            (twPullUpSeq (rightSpineLen u)) (.node () u tl) 0 0 0 := by
      intro u
      induction u with
      | nil =>
        intro tl
        refine ⟨rfl, rfl, rfl, fun tail => ?_⟩
        change coreCascadeCostAux (.node () .nil tl) ([] ++ tail) = 0 + coreCascadeCostAux (.node () .nil tl) tail
        simp
      | node u0 l r _ ihr =>
        intro tl
        cases u0
        have hr_run := ihr tl
        have hshift := h_shift_rslr_run (twPullUpSeq (rightSpineLen r)) l
          (twAppendRightmost r (.node () .nil tl)) (.node () r tl)
          (h_pullUp_all_rslr (rightSpineLen r)) hr_run.1
        have hrot0 : coreRun (.node () l (.node () r tl)) [.rslr 0]
            (.node () (.node () l r) tl) 0 0 0 := by
          refine ⟨⟨by simp [rightSpineLen]; omega, rfl⟩, rfl, rfl, ?_⟩
          intro tail
          simp [coreCascadeCostAux, coreCascadeStepCost, execCoreOp,
            rotateLeftAtRightDepth, _root_.BinaryTree.rotateLeft]
        have hcomb := h_run_trans hshift hrot0
        simp only [Nat.add_zero] at hcomb
        rw [h_pullUp_shift (rightSpineLen r)] at hcomb
        simpa [twAppendRightmost, rightSpineLen, Nat.add_comm 1] using hcomb

    have h_rsl_le_nodes : ∀ u : _root_.BinaryTree Unit, rightSpineLen u ≤ u.num_nodes := by
      intro u
      induction u with
      | nil => rfl
      | node _ l r _ ihr => simp [rightSpineLen, _root_.BinaryTree.num_nodes]; omega

    have h_build_aux :
        ∀ (fuel : ℕ) (t : _root_.BinaryTree Unit),
          2 * t.num_nodes - rightSpineLen t ≤ fuel →
          coreRun .nil (twBuildFromEmptyAux fuel t) t t.num_nodes 0 0 := by
      intro fuel
      induction fuel with
      | zero =>
        intro t hle
        cases t with
        | nil => exact ⟨rfl, rfl, rfl, fun _ => by simp [twBuildFromEmptyAux]⟩
        | node _ l r =>
          have hr := h_rsl_le_nodes r
          simp only [_root_.BinaryTree.num_nodes, rightSpineLen] at hle
          omega
      | succ fuel ih =>
        intro t hle
        rcases t with _ | ⟨u0, l, r⟩
        · exact ⟨rfl, rfl, rfl, fun _ => by simp [twBuildFromEmptyAux]⟩
        · cases u0
          rcases l with _ | ⟨u1, a, b⟩
          · have hr := h_rsl_le_nodes r
            have hfuel : 2 * r.num_nodes - rightSpineLen r ≤ fuel := by
              simp only [_root_.BinaryTree.num_nodes, rightSpineLen] at hle
              omega
            have h1 := ih r hfuel
            have h2 : coreRun r [.push] (.node () .nil r) 1 0 0 :=
              ⟨rfl, rfl, rfl, fun _ => by simp [coreCascadeCostAux, coreCascadeStepCost, execCoreOp]⟩
            have hcomb := h_run_trans h1 h2
            simp only [twBuildFromEmptyAux, _root_.BinaryTree.num_nodes, Nat.add_zero]
            have hn_eq : r.num_nodes + 1 = 1 + 0 + r.num_nodes := by omega
            rw [← hn_eq]
            exact hcomb
          · cases u1
            let t' : _root_.BinaryTree Unit := .node () a (.node () b r)
            have hr := h_rsl_le_nodes r
            have ht'_nodes : t'.num_nodes = (_root_.BinaryTree.node () (.node () a b) r).num_nodes := by
              simp [t', _root_.BinaryTree.num_nodes]; omega
            have hfuel : 2 * t'.num_nodes - rightSpineLen t' ≤ fuel := by
              simp only [t', _root_.BinaryTree.num_nodes, rightSpineLen] at hle ⊢
              omega
            have h1 := ih t' hfuel
            have h2 : coreRun t' [.rslr 0] (.node () (.node () a b) r) 0 0 0 := by
              refine ⟨⟨by simp [t', rightSpineLen]; omega, rfl⟩, rfl, rfl, ?_⟩
              intro tail
              simp [t', coreCascadeCostAux, coreCascadeStepCost, execCoreOp,
                rotateLeftAtRightDepth, _root_.BinaryTree.rotateLeft]
            have hcomb := h_run_trans h1 h2
            simp only [Nat.add_zero, ht'_nodes] at hcomb
            exact hcomb

    have h_sim_loop :
        ∀ (eops : List TwExtCoreOp) (u : _root_.BinaryTree Unit),
          TwValidExtCoreSeq u eops →
          ∃ simOps : List CoreOp,
            coreRun (twAppendRightmost u (twRightChain (twCountExtInject eops)))
              simOps .nil (twCountExtPush eops) (twCountExtPop eops)
              (twExtCoreCascadeCost u eops) := by
      intro eops
      induction eops with
      | nil =>
        intro u h; subst h
        refine ⟨[], rfl, rfl, rfl, fun tail => ?_⟩
        change coreCascadeCostAux .nil ([] ++ tail) = 0 + coreCascadeCostAux .nil tail
        simp
      | cons op rest ih =>
        intro u hval
        cases op with
        | push =>
          obtain ⟨simRest, hrest⟩ := ih (.node () .nil u) hval
          have hstep : coreRun (twAppendRightmost u (twRightChain (twCountExtInject rest)))
              [.push] (twAppendRightmost (.node () .nil u) (twRightChain (twCountExtInject rest)))
              1 0 0 :=
            ⟨rfl, rfl, rfl, fun _ => by simp [twAppendRightmost, coreCascadeCostAux, coreCascadeStepCost, execCoreOp]⟩
          refine ⟨.push :: simRest, ?_⟩
          simpa [twCountExtInject, twCountExtPush, twCountExtPop, twExtCoreCascadeCost,
            twExtCascadeStepCost, twExecExtCoreOp] using h_run_trans hstep hrest
        | pop =>
          rcases hval with ⟨hne, hval⟩
          obtain ⟨simRest, hrest⟩ := ih (popUnlabeled u) hval
          obtain ⟨happ_ne, hlsl_eq, hpop_eq⟩ := h_pop_app u (twRightChain (twCountExtInject rest)) hne
          have hstep : coreRun (twAppendRightmost u (twRightChain (twCountExtInject rest)))
              [.pop] (twAppendRightmost (popUnlabeled u) (twRightChain (twCountExtInject rest)))
              0 1 ((leftSpineLen u - 1) / 2) := by
            refine ⟨⟨happ_ne, by rw [hpop_eq]; rfl⟩, rfl, rfl, ?_⟩
            intro tail
            simp [coreCascadeCostAux, coreCascadeStepCost, execCoreOp, hlsl_eq, hpop_eq]
          refine ⟨.pop :: simRest, ?_⟩
          simpa [twCountExtInject, twCountExtPush, twCountExtPop, twExtCoreCascadeCost,
            twExtCascadeStepCost, twExecExtCoreOp] using h_run_trans hstep hrest
        | rslr d =>
          rcases hval with ⟨hd, hval⟩
          obtain ⟨simRest, hrest⟩ := ih (rotateLeftAtRightDepth u d) hval
          obtain ⟨hd_app, hrot_eq⟩ := h_rslr_app d u (twRightChain (twCountExtInject rest)) hd
          have hstep : coreRun (twAppendRightmost u (twRightChain (twCountExtInject rest)))
              [.rslr d] (twAppendRightmost (rotateLeftAtRightDepth u d)
                (twRightChain (twCountExtInject rest))) 0 0 0 := by
            refine ⟨⟨hd_app, by rw [hrot_eq]; rfl⟩, rfl, rfl, ?_⟩
            intro tail
            simp [coreCascadeCostAux, coreCascadeStepCost, execCoreOp, hrot_eq]
          refine ⟨.rslr d :: simRest, ?_⟩
          simpa [twCountExtInject, twCountExtPush, twCountExtPop, twExtCoreCascadeCost,
            twExtCascadeStepCost, twExecExtCoreOp] using h_run_trans hstep hrest
        | inject =>
          obtain ⟨simRest, hrest⟩ := ih (.node () u .nil) hval
          have hstep := h_pullUp_run u (twRightChain (twCountExtInject rest))
          refine ⟨twPullUpSeq (rightSpineLen u) ++ simRest, ?_⟩
          simpa [twCountExtInject, Nat.add_comm 1, twCountExtPush, twCountExtPop,
            twExtCoreCascadeCost, twExtCascadeStepCost, twExecExtCoreOp, twRightChain,
            twAppendRightmost] using h_run_trans hstep hrest

    intro u0 P eops hP hval
    have hcons := h_ext_conservation eops u0 hval
    set k := twCountExtInject eops
    set H0 := twAppendRightmost u0 (twRightChain k)
    have hbuild : coreRun .nil (twBuildFromEmpty H0) H0 H0.num_nodes 0 0 :=
      h_build_aux (2 * H0.num_nodes - rightSpineLen H0) H0 le_rfl
    obtain ⟨simOps, hsim⟩ := h_sim_loop eops u0 hval
    have htot := h_run_trans hbuild hsim
    rcases htot with ⟨hv_tot, hpush_tot, hpop_tot, hcost_tot⟩
    refine ⟨twBuildFromEmpty H0 ++ simOps, ⟨?_, ?_, h_steps_empty _ .nil hv_tot⟩, ?_⟩
    · have hH0_nodes : H0.num_nodes = u0.num_nodes + k := by
        dsimp (config := { failIfUnchanged := false }) [H0]; rw [h_app_nodes, h_chain_nodes]
      omega
    · omega
    · have hc := hcost_tot []
      simp only [List.append_nil, coreCascadeCostAux] at hc
      simpa [coreCascadeCost] using hc

  obtain ⟨C0, cops, hC0_n, hcops_m, hvc, hcost_eq⟩ := h_stage12 n m init ops hn hvalid
  obtain ⟨d_L, d_R, eops_L, eops_R, hd_le, hpopL, hpopR, hvL, hvR, hcost_le⟩ :=
    h_stage3 n m C0 cops hC0_n hcops_m hvc
  obtain ⟨ops_L, hcoreL, hccL⟩ := h_stage4 (twProjL C0) d_L eops_L hpopL hvL
  obtain ⟨ops_R, hcoreR, hccR⟩ := h_stage4 (twMirrorTree (twProjR C0)) d_R eops_R hpopR hvR
  refine ⟨d_L, d_R, ops_L, ops_R, hd_le, hcoreL, hcoreR, ?_⟩
  rw [hcost_eq, hccL, hccR]
  exact_mod_cast hcost_le

theorem block_and_typeB_cascade_bound (Δ' k M S : ℕ) (init : _root_.BinaryTree Unit) (seq : List RightRotOp)
    (hk : 2 ≤ k) (hM : 1 ≤ M) (hS : 1 ≤ S)
    (hnodes : init.num_nodes = M * S)
    (hvalid : ValidRightRotSeq Δ' k init seq) :
    (M = 2 ∧ k = 2 →
      countPureInterblockCascades S (labelRange 0 init) seq = 0) ∧
    ∃ b_seqs : Fin M → _root_.BinaryTree Unit × List RightRotOp,
      (∀ m : Fin M,
        (b_seqs m).1.num_nodes = S ∧
        ValidRightRotSeq Δ' k (b_seqs m).1 (b_seqs m).2) ∧
      countGappedCascades seq ≤
        (∑ m : Fin M, countGappedCascades (b_seqs m).2) +
          (Δ' + 3) * (M * S) +
          countPureInterblockCascades S (labelRange 0 init) seq :=
by
  have _ := And.intro hk hM

  have h_subLD0 : ∀ {β : Type} (t : _root_.BinaryTree β), subtreeAtLeftDepthGen t 0 = t := by
    rintro _ (_ | _) <;> rfl
  have h_appLD0 :
      ∀ {β : Type} (f : _root_.BinaryTree β → _root_.BinaryTree β) (t : _root_.BinaryTree β),
        applyAtLeftDepthGen f t 0 = f t := by
    rintro _ _ (_ | _) <;> rfl
  have h_subPos0 : ∀ {β : Type} (t : _root_.BinaryTree β), subtreeAtPosGen t [] = t := by
    rintro _ (_ | _) <;> rfl
  have h_appPos0 :
      ∀ {β : Type} (f : _root_.BinaryTree β → _root_.BinaryTree β) (t : _root_.BinaryTree β),
        applyAtPosGen f t [] = f t := by
    rintro _ _ (_ | _) <;> rfl
  have h_off0 : ∀ (a : ℕ) (t : _root_.BinaryTree ℕ), btbSubtreeOffset a t [] = a := by
    rintro _ (_ | _) <;> rfl
  have h_proj0 : ∀ (lo hi : ℕ) (t : _root_.BinaryTree ℕ), btbProjectPos lo hi t [] = [] := by
    rintro _ _ (_ | _) <;> rfl

  have h_seq_cat :
      ∀ (k0 : ℕ) (s1 s2 : List RightRotOp) (t : _root_.BinaryTree Unit),
        (ValidRightRotSeq Δ' k0 t (s1 ++ s2) ↔
          ValidRightRotSeq Δ' k0 t s1 ∧ ValidRightRotSeq Δ' k0 (execRightRotSeq t s1) s2) ∧
        execRightRotSeq t (s1 ++ s2) = execRightRotSeq (execRightRotSeq t s1) s2 ∧
        countGappedCascades (s1 ++ s2) = countGappedCascades s1 + countGappedCascades s2 := by
    intro k0 s1
    induction s1 with
    | nil =>
      intro s2 t
      simp [ValidRightRotSeq, execRightRotSeq, countGappedCascades]
    | cons op rest ih =>
      intro s2 t
      obtain ⟨h_val, h_exec, h_cnt⟩ := ih s2 (execRightRotOp t op)
      refine ⟨?_, h_exec, ?_⟩
      · simp only [List.cons_append, ValidRightRotSeq, execRightRotSeq, h_val, and_assoc]
      · cases op <;> simp only [List.cons_append, countGappedCascades, h_cnt, Nat.add_assoc]




  have h_ek_nodes : ∀ {β : Type} (t : _root_.BinaryTree β), (eraseKeys t).num_nodes = t.num_nodes := by
    intro β t
    induction t with
    | nil => rfl
    | node _ l r ihl ihr => simp only [eraseKeys, _root_.BinaryTree.num_nodes, ihl, ihr]

  have h_ek_rotR : ∀ (t : _root_.BinaryTree ℕ), eraseKeys t.rotateRight = (eraseKeys t).rotateRight := by
    rintro (_ | ⟨y, _ | ⟨x, a, b⟩, c⟩) <;> rfl

  have h_ek_subLD :
      ∀ (d : ℕ) (t : _root_.BinaryTree ℕ),
        eraseKeys (subtreeAtLeftDepthGen t d) = subtreeAtLeftDepth (eraseKeys t) d := by
    intro d
    induction d with
    | zero => rintro (_ | _) <;> rfl
    | succ d ih =>
      rintro (_ | ⟨_, l, _⟩)
      · rfl
      · exact ih l

  have h_ek_applyLD :
      ∀ (d : ℕ) (fN : _root_.BinaryTree ℕ → _root_.BinaryTree ℕ) (fU : _root_.BinaryTree Unit → _root_.BinaryTree Unit)
        (t : _root_.BinaryTree ℕ),
        (∀ s, eraseKeys (fN s) = fU (eraseKeys s)) →
        eraseKeys (applyAtLeftDepthGen fN t d) = applyAtLeftDepth fU (eraseKeys t) d := by
    intro d
    induction d with
    | zero => intro fN fU t hf; cases t <;> exact hf _
    | succ d ih =>
      rintro fN fU (_ | ⟨k0, l, r⟩) hf
      · rfl
      · simp only [applyAtLeftDepthGen, eraseKeys, applyAtLeftDepth, ih fN fU l hf]

  have h_ek_cascRoot :
      ∀ (gaps : List ℕ) (t : _root_.BinaryTree ℕ),
        eraseKeys (execGappedCascadeAtRootGen t gaps) =
          execGappedCascadeAtRoot (eraseKeys t) gaps := by
    intro gaps
    induction gaps with
    | nil => intro t; exact h_ek_rotR t
    | cons g rest ih =>
      rintro (_ | ⟨k2, _ | ⟨k1, a, b⟩, c⟩)
      · rfl
      · rfl
      · simp only [execGappedCascadeAtRootGen, eraseKeys, execGappedCascadeAtRoot]
        rw [h_ek_applyLD g (fun s => execGappedCascadeAtRootGen s rest)
          (fun s => execGappedCascadeAtRoot s rest) a ih]

  have h_ek_subPos :
      ∀ (pos : List Dir) (t : _root_.BinaryTree ℕ),
        eraseKeys (subtreeAtPosGen t pos) = subtreeAtPos (eraseKeys t) pos := by
    intro pos
    induction pos with
    | nil => rintro (_ | _) <;> rfl
    | cons dir rest ih =>
      rintro (_ | ⟨_, l, r⟩)
      · rfl
      · cases dir <;> exact ih _

  have h_ek_applyPos :
      ∀ (pos : List Dir) (fN : _root_.BinaryTree ℕ → _root_.BinaryTree ℕ)
        (fU : _root_.BinaryTree Unit → _root_.BinaryTree Unit) (t : _root_.BinaryTree ℕ),
        (∀ s, eraseKeys (fN s) = fU (eraseKeys s)) →
        eraseKeys (applyAtPosGen fN t pos) = applyAtPos fU (eraseKeys t) pos := by
    intro pos
    induction pos with
    | nil => intro fN fU t hf; cases t <;> exact hf _
    | cons dir rest ih =>
      rintro fN fU (_ | ⟨k0, l, r⟩) hf
      · rfl
      · cases dir <;> simp only [applyAtPosGen, eraseKeys, applyAtPos, ih fN fU _ hf]

  have h_ek_op :
      ∀ (t : _root_.BinaryTree ℕ) (op : RightRotOp),
        eraseKeys (execRightRotOpGen t op) = execRightRotOp (eraseKeys t) op := by
    intro t op
    cases op with
    | single pos =>
      exact h_ek_applyPos pos _root_.BinaryTree.rotateRight _root_.BinaryTree.rotateRight t h_ek_rotR
    | cascade pos gaps =>
      exact h_ek_applyPos pos (fun s => execGappedCascadeAtRootGen s gaps)
        (fun s => execGappedCascadeAtRoot s gaps) t (h_ek_cascRoot gaps)

  have h_labelRange_spec :
      ∀ (u : _root_.BinaryTree Unit) (a : ℕ),
        IsRangeBST a (labelRange a u) ∧
        (labelRange a u).num_nodes = u.num_nodes ∧
        eraseKeys (labelRange a u) = u := by
    intro u
    induction u with
    | nil => intro a; exact ⟨trivial, rfl, rfl⟩
    | node _ l r ihl ihr =>
      intro a
      obtain ⟨hb_l, hn_l, he_l⟩ := ihl a
      obtain ⟨hb_r, hn_r, he_r⟩ := ihr (a + l.num_nodes + 1)
      refine ⟨⟨?_, hb_l, hb_r⟩, ?_, ?_⟩
      · simp only [hn_l]
      · simp only [labelRange, _root_.BinaryTree.num_nodes, hn_l, hn_r]
      · simp only [labelRange, eraseKeys, he_l, he_r]

  have h_bst_rotR :
      ∀ (a : ℕ) (s : _root_.BinaryTree ℕ),
        IsRangeBST a s → IsRangeBST a s.rotateRight ∧ s.rotateRight.num_nodes = s.num_nodes := by
    intro a s hs
    rcases s with _ | ⟨y, _ | ⟨x, A, B⟩, C⟩
    · exact ⟨trivial, rfl⟩
    · exact ⟨hs, rfl⟩
    · obtain ⟨hy, ⟨hx, hA, hB⟩, hC⟩ := hs
      simp only [_root_.BinaryTree.num_nodes] at hy
      refine ⟨⟨hx, hA, ⟨?_, hB, hC⟩⟩, ?_⟩
      · omega
      · simp only [_root_.BinaryTree.rotateRight, _root_.BinaryTree.num_nodes]; omega

  have h_bst_applyLD :
      ∀ (d : ℕ) (f : _root_.BinaryTree ℕ → _root_.BinaryTree ℕ),
        (∀ a0 u, IsRangeBST a0 u → IsRangeBST a0 (f u) ∧ (f u).num_nodes = u.num_nodes) →
        ∀ (a : ℕ) (t : _root_.BinaryTree ℕ),
          IsRangeBST a t →
          IsRangeBST a (applyAtLeftDepthGen f t d) ∧
            (applyAtLeftDepthGen f t d).num_nodes = t.num_nodes := by
    intro d
    induction d with
    | zero => intro f hf a t ht; rw [h_appLD0]; exact hf a t ht
    | succ d ih =>
      intro f hf a t ht
      rcases t with _ | ⟨k0, l, r⟩
      · exact ⟨trivial, rfl⟩
      · obtain ⟨hk0, hl, hr⟩ := ht
        obtain ⟨hl', hn'⟩ := ih f hf a l hl
        refine ⟨⟨?_, hl', hr⟩, ?_⟩
        · rw [hn']; exact hk0
        · simp only [applyAtLeftDepthGen, _root_.BinaryTree.num_nodes, hn']

  have h_bst_cascRoot :
      ∀ (gaps : List ℕ) (a : ℕ) (s : _root_.BinaryTree ℕ),
        IsRangeBST a s →
        IsRangeBST a (execGappedCascadeAtRootGen s gaps) ∧
          (execGappedCascadeAtRootGen s gaps).num_nodes = s.num_nodes := by
    intro gaps
    induction gaps with
    | nil => intro a s hs; exact h_bst_rotR a s hs
    | cons g rest ih =>
      intro a s hs
      rcases s with _ | ⟨y, _ | ⟨x, A, B⟩, C⟩
      · exact ⟨trivial, rfl⟩
      · exact ⟨hs, rfl⟩
      · obtain ⟨hy, ⟨hx, hA, hB⟩, hC⟩ := hs
        obtain ⟨hA', hnA'⟩ := h_bst_applyLD g (fun u => execGappedCascadeAtRootGen u rest) ih a A hA
        simp only [_root_.BinaryTree.num_nodes] at hy
        refine ⟨⟨?_, hA', ⟨?_, hB, hC⟩⟩, ?_⟩
        · rw [hnA']; exact hx
        · omega
        · simp only [execGappedCascadeAtRootGen, _root_.BinaryTree.num_nodes, hnA']; omega

  have h_bst_applyPos :
      ∀ (pos : List Dir) (f : _root_.BinaryTree ℕ → _root_.BinaryTree ℕ),
        (∀ a0 u, IsRangeBST a0 u → IsRangeBST a0 (f u) ∧ (f u).num_nodes = u.num_nodes) →
        ∀ (a : ℕ) (t : _root_.BinaryTree ℕ),
          IsRangeBST a t →
          IsRangeBST a (applyAtPosGen f t pos) ∧
            (applyAtPosGen f t pos).num_nodes = t.num_nodes := by
    intro pos
    induction pos with
    | nil => intro f hf a t ht; rw [h_appPos0]; exact hf a t ht
    | cons dir rest ih =>
      intro f hf a t ht
      rcases t with _ | ⟨k0, l, r⟩
      · exact ⟨trivial, rfl⟩
      · obtain ⟨hk0, hl, hr⟩ := ht
        cases dir with
        | L =>
          obtain ⟨hl', hn'⟩ := ih f hf a l hl
          refine ⟨⟨?_, hl', hr⟩, ?_⟩
          · rw [hn']; exact hk0
          · simp only [applyAtPosGen, _root_.BinaryTree.num_nodes, hn']
        | R =>
          obtain ⟨hr', hn'⟩ := ih f hf (k0 + 1) r hr
          exact ⟨⟨hk0, hl, hr'⟩, by simp only [applyAtPosGen, _root_.BinaryTree.num_nodes, hn']⟩

  have h_bst_op :
      ∀ (op : RightRotOp) (a : ℕ) (t : _root_.BinaryTree ℕ),
        IsRangeBST a t →
        IsRangeBST a (execRightRotOpGen t op) ∧
          (execRightRotOpGen t op).num_nodes = t.num_nodes := by
    intro op a t ht
    cases op with
    | single pos => exact h_bst_applyPos pos _root_.BinaryTree.rotateRight h_bst_rotR a t ht
    | cascade pos gaps =>
      exact h_bst_applyPos pos (fun u => execGappedCascadeAtRootGen u gaps)
        (h_bst_cascRoot gaps) a t ht

  have h_subLD_bst :
      ∀ (d : ℕ) (a : ℕ) (t : _root_.BinaryTree ℕ),
        IsRangeBST a t →
        IsRangeBST a (subtreeAtLeftDepthGen t d) ∧
          (subtreeAtLeftDepthGen t d).num_nodes ≤ t.num_nodes := by
    intro d
    induction d with
    | zero => intro a t ht; rw [h_subLD0]; exact ⟨ht, le_rfl⟩
    | succ d ih =>
      intro a t ht
      rcases t with _ | ⟨_, l, r⟩
      · exact ⟨trivial, le_rfl⟩
      · obtain ⟨_, hl, _⟩ := ht
        obtain ⟨hl', hn'⟩ := ih a l hl
        exact ⟨hl', by simp only [subtreeAtLeftDepthGen, _root_.BinaryTree.num_nodes]; omega⟩

  have h_subPos_bst :
      ∀ (pos : List Dir) (a : ℕ) (t : _root_.BinaryTree ℕ),
        IsRangeBST a t →
        IsRangeBST (btbSubtreeOffset a t pos) (subtreeAtPosGen t pos) ∧
          a ≤ btbSubtreeOffset a t pos ∧
          btbSubtreeOffset a t pos + (subtreeAtPosGen t pos).num_nodes ≤ a + t.num_nodes := by
    intro pos
    induction pos with
    | nil => intro a t ht; rw [h_off0, h_subPos0]; exact ⟨ht, le_rfl, le_rfl⟩
    | cons dir rest ih =>
      intro a t ht
      rcases t with _ | ⟨k0, l, r⟩
      · exact ⟨trivial, le_rfl, by simp [btbSubtreeOffset, subtreeAtPosGen, _root_.BinaryTree.num_nodes]⟩
      · obtain ⟨hk0, hl, hr⟩ := ht
        cases dir with
        | L =>
          obtain ⟨hs, hlo, hhi⟩ := ih a l hl
          refine ⟨hs, hlo, ?_⟩
          simp only [btbSubtreeOffset, subtreeAtPosGen, _root_.BinaryTree.num_nodes] at hhi ⊢
          omega
        | R =>
          obtain ⟨hs, hlo, hhi⟩ := ih (k0 + 1) r hr
          refine ⟨hs, ?_, ?_⟩
          · simp only [btbSubtreeOffset] at hlo ⊢; omega
          · simp only [btbSubtreeOffset, subtreeAtPosGen, _root_.BinaryTree.num_nodes] at hhi ⊢
            omega

  have h_offset_applyPos :
      ∀ (pos : List Dir) (h : _root_.BinaryTree ℕ → _root_.BinaryTree ℕ) (a : ℕ) (t : _root_.BinaryTree ℕ),
        btbSubtreeOffset a (applyAtPosGen h t pos) pos = btbSubtreeOffset a t pos := by
    intro pos
    induction pos with
    | nil => intro h a t; rw [h_off0, h_off0]
    | cons dir rest ih =>
      rintro h a (_ | ⟨k0, l, r⟩)
      · rfl
      · cases dir <;> exact ih h _ _

  have h_offset_append :
      ∀ (pos suf : List Dir) (a : ℕ) (t : _root_.BinaryTree ℕ),
        btbSubtreeOffset a t (pos ++ suf) =
          btbSubtreeOffset (btbSubtreeOffset a t pos) (subtreeAtPosGen t pos) suf := by
    intro pos
    induction pos with
    | nil => intro suf a t; rw [List.nil_append, h_off0, h_subPos0]
    | cons dir rest ih =>
      rintro suf a (_ | ⟨k0, l, r⟩)
      · cases suf <;> rfl
      · cases dir <;> exact ih suf _ _

  have h_offset_repL :
      ∀ (n a : ℕ) (t : _root_.BinaryTree ℕ),
        btbSubtreeOffset a t (List.replicate n Dir.L) = a := by
    intro n
    induction n with
    | zero => intro a t; exact h_off0 a t
    | succ n ih =>
      rintro a (_ | ⟨_, l, _⟩)
      · rfl
      · exact ih a l

  have h_casc_keys :
      ∀ (gaps : List ℕ) (a0 : ℕ) (s : _root_.BinaryTree ℕ),
        IsRangeBST a0 s →
        validGappedCascadeAtRoot Δ' (eraseKeys s) gaps →
        2 ≤ leftSpineLen (eraseKeys s) ∧
          s ≠ .nil ∧
          a0 ≤ btbCascadeBotKey s gaps ∧
          btbCascadeBotKey s gaps ≤ btbCascadeBotKey s [] ∧
          btbCascadeBotKey s [] < btbCascadeTopKey s ∧
          btbCascadeTopKey s < a0 + s.num_nodes := by
    intro gaps
    induction gaps with
    | nil =>
      rintro a0 (_ | ⟨y, _ | ⟨x, A, B⟩, C⟩) hs hv
      · simp [eraseKeys, validGappedCascadeAtRoot, leftSpineLen] at hv
      · simp [eraseKeys, validGappedCascadeAtRoot, leftSpineLen] at hv
      · obtain ⟨hy, ⟨hx, _, _⟩, _⟩ := hs
        simp only [_root_.BinaryTree.num_nodes] at hy
        refine ⟨hv, by simp, ?_, le_rfl, ?_, ?_⟩
        · simp only [btbCascadeBotKey]; omega
        · simp only [btbCascadeBotKey, btbCascadeTopKey]; omega
        · simp only [btbCascadeTopKey, _root_.BinaryTree.num_nodes]; omega
    | cons g rest ih =>
      rintro a0 (_ | ⟨y, _ | ⟨x, A, B⟩, C⟩) hs hv
      · exact False.elim hv
      · exact False.elim hv
      · obtain ⟨_, hv_rest⟩ := hv
        rw [← h_ek_subLD g A] at hv_rest
        obtain ⟨hy, ⟨hx, hA, _⟩, _⟩ := hs
        obtain ⟨hA_sub_bst, hA_sub_n⟩ := h_subLD_bst g a0 A hA
        obtain ⟨_, _, h1, h2, h3, h4⟩ := ih a0 (subtreeAtLeftDepthGen A g) hA_sub_bst hv_rest
        simp only [_root_.BinaryTree.num_nodes] at hy
        refine ⟨by simp only [eraseKeys, leftSpineLen]; omega, by simp, h1, ?_, ?_, ?_⟩
        · simp only [btbCascadeBotKey]; omega
        · simp only [btbCascadeBotKey, btbCascadeTopKey]; omega
        · simp only [btbCascadeTopKey, _root_.BinaryTree.num_nodes]; omega

  have h_pure_2x2_false :
      ∀ (T : _root_.BinaryTree ℕ) (pos : List Dir) (gaps : List ℕ),
        IsRangeBST 0 T →
        T.num_nodes = 2 * S →
        validRightRotOp Δ' 2 (eraseKeys T) (.cascade pos gaps) →
        allPairsInterblock S (subtreeAtPosGen T pos) gaps = false := by
    intro T pos gaps hbst hT_n ⟨hlen, hv⟩
    rcases gaps with _ | ⟨g, _ | ⟨g2, _⟩⟩
    · simp at hlen
    · rw [← h_ek_subPos pos T] at hv
      obtain ⟨hs_bst, _, hs_ub⟩ := h_subPos_bst pos 0 T hbst
      rcases hs_eq : subtreeAtPosGen T pos with _ | ⟨y2, _ | ⟨x2, A, B⟩, C⟩
      · rw [hs_eq] at hv; exact False.elim hv
      · rw [hs_eq] at hv; exact False.elim hv
      · rw [hs_eq] at hv hs_bst hs_ub
        obtain ⟨_, hv1⟩ := hv
        rw [← h_ek_subLD g A] at hv1
        obtain ⟨hy2, ⟨hx2, hA, _⟩, _⟩ := hs_bst
        obtain ⟨hs1_bst, hs1_n⟩ := h_subLD_bst g (btbSubtreeOffset 0 T pos) A hA
        obtain ⟨_, _, _, _, hx1_lt_y1, hy1_ub⟩ :=
          h_casc_keys [] (btbSubtreeOffset 0 T pos) (subtreeAtLeftDepthGen A g) hs1_bst hv1
        rcases hs1_eq : subtreeAtLeftDepthGen A g with _ | ⟨y1, _ | ⟨x1, A1, B1⟩, C1⟩
        · rw [hs1_eq] at hv1; simp [eraseKeys, validGappedCascadeAtRoot, leftSpineLen] at hv1
        · rw [hs1_eq] at hv1; simp [eraseKeys, validGappedCascadeAtRoot, leftSpineLen] at hv1
        · rw [hs1_eq] at hx1_lt_y1 hy1_ub hs1_n
          simp only [btbCascadeBotKey, btbCascadeTopKey] at hx1_lt_y1 hy1_ub
          simp only [_root_.BinaryTree.num_nodes] at hy2 hs_ub
          have hy1_lt_x2 : y1 < x2 := by omega
          have hy2_lt_2S : y2 < 2 * S := by omega
          have hy1_div_le : y1 / S ≤ x2 / S := Nat.div_le_div_right (le_of_lt hy1_lt_x2)
          have hy2_div_lt : y2 / S < 2 := (Nat.div_lt_iff_lt_mul hS).mpr hy2_lt_2S
          by_contra h_not_f
          have h_tr : allPairsInterblock S
              (.node y2 (.node x2 A B) C) [g] = true := by
            cases hall : allPairsInterblock S (.node y2 (.node x2 A B) C) [g]
            · exact absurd hall h_not_f
            · rfl
          simp only [allPairsInterblock, hs1_eq, Bool.and_eq_true, decide_eq_true_eq] at h_tr
          obtain ⟨h_div2, h_div1⟩ := h_tr
          have h_nonneg : 0 ≤ x1 / S := Nat.zero_le _
          omega
    · simp at hlen




  have h_applyPos_comp :
      ∀ (pos q : List Dir) (f h : _root_.BinaryTree ℕ → _root_.BinaryTree ℕ) (W : _root_.BinaryTree ℕ),
        applyAtPosGen f (applyAtPosGen h W pos) (pos ++ q) =
          applyAtPosGen (fun u => applyAtPosGen f (h u) q) W pos := by
    intro pos
    induction pos with
    | nil => intro q f h W; rw [List.nil_append, h_appPos0, h_appPos0]
    | cons dir rest ih =>
      rintro q f h (_ | ⟨k0, l, r⟩)
      · rfl
      · cases dir <;> simp only [List.cons_append, applyAtPosGen, ih]

  have h_subPos_after_apply :
      ∀ (pos q : List Dir) (h : _root_.BinaryTree ℕ → _root_.BinaryTree ℕ) (W : _root_.BinaryTree ℕ),
        h .nil = .nil →
        subtreeAtPosGen (applyAtPosGen h W pos) (pos ++ q) =
          subtreeAtPosGen (h (subtreeAtPosGen W pos)) q := by
    intro pos
    induction pos with
    | nil => intro q h W _; rw [List.nil_append, h_appPos0, h_subPos0]
    | cons dir rest ih =>
      rintro q h (_ | ⟨k0, l, r⟩) h_emp
      · simp only [List.cons_append, applyAtPosGen, subtreeAtPosGen, h_emp]
        cases q <;> rfl
      · cases dir <;> exact ih q h _ h_emp

  have h_subPos_repL :
      ∀ (g : ℕ) (W : _root_.BinaryTree ℕ),
        subtreeAtPosGen W (List.replicate g Dir.L) = subtreeAtLeftDepthGen W g := by
    intro g
    induction g with
    | zero => intro W; simp only [List.replicate_zero, h_subPos0, h_subLD0]
    | succ g ih =>
      rintro (_ | ⟨_, l, _⟩)
      · rfl
      · exact ih l

  have h_applyPos_repL :
      ∀ (g : ℕ) (f : _root_.BinaryTree ℕ → _root_.BinaryTree ℕ) (W : _root_.BinaryTree ℕ),
        applyAtPosGen f W (List.replicate g Dir.L) = applyAtLeftDepthGen f W g := by
    intro g
    induction g with
    | zero => intro f W; simp only [List.replicate_zero, h_appPos0, h_appLD0]
    | succ g ih =>
      rintro f (_ | ⟨k0, l, r⟩)
      · rfl
      · simp only [List.replicate_succ, applyAtPosGen, applyAtLeftDepthGen, ih]

  have h_applyPos_congr :
      ∀ (pos : List Dir) (f1 f2 : _root_.BinaryTree ℕ → _root_.BinaryTree ℕ) (W : _root_.BinaryTree ℕ),
        f1 (subtreeAtPosGen W pos) = f2 (subtreeAtPosGen W pos) →
        applyAtPosGen f1 W pos = applyAtPosGen f2 W pos := by
    intro pos
    induction pos with
    | nil => intro f1 f2 W h; rw [h_subPos0] at h; rw [h_appPos0, h_appPos0]; exact h
    | cons dir rest ih =>
      rintro f1 f2 (_ | ⟨k0, l, r⟩) h
      · rfl
      · cases dir with
        | L => exact congrArg (fun x => _root_.BinaryTree.node k0 x r) (ih f1 f2 l h)
        | R => exact congrArg (_root_.BinaryTree.node k0 l) (ih f1 f2 r h)

  have h_peel_cascade :
      ∀ (T : _root_.BinaryTree ℕ) (pos : List Dir) (g : ℕ) (rest : List ℕ),
        validGappedCascadeAtRoot Δ' (eraseKeys (subtreeAtPosGen T pos)) (g :: rest) →
        let T1 := execRightRotOpGen T (.single pos)
        let pos' := pos ++ List.replicate (g + 1) Dir.L
        2 ≤ leftSpineLen (subtreeAtPos (eraseKeys T) pos) ∧
        g ≤ Δ' ∧
        subtreeAtPosGen T1 pos = (subtreeAtPosGen T pos).rotateRight ∧
        validGappedCascadeAtRoot Δ' (eraseKeys (subtreeAtPosGen T1 pos')) rest ∧
        btbCascadeBotKey (subtreeAtPosGen T pos) (g :: rest) =
          btbCascadeBotKey (subtreeAtPosGen T1 pos') rest ∧
        execRightRotOpGen T (.cascade pos (g :: rest)) =
          execRightRotOpGen T1 (.cascade pos' rest) := by
    intro T pos g rest hv
    dsimp (config := { failIfUnchanged := false }) only
    have hs_pos : subtreeAtPos (eraseKeys T) pos = eraseKeys (subtreeAtPosGen T pos) :=
      (h_ek_subPos pos T).symm
    have hT1_pos :
        subtreeAtPosGen (execRightRotOpGen T (.single pos)) pos =
          (subtreeAtPosGen T pos).rotateRight := by
      have h1 := h_subPos_after_apply pos [] _root_.BinaryTree.rotateRight T rfl
      rw [List.append_nil, h_subPos0] at h1
      exact h1
    have hT1_pos' :
        subtreeAtPosGen (execRightRotOpGen T (.single pos))
            (pos ++ List.replicate (g + 1) Dir.L) =
          subtreeAtPosGen (subtreeAtPosGen T pos).rotateRight (List.replicate (g + 1) Dir.L) :=
      h_subPos_after_apply pos (List.replicate (g + 1) Dir.L) _root_.BinaryTree.rotateRight T rfl
    rcases hs_eq : subtreeAtPosGen T pos with _ | ⟨y, _ | ⟨x, A, B⟩, C⟩
    · rw [hs_eq] at hv; exact False.elim hv
    · rw [hs_eq] at hv; exact False.elim hv
    · rw [hs_eq] at hv hT1_pos hT1_pos'
      obtain ⟨hg, hv_rest⟩ := hv
      rw [← h_ek_subLD g A] at hv_rest
      have hsub_A :
          subtreeAtPosGen (_root_.BinaryTree.node y (.node x A B) C).rotateRight
              (List.replicate (g + 1) Dir.L) =
            subtreeAtLeftDepthGen A g := by
        simp only [_root_.BinaryTree.rotateRight, List.replicate_succ, subtreeAtPosGen]
        exact h_subPos_repL g A
      rw [hsub_A] at hT1_pos'
      refine ⟨?_, hg, hT1_pos, ?_, ?_, ?_⟩
      · rw [hs_pos, hs_eq]; simp only [eraseKeys, leftSpineLen]; omega
      · rw [hT1_pos']; exact hv_rest
      · rw [hT1_pos']; rfl
      · simp only [execRightRotOpGen]
        rw [h_applyPos_comp pos (List.replicate (g + 1) Dir.L)
          (fun u => execGappedCascadeAtRootGen u rest) _root_.BinaryTree.rotateRight T]
        apply h_applyPos_congr pos _ _ T
        rw [hs_eq]
        simp only [execGappedCascadeAtRootGen, _root_.BinaryTree.rotateRight, List.replicate_succ,
          applyAtPosGen, h_applyPos_repL]




  have h_restrict_nodes_gen :
      ∀ (lo hi : ℕ), lo ≤ hi →
        ∀ (W : _root_.BinaryTree ℕ) (a : ℕ),
          IsRangeBST a W →
          (restrictInterval lo hi W).num_nodes = min hi (a + W.num_nodes) - max lo a := by
    intro lo hi hlohi W
    induction W with
    | nil =>
      intro a _
      simp only [restrictInterval, _root_.BinaryTree.num_nodes, Nat.add_zero]
      omega
    | node w l r ihl ihr =>
      intro a ⟨hw, hl, hr⟩
      have hn_l := ihl a hl
      have hn_r := ihr (w + 1) hr
      simp only [restrictInterval, _root_.BinaryTree.num_nodes]
      by_cases h1 : w < lo
      · rw [if_pos h1, hn_r]; omega
      · rw [if_neg h1]
        by_cases h2 : hi ≤ w
        · rw [if_pos h2, hn_l]; omega
        · rw [if_neg h2]
          simp only [_root_.BinaryTree.num_nodes, hn_l, hn_r]
          omega

  have h_restrict_congr_pos :
      ∀ (lo hi : ℕ) (pos : List Dir) (f : _root_.BinaryTree ℕ → _root_.BinaryTree ℕ) (W : _root_.BinaryTree ℕ),
        restrictInterval lo hi (f (subtreeAtPosGen W pos)) =
          restrictInterval lo hi (subtreeAtPosGen W pos) →
        restrictInterval lo hi (applyAtPosGen f W pos) = restrictInterval lo hi W := by
    intro lo hi pos
    induction pos with
    | nil => intro f W h; rw [h_subPos0] at h; rw [h_appPos0]; exact h
    | cons dir rest ih =>
      rintro f (_ | ⟨k0, l, r⟩) h
      · rfl
      · cases dir with
        | L =>
          have h_l := ih f l h
          simp only [applyAtPosGen, restrictInterval]
          split_ifs
          · rfl
          · exact h_l
          · rw [h_l]
        | R =>
          have h_r := ih f r h
          simp only [applyAtPosGen, restrictInterval]
          split_ifs
          · exact h_r
          · rfl
          · rw [h_r]

  have h_restrict_active_pos :
      ∀ (lo hi : ℕ), lo < hi →
        ∀ (pos : List Dir) (a : ℕ) (W : _root_.BinaryTree ℕ),
          IsRangeBST a W →
          subtreeAtPosGen W pos ≠ .nil →
          btbSubtreeOffset a W pos < hi →
          lo < btbSubtreeOffset a W pos + (subtreeAtPosGen W pos).num_nodes →
          subtreeAtPosGen (restrictInterval lo hi W) (btbProjectPos lo hi W pos) =
            restrictInterval lo hi (subtreeAtPosGen W pos) ∧
          ∀ (f g_fn : _root_.BinaryTree ℕ → _root_.BinaryTree ℕ),
            restrictInterval lo hi (f (subtreeAtPosGen W pos)) =
              g_fn (restrictInterval lo hi (subtreeAtPosGen W pos)) →
            restrictInterval lo hi (applyAtPosGen f W pos) =
              applyAtPosGen g_fn (restrictInterval lo hi W) (btbProjectPos lo hi W pos) := by
    intro lo hi hlohi pos
    induction pos with
    | nil =>
      intro a W _ _ _ _
      refine ⟨?_, ?_⟩
      · rw [h_proj0, h_subPos0, h_subPos0]
      · intro f g_fn hfg
        rw [h_subPos0] at hfg
        rw [h_proj0, h_appPos0, h_appPos0]
        exact hfg
    | cons dir rest ih =>
      rintro a (_ | ⟨k0, l, r⟩) hbst hne ha_lt hlo_lt
      · exact absurd rfl hne
      · obtain ⟨hk0, hl, hr⟩ := hbst
        cases dir with
        | L =>
          simp only [subtreeAtPosGen, btbSubtreeOffset] at hne ha_lt hlo_lt
          obtain ⟨_, _, hl_ub⟩ := h_subPos_bst rest a l hl
          have hk0_gt_lo : ¬ k0 < lo := by omega
          obtain ⟨hsub_ih, happ_ih⟩ := ih a l hl hne ha_lt hlo_lt
          simp only [restrictInterval, btbProjectPos, applyAtPosGen, subtreeAtPosGen,
            if_neg hk0_gt_lo]
          by_cases hhi_le : hi ≤ k0
          · simp only [if_pos hhi_le]
            exact ⟨hsub_ih, fun f g_fn hfg => happ_ih f g_fn hfg⟩
          · simp only [if_neg hhi_le, subtreeAtPosGen, applyAtPosGen]
            exact ⟨hsub_ih, fun f g_fn hfg =>
              congrArg (fun x => _root_.BinaryTree.node k0 x (restrictInterval lo hi r))
                (happ_ih f g_fn hfg)⟩
        | R =>
          simp only [subtreeAtPosGen, btbSubtreeOffset] at hne ha_lt hlo_lt
          obtain ⟨_, hr_lb, _⟩ := h_subPos_bst rest (k0 + 1) r hr
          have hk0_lt_hi : ¬ hi ≤ k0 := by omega
          obtain ⟨hsub_ih, happ_ih⟩ := ih (k0 + 1) r hr hne ha_lt hlo_lt
          simp only [restrictInterval, btbProjectPos, applyAtPosGen, subtreeAtPosGen,
            if_neg hk0_lt_hi]
          by_cases hk0_lt_lo : k0 < lo
          · simp only [if_pos hk0_lt_lo]
            exact ⟨hsub_ih, fun f g_fn hfg => happ_ih f g_fn hfg⟩
          · simp only [if_neg hk0_lt_lo, subtreeAtPosGen, applyAtPosGen]
            exact ⟨hsub_ih, fun f g_fn hfg =>
              congrArg (_root_.BinaryTree.node k0 (restrictInterval lo hi l))
                (happ_ih f g_fn hfg)⟩

  have h_restrict_rotR_cases :
      ∀ (lo hi : ℕ), lo < hi →
        ∀ (a0 : ℕ) (s : _root_.BinaryTree ℕ),
          IsRangeBST a0 s →
          2 ≤ leftSpineLen (eraseKeys s) →
          let u := btbCascadeBotKey s []
          let v := btbCascadeTopKey s
          (lo ≤ u ∧ v < hi →
            2 ≤ leftSpineLen (eraseKeys (restrictInterval lo hi s)) ∧
            restrictInterval lo hi s.rotateRight = (restrictInterval lo hi s).rotateRight) ∧
          (¬ (lo ≤ u ∧ v < hi) →
            restrictInterval lo hi s.rotateRight = restrictInterval lo hi s) := by
    rintro lo hi hlohi a0 (_ | ⟨v, _ | ⟨u, A, B⟩, C⟩) hs hv
    · simp [eraseKeys, leftSpineLen] at hv
    · simp [eraseKeys, leftSpineLen] at hv
    · obtain ⟨hv_eq, ⟨hu_eq, _, _⟩, _⟩ := hs
      simp only [_root_.BinaryTree.num_nodes] at hv_eq
      have huv : u < v := by omega
      dsimp (config := { failIfUnchanged := false }) only [btbCascadeBotKey, btbCascadeTopKey]
      refine ⟨?_, ?_⟩
      · rintro ⟨hlo_u, hv_hi⟩
        have h1 : ¬ v < lo := by omega
        have h2 : ¬ hi ≤ v := by omega
        have h3 : ¬ u < lo := by omega
        have h4 : ¬ hi ≤ u := by omega
        simp only [_root_.BinaryTree.rotateRight, restrictInterval,
          if_neg h1, if_neg h2, if_neg h3, if_neg h4, eraseKeys, leftSpineLen]
        exact ⟨by omega, trivial⟩
      · intro h_out
        simp only [_root_.BinaryTree.rotateRight]
        by_cases hu1 : u < lo <;> by_cases hu2 : hi ≤ u <;>
          by_cases hv1 : v < lo <;> by_cases hv2 : hi ≤ v <;>
          try omega
        all_goals simp only [restrictInterval, if_pos, if_neg, hu1, hu2, hv1, hv2, not_false_eq_true]

  have h_restrict_LD_active :
      ∀ (lo hi d : ℕ) (a0 : ℕ) (W : _root_.BinaryTree ℕ),
        IsRangeBST a0 W →
        subtreeAtLeftDepthGen W d ≠ .nil →
        lo < a0 + (subtreeAtLeftDepthGen W d).num_nodes →
        a0 + W.num_nodes ≤ hi →
        subtreeAtLeftDepthGen (restrictInterval lo hi W) d =
          restrictInterval lo hi (subtreeAtLeftDepthGen W d) ∧
        ∀ (f g_fn : _root_.BinaryTree ℕ → _root_.BinaryTree ℕ),
          restrictInterval lo hi (f (subtreeAtLeftDepthGen W d)) =
            g_fn (restrictInterval lo hi (subtreeAtLeftDepthGen W d)) →
          restrictInterval lo hi (applyAtLeftDepthGen f W d) =
            applyAtLeftDepthGen g_fn (restrictInterval lo hi W) d := by
    intro lo hi d
    induction d with
    | zero =>
      intro a0 W _ _ _ _
      refine ⟨by rw [h_subLD0, h_subLD0], ?_⟩
      intro f g_fn hfg
      rw [h_subLD0] at hfg
      rw [h_appLD0, h_appLD0]
      exact hfg
    | succ d ih =>
      rintro a0 (_ | ⟨w, l, r⟩) hbst hne hlo_lt hhi_ge
      · exact absurd rfl hne
      · obtain ⟨hw, hl, _⟩ := hbst
        simp only [subtreeAtLeftDepthGen] at hne hlo_lt
        simp only [_root_.BinaryTree.num_nodes] at hhi_ge
        obtain ⟨_, hl_sub_n⟩ := h_subLD_bst d a0 l hl
        have hw1 : ¬ w < lo := by omega
        have hw2 : ¬ hi ≤ w := by omega
        obtain ⟨hsub_ih, happ_ih⟩ := ih a0 l hl hne hlo_lt (by omega)
        simp only [restrictInterval, applyAtLeftDepthGen, subtreeAtLeftDepthGen,
          if_neg hw1, if_neg hw2]
        exact ⟨hsub_ih, fun f g_fn hfg =>
          congrArg (fun x => _root_.BinaryTree.node w x (restrictInterval lo hi r))
            (happ_ih f g_fn hfg)⟩

  have h_restrict_cascRoot_active :
      ∀ (lo hi : ℕ) (gaps : List ℕ) (a0 : ℕ) (s : _root_.BinaryTree ℕ),
        IsRangeBST a0 s →
        validGappedCascadeAtRoot Δ' (eraseKeys s) gaps →
        lo ≤ btbCascadeBotKey s gaps →
        btbCascadeTopKey s < hi →
        validGappedCascadeAtRoot Δ' (eraseKeys (restrictInterval lo hi s)) gaps ∧
        restrictInterval lo hi (execGappedCascadeAtRootGen s gaps) =
          execGappedCascadeAtRootGen (restrictInterval lo hi s) gaps := by
    intro lo hi gaps
    induction gaps with
    | nil =>
      intro a0 s hs hv hlo_b hhi_t
      obtain ⟨_, _, _, _, hbot_lt_top, _⟩ := h_casc_keys [] a0 s hs hv
      have hlohi : lo < hi := by omega
      exact (h_restrict_rotR_cases lo hi hlohi a0 s hs hv).1 ⟨hlo_b, hhi_t⟩
    | cons g rest ih =>
      rintro a0 (_ | ⟨y, _ | ⟨x, A, B⟩, C⟩) hs hv hlo_b hhi_t
      · exact False.elim hv
      · exact False.elim hv
      · obtain ⟨hg, hv_rest⟩ := hv
        rw [← h_ek_subLD g A] at hv_rest
        obtain ⟨hy, ⟨hx, hA, _⟩, _⟩ := hs
        simp only [_root_.BinaryTree.num_nodes] at hy
        obtain ⟨hA_sub_bst, hA_sub_n⟩ := h_subLD_bst g a0 A hA
        obtain ⟨_, hs_low_ne, hlow1, hlow2, hlow3, hlow4⟩ :=
          h_casc_keys rest a0 (subtreeAtLeftDepthGen A g) hA_sub_bst hv_rest
        simp only [btbCascadeBotKey] at hlo_b
        simp only [btbCascadeTopKey] at hhi_t
        obtain ⟨hv_ih, hex_ih⟩ :=
          ih a0 (subtreeAtLeftDepthGen A g) hA_sub_bst hv_rest hlo_b (by omega)
        obtain ⟨hLD_sub, hLD_app⟩ :=
          h_restrict_LD_active lo hi g a0 A hA hs_low_ne (by omega) (by omega)
        have hy1 : ¬ y < lo := by omega
        have hy2 : ¬ hi ≤ y := by omega
        have hx1 : ¬ x < lo := by omega
        have hx2 : ¬ hi ≤ x := by omega
        simp only [restrictInterval, execGappedCascadeAtRootGen,
          if_neg hy1, if_neg hy2, if_neg hx1, if_neg hx2, eraseKeys, validGappedCascadeAtRoot]
        refine ⟨⟨hg, ?_⟩, ?_⟩
        · rw [← h_ek_subLD g (restrictInterval lo hi A), hLD_sub]
          exact hv_ih
        · rw [hLD_app (fun s => execGappedCascadeAtRootGen s rest)
            (fun s => execGappedCascadeAtRootGen s rest) hex_ih]

  have h_restrict_single_sim :
      ∀ (lo hi : ℕ), lo < hi →
        ∀ (T : _root_.BinaryTree ℕ) (pos : List Dir),
          IsRangeBST 0 T →
          2 ≤ leftSpineLen (subtreeAtPos (eraseKeys T) pos) →
          ∃ b_ops : List RightRotOp,
            ValidRightRotSeq Δ' k (eraseKeys (restrictInterval lo hi T)) b_ops ∧
            execRightRotSeq (eraseKeys (restrictInterval lo hi T)) b_ops =
              eraseKeys (restrictInterval lo hi (execRightRotOpGen T (.single pos))) ∧
            countGappedCascades b_ops = 0 := by
    intro lo hi hlohi T pos hbst hop
    rw [← h_ek_subPos pos T] at hop
    obtain ⟨hs_bst, _, _⟩ := h_subPos_bst pos 0 T hbst
    obtain ⟨_, hs_ne, ha0_le_u, _, _, hv_lt_ub⟩ :=
      h_casc_keys [] (btbSubtreeOffset 0 T pos) (subtreeAtPosGen T pos) hs_bst hop
    obtain ⟨h_in_case, h_out_case⟩ :=
      h_restrict_rotR_cases lo hi hlohi (btbSubtreeOffset 0 T pos) (subtreeAtPosGen T pos) hs_bst hop
    by_cases h_in : lo ≤ btbCascadeBotKey (subtreeAtPosGen T pos) [] ∧
        btbCascadeTopKey (subtreeAtPosGen T pos) < hi
    · obtain ⟨hlsl', hrot'⟩ := h_in_case h_in
      obtain ⟨hsub_proj, happ_proj⟩ :=
        h_restrict_active_pos lo hi hlohi pos 0 T hbst hs_ne (by omega) (by omega)
      set p_proj := btbProjectPos lo hi T pos
      refine ⟨[.single p_proj], ⟨?_, trivial⟩, ?_, rfl⟩
      · simp only [validRightRotOp, ← h_ek_subPos p_proj (restrictInterval lo hi T), hsub_proj]
        exact hlsl'
      · simp only [execRightRotSeq, execRightRotOp, execRightRotOpGen]
        rw [happ_proj _root_.BinaryTree.rotateRight _root_.BinaryTree.rotateRight hrot',
          h_ek_applyPos p_proj _root_.BinaryTree.rotateRight _root_.BinaryTree.rotateRight
            (restrictInterval lo hi T) h_ek_rotR]
    · have h_noop := h_restrict_congr_pos lo hi pos _root_.BinaryTree.rotateRight T (h_out_case h_in)
      exact ⟨[], trivial, by simp only [execRightRotSeq, execRightRotOpGen, h_noop], rfl⟩

  have h_restrict_casc_intrablock :
      ∀ (lo hi : ℕ), lo < hi →
        ∀ (T : _root_.BinaryTree ℕ) (pos : List Dir) (gaps : List ℕ),
          IsRangeBST 0 T →
          validRightRotOp Δ' k (eraseKeys T) (.cascade pos gaps) →
          lo ≤ btbCascadeBotKey (subtreeAtPosGen T pos) gaps →
          btbCascadeTopKey (subtreeAtPosGen T pos) < hi →
          let b_op := RightRotOp.cascade (btbProjectPos lo hi T pos) gaps
          ValidRightRotSeq Δ' k (eraseKeys (restrictInterval lo hi T)) [b_op] ∧
          execRightRotSeq (eraseKeys (restrictInterval lo hi T)) [b_op] =
            eraseKeys (restrictInterval lo hi (execRightRotOpGen T (.cascade pos gaps))) ∧
          countGappedCascades [b_op] = 1 := by
    intro lo hi hlohi T pos gaps hbst ⟨hk_len, hv⟩ hlo_b hhi_t
    rw [← h_ek_subPos pos T] at hv
    obtain ⟨hs_bst, _, _⟩ := h_subPos_bst pos 0 T hbst
    obtain ⟨_, hs_ne, ha0_le_b, _, _, htop_lt_ub⟩ :=
      h_casc_keys gaps (btbSubtreeOffset 0 T pos) (subtreeAtPosGen T pos) hs_bst hv
    obtain ⟨hv_proj, hex_proj⟩ :=
      h_restrict_cascRoot_active lo hi gaps (btbSubtreeOffset 0 T pos)
        (subtreeAtPosGen T pos) hs_bst hv hlo_b hhi_t
    obtain ⟨hsub_proj, happ_proj⟩ :=
      h_restrict_active_pos lo hi hlohi pos 0 T hbst hs_ne (by omega) (by omega)
    let p_proj := btbProjectPos lo hi T pos
    refine ⟨⟨⟨hk_len, ?_⟩, trivial⟩, ?_, rfl⟩
    · rw [← h_ek_subPos p_proj (restrictInterval lo hi T), hsub_proj]
      exact hv_proj
    · simp only [execRightRotSeq, execRightRotOp, execRightRotOpGen]
      rw [happ_proj (fun u => execGappedCascadeAtRootGen u gaps)
          (fun u => execGappedCascadeAtRootGen u gaps) hex_proj,
        h_ek_applyPos p_proj (fun u => execGappedCascadeAtRootGen u gaps)
          (fun u => execGappedCascadeAtRoot u gaps) (restrictInterval lo hi T)
          (h_ek_cascRoot gaps)]

  have h_restrict_casc_fallback :
      ∀ (lo hi : ℕ), lo < hi →
        ∀ (gaps : List ℕ) (T : _root_.BinaryTree ℕ) (pos : List Dir),
          IsRangeBST 0 T →
          validGappedCascadeAtRoot Δ' (eraseKeys (subtreeAtPosGen T pos)) gaps →
          ∃ b_ops : List RightRotOp,
            ValidRightRotSeq Δ' k (eraseKeys (restrictInterval lo hi T)) b_ops ∧
            execRightRotSeq (eraseKeys (restrictInterval lo hi T)) b_ops =
              eraseKeys (restrictInterval lo hi (execRightRotOpGen T (.cascade pos gaps))) ∧
            countGappedCascades b_ops = 0 := by
    intro lo hi hlohi gaps
    induction gaps with
    | nil =>
      intro T pos hbst hv
      rw [h_ek_subPos pos T] at hv
      exact h_restrict_single_sim lo hi hlohi T pos hbst hv
    | cons g rest ih =>
      intro T pos hbst hv
      obtain ⟨hlsl_pos, _, _, hv_rest, _, hex_peel⟩ := h_peel_cascade T pos g rest hv
      obtain ⟨b_ops1, hv1, hex1, hc1⟩ := h_restrict_single_sim lo hi hlohi T pos hbst hlsl_pos
      have ⟨hT1_bst, _⟩ := h_bst_op (.single pos) 0 T hbst
      obtain ⟨b_ops2, hv2, hex2, hc2⟩ :=
        ih (execRightRotOpGen T (.single pos)) (pos ++ List.replicate (g + 1) Dir.L) hT1_bst hv_rest
      obtain ⟨hcat_v, hcat_ex, hcat_c⟩ :=
        h_seq_cat k b_ops1 b_ops2 (eraseKeys (restrictInterval lo hi T))
      refine ⟨b_ops1 ++ b_ops2, ?_, ?_, ?_⟩
      · rw [hcat_v, hex1]
        exact ⟨hv1, hv2⟩
      · rw [hcat_ex, hex1, hex2, ← hex_peel]
      · rw [hcat_c, hc1, hc2]




  obtain ⟨D, hD_def⟩ : ∃ D : ℕ, D = Δ' + 2 := ⟨Δ' + 2, rfl⟩

  have h_lsl_le_nodes :
      ∀ (B : _root_.BinaryTree ℕ), leftSpineLen (eraseKeys B) ≤ B.num_nodes := by
    intro B
    induction B with
    | nil => exact le_rfl
    | node _ l r ihl _ =>
      simp only [eraseKeys, leftSpineLen, _root_.BinaryTree.num_nodes]
      omega

  have h_sumTrunc_le :
      ∀ (B : _root_.BinaryTree ℕ) (ld : ℕ), btbSumTruncLD ld D B ≤ D * B.num_nodes := by
    intro B
    induction B with
    | nil => intro _; simp [btbSumTruncLD, _root_.BinaryTree.num_nodes]
    | node _ l r ihl ihr =>
      intro ld
      have hmin : min ld D ≤ D := Nat.min_le_right ld D
      have hl := ihl (ld + 1)
      have hr := ihr ld
      simp only [btbSumTruncLD, _root_.BinaryTree.num_nodes]
      nlinarith

  have h_psi_init_bound :
      ∀ (T : _root_.BinaryTree ℕ),
        IsRangeBST 0 T →
        T.num_nodes = M * S →
        btbTotalBlockPsi D M S T ≤ (D + 1) * (M * S) := by
    intro T hbst hT_n
    have h_each : ∀ m ∈ Finset.range M, btbBlockPsi D S m T ≤ (D + 1) * S := by
      intro m hm
      have hm_lt : m < M := Finset.mem_range.mp hm
      have h_mul_le : (m + 1) * S ≤ M * S := Nat.mul_le_mul_right S (by omega)
      have h_lo_le_hi : m * S ≤ (m + 1) * S := Nat.mul_le_mul_right S (by omega)
      have h_bt_n : (blockTree S m T).num_nodes = S := by
        dsimp (config := { failIfUnchanged := false }) only [blockTree]
        rw [h_restrict_nodes_gen (m * S) ((m + 1) * S) h_lo_le_hi T 0 hbst, hT_n]
        have h_step : (m + 1) * S = m * S + S := by ring
        omega
      have h1 := h_lsl_le_nodes (blockTree S m T)
      have h2 := h_sumTrunc_le (blockTree S m T) 0
      rw [h_bt_n] at h1 h2
      dsimp (config := { failIfUnchanged := false }) only [btbBlockPsi]
      nlinarith
    calc btbTotalBlockPsi D M S T
      _ ≤ (Finset.range M).card • ((D + 1) * S) :=
          Finset.sum_le_card_nsmul (Finset.range M) _ _ h_each
      _ = M * ((D + 1) * S) := by simp [smul_eq_mul]
      _ = (D + 1) * (M * S) := by ring

  have h_lsl_rotR_pos :
      ∀ (p : List Dir) (B : _root_.BinaryTree ℕ),
        2 ≤ leftSpineLen (eraseKeys (subtreeAtPosGen B p)) →
        let B' := applyAtPosGen _root_.BinaryTree.rotateRight B p
        leftSpineLen (eraseKeys B') ≤ leftSpineLen (eraseKeys B) ∧
        ((∀ d ∈ p, d = Dir.L) → leftSpineLen (eraseKeys B') + 1 = leftSpineLen (eraseKeys B)) := by
    intro p
    induction p with
    | nil =>
      rintro (_ | ⟨v0, _ | ⟨u0, A, M0⟩, R0⟩) hv
      · simp [h_subPos0, eraseKeys, leftSpineLen] at hv
      · simp [h_subPos0, eraseKeys, leftSpineLen] at hv
      · dsimp (config := { failIfUnchanged := false }) only
        rw [h_appPos0]
        simp only [_root_.BinaryTree.rotateRight, eraseKeys, leftSpineLen]
        exact ⟨by omega, fun _ => by omega⟩
    | cons dir rest ih =>
      rintro (_ | ⟨k0, l, r⟩) hv
      · simp [subtreeAtPosGen, eraseKeys, leftSpineLen] at hv
      · cases dir with
        | L =>
          obtain ⟨hle, hdrop⟩ := ih l hv
          dsimp (config := { failIfUnchanged := false }) only
          simp only [applyAtPosGen, eraseKeys, leftSpineLen]
          refine ⟨by omega, fun hall => ?_⟩
          have hall_rest : ∀ d ∈ rest, d = Dir.L :=
            fun d hd => hall d (List.mem_cons_of_mem _ hd)
          have hd' := hdrop hall_rest
          omega
        | R =>
          dsimp (config := { failIfUnchanged := false }) only
          simp only [applyAtPosGen, eraseKeys, leftSpineLen]
          refine ⟨le_rfl, fun hall => ?_⟩
          have h_abs := hall Dir.R List.mem_cons_self
          cases h_abs

  have h_sumTrunc_mono_ld :
      ∀ (A : _root_.BinaryTree ℕ) (ld : ℕ),
        btbSumTruncLD ld D A ≤ btbSumTruncLD (ld + 1) D A := by
    intro A
    induction A with
    | nil => intro _; exact le_rfl
    | node _ l r ihl ihr =>
      intro ld
      have hl := ihl (ld + 1)
      have hr := ihr ld
      simp only [btbSumTruncLD]
      omega

  have h_sumTrunc_rotR_pos :
      ∀ (p : List Dir) (B : _root_.BinaryTree ℕ) (ld : ℕ),
        2 ≤ leftSpineLen (eraseKeys (subtreeAtPosGen B p)) →
        let B' := applyAtPosGen _root_.BinaryTree.rotateRight B p
        btbSumTruncLD ld D B' ≤ btbSumTruncLD ld D B ∧
        (ld + btbCountDirL p < D → btbSumTruncLD ld D B' + 1 ≤ btbSumTruncLD ld D B) := by
    intro p
    induction p with
    | nil =>
      rintro (_ | ⟨v0, _ | ⟨u0, A, M0⟩, R0⟩) ld hv
      · simp [h_subPos0, eraseKeys, leftSpineLen] at hv
      · simp [h_subPos0, eraseKeys, leftSpineLen] at hv
      · dsimp (config := { failIfUnchanged := false }) only
        rw [h_appPos0]
        have hA_mono := h_sumTrunc_mono_ld A (ld + 1)
        simp only [_root_.BinaryTree.rotateRight, btbSumTruncLD, btbCountDirL, Nat.add_zero]
        exact ⟨by omega, fun hlt => by omega⟩
    | cons dir rest ih =>
      rintro (_ | ⟨k0, l, r⟩) ld hv
      · simp [subtreeAtPosGen, eraseKeys, leftSpineLen] at hv
      · cases dir with
        | L =>
          obtain ⟨hle, hdrop⟩ := ih l (ld + 1) hv
          dsimp (config := { failIfUnchanged := false }) only
          simp only [applyAtPosGen, btbSumTruncLD, btbCountDirL]
          refine ⟨by omega, fun hlt => ?_⟩
          have hd' := hdrop (by omega)
          omega
        | R =>
          obtain ⟨hle, hdrop⟩ := ih r ld hv
          dsimp (config := { failIfUnchanged := false }) only
          simp only [applyAtPosGen, btbSumTruncLD, btbCountDirL]
          refine ⟨by omega, fun hlt => ?_⟩
          have hd' := hdrop hlt
          omega

  have h_psi_single_props :
      ∀ (T : _root_.BinaryTree ℕ) (pos : List Dir),
        IsRangeBST 0 T →
        2 ≤ leftSpineLen (subtreeAtPos (eraseKeys T) pos) →
        let s := subtreeAtPosGen T pos
        let u := btbCascadeBotKey s []
        let v := btbCascadeTopKey s
        let T' := execRightRotOpGen T (.single pos)
        btbTotalBlockPsi D M S T' ≤ btbTotalBlockPsi D M S T ∧
        (∀ q < M,
          u / S = q → v / S = q →
          (∀ d ∈ btbProjectPos (q * S) ((q + 1) * S) T pos, d = Dir.L) →
          btbTotalBlockPsi D M S T' + 1 ≤ btbTotalBlockPsi D M S T) ∧
        (∀ q < M,
          u / S = q → v / S = q →
          btbCountDirL (btbProjectPos (q * S) ((q + 1) * S) T pos) < D →
          btbTotalBlockPsi D M S T' + 1 ≤ btbTotalBlockPsi D M S T) := by
    intro T pos hbst hop
    rw [← h_ek_subPos pos T] at hop
    obtain ⟨hs_bst, _, _⟩ := h_subPos_bst pos 0 T hbst
    obtain ⟨_, hs_ne, ha0_le_u, _, _, hv_lt_ub⟩ :=
      h_casc_keys [] (btbSubtreeOffset 0 T pos) (subtreeAtPosGen T pos) hs_bst hop
    have h_per_m :
        ∀ m : ℕ,
          let lo := m * S
          let hi := (m + 1) * S
          let p_m := btbProjectPos lo hi T pos
          let T' := execRightRotOpGen T (.single pos)
          btbBlockPsi D S m T' ≤ btbBlockPsi D S m T ∧
          (lo ≤ btbCascadeBotKey (subtreeAtPosGen T pos) [] ∧
              btbCascadeTopKey (subtreeAtPosGen T pos) < hi →
            ((∀ d ∈ p_m, d = Dir.L) → btbBlockPsi D S m T' + 1 ≤ btbBlockPsi D S m T) ∧
            (btbCountDirL p_m < D → btbBlockPsi D S m T' + 1 ≤ btbBlockPsi D S m T)) := by
      intro m
      dsimp (config := { failIfUnchanged := false }) only
      have hlohi : m * S < (m + 1) * S := by
        have : (m + 1) * S = m * S + S := by ring
        omega
      obtain ⟨h_in_c, h_out_c⟩ :=
        h_restrict_rotR_cases (m * S) ((m + 1) * S) hlohi
          (btbSubtreeOffset 0 T pos) (subtreeAtPosGen T pos) hs_bst hop
      by_cases h_in : m * S ≤ btbCascadeBotKey (subtreeAtPosGen T pos) [] ∧
          btbCascadeTopKey (subtreeAtPosGen T pos) < (m + 1) * S
      · obtain ⟨hlsl_m, hrot_m⟩ := h_in_c h_in
        obtain ⟨hsub_m, happ_m⟩ :=
          h_restrict_active_pos (m * S) ((m + 1) * S) hlohi pos 0 T hbst hs_ne
            (by omega) (by omega)
        have hbt_eq :
            blockTree S m (execRightRotOpGen T (.single pos)) =
              applyAtPosGen _root_.BinaryTree.rotateRight (blockTree S m T)
                (btbProjectPos (m * S) ((m + 1) * S) T pos) :=
          happ_m _root_.BinaryTree.rotateRight _root_.BinaryTree.rotateRight hrot_m
        have hlsl_sub :
            2 ≤ leftSpineLen (eraseKeys (subtreeAtPosGen (blockTree S m T)
              (btbProjectPos (m * S) ((m + 1) * S) T pos))) := by
          dsimp (config := { failIfUnchanged := false }) only [blockTree]
          rw [hsub_m]
          exact hlsl_m
        obtain ⟨hlsl_le, hlsl_drop⟩ :=
          h_lsl_rotR_pos (btbProjectPos (m * S) ((m + 1) * S) T pos) (blockTree S m T) hlsl_sub
        obtain ⟨hsum_le, hsum_drop⟩ :=
          h_sumTrunc_rotR_pos (btbProjectPos (m * S) ((m + 1) * S) T pos)
            (blockTree S m T) 0 hlsl_sub
        simp only [Nat.zero_add] at hsum_drop
        dsimp (config := { failIfUnchanged := false }) only [btbBlockPsi]
        rw [hbt_eq]
        refine ⟨by omega, fun _ => ⟨fun hall => ?_, fun hcnt => ?_⟩⟩
        · have hd := hlsl_drop hall; omega
        · have hd := hsum_drop hcnt; omega
      · have h_noop :
            blockTree S m (execRightRotOpGen T (.single pos)) = blockTree S m T :=
          h_restrict_congr_pos (m * S) ((m + 1) * S) pos _root_.BinaryTree.rotateRight T (h_out_c h_in)
        dsimp (config := { failIfUnchanged := false }) only [btbBlockPsi]
        rw [h_noop]
        exact ⟨le_rfl, fun hc => absurd hc h_in⟩
    dsimp (config := { failIfUnchanged := false }) only
    have h_tot_le :
        btbTotalBlockPsi D M S (execRightRotOpGen T (.single pos)) ≤
          btbTotalBlockPsi D M S T :=
      Finset.sum_le_sum (fun m _ => (h_per_m m).1)
    refine ⟨h_tot_le, ?_, ?_⟩
    · intro q hq hu_q hv_q hall
      have hq_mem : q ∈ Finset.range M := Finset.mem_range.mpr hq
      have hlo_u : q * S ≤ btbCascadeBotKey (subtreeAtPosGen T pos) [] :=
        (Nat.le_div_iff_mul_le hS).mp (by omega)
      have hv_hi : btbCascadeTopKey (subtreeAtPosGen T pos) < (q + 1) * S :=
        (Nat.div_lt_iff_lt_mul hS).mp (by omega)
      have hdrop_q := ((h_per_m q).2 ⟨hlo_u, hv_hi⟩).1 hall
      have hrest_le :
          ∑ m ∈ (Finset.range M).erase q,
              btbBlockPsi D S m (execRightRotOpGen T (.single pos)) ≤
            ∑ m ∈ (Finset.range M).erase q, btbBlockPsi D S m T :=
        Finset.sum_le_sum (fun m _ => (h_per_m m).1)
      dsimp (config := { failIfUnchanged := false }) only [btbTotalBlockPsi]
      rw [← Finset.add_sum_erase (Finset.range M) _ hq_mem,
        ← Finset.add_sum_erase (Finset.range M) (fun m => btbBlockPsi D S m T) hq_mem]
      omega
    · intro q hq hu_q hv_q hcnt
      have hq_mem : q ∈ Finset.range M := Finset.mem_range.mpr hq
      have hlo_u : q * S ≤ btbCascadeBotKey (subtreeAtPosGen T pos) [] :=
        (Nat.le_div_iff_mul_le hS).mp (by omega)
      have hv_hi : btbCascadeTopKey (subtreeAtPosGen T pos) < (q + 1) * S :=
        (Nat.div_lt_iff_lt_mul hS).mp (by omega)
      have hdrop_q := ((h_per_m q).2 ⟨hlo_u, hv_hi⟩).2 hcnt
      have hrest_le :
          ∑ m ∈ (Finset.range M).erase q,
              btbBlockPsi D S m (execRightRotOpGen T (.single pos)) ≤
            ∑ m ∈ (Finset.range M).erase q, btbBlockPsi D S m T :=
        Finset.sum_le_sum (fun m _ => (h_per_m m).1)
      dsimp (config := { failIfUnchanged := false }) only [btbTotalBlockPsi]
      rw [← Finset.add_sum_erase (Finset.range M) _ hq_mem,
        ← Finset.add_sum_erase (Finset.range M) (fun m => btbBlockPsi D S m T) hq_mem]
      omega




  have h_psi_casc_mono :
      ∀ (gaps : List ℕ) (T : _root_.BinaryTree ℕ) (pos : List Dir),
        IsRangeBST 0 T →
        validGappedCascadeAtRoot Δ' (eraseKeys (subtreeAtPosGen T pos)) gaps →
        btbTotalBlockPsi D M S (execRightRotOpGen T (.cascade pos gaps)) ≤
          btbTotalBlockPsi D M S T := by
    intro gaps
    induction gaps with
    | nil =>
      intro T pos hbst hv
      rw [h_ek_subPos pos T] at hv
      exact (h_psi_single_props T pos hbst hv).1
    | cons g rest ih =>
      intro T pos hbst hv
      obtain ⟨hlsl_pos, _, _, hv_rest, _, hex_peel⟩ := h_peel_cascade T pos g rest hv
      have h1 := (h_psi_single_props T pos hbst hlsl_pos).1
      have ⟨hT1_bst, _⟩ := h_bst_op (.single pos) 0 T hbst
      have h2 :=
        ih (execRightRotOpGen T (.single pos)) (pos ++ List.replicate (g + 1) Dir.L) hT1_bst hv_rest
      rw [hex_peel]
      exact le_trans h2 h1

  have h_proj_P1 :
      ∀ (lo hi : ℕ) (p : List Dir) (a : ℕ) (W : _root_.BinaryTree ℕ),
        IsRangeBST a W →
        subtreeAtPosGen W p ≠ .nil →
        btbSubtreeOffset a W p ≤ lo →
        ∀ d ∈ btbProjectPos lo hi W p, d = Dir.L := by
    intro lo hi p
    induction p with
    | nil =>
      intro a W _ _ _ d hd
      rw [h_proj0] at hd
      simp at hd
    | cons dir rest ih =>
      rintro a (_ | ⟨k0, l, r⟩) hbst hne ha_le d hd
      · exact absurd rfl hne
      · obtain ⟨hk0, hl, hr⟩ := hbst
        cases dir with
        | L =>
          simp only [subtreeAtPosGen, btbSubtreeOffset] at hne ha_le
          simp only [btbProjectPos] at hd
          split_ifs at hd with h1 h2
          · simp at hd
          · exact ih a l hl hne ha_le d hd
          · simp only [List.mem_cons] at hd
            rcases hd with rfl | hd_rest
            · rfl
            · exact ih a l hl hne ha_le d hd_rest
        | R =>
          simp only [subtreeAtPosGen, btbSubtreeOffset] at hne ha_le
          obtain ⟨_, hr_lb, _⟩ := h_subPos_bst rest (k0 + 1) r hr
          have hk0_lt_lo : k0 < lo := by omega
          simp only [btbProjectPos, if_pos hk0_lt_lo] at hd
          exact ih (k0 + 1) r hr hne ha_le d hd

  have h_countDirL_append :
      ∀ (xs ys : List Dir), btbCountDirL (xs ++ ys) = btbCountDirL xs + btbCountDirL ys := by
    intro xs
    induction xs with
    | nil => intro ys; simp [btbCountDirL]
    | cons d xs ih =>
      intro ys
      (cases d <;> simp only [List.cons_append, btbCountDirL, ih]); omega

  have h_countDirL_proj_le :
      ∀ (lo hi : ℕ) (suf : List Dir) (W : _root_.BinaryTree ℕ),
        btbCountDirL (btbProjectPos lo hi W suf) ≤ suf.length := by
    intro lo hi suf
    induction suf with
    | nil => intro W; rw [h_proj0]; exact le_rfl
    | cons dir rest ih =>
      rintro (_ | ⟨k0, l, r⟩)
      · simp [btbProjectPos, btbCountDirL]
      · cases dir with
        | L =>
          simp only [btbProjectPos, List.length_cons]
          split_ifs
          · simp [btbCountDirL]
          · have h1 := ih l; omega
          · simp only [btbCountDirL]; have h1 := ih l; omega
        | R =>
          simp only [btbProjectPos, List.length_cons]
          split_ifs
          · have h1 := ih r; omega
          · simp [btbCountDirL]
          · simp only [btbCountDirL]; have h1 := ih r; omega

  have h_proj_P2 :
      ∀ (lo hi : ℕ), lo < hi →
        ∀ (p suf : List Dir) (a : ℕ) (W : _root_.BinaryTree ℕ),
          IsRangeBST a W →
          subtreeAtPosGen W p ≠ .nil →
          btbSubtreeOffset a W p < hi →
          hi ≤ btbSubtreeOffset a W p + (subtreeAtPosGen W p).num_nodes →
          btbProjectPos lo hi W (p ++ suf) =
            btbProjectPos lo hi W p ++ btbProjectPos lo hi (subtreeAtPosGen W p) suf ∧
          btbCountDirL (btbProjectPos lo hi W p) = 0 := by
    intro lo hi hlohi p
    induction p with
    | nil =>
      intro suf a W _ _ _ _
      rw [List.nil_append, h_proj0, List.nil_append, h_subPos0]
      exact ⟨rfl, rfl⟩
    | cons dir rest ih =>
      rintro suf a (_ | ⟨k0, l, r⟩) hbst hne ha_lt hhi_le
      · exact absurd rfl hne
      · obtain ⟨hk0, hl, hr⟩ := hbst
        cases dir with
        | L =>
          simp only [subtreeAtPosGen, btbSubtreeOffset] at hne ha_lt hhi_le
          obtain ⟨_, _, hl_ub⟩ := h_subPos_bst rest a l hl
          have hk1 : ¬ k0 < lo := by omega
          have hk2 : hi ≤ k0 := by omega
          simp only [List.cons_append, btbProjectPos, subtreeAtPosGen, if_neg hk1, if_pos hk2]
          exact ih suf a l hl hne ha_lt hhi_le
        | R =>
          simp only [subtreeAtPosGen, btbSubtreeOffset] at hne ha_lt hhi_le
          obtain ⟨_, hr_lb, _⟩ := h_subPos_bst rest (k0 + 1) r hr
          have hk_not_hi : ¬ hi ≤ k0 := by omega
          obtain ⟨happ_ih, hcnt_ih⟩ := ih suf (k0 + 1) r hr hne ha_lt hhi_le
          simp only [List.cons_append, btbProjectPos, subtreeAtPosGen, if_neg hk_not_hi]
          by_cases hk_lt_lo : k0 < lo
          · simp only [if_pos hk_lt_lo]
            exact ⟨happ_ih, hcnt_ih⟩
          · simp only [if_neg hk_lt_lo, List.cons_append, btbCountDirL]
            exact ⟨congrArg (List.cons Dir.R) happ_ih, hcnt_ih⟩

  have h_psi_typeB_drop :
      ∀ (gaps : List ℕ) (T : _root_.BinaryTree ℕ) (pos : List Dir),
        IsRangeBST 0 T →
        T.num_nodes = M * S →
        validGappedCascadeAtRoot Δ' (eraseKeys (subtreeAtPosGen T pos)) gaps →
        btbIsTypeB S (subtreeAtPosGen T pos) gaps = true →
        btbTotalBlockPsi D M S (execRightRotOpGen T (.cascade pos gaps)) + 1 ≤
          btbTotalBlockPsi D M S T := by
    intro gaps
    induction gaps with
    | nil =>
      intro T pos _ _ hv htypeB
      rcases hs_eq : subtreeAtPosGen T pos with _ | ⟨y, _ | ⟨x, A, B⟩, C⟩
      · rw [hs_eq] at hv; simp [eraseKeys, validGappedCascadeAtRoot, leftSpineLen] at hv
      · rw [hs_eq] at hv; simp [eraseKeys, validGappedCascadeAtRoot, leftSpineLen] at hv
      · rw [hs_eq] at htypeB
        simp [btbIsTypeB, btbCascadeBotKey, btbCascadeTopKey, allPairsInterblock] at htypeB
    | cons g rest ih =>
      intro T pos hbst hT_n hv htypeB
      obtain ⟨hlsl_pos, hg_le, hT1_pos, hv_rest, hbot_eq, hex_peel⟩ :=
        h_peel_cascade T pos g rest hv
      obtain ⟨hT1_bst, hT1_n⟩ := h_bst_op (.single pos) 0 T hbst
      set T1 := execRightRotOpGen T (.single pos) with hT1_def
      set pos' := pos ++ List.replicate (g + 1) Dir.L with hpos'_def
      rw [hT_n] at hT1_n
      obtain ⟨hs_bst, _, hs_ub⟩ := h_subPos_bst pos 0 T hbst
      obtain ⟨_, hs_ne, ha0_le_bot, hbot_le_x, hx_lt_y, hy_lt_ub⟩ :=
        h_casc_keys (g :: rest) (btbSubtreeOffset 0 T pos) (subtreeAtPosGen T pos) hs_bst hv
      obtain ⟨hs'_bst, _, hs'_ub⟩ := h_subPos_bst pos' 0 T1 hT1_bst
      have hoff_T1_pos : btbSubtreeOffset 0 T1 pos = btbSubtreeOffset 0 T pos := by
        rw [hT1_def]
        exact h_offset_applyPos pos _root_.BinaryTree.rotateRight 0 T
      have hoff_T1_pos' : btbSubtreeOffset 0 T1 pos' = btbSubtreeOffset 0 T pos := by
        rw [hpos'_def, h_offset_append pos (List.replicate (g + 1) Dir.L) 0 T1,
          h_offset_repL (g + 1), hoff_T1_pos]
      rw [hoff_T1_pos'] at hs'_bst
      obtain ⟨hlsl_s', hs'_ne, _, hbot'_le_x', hx'_lt_y', hy'_lt_ub'⟩ :=
        h_casc_keys rest (btbSubtreeOffset 0 T pos) (subtreeAtPosGen T1 pos') hs'_bst hv_rest

      have hy'_lt_x : btbCascadeTopKey (subtreeAtPosGen T1 pos') <
          btbCascadeBotKey (subtreeAtPosGen T pos) [] := by
        rcases hs_eq : subtreeAtPosGen T pos with _ | ⟨y0, _ | ⟨x0, A, B⟩, C⟩
        · rw [hs_eq] at hv; exact False.elim hv
        · rw [hs_eq] at hv; exact False.elim hv
        · have hs'_A : subtreeAtPosGen T1 pos' = subtreeAtLeftDepthGen A g := by
            rw [hT1_def, hpos'_def]
            dsimp (config := { failIfUnchanged := false }) only [execRightRotOpGen]
            rw [h_subPos_after_apply pos (List.replicate (g + 1) Dir.L) _root_.BinaryTree.rotateRight T rfl,
              hs_eq]
            simp only [_root_.BinaryTree.rotateRight, List.replicate_succ, subtreeAtPosGen]
            exact h_subPos_repL g A
          rw [hs_eq] at hs_bst
          obtain ⟨_, ⟨hx_eq, hA, _⟩, _⟩ := hs_bst
          obtain ⟨_, hA_sub_n⟩ := h_subLD_bst g (btbSubtreeOffset 0 T pos) A hA
          rw [hs'_A] at hy'_lt_ub' ⊢
          simp only [btbCascadeBotKey]
          omega
      simp only [btbIsTypeB, Bool.and_eq_true, Bool.not_eq_true', decide_eq_true_eq] at htypeB
      obtain ⟨hbot_div_lt_y, hall_false⟩ := htypeB
      set x := btbCascadeBotKey (subtreeAtPosGen T pos) [] with hx_def
      set y := btbCascadeTopKey (subtreeAtPosGen T pos) with hy_def
      set x_bot := btbCascadeBotKey (subtreeAtPosGen T pos) (g :: rest) with hx_bot_def
      have hx_div_le_y : x / S ≤ y / S := Nat.div_le_div_right (le_of_lt hx_lt_y)
      have hy_lt_MS : y < M * S := by omega
      have hy_div_lt_M : y / S < M := (Nat.div_lt_iff_lt_mul hS).mpr hy_lt_MS
      by_cases hxy_eq : x / S = y / S
      ·
        set q := y / S with hq_def
        have hbot_lt_qS : x_bot < q * S := (Nat.div_lt_iff_lt_mul hS).mp hbot_div_lt_y
        have ha0_le_qS : btbSubtreeOffset 0 T pos ≤ q * S := by omega
        have hall_L := h_proj_P1 (q * S) ((q + 1) * S) pos 0 T hbst hs_ne ha0_le_qS
        have hdrop1 : btbTotalBlockPsi D M S T1 + 1 ≤ btbTotalBlockPsi D M S T :=
          (h_psi_single_props T pos hbst hlsl_pos).2.1 q hy_div_lt_M hxy_eq hq_def.symm hall_L
        have hmono2 := h_psi_casc_mono rest T1 pos' hT1_bst hv_rest
        rw [hex_peel]
        omega
      ·
        have hx_div_lt_y : x / S < y / S := by omega
        have hall'_false : allPairsInterblock S (subtreeAtPosGen T1 pos') rest = false := by
          rcases hs_eq : subtreeAtPosGen T pos with _ | ⟨y0, _ | ⟨x0, A, B⟩, C⟩
          · rw [hs_eq] at hv; exact False.elim hv
          · rw [hs_eq] at hv; exact False.elim hv
          · have hs'_A : subtreeAtPosGen T1 pos' = subtreeAtLeftDepthGen A g := by
              rw [hT1_def, hpos'_def]
              dsimp (config := { failIfUnchanged := false }) only [execRightRotOpGen]
              rw [h_subPos_after_apply pos (List.replicate (g + 1) Dir.L)
                _root_.BinaryTree.rotateRight T rfl, hs_eq]
              simp only [_root_.BinaryTree.rotateRight, List.replicate_succ, subtreeAtPosGen]
              exact h_subPos_repL g A
            have hx_eq0 : x = x0 := by rw [hx_def, hs_eq]; rfl
            have hy_eq0 : y = y0 := by rw [hy_def, hs_eq]; rfl
            rw [hx_eq0, hy_eq0] at hx_div_lt_y
            rw [hs_eq] at hall_false
            simp only [allPairsInterblock, Bool.and_eq_false_imp, decide_eq_true_eq] at hall_false
            rw [hs'_A]
            exact hall_false hx_div_lt_y
        set y' := btbCascadeTopKey (subtreeAtPosGen T1 pos') with hy'_def
        set x' := btbCascadeBotKey (subtreeAtPosGen T1 pos') [] with hx'_def
        have hbot_lt_y' : x_bot < y' := by omega
        have hbot_div_le_y' : x_bot / S ≤ y' / S := Nat.div_le_div_right (le_of_lt hbot_lt_y')
        by_cases hbot_lt_div_y' : x_bot / S < y' / S
        ·
          have htypeB' : btbIsTypeB S (subtreeAtPosGen T1 pos') rest = true := by
            unfold btbIsTypeB
            rw [← hbot_eq, ← hy'_def, hall'_false]
            simp only [Bool.not_false, Bool.and_true, decide_eq_true_eq]
            exact hbot_lt_div_y'
          have hdrop2 := ih T1 pos' hT1_bst hT1_n hv_rest htypeB'
          have hmono1 : btbTotalBlockPsi D M S T1 ≤ btbTotalBlockPsi D M S T :=
            (h_psi_single_props T pos hbst hlsl_pos).1
          rw [hex_peel]
          omega
        ·
          have hbot_eq_div_y' : x_bot / S = y' / S := by omega
          set q := y' / S with hq_def
          have hy'_div_le_x : q ≤ x / S := Nat.div_le_div_right (le_of_lt hy'_lt_x)
          have hq_lt_y_div : q < y / S := by omega
          have hq_lt_M : q < M := by omega
          have hx_bot_le_x' : x_bot ≤ x' := by omega
          have hx'_div_le : q ≤ x' / S := by
            rw [← hbot_eq_div_y']
            exact Nat.div_le_div_right hx_bot_le_x'
          have hx'_div_ge : x' / S ≤ q := Nat.div_le_div_right (le_of_lt hx'_lt_y')
          have hx'_div_eq : x' / S = q := by omega
          have hlohi_q : q * S < (q + 1) * S := by
            have : (q + 1) * S = q * S + S := by ring
            omega
          have hx_bot_lt_hi : x_bot < (q + 1) * S :=
            (Nat.div_lt_iff_lt_mul hS).mp (by omega)
          have ha0_lt_hi : btbSubtreeOffset 0 T1 pos < (q + 1) * S := by
            rw [hoff_T1_pos]
            omega
          have hhi_le_y : (q + 1) * S ≤ y :=
            (Nat.le_div_iff_mul_le hS).mp (by omega)
          obtain ⟨_, hs_rot_n⟩ := h_bst_rotR (btbSubtreeOffset 0 T pos) (subtreeAtPosGen T pos) hs_bst
          have hs1_ne : subtreeAtPosGen T1 pos ≠ .nil := by
            rw [hT1_pos]
            intro hemp
            rw [hemp] at hs_rot_n
            simp only [_root_.BinaryTree.num_nodes] at hs_rot_n
            omega
          have hhi_le_s1 :
              (q + 1) * S ≤ btbSubtreeOffset 0 T1 pos + (subtreeAtPosGen T1 pos).num_nodes := by
            rw [hoff_T1_pos, hT1_pos, hs_rot_n]
            omega
          obtain ⟨hP2_app, hP2_zero⟩ :=
            h_proj_P2 (q * S) ((q + 1) * S) hlohi_q pos (List.replicate (g + 1) Dir.L)
              0 T1 hT1_bst hs1_ne ha0_lt_hi hhi_le_s1
          have hcnt_pos' : btbCountDirL (btbProjectPos (q * S) ((q + 1) * S) T1 pos') < D := by
            rw [hpos'_def, hP2_app, h_countDirL_append, hP2_zero, Nat.zero_add]
            have hle_len :=
              h_countDirL_proj_le (q * S) ((q + 1) * S) (List.replicate (g + 1) Dir.L)
                (subtreeAtPosGen T1 pos)
            rw [List.length_replicate] at hle_len
            omega
          have hlsl_pos' : 2 ≤ leftSpineLen (subtreeAtPos (eraseKeys T1) pos') := by
            rw [← h_ek_subPos pos' T1]
            exact hlsl_s'
          have hmono1 : btbTotalBlockPsi D M S T1 ≤ btbTotalBlockPsi D M S T :=
            (h_psi_single_props T pos hbst hlsl_pos).1
          have hdrop_T2 :=
            (h_psi_single_props T1 pos' hT1_bst hlsl_pos').2.2 q hq_lt_M hx'_div_eq hq_def.symm hcnt_pos'
          set T2 := execRightRotOpGen T1 (.single pos') with hT2_def
          have hdrop_T2' : btbTotalBlockPsi D M S T2 + 1 ≤ btbTotalBlockPsi D M S T1 := hdrop_T2
          have hmono_after_T2 :
              btbTotalBlockPsi D M S (execRightRotOpGen T1 (.cascade pos' rest)) ≤
                btbTotalBlockPsi D M S T2 := by
            rcases rest with _ | ⟨g2, rest2⟩
            · exact le_rfl
            · obtain ⟨_, _, _, hv_rest2, _, hex_peel2⟩ := h_peel_cascade T1 pos' g2 rest2 hv_rest
              obtain ⟨hT2_bst, _⟩ := h_bst_op (.single pos') 0 T1 hT1_bst
              rw [hex_peel2]
              exact h_psi_casc_mono rest2 T2 (pos' ++ List.replicate (g2 + 1) Dir.L) hT2_bst hv_rest2
          rw [hex_peel]
          omega




  set T0 := labelRange 0 init with hT0_def
  obtain ⟨hT0_bst, hT0_n, hT0_ek⟩ := h_labelRange_spec init 0
  rw [← hT0_def] at hT0_bst hT0_n hT0_ek
  rw [hnodes] at hT0_n
  have hvalid_T0 : ValidRightRotSeq Δ' k (eraseKeys T0) seq := by
    rw [hT0_ek]; exact hvalid


  have h_part_a :
      M = 2 ∧ k = 2 → countPureInterblockCascades S T0 seq = 0 := by
    rintro ⟨hM2, hk2⟩
    have h_ind_a :
        ∀ (ops : List RightRotOp) (T : _root_.BinaryTree ℕ),
          IsRangeBST 0 T →
          T.num_nodes = 2 * S →
          ValidRightRotSeq Δ' 2 (eraseKeys T) ops →
          countPureInterblockCascades S T ops = 0 := by
      intro ops
      induction ops with
      | nil => intro _ _ _ _; rfl
      | cons op rest ih =>
        intro T hbst hn ⟨hop, hrest⟩
        obtain ⟨hT'_bst, hT'_n⟩ := h_bst_op op 0 T hbst
        rw [hn] at hT'_n
        rw [← h_ek_op T op] at hrest
        have h_ih := ih (execRightRotOpGen T op) hT'_bst hT'_n hrest
        cases op with
        | single pos =>
          simp only [countPureInterblockCascades, h_ih]
        | cascade pos gaps =>
          have hfalse := h_pure_2x2_false T pos gaps hbst hn hop
          simp only [countPureInterblockCascades, hfalse, Bool.false_eq_true, ↓reduceIte,
            Nat.zero_add, h_ih]
    have hT0_2S : T0.num_nodes = 2 * S := by rw [hT0_n, hM2]
    have hv2 : ValidRightRotSeq Δ' 2 (eraseKeys T0) seq := by rw [← hk2]; exact hvalid_T0
    exact h_ind_a seq T0 hT0_bst hT0_2S hv2


  have h_per_block_seq :
      ∀ (m : Fin M),
        ∃ b_seq : List RightRotOp,
          (eraseKeys (blockTree S m.val T0)).num_nodes = S ∧
          ValidRightRotSeq Δ' k (eraseKeys (blockTree S m.val T0)) b_seq ∧
          countGappedCascades b_seq = btbCountIntrablock S m.val T0 seq := by
    intro m
    let lo := m.val * S
    let hi := (m.val + 1) * S
    have hlohi : lo < hi := by
      dsimp (config := { failIfUnchanged := false }) only [lo, hi]
      have : (m.val + 1) * S = m.val * S + S := by ring
      omega
    have hhi_le : hi ≤ M * S := Nat.mul_le_mul_right S (by omega)
    have h_bt0_n : (eraseKeys (blockTree S m.val T0)).num_nodes = S := by
      rw [h_ek_nodes]
      dsimp (config := { failIfUnchanged := false }) only [blockTree]
      rw [h_restrict_nodes_gen lo hi (le_of_lt hlohi) T0 0 hT0_bst, hT0_n]
      dsimp (config := { failIfUnchanged := false }) only [lo, hi]
      have : (m.val + 1) * S = m.val * S + S := by ring
      omega
    have h_ind_blk :
        ∀ (ops : List RightRotOp) (T : _root_.BinaryTree ℕ),
          IsRangeBST 0 T →
          ValidRightRotSeq Δ' k (eraseKeys T) ops →
          ∃ b_seq : List RightRotOp,
            ValidRightRotSeq Δ' k (eraseKeys (blockTree S m.val T)) b_seq ∧
            countGappedCascades b_seq = btbCountIntrablock S m.val T ops := by
      intro ops
      induction ops with
      | nil =>
        intro T _ _
        exact ⟨[], trivial, rfl⟩
      | cons op rest ih =>
        intro T hbst ⟨hop, hrest⟩
        obtain ⟨hT'_bst, _⟩ := h_bst_op op 0 T hbst
        rw [← h_ek_op T op] at hrest
        obtain ⟨b_rest, hv_rest, hc_rest⟩ := ih (execRightRotOpGen T op) hT'_bst hrest
        cases op with
        | single pos =>
          obtain ⟨b_ops, hv_op, hex_op, hc_op⟩ :=
            h_restrict_single_sim lo hi hlohi T pos hbst hop
          obtain ⟨hcat_v, _, hcat_c⟩ :=
            h_seq_cat k b_ops b_rest (eraseKeys (blockTree S m.val T))
          refine ⟨b_ops ++ b_rest, ?_, ?_⟩
          · dsimp (config := { failIfUnchanged := false }) only [blockTree] at hcat_v hv_rest ⊢
            rw [hcat_v, hex_op]
            exact ⟨hv_op, hv_rest⟩
          · simp only [btbCountIntrablock, hcat_c, hc_op, Nat.zero_add, hc_rest]
        | cascade pos gaps =>
          cases h_intra : btbIsIntrablock S m.val (subtreeAtPosGen T pos) gaps with
          | true =>
            have h_intra' := h_intra
            simp only [btbIsIntrablock, decide_eq_true_eq] at h_intra'
            have hlo_b : lo ≤ btbCascadeBotKey (subtreeAtPosGen T pos) gaps :=
              (Nat.le_div_iff_mul_le hS).mp (by omega)
            have hhi_t : btbCascadeTopKey (subtreeAtPosGen T pos) < hi :=
              (Nat.div_lt_iff_lt_mul hS).mp (by omega)
            obtain ⟨hv_op, hex_op, hc_op⟩ :=
              h_restrict_casc_intrablock lo hi hlohi T pos gaps hbst hop hlo_b hhi_t
            set b_op := RightRotOp.cascade (btbProjectPos lo hi T pos) gaps
            obtain ⟨hcat_v, _, hcat_c⟩ :=
              h_seq_cat k [b_op] b_rest (eraseKeys (blockTree S m.val T))
            refine ⟨[b_op] ++ b_rest, ?_, ?_⟩
            · dsimp (config := { failIfUnchanged := false }) only [blockTree] at hcat_v hv_rest ⊢
              rw [hcat_v, hex_op]
              exact ⟨hv_op, hv_rest⟩
            · simp only [btbCountIntrablock, h_intra, ↓reduceIte, hcat_c, hc_op, hc_rest]
          | false =>
            have hv_casc := hop.2
            rw [← h_ek_subPos pos T] at hv_casc
            obtain ⟨b_ops, hv_op, hex_op, hc_op⟩ :=
              h_restrict_casc_fallback lo hi hlohi gaps T pos hbst hv_casc
            obtain ⟨hcat_v, _, hcat_c⟩ :=
              h_seq_cat k b_ops b_rest (eraseKeys (blockTree S m.val T))
            refine ⟨b_ops ++ b_rest, ?_, ?_⟩
            · dsimp (config := { failIfUnchanged := false }) only [blockTree] at hcat_v hv_rest ⊢
              rw [hcat_v, hex_op]
              exact ⟨hv_op, hv_rest⟩
            · simp only [btbCountIntrablock, h_intra, Bool.false_eq_true, ↓reduceIte,
                hcat_c, hc_op, Nat.zero_add, hc_rest]
    obtain ⟨b_seq, hv_b, hc_b⟩ := h_ind_blk seq T0 hT0_bst hvalid_T0
    exact ⟨b_seq, h_bt0_n, hv_b, hc_b⟩


  have h_typeB_seq_bound :
      ∀ (ops : List RightRotOp) (T : _root_.BinaryTree ℕ),
        IsRangeBST 0 T →
        T.num_nodes = M * S →
        ValidRightRotSeq Δ' k (eraseKeys T) ops →
        btbCountTypeB S T ops ≤ btbTotalBlockPsi D M S T := by
    intro ops
    induction ops with
    | nil =>
      intro T _ _ _
      exact Nat.zero_le _
    | cons op rest ih =>
      intro T hbst hn ⟨hop, hrest⟩
      obtain ⟨hT'_bst, hT'_n⟩ := h_bst_op op 0 T hbst
      rw [hn] at hT'_n
      rw [← h_ek_op T op] at hrest
      have h_ih := ih (execRightRotOpGen T op) hT'_bst hT'_n hrest
      cases op with
      | single pos =>
        have hmono := (h_psi_single_props T pos hbst hop).1
        simp only [btbCountTypeB]
        omega
      | cascade pos gaps =>
        have hv_casc := hop.2
        rw [← h_ek_subPos pos T] at hv_casc
        cases htb : btbIsTypeB S (subtreeAtPosGen T pos) gaps with
        | true =>
          have hdrop := h_psi_typeB_drop gaps T pos hbst hn hv_casc htb
          simp only [btbCountTypeB, htb, ↓reduceIte]
          omega
        | false =>
          have hmono := h_psi_casc_mono gaps T pos hbst hv_casc
          simp only [btbCountTypeB, htb, Bool.false_eq_true, ↓reduceIte]
          omega


  have h_three_way_sum :
      ∀ (ops : List RightRotOp) (T : _root_.BinaryTree ℕ),
        IsRangeBST 0 T →
        T.num_nodes = M * S →
        ValidRightRotSeq Δ' k (eraseKeys T) ops →
        countGappedCascades ops ≤
          (∑ m : Fin M, btbCountIntrablock S m.val T ops) +
            btbCountTypeB S T ops +
            countPureInterblockCascades S T ops := by
    intro ops
    induction ops with
    | nil =>
      intro T _ _ _
      simp [countGappedCascades, btbCountIntrablock, btbCountTypeB, countPureInterblockCascades]
    | cons op rest ih =>
      intro T hbst hn ⟨hop, hrest⟩
      obtain ⟨hT'_bst, hT'_n⟩ := h_bst_op op 0 T hbst
      rw [hn] at hT'_n
      rw [← h_ek_op T op] at hrest
      have h_ih := ih (execRightRotOpGen T op) hT'_bst hT'_n hrest
      cases op with
      | single pos =>
        simpa [countGappedCascades, btbCountIntrablock, btbCountTypeB,
          countPureInterblockCascades] using h_ih
      | cascade pos gaps =>
        obtain ⟨_, hv_casc⟩ := hop
        rw [← h_ek_subPos pos T] at hv_casc
        obtain ⟨hs_bst, _, hs_ub⟩ := h_subPos_bst pos 0 T hbst
        obtain ⟨_, _, _, hbot_le_x, hx_lt_y, hy_lt_ub⟩ :=
          h_casc_keys gaps (btbSubtreeOffset 0 T pos) (subtreeAtPosGen T pos) hs_bst hv_casc
        let s := subtreeAtPosGen T pos
        let x_bot := btbCascadeBotKey s gaps
        let y_top := btbCascadeTopKey s
        have hbot_lt_top : x_bot < y_top := by dsimp (config := { failIfUnchanged := false }) only [x_bot, y_top, s]; omega
        have hy_lt_MS : y_top < M * S := by dsimp (config := { failIfUnchanged := false }) only [y_top, s]; omega
        have hy_div_lt_M : y_top / S < M := (Nat.div_lt_iff_lt_mul hS).mpr hy_lt_MS
        have hdiv_le : x_bot / S ≤ y_top / S := Nat.div_le_div_right (le_of_lt hbot_lt_top)
        let step_intra : Fin M → ℕ :=
          fun m => if btbIsIntrablock S m.val s gaps then 1 else 0
        have hsum_split :
            (∑ m : Fin M, btbCountIntrablock S m.val T (.cascade pos gaps :: rest)) =
              (∑ m : Fin M, step_intra m) +
                (∑ m : Fin M, btbCountIntrablock S m.val
                  (execRightRotOpGen T (.cascade pos gaps)) rest) := by
          simp only [btbCountIntrablock, step_intra, s]
          exact Finset.sum_add_distrib
        simp only [countGappedCascades, btbCountTypeB, countPureInterblockCascades]
        rw [hsum_split]
        by_cases h_same : x_bot / S = y_top / S
        · let m0 : Fin M := ⟨y_top / S, hy_div_lt_M⟩
          have hm0_val : step_intra m0 = 1 := by
            dsimp (config := { failIfUnchanged := false }) only [step_intra, m0]
            have h_tr : btbIsIntrablock S (y_top / S) s gaps = true := by
              simp only [btbIsIntrablock, decide_eq_true_eq]
              exact ⟨h_same, rfl⟩
            rw [h_tr]
            rfl
          have h1_le_sum : 1 ≤ ∑ m : Fin M, step_intra m := by
            rw [← hm0_val]
            exact Finset.single_le_sum (fun _ _ => Nat.zero_le _) (Finset.mem_univ m0)
          omega
        · have h_diff : x_bot / S < y_top / S := by omega
          cases hpure : allPairsInterblock S (subtreeAtPosGen T pos) gaps with
          | true =>
            simp only [↓reduceIte]
            omega
          | false =>
            have htb : btbIsTypeB S (subtreeAtPosGen T pos) gaps = true := by
              simp only [btbIsTypeB, hpure, Bool.not_false, Bool.and_true, decide_eq_true_eq]
              exact h_diff
            simp only [htb, ↓reduceIte]
            omega

  let b_seqs : Fin M → _root_.BinaryTree Unit × List RightRotOp :=
    fun m => (eraseKeys (blockTree S m.val T0), (h_per_block_seq m).choose)
  refine ⟨h_part_a, b_seqs, ?_, ?_⟩
  · intro m
    obtain ⟨hn_m, hv_m, _⟩ := (h_per_block_seq m).choose_spec
    exact ⟨hn_m, hv_m⟩
  · have h_sum_eq :
        (∑ m : Fin M, countGappedCascades (b_seqs m).2) =
          (∑ m : Fin M, btbCountIntrablock S m.val T0 seq) := by
      refine Finset.sum_congr rfl (fun m _ => ?_)
      exact (h_per_block_seq m).choose_spec.2.2
    have h_tb_le : btbCountTypeB S T0 seq ≤ (Δ' + 3) * (M * S) := by
      have h1 := h_typeB_seq_bound seq T0 hT0_bst hT0_n hvalid_T0
      have h2 := h_psi_init_bound T0 hT0_bst hT0_n
      have hD3 : D + 1 = Δ' + 3 := by omega
      rw [hD3] at h2
      exact le_trans h1 h2
    have h_tot := h_three_way_sum seq T0 hT0_bst hT0_n hvalid_T0
    rw [h_sum_eq]
    omega

theorem preorder_global_single_dominance (Δ' M S : ℕ) (T : _root_.BinaryTree ℕ)
    (hM : 1 ≤ M) (hS : Δ' + 2 ≤ S)
    (hbst : IsRangeBST 0 T) (hnodes : T.num_nodes = M * S) :
    (globalTree (Δ' + 2) S T).num_nodes = (Δ' + 2) * M ∧
    ∀ (k : ℕ) (op : RightRotOp),
      validRightRotOp Δ' k (eraseKeys T) op →
      IsRangeBST 0 (execRightRotOpGen T op) ∧
      (execRightRotOpGen T op).num_nodes = M * S ∧
      List.Forall₂ (· ≤ ·)
        (rightReachList 0 (globalTree (Δ' + 2) S T))
        (rightReachList 0 (globalTree (Δ' + 2) S (execRightRotOpGen T op))) :=
by
  have _ : 1 ≤ M := hM

  have h_nodup_take : ∀ {β : Type} (d : ℕ) (xs : List β), xs.Nodup → (xs.take d).Nodup := by
    intro β d xs h
    exact (List.nodup_append.mp (by rw [List.take_append_drop]; exact h)).1

  have h_nodup_filter : ∀ {β : Type} (p : β → Bool) (xs : List β), xs.Nodup → (xs.filter p).Nodup := by
    intro β p xs
    induction xs with
    | nil =>
      intro _
      exact List.nodup_nil
    | cons x xs ih =>
      intro h
      rw [List.nodup_cons] at h
      simp only [List.filter_cons]
      cases p x with
      | false => exact ih h.2
      | true =>
        simp only [↓reduceIte, List.nodup_cons]
        refine ⟨?_, ih h.2⟩
        intro hm
        rw [List.mem_filter] at hm
        exact h.1 hm.1

  have h_nodup_range' : ∀ (a n : ℕ), (List.range' a n).Nodup := by
    intro a n
    induction n generalizing a with
    | zero => exact List.nodup_nil
    | succ n ih =>
      change (a :: List.range' (a + 1) n).Nodup
      rw [List.nodup_cons]
      refine ⟨?_, ih (a + 1)⟩
      intro hm
      rw [List.mem_range'] at hm
      rcases hm with ⟨i, _, hi⟩
      omega

  have h_mem_range'_iff : ∀ {a n x : ℕ}, x ∈ List.range' a n ↔ a ≤ x ∧ x < a + n := by
    intro a n x
    rw [List.mem_range']
    constructor
    · rintro ⟨i, hi, rfl⟩
      omega
    · rintro ⟨h1, h2⟩
      exact ⟨x - a, by omega, by omega⟩

  have h_range_add : ∀ (a m : ℕ), List.range (a + m) = List.range a ++ List.range' a m := by
    intro a m
    rw [List.range_eq_range', List.range_eq_range', ← @List.range'_append 0 a m 1]
    simp

  have h_cnt_add :
      ∀ (p : ℕ → Bool) (a m : ℕ),
        pgsdCountGlobalLt p (a + m) = pgsdCountGlobalLt p a + ((List.range' a m).filter p).length := by
    intro p a m
    simp only [pgsdCountGlobalLt, h_range_add, List.filter_append, List.length_append]

  have h_div_eq_iff : ∀ {S0 x m : ℕ}, 0 < S0 → (m * S0 ≤ x ∧ x < (m + 1) * S0 ↔ x / S0 = m) := by
    intro S0 x m hS_pos
    have hmod := Nat.div_add_mod x S0
    rw [Nat.mul_comm S0 (x / S0)] at hmod
    have hlt := Nat.mod_lt x hS_pos
    have h_lo_self : (x / S0) * S0 ≤ x := by omega
    have h_hi_self : x < (x / S0 + 1) * S0 := by
      have hmul : (x / S0 + 1) * S0 = (x / S0) * S0 + S0 := by ring
      omega
    constructor
    · rintro ⟨hlo, hhi⟩
      by_contra hne
      rcases Nat.lt_or_gt_of_ne hne with hlt_m | hgt_m
      · have h1 : (x / S0 + 1) * S0 ≤ m * S0 := Nat.mul_le_mul_right S0 (by omega)
        omega
      · have h1 : (m + 1) * S0 ≤ (x / S0) * S0 := Nat.mul_le_mul_right S0 (by omega)
        omega
    · rintro rfl
      exact ⟨h_lo_self, h_hi_self⟩

  have h_nodes_eq_zero : ∀ {β : Type} (t : _root_.BinaryTree β), t.num_nodes = 0 ↔ t = .nil := by
    intro β t
    cases t <;> simp [_root_.BinaryTree.num_nodes]

  have h_ek_nodes : ∀ {β : Type} (t : _root_.BinaryTree β), (eraseKeys t).num_nodes = t.num_nodes := by
    intro β t
    induction t with
    | nil => rfl
    | node _ l r ihl ihr =>
      simp only [eraseKeys, _root_.BinaryTree.num_nodes, ihl, ihr]

  have h_pre_len : ∀ {β : Type} (t : _root_.BinaryTree β), (preorderList t).length = t.num_nodes := by
    intro β t
    induction t with
    | nil => rfl
    | node _ l r ihl ihr =>
      simp only [preorderList, List.length_cons, List.length_append, ihl, ihr, _root_.BinaryTree.num_nodes]
      omega

  have h_bst_pre_mem :
      ∀ (t : _root_.BinaryTree ℕ) (a x : ℕ),
        IsRangeBST a t → (x ∈ preorderList t ↔ a ≤ x ∧ x < a + t.num_nodes) := by
    intro t
    induction t with
    | nil =>
      intro a x _
      simp only [preorderList, List.not_mem_nil, _root_.BinaryTree.num_nodes, false_iff]
      omega
    | node k l r ihl ihr =>
      intro a x ⟨hk, hl, hr⟩
      simp only [preorderList, List.mem_cons, List.mem_append, ihl a x hl, ihr (k + 1) x hr,
        _root_.BinaryTree.num_nodes]
      omega

  have h_bst_pre_nodup :
      ∀ (t : _root_.BinaryTree ℕ) (a : ℕ), IsRangeBST a t → (preorderList t).Nodup := by
    intro t
    induction t with
    | nil =>
      intro _ _
      exact List.nodup_nil
    | node k l r ihl ihr =>
      intro a ⟨hk, hl, hr⟩
      simp only [preorderList]
      rw [List.nodup_cons, List.nodup_append]
      refine ⟨?_, ihl a hl, ihr (k + 1) hr, ?_⟩
      · intro hm
        rw [List.mem_append, h_bst_pre_mem l a k hl, h_bst_pre_mem r (k + 1) k hr] at hm
        omega
      · intro x hx y hy hxy
        rw [h_bst_pre_mem l a x hl] at hx
        rw [h_bst_pre_mem r (k + 1) y hr] at hy
        omega

  have h_restrict_bst :
      ∀ (t : _root_.BinaryTree ℕ) (a lo hi : ℕ),
        lo ≤ hi →
        IsRangeBST a t →
        IsRangeBST (max a lo) (restrictInterval lo hi t) ∧
        (restrictInterval lo hi t).num_nodes = min hi (a + t.num_nodes) - max a lo := by
    intro t
    induction t with
    | nil =>
      intro a lo hi _ _
      simp only [restrictInterval, IsRangeBST, _root_.BinaryTree.num_nodes]
      refine ⟨trivial, ?_⟩
      omega
    | node k l r ihl ihr =>
      intro a lo hi hlohi ⟨hk, hl, hr⟩
      simp only [restrictInterval]
      split_ifs with h1 h2
      · obtain ⟨hr_bst, hr_n⟩ := ihr (k + 1) lo hi hlohi hr
        have hmax : max (k + 1) lo = max a lo := by omega
        have hend : k + 1 + r.num_nodes = a + (_root_.BinaryTree.node k l r).num_nodes := by
          simp only [_root_.BinaryTree.num_nodes]
          omega
        rw [hmax] at hr_bst hr_n
        rw [hend] at hr_n
        exact ⟨hr_bst, hr_n⟩
      · obtain ⟨hl_bst, hl_n⟩ := ihl a lo hi hlohi hl
        have hmin : min hi (a + l.num_nodes) = min hi (a + (_root_.BinaryTree.node k l r).num_nodes) := by
          simp only [_root_.BinaryTree.num_nodes]
          omega
        rw [hmin] at hl_n
        exact ⟨hl_bst, hl_n⟩
      · obtain ⟨hl_bst, hl_n⟩ := ihl a lo hi hlohi hl
        obtain ⟨hr_bst, hr_n⟩ := ihr (k + 1) lo hi hlohi hr
        have hmax_r : max (k + 1) lo = k + 1 := by omega
        rw [hmax_r] at hr_bst hr_n
        refine ⟨⟨?_, hl_bst, hr_bst⟩, ?_⟩
        · omega
        · simp only [_root_.BinaryTree.num_nodes] at hl_n hr_n ⊢
          omega

  have h_extract_nonempty :
      ∀ (p : ℕ → Bool) (t : _root_.BinaryTree ℕ),
        extractGlobalTree p t ≠ .nil → ∃ x ∈ preorderList t, p x = true := by
    intro p t
    induction t with
    | nil =>
      intro h
      exact absurd rfl h
    | node k l r ihl ihr =>
      intro hne
      simp only [extractGlobalTree] at hne
      cases hpk : p k with
      | true =>
        exact ⟨k, by simp [preorderList], hpk⟩
      | false =>
        rw [hpk] at hne
        simp only [Bool.false_eq_true, ↓reduceIte] at hne
        cases hlG : extractGlobalTree p l with
        | nil =>
          rw [hlG] at hne
          obtain ⟨z, hz, hpz⟩ := ihr hne
          exact ⟨z, by simp [preorderList, hz], hpz⟩
        | node lk ll lr =>
          obtain ⟨y, hy, hpy⟩ := ihl (by simp [hlG])
          exact ⟨y, by simp [preorderList, hy], hpy⟩


  have h_s1 :
      ∀ (D M0 S0 : ℕ) (U : _root_.BinaryTree ℕ),
        1 ≤ D → D ≤ S0 → IsRangeBST 0 U → U.num_nodes = M0 * S0 →
        (globalTree D S0 U).num_nodes = D * M0 ∧
        (rightReachList 0 (globalTree D S0 U)).map (· + 1) =
          ((List.range (M0 * S0)).filter (isGlobalKey D S0 U)).map
            (fun x => pgsdCountGlobalLt (isGlobalKey D S0 U) (pgsdMaxSubtreeKey U x + 1)) := by
    intro D M0 S0 U hD hS0 hU_bst hU_nodes
    have hS_pos : 0 < S0 := by omega
    let isG := isGlobalKey D S0 U

    have h_blk_cnt : ∀ m < M0, ((List.range' (m * S0) S0).filter isG).length = D := by
      intro m hm
      have hhi_le : (m + 1) * S0 ≤ M0 * S0 := Nat.mul_le_mul_right S0 (by omega)
      have hlohi : m * S0 ≤ (m + 1) * S0 := Nat.mul_le_mul_right S0 (by omega)
      obtain ⟨hbt_bst, hbt_n⟩ := h_restrict_bst U 0 (m * S0) ((m + 1) * S0) hlohi hU_bst
      have hmax0 : max 0 (m * S0) = m * S0 := by omega
      have hmin0 : min ((m + 1) * S0) (0 + U.num_nodes) = (m + 1) * S0 := by omega
      rw [hmax0] at hbt_bst hbt_n
      rw [hmin0] at hbt_n
      change IsRangeBST (m * S0) (blockTree S0 m U) at hbt_bst
      change (blockTree S0 m U).num_nodes = (m + 1) * S0 - m * S0 at hbt_n
      have hbt_nodes : (blockTree S0 m U).num_nodes = S0 := by
        have : (m + 1) * S0 = m * S0 + S0 := by ring
        omega
      let Lm := (preorderList (blockTree S0 m U)).take D
      have hLm_len : Lm.length = D := by
        simp only [Lm, List.length_take, h_pre_len, hbt_nodes]
        omega
      have hLm_nodup : Lm.Nodup :=
        h_nodup_take D _ (h_bst_pre_nodup (blockTree S0 m U) (m * S0) hbt_bst)
      have hflt_nodup : ((List.range' (m * S0) S0).filter isG).Nodup :=
        h_nodup_filter isG _ (h_nodup_range' (m * S0) S0)
      have hperm : ((List.range' (m * S0) S0).filter isG).Perm Lm := by
        rw [List.perm_ext_iff_of_nodup hflt_nodup hLm_nodup]
        intro x
        rw [List.mem_filter, h_mem_range'_iff]
        have hms : m * S0 + S0 = (m + 1) * S0 := by ring
        constructor
        · rintro ⟨⟨hx1, hx2⟩, hxG⟩
          have hdiv : x / S0 = m := (h_div_eq_iff hS_pos).mp ⟨hx1, by omega⟩
          dsimp (config := { failIfUnchanged := false }) only [isG, isGlobalKey] at hxG
          rw [hdiv, decide_eq_true_eq] at hxG
          exact hxG
        · intro hxLm
          have hx_pre : x ∈ preorderList (blockTree S0 m U) := List.mem_of_mem_take hxLm
          rw [h_bst_pre_mem (blockTree S0 m U) (m * S0) x hbt_bst, hbt_nodes] at hx_pre
          have hdiv : x / S0 = m := (h_div_eq_iff hS_pos).mp ⟨hx_pre.1, by omega⟩
          refine ⟨hx_pre, ?_⟩
          dsimp (config := { failIfUnchanged := false }) only [isG, isGlobalKey]
          rw [hdiv, decide_eq_true_eq]
          exact hxLm
      rw [hperm.length_eq, hLm_len]

    have h_tot_cnt : ∀ c ≤ M0, ((List.range (c * S0)).filter isG).length = D * c := by
      intro c
      induction c with
      | zero =>
        intro _
        simp
      | succ c ih =>
        intro hc
        have hcs : (c + 1) * S0 = c * S0 + S0 := by ring
        rw [hcs, h_range_add, List.filter_append, List.length_append,
          ih (by omega), h_blk_cnt c (by omega)]
        ring

    have h_nonsplit_sub :
        ∀ (t : _root_.BinaryTree ℕ) (a : ℕ),
          IsRangeBST a t →
          (∀ lo hi, a ≤ lo → hi ≤ a + t.num_nodes → lo < hi →
            restrictInterval lo hi U = restrictInterval lo hi t) →
          (∀ lo hi, lo ≤ hi → ∃ pfx sfx,
            preorderList (restrictInterval lo hi U) =
              pfx ++ preorderList (restrictInterval lo hi t) ++ sfx) →
          pgsdNonSplitting isG t := by
      intro t
      induction t with
      | nil =>
        intro _ _ _ _
        exact trivial
      | node k l r ihl ihr =>
        intro a ⟨hk, hl, hr⟩ hP1 hP2
        have hP1_l : ∀ lo hi, a ≤ lo → hi ≤ a + l.num_nodes → lo < hi →
            restrictInterval lo hi U = restrictInterval lo hi l := by
          intro lo hi hlo hhi hlt
          have h1 := hP1 lo hi hlo (by simp [_root_.BinaryTree.num_nodes]; omega) hlt
          rw [h1]
          simp only [restrictInterval]
          have hn1 : ¬ k < lo := by omega
          have hn2 : hi ≤ k := by omega
          simp [hn1, hn2]
        have hP1_r : ∀ lo hi, k + 1 ≤ lo → hi ≤ k + 1 + r.num_nodes → lo < hi →
            restrictInterval lo hi U = restrictInterval lo hi r := by
          intro lo hi hlo hhi hlt
          have h1 := hP1 lo hi (by omega) (by simp [_root_.BinaryTree.num_nodes]; omega) hlt
          rw [h1]
          simp only [restrictInterval]
          have hn1 : k < lo := by omega
          simp [hn1]
        have hP2_l : ∀ lo hi, lo ≤ hi → ∃ pfx sfx,
            preorderList (restrictInterval lo hi U) =
              pfx ++ preorderList (restrictInterval lo hi l) ++ sfx := by
          intro lo hi hlohi
          obtain ⟨pfx, sfx, hpfx⟩ := hP2 lo hi hlohi
          simp only [restrictInterval] at hpfx
          split_ifs at hpfx with h1 h2
          · have hl_emp : restrictInterval lo hi l = .nil := by
              obtain ⟨_, hn⟩ := h_restrict_bst l a lo hi hlohi hl
              exact (h_nodes_eq_zero _).mp (by omega)
            rw [hl_emp]
            exact ⟨preorderList (restrictInterval lo hi U), [], by simp [preorderList]⟩
          · exact ⟨pfx, sfx, hpfx⟩
          · simp only [preorderList] at hpfx
            refine ⟨pfx ++ [k], preorderList (restrictInterval lo hi r) ++ sfx, ?_⟩
            simpa [List.append_assoc] using hpfx
        have hP2_r : ∀ lo hi, lo ≤ hi → ∃ pfx sfx,
            preorderList (restrictInterval lo hi U) =
              pfx ++ preorderList (restrictInterval lo hi r) ++ sfx := by
          intro lo hi hlohi
          obtain ⟨pfx, sfx, hpfx⟩ := hP2 lo hi hlohi
          simp only [restrictInterval] at hpfx
          split_ifs at hpfx with h1 h2
          · exact ⟨pfx, sfx, hpfx⟩
          · have hr_emp : restrictInterval lo hi r = .nil := by
              obtain ⟨_, hn⟩ := h_restrict_bst r (k + 1) lo hi hlohi hr
              exact (h_nodes_eq_zero _).mp (by omega)
            rw [hr_emp]
            exact ⟨preorderList (restrictInterval lo hi U), [], by simp [preorderList]⟩
          · simp only [preorderList] at hpfx
            refine ⟨pfx ++ [k] ++ preorderList (restrictInterval lo hi l), sfx, ?_⟩
            simpa [List.append_assoc] using hpfx
        refine ⟨ihl a hl hP1_l hP2_l, ihr (k + 1) hr hP1_r hP2_r, ?_⟩
        intro hl_ne hr_ne
        obtain ⟨y, hy_mem, hyG⟩ := h_extract_nonempty isG l hl_ne
        obtain ⟨z, hz_mem, hzG⟩ := h_extract_nonempty isG r hr_ne
        rw [h_bst_pre_mem l a y hl] at hy_mem
        rw [h_bst_pre_mem r (k + 1) z hr] at hz_mem
        let m := k / S0
        let lo := m * S0
        let hi := (m + 1) * S0
        have hk_int : lo ≤ k ∧ k < hi := (h_div_eq_iff hS_pos).mpr rfl
        have hlohi : lo ≤ hi := by omega
        have ht_int : restrictInterval lo hi (.node k l r) =
            .node k (restrictInterval lo hi l) (restrictInterval lo hi r) := by
          simp only [restrictInterval]
          have hn1 : ¬ k < lo := by omega
          have hn2 : ¬ hi ≤ k := by omega
          simp [hn1, hn2]
        by_cases h_in : lo ≤ y ∨ z < hi
        · obtain ⟨pfx, sfx, hpfx⟩ := hP2 lo hi hlohi
          rw [ht_int] at hpfx
          simp only [preorderList] at hpfx
          obtain ⟨hbtU_bst, _⟩ := h_restrict_bst U 0 lo hi hlohi hU_bst
          have hbtU_nodup : (preorderList (restrictInterval lo hi U)).Nodup :=
            h_bst_pre_nodup _ _ hbtU_bst
          have h_witness :
              ∃ w ∈ preorderList (restrictInterval lo hi l) ++ preorderList (restrictInterval lo hi r),
                w ∈ (preorderList (restrictInterval lo hi U)).take D := by
            rcases h_in with hy_lo | hz_hi
            · refine ⟨y, ?_, ?_⟩
              · rw [List.mem_append]
                left
                obtain ⟨hl'_bst, hl'_n⟩ := h_restrict_bst l a lo hi hlohi hl
                rw [h_bst_pre_mem _ _ y hl'_bst, hl'_n]
                omega
              · have hy_div : y / S0 = m := (h_div_eq_iff hS_pos).mp ⟨hy_lo, by omega⟩
                dsimp (config := { failIfUnchanged := false }) only [isG, isGlobalKey] at hyG
                rw [hy_div, decide_eq_true_eq] at hyG
                exact hyG
            · refine ⟨z, ?_, ?_⟩
              · rw [List.mem_append]
                right
                obtain ⟨hr'_bst, hr'_n⟩ := h_restrict_bst r (k + 1) lo hi hlohi hr
                rw [h_bst_pre_mem _ _ z hr'_bst, hr'_n]
                omega
              · have hz_div : z / S0 = m := (h_div_eq_iff hS_pos).mp ⟨by omega, hz_hi⟩
                dsimp (config := { failIfUnchanged := false }) only [isG, isGlobalKey] at hzG
                rw [hz_div, decide_eq_true_eq] at hzG
                exact hzG
          rcases h_witness with ⟨w, hw_mid, hw_take⟩
          have hpfx_lt : pfx.length < D := by
            by_contra hD_le
            have hD_le' : D ≤ pfx.length := by omega
            rw [hpfx, List.append_assoc, List.take_append_of_le_length hD_le'] at hw_take
            have hw_pfx : w ∈ pfx := List.mem_of_mem_take hw_take
            rw [hpfx, List.append_assoc, List.nodup_append] at hbtU_nodup
            exact hbtU_nodup.2.2 w hw_pfx w
              (List.mem_append_left sfx (List.mem_cons_of_mem k hw_mid)) rfl
          dsimp (config := { failIfUnchanged := false }) only [isG, isGlobalKey]
          change decide (k ∈ (preorderList (restrictInterval lo hi U)).take D) = true
          rw [decide_eq_true_eq, hpfx, List.append_assoc, List.take_append]
          rw [List.take_of_length_le (by omega)]
          have hd_pos : ∃ d, D - pfx.length = d + 1 := ⟨D - pfx.length - 1, by omega⟩
          rcases hd_pos with ⟨d, hd⟩
          rw [hd]
          simp
        · have h1 : restrictInterval lo hi U = restrictInterval lo hi (.node k l r) :=
            hP1 lo hi (by omega) (by simp [_root_.BinaryTree.num_nodes]; omega) (by omega)
          dsimp (config := { failIfUnchanged := false }) only [isG, isGlobalKey]
          change decide (k ∈ (preorderList (restrictInterval lo hi U)).take D) = true
          rw [decide_eq_true_eq, h1, ht_int]
          rcases Nat.exists_eq_succ_of_ne_zero (by omega : D ≠ 0) with ⟨d, rfl⟩
          simp [preorderList]

    have hU_ns : pgsdNonSplitting isG U :=
      h_nonsplit_sub U 0 hU_bst (fun _ _ _ _ _ => rfl)
        (fun lo hi _ => ⟨[], [], by simp⟩)

    have h_ind_s1 :
        ∀ (t : _root_.BinaryTree ℕ) (a : ℕ),
          IsRangeBST a t →
          pgsdNonSplitting isG t →
          (extractGlobalTree isG t).num_nodes = ((List.range' a t.num_nodes).filter isG).length ∧
          (rightReachList (pgsdCountGlobalLt isG a) (eraseKeys (extractGlobalTree isG t))).map (· + 1) =
            ((List.range' a t.num_nodes).filter isG).map
              (fun x => pgsdCountGlobalLt isG (pgsdMaxSubtreeKey t x + 1)) := by
      intro t
      induction t with
      | nil =>
        intro a _ _
        simp [extractGlobalTree, eraseKeys, rightReachList, _root_.BinaryTree.num_nodes]
      | node k l r ihl ihr =>
        intro a ⟨hk, hl, hr⟩ ⟨hns_l, hns_r, hns_k⟩
        obtain ⟨ihl_n, ihl_rr⟩ := ihl a hl hns_l
        obtain ⟨ihr_n, ihr_rr⟩ := ihr (k + 1) hr hns_r
        have h_rng_split :
            List.range' a (_root_.BinaryTree.node k l r).num_nodes =
              List.range' a l.num_nodes ++ [k] ++ List.range' (k + 1) r.num_nodes := by
          have h1 : (_root_.BinaryTree.node k l r).num_nodes = l.num_nodes + (1 + r.num_nodes) := by
            simp only [_root_.BinaryTree.num_nodes]
            omega
          rw [h1, ← @List.range'_append a l.num_nodes (1 + r.num_nodes) 1]
          have h2 : a + 1 * l.num_nodes = k := by omega
          rw [h2]
          have h3 : List.range' k (1 + r.num_nodes) = [k] ++ List.range' (k + 1) r.num_nodes := by
            rw [Nat.add_comm 1 r.num_nodes]
            rfl
          rw [h3, List.append_assoc]
        have h_map_l :
            ((List.range' a l.num_nodes).filter isG).map
              (fun x => pgsdCountGlobalLt isG (pgsdMaxSubtreeKey (.node k l r) x + 1)) =
            ((List.range' a l.num_nodes).filter isG).map
              (fun x => pgsdCountGlobalLt isG (pgsdMaxSubtreeKey l x + 1)) := by
          apply List.map_congr_left
          intro x hx
          rw [List.mem_filter, h_mem_range'_iff] at hx
          have hxk : x < k := by omega
          simp [pgsdMaxSubtreeKey, hxk]
        have h_map_r :
            ((List.range' (k + 1) r.num_nodes).filter isG).map
              (fun x => pgsdCountGlobalLt isG (pgsdMaxSubtreeKey (.node k l r) x + 1)) =
            ((List.range' (k + 1) r.num_nodes).filter isG).map
              (fun x => pgsdCountGlobalLt isG (pgsdMaxSubtreeKey r x + 1)) := by
          apply List.map_congr_left
          intro x hx
          rw [List.mem_filter, h_mem_range'_iff] at hx
          have hxk1 : ¬ x < k := by omega
          have hxk2 : x ≠ k := by omega
          simp [pgsdMaxSubtreeKey, hxk1, hxk2]
        cases hgk : isG k with
        | true =>
          have h_ext_true :
              extractGlobalTree isG (.node k l r) =
                .node k (extractGlobalTree isG l) (extractGlobalTree isG r) := by
            simp [extractGlobalTree, hgk]
          rw [h_ext_true]
          refine ⟨?_, ?_⟩
          · rw [h_rng_split]
            simp only [List.filter_append, List.filter_cons, hgk, ↓reduceIte, List.filter_nil,
              List.length_append, List.length_singleton, _root_.BinaryTree.num_nodes, ihl_n, ihr_n]
            omega
          · rw [h_rng_split]
            simp only [eraseKeys, rightReachList, List.map_append, List.map_cons, List.map_nil,
              List.filter_append, List.filter_cons, hgk, ↓reduceIte, List.filter_nil]
            rw [h_map_l, h_map_r, ← ihl_rr]
            have hxG_eq :
                pgsdCountGlobalLt isG a + (eraseKeys (extractGlobalTree isG l)).num_nodes =
                  pgsdCountGlobalLt isG k := by
              rw [h_ek_nodes, ihl_n, ← h_cnt_add isG a l.num_nodes, ← hk]
            have hck1 : pgsdCountGlobalLt isG (k + 1) = pgsdCountGlobalLt isG k + 1 := by
              rw [h_cnt_add isG k 1]
              simp [List.range', hgk]
            rw [hxG_eq]
            have hxG_succ : pgsdCountGlobalLt isG k + 1 = pgsdCountGlobalLt isG (k + 1) := hck1.symm
            have hmid_eq :
                pgsdCountGlobalLt isG k + (eraseKeys (extractGlobalTree isG r)).num_nodes + 1 =
                  pgsdCountGlobalLt isG (pgsdMaxSubtreeKey (.node k l r) k + 1) := by
              have hmsk_k : pgsdMaxSubtreeKey (.node k l r) k = k + r.num_nodes := by
                simp [pgsdMaxSubtreeKey]
              rw [hmsk_k, h_ek_nodes, ihr_n]
              have h1 := h_cnt_add isG (k + 1) r.num_nodes
              have h2 : k + 1 + r.num_nodes = k + r.num_nodes + 1 := by omega
              rw [h2] at h1
              omega
            rw [hmid_eq, hxG_succ, ihr_rr]
        | false =>
          have h_ext_false :
              extractGlobalTree isG (.node k l r) =
                if extractGlobalTree isG l = .nil then extractGlobalTree isG r
                else extractGlobalTree isG l := by
            simp only [extractGlobalTree, hgk, Bool.false_eq_true, ↓reduceIte]
            cases extractGlobalTree isG l <;> rfl
          rw [h_ext_false]
          by_cases hlG : extractGlobalTree isG l = .nil
          · simp only [hlG, ↓reduceIte]
            have hl_flt_nil : (List.range' a l.num_nodes).filter isG = [] := by
              rw [← List.length_eq_zero_iff, ← ihl_n, hlG, _root_.BinaryTree.num_nodes]
            have hca_eq : pgsdCountGlobalLt isG a = pgsdCountGlobalLt isG (k + 1) := by
              have h1 := h_cnt_add isG a l.num_nodes
              rw [hl_flt_nil, List.length_nil, Nat.add_zero, ← hk] at h1
              have h2 := h_cnt_add isG k 1
              simp only [List.range', List.filter_cons, hgk, Bool.false_eq_true, ↓reduceIte,
                List.filter_nil, List.length_nil, Nat.add_zero] at h2
              omega
            refine ⟨?_, ?_⟩
            · rw [h_rng_split]
              simp [hl_flt_nil, hgk, ihr_n]
            · rw [h_rng_split]
              simp only [List.filter_append, hl_flt_nil, List.filter_cons, hgk, Bool.false_eq_true,
                ↓reduceIte, List.filter_nil, List.nil_append, h_map_r]
              rw [hca_eq, ihr_rr]
          · simp only [hlG, ↓reduceIte]
            have hrG : extractGlobalTree isG r = .nil := by
              by_contra hr_ne
              have := hns_k hlG hr_ne
              rw [hgk] at this
              exact Bool.noConfusion this
            have hr_flt_nil : (List.range' (k + 1) r.num_nodes).filter isG = [] := by
              rw [← List.length_eq_zero_iff, ← ihr_n, hrG, _root_.BinaryTree.num_nodes]
            refine ⟨?_, ?_⟩
            · rw [h_rng_split]
              simp [hr_flt_nil, hgk, ihl_n]
            · rw [h_rng_split]
              simp only [List.filter_append, hr_flt_nil, List.filter_cons, hgk, Bool.false_eq_true,
                ↓reduceIte, List.filter_nil, List.append_nil, h_map_l]
              exact ihl_rr

    obtain ⟨h0_n, h0_rr⟩ := h_ind_s1 U 0 hU_bst hU_ns
    have hc0 : pgsdCountGlobalLt isG 0 = 0 := rfl
    rw [hU_nodes, ← List.range_eq_range'] at h0_n h0_rr
    rw [hc0] at h0_rr
    refine ⟨?_, h0_rr⟩
    dsimp (config := { failIfUnchanged := false }) only [globalTree]
    rw [h_ek_nodes, h0_n]
    exact h_tot_cnt M0 le_rfl


  have h_rotR_bst :
      ∀ (s : _root_.BinaryTree ℕ) (a : ℕ),
        IsRangeBST a s → IsRangeBST a s.rotateRight ∧ s.rotateRight.num_nodes = s.num_nodes := by
    rintro (_ | ⟨v, _ | ⟨u, A, B⟩, C⟩) a hs
    · exact ⟨trivial, rfl⟩
    · exact ⟨hs, rfl⟩
    · rcases hs with ⟨hv, ⟨hu, hA, hB⟩, hC⟩
      simp only [_root_.BinaryTree.rotateRight, IsRangeBST, _root_.BinaryTree.num_nodes] at hv ⊢
      refine ⟨⟨hu, hA, ⟨by omega, hB, hC⟩⟩, by omega⟩

  have h_applyPos_rotR_bst :
      ∀ (pos : List Dir) (U : _root_.BinaryTree ℕ) (a : ℕ),
        IsRangeBST a U →
        IsRangeBST a (applyAtPosGen _root_.BinaryTree.rotateRight U pos) ∧
        (applyAtPosGen _root_.BinaryTree.rotateRight U pos).num_nodes = U.num_nodes := by
    intro pos
    induction pos with
    | nil =>
      intro U a hU
      cases U <;> exact h_rotR_bst _ a hU
    | cons dir rest ih =>
      intro U a hU
      rcases U with _ | ⟨k, l, r⟩
      · exact ⟨trivial, rfl⟩
      · rcases hU with ⟨hk, hl, hr⟩
        cases dir with
        | L =>
          obtain ⟨hl', hln⟩ := ih l a hl
          simp only [applyAtPosGen, IsRangeBST, _root_.BinaryTree.num_nodes, hln]
          exact ⟨⟨hk, hl', hr⟩, trivial⟩
        | R =>
          obtain ⟨hr', hrn⟩ := ih r (k + 1) hr
          simp only [applyAtPosGen, IsRangeBST, _root_.BinaryTree.num_nodes, hrn]
          exact ⟨⟨hk, hl, hr'⟩, trivial⟩

  have h_ek_subPos :
      ∀ (pos : List Dir) (U : _root_.BinaryTree ℕ),
        eraseKeys (subtreeAtPosGen U pos) = subtreeAtPos (eraseKeys U) pos := by
    intro pos
    induction pos with
    | nil => intro U; cases U <;> rfl
    | cons dir rest ih =>
      rintro (_ | ⟨k, l, r⟩)
      · rfl
      · cases dir <;> exact ih _

  have h_ek_subLD :
      ∀ (g : ℕ) (s : _root_.BinaryTree ℕ),
        eraseKeys (subtreeAtLeftDepthGen s g) = subtreeAtLeftDepth (eraseKeys s) g := by
    intro g
    induction g with
    | zero => intro s; cases s <;> rfl
    | succ g ih =>
      rintro (_ | ⟨k, l, r⟩)
      · rfl
      · exact ih l

  have h_applyPos_comp :
      ∀ (p1 p2 : List Dir) (f1 f2 : _root_.BinaryTree ℕ → _root_.BinaryTree ℕ) (U : _root_.BinaryTree ℕ),
        applyAtPosGen f2 (applyAtPosGen f1 U p1) (p1 ++ p2) =
          applyAtPosGen (fun s => applyAtPosGen f2 (f1 s) p2) U p1 := by
    intro p1
    induction p1 with
    | nil =>
      intro p2 f1 f2 U
      cases U <;> rfl
    | cons dir rest ih =>
      intro p2 f1 f2 U
      rcases U with _ | ⟨k, l, r⟩
      · rfl
      · cases dir <;> simp only [List.cons_append, applyAtPosGen, ih]

  have h_subPos_applyPos :
      ∀ (p1 p2 : List Dir) (f1 : _root_.BinaryTree ℕ → _root_.BinaryTree ℕ) (U : _root_.BinaryTree ℕ),
        subtreeAtPosGen U p1 ≠ .nil →
        subtreeAtPosGen (applyAtPosGen f1 U p1) (p1 ++ p2) =
          subtreeAtPosGen (f1 (subtreeAtPosGen U p1)) p2 := by
    intro p1
    induction p1 with
    | nil =>
      intro p2 f1 U _
      cases U <;> rfl
    | cons dir rest ih =>
      intro p2 f1 U hne
      rcases U with _ | ⟨k, l, r⟩
      · exact absurd rfl hne
      · cases dir <;> exact ih p2 f1 _ hne

  have h_repL_spec :
      ∀ (g : ℕ) (fn : _root_.BinaryTree ℕ → _root_.BinaryTree ℕ) (a : _root_.BinaryTree ℕ),
        subtreeAtPosGen a (List.replicate g Dir.L) = subtreeAtLeftDepthGen a g ∧
        applyAtPosGen fn a (List.replicate g Dir.L) = applyAtLeftDepthGen fn a g := by
    intro g
    induction g with
    | zero =>
      intro fn a
      cases a <;> exact ⟨rfl, rfl⟩
    | succ g ih =>
      intro fn a
      rcases a with _ | ⟨k, l, r⟩
      · exact ⟨rfl, rfl⟩
      · obtain ⟨ih1, ih2⟩ := ih fn l
        exact ⟨ih1, congrArg (fun x => _root_.BinaryTree.node k x r) ih2⟩

  have h_applyPos_congr :
      ∀ (pos : List Dir) (f1 f2 : _root_.BinaryTree ℕ → _root_.BinaryTree ℕ) (U : _root_.BinaryTree ℕ),
        f1 (subtreeAtPosGen U pos) = f2 (subtreeAtPosGen U pos) →
        applyAtPosGen f1 U pos = applyAtPosGen f2 U pos := by
    intro pos
    induction pos with
    | nil =>
      intro f1 f2 U h
      cases U <;> exact h
    | cons dir rest ih =>
      intro f1 f2 U h
      rcases U with _ | ⟨k, l, r⟩
      · rfl
      · cases dir with
        | L => exact congrArg (fun x => _root_.BinaryTree.node k x r) (ih f1 f2 l h)
        | R => exact congrArg (_root_.BinaryTree.node k l) (ih f1 f2 r h)

  have h_s2 :
      ∀ (N : ℕ) (Rel : _root_.BinaryTree ℕ → _root_.BinaryTree ℕ → Prop),
        (∀ U, Rel U U) →
        (∀ U1 U2 U3, Rel U1 U2 → Rel U2 U3 → Rel U1 U3) →
        (∀ (U : _root_.BinaryTree ℕ) (pos : List Dir),
          IsRangeBST 0 U → U.num_nodes = N →
          2 ≤ leftSpineLen (subtreeAtPos (eraseKeys U) pos) →
          Rel U (applyAtPosGen _root_.BinaryTree.rotateRight U pos)) →
        ∀ (U : _root_.BinaryTree ℕ), IsRangeBST 0 U → U.num_nodes = N →
        ∀ (k : ℕ) (op : RightRotOp),
          validRightRotOp Δ' k (eraseKeys U) op →
          IsRangeBST 0 (execRightRotOpGen U op) ∧
          (execRightRotOpGen U op).num_nodes = N ∧
          Rel U (execRightRotOpGen U op) := by
    intro N Rel hrefl htrans hstep U hU_bst hU_n k op hop
    cases op with
    | single pos =>
      obtain ⟨hbst', hn'⟩ := h_applyPos_rotR_bst pos U 0 hU_bst
      rw [hU_n] at hn'
      exact ⟨hbst', hn', hstep U pos hU_bst hU_n hop⟩
    | cascade pos gaps =>
      have h_casc :
          ∀ (gs : List ℕ) (W : _root_.BinaryTree ℕ) (p : List Dir),
            IsRangeBST 0 W →
            W.num_nodes = N →
            validGappedCascadeAtRoot Δ' (subtreeAtPos (eraseKeys W) p) gs →
            IsRangeBST 0 (applyAtPosGen (fun s => execGappedCascadeAtRootGen s gs) W p) ∧
            (applyAtPosGen (fun s => execGappedCascadeAtRootGen s gs) W p).num_nodes = N ∧
            Rel W (applyAtPosGen (fun s => execGappedCascadeAtRootGen s gs) W p) := by
        intro gs
        induction gs with
        | nil =>
          intro W p hW_bst hW_n hv
          obtain ⟨hbst', hn'⟩ := h_applyPos_rotR_bst p W 0 hW_bst
          rw [hW_n] at hn'
          exact ⟨hbst', hn', hstep W p hW_bst hW_n hv⟩
        | cons g rest ih =>
          intro W p hW_bst hW_n hv
          rw [← h_ek_subPos p W] at hv
          rcases hsub : subtreeAtPosGen W p with _ | ⟨k2, _ | ⟨k1, a, b⟩, c⟩
          · rw [hsub] at hv
            exact False.elim hv
          · rw [hsub] at hv
            exact False.elim hv
          · rw [hsub] at hv
            obtain ⟨_, hv_rest⟩ := hv
            have hp_lsl : 2 ≤ leftSpineLen (subtreeAtPos (eraseKeys W) p) := by
              rw [← h_ek_subPos p W, hsub]
              simp only [eraseKeys, leftSpineLen]
              omega
            let W1 := applyAtPosGen _root_.BinaryTree.rotateRight W p
            obtain ⟨hW1_bst, hW1_n⟩ := h_applyPos_rotR_bst p W 0 hW_bst
            rw [hW_n] at hW1_n
            have hrel1 : Rel W1 W1 → Rel W W1 := fun _ => hstep W p hW_bst hW_n hp_lsl
            let p' := p ++ (Dir.L :: List.replicate g Dir.L)
            have hsub_W1 : subtreeAtPosGen W1 p' = subtreeAtLeftDepthGen a g := by
              dsimp (config := { failIfUnchanged := false }) only [W1, p']
              rw [h_subPos_applyPos p (Dir.L :: List.replicate g Dir.L) _root_.BinaryTree.rotateRight W
                (by simp [hsub])]
              rw [hsub]
              simp only [_root_.BinaryTree.rotateRight, subtreeAtPosGen]
              exact (h_repL_spec g id a).1
            have hv_W1 : validGappedCascadeAtRoot Δ' (subtreeAtPos (eraseKeys W1) p') rest := by
              rw [← h_ek_subPos p' W1, hsub_W1, h_ek_subLD g a]
              exact hv_rest
            obtain ⟨hW2_bst, hW2_n, hrel2⟩ := ih W1 p' hW1_bst hW1_n hv_W1
            have heq_exec :
                applyAtPosGen (fun x => execGappedCascadeAtRootGen x rest) W1 p' =
                  applyAtPosGen (fun s => execGappedCascadeAtRootGen s (g :: rest)) W p := by
              dsimp (config := { failIfUnchanged := false }) only [W1, p']
              rw [h_applyPos_comp]
              apply h_applyPos_congr
              rw [hsub]
              simp only [_root_.BinaryTree.rotateRight, applyAtPosGen, execGappedCascadeAtRootGen]
              rw [(h_repL_spec g (fun x => execGappedCascadeAtRootGen x rest) a).2]
            rw [heq_exec] at hW2_bst hW2_n hrel2
            exact ⟨hW2_bst, hW2_n, htrans W W1 _ (hrel1 (hrefl W1)) hrel2⟩
      exact h_casc gaps U pos hU_bst hU_n hop.2


  have h_msk_bounds :
      ∀ (t : _root_.BinaryTree ℕ) (a x : ℕ),
        IsRangeBST a t → a ≤ x → x < a + t.num_nodes →
        x ≤ pgsdMaxSubtreeKey t x ∧ pgsdMaxSubtreeKey t x < a + t.num_nodes := by
    intro t
    induction t with
    | nil =>
      intro a x _ h1 h2
      simp [_root_.BinaryTree.num_nodes] at h2
      omega
    | node k l r ihl ihr =>
      intro a x ⟨hk, hl, hr⟩ hax hlt
      simp only [_root_.BinaryTree.num_nodes] at hlt ⊢
      simp only [pgsdMaxSubtreeKey]
      split_ifs with h1 h2
      · obtain ⟨b1, b2⟩ := ihl a x hl hax (by omega)
        exact ⟨b1, by omega⟩
      · omega
      · obtain ⟨b1, b2⟩ := ihr (k + 1) x hr (by omega) (by omega)
        exact ⟨b1, by omega⟩

  have h_s3 :
      ∀ (U : _root_.BinaryTree ℕ) (pos : List Dir),
        IsRangeBST 0 U →
        2 ≤ leftSpineLen (subtreeAtPos (eraseKeys U) pos) →
        let U' := applyAtPosGen _root_.BinaryTree.rotateRight U pos
        IsRangeBST 0 U' ∧
        U'.num_nodes = U.num_nodes ∧
        ∃ (A_T B_T C_T : _root_.BinaryTree ℕ) (u v : ℕ),
          subtreeAtPosGen U pos = .node v (.node u A_T B_T) C_T ∧
          u < v ∧ v < U.num_nodes ∧
          (∀ x < U.num_nodes,
            x ≤ pgsdMaxSubtreeKey U x ∧ pgsdMaxSubtreeKey U x < U.num_nodes ∧
            x ≤ pgsdMaxSubtreeKey U' x ∧ pgsdMaxSubtreeKey U' x < U.num_nodes) ∧
          (∀ x < U.num_nodes, x ≠ u → pgsdMaxSubtreeKey U' x = pgsdMaxSubtreeKey U x) ∧
          pgsdMaxSubtreeKey U u + 1 = v ∧
          pgsdMaxSubtreeKey U' u = pgsdMaxSubtreeKey U v := by
    intro U pos hU_bst hpos
    have h_ind_s3 :
        ∀ (p : List Dir) (W : _root_.BinaryTree ℕ) (a : ℕ),
          IsRangeBST a W →
          2 ≤ leftSpineLen (subtreeAtPos (eraseKeys W) p) →
          let W' := applyAtPosGen _root_.BinaryTree.rotateRight W p
          ∃ (A_T B_T C_T : _root_.BinaryTree ℕ) (u v : ℕ),
            subtreeAtPosGen W p = .node v (.node u A_T B_T) C_T ∧
            a ≤ u ∧ u < v ∧ v < a + W.num_nodes ∧
            (∀ x, x ≠ u → pgsdMaxSubtreeKey W' x = pgsdMaxSubtreeKey W x) ∧
            pgsdMaxSubtreeKey W u + 1 = v ∧
            pgsdMaxSubtreeKey W' u = pgsdMaxSubtreeKey W v := by
      intro p
      induction p with
      | nil =>
        rintro (_ | ⟨v, _ | ⟨u, A_T, B_T⟩, C_T⟩) a hW hp
        · simp [eraseKeys, subtreeAtPos, leftSpineLen] at hp
        · simp [eraseKeys, subtreeAtPos, leftSpineLen] at hp
        · rcases hW with ⟨hv, ⟨hu, hA, hB⟩, hC⟩
          simp only [_root_.BinaryTree.num_nodes] at hv ⊢
          refine ⟨A_T, B_T, C_T, u, v, rfl, by omega, by omega, by omega, ?_, ?_, ?_⟩
          · intro x hxu
            simp only [applyAtPosGen, _root_.BinaryTree.rotateRight, pgsdMaxSubtreeKey]
            split_ifs <;> omega
          · simp only [pgsdMaxSubtreeKey]
            split_ifs <;> omega
          · simp only [applyAtPosGen, _root_.BinaryTree.rotateRight, pgsdMaxSubtreeKey,
              _root_.BinaryTree.num_nodes]
            split_ifs <;> omega
      | cons dir rest ih =>
        rintro (_ | ⟨k, l, r⟩) a hW hp
        · cases dir <;> simp [eraseKeys, subtreeAtPos, leftSpineLen] at hp
        · rcases hW with ⟨hk, hl, hr⟩
          cases dir with
          | L =>
            obtain ⟨A_T, B_T, C_T, u, v, hsub, hau, huv, hvk, heq, hRu, hR'u⟩ :=
              ih l a hl hp
            have hln : (applyAtPosGen _root_.BinaryTree.rotateRight l rest).num_nodes = l.num_nodes :=
              (h_applyPos_rotR_bst rest l a hl).2
            refine ⟨A_T, B_T, C_T, u, v, hsub, hau, huv, ?_, ?_, ?_, ?_⟩
            · simp only [_root_.BinaryTree.num_nodes]
              omega
            · intro x hxu
              simp only [applyAtPosGen, pgsdMaxSubtreeKey]
              split_ifs with h1 h2
              · exact heq x hxu
              · rfl
              · rfl
            · have huk : u < k := by omega
              simpa [pgsdMaxSubtreeKey, huk] using hRu
            · have huk : u < k := by omega
              have hvk' : v < k := by omega
              simpa [applyAtPosGen, pgsdMaxSubtreeKey, huk, hvk'] using hR'u
          | R =>
            obtain ⟨A_T, B_T, C_T, u, v, hsub, hku, huv, hvr, heq, hRu, hR'u⟩ :=
              ih r (k + 1) hr hp
            have hrn : (applyAtPosGen _root_.BinaryTree.rotateRight r rest).num_nodes = r.num_nodes :=
              (h_applyPos_rotR_bst rest r (k + 1) hr).2
            refine ⟨A_T, B_T, C_T, u, v, hsub, by omega, huv, ?_, ?_, ?_, ?_⟩
            · simp only [_root_.BinaryTree.num_nodes]
              omega
            · intro x hxu
              simp only [applyAtPosGen, pgsdMaxSubtreeKey, hrn]
              split_ifs with h1 h2
              · rfl
              · rfl
              · exact heq x hxu
            · have huk1 : ¬ u < k := by omega
              have huk2 : u ≠ k := by omega
              simpa [pgsdMaxSubtreeKey, huk1, huk2] using hRu
            · have huk1 : ¬ u < k := by omega
              have huk2 : u ≠ k := by omega
              have hvk1 : ¬ v < k := by omega
              have hvk2 : v ≠ k := by omega
              simpa [applyAtPosGen, pgsdMaxSubtreeKey, huk1, huk2, hvk1, hvk2] using hR'u
    obtain ⟨hU'_bst, hU'_n⟩ := h_applyPos_rotR_bst pos U 0 hU_bst
    obtain ⟨A_T, B_T, C_T, u, v, hsub, _, huv, hvU, heq, hRu, hR'u⟩ :=
      h_ind_s3 pos U 0 hU_bst hpos
    refine ⟨hU'_bst, hU'_n, A_T, B_T, C_T, u, v, hsub, huv, by omega, ?_, ?_, hRu, hR'u⟩
    · intro x hx
      obtain ⟨b1, b2⟩ := h_msk_bounds U 0 x hU_bst (by omega) (by omega)
      obtain ⟨b3, b4⟩ := h_msk_bounds _ 0 x hU'_bst (by omega) (by omega)
      exact ⟨b1, by omega, b3, by omega⟩
    · intro x _ hxu
      exact heq x hxu


  have h_msk_restrict :
      ∀ (t : _root_.BinaryTree ℕ) (b lo hi z : ℕ),
        lo ≤ hi →
        IsRangeBST b t →
        b + t.num_nodes ≤ hi →
        max b lo ≤ z →
        z < b + t.num_nodes →
        pgsdMaxSubtreeKey (restrictInterval lo hi t) z = pgsdMaxSubtreeKey t z := by
    intro t
    induction t with
    | nil =>
      intro b lo hi z _ _ _ h1 h2
      simp [_root_.BinaryTree.num_nodes] at h2
      omega
    | node K L R ihL ihR =>
      intro b lo hi z hlohi ⟨hK, hL, hR⟩ hhi hz_lo hz_hi
      simp only [_root_.BinaryTree.num_nodes] at hhi hz_hi
      have hK_lt_hi : ¬ hi ≤ K := by omega
      simp only [restrictInterval]
      split_ifs with hK_lo
      · have hz_gt : ¬ z < K := by omega
        have hz_ne : z ≠ K := by omega
        simp only [pgsdMaxSubtreeKey, hz_gt, ↓reduceIte, hz_ne]
        exact ihR (K + 1) lo hi z hlohi hR (by omega) (by omega) (by omega)
      · simp only [pgsdMaxSubtreeKey]
        split_ifs with hzK hz_eq
        · exact ihL b lo hi z hlohi hL (by omega) hz_lo (by omega)
        · obtain ⟨_, hRn⟩ := h_restrict_bst R (K + 1) lo hi hlohi hR
          omega
        · exact ihR (K + 1) lo hi z hlohi hR (by omega) (by omega) (by omega)

  have h_pre_right_empty :
      ∀ (bt : _root_.BinaryTree ℕ) (b m z y : ℕ),
        IsRangeBST b bt →
        (hm : m < (preorderList bt).length) →
        z ∈ (preorderList bt).take m →
        (preorderList bt)[m] < z →
        z < y →
        y ≤ pgsdMaxSubtreeKey bt z →
        y ∉ (preorderList bt).take m := by
    intro bt
    induction bt with
    | nil =>
      intro _ m _ _ _ hm
      simp [preorderList] at hm
    | node k L R ihL ihR =>
      intro b m z y ⟨hk, hL, hR⟩ hm hz_mem hx0_lt hzy hy_max
      rcases m with _ | m'
      · simp at hz_mem
      · simp only [preorderList, List.length_cons, List.length_append] at hm
        have hm'_len : m' < (preorderList L ++ preorderList R).length := by
          rw [List.length_append]
          omega
        simp only [preorderList, List.getElem_cons_succ] at hx0_lt
        change z ∈ k :: (preorderList L ++ preorderList R).take m' at hz_mem
        change y ∉ k :: (preorderList L ++ preorderList R).take m'
        have hm'_lt_L_of_lt_k :
            (preorderList L ++ preorderList R)[m']'hm'_len < k →
            m' < (preorderList L).length := by
          intro hlt_k
          by_contra hge
          have hle : (preorderList L).length ≤ m' := by omega
          rw [List.getElem_append_right hle] at hlt_k
          have hmem_R : (preorderList R)[m' - (preorderList L).length]'(by omega) ∈ preorderList R :=
            List.getElem_mem _
          rw [h_bst_pre_mem R (k + 1) _ hR] at hmem_R
          omega
        rcases lt_trichotomy z k with hzk | rfl | hkz
        · have hm'_L : m' < (preorderList L).length := hm'_lt_L_of_lt_k (by omega)
          rw [List.take_append_of_le_length (by omega)] at hz_mem ⊢
          rw [List.getElem_append_left hm'_L] at hx0_lt
          simp only [List.mem_cons] at hz_mem ⊢
          have hz_L : z ∈ (preorderList L).take m' := by
            rcases hz_mem with rfl | hz'
            · omega
            · exact hz'
          have hz_preL : z ∈ preorderList L := List.mem_of_mem_take hz_L
          rw [h_bst_pre_mem L b z hL] at hz_preL
          simp only [pgsdMaxSubtreeKey, hzk, ↓reduceIte] at hy_max
          have hy_lt_k : y < k := by
            have := (h_msk_bounds L b z hL hz_preL.1 hz_preL.2).2
            omega
          rintro (rfl | hy_mem)
          · omega
          · exact ihL b m' z y hL hm'_L hz_L hx0_lt hzy hy_max hy_mem
        · have hm'_L : m' < (preorderList L).length := hm'_lt_L_of_lt_k hx0_lt
          rw [List.take_append_of_le_length (by omega)]
          simp only [List.mem_cons]
          rintro (rfl | hy_mem)
          · omega
          · have hy_preL : y ∈ preorderList L := List.mem_of_mem_take hy_mem
            rw [h_bst_pre_mem L b y hL] at hy_preL
            omega
        · have hL_le_m' : (preorderList L).length ≤ m' := by
            by_contra hlt_L
            rw [List.take_append_of_le_length (by omega)] at hz_mem
            simp only [List.mem_cons] at hz_mem
            rcases hz_mem with rfl | hz_L
            · omega
            · have hz_preL : z ∈ preorderList L := List.mem_of_mem_take hz_L
              rw [h_bst_pre_mem L b z hL] at hz_preL
              omega
          have hm''_R : m' - (preorderList L).length < (preorderList R).length := by omega
          rw [List.take_append] at hz_mem ⊢
          rw [List.take_of_length_le hL_le_m'] at hz_mem ⊢
          rw [List.getElem_append_right hL_le_m'] at hx0_lt
          simp only [List.mem_cons, List.mem_append] at hz_mem ⊢
          have hz_R : z ∈ (preorderList R).take (m' - (preorderList L).length) := by
            rcases hz_mem with rfl | hz_L | hz_R
            · omega
            · rw [h_bst_pre_mem L b z hL] at hz_L
              omega
            · exact hz_R
          have hnk1 : ¬ z < k := by omega
          have hnk2 : z ≠ k := by omega
          simp only [pgsdMaxSubtreeKey, hnk1, ↓reduceIte, hnk2] at hy_max
          rintro (rfl | hy_L | hy_R)
          · omega
          · rw [h_bst_pre_mem L b y hL] at hy_L
            omega
          · exact ihR (k + 1) (m' - (preorderList L).length) z y hR hm''_R hz_R hx0_lt hzy hy_max hy_R

  have h_applyPos_restrict_eq :
      ∀ (p : List Dir) (f : _root_.BinaryTree ℕ → _root_.BinaryTree ℕ) (W : _root_.BinaryTree ℕ) (lo hi : ℕ),
        restrictInterval lo hi (f (subtreeAtPosGen W p)) =
          restrictInterval lo hi (subtreeAtPosGen W p) →
        restrictInterval lo hi (applyAtPosGen f W p) = restrictInterval lo hi W := by
    intro p
    induction p with
    | nil =>
      intro f W lo hi h
      cases W <;> exact h
    | cons dir rest ih =>
      intro f W lo hi h
      rcases W with _ | ⟨K, l, r⟩
      · rfl
      · cases dir with
        | L =>
          have h_l := ih f l lo hi h
          simp only [applyAtPosGen, restrictInterval, h_l]
        | R =>
          have h_r := ih f r lo hi h
          simp only [applyAtPosGen, restrictInterval, h_r]

  have h_s4 :
      ∀ (D M0 S0 : ℕ) (U : _root_.BinaryTree ℕ) (pos : List Dir)
        (A_T B_T C_T : _root_.BinaryTree ℕ) (u v : ℕ),
        1 ≤ D → D ≤ S0 →
        IsRangeBST 0 U → U.num_nodes = M0 * S0 →
        subtreeAtPosGen U pos = .node v (.node u A_T B_T) C_T →
        let U' := applyAtPosGen _root_.BinaryTree.rotateRight U pos
        let isG := isGlobalKey D S0 U
        let isG' := isGlobalKey D S0 U'
        (∀ x < M0 * S0, isG' x = isG x) ∨
        (∃ x' : ℕ,
          x' ≤ u ∧ u < v ∧ v < M0 * S0 ∧
          isG x' = false ∧ isG' x' = true ∧
          isG v = true ∧ isG' v = false ∧
          (∀ y < M0 * S0, y ≠ x' → y ≠ v → isG' y = isG y) ∧
          (x' < u → isG u = true) ∧
          (∀ y, u < y → y < v → isG y = false) ∧
          (∀ z, x' < z → z ≤ u → isG z = true →
            ∀ y, z < y → y ≤ pgsdMaxSubtreeKey U z → isG y = false)) := by
    intro D M0 S0 U pos A_T B_T C_T u v hD hS0 hU_bst hU_n hsub
    have hS_pos : 0 < S0 := by omega
    let s := _root_.BinaryTree.node v (.node u A_T B_T) C_T
    let s' := _root_.BinaryTree.node u A_T (.node v B_T C_T)
    let U' := applyAtPosGen _root_.BinaryTree.rotateRight U pos
    let isG := isGlobalKey D S0 U
    let isG' := isGlobalKey D S0 U'

    have h_sub_loc :
        ∀ (p : List Dir) (W : _root_.BinaryTree ℕ) (a0 : ℕ),
          IsRangeBST a0 W →
          subtreeAtPosGen W p = s →
          ∃ a_sub : ℕ,
            a0 ≤ a_sub ∧
            a_sub + s.num_nodes ≤ a0 + W.num_nodes ∧
            IsRangeBST a_sub s ∧
            (∀ z, a_sub ≤ z → z < a_sub + s.num_nodes →
              pgsdMaxSubtreeKey W z = pgsdMaxSubtreeKey s z) := by
      intro p
      induction p with
      | nil =>
        intro W a0 hW hp
        have hWs : W = s := by cases W <;> exact hp
        subst hWs
        exact ⟨a0, le_rfl, le_rfl, hW, fun _ _ _ => rfl⟩
      | cons dir rest ih =>
        rintro (_ | ⟨K, l, r⟩) a0 hW hp
        · cases dir <;> simp [subtreeAtPosGen, s] at hp
        · rcases hW with ⟨hK, hl, hr⟩
          cases dir with
          | L =>
            obtain ⟨a_sub, ha1, ha2, hs_bst, hmsk⟩ := ih l a0 hl hp
            refine ⟨a_sub, ha1, by simp [_root_.BinaryTree.num_nodes]; omega, hs_bst, ?_⟩
            intro z hz1 hz2
            have hzK : z < K := by omega
            simp only [pgsdMaxSubtreeKey, hzK, ↓reduceIte]
            exact hmsk z hz1 hz2
          | R =>
            obtain ⟨a_sub, ha1, ha2, hs_bst, hmsk⟩ := ih r (K + 1) hr hp
            refine ⟨a_sub, by omega, by simp [_root_.BinaryTree.num_nodes]; omega, hs_bst, ?_⟩
            intro z hz1 hz2
            have hzn1 : ¬ z < K := by omega
            have hzn2 : z ≠ K := by omega
            simp only [pgsdMaxSubtreeKey, hzn1, ↓reduceIte, hzn2]
            exact hmsk z hz1 hz2

    obtain ⟨a_sub, _, hasub_end, hs_bst, hmsk_s⟩ := h_sub_loc pos U 0 hU_bst hsub
    rcases hs_bst with ⟨hv_eq, ⟨hu_eq, hA_bst, hB_bst⟩, hC_bst⟩
    have huv : u < v := by simp [_root_.BinaryTree.num_nodes] at hv_eq; omega
    have hv_lt_N : v < M0 * S0 := by
      simp only [s, _root_.BinaryTree.num_nodes] at hasub_end hv_eq
      omega

    have h_rot_restrict_eq :
        ∀ lo hi : ℕ, ¬(lo ≤ u ∧ v < hi) →
          restrictInterval lo hi s' = restrictInterval lo hi s := by
      intro lo hi hnot
      dsimp (config := { failIfUnchanged := false }) only [s, s']
      simp only [restrictInterval]
      split_ifs <;> first | rfl | omega

    have h_blk_eq_of_not :
        ∀ m : ℕ, ¬(u / S0 = m ∧ v / S0 = m) → blockTree S0 m U' = blockTree S0 m U := by
      intro m hnot_m
      apply h_applyPos_restrict_eq pos _root_.BinaryTree.rotateRight U (m * S0) ((m + 1) * S0)
      rw [hsub]
      apply h_rot_restrict_eq
      rintro ⟨h1, h2⟩
      apply hnot_m
      exact ⟨(h_div_eq_iff hS_pos).mp ⟨h1, by omega⟩, (h_div_eq_iff hS_pos).mp ⟨by omega, h2⟩⟩

    by_cases huv_blk : u / S0 = v / S0
    · let q := u / S0
      have hv_div : v / S0 = q := huv_blk.symm
      let lo := q * S0
      let hi := (q + 1) * S0
      have hu_int : lo ≤ u ∧ u < hi := (h_div_eq_iff hS_pos).mpr rfl
      have hv_int : lo ≤ v ∧ v < hi := (h_div_eq_iff hS_pos).mpr hv_div
      have hlohi : lo ≤ hi := by omega

      have hisG_other : ∀ y : ℕ, y / S0 ≠ q → isG' y = isG y := by
        intro y hy
        dsimp (config := { failIfUnchanged := false }) only [isG, isG', isGlobalKey]
        rw [h_blk_eq_of_not (y / S0) (by omega)]

      have h_infix_pos :
          ∀ (p : List Dir) (W : _root_.BinaryTree ℕ) (a0 : ℕ),
            IsRangeBST a0 W →
            subtreeAtPosGen W p = s →
            ∃ P_pre S_pre : List ℕ,
              preorderList (restrictInterval lo hi W) =
                P_pre ++ preorderList (restrictInterval lo hi s) ++ S_pre ∧
              preorderList (restrictInterval lo hi (applyAtPosGen _root_.BinaryTree.rotateRight W p)) =
                P_pre ++ preorderList (restrictInterval lo hi s') ++ S_pre := by
        intro p
        induction p with
        | nil =>
          intro W _ _ hp
          have hWs : W = s := by cases W <;> exact hp
          subst hWs
          exact ⟨[], [], by simp, by simp [applyAtPosGen, _root_.BinaryTree.rotateRight, s, s']⟩
        | cons dir rest ih =>
          rintro (_ | ⟨K, l, r⟩) a0 hW hp
          · cases dir <;> simp [subtreeAtPosGen, s] at hp
          · rcases hW with ⟨hK, hl, hr⟩
            cases dir with
            | L =>
              obtain ⟨a1, _, ha1_end, hs1, _⟩ := h_sub_loc rest l a0 hl hp
              have hv_lt_K : v < K := by
                rcases hs1 with ⟨hv1, _, _⟩
                simp only [s, _root_.BinaryTree.num_nodes] at ha1_end hv1
                omega
              have hnK_lo : ¬ K < lo := by omega
              obtain ⟨P_pre, S_pre, hP1, hP2⟩ := ih l a0 hl hp
              simp only [applyAtPosGen, restrictInterval, hnK_lo, ↓reduceIte]
              split_ifs with hhi_K
              · exact ⟨P_pre, S_pre, hP1, hP2⟩
              · refine ⟨K :: P_pre, S_pre ++ preorderList (restrictInterval lo hi r), ?_, ?_⟩
                · simp only [preorderList, hP1, List.cons_append, List.append_assoc]
                · simp only [preorderList, hP2, List.cons_append, List.append_assoc]
            | R =>
              obtain ⟨a1, ha1_lo, _, hs1, _⟩ := h_sub_loc rest r (K + 1) hr hp
              have hK_lt_u : K < u := by
                rcases hs1 with ⟨_, ⟨hu1, _, _⟩, _⟩
                omega
              have hnK_hi : ¬ hi ≤ K := by omega
              obtain ⟨P_pre, S_pre, hP1, hP2⟩ := ih r (K + 1) hr hp
              simp only [applyAtPosGen, restrictInterval, hnK_hi, ↓reduceIte]
              split_ifs with hK_lo
              · exact ⟨P_pre, S_pre, hP1, hP2⟩
              · refine ⟨(K :: preorderList (restrictInterval lo hi l)) ++ P_pre, S_pre, ?_, ?_⟩
                · simp only [preorderList, hP1, List.cons_append, List.append_assoc]
                · simp only [preorderList, hP2, List.cons_append, List.append_assoc]

      obtain ⟨P_pre, S_pre, hL_old_raw, hL_new_raw⟩ := h_infix_pos pos U 0 hU_bst hsub
      let A_q := restrictInterval lo hi A_T
      let B_q := restrictInterval lo hi B_T
      let C_q := restrictInterval lo hi C_T
      let UA := u :: preorderList A_q
      let Rest := preorderList B_q ++ preorderList C_q ++ S_pre
      have hs_int : restrictInterval lo hi s = .node v (.node u A_q B_q) C_q := by
        dsimp (config := { failIfUnchanged := false }) only [s, A_q, B_q, C_q]
        simp only [restrictInterval]
        split_ifs <;> first | rfl | omega
      have hs'_int : restrictInterval lo hi s' = .node u A_q (.node v B_q C_q) := by
        dsimp (config := { failIfUnchanged := false }) only [s', A_q, B_q, C_q]
        simp only [restrictInterval]
        split_ifs <;> first | rfl | omega
      have hL_old : preorderList (blockTree S0 q U) = P_pre ++ (v :: (UA ++ Rest)) := by
        change preorderList (restrictInterval lo hi U) = _
        rw [hL_old_raw, hs_int]
        simp [preorderList, UA, Rest, List.append_assoc]
      have hL_new : preorderList (blockTree S0 q U') = P_pre ++ (UA ++ (v :: Rest)) := by
        change preorderList (restrictInterval lo hi U') = _
        rw [hL_new_raw, hs'_int]
        simp [preorderList, UA, Rest, List.append_assoc]

      obtain ⟨hU'_bst, _⟩ := h_applyPos_rotR_bst pos U 0 hU_bst
      have hL_old_nodup : (preorderList (blockTree S0 q U)).Nodup :=
        h_bst_pre_nodup _ _ (h_restrict_bst U 0 lo hi hlohi hU_bst).1
      have hL_new_nodup : (preorderList (blockTree S0 q U')).Nodup :=
        h_bst_pre_nodup _ _ (h_restrict_bst U' 0 lo hi hlohi hU'_bst).1

      let p0 := P_pre.length
      by_cases hD_le_p0 : D ≤ p0
      · left
        intro x _
        by_cases hx_q : x / S0 = q
        · dsimp (config := { failIfUnchanged := false }) only [isG, isG', isGlobalKey]
          rw [hx_q, hL_old, hL_new, List.take_append_of_le_length hD_le_p0,
            List.take_append_of_le_length hD_le_p0]
        · exact hisG_other x hx_q
      · by_cases hD_ge_end : p0 + 1 + UA.length ≤ D
        · left
          intro x _
          by_cases hx_q : x / S0 = q
          · dsimp (config := { failIfUnchanged := false }) only [isG, isG', isGlobalKey]
            rw [hx_q]
            have htake_old2 :
                (preorderList (blockTree S0 q U)).take D =
                  (P_pre ++ (v :: UA)) ++ Rest.take (D - (p0 + 1 + UA.length)) := by
              have h1 : preorderList (blockTree S0 q U) = (P_pre ++ (v :: UA)) ++ Rest := by
                simpa [List.append_assoc] using hL_old
              have hlen1 : (P_pre ++ (v :: UA)).length = p0 + 1 + UA.length := by
                simp [p0]; omega
              rw [h1, List.take_append, List.take_of_length_le (by omega), hlen1]
            have htake_new2 :
                (preorderList (blockTree S0 q U')).take D =
                  (P_pre ++ (UA ++ [v])) ++ Rest.take (D - (p0 + 1 + UA.length)) := by
              have h2 : preorderList (blockTree S0 q U') = (P_pre ++ (UA ++ [v])) ++ Rest := by
                simpa [List.append_assoc] using hL_new
              have hlen2 : (P_pre ++ (UA ++ [v])).length = p0 + 1 + UA.length := by
                simp [p0]; omega
              rw [h2, List.take_append, List.take_of_length_le (by omega), hlen2]
            rw [htake_new2, htake_old2]
            apply decide_eq_decide.mpr
            simp only [List.mem_append, List.mem_cons]
            tauto
          · exact hisG_other x hx_q
        · right
          let r := D - (p0 + 1)
          have hr_lt : r < UA.length := by omega
          have hD_eq : D = p0 + (r + 1) := by omega
          let x' := UA[r]

          have htake_old :
              (preorderList (blockTree S0 q U)).take D = P_pre ++ (v :: UA.take r) := by
            rw [hL_old, hD_eq, List.take_append, List.take_of_length_le (by dsimp (config := { failIfUnchanged := false }) [p0]; omega)]
            have hsub_len : p0 + (r + 1) - P_pre.length = r + 1 := by dsimp (config := { failIfUnchanged := false }) [p0]; omega
            rw [hsub_len]
            change P_pre ++ (v :: List.take r (UA ++ Rest)) = _
            rw [List.take_append_of_le_length (by omega)]

          have htake_new :
              (preorderList (blockTree S0 q U')).take D = P_pre ++ (UA.take r ++ [x']) := by
            rw [hL_new, hD_eq, List.take_append, List.take_of_length_le (by dsimp (config := { failIfUnchanged := false }) [p0]; omega)]
            have hsub_len : p0 + (r + 1) - P_pre.length = r + 1 := by dsimp (config := { failIfUnchanged := false }) [p0]; omega
            rw [hsub_len, List.take_append_of_le_length (by omega),
              List.take_succ_eq_append_getElem hr_lt]

          have hUA_split : UA = UA.take r ++ (x' :: UA.drop (r + 1)) := by
            conv_lhs => rw [← List.take_append_drop r UA, List.drop_eq_getElem_cons hr_lt]

          obtain ⟨hAq_bst, hAq_n⟩ := h_restrict_bst A_T a_sub lo hi hlohi hA_bst
          have hAq_end : max a_sub lo + A_q.num_nodes = u := by
            dsimp (config := { failIfUnchanged := false }) only [A_q]
            rw [hAq_n]
            omega

          have hUA_bounds : ∀ w ∈ UA, max a_sub lo ≤ w ∧ w ≤ u := by
            intro w hw
            simp only [UA, List.mem_cons] at hw
            rcases hw with rfl | hw_A
            · omega
            · rw [h_bst_pre_mem A_q (max a_sub lo) w hAq_bst, hAq_end] at hw_A
              omega

          have hx'_mem_UA : x' ∈ UA := List.getElem_mem hr_lt
          obtain ⟨hx'_lo, hx'_le_u⟩ := hUA_bounds x' hx'_mem_UA
          have hx'_div : x' / S0 = q := (h_div_eq_iff hS_pos).mp ⟨by omega, by omega⟩

          have hisG_x' : isG x' = false := by
            dsimp (config := { failIfUnchanged := false }) only [isG, isGlobalKey]
            rw [hx'_div, htake_old, decide_eq_false_iff_not]
            intro hx'_in
            have hnodup := hL_old_nodup
            rw [hL_old, hUA_split] at hnodup
            have h_grp :
                P_pre ++ (v :: ((UA.take r ++ (x' :: UA.drop (r + 1))) ++ Rest)) =
                  (P_pre ++ (v :: UA.take r)) ++ (x' :: (UA.drop (r + 1) ++ Rest)) := by
              simp [List.append_assoc]
            rw [h_grp, List.nodup_append] at hnodup
            exact hnodup.2.2 x' hx'_in x' List.mem_cons_self rfl

          have hisG'_x' : isG' x' = true := by
            dsimp (config := { failIfUnchanged := false }) only [isG', isGlobalKey]
            rw [hx'_div, htake_new, decide_eq_true_eq]
            simp

          have hisG_v : isG v = true := by
            dsimp (config := { failIfUnchanged := false }) only [isG, isGlobalKey]
            rw [hv_div, htake_old, decide_eq_true_eq]
            simp

          have hisG'_v : isG' v = false := by
            dsimp (config := { failIfUnchanged := false }) only [isG', isGlobalKey]
            rw [hv_div, htake_new, decide_eq_false_iff_not]
            intro hv_in
            have hnodup := hL_new_nodup
            rw [hL_new, hUA_split] at hnodup
            have h_grp :
                P_pre ++ ((UA.take r ++ (x' :: UA.drop (r + 1))) ++ (v :: Rest)) =
                  (P_pre ++ (UA.take r ++ [x']) ++ UA.drop (r + 1)) ++ (v :: Rest) := by
              simp [List.append_assoc]
            rw [h_grp, List.nodup_append] at hnodup
            exact hnodup.2.2 v (by simp [List.append_assoc] at hv_in ⊢; tauto) v List.mem_cons_self rfl

          have hisG_agree : ∀ y < M0 * S0, y ≠ x' → y ≠ v → isG' y = isG y := by
            intro y _ hyx' hyv
            by_cases hy_q : y / S0 = q
            · dsimp (config := { failIfUnchanged := false }) only [isG, isG', isGlobalKey]
              rw [hy_q, htake_old, htake_new]
              apply decide_eq_decide.mpr
              simp only [List.mem_append, List.mem_cons]
              tauto
            · exact hisG_other y hy_q

          have hisG_u_of_lt : x' < u → isG u = true := by
            intro hx'_lt_u
            rcases r with _ | r'
            · have : x' = u := rfl
              omega
            · dsimp (config := { failIfUnchanged := false }) only [isG, isGlobalKey]
              have hu_div : u / S0 = q := rfl
              rw [hu_div, htake_old, decide_eq_true_eq]
              simp [UA]

          have hisG_mid_false : ∀ y, u < y → y < v → isG y = false := by
            intro y huy hyv
            have hy_div : y / S0 = q := (h_div_eq_iff hS_pos).mp ⟨by omega, by omega⟩
            obtain ⟨hBq_bst, hBq_n⟩ := h_restrict_bst B_T (u + 1) lo hi hlohi hB_bst
            have hBq_mem : y ∈ preorderList B_q := by
              rw [h_bst_pre_mem B_q _ y hBq_bst, hBq_n]
              simp only [_root_.BinaryTree.num_nodes] at hv_eq
              omega
            dsimp (config := { failIfUnchanged := false }) only [isG, isGlobalKey]
            rw [hy_div, htake_old, decide_eq_false_iff_not]
            intro hy_in
            have hnodup := hL_old_nodup
            have h_grp : preorderList (blockTree S0 q U) = (P_pre ++ (v :: UA)) ++ Rest := by
              simpa [List.append_assoc] using hL_old
            rw [h_grp, List.nodup_append] at hnodup
            have hy_left : y ∈ P_pre ++ (v :: UA) := by
              simp only [List.mem_append, List.mem_cons] at hy_in ⊢
              rcases hy_in with h1 | rfl | h2
              · exact Or.inl h1
              · exact Or.inr (Or.inl rfl)
              · exact Or.inr (Or.inr (List.mem_of_mem_take h2))
            have hy_right : y ∈ Rest := by simp [Rest, hBq_mem]
            exact hnodup.2.2 y hy_left y hy_right rfl

          refine ⟨x', hx'_le_u, huv, hv_lt_N, hisG_x', hisG'_x', hisG_v, hisG'_v,
            hisG_agree, hisG_u_of_lt, hisG_mid_false, ?_⟩

          intro z hxz hzu hzG y hzy hy_max
          rcases eq_or_lt_of_le hzu with rfl | hzu_lt
          · have hmsk_u : pgsdMaxSubtreeKey U z = z + B_T.num_nodes := by
              rw [hmsk_s z (by omega) (by simp [s, _root_.BinaryTree.num_nodes]; omega)]
              dsimp (config := { failIfUnchanged := false }) only [s]
              simp only [pgsdMaxSubtreeKey]
              split_ifs <;> omega
            have hyv_lt : y < v := by
              simp only [_root_.BinaryTree.num_nodes] at hv_eq
              omega
            exact hisG_mid_false y hzy hyv_lt
          · rcases r with _ | m
            · have : x' = u := rfl
              omega
            · have hm_lt : m < (preorderList A_q).length := by
                simp only [UA, List.length_cons] at hr_lt
                omega
              have hx'_eq : x' = (preorderList A_q)[m] := rfl
              have hz_div : z / S0 = q := (h_div_eq_iff hS_pos).mp ⟨by omega, by omega⟩
              have hz_preAq : z ∈ preorderList A_q := by
                rw [h_bst_pre_mem A_q (max a_sub lo) z hAq_bst, hAq_end]
                omega
              have hz_not_Ppre : z ∉ P_pre := by
                have hnodup := hL_old_nodup
                rw [hL_old, List.nodup_append] at hnodup
                intro hzP
                exact hnodup.2.2 z hzP z (by simp [UA, hz_preAq]) rfl
              have hz_take_m : z ∈ (preorderList A_q).take m := by
                dsimp (config := { failIfUnchanged := false }) only [isG, isGlobalKey] at hzG
                rw [hz_div, htake_old, decide_eq_true_eq] at hzG
                change z ∈ P_pre ++ (v :: u :: (preorderList A_q).take m) at hzG
                simp only [List.mem_append, List.mem_cons] at hzG
                rcases hzG with hzP | rfl | rfl | hzm
                · exact absurd hzP hz_not_Ppre
                · omega
                · omega
                · exact hzm
              have hmsk_z_eq : pgsdMaxSubtreeKey U z = pgsdMaxSubtreeKey A_q z := by
                rw [hmsk_s z (by omega) (by simp [s, _root_.BinaryTree.num_nodes]; omega)]
                have h1 : pgsdMaxSubtreeKey s z = pgsdMaxSubtreeKey A_T z := by
                  dsimp (config := { failIfUnchanged := false }) only [s]
                  simp only [pgsdMaxSubtreeKey]
                  split_ifs <;> first | rfl | omega
                rw [h1]
                exact (h_msk_restrict A_T a_sub lo hi z hlohi hA_bst (by omega)
                  (by omega) (by omega)).symm
              rw [hmsk_z_eq] at hy_max
              have hy_lt_u : y < u := by
                have := (h_msk_bounds A_q (max a_sub lo) z hAq_bst (by omega) (by omega)).2
                omega
              have hy_div : y / S0 = q := (h_div_eq_iff hS_pos).mp ⟨by omega, by omega⟩
              have hy_preAq : y ∈ preorderList A_q := by
                rw [h_bst_pre_mem A_q (max a_sub lo) y hAq_bst, hAq_end]
                omega
              have hy_not_Ppre : y ∉ P_pre := by
                have hnodup := hL_old_nodup
                rw [hL_old, List.nodup_append] at hnodup
                intro hyP
                exact hnodup.2.2 y hyP y (by simp [UA, hy_preAq]) rfl
              have hy_not_take_m : y ∉ (preorderList A_q).take m :=
                h_pre_right_empty A_q (max a_sub lo) m z y hAq_bst hm_lt hz_take_m
                  (by rw [← hx'_eq]; exact hxz) hzy hy_max
              dsimp (config := { failIfUnchanged := false }) only [isG, isGlobalKey]
              rw [hy_div, htake_old, decide_eq_false_iff_not]
              change y ∉ P_pre ++ (v :: u :: (preorderList A_q).take m)
              simp only [List.mem_append, List.mem_cons]
              rintro (hyP | rfl | rfl | hym)
              · exact hy_not_Ppre hyP
              · omega
              · omega
              · exact hy_not_take_m hym
    · left
      intro x _
      dsimp (config := { failIfUnchanged := false }) only [isG, isG', isGlobalKey]
      rw [h_blk_eq_of_not (x / S0) (by omega)]


  have h_forall2_append :
      ∀ {l1 l2 r1 r2 : List ℕ},
        List.Forall₂ (· ≤ ·) l1 r1 →
        List.Forall₂ (· ≤ ·) l2 r2 →
        List.Forall₂ (· ≤ ·) (l1 ++ l2) (r1 ++ r2) := by
    intro l1 l2 r1 r2 h1 h2
    exact List.rel_append h1 h2

  have h_cnt_mono :
      ∀ (p : ℕ → Bool) {m1 m2 : ℕ}, m1 ≤ m2 → pgsdCountGlobalLt p m1 ≤ pgsdCountGlobalLt p m2 := by
    intro p m1 m2 hle
    have hm2 : m2 = m1 + (m2 - m1) := by omega
    rw [hm2, h_cnt_add]
    omega

  have h_cnt_succ :
      ∀ (p : ℕ → Bool) (a : ℕ),
        pgsdCountGlobalLt p (a + 1) = pgsdCountGlobalLt p a + (if p a then 1 else 0) := by
    intro p a
    rw [h_cnt_add p a 1]
    simp only [List.range', List.filter_cons, List.filter_nil]
    cases p a <;> simp

  have h_cnt_flat :
      ∀ (p : ℕ → Bool) (a b : ℕ),
        a ≤ b → (∀ y, a ≤ y → y < b → p y = false) →
        pgsdCountGlobalLt p b = pgsdCountGlobalLt p a := by
    intro p a b hle hemp
    have hb : b = a + (b - a) := by omega
    rw [hb, h_cnt_add]
    have hnil : (List.range' a (b - a)).filter p = [] := by
      rw [List.filter_eq_nil_iff]
      intro y hy
      rw [h_mem_range'_iff] at hy
      simp [hemp y hy.1 (by omega)]
    simp [hnil]

  have h_get_congr :
      ∀ {xs ys : List ℕ} (h : xs = ys) (t : ℕ) (ht : t < xs.length),
        xs[t]'ht = ys[t]'(h ▸ ht) := by
    rintro xs _ rfl t ht
    rfl

  have h_rank_range' :
      ∀ (p : ℕ → Bool) (a len t : ℕ) (ht : t < ((List.range' a len).filter p).length),
        pgsdCountGlobalLt p (((List.range' a len).filter p)[t] + 1) =
          pgsdCountGlobalLt p a + t + 1 := by
    intro p a len
    induction len generalizing a with
    | zero =>
      intro t ht
      simp at ht
    | succ len ih =>
      intro t ht
      cases hpa : p a with
      | false =>
        have hflt :
            (List.range' a (len + 1)).filter p = (List.range' (a + 1) len).filter p := by
          change (a :: List.range' (a + 1) len).filter p = _
          simp [hpa]
        have ht' : t < ((List.range' (a + 1) len).filter p).length := hflt ▸ ht
        have hc : pgsdCountGlobalLt p (a + 1) = pgsdCountGlobalLt p a := by
          rw [h_cnt_succ, hpa]; simp
        rw [h_get_congr hflt t ht, ih (a + 1) t ht', hc]
      | true =>
        have hflt :
            (List.range' a (len + 1)).filter p = a :: (List.range' (a + 1) len).filter p := by
          change (a :: List.range' (a + 1) len).filter p = _
          simp [hpa]
        have ht' : t < (a :: (List.range' (a + 1) len).filter p).length := hflt ▸ ht
        have hc : pgsdCountGlobalLt p (a + 1) = pgsdCountGlobalLt p a + 1 := by
          rw [h_cnt_succ, hpa]; simp
        rw [h_get_congr hflt t ht]
        rcases t with _ | t'
        · simp [hc]
        · simp only [List.length_cons] at ht'
          simp only [List.getElem_cons_succ]
          rw [ih (a + 1) t' (by omega), hc]
          omega

  have h_s5 :
      ∀ (N u v : ℕ) (isG isG' : ℕ → Bool) (R R' : ℕ → ℕ),
        (u < v ∧ v < N) →
        (∀ x < N, x ≤ R x ∧ R x < N ∧ x ≤ R' x ∧ R' x < N) →
        (∀ x < N, x ≠ u → R' x = R x) →
        R u + 1 = v →
        R' u = R v →
        ((∀ x < N, isG' x = isG x) ∨
         (∃ x' : ℕ,
           x' ≤ u ∧ u < v ∧ v < N ∧
           isG x' = false ∧ isG' x' = true ∧
           isG v = true ∧ isG' v = false ∧
           (∀ y < N, y ≠ x' → y ≠ v → isG' y = isG y) ∧
           (x' < u → isG u = true) ∧
           (∀ y, u < y → y < v → isG y = false) ∧
           (∀ z, x' < z → z ≤ u → isG z = true →
             ∀ y, z < y → y ≤ R z → isG y = false))) →
        List.Forall₂ (· ≤ ·)
          (((List.range N).filter isG).map (fun x => pgsdCountGlobalLt isG (R x + 1)))
          (((List.range N).filter isG').map (fun x => pgsdCountGlobalLt isG' (R' x + 1))) := by
    intro N u v isG isG' R R' ⟨huv, hvN⟩ hbds heq hRu hR'u hdich
    rcases hdich with h_caseA | ⟨x', hxu, _, _, hx'G, hx'G', hvG, hvG', hagree, huG, hmid0, hremp⟩
    · have hflt_eq : (List.range N).filter isG' = (List.range N).filter isG := by
        apply List.filter_congr
        intro x hx
        exact h_caseA x (List.mem_range.mp hx)
      have hcnt_eq : ∀ m ≤ N, pgsdCountGlobalLt isG' m = pgsdCountGlobalLt isG m := by
        intro m hm
        dsimp (config := { failIfUnchanged := false }) only [pgsdCountGlobalLt]
        congr 1
        apply List.filter_congr
        intro x hx
        have hx_lt : x < m := List.mem_range.mp hx
        exact h_caseA x (by omega)
      rw [hflt_eq, List.forall₂_map_left_iff, List.forall₂_map_right_iff, List.forall₂_same]
      intro x hx
      rw [List.mem_filter, List.mem_range] at hx
      obtain ⟨_, _, _, hR'x_lt⟩ := hbds x hx.1
      rw [hcnt_eq (R' x + 1) (by omega)]
      apply h_cnt_mono isG
      by_cases hxu_eq : x = u
      · subst hxu_eq
        have hv_le_Rv : v ≤ R v := (hbds v hvN).1
        omega
      · rw [heq x hx.1 hxu_eq]
    · have h_cnt_exact :
          ∀ m ≤ N,
            pgsdCountGlobalLt isG' m =
              pgsdCountGlobalLt isG m + (if x' < m ∧ m ≤ v then 1 else 0) := by
        intro m
        induction m with
        | zero =>
          intro _
          simp [pgsdCountGlobalLt]
        | succ m ih =>
          intro hm_succ
          have hm_le : m ≤ N := by omega
          rw [h_cnt_succ isG' m, h_cnt_succ isG m, ih hm_le]
          by_cases hmx : m = x'
          · subst hmx
            have h2 : m < m + 1 ∧ m + 1 ≤ v := by omega
            simp [hx'G', hx'G, h2]
          · by_cases hmv : m = v
            · subst hmv
              have h1 : x' < m ∧ m ≤ m := by omega
              simp [hvG', hvG, h1]
            · rw [hagree m (by omega) hmx hmv]
              have h_iff : (x' < m + 1 ∧ m + 1 ≤ v) ↔ (x' < m ∧ m ≤ v) := by omega
              simp only [h_iff]
              (cases isG m <;> simp); omega

      have h_cnt_dom : ∀ m ≤ N, pgsdCountGlobalLt isG m ≤ pgsdCountGlobalLt isG' m := by
        intro m hm
        rw [h_cnt_exact m hm]
        omega

      have h_rng3 :
          List.range N =
            List.range' 0 x' ++ List.range' x' (v + 1 - x') ++ List.range' (v + 1) (N - (v + 1)) := by
        rw [List.range_eq_range']
        have h1 := @List.range'_append 0 x' (v + 1 - x') 1
        have h2 := @List.range'_append 0 (v + 1) (N - (v + 1)) 1
        have ha1 : x' + (v + 1 - x') = v + 1 := by omega
        have ha2 : (v + 1) + (N - (v + 1)) = N := by omega
        simp only [Nat.one_mul, Nat.zero_add] at h1 h2
        rw [ha1] at h1
        rw [ha2] at h2
        rw [← h2, ← h1]

      have h_outer_dom :
          ∀ a len : ℕ,
            a + len ≤ N →
            (∀ w, a ≤ w → w < a + len → w ≠ x' ∧ w ≠ v ∧ w ≠ u) →
            List.Forall₂ (· ≤ ·)
              (((List.range' a len).filter isG).map (fun x => pgsdCountGlobalLt isG (R x + 1)))
              (((List.range' a len).filter isG').map (fun x => pgsdCountGlobalLt isG' (R' x + 1))) := by
        intro a len halen hout
        have hflt : (List.range' a len).filter isG' = (List.range' a len).filter isG := by
          apply List.filter_congr
          intro w hw
          rw [h_mem_range'_iff] at hw
          obtain ⟨hnx, hnv, _⟩ := hout w hw.1 hw.2
          exact hagree w (by omega) hnx hnv
        rw [hflt, List.forall₂_map_left_iff, List.forall₂_map_right_iff, List.forall₂_same]
        intro w hw
        rw [List.mem_filter, h_mem_range'_iff] at hw
        have hwN : w < N := by omega
        obtain ⟨_, _, hnu⟩ := hout w hw.1.1 hw.1.2
        rw [heq w hwN hnu]
        exact h_cnt_dom (R w + 1) (by have := (hbds w hwN).2.1; omega)

      have h_left :
          List.Forall₂ (· ≤ ·)
            (((List.range' 0 x').filter isG).map (fun x => pgsdCountGlobalLt isG (R x + 1)))
            (((List.range' 0 x').filter isG').map (fun x => pgsdCountGlobalLt isG' (R' x + 1))) :=
        h_outer_dom 0 x' (by omega) (fun w _ hw => ⟨by omega, by omega, by omega⟩)

      have h_right :
          List.Forall₂ (· ≤ ·)
            (((List.range' (v + 1) (N - (v + 1))).filter isG).map
              (fun x => pgsdCountGlobalLt isG (R x + 1)))
            (((List.range' (v + 1) (N - (v + 1))).filter isG').map
              (fun x => pgsdCountGlobalLt isG' (R' x + 1))) :=
        h_outer_dom (v + 1) (N - (v + 1)) (by omega) (fun w hw _ => ⟨by omega, by omega, by omega⟩)

      have h_mid :
          List.Forall₂ (· ≤ ·)
            (((List.range' x' (v + 1 - x')).filter isG).map (fun x => pgsdCountGlobalLt isG (R x + 1)))
            (((List.range' x' (v + 1 - x')).filter isG').map (fun x => pgsdCountGlobalLt isG' (R' x + 1))) := by
        let e := v - (u + 1)
        have h_uv_nil_G : (List.range' (u + 1) e).filter isG = [] := by
          rw [List.filter_eq_nil_iff]
          intro y hy
          rw [h_mem_range'_iff] at hy
          simp [hmid0 y (by omega) (by omega)]
        have h_uv_nil_G' : (List.range' (u + 1) e).filter isG' = [] := by
          rw [List.filter_eq_nil_iff]
          intro y hy
          rw [h_mem_range'_iff] at hy
          rw [hagree y (by omega) (by omega) (by omega)]
          simp [hmid0 y (by omega) (by omega)]
        have h_tail_vu :
            pgsdCountGlobalLt isG (R v + 1) ≤ pgsdCountGlobalLt isG' (R' u + 1) := by
          rw [hR'u]
          exact h_cnt_dom (R v + 1) (by have := (hbds v hvN).2.1; omega)

        rcases eq_or_lt_of_le hxu with rfl | hxu_lt
        · have h_split_u :
              List.range' x' (v + 1 - x') = [x'] ++ List.range' (x' + 1) e ++ [v] := by
            have h1 : v + 1 - x' = (e + 1) + 1 := by dsimp (config := { failIfUnchanged := false }) [e]; omega
            rw [h1]
            change x' :: List.range' (x' + 1) (e + 1) = _
            rw [← @List.range'_append (x' + 1) e 1 1]
            have h2 : x' + 1 + 1 * e = v := by dsimp (config := { failIfUnchanged := false }) [e]; omega
            rw [h2]
            simp [List.range']
          rw [h_split_u]
          simp only [List.filter_append, List.filter_cons, List.filter_nil, hx'G, hx'G',
            hvG, hvG', h_uv_nil_G, h_uv_nil_G', Bool.false_eq_true, ↓reduceIte]
          simp only [List.nil_append, List.append_nil, List.map_cons, List.map_nil]
          exact List.Forall₂.cons h_tail_vu List.Forall₂.nil
        · let d := u - (x' + 1)
          have hisG_u : isG u = true := huG hxu_lt
          have hisG'_u : isG' u = true := by
            rw [hagree u (by omega) (by omega) (by omega)]
            exact hisG_u
          have h_split_xu :
              List.range' x' (v + 1 - x') =
                List.range' x' (d + 2) ++ List.range' (u + 1) e ++ [v] := by
            have h1 : x' + 1 * (d + 2) = u + 1 := by dsimp (config := { failIfUnchanged := false }) [d]; omega
            have h2 : u + 1 + 1 * e = v := by dsimp (config := { failIfUnchanged := false }) [e]; omega
            have h3 : (d + 2) + e + 1 = v + 1 - x' := by dsimp (config := { failIfUnchanged := false }) [d, e]; omega
            rw [← h3]
            have ha := @List.range'_append x' (d + 2) e 1
            have hb := @List.range'_append x' ((d + 2) + e) 1 1
            rw [h1] at ha
            have hc : x' + 1 * (d + 2 + e) = v := by dsimp (config := { failIfUnchanged := false }) [d, e]; omega
            rw [hc] at hb
            rw [ha]
            exact hb.symm
          have h_d2_G :
              (List.range' x' (d + 2)).filter isG = (List.range' (x' + 1) (d + 1)).filter isG := by
            change (x' :: List.range' (x' + 1) (d + 1)).filter isG = _
            simp [hx'G]
          have h_d2_G' :
              (List.range' x' (d + 2)).filter isG' =
                (List.range' x' (d + 1)).filter isG' ++ [u] := by
            have h1 : d + 2 = (d + 1) + 1 := by omega
            rw [h1, ← @List.range'_append x' (d + 1) 1 1]
            have h2 : x' + 1 * (d + 1) = u := by dsimp (config := { failIfUnchanged := false }) [d]; omega
            rw [h2, List.filter_append]
            simp [List.range', hisG'_u]
          simp only [h_split_xu, List.filter_append]
          rw [h_d2_G, h_d2_G', h_uv_nil_G, h_uv_nil_G']
          simp only [List.filter_cons, List.filter_nil, hvG, hvG', Bool.false_eq_true, ↓reduceIte,
            List.append_nil, List.map_append, List.map_cons, List.map_nil]

          let L1 := (List.range' (x' + 1) (d + 1)).filter isG
          let L2 := (List.range' x' (d + 1)).filter isG'
          change List.Forall₂ (· ≤ ·)
            (L1.map (fun x => pgsdCountGlobalLt isG (R x + 1)) ++ [pgsdCountGlobalLt isG (R v + 1)])
            (L2.map (fun x => pgsdCountGlobalLt isG' (R' x + 1)) ++ [pgsdCountGlobalLt isG' (R' u + 1)])
          refine h_forall2_append ?_ (List.Forall₂.cons h_tail_vu List.Forall₂.nil)

          have hL1_eq : L1 = (List.range' (x' + 1) d).filter isG ++ [u] := by
            dsimp (config := { failIfUnchanged := false }) only [L1]
            rw [← @List.range'_append (x' + 1) d 1 1]
            have hu_eq' : x' + 1 + 1 * d = u := by dsimp (config := { failIfUnchanged := false }) [d]; omega
            rw [hu_eq', List.filter_append]
            simp [List.range', hisG_u]
          have hL2_eq : L2 = x' :: (List.range' (x' + 1) d).filter isG := by
            dsimp (config := { failIfUnchanged := false }) only [L2]
            change (x' :: List.range' (x' + 1) d).filter isG' = _
            simp only [List.filter_cons, hx'G', ↓reduceIte]
            congr 1
            apply List.filter_congr
            intro y hy
            rw [h_mem_range'_iff] at hy
            exact hagree y (by dsimp (config := { failIfUnchanged := false }) [d] at hy; omega) (by omega) (by dsimp (config := { failIfUnchanged := false }) [d] at hy; omega)
          have hlen_eq : L1.length = L2.length := by
            rw [hL1_eq, hL2_eq]
            simp
          rw [List.forall₂_iff_get]
          refine ⟨by simp only [List.length_map]; exact hlen_eq, ?_⟩
          intro t ht1 ht2
          simp only [List.length_map] at ht1 ht2
          simp only [List.get_eq_getElem, List.getElem_map]
          have hrank1 : pgsdCountGlobalLt isG (L1[t] + 1) = pgsdCountGlobalLt isG (x' + 1) + t + 1 :=
            h_rank_range' isG (x' + 1) (d + 1) t ht1
          have hrank2 : pgsdCountGlobalLt isG' (L2[t] + 1) = pgsdCountGlobalLt isG' x' + t + 1 :=
            h_rank_range' isG' x' (d + 1) t ht2
          have hcx' : pgsdCountGlobalLt isG (x' + 1) = pgsdCountGlobalLt isG' x' := by
            have h1 := h_cnt_succ isG x'
            have h2 := h_cnt_exact x' (by omega)
            simp [hx'G] at h1 h2
            omega
          have hd_eq1 : (x' + 1) + (d + 1) = u + 1 := by dsimp (config := { failIfUnchanged := false }) [d]; omega
          have hd_eq2 : x' + (d + 1) = u := by dsimp (config := { failIfUnchanged := false }) [d]; omega
          have hz_mem : L1[t] ∈ (List.range' (x' + 1) (d + 1)).filter isG := List.getElem_mem ht1
          rw [List.mem_filter, h_mem_range'_iff, hd_eq1] at hz_mem
          have hz_lt_N : L1[t] < N := by omega
          have hz_le_Rz : L1[t] ≤ R (L1[t]) := (hbds (L1[t]) hz_lt_N).1
          have h_flat_zt :
              pgsdCountGlobalLt isG (R (L1[t]) + 1) = pgsdCountGlobalLt isG (L1[t] + 1) := by
            apply h_cnt_flat isG (L1[t] + 1) (R (L1[t]) + 1) (by omega)
            intro y hy1 hy2
            exact hremp (L1[t]) (by omega) (by omega) hz_mem.2 y (by omega) (by omega)
          have hw_mem : L2[t] ∈ (List.range' x' (d + 1)).filter isG' := List.getElem_mem ht2
          rw [List.mem_filter, h_mem_range'_iff, hd_eq2] at hw_mem
          have hw_lt_N : L2[t] < N := by omega
          have hw_le_R'w : L2[t] ≤ R' (L2[t]) := (hbds (L2[t]) hw_lt_N).2.2.1
          have h_mono_wt :
              pgsdCountGlobalLt isG' (L2[t] + 1) ≤ pgsdCountGlobalLt isG' (R' (L2[t]) + 1) :=
            h_cnt_mono isG' (by omega)
          rw [h_flat_zt, hrank1, hcx', ← hrank2]
          exact h_mono_wt

      rw [h_rng3]
      simp only [List.filter_append, List.map_append]
      exact h_forall2_append (h_forall2_append h_left h_mid) h_right


  have h_forall2_refl : ∀ (xs : List ℕ), List.Forall₂ (· ≤ ·) xs xs := by
    intro xs
    rw [List.forall₂_same]
    intro _ _
    exact le_rfl

  have h_forall2_trans :
      ∀ {xs ys zs : List ℕ},
        List.Forall₂ (· ≤ ·) xs ys →
        List.Forall₂ (· ≤ ·) ys zs →
        List.Forall₂ (· ≤ ·) xs zs := by
    intro xs ys zs h1 h2
    induction h1 generalizing zs with
    | nil =>
      cases h2
      exact List.Forall₂.nil
    | cons hxy _ ih =>
      cases h2 with
      | cons hyz hrest =>
        exact List.Forall₂.cons (le_trans hxy hyz) (ih hrest)

  have h_forall2_of_map_succ :
      ∀ {xs ys : List ℕ},
        List.Forall₂ (· ≤ ·) (xs.map (· + 1)) (ys.map (· + 1)) →
        List.Forall₂ (· ≤ ·) xs ys := by
    intro xs ys h
    rw [List.forall₂_map_left_iff, List.forall₂_map_right_iff] at h
    exact h.imp (fun _ _ hle => by omega)

  let D := Δ' + 2
  have hD1 : 1 ≤ D := by omega
  have hDS : D ≤ S := hS

  have h_part1 : (globalTree D S T).num_nodes = D * M :=
    (h_s1 D M S T hD1 hDS hbst hnodes).1

  let Rel : _root_.BinaryTree ℕ → _root_.BinaryTree ℕ → Prop := fun U1 U2 =>
    List.Forall₂ (· ≤ ·)
      (rightReachList 0 (globalTree D S U1))
      (rightReachList 0 (globalTree D S U2))

  have h_single_step :
      ∀ (U : _root_.BinaryTree ℕ) (pos : List Dir),
        IsRangeBST 0 U → U.num_nodes = M * S →
        2 ≤ leftSpineLen (subtreeAtPos (eraseKeys U) pos) →
        Rel U (applyAtPosGen _root_.BinaryTree.rotateRight U pos) := by
    intro U pos hU_bst hU_n hpos
    obtain ⟨hU'_bst, hU'_n_eq, A_T, B_T, C_T, u, v, hsub, huv, hvU, hbds, heq, hRu, hR'u⟩ :=
      h_s3 U pos hU_bst hpos
    have hU'_n : (applyAtPosGen _root_.BinaryTree.rotateRight U pos).num_nodes = M * S := by
      rw [hU'_n_eq, hU_n]
    have hvN : v < M * S := by rw [← hU_n]; exact hvU
    have hbds' : ∀ x < M * S,
        x ≤ pgsdMaxSubtreeKey U x ∧ pgsdMaxSubtreeKey U x < M * S ∧
        x ≤ pgsdMaxSubtreeKey (applyAtPosGen _root_.BinaryTree.rotateRight U pos) x ∧
        pgsdMaxSubtreeKey (applyAtPosGen _root_.BinaryTree.rotateRight U pos) x < M * S := by
      intro x hx
      rw [← hU_n] at hx ⊢
      exact hbds x hx
    have heq' : ∀ x < M * S, x ≠ u →
        pgsdMaxSubtreeKey (applyAtPosGen _root_.BinaryTree.rotateRight U pos) x =
          pgsdMaxSubtreeKey U x := by
      intro x hx hxu
      rw [← hU_n] at hx
      exact heq x hx hxu
    have hdich := h_s4 D M S U pos A_T B_T C_T u v hD1 hDS hU_bst hU_n hsub
    have hdom_succ := h_s5 (M * S) u v
      (isGlobalKey D S U)
      (isGlobalKey D S (applyAtPosGen _root_.BinaryTree.rotateRight U pos))
      (pgsdMaxSubtreeKey U)
      (pgsdMaxSubtreeKey (applyAtPosGen _root_.BinaryTree.rotateRight U pos))
      ⟨huv, hvN⟩ hbds' heq' hRu hR'u hdich
    have hrr1 := (h_s1 D M S U hD1 hDS hU_bst hU_n).2
    have hrr2 := (h_s1 D M S (applyAtPosGen _root_.BinaryTree.rotateRight U pos) hD1 hDS hU'_bst hU'_n).2
    rw [← hrr1, ← hrr2] at hdom_succ
    exact h_forall2_of_map_succ hdom_succ

  refine ⟨h_part1, ?_⟩
  intro k op hop
  exact h_s2 (M * S) Rel (fun _ => h_forall2_refl _) (fun _ _ _ => h_forall2_trans)
    h_single_step T hbst hnodes k op hop

theorem preorder_global_interblock_cascade_proj (Δ' k' M S : ℕ) (T : _root_.BinaryTree ℕ) (pos : List Dir) (gaps : List ℕ)
    (hk' : 1 ≤ k') (hM : 1 ≤ M) (hS : Δ' + 2 ≤ S)
    (hbst : IsRangeBST 0 T) (hnodes : T.num_nodes = M * S)
    (hvalid : validRightRotOp Δ' (k' + 2) (eraseKeys T) (.cascade pos gaps))
    (hpure : allPairsInterblock S (subtreeAtPosGen T pos) gaps = true) :
    ∃ step_ops : List RightRotOp,
      ValidRightRotSeq Δ' k' (globalTree (Δ' + 2) S T) step_ops ∧
      execRightRotSeq (globalTree (Δ' + 2) S T) step_ops =
        globalTree (Δ' + 2) S (execRightRotOpGen T (.cascade pos gaps)) ∧
      countGappedCascades step_ops = 1 :=
by
  have _ := And.intro hM hnodes
  let gapsLeftOffset : List ℕ → ℕ := fun xs =>
    xs.foldr (fun g acc => (g + 1) + acc) 0
  let NonSplittingGlobal : (ℕ → Bool) → _root_.BinaryTree ℕ → Prop := fun isG t =>
    _root_.BinaryTree.rec True
      (fun k l r ihl ihr =>
        (isG k = false → extractGlobalTree isG l = .nil ∨ extractGlobalTree isG r = .nil) ∧
        ihl ∧ ihr) t
  let projGlobalPos : (ℕ → Bool) → _root_.BinaryTree ℕ → List Dir → List Dir := fun isG t =>
    _root_.BinaryTree.rec (fun _ => [])
      (fun k _ _ ihl ihr p =>
        match p with
        | [] => []
        | .L :: rest => if isG k then .L :: ihl rest else ihl rest
        | .R :: rest => if isG k then .R :: ihr rest else ihr rest) t
  let leftPrefixGlobal : (ℕ → Bool) → _root_.BinaryTree ℕ → ℕ → Prop := fun isG t =>
    _root_.BinaryTree.rec
      (fun d => match d with | 0 => True | _ + 1 => False)
      (fun k _ _ ihl _ d => match d with | 0 => True | d' + 1 => isG k = true ∧ ihl d') t
  let allCascadeSpineGlobal : (ℕ → Bool) → _root_.BinaryTree ℕ → List ℕ → Prop := fun isG s gs =>
    List.rec
      (fun s => match s with
        | .node y (.node x _ _) _ => isG x = true ∧ isG y = true
        | _ => False)
      (fun g _ ih s => match s with
        | .node y (.node x a _) _ =>
            isG x = true ∧ isG y = true ∧ leftPrefixGlobal isG a g ∧ ih (subtreeAtLeftDepthGen a g)
        | _ => False)
      gs s

  have hS_pos : 0 < S := by omega


  have h_subPos_nil : ∀ {α : Type} (t : _root_.BinaryTree α), subtreeAtPosGen t [] = t := by
    intro _; rintro (_ | ⟨_, _, _⟩) <;> rfl
  have h_subPosU_nil : ∀ (t : _root_.BinaryTree Unit), subtreeAtPos t [] = t := by
    rintro (_ | ⟨_, _, _⟩) <;> rfl
  have h_appPos_nil : ∀ {α : Type} (f : _root_.BinaryTree α → _root_.BinaryTree α) (t : _root_.BinaryTree α),
      applyAtPosGen f t [] = f t := by
    intro _ _; rintro (_ | ⟨_, _, _⟩) <;> rfl
  have h_appPosU_nil : ∀ (f : _root_.BinaryTree Unit → _root_.BinaryTree Unit) (t : _root_.BinaryTree Unit),
      applyAtPos f t [] = f t := by
    intro _; rintro (_ | ⟨_, _, _⟩) <;> rfl
  have h_subLD_zero : ∀ {α : Type} (t : _root_.BinaryTree α), subtreeAtLeftDepthGen t 0 = t := by
    intro _; rintro (_ | ⟨_, _, _⟩) <;> rfl
  have h_subLDU_zero : ∀ (t : _root_.BinaryTree Unit), subtreeAtLeftDepth t 0 = t := by
    rintro (_ | ⟨_, _, _⟩) <;> rfl
  have h_appLD_zero : ∀ {α : Type} (f : _root_.BinaryTree α → _root_.BinaryTree α) (t : _root_.BinaryTree α),
      applyAtLeftDepthGen f t 0 = f t := by
    intro _ _; rintro (_ | ⟨_, _, _⟩) <;> rfl
  have h_appLDU_zero : ∀ (f : _root_.BinaryTree Unit → _root_.BinaryTree Unit) (t : _root_.BinaryTree Unit),
      applyAtLeftDepth f t 0 = f t := by
    intro _; rintro (_ | ⟨_, _, _⟩) <;> rfl
  have h_projPos_nil : ∀ (isG : ℕ → Bool) (t : _root_.BinaryTree ℕ), projGlobalPos isG t [] = [] := by
    intro _; rintro (_ | ⟨_, _, _⟩) <;> rfl


  have h_ek_subPos :
      ∀ (p : List Dir) (t : _root_.BinaryTree ℕ),
        eraseKeys (subtreeAtPosGen t p) = subtreeAtPos (eraseKeys t) p := by
    intro p
    induction p with
    | nil => intro t; rw [h_subPos_nil, h_subPosU_nil]
    | cons dir rest ih =>
      rintro (_ | ⟨k, l, r⟩)
      · rfl
      · cases dir <;> exact ih _

  have h_ek_subLD :
      ∀ (d : ℕ) (t : _root_.BinaryTree ℕ),
        eraseKeys (subtreeAtLeftDepthGen t d) = subtreeAtLeftDepth (eraseKeys t) d := by
    intro d
    induction d with
    | zero => intro t; rw [h_subLD_zero, h_subLDU_zero]
    | succ d ih =>
      rintro (_ | ⟨k, l, r⟩)
      · rfl
      · exact ih l

  have h_subPos_app :
      ∀ (p1 p2 : List Dir) (t : _root_.BinaryTree ℕ),
        subtreeAtPosGen t (p1 ++ p2) = subtreeAtPosGen (subtreeAtPosGen t p1) p2 := by
    intro p1
    induction p1 with
    | nil => intro p2 t; simp only [List.nil_append, h_subPos_nil]
    | cons dir rest ih =>
      intro p2 t
      rcases t with _ | ⟨k, l, r⟩
      · cases p2 <;> rfl
      · cases dir <;> exact ih p2 _

  have h_appPos_app :
      ∀ (p1 p2 : List Dir) (f : _root_.BinaryTree ℕ → _root_.BinaryTree ℕ) (t : _root_.BinaryTree ℕ),
        applyAtPosGen f t (p1 ++ p2) =
          applyAtPosGen (fun s => applyAtPosGen f s p2) t p1 := by
    intro p1
    induction p1 with
    | nil => intro p2 f t; simp only [List.nil_append, h_appPos_nil]
    | cons dir rest ih =>
      intro p2 f t
      rcases t with _ | ⟨k, l, r⟩
      · rfl
      · cases dir <;> simp only [List.cons_append, applyAtPosGen, ih]

  have h_appPos_congr :
      ∀ (p : List Dir) (f1 f2 : _root_.BinaryTree ℕ → _root_.BinaryTree ℕ) (t : _root_.BinaryTree ℕ),
        f1 (subtreeAtPosGen t p) = f2 (subtreeAtPosGen t p) →
        applyAtPosGen f1 t p = applyAtPosGen f2 t p := by
    intro p
    induction p with
    | nil => intro f1 f2 t h; simpa only [h_subPos_nil, h_appPos_nil] using h
    | cons dir rest ih =>
      intro f1 f2 t h
      rcases t with _ | ⟨k, l, r⟩
      · rfl
      · cases dir with
        | L => exact congrArg (fun x => _root_.BinaryTree.node k x r) (ih f1 f2 l h)
        | R => exact congrArg (_root_.BinaryTree.node k l) (ih f1 f2 r h)

  have h_appPos_same :
      ∀ (p : List Dir) (g f : _root_.BinaryTree ℕ → _root_.BinaryTree ℕ) (t : _root_.BinaryTree ℕ),
        f .nil = .nil →
        applyAtPosGen g (applyAtPosGen f t p) p = applyAtPosGen (fun s => g (f s)) t p := by
    intro p
    induction p with
    | nil => intro g f t _; simp only [h_appPos_nil]
    | cons dir rest ih =>
      intro g f t hf0
      rcases t with _ | ⟨k, l, r⟩
      · rfl
      · cases dir <;> simp only [applyAtPosGen, ih g f _ hf0]

  have h_subPos_after_app :
      ∀ (p : List Dir) (f : _root_.BinaryTree ℕ → _root_.BinaryTree ℕ) (t : _root_.BinaryTree ℕ),
        subtreeAtPosGen t p ≠ .nil →
        subtreeAtPosGen (applyAtPosGen f t p) p = f (subtreeAtPosGen t p) := by
    intro p
    induction p with
    | nil => intro f t _; simp only [h_appPos_nil, h_subPos_nil]
    | cons dir rest ih =>
      intro f t hne
      rcases t with _ | ⟨k, l, r⟩
      · exact absurd rfl hne
      · cases dir <;> exact ih f _ hne

  have h_subLD_eq_pos :
      ∀ (d : ℕ) (t : _root_.BinaryTree ℕ),
        subtreeAtLeftDepthGen t d = subtreeAtPosGen t (List.replicate d .L) := by
    intro d
    induction d with
    | zero => intro t; simp only [List.replicate_zero, h_subLD_zero, h_subPos_nil]
    | succ d ih =>
      rintro (_ | ⟨k, l, r⟩)
      · rfl
      · exact ih l

  have h_appLD_eq_pos :
      ∀ (d : ℕ) (f : _root_.BinaryTree ℕ → _root_.BinaryTree ℕ) (t : _root_.BinaryTree ℕ),
        applyAtLeftDepthGen f t d = applyAtPosGen f t (List.replicate d .L) := by
    intro d
    induction d with
    | zero => intro f t; simp only [List.replicate_zero, h_appLD_zero, h_appPos_nil]
    | succ d ih =>
      intro f t
      rcases t with _ | ⟨k, l, r⟩
      · rfl
      · simp only [applyAtLeftDepthGen, List.replicate_succ, applyAtPosGen, ih]

  have h_subLD_add :
      ∀ (d1 d2 : ℕ) (t : _root_.BinaryTree ℕ),
        subtreeAtLeftDepthGen t (d1 + d2) =
          subtreeAtLeftDepthGen (subtreeAtLeftDepthGen t d1) d2 := by
    intro d1
    induction d1 with
    | zero => intro d2 t; simp only [Nat.zero_add, h_subLD_zero]
    | succ d1 ih =>
      intro d2 t
      rw [Nat.succ_add]
      rcases t with _ | ⟨k, l, r⟩
      · cases d2 <;> rfl
      · exact ih d2 l

  have h_appLD_comp :
      ∀ (g d : ℕ) (h f : _root_.BinaryTree ℕ → _root_.BinaryTree ℕ) (t : _root_.BinaryTree ℕ),
        applyAtLeftDepthGen h (applyAtLeftDepthGen f t g) (g + d) =
          applyAtLeftDepthGen (fun s => applyAtLeftDepthGen h (f s) d) t g := by
    intro g
    induction g with
    | zero => intro d h f t; simp only [Nat.zero_add, h_appLD_zero]
    | succ g ih =>
      intro d h f t
      rw [Nat.succ_add]
      rcases t with _ | ⟨k, l, r⟩
      · rfl
      · simp only [applyAtLeftDepthGen, ih]

  have h_appLD_congr :
      ∀ (g : ℕ) (f1 f2 : _root_.BinaryTree ℕ → _root_.BinaryTree ℕ) (t : _root_.BinaryTree ℕ),
        f1 (subtreeAtLeftDepthGen t g) = f2 (subtreeAtLeftDepthGen t g) →
        applyAtLeftDepthGen f1 t g = applyAtLeftDepthGen f2 t g := by
    intro g
    induction g with
    | zero => intro f1 f2 t h; simpa only [h_subLD_zero, h_appLD_zero] using h
    | succ g ih =>
      intro f1 f2 t h
      rcases t with _ | ⟨k, l, r⟩
      · rfl
      · exact congrArg (fun x => _root_.BinaryTree.node k x r) (ih f1 f2 l h)

  have h_subLD_after_app :
      ∀ (g d : ℕ) (f : _root_.BinaryTree ℕ → _root_.BinaryTree ℕ) (t : _root_.BinaryTree ℕ),
        f .nil = .nil →
        subtreeAtLeftDepthGen (applyAtLeftDepthGen f t g) (g + d) =
          subtreeAtLeftDepthGen (f (subtreeAtLeftDepthGen t g)) d := by
    intro g
    induction g with
    | zero => intro d f t _; simp only [Nat.zero_add, h_appLD_zero, h_subLD_zero]
    | succ g ih =>
      intro d f t hf0
      rw [Nat.succ_add]
      rcases t with _ | ⟨k, l, r⟩
      · simp only [applyAtLeftDepthGen, subtreeAtLeftDepthGen, hf0]
        cases d <;> rfl
      · exact ih d f l hf0


  have h_peel_bot_root :
      ∀ (mid_gaps : List ℕ) (g_bot : ℕ) (u : _root_.BinaryTree ℕ),
        validGappedCascadeAtRoot Δ' (eraseKeys u) (mid_gaps ++ [g_bot]) →
        allPairsInterblock S u (mid_gaps ++ [g_bot]) = true →
        let u' := execGappedCascadeAtRootGen u mid_gaps
        let δ := gapsLeftOffset (mid_gaps ++ [g_bot])
        validGappedCascadeAtRoot Δ' (eraseKeys u) mid_gaps ∧
        allPairsInterblock S u mid_gaps = true ∧
        2 ≤ leftSpineLen (eraseKeys (subtreeAtLeftDepthGen u' δ)) ∧
        applyAtLeftDepthGen _root_.BinaryTree.rotateRight u' δ =
          execGappedCascadeAtRootGen u (mid_gaps ++ [g_bot]) := by
    intro mid_gaps g_bot
    induction mid_gaps with
    | nil =>
      intro u hvc hp
      simp only [List.nil_append] at hvc hp ⊢
      rcases u with _ | ⟨y, _ | ⟨x, a, b⟩, c⟩
      · simp [allPairsInterblock] at hp
      · simp [allPairsInterblock] at hp
      · simp only [allPairsInterblock, Bool.and_eq_true] at hp
        obtain ⟨hxy, hp_bot⟩ := hp
        have h_sub_bot :
            2 ≤ leftSpineLen (eraseKeys (subtreeAtLeftDepthGen a g_bot)) := by
          rcases hbot : subtreeAtLeftDepthGen a g_bot with _ | ⟨y1, _ | ⟨x1, a1, b1⟩, c1⟩
          · rw [hbot] at hp_bot; simp [allPairsInterblock] at hp_bot
          · rw [hbot] at hp_bot; simp [allPairsInterblock] at hp_bot
          · simp only [eraseKeys, leftSpineLen]; omega
        refine ⟨?_, ?_, ?_, ?_⟩
        · simp only [validGappedCascadeAtRoot, eraseKeys, leftSpineLen]; omega
        · simp [allPairsInterblock, hxy]
        · exact h_sub_bot
        · rfl
    | cons g rest ih =>
      intro u hvc hp
      simp only [List.cons_append] at hvc hp
      rcases u with _ | ⟨y, _ | ⟨x, a, b⟩, c⟩
      · simp [allPairsInterblock] at hp
      · simp [allPairsInterblock] at hp
      · simp only [eraseKeys, validGappedCascadeAtRoot] at hvc
        rw [← h_ek_subLD g a] at hvc
        obtain ⟨hg_le, hvc_sub⟩ := hvc
        simp only [allPairsInterblock, Bool.and_eq_true] at hp
        obtain ⟨hxy, hp_sub⟩ := hp
        obtain ⟨hvc_mid, hp_mid, hspine_bot, hex_bot⟩ :=
          ih (subtreeAtLeftDepthGen a g) hvc_sub hp_sub
        let δ_rest := gapsLeftOffset (rest ++ [g_bot])
        have hf0 : (fun s : _root_.BinaryTree ℕ => execGappedCascadeAtRootGen s rest) .nil = .nil := by
          cases rest <;> rfl
        have h_add_eq : (g + 1) + δ_rest = (g + δ_rest) + 1 := by omega
        refine ⟨?_, ?_, ?_, ?_⟩
        · simp only [eraseKeys, validGappedCascadeAtRoot, ← h_ek_subLD g a]
          exact ⟨hg_le, hvc_mid⟩
        · simp only [allPairsInterblock, Bool.and_eq_true]
          exact ⟨hxy, hp_mid⟩
        · change 2 ≤ leftSpineLen (eraseKeys (subtreeAtLeftDepthGen
            (.node x
              (applyAtLeftDepthGen (fun s => execGappedCascadeAtRootGen s rest) a g) (.node y b c)) ((g + 1) + δ_rest)))
          rw [h_add_eq]
          simp only [subtreeAtLeftDepthGen]
          rw [h_subLD_after_app g δ_rest _ a hf0]
          exact hspine_bot
        · change applyAtLeftDepthGen _root_.BinaryTree.rotateRight
            (.node x
              (applyAtLeftDepthGen (fun s => execGappedCascadeAtRootGen s rest) a g) (.node y b c)) ((g + 1) + δ_rest) = _
          rw [h_add_eq]
          simp only [applyAtLeftDepthGen, List.cons_append, execGappedCascadeAtRootGen]
          rw [h_appLD_comp g δ_rest _root_.BinaryTree.rotateRight
            (fun s => execGappedCascadeAtRootGen s rest) a]
          congr 1
          exact h_appLD_congr g _ _ a hex_bot

  have h_single_interblock_inv :
      ∀ (p : List Dir) (U : _root_.BinaryTree ℕ) (a : ℕ) (A B C : _root_.BinaryTree ℕ) (x y : ℕ),
        IsRangeBST a U →
        subtreeAtPosGen U p = .node y (.node x A B) C →
        x / S < y / S →
        let U' := execRightRotOpGen U (.single p)
        IsRangeBST a U' ∧
        U'.num_nodes = U.num_nodes ∧
        ∀ m : ℕ, restrictInterval (m * S) ((m + 1) * S) U' =
          restrictInterval (m * S) ((m + 1) * S) U := by
    intro p
    induction p with
    | nil =>
      intro U a A B C x y hU hsub hxy_div
      rw [h_subPos_nil] at hsub
      subst hsub
      obtain ⟨hy_eq, ⟨hx_eq, hA, hB⟩, hC⟩ := hU
      simp only [_root_.BinaryTree.num_nodes] at hy_eq
      refine ⟨?_, ?_, ?_⟩
      · refine ⟨hx_eq, hA, ?_, hB, hC⟩
        omega
      · simp only [execRightRotOpGen, applyAtPosGen, _root_.BinaryTree.rotateRight, _root_.BinaryTree.num_nodes]
        omega
      · intro m
        let lo := m * S
        let hi := (m + 1) * S
        have hlo_hi : lo ≤ hi := Nat.mul_le_mul_right S (by omega)
        have hxy : x < y := by omega
        have h_not_both : ¬ (lo ≤ x ∧ y < hi) := by
          rintro ⟨hx_ge, hy_lt⟩
          have h1 : m ≤ x / S := (Nat.le_div_iff_mul_le hS_pos).mpr hx_ge
          have h2 : y / S < m + 1 := (Nat.div_lt_iff_lt_mul hS_pos).mpr hy_lt
          omega
        change restrictInterval lo hi (.node x A (.node y B C)) =
          restrictInterval lo hi (.node y (.node x A B) C)
        simp only [restrictInterval]
        split_ifs <;> first | rfl | omega
    | cons dir rest ih =>
      intro U a A B C x y hU hsub hxy_div
      rcases U with _ | ⟨K, L, R⟩
      · simp [subtreeAtPosGen] at hsub
      · obtain ⟨hK, hL, hR⟩ := hU
        cases dir with
        | L =>
          obtain ⟨hL', hnL', hriL'⟩ := ih L a A B C x y hL hsub hxy_div
          refine ⟨⟨by simp [execRightRotOpGen] at hnL' ⊢; omega, hL', hR⟩, ?_, ?_⟩
          · simp only [execRightRotOpGen, applyAtPosGen, _root_.BinaryTree.num_nodes] at hnL' ⊢
            omega
          · intro m
            dsimp (config := { failIfUnchanged := false }) only [execRightRotOpGen] at hriL' ⊢
            simp only [applyAtPosGen, restrictInterval, hriL' m]
        | R =>
          obtain ⟨hR', hnR', hriR'⟩ := ih R (K + 1) A B C x y hR hsub hxy_div
          refine ⟨⟨hK, hL, hR'⟩, ?_, ?_⟩
          · simp only [execRightRotOpGen, applyAtPosGen, _root_.BinaryTree.num_nodes] at hnR' ⊢
            omega
          · intro m
            dsimp (config := { failIfUnchanged := false }) only [execRightRotOpGen] at hriR' ⊢
            simp only [applyAtPosGen, restrictInterval, hriR' m]

  have h_casc_interblock_inv :
      ∀ (gs : List ℕ) (U : _root_.BinaryTree ℕ) (p : List Dir),
        IsRangeBST 0 U →
        allPairsInterblock S (subtreeAtPosGen U p) gs = true →
        let U' := execRightRotOpGen U (.cascade p gs)
        IsRangeBST 0 U' ∧
        ∀ m : ℕ, blockTree S m U' = blockTree S m U := by
    intro gs
    induction gs with
    | nil =>
      intro U p hU hp
      rcases hsub : subtreeAtPosGen U p with _ | ⟨y, _ | ⟨x, A, B⟩, C⟩
      · rw [hsub] at hp; simp [allPairsInterblock] at hp
      · rw [hsub] at hp; simp [allPairsInterblock] at hp
      · rw [hsub] at hp
        simp only [allPairsInterblock, decide_eq_true_eq] at hp
        obtain ⟨hU', _, hri⟩ := h_single_interblock_inv p U 0 A B C x y hU hsub hp
        exact ⟨hU', hri⟩
    | cons g rest ih =>
      intro U p hU hp
      rcases hsub : subtreeAtPosGen U p with _ | ⟨y, _ | ⟨x, A, B⟩, C⟩
      · rw [hsub] at hp; simp [allPairsInterblock] at hp
      · rw [hsub] at hp; simp [allPairsInterblock] at hp
      · rw [hsub] at hp
        simp only [allPairsInterblock, Bool.and_eq_true, decide_eq_true_eq] at hp
        obtain ⟨hxy, hp_rest⟩ := hp
        obtain ⟨hU1, _, hri1⟩ := h_single_interblock_inv p U 0 A B C x y hU hsub hxy
        let U1 := execRightRotOpGen U (.single p)
        let p' := p ++ List.replicate (g + 1) .L
        have hsub_U1 : subtreeAtPosGen U1 p' = subtreeAtLeftDepthGen A g := by
          dsimp (config := { failIfUnchanged := false }) only [U1, p', execRightRotOpGen]
          rw [h_subPos_app, h_subPos_after_app p _root_.BinaryTree.rotateRight U (by simp [hsub]), hsub]
          rw [← h_subLD_eq_pos (g + 1)]
          rfl
        have hex_eq : execRightRotOpGen U (.cascade p (g :: rest)) =
            execRightRotOpGen U1 (.cascade p' rest) := by
          dsimp (config := { failIfUnchanged := false }) only [U1, p', execRightRotOpGen]
          rw [h_appPos_app, h_appPos_same p _ _root_.BinaryTree.rotateRight U rfl]
          refine h_appPos_congr p _ _ U ?_
          rw [hsub]
          simp only [_root_.BinaryTree.rotateRight, ← h_appLD_eq_pos (g + 1)]
          rfl
        rw [hex_eq]
        rw [← hsub_U1] at hp_rest
        obtain ⟨hU2, hri2⟩ := ih U1 p' hU1 hp_rest
        exact ⟨hU2, fun m => (hri2 m).trans (hri1 m)⟩


  have h_mem_pre_bst :
      ∀ (t : _root_.BinaryTree ℕ) (a x : ℕ),
        IsRangeBST a t → (x ∈ preorderList t ↔ a ≤ x ∧ x < a + t.num_nodes) := by
    intro t
    induction t with
    | nil =>
      intro a x _
      simp [preorderList, _root_.BinaryTree.num_nodes]
    | node k l r ihl ihr =>
      intro a x ⟨hk, hl, hr⟩
      simp only [preorderList, List.mem_cons, List.mem_append, _root_.BinaryTree.num_nodes,
        ihl a x hl, ihr (k + 1) x hr]
      omega

  have h_mem_subPos :
      ∀ (p : List Dir) (t : _root_.BinaryTree ℕ) (x : ℕ),
        x ∈ preorderList (subtreeAtPosGen t p) → x ∈ preorderList t := by
    intro p
    induction p with
    | nil => intro t x h; rwa [h_subPos_nil] at h
    | cons dir rest ih =>
      rintro (_ | ⟨k, l, r⟩) x h
      · simp [subtreeAtPosGen, preorderList] at h
      · cases dir with
        | L =>
          simp only [preorderList, List.mem_cons, List.mem_append]
          exact Or.inr (Or.inl (ih l x h))
        | R =>
          simp only [preorderList, List.mem_cons, List.mem_append]
          exact Or.inr (Or.inr (ih r x h))

  have h_bst_subPos :
      ∀ (p : List Dir) (t : _root_.BinaryTree ℕ) (a : ℕ),
        IsRangeBST a t → ∃ a', IsRangeBST a' (subtreeAtPosGen t p) := by
    intro p
    induction p with
    | nil => intro t a h; rw [h_subPos_nil]; exact ⟨a, h⟩
    | cons dir rest ih =>
      rintro (_ | ⟨k, l, r⟩) a h
      · exact ⟨0, trivial⟩
      · obtain ⟨_, hl, hr⟩ := h
        cases dir with
        | L => exact ih l a hl
        | R => exact ih r (k + 1) hr

  have h_mem_restrict_sub :
      ∀ (lo hi : ℕ) (t : _root_.BinaryTree ℕ) (x : ℕ),
        x ∈ preorderList (restrictInterval lo hi t) → x ∈ preorderList t := by
    intro lo hi t
    induction t with
    | nil => intro x h; exact h
    | node k l r ihl ihr =>
      intro x h
      simp only [restrictInterval] at h
      split_ifs at h
      · exact List.mem_cons_of_mem k (List.mem_append_right _ (ihr x h))
      · exact List.mem_cons_of_mem k (List.mem_append_left _ (ihl x h))
      · simp only [preorderList, List.mem_cons, List.mem_append] at h ⊢
        rcases h with rfl | hl | hr
        · exact Or.inl rfl
        · exact Or.inr (Or.inl (ihl x hl))
        · exact Or.inr (Or.inr (ihr x hr))

  have h_mem_restrict_of_mem :
      ∀ (lo hi : ℕ) (t : _root_.BinaryTree ℕ) (a x : ℕ),
        IsRangeBST a t →
        x ∈ preorderList t →
        lo ≤ x →
        x < hi →
        x ∈ preorderList (restrictInterval lo hi t) := by
    intro lo hi t
    induction t with
    | nil => intro _ _ _ h _ _; simp [preorderList] at h
    | node k l r ihl ihr =>
      intro a x ⟨hk, hl, hr⟩ hx hlo hhi
      simp only [preorderList, List.mem_cons, List.mem_append] at hx
      simp only [restrictInterval]
      split_ifs with hk_lt hk_ge
      · rcases hx with rfl | hxl | hxr
        · omega
        · have := (h_mem_pre_bst l a x hl).mp hxl
          omega
        · exact ihr (k + 1) x hr hxr hlo hhi
      · rcases hx with rfl | hxl | hxr
        · omega
        · exact ihl a x hl hxl hlo hhi
        · have := (h_mem_pre_bst r (k + 1) x hr).mp hxr
          omega
      · simp only [preorderList, List.mem_cons, List.mem_append]
        rcases hx with rfl | hxl | hxr
        · exact Or.inl rfl
        · exact Or.inr (Or.inl (ihl a x hl hxl hlo hhi))
        · exact Or.inr (Or.inr (ihr (k + 1) x hr hxr hlo hhi))

  have h_nodup_restrict :
      ∀ (lo hi : ℕ) (t : _root_.BinaryTree ℕ) (a : ℕ),
        IsRangeBST a t → (preorderList (restrictInterval lo hi t)).Nodup := by
    intro lo hi t
    induction t with
    | nil => intro _ _; exact List.nodup_nil
    | node k l r ihl ihr =>
      intro a ⟨hk, hl, hr⟩
      simp only [restrictInterval]
      split_ifs
      · exact ihr (k + 1) hr
      · exact ihl a hl
      · simp only [preorderList, List.nodup_cons, List.mem_append]
        refine ⟨?_, List.nodup_append.mpr ⟨ihl a hl, ihr (k + 1) hr, ?_⟩⟩
        · rintro (hkl | hkr)
          · have := (h_mem_pre_bst l a k hl).mp (h_mem_restrict_sub lo hi l k hkl)
            omega
          · have := (h_mem_pre_bst r (k + 1) k hr).mp (h_mem_restrict_sub lo hi r k hkr)
            omega
        · intro u hu v hv
          have hu' := (h_mem_pre_bst l a u hl).mp (h_mem_restrict_sub lo hi l u hu)
          have hv' := (h_mem_pre_bst r (k + 1) v hr).mp (h_mem_restrict_sub lo hi r v hv)
          omega

  have h_restrict_subPos_eq :
      ∀ (lo hi : ℕ), lo ≤ hi →
      ∀ (p : List Dir) (W : _root_.BinaryTree ℕ) (aW : ℕ),
        IsRangeBST aW W →
        (∃ x ∈ preorderList (subtreeAtPosGen W p), x < lo) →
        (∃ z ∈ preorderList (subtreeAtPosGen W p), hi ≤ z) →
        restrictInterval lo hi W = restrictInterval lo hi (subtreeAtPosGen W p) := by
    intro lo hi hlo_hi p
    induction p with
    | nil => intro W _ _ _ _; rw [h_subPos_nil]
    | cons dir rest ih =>
      rintro (_ | ⟨K, L, R⟩) aW hW ⟨x, hx_mem, hx_lt⟩ ⟨z, hz_mem, hz_ge⟩
      · simp [subtreeAtPosGen, preorderList] at hx_mem
      · obtain ⟨hK, hL, hR⟩ := hW
        cases dir with
        | L =>
          have hz_L : z ∈ preorderList L := h_mem_subPos rest L z hz_mem
          have hz_b := (h_mem_pre_bst L aW z hL).mp hz_L
          have hK_not_lt : ¬ K < lo := by omega
          have hK_ge : hi ≤ K := by omega
          simp only [restrictInterval, hK_not_lt, hK_ge, ↓reduceIte, subtreeAtPosGen]
          exact ih L aW hL ⟨x, hx_mem, hx_lt⟩ ⟨z, hz_mem, hz_ge⟩
        | R =>
          have hx_R : x ∈ preorderList R := h_mem_subPos rest R x hx_mem
          have hx_b := (h_mem_pre_bst R (K + 1) x hR).mp hx_R
          have hK_lt : K < lo := by omega
          simp only [restrictInterval, hK_lt, ↓reduceIte, subtreeAtPosGen]
          exact ih R (K + 1) hR ⟨x, hx_mem, hx_lt⟩ ⟨z, hz_mem, hz_ge⟩

  have h_subPos_pre_embed :
      ∀ (lo hi : ℕ) (p : List Dir) (W : _root_.BinaryTree ℕ) (aW : ℕ) (l r : _root_.BinaryTree ℕ) (k : ℕ),
        IsRangeBST aW W →
        subtreeAtPosGen W p = .node k l r →
        lo ≤ k →
        k < hi →
        ∃ pref suff : List ℕ,
          preorderList (restrictInterval lo hi W) =
            pref ++ (k :: (preorderList (restrictInterval lo hi l) ++
              preorderList (restrictInterval lo hi r))) ++ suff := by
    intro lo hi p
    induction p with
    | nil =>
      intro W _ l r k _ hsub hlo hhi
      rw [h_subPos_nil] at hsub
      subst hsub
      have hk1 : ¬ k < lo := by omega
      have hk2 : ¬ hi ≤ k := by omega
      refine ⟨[], [], ?_⟩
      simp [restrictInterval, hk1, hk2, preorderList]
    | cons dir rest ih =>
      rintro (_ | ⟨K, L, R⟩) aW l r k hW hsub hlo hhi
      · simp [subtreeAtPosGen] at hsub
      · obtain ⟨hK, hL, hR⟩ := hW
        have hk_in : k ∈ preorderList (subtreeAtPosGen (.node K L R) (dir :: rest)) := by
          rw [hsub]; exact List.mem_cons_self
        cases dir with
        | L =>
          have hk_L : k ∈ preorderList L := h_mem_subPos rest L k hk_in
          have hk_b := (h_mem_pre_bst L aW k hL).mp hk_L
          have hK_not_lt : ¬ K < lo := by omega
          obtain ⟨pref, suff, h_ih⟩ := ih L aW l r k hL hsub hlo hhi
          simp only [restrictInterval, hK_not_lt, ↓reduceIte]
          split_ifs with hK_ge
          · exact ⟨pref, suff, h_ih⟩
          · refine ⟨K :: pref, suff ++ preorderList (restrictInterval lo hi R), ?_⟩
            simp [preorderList, h_ih, List.append_assoc]
        | R =>
          have hk_R : k ∈ preorderList R := h_mem_subPos rest R k hk_in
          have hk_b := (h_mem_pre_bst R (K + 1) k hR).mp hk_R
          have hK_not_ge : ¬ hi ≤ K := by omega
          obtain ⟨pref, suff, h_ih⟩ := ih R (K + 1) l r k hR hsub hlo hhi
          simp only [restrictInterval, hK_not_ge, ↓reduceIte]
          split_ifs with hK_lt
          · exact ⟨pref, suff, h_ih⟩
          · refine ⟨K :: (preorderList (restrictInterval lo hi L) ++ pref), suff, ?_⟩
            simp [preorderList, h_ih, List.append_assoc]

  have h_extract_ne_empty :
      ∀ (isG : ℕ → Bool) (w : _root_.BinaryTree ℕ),
        extractGlobalTree isG w ≠ .nil → ∃ x ∈ preorderList w, isG x = true := by
    intro isG w
    induction w with
    | nil =>
      intro h
      exact absurd rfl h
    | node wk wl wr ihl ihr =>
      intro h
      cases hwk : isG wk with
      | true =>
        exact ⟨wk, List.mem_cons_self, hwk⟩
      | false =>
        simp only [extractGlobalTree, hwk, Bool.false_eq_true, ↓reduceIte] at h
        cases hwl : extractGlobalTree isG wl with
        | nil =>
          rw [hwl] at h
          obtain ⟨x, hx_m, hx_g⟩ := ihr h
          exact ⟨x, List.mem_cons_of_mem wk (List.mem_append_right _ hx_m), hx_g⟩
        | node b a c =>
          have hwl_ne : extractGlobalTree isG wl ≠ .nil := by simp [hwl]
          obtain ⟨x, hx_m, hx_g⟩ := ihl hwl_ne
          exact ⟨x, List.mem_cons_of_mem wk (List.mem_append_left _ hx_m), hx_g⟩

  have h_mem_take_mid :
      ∀ (xs ys : List ℕ) (y D : ℕ),
        xs.length < D → y ∈ (xs ++ y :: ys).take D := by
    intro xs ys y
    induction xs with
    | nil =>
      rintro (_ | D) hd
      · omega
      · simp [List.take_succ_cons]
    | cons x xs ih =>
      rintro (_ | D) hd
      · simp at hd
      · simp only [List.length_cons] at hd
        simp only [List.cons_append, List.take_succ_cons, List.mem_cons]
        exact Or.inr (ih D (by omega))

  have h_bst_nonSplitting :
      ∀ (D : ℕ), 1 ≤ D →
      ∀ (U : _root_.BinaryTree ℕ), IsRangeBST 0 U →
        NonSplittingGlobal (isGlobalKey D S U) U := by
    intro D hD1 U hU
    let isG := isGlobalKey D S U
    have h_aux :
        ∀ (t : _root_.BinaryTree ℕ) (p : List Dir),
          subtreeAtPosGen U p = t → NonSplittingGlobal isG t := by
      intro t
      induction t with
      | nil => intro _ _; exact trivial
      | node k l r ihl ihr =>
        intro p hp_eq
        have hp_l : subtreeAtPosGen U (p ++ [.L]) = l := by
          rw [h_subPos_app, hp_eq]; exact h_subPos_nil l
        have hp_r : subtreeAtPosGen U (p ++ [.R]) = r := by
          rw [h_subPos_app, hp_eq]; exact h_subPos_nil r
        refine ⟨?_, ihl (p ++ [.L]) hp_l, ihr (p ++ [.R]) hp_r⟩
        intro hk_false
        by_contra h_both
        push_neg at h_both
        obtain ⟨hl_ne, hr_ne⟩ := h_both
        obtain ⟨x, hx_mem, hx_G⟩ := h_extract_ne_empty isG l hl_ne
        obtain ⟨z, hz_mem, hz_G⟩ := h_extract_ne_empty isG r hr_ne
        obtain ⟨a_t, hbst_t⟩ := h_bst_subPos p U 0 hU
        rw [hp_eq] at hbst_t
        obtain ⟨hk_a, hbst_l, hbst_r⟩ := hbst_t
        have hx_b := (h_mem_pre_bst l a_t x hbst_l).mp hx_mem
        have hz_b := (h_mem_pre_bst r (k + 1) z hbst_r).mp hz_mem
        let m := k / S
        let lo := m * S
        let hi := (m + 1) * S
        have hlo_k : lo ≤ k := Nat.div_mul_le_self k S
        have hk_hi : k < hi := (Nat.div_lt_iff_lt_mul hS_pos).mp (by dsimp (config := { failIfUnchanged := false }) [m]; omega)
        have hlo_hi : lo ≤ hi := by omega
        by_cases h_out : x < lo ∧ hi ≤ z
        · obtain ⟨hx_lt, hz_ge⟩ := h_out
          have hx_in_t : x ∈ preorderList (subtreeAtPosGen U p) := by
            rw [hp_eq]; exact List.mem_cons_of_mem k (List.mem_append_left _ hx_mem)
          have hz_in_t : z ∈ preorderList (subtreeAtPosGen U p) := by
            rw [hp_eq]; exact List.mem_cons_of_mem k (List.mem_append_right _ hz_mem)
          have hblk_eq := h_restrict_subPos_eq lo hi hlo_hi p U 0 hU
            ⟨x, hx_in_t, hx_lt⟩ ⟨z, hz_in_t, hz_ge⟩
          rw [hp_eq] at hblk_eq
          have hk1 : ¬ k < lo := by omega
          have hk2 : ¬ hi ≤ k := by omega
          rcases D with _ | D0
          · omega
          · have hk_take : k ∈ (preorderList (blockTree S m U)).take (D0 + 1) := by
              change k ∈ (preorderList (restrictInterval lo hi U)).take (D0 + 1)
              rw [hblk_eq]
              simp [restrictInterval, hk1, hk2, preorderList, List.take_succ_cons]
            have hk_true : isG k = true := by
              dsimp (config := { failIfUnchanged := false }) only [isG, isGlobalKey]
              exact decide_eq_true hk_take
            rw [hk_true] at hk_false
            contradiction
        · have h_in_one :
              ∃ w : ℕ, isG w = true ∧ lo ≤ w ∧ w < hi ∧
                w ∈ preorderList (restrictInterval lo hi l) ++
                  preorderList (restrictInterval lo hi r) := by
            by_cases hx_lo : lo ≤ x
            · refine ⟨x, hx_G, hx_lo, by omega, List.mem_append_left _ ?_⟩
              exact h_mem_restrict_of_mem lo hi l a_t x hbst_l hx_mem hx_lo (by omega)
            · have hz_hi : z < hi := by omega
              refine ⟨z, hz_G, by omega, hz_hi, List.mem_append_right _ ?_⟩
              exact h_mem_restrict_of_mem lo hi r (k + 1) z hbst_r hz_mem (by omega) hz_hi
          obtain ⟨w, hw_G, hw_lo, hw_hi, hw_mid⟩ := h_in_one
          have hw_div : w / S = m := by
            have h1 : m ≤ w / S := (Nat.le_div_iff_mul_le hS_pos).mpr hw_lo
            have h2 : w / S < m + 1 := (Nat.div_lt_iff_lt_mul hS_pos).mpr hw_hi
            omega
          obtain ⟨pref, suff, hpre_eq⟩ := h_subPos_pre_embed lo hi p U 0 l r k hU hp_eq hlo_k hk_hi
          have hnodup := h_nodup_restrict lo hi U 0 hU
          rw [hpre_eq] at hnodup
          have hnodup1 := (List.nodup_append.mp hnodup).1
          have hw_not_pref : w ∉ pref := by
            intro hw_p
            have hneq := (List.nodup_append.mp hnodup1).2.2 w hw_p w (List.mem_cons_of_mem k hw_mid)
            exact hneq rfl
          dsimp (config := { failIfUnchanged := false }) only [isG, isGlobalKey] at hw_G
          rw [decide_eq_true_eq, hw_div] at hw_G
          change w ∈ (preorderList (restrictInterval lo hi U)).take D at hw_G
          rw [hpre_eq, List.append_assoc] at hw_G
          have hpref_lt : pref.length < D := by
            by_contra h_ge
            rw [List.take_append_of_le_length (by omega : D ≤ pref.length)] at hw_G
            exact hw_not_pref (List.mem_of_mem_take hw_G)
          have hk_take : k ∈ (preorderList (restrictInterval lo hi U)).take D := by
            rw [hpre_eq, List.append_assoc, List.cons_append]
            exact h_mem_take_mid pref _ k D hpref_lt
          have hk_true : isG k = true := by
            dsimp (config := { failIfUnchanged := false }) only [isG, isGlobalKey]
            exact decide_eq_true hk_take
          rw [hk_true] at hk_false
          contradiction
    exact h_aux U [] (h_subPos_nil U)


  have h_bst_subLD :
      ∀ (d : ℕ) (t : _root_.BinaryTree ℕ) (a : ℕ),
        IsRangeBST a t → IsRangeBST a (subtreeAtLeftDepthGen t d) := by
    intro d
    induction d with
    | zero => intro t a h; rwa [h_subLD_zero]
    | succ d ih =>
      rintro (_ | ⟨k, l, r⟩) a h
      · trivial
      · exact ih l a h.2.1

  have h_mem_subLD :
      ∀ (d : ℕ) (t : _root_.BinaryTree ℕ) (x : ℕ),
        x ∈ preorderList (subtreeAtLeftDepthGen t d) → x ∈ preorderList t := by
    intro d t x h
    rw [h_subLD_eq_pos] at h
    exact h_mem_subPos (List.replicate d .L) t x h

  have h_mem_take_app_left :
      ∀ (xs ys : List ℕ) (n x : ℕ),
        x ∈ xs.take n → x ∈ (xs ++ ys).take n := by
    intro xs ys
    induction xs with
    | nil =>
      intro n x h
      simp at h
    | cons a xs ih =>
      rintro (_ | n) x h
      · simp at h
      · simp only [List.take_succ_cons, List.cons_append, List.mem_cons] at h ⊢
        rcases h with rfl | h
        · exact Or.inl rfl
        · exact Or.inr (ih n x h)

  have h_ld_mem_take :
      ∀ (d D : ℕ) (B bl br : _root_.BinaryTree ℕ) (v : ℕ),
        d < D →
        subtreeAtLeftDepthGen B d = .node v bl br →
        v ∈ (preorderList B).take D := by
    intro d
    induction d with
    | zero =>
      rintro (_ | D) B bl br v hd hsub
      · omega
      · rw [h_subLD_zero] at hsub
        subst hsub
        simp [preorderList, List.take_succ_cons]
    | succ d ih =>
      rintro (_ | D) (_ | ⟨K, L, R⟩) bl br v hd hsub
      · omega
      · omega
      · simp [subtreeAtLeftDepthGen] at hsub
      · simp only [subtreeAtLeftDepthGen] at hsub
        have hv_L : v ∈ (preorderList L).take D := ih D L bl br v (by omega) hsub
        simp only [preorderList, List.take_succ_cons, List.mem_cons]
        exact Or.inr (h_mem_take_app_left (preorderList L) (preorderList R) D v hv_L)

  have h_restrict_ld_drop_hi :
      ∀ (L0 lo hi : ℕ), lo ≤ hi →
      ∀ (t pl pr : _root_.BinaryTree ℕ) (a y_anc : ℕ),
        IsRangeBST a t →
        subtreeAtLeftDepthGen t L0 = .node y_anc pl pr →
        hi ≤ y_anc →
        restrictInterval lo hi t = restrictInterval lo hi pl := by
    intro L0 lo hi hlo_hi
    induction L0 with
    | zero =>
      intro t pl pr a y_anc _ hsub hy_ge
      rw [h_subLD_zero] at hsub
      subst hsub
      have hy_not_lt : ¬ y_anc < lo := by omega
      simp [restrictInterval, hy_not_lt, hy_ge]
    | succ L0 ih =>
      rintro (_ | ⟨K, L, R⟩) pl pr a y_anc ht hsub hy_ge
      · simp [subtreeAtLeftDepthGen] at hsub
      · obtain ⟨hK, hL, _⟩ := ht
        simp only [subtreeAtLeftDepthGen] at hsub
        have hy_in_sub : y_anc ∈ preorderList (subtreeAtLeftDepthGen L L0) := by
          rw [hsub]; exact List.mem_cons_self
        have hy_in_L : y_anc ∈ preorderList L := h_mem_subLD L0 L y_anc hy_in_sub
        have hy_b := (h_mem_pre_bst L a y_anc hL).mp hy_in_L
        have hK_not_lt : ¬ K < lo := by omega
        have hK_ge : hi ≤ K := by omega
        simp only [restrictInterval, hK_not_lt, hK_ge, ↓reduceIte]
        exact ih L pl pr a y_anc hL hsub hy_ge

  have h_restrict_ld_node :
      ∀ (c lo hi : ℕ) (t vl vr : _root_.BinaryTree ℕ) (a v : ℕ),
        IsRangeBST a t →
        subtreeAtLeftDepthGen t c = .node v vl vr →
        lo ≤ v →
        v < hi →
        ∃ d ≤ c, ∃ rl rr,
          subtreeAtLeftDepthGen (restrictInterval lo hi t) d = .node v rl rr := by
    intro c lo hi
    induction c with
    | zero =>
      intro t vl vr a v _ hsub hv_lo hv_hi
      rw [h_subLD_zero] at hsub
      subst hsub
      have hv1 : ¬ v < lo := by omega
      have hv2 : ¬ hi ≤ v := by omega
      refine ⟨0, le_rfl, restrictInterval lo hi vl, restrictInterval lo hi vr, ?_⟩
      rw [h_subLD_zero]
      simp [restrictInterval, hv1, hv2]
    | succ c ih =>
      rintro (_ | ⟨K, L, R⟩) vl vr a v ht hsub hv_lo hv_hi
      · simp [subtreeAtLeftDepthGen] at hsub
      · obtain ⟨hK, hL, _⟩ := ht
        simp only [subtreeAtLeftDepthGen] at hsub
        have hv_in_sub : v ∈ preorderList (subtreeAtLeftDepthGen L c) := by
          rw [hsub]; exact List.mem_cons_self
        have hv_in_L : v ∈ preorderList L := h_mem_subLD c L v hv_in_sub
        have hv_b := (h_mem_pre_bst L a v hL).mp hv_in_L
        have hK_not_lt : ¬ K < lo := by omega
        obtain ⟨d, hd_le, rl, rr, hd_eq⟩ := ih L vl vr a v hL hsub hv_lo hv_hi
        simp only [restrictInterval, hK_not_lt, ↓reduceIte]
        split_ifs with hK_ge
        · exact ⟨d, by omega, rl, rr, hd_eq⟩
        · exact ⟨d + 1, by omega, rl, rr, hd_eq⟩

  let isG := isGlobalKey (Δ' + 2) S T
  let s_top := subtreeAtPosGen T pos
  obtain ⟨a_top0, hbst_stop⟩ := h_bst_subPos pos T 0 hbst

  have h_spine_node_global :
      ∀ (L0 c : ℕ), c ≤ Δ' + 1 →
      ∀ (pl pr vl vr : _root_.BinaryTree ℕ) (y_anc v : ℕ),
        subtreeAtLeftDepthGen s_top L0 = .node y_anc pl pr →
        subtreeAtLeftDepthGen pl c = .node v vl vr →
        (∃ x_bot ∈ preorderList s_top, x_bot / S < v / S) →
        v / S < y_anc / S →
        isG v = true := by
    intro L0 c hc_le pl pr vl vr y_anc v h_anc h_v ⟨x_bot, hx_mem, hx_div⟩ h_top
    let m := v / S
    let lo := m * S
    let hi := (m + 1) * S
    have hv_lo : lo ≤ v := Nat.div_mul_le_self v S
    have hv_hi : v < hi := (Nat.div_lt_iff_lt_mul hS_pos).mp (by dsimp (config := { failIfUnchanged := false }) [m]; omega)
    have hlo_hi : lo ≤ hi := by omega
    have hx_lt : x_bot < lo := (Nat.div_lt_iff_lt_mul hS_pos).mp hx_div
    have hy_ge : hi ≤ y_anc := (Nat.le_div_iff_mul_le hS_pos).mp (by dsimp (config := { failIfUnchanged := false }) [m]; omega)
    have hy_in_sub : y_anc ∈ preorderList (subtreeAtLeftDepthGen s_top L0) := by
      rw [h_anc]; exact List.mem_cons_self
    have hy_mem : y_anc ∈ preorderList s_top := h_mem_subLD L0 s_top y_anc hy_in_sub
    have hblk1 := h_restrict_subPos_eq lo hi hlo_hi pos T 0 hbst
      ⟨x_bot, hx_mem, hx_lt⟩ ⟨y_anc, hy_mem, hy_ge⟩
    have hblk2 := h_restrict_ld_drop_hi L0 lo hi hlo_hi s_top pl pr a_top0 y_anc
      hbst_stop h_anc hy_ge
    have hbst_anc := h_bst_subLD L0 s_top a_top0 hbst_stop
    rw [h_anc] at hbst_anc
    obtain ⟨d, hd_le, rl, rr, hd_eq⟩ :=
      h_restrict_ld_node c lo hi pl vl vr a_top0 v hbst_anc.2.1 h_v hv_lo hv_hi
    rw [← hblk2, ← hblk1] at hd_eq
    have hv_take : v ∈ (preorderList (blockTree S m T)).take (Δ' + 2) :=
      h_ld_mem_take d (Δ' + 2) (blockTree S m T) rl rr v (by omega) hd_eq
    dsimp (config := { failIfUnchanged := false }) only [isG, isGlobalKey]
    exact decide_eq_true hv_take

  have h_exists_bot_interblock :
      ∀ (gs : List ℕ) (g_bot : ℕ) (a b c : _root_.BinaryTree ℕ) (a0 x y : ℕ),
        IsRangeBST a0 (.node y (.node x a b) c) →
        allPairsInterblock S (.node y (.node x a b) c) (gs ++ [g_bot]) = true →
        ∃ x_bot ∈ preorderList a, x_bot / S < x / S := by
    intro gs
    induction gs with
    | nil =>
      intro g_bot a b c a0 x y hbst_u hp
      simp only [List.nil_append, allPairsInterblock, Bool.and_eq_true] at hp
      obtain ⟨_, hp_bot⟩ := hp
      rcases hbot : subtreeAtLeftDepthGen a g_bot with _ | ⟨y1, _ | ⟨x1, a1, b1⟩, c1⟩
      · rw [hbot] at hp_bot; simp [allPairsInterblock] at hp_bot
      · rw [hbot] at hp_bot; simp [allPairsInterblock] at hp_bot
      · rw [hbot] at hp_bot
        simp only [allPairsInterblock, decide_eq_true_eq] at hp_bot
        have hx1_sub : x1 ∈ preorderList (subtreeAtLeftDepthGen a g_bot) := by
          rw [hbot]
          exact List.mem_cons_of_mem y1 (List.mem_append_left _ List.mem_cons_self)
        have hy1_sub : y1 ∈ preorderList (subtreeAtLeftDepthGen a g_bot) := by
          rw [hbot]; exact List.mem_cons_self
        have hx1_a := h_mem_subLD g_bot a x1 hx1_sub
        have hy1_a := h_mem_subLD g_bot a y1 hy1_sub
        obtain ⟨_, ⟨hx_eq, ha_bst, _⟩, _⟩ := hbst_u
        have hy1_b := (h_mem_pre_bst a a0 y1 ha_bst).mp hy1_a
        have hy1_div : y1 / S ≤ x / S := Nat.div_le_div_right (by omega)
        exact ⟨x1, hx1_a, by omega⟩
    | cons g rest ih =>
      intro g_bot a b c a0 x y hbst_u hp
      simp only [List.cons_append, allPairsInterblock, Bool.and_eq_true] at hp
      obtain ⟨_, hp_sub⟩ := hp
      rcases hsub : subtreeAtLeftDepthGen a g with _ | ⟨y1, _ | ⟨x1, a1, b1⟩, c1⟩
      · rw [hsub] at hp_sub; simp [allPairsInterblock] at hp_sub
      · rw [hsub] at hp_sub; simp [allPairsInterblock] at hp_sub
      · rw [hsub] at hp_sub
        obtain ⟨_, ⟨hx_eq, ha_bst, _⟩, _⟩ := hbst_u
        have hbst_sub := h_bst_subLD g a a0 ha_bst
        rw [hsub] at hbst_sub
        obtain ⟨x_bot, hx_a1, hx_lt_x1⟩ := ih g_bot a1 b1 c1 a0 x1 y1 hbst_sub hp_sub
        have hx_sub : x_bot ∈ preorderList (subtreeAtLeftDepthGen a g) := by
          rw [hsub]
          exact List.mem_cons_of_mem y1
            (List.mem_append_left _ (List.mem_cons_of_mem x1 (List.mem_append_left _ hx_a1)))
        have hx1_sub : x1 ∈ preorderList (subtreeAtLeftDepthGen a g) := by
          rw [hsub]
          exact List.mem_cons_of_mem y1 (List.mem_append_left _ List.mem_cons_self)
        have hx_a := h_mem_subLD g a x_bot hx_sub
        have hx1_a := h_mem_subLD g a x1 hx1_sub
        have hx1_b := (h_mem_pre_bst a a0 x1 ha_bst).mp hx1_a
        have hx1_div : x1 / S ≤ x / S := Nat.div_le_div_right (by omega)
        exact ⟨x_bot, hx_a, by omega⟩

  have h_mk_lpg :
      ∀ (g : ℕ) (a : _root_.BinaryTree ℕ),
        subtreeAtLeftDepthGen a g ≠ .nil →
        (∀ j < g, ∀ wl wr w, subtreeAtLeftDepthGen a j = .node w wl wr → isG w = true) →
        leftPrefixGlobal isG a g := by
    intro g
    induction g with
    | zero =>
      intro a _ _
      cases a <;> trivial
    | succ g ih =>
      rintro (_ | ⟨k, l, r⟩) hne hall
      · exact absurd rfl hne
      · refine ⟨hall 0 (by omega) l r k (h_subLD_zero _), ih l hne ?_⟩
        intro j hj wl wr w hj_eq
        exact hall (j + 1) (by omega) wl wr w hj_eq

  have h_mid_casc_global :
      ∀ (gs : List ℕ) (g_bot L0 g_prev : ℕ) (a_prev b_prev c_prev : _root_.BinaryTree ℕ) (x_prev y_prev : ℕ),
        g_prev ≤ Δ' →
        subtreeAtLeftDepthGen s_top L0 = .node y_prev (.node x_prev a_prev b_prev) c_prev →
        x_prev / S < y_prev / S →
        validGappedCascadeAtRoot Δ' (eraseKeys (subtreeAtLeftDepthGen a_prev g_prev)) (gs ++ [g_bot]) →
        allPairsInterblock S (subtreeAtLeftDepthGen a_prev g_prev) (gs ++ [g_bot]) = true →
        allCascadeSpineGlobal isG (subtreeAtLeftDepthGen a_prev g_prev) gs := by
    intro gs
    induction gs with
    | nil =>
      intro g_bot L0 g_prev a_prev b_prev c_prev x_prev y_prev hg_prev h_anc hxy_prev _ hp
      simp only [List.nil_append] at hp
      rcases hu : subtreeAtLeftDepthGen a_prev g_prev with _ | ⟨y, _ | ⟨x, a, b⟩, c⟩
      · rw [hu] at hp; simp [allPairsInterblock] at hp
      · rw [hu] at hp; simp [allPairsInterblock] at hp
      · rw [hu] at hp
        have hxy : x / S < y / S := by
          simp only [allPairsInterblock, Bool.and_eq_true, decide_eq_true_eq] at hp
          exact hp.1
        let L_u := L0 + (g_prev + 2)
        have hu_stop : subtreeAtLeftDepthGen s_top L_u = .node y (.node x a b) c := by
          dsimp (config := { failIfUnchanged := false }) only [L_u]
          rw [h_subLD_add L0 (g_prev + 2) s_top, h_anc]
          exact hu
        have hbst_u := h_bst_subLD L_u s_top a_top0 hbst_stop
        rw [hu_stop] at hbst_u
        obtain ⟨x_bot, hx_a, hx_div⟩ :=
          h_exists_bot_interblock [] g_bot a b c a_top0 x y hbst_u (by simpa using hp)
        have hx_stop : x_bot ∈ preorderList s_top := by
          apply h_mem_subLD L_u s_top x_bot
          rw [hu_stop]
          exact List.mem_cons_of_mem y
            (List.mem_append_left _ (List.mem_cons_of_mem x (List.mem_append_left _ hx_a)))
        have hy_aprev : y ∈ preorderList a_prev := by
          apply h_mem_subLD g_prev a_prev y
          rw [hu]; exact List.mem_cons_self
        have hbst_anc := h_bst_subLD L0 s_top a_top0 hbst_stop
        rw [h_anc] at hbst_anc
        have hy_b := (h_mem_pre_bst a_prev a_top0 y hbst_anc.2.1.2.1).mp hy_aprev
        have hxprev_eq := hbst_anc.2.1.1
        have hy_lt_yprev : y / S < y_prev / S := by
          have : y / S ≤ x_prev / S := Nat.div_le_div_right (by omega)
          omega
        have hisG_y : isG y = true :=
          h_spine_node_global L0 (g_prev + 1) (by omega)
            (.node x_prev a_prev b_prev) c_prev (.node x a b) c y_prev y
            h_anc hu ⟨x_bot, hx_stop, by omega⟩ hy_lt_yprev
        have hisG_x : isG x = true :=
          h_spine_node_global L_u 0 (by omega)
            (.node x a b) c a b y x
            hu_stop (h_subLD_zero _) ⟨x_bot, hx_stop, hx_div⟩ hxy
        exact ⟨hisG_x, hisG_y⟩
    | cons g rest ih =>
      intro g_bot L0 g_prev a_prev b_prev c_prev x_prev y_prev hg_prev h_anc hxy_prev hvc hp
      simp only [List.cons_append] at hvc hp
      rcases hu : subtreeAtLeftDepthGen a_prev g_prev with _ | ⟨y, _ | ⟨x, a, b⟩, c⟩
      · rw [hu] at hp; simp [allPairsInterblock] at hp
      · rw [hu] at hp; simp [allPairsInterblock] at hp
      · rw [hu] at hvc hp
        simp only [eraseKeys, validGappedCascadeAtRoot] at hvc
        rw [← h_ek_subLD g a] at hvc
        obtain ⟨hg_le, hvc_sub⟩ := hvc
        simp only [allPairsInterblock, Bool.and_eq_true, decide_eq_true_eq] at hp
        obtain ⟨hxy, hp_sub⟩ := hp
        let L_u := L0 + (g_prev + 2)
        have hu_stop : subtreeAtLeftDepthGen s_top L_u = .node y (.node x a b) c := by
          dsimp (config := { failIfUnchanged := false }) only [L_u]
          rw [h_subLD_add L0 (g_prev + 2) s_top, h_anc]
          exact hu
        have hbst_u := h_bst_subLD L_u s_top a_top0 hbst_stop
        rw [hu_stop] at hbst_u
        obtain ⟨x_bot, hx_a, hx_div⟩ :=
          h_exists_bot_interblock (g :: rest) g_bot a b c a_top0 x y hbst_u
            (by simp [List.cons_append, allPairsInterblock, hxy, hp_sub])
        have hx_stop : x_bot ∈ preorderList s_top := by
          apply h_mem_subLD L_u s_top x_bot
          rw [hu_stop]
          exact List.mem_cons_of_mem y
            (List.mem_append_left _ (List.mem_cons_of_mem x (List.mem_append_left _ hx_a)))
        have hy_aprev : y ∈ preorderList a_prev := by
          apply h_mem_subLD g_prev a_prev y
          rw [hu]; exact List.mem_cons_self
        have hbst_anc := h_bst_subLD L0 s_top a_top0 hbst_stop
        rw [h_anc] at hbst_anc
        have hy_b := (h_mem_pre_bst a_prev a_top0 y hbst_anc.2.1.2.1).mp hy_aprev
        have hxprev_eq := hbst_anc.2.1.1
        have hy_lt_yprev : y / S < y_prev / S := by
          have : y / S ≤ x_prev / S := Nat.div_le_div_right (by omega)
          omega
        have hisG_y : isG y = true :=
          h_spine_node_global L0 (g_prev + 1) (by omega)
            (.node x_prev a_prev b_prev) c_prev (.node x a b) c y_prev y
            h_anc hu ⟨x_bot, hx_stop, by omega⟩ hy_lt_yprev
        have hisG_x : isG x = true :=
          h_spine_node_global L_u 0 (by omega)
            (.node x a b) c a b y x
            hu_stop (h_subLD_zero _) ⟨x_bot, hx_stop, hx_div⟩ hxy
        have hlpg : leftPrefixGlobal isG a g := by
          apply h_mk_lpg g a
          · intro he
            rw [he] at hp_sub
            simp [allPairsInterblock] at hp_sub
          · intro j hj_lt wl wr w hj_eq
            rcases hsub_g : subtreeAtLeftDepthGen a g with _ | ⟨y1, _ | ⟨x1, a1, b1⟩, c1⟩
            · rw [hsub_g] at hp_sub; simp [allPairsInterblock] at hp_sub
            · rw [hsub_g] at hp_sub; simp [allPairsInterblock] at hp_sub
            · have hp_sub' := hp_sub
              rw [hsub_g] at hp_sub'
              have hbst_a := hbst_u.2.1.2.1
              have hbst_subg := h_bst_subLD g a a_top0 hbst_a
              rw [hsub_g] at hbst_subg
              obtain ⟨x_bot1, hx_b1_a1, hx_b1_div⟩ :=
                h_exists_bot_interblock rest g_bot a1 b1 c1 a_top0 x1 y1 hbst_subg hp_sub'
              have hx_b1_stop : x_bot1 ∈ preorderList s_top := by
                apply h_mem_subLD (L_u + (g + 2)) s_top x_bot1
                rw [h_subLD_add L_u (g + 2) s_top, hu_stop]
                change x_bot1 ∈ preorderList (subtreeAtLeftDepthGen a g)
                rw [hsub_g]
                exact List.mem_cons_of_mem y1
                  (List.mem_append_left _ (List.mem_cons_of_mem x1 (List.mem_append_left _ hx_b1_a1)))
              let rem := g - (j + 1)
              have hg_split : g = (j + 1) + rem := by omega
              have hwl_rem : subtreeAtLeftDepthGen wl rem = .node y1 (.node x1 a1 b1) c1 := by
                have h1 := h_subLD_add (j + 1) rem a
                rw [← hg_split, h_subLD_add j 1 a, hj_eq] at h1
                simp only [subtreeAtLeftDepthGen, h_subLD_zero] at h1
                exact h1.symm.trans hsub_g
              have hx1_wl : x1 ∈ preorderList wl := by
                apply h_mem_subLD rem wl x1
                rw [hwl_rem]
                exact List.mem_cons_of_mem y1 (List.mem_append_left _ List.mem_cons_self)
              have hbst_w := h_bst_subLD j a a_top0 hbst_a
              rw [hj_eq] at hbst_w
              have hx1_b := (h_mem_pre_bst wl a_top0 x1 hbst_w.2.1).mp hx1_wl
              have hw_eq := hbst_w.1
              have hx1_div_w : x1 / S ≤ w / S := Nat.div_le_div_right (by omega)
              have hw_a : w ∈ preorderList a := by
                apply h_mem_subLD j a w
                rw [hj_eq]; exact List.mem_cons_self
              have hw_b := (h_mem_pre_bst a a_top0 w hbst_a).mp hw_a
              have hx_eq := hbst_u.2.1.1
              have hw_div_x : w / S ≤ x / S := Nat.div_le_div_right (by omega)
              exact h_spine_node_global L_u (j + 1) (by omega)
                (.node x a b) c wl wr y w
                hu_stop hj_eq ⟨x_bot1, hx_b1_stop, by omega⟩ (by omega)
        exact ⟨hisG_x, hisG_y, hlpg, ih g_bot L_u g a b c x y hg_le hu_stop hxy hvc_sub hp_sub⟩


  have h_ext_left_ne :
      ∀ (pG : ℕ → Bool) (l r : _root_.BinaryTree ℕ) (k : ℕ),
        pG k = false →
        extractGlobalTree pG l ≠ .nil →
        extractGlobalTree pG (.node k l r) = extractGlobalTree pG l := by
    intro pG l r k hk hne
    simp only [extractGlobalTree, hk, Bool.false_eq_true, ↓reduceIte]

  have h_ext_left_emp :
      ∀ (pG : ℕ → Bool) (l r : _root_.BinaryTree ℕ) (k : ℕ),
        pG k = false →
        extractGlobalTree pG l = .nil →
        extractGlobalTree pG (.node k l r) = extractGlobalTree pG r := by
    intro pG l r k hk hl
    simp [extractGlobalTree, hk, hl]

  have h_ns_subPos :
      ∀ (p : List Dir) (U : _root_.BinaryTree ℕ),
        NonSplittingGlobal isG U → NonSplittingGlobal isG (subtreeAtPosGen U p) := by
    intro p
    induction p with
    | nil => intro U h; rwa [h_subPos_nil]
    | cons dir rest ih =>
      rintro (_ | ⟨k, l, r⟩) h
      · trivial
      · cases dir with
        | L => exact ih l h.2.1
        | R => exact ih r h.2.2

  have h_unchanged_lift :
      ∀ (p : List Dir) (f : _root_.BinaryTree ℕ → _root_.BinaryTree ℕ) (U : _root_.BinaryTree ℕ),
        extractGlobalTree isG (f (subtreeAtPosGen U p)) =
          extractGlobalTree isG (subtreeAtPosGen U p) →
        extractGlobalTree isG (applyAtPosGen f U p) = extractGlobalTree isG U := by
    intro p
    induction p with
    | nil =>
      intro f U h
      simpa only [h_subPos_nil, h_appPos_nil] using h
    | cons dir rest ih =>
      intro f U h
      rcases U with _ | ⟨k, l, r⟩
      · rfl
      · cases dir with
        | L =>
          simp only [subtreeAtPosGen] at h
          simp only [applyAtPosGen, extractGlobalTree, ih f l h]
        | R =>
          simp only [subtreeAtPosGen] at h
          simp only [applyAtPosGen, extractGlobalTree, ih f r h]

  have h_nonempty_anc :
      ∀ (p : List Dir) (U : _root_.BinaryTree ℕ),
        extractGlobalTree isG (subtreeAtPosGen U p) ≠ .nil →
        extractGlobalTree isG U ≠ .nil := by
    intro p
    induction p with
    | nil => intro U h; rwa [h_subPos_nil] at h
    | cons dir rest ih =>
      rintro (_ | ⟨k, l, r⟩) h
      · simp [subtreeAtPosGen, extractGlobalTree] at h
      · cases dir with
        | L =>
          have hl := ih l h
          cases hk : isG k
          · rw [h_ext_left_ne isG l r k hk hl]; exact hl
          · simp [extractGlobalTree, hk]
        | R =>
          have hr := ih r h
          cases hk : isG k
          · simp only [extractGlobalTree, hk, Bool.false_eq_true, ↓reduceIte]
            cases extractGlobalTree isG l
            · exact hr
            · simp
          · simp [extractGlobalTree, hk]

  have h_nonempty_lift :
      ∀ (p : List Dir) (f : _root_.BinaryTree ℕ → _root_.BinaryTree ℕ)
        (fG : _root_.BinaryTree Unit → _root_.BinaryTree Unit) (U : _root_.BinaryTree ℕ),
        NonSplittingGlobal isG U →
        extractGlobalTree isG (subtreeAtPosGen U p) ≠ .nil →
        extractGlobalTree isG (f (subtreeAtPosGen U p)) ≠ .nil →
        eraseKeys (extractGlobalTree isG (f (subtreeAtPosGen U p))) =
          fG (eraseKeys (extractGlobalTree isG (subtreeAtPosGen U p))) →
        let pG := projGlobalPos isG U p
        subtreeAtPos (eraseKeys (extractGlobalTree isG U)) pG =
          eraseKeys (extractGlobalTree isG (subtreeAtPosGen U p)) ∧
        eraseKeys (extractGlobalTree isG (applyAtPosGen f U p)) =
          applyAtPos fG (eraseKeys (extractGlobalTree isG U)) pG := by
    intro p
    induction p with
    | nil =>
      intro f fG U _ _ _ hcomm
      simp only [h_projPos_nil, h_subPosU_nil, h_subPos_nil, h_appPos_nil, h_appPosU_nil] at hcomm ⊢
      exact ⟨trivial, hcomm⟩
    | cons dir rest ih =>
      rintro f fG (_ | ⟨k, l, r⟩) hns hne1 hne2 hcomm
      · simp [subtreeAtPosGen, extractGlobalTree] at hne1
      · obtain ⟨hns_k, hns_l, hns_r⟩ := hns
        cases dir with
        | L =>
          simp only [subtreeAtPosGen] at hne1 hne2 hcomm
          have hsub_ne : subtreeAtPosGen l rest ≠ .nil := by
            intro he; simp [he, extractGlobalTree] at hne1
          have hne_l : extractGlobalTree isG l ≠ .nil := h_nonempty_anc rest l hne1
          have hne_fl : extractGlobalTree isG (applyAtPosGen f l rest) ≠ .nil := by
            apply h_nonempty_anc rest (applyAtPosGen f l rest)
            rwa [h_subPos_after_app rest f l hsub_ne]
          obtain ⟨ih1, ih2⟩ := ih f fG l hns_l hne1 hne2 hcomm
          cases hk : isG k with
          | false =>
            have hpG : projGlobalPos isG (.node k l r) (.L :: rest) = projGlobalPos isG l rest := by
              simp [projGlobalPos, hk]
            simp only [hpG, subtreeAtPosGen, applyAtPosGen,
              h_ext_left_ne isG l r k hk hne_l,
              h_ext_left_ne isG (applyAtPosGen f l rest) r k hk hne_fl]
            exact ⟨ih1, ih2⟩
          | true =>
            have hpG : projGlobalPos isG (.node k l r) (.L :: rest) = .L :: projGlobalPos isG l rest := by
              simp [projGlobalPos, hk]
            simp only [hpG, subtreeAtPosGen, applyAtPosGen, extractGlobalTree, hk, ↓reduceIte,
              eraseKeys, subtreeAtPos, applyAtPos, ih1, ih2]
            exact ⟨trivial, trivial⟩
        | R =>
          simp only [subtreeAtPosGen] at hne1 hne2 hcomm
          have hne_r : extractGlobalTree isG r ≠ .nil := h_nonempty_anc rest r hne1
          obtain ⟨ih1, ih2⟩ := ih f fG r hns_r hne1 hne2 hcomm
          cases hk : isG k with
          | false =>
            have hl_emp : extractGlobalTree isG l = .nil := by
              rcases hns_k hk with hl | hr
              · exact hl
              · exact absurd hr hne_r
            have hpG : projGlobalPos isG (.node k l r) (.R :: rest) = projGlobalPos isG r rest := by
              simp [projGlobalPos, hk]
            simp only [hpG, subtreeAtPosGen, applyAtPosGen,
              h_ext_left_emp isG l r k hk hl_emp,
              h_ext_left_emp isG l (applyAtPosGen f r rest) k hk hl_emp]
            exact ⟨ih1, ih2⟩
          | true =>
            have hpG : projGlobalPos isG (.node k l r) (.R :: rest) = .R :: projGlobalPos isG r rest := by
              simp [projGlobalPos, hk]
            simp only [hpG, subtreeAtPosGen, applyAtPosGen, extractGlobalTree, hk, ↓reduceIte,
              eraseKeys, subtreeAtPos, applyAtPos, ih1, ih2]
            exact ⟨trivial, trivial⟩

  have h_proj_single :
      ∀ (p : List Dir) (U A B C : _root_.BinaryTree ℕ) (x y : ℕ),
        subtreeAtPosGen U p = .node y (.node x A B) C →
        NonSplittingGlobal isG U →
        NonSplittingGlobal isG (execRightRotOpGen U (.single p)) →
        ∃ ops : List RightRotOp,
          ValidRightRotSeq Δ' k' (eraseKeys (extractGlobalTree isG U)) ops ∧
          execRightRotSeq (eraseKeys (extractGlobalTree isG U)) ops =
            eraseKeys (extractGlobalTree isG (execRightRotOpGen U (.single p))) ∧
          countGappedCascades ops = 0 := by
    intro p U A B C x y hsub hns_U hns_U'
    let s := _root_.BinaryTree.node y (.node x A B) C
    let s' := _root_.BinaryTree.node x A (.node y B C)
    have hns_s : NonSplittingGlobal isG s := by
      have := h_ns_subPos p U hns_U
      rwa [hsub] at this
    have hns_s' : NonSplittingGlobal isG s' := by
      have := h_ns_subPos p (execRightRotOpGen U (.single p)) hns_U'
      dsimp (config := { failIfUnchanged := false }) only [execRightRotOpGen] at this
      rw [h_subPos_after_app p _root_.BinaryTree.rotateRight U (by simp [hsub]), hsub] at this
      exact this
    cases hx : isG x with
    | true =>
      cases hy : isG y with
      | true =>
        have hne1 : extractGlobalTree isG (subtreeAtPosGen U p) ≠ .nil := by
          rw [hsub]; simp [extractGlobalTree, hx, hy]
        have hne2 : extractGlobalTree isG (_root_.BinaryTree.rotateRight (subtreeAtPosGen U p)) ≠ .nil := by
          rw [hsub]; simp [_root_.BinaryTree.rotateRight, extractGlobalTree, hx, hy]
        have hcomm :
            eraseKeys (extractGlobalTree isG (_root_.BinaryTree.rotateRight (subtreeAtPosGen U p))) =
              _root_.BinaryTree.rotateRight (eraseKeys (extractGlobalTree isG (subtreeAtPosGen U p))) := by
          rw [hsub]
          simp [_root_.BinaryTree.rotateRight, extractGlobalTree, hx, hy, eraseKeys]
        obtain ⟨hpos_sub, hpos_app⟩ :=
          h_nonempty_lift p _root_.BinaryTree.rotateRight _root_.BinaryTree.rotateRight U hns_U hne1 hne2 hcomm
        let pG := projGlobalPos isG U p
        refine ⟨[.single pG], ⟨?_, trivial⟩, ?_, rfl⟩
        · simp only [pG, validRightRotOp, hpos_sub, hsub, extractGlobalTree, hx, hy, ↓reduceIte,
            eraseKeys, leftSpineLen]
          omega
        · simp only [pG, execRightRotSeq, execRightRotOp, execRightRotOpGen, hpos_app]
      | false =>
        have hEC : extractGlobalTree isG C = .nil := by
          have hl_ne : extractGlobalTree isG (.node x A B) ≠ .nil := by
            simp [extractGlobalTree, hx]
          rcases hns_s.1 hy with hl | hr
          · exact absurd hl hl_ne
          · exact hr
        have heq : extractGlobalTree isG (_root_.BinaryTree.rotateRight (subtreeAtPosGen U p)) =
            extractGlobalTree isG (subtreeAtPosGen U p) := by
          rw [hsub]
          simp only [_root_.BinaryTree.rotateRight, extractGlobalTree, hx, hy, ↓reduceIte,
            Bool.false_eq_true, hEC]
          cases extractGlobalTree isG B <;> rfl
        refine ⟨[], trivial, ?_, rfl⟩
        simp only [execRightRotSeq, execRightRotOpGen,
          h_unchanged_lift p _root_.BinaryTree.rotateRight U heq]
    | false =>
      cases hy : isG y with
      | true =>
        have hEA : extractGlobalTree isG A = .nil := by
          have hr_ne : extractGlobalTree isG (.node y B C) ≠ .nil := by
            simp [extractGlobalTree, hy]
          rcases hns_s'.1 hx with hl | hr
          · exact hl
          · exact absurd hr hr_ne
        have heq : extractGlobalTree isG (_root_.BinaryTree.rotateRight (subtreeAtPosGen U p)) =
            extractGlobalTree isG (subtreeAtPosGen U p) := by
          rw [hsub]
          simp [_root_.BinaryTree.rotateRight, extractGlobalTree, hx, hy, hEA]
        refine ⟨[], trivial, ?_, rfl⟩
        simp only [execRightRotSeq, execRightRotOpGen,
          h_unchanged_lift p _root_.BinaryTree.rotateRight U heq]
      | false =>
        have heq : extractGlobalTree isG (_root_.BinaryTree.rotateRight (subtreeAtPosGen U p)) =
            extractGlobalTree isG (subtreeAtPosGen U p) := by
          rw [hsub]
          simp only [_root_.BinaryTree.rotateRight, extractGlobalTree, hx, hy, Bool.false_eq_true, ↓reduceIte]
          cases extractGlobalTree isG A <;> cases extractGlobalTree isG B <;> rfl
        refine ⟨[], trivial, ?_, rfl⟩
        simp only [execRightRotSeq, execRightRotOpGen,
          h_unchanged_lift p _root_.BinaryTree.rotateRight U heq]

  have h_lpg_comm :
      ∀ (g : ℕ) (a : _root_.BinaryTree ℕ) (f : _root_.BinaryTree ℕ → _root_.BinaryTree ℕ)
        (fG : _root_.BinaryTree Unit → _root_.BinaryTree Unit),
        leftPrefixGlobal isG a g →
        eraseKeys (extractGlobalTree isG (f (subtreeAtLeftDepthGen a g))) =
          fG (eraseKeys (extractGlobalTree isG (subtreeAtLeftDepthGen a g))) →
        subtreeAtLeftDepth (eraseKeys (extractGlobalTree isG a)) g =
          eraseKeys (extractGlobalTree isG (subtreeAtLeftDepthGen a g)) ∧
        eraseKeys (extractGlobalTree isG (applyAtLeftDepthGen f a g)) =
          applyAtLeftDepth fG (eraseKeys (extractGlobalTree isG a)) g := by
    intro g
    induction g with
    | zero =>
      intro a f fG _ hcomm
      rw [h_subLD_zero] at hcomm ⊢
      rw [h_subLDU_zero, h_appLD_zero, h_appLDU_zero]
      exact ⟨rfl, hcomm⟩
    | succ g ih =>
      rintro (_ | ⟨k, l, r⟩) f fG hlpg hcomm
      · exact False.elim hlpg
      · obtain ⟨hk, hlpg_l⟩ := hlpg
        simp only [subtreeAtLeftDepthGen, applyAtLeftDepthGen] at hcomm ⊢
        obtain ⟨h1, h2⟩ := ih l f fG hlpg_l hcomm
        simp only [extractGlobalTree, hk, ↓reduceIte, eraseKeys,
          subtreeAtLeftDepth, applyAtLeftDepth, h1, h2]
        exact ⟨trivial, trivial⟩

  have h_root_casc_comm :
      ∀ (gs : List ℕ) (s : _root_.BinaryTree ℕ),
        validGappedCascadeAtRoot Δ' (eraseKeys s) gs →
        allCascadeSpineGlobal isG s gs →
        extractGlobalTree isG s ≠ .nil ∧
        extractGlobalTree isG (execGappedCascadeAtRootGen s gs) ≠ .nil ∧
        validGappedCascadeAtRoot Δ' (eraseKeys (extractGlobalTree isG s)) gs ∧
        eraseKeys (extractGlobalTree isG (execGappedCascadeAtRootGen s gs)) =
          execGappedCascadeAtRoot (eraseKeys (extractGlobalTree isG s)) gs := by
    intro gs
    induction gs with
    | nil =>
      rintro (_ | ⟨y, _ | ⟨x, a, b⟩, c⟩) _ hsp
      · exact False.elim hsp
      · exact False.elim hsp
      · obtain ⟨hx, hy⟩ := hsp
        simp only [execGappedCascadeAtRootGen, execGappedCascadeAtRoot,
          _root_.BinaryTree.rotateRight, extractGlobalTree, hx, hy, ↓reduceIte,
          eraseKeys, validGappedCascadeAtRoot, leftSpineLen]
        refine ⟨by simp, by simp, by omega, trivial⟩
    | cons g rest ih =>
      rintro (_ | ⟨y, _ | ⟨x, a, b⟩, c⟩) hvc hsp
      · exact False.elim hsp
      · exact False.elim hsp
      · simp only [eraseKeys, validGappedCascadeAtRoot] at hvc
        rw [← h_ek_subLD g a] at hvc
        obtain ⟨hg_le, hvc_sub⟩ := hvc
        obtain ⟨hx, hy, hlpg, hsp_sub⟩ := hsp
        obtain ⟨_, _, hvc_G, hcomm_sub⟩ := ih (subtreeAtLeftDepthGen a g) hvc_sub hsp_sub
        obtain ⟨hsub_G, happ_G⟩ := h_lpg_comm g a
          (fun t => execGappedCascadeAtRootGen t rest)
          (fun t => execGappedCascadeAtRoot t rest) hlpg hcomm_sub
        simp only [execGappedCascadeAtRootGen, extractGlobalTree, hx, hy, ↓reduceIte,
          eraseKeys, validGappedCascadeAtRoot, execGappedCascadeAtRoot, hsub_G, happ_G]
        exact ⟨by simp, by simp, ⟨hg_le, hvc_G⟩, trivial⟩


  have h_seq_cat :
      ∀ (ops1 ops2 : List RightRotOp) (t : _root_.BinaryTree Unit),
        ValidRightRotSeq Δ' k' t ops1 →
        ValidRightRotSeq Δ' k' (execRightRotSeq t ops1) ops2 →
        ValidRightRotSeq Δ' k' t (ops1 ++ ops2) ∧
        execRightRotSeq t (ops1 ++ ops2) = execRightRotSeq (execRightRotSeq t ops1) ops2 ∧
        countGappedCascades (ops1 ++ ops2) =
          countGappedCascades ops1 + countGappedCascades ops2 := by
    intro ops1
    induction ops1 with
    | nil =>
      intro ops2 t _ hv2
      exact ⟨hv2, rfl, by simp [countGappedCascades]⟩
    | cons op rest ih =>
      intro ops2 t ⟨hv_op, hv_rest⟩ hv2
      obtain ⟨hv_cat, hex_cat, hcnt_cat⟩ := ih ops2 (execRightRotOp t op) hv_rest hv2
      refine ⟨⟨hv_op, hv_cat⟩, hex_cat, ?_⟩
      cases op with
      | single _ => simp only [List.cons_append, countGappedCascades, hcnt_cat]
      | cascade _ _ => simp only [List.cons_append, countGappedCascades, hcnt_cat]; omega

  obtain ⟨h_len, hvc_top⟩ := hvalid
  rw [← h_ek_subPos pos T] at hvc_top
  rcases gaps with _ | ⟨g_top, tail1⟩
  · simp at h_len
  · simp only [List.length_cons] at h_len
    have htail_ne : tail1 ≠ [] := by
      intro h; simp [h] at h_len; omega
    let mid_gaps := tail1.dropLast
    let g_bot := tail1.getLast htail_ne
    have htail_eq : mid_gaps ++ [g_bot] = tail1 := List.dropLast_concat_getLast htail_ne
    have hmid_len : mid_gaps.length + 1 = k' := by
      dsimp (config := { failIfUnchanged := false }) only [mid_gaps]
      rw [List.length_dropLast]
      omega
    rw [← htail_eq] at hvc_top hpure ⊢
    change allPairsInterblock S s_top (g_top :: (mid_gaps ++ [g_bot])) = true at hpure
    change validGappedCascadeAtRoot Δ' (eraseKeys s_top) (g_top :: (mid_gaps ++ [g_bot])) at hvc_top
    rcases hstop : s_top with _ | ⟨y_top, _ | ⟨x_top, a_top, b_top⟩, c_top⟩
    · rw [hstop] at hpure; simp [allPairsInterblock] at hpure
    · rw [hstop] at hpure; simp [allPairsInterblock] at hpure
    · have hpure_full := hpure
      rw [hstop] at hvc_top hpure
      simp only [eraseKeys, validGappedCascadeAtRoot] at hvc_top
      rw [← h_ek_subLD g_top a_top] at hvc_top
      obtain ⟨hg_top_le, hvc_after_top⟩ := hvc_top
      simp only [allPairsInterblock, Bool.and_eq_true, decide_eq_true_eq] at hpure
      obtain ⟨hxy_top, hpure_after_top⟩ := hpure

      let T₁ := execRightRotOpGen T (.single pos)
      let pos_mid := pos ++ List.replicate (g_top + 1) .L
      have hstop_T : subtreeAtPosGen T pos = .node y_top (.node x_top a_top b_top) c_top := hstop

      have hsub_T1_mid : subtreeAtPosGen T₁ pos_mid = subtreeAtLeftDepthGen a_top g_top := by
        dsimp (config := { failIfUnchanged := false }) only [T₁, pos_mid, execRightRotOpGen]
        rw [h_subPos_app, h_subPos_after_app pos _root_.BinaryTree.rotateRight T (by simp [hstop_T]),
          hstop_T, ← h_subLD_eq_pos (g_top + 1)]
        rfl

      have hex_top_peel :
          execRightRotOpGen T (.cascade pos (g_top :: (mid_gaps ++ [g_bot]))) =
            execRightRotOpGen T₁ (.cascade pos_mid (mid_gaps ++ [g_bot])) := by
        dsimp (config := { failIfUnchanged := false }) only [T₁, pos_mid, execRightRotOpGen]
        rw [h_appPos_app, h_appPos_same pos _ _root_.BinaryTree.rotateRight T rfl]
        refine h_appPos_congr pos _ _ T ?_
        rw [hstop_T]
        simp only [_root_.BinaryTree.rotateRight, ← h_appLD_eq_pos (g_top + 1)]
        rfl

      obtain ⟨hvc_mid, hpure_mid, hspine_bot, hex_bot_root⟩ :=
        h_peel_bot_root mid_gaps g_bot (subtreeAtLeftDepthGen a_top g_top)
          hvc_after_top hpure_after_top

      let u_mid' := execGappedCascadeAtRootGen (subtreeAtLeftDepthGen a_top g_top) mid_gaps
      let δ_bot := gapsLeftOffset (mid_gaps ++ [g_bot])
      let T₂ := execRightRotOpGen T₁ (.cascade pos_mid mid_gaps)
      let pos_bot := pos_mid ++ List.replicate δ_bot .L
      let T₃ := execRightRotOpGen T₂ (.single pos_bot)

      have hsub_T1_ne : subtreeAtPosGen T₁ pos_mid ≠ .nil := by
        rw [hsub_T1_mid]
        intro he
        rw [he] at hpure_mid
        simp [allPairsInterblock] at hpure_mid

      have hsub_T2_bot : subtreeAtPosGen T₂ pos_bot = subtreeAtLeftDepthGen u_mid' δ_bot := by
        dsimp (config := { failIfUnchanged := false }) only [T₂, pos_bot, u_mid', execRightRotOpGen]
        rw [h_subPos_app, h_subPos_after_app pos_mid _ T₁ hsub_T1_ne,
          hsub_T1_mid, ← h_subLD_eq_pos δ_bot]

      have hT3_eq : T₃ = execRightRotOpGen T (.cascade pos (g_top :: (mid_gaps ++ [g_bot]))) := by
        rw [hex_top_peel]
        dsimp (config := { failIfUnchanged := false }) only [T₃, T₂, pos_bot, execRightRotOpGen]
        rw [h_appPos_app, h_appPos_same pos_mid _ _ T₁ (by cases mid_gaps <;> rfl)]
        refine h_appPos_congr pos_mid _ _ T₁ ?_
        rw [hsub_T1_mid, ← h_appLD_eq_pos δ_bot]
        exact hex_bot_root


      obtain ⟨hbst_T1, _, hblk_T1⟩ :=
        h_single_interblock_inv pos T 0 a_top b_top c_top x_top y_top hbst hstop_T hxy_top
      obtain ⟨hbst_T2, hblk_T2⟩ :=
        h_casc_interblock_inv mid_gaps T₁ pos_mid hbst_T1 (by rwa [hsub_T1_mid])
      obtain ⟨hbst_T3, hblk_T3⟩ :=
        h_casc_interblock_inv (g_top :: (mid_gaps ++ [g_bot])) T pos hbst hpure_full
      rw [← hT3_eq] at hbst_T3 hblk_T3

      have hisG_T1 : isGlobalKey (Δ' + 2) S T₁ = isG := by
        funext k; simp only [T₁, isG, isGlobalKey, blockTree, hblk_T1 (k / S)]
      have hisG_T2 : isGlobalKey (Δ' + 2) S T₂ = isG := by
        funext k; simp only [isG, isGlobalKey]
        rw [hblk_T2 (k / S)]; exact congrFun hisG_T1 k
      have hisG_T3 : isGlobalKey (Δ' + 2) S T₃ = isG := by
        funext k; simp only [isG, isGlobalKey, hblk_T3 (k / S)]

      have hns_T : NonSplittingGlobal isG T :=
        h_bst_nonSplitting (Δ' + 2) (by omega) T hbst
      have hns_T1 : NonSplittingGlobal isG T₁ := by
        rw [← hisG_T1]; exact h_bst_nonSplitting (Δ' + 2) (by omega) T₁ hbst_T1
      have hns_T2 : NonSplittingGlobal isG T₂ := by
        rw [← hisG_T2]; exact h_bst_nonSplitting (Δ' + 2) (by omega) T₂ hbst_T2
      have hns_T3 : NonSplittingGlobal isG T₃ := by
        rw [← hisG_T3]; exact h_bst_nonSplitting (Δ' + 2) (by omega) T₃ hbst_T3


      obtain ⟨ops₁, hv_ops1, hex_ops1, hcnt_ops1⟩ :=
        h_proj_single pos T a_top b_top c_top x_top y_top hstop_T hns_T hns_T1


      have hsp_mid : allCascadeSpineGlobal isG (subtreeAtPosGen T₁ pos_mid) mid_gaps := by
        rw [hsub_T1_mid]
        exact h_mid_casc_global mid_gaps g_bot 0 g_top a_top b_top c_top x_top y_top
          hg_top_le (by rw [h_subLD_zero]; exact hstop) hxy_top hvc_after_top hpure_after_top
      have hvc_mid_T1 : validGappedCascadeAtRoot Δ' (eraseKeys (subtreeAtPosGen T₁ pos_mid)) mid_gaps := by
        rwa [hsub_T1_mid]
      obtain ⟨hne1_mid, hne2_mid, hvc_mid_G, hcomm_mid_G⟩ :=
        h_root_casc_comm mid_gaps (subtreeAtPosGen T₁ pos_mid) hvc_mid_T1 hsp_mid
      obtain ⟨hpos_mid_sub, hpos_mid_app⟩ :=
        h_nonempty_lift pos_mid
          (fun s => execGappedCascadeAtRootGen s mid_gaps)
          (fun s => execGappedCascadeAtRoot s mid_gaps)
          T₁ hns_T1 hne1_mid hne2_mid hcomm_mid_G
      let op_mid_G := RightRotOp.cascade (projGlobalPos isG T₁ pos_mid) mid_gaps
      have hv_ops2 : ValidRightRotSeq Δ' k' (eraseKeys (extractGlobalTree isG T₁)) [op_mid_G] :=
        ⟨⟨hmid_len, by rwa [hpos_mid_sub]⟩, trivial⟩
      have hex_ops2 :
          execRightRotSeq (eraseKeys (extractGlobalTree isG T₁)) [op_mid_G] =
            eraseKeys (extractGlobalTree isG T₂) := by
        simp only [execRightRotSeq, execRightRotOp, op_mid_G, T₂, execRightRotOpGen, hpos_mid_app]


      rw [← hsub_T2_bot] at hspine_bot
      rcases hbot_eq : subtreeAtPosGen T₂ pos_bot with _ | ⟨y_bot, _ | ⟨x_bot, a_bot, b_bot⟩, c_bot⟩
      · rw [hbot_eq] at hspine_bot; simp [eraseKeys, leftSpineLen] at hspine_bot
      · rw [hbot_eq] at hspine_bot; simp [eraseKeys, leftSpineLen] at hspine_bot
      · obtain ⟨ops₃, hv_ops3, hex_ops3, hcnt_ops3⟩ :=
          h_proj_single pos_bot T₂ a_bot b_bot c_bot x_bot y_bot hbot_eq hns_T2 hns_T3


        obtain ⟨hv_12, hex_12, hcnt_12⟩ :=
          h_seq_cat ops₁ [op_mid_G] (eraseKeys (extractGlobalTree isG T))
            hv_ops1 (by rwa [hex_ops1])
        have hex_12' :
            execRightRotSeq (eraseKeys (extractGlobalTree isG T)) (ops₁ ++ [op_mid_G]) =
              eraseKeys (extractGlobalTree isG T₂) := by
          rw [hex_12, hex_ops1, hex_ops2]
        obtain ⟨hv_123, hex_123, hcnt_123⟩ :=
          h_seq_cat (ops₁ ++ [op_mid_G]) ops₃ (eraseKeys (extractGlobalTree isG T))
            hv_12 (by rwa [hex_12'])

        refine ⟨(ops₁ ++ [op_mid_G]) ++ ops₃, hv_123, ?_, ?_⟩
        · rw [← hT3_eq]
          simp only [globalTree, hisG_T3]
          dsimp (config := { failIfUnchanged := false }) only [isG, T₃] at hex_123 hex_12' hex_ops3 ⊢
          rw [hex_123, hex_12', hex_ops3]
        · rw [hcnt_123, hcnt_12, hcnt_ops1, hcnt_ops3]
          rfl

theorem gapped_right_cascade_bound : GappedCascadeBoundProp :=
by
  intro i Δ' N init0 seq0 hi hN_pos hN_ack hinit0_nodes hvalid0
  set D := Δ' + 2




  have h_seq_cat :
      ∀ (k : ℕ) (s1 s2 : List RightRotOp) (t : _root_.BinaryTree Unit),
        (ValidRightRotSeq Δ' k t (s1 ++ s2) ↔
          ValidRightRotSeq Δ' k t s1 ∧ ValidRightRotSeq Δ' k (execRightRotSeq t s1) s2) ∧
        execRightRotSeq t (s1 ++ s2) = execRightRotSeq (execRightRotSeq t s1) s2 ∧
        countGappedCascades (s1 ++ s2) = countGappedCascades s1 + countGappedCascades s2 := by
    intro k s1
    induction s1 with
    | nil =>
      intro s2 t
      simp [ValidRightRotSeq, execRightRotSeq, countGappedCascades]
    | cons op rest ih =>
      intro s2 t
      obtain ⟨h_val, h_exec, h_cnt⟩ := ih s2 (execRightRotOp t op)
      refine ⟨?_, h_exec, ?_⟩
      · simp only [List.cons_append, ValidRightRotSeq, execRightRotSeq, h_val, and_assoc]
      · cases op <;> simp only [List.cons_append, countGappedCascades, h_cnt, Nat.add_assoc]

  have h_ek_rotR :
      ∀ (t : _root_.BinaryTree ℕ), eraseKeys t.rotateRight = (eraseKeys t).rotateRight := by
    rintro (_ | ⟨y, _ | ⟨x, a, b⟩, c⟩) <;> rfl

  have h_ek_applyLD :
      ∀ (d : ℕ) (fN : _root_.BinaryTree ℕ → _root_.BinaryTree ℕ) (fU : _root_.BinaryTree Unit → _root_.BinaryTree Unit)
        (t : _root_.BinaryTree ℕ),
        (∀ s, eraseKeys (fN s) = fU (eraseKeys s)) →
        eraseKeys (applyAtLeftDepthGen fN t d) = applyAtLeftDepth fU (eraseKeys t) d := by
    intro d
    induction d with
    | zero =>
      intro fN fU t hf
      cases t <;> exact hf _
    | succ d ih =>
      intro fN fU t hf
      rcases t with _ | ⟨k, l, r⟩
      · rfl
      · simp only [applyAtLeftDepthGen, eraseKeys, applyAtLeftDepth, ih fN fU l hf]

  have h_ek_cascRoot :
      ∀ (gaps : List ℕ) (t : _root_.BinaryTree ℕ),
        eraseKeys (execGappedCascadeAtRootGen t gaps) =
          execGappedCascadeAtRoot (eraseKeys t) gaps := by
    intro gaps
    induction gaps with
    | nil =>
      intro t
      exact h_ek_rotR t
    | cons g rest ih =>
      rintro (_ | ⟨k2, _ | ⟨k1, a, b⟩, c⟩)
      · rfl
      · rfl
      · simp only [execGappedCascadeAtRootGen, eraseKeys, execGappedCascadeAtRoot]
        rw [h_ek_applyLD g (fun s => execGappedCascadeAtRootGen s rest)
          (fun s => execGappedCascadeAtRoot s rest) a ih]

  have h_ek_applyPos :
      ∀ (pos : List Dir) (fN : _root_.BinaryTree ℕ → _root_.BinaryTree ℕ)
        (fU : _root_.BinaryTree Unit → _root_.BinaryTree Unit) (t : _root_.BinaryTree ℕ),
        (∀ s, eraseKeys (fN s) = fU (eraseKeys s)) →
        eraseKeys (applyAtPosGen fN t pos) = applyAtPos fU (eraseKeys t) pos := by
    intro pos
    induction pos with
    | nil =>
      intro fN fU t hf
      cases t <;> exact hf _
    | cons dir rest ih =>
      intro fN fU t hf
      rcases t with _ | ⟨k, l, r⟩
      · rfl
      · cases dir <;> simp only [applyAtPosGen, eraseKeys, applyAtPos, ih fN fU _ hf]

  have h_ek_op :
      ∀ (t : _root_.BinaryTree ℕ) (op : RightRotOp),
        eraseKeys (execRightRotOpGen t op) = execRightRotOp (eraseKeys t) op := by
    intro t op
    cases op with
    | single pos =>
      exact h_ek_applyPos pos _root_.BinaryTree.rotateRight _root_.BinaryTree.rotateRight t h_ek_rotR
    | cascade pos gaps =>
      exact h_ek_applyPos pos (fun s => execGappedCascadeAtRootGen s gaps)
        (fun s => execGappedCascadeAtRoot s gaps) t (h_ek_cascRoot gaps)

  have h_labelRange_spec :
      ∀ (u : _root_.BinaryTree Unit) (a : ℕ),
        IsRangeBST a (labelRange a u) ∧
        (labelRange a u).num_nodes = u.num_nodes ∧
        eraseKeys (labelRange a u) = u := by
    intro u
    induction u with
    | nil =>
      intro a
      exact ⟨trivial, rfl, rfl⟩
    | node _ l r ihl ihr =>
      intro a
      obtain ⟨hb_l, hn_l, he_l⟩ := ihl a
      obtain ⟨hb_r, hn_r, he_r⟩ := ihr (a + l.num_nodes + 1)
      refine ⟨⟨?_, hb_l, hb_r⟩, ?_, ?_⟩
      · simp only [hn_l]
      · simp only [labelRange, _root_.BinaryTree.num_nodes, hn_l, hn_r]
      · simp only [labelRange, eraseKeys, he_l, he_r]




  let sumRightDepth : _root_.BinaryTree Unit → ℕ := fun t =>
    _root_.BinaryTree.rec 0 (fun _ _ r sl sr => sl + sr + r.num_nodes) t

  have h_srd_quad : ∀ t : _root_.BinaryTree Unit, 2 * sumRightDepth t ≤ t.num_nodes * t.num_nodes := by
    intro t
    induction t with
    | nil => simp [sumRightDepth, _root_.BinaryTree.num_nodes]
    | node _ l r ihl ihr =>
      change 2 * (sumRightDepth l + sumRightDepth r + r.num_nodes) ≤
        (1 + l.num_nodes + r.num_nodes) * (1 + l.num_nodes + r.num_nodes)
      nlinarith

  have h_rotR_srd :
      ∀ s : _root_.BinaryTree Unit,
        2 ≤ leftSpineLen s →
        s ≠ .nil ∧
        s.rotateRight.num_nodes = s.num_nodes ∧
        sumRightDepth s + 1 ≤ sumRightDepth s.rotateRight := by
    rintro (_ | ⟨u2, _ | ⟨u1, a, b⟩, c⟩) h
    · simp [leftSpineLen] at h
    · simp [leftSpineLen] at h
    · refine ⟨by simp, ?_, ?_⟩
      · simp only [_root_.BinaryTree.rotateRight, _root_.BinaryTree.num_nodes]
        omega
      · change (sumRightDepth a + sumRightDepth b + b.num_nodes) + sumRightDepth c + c.num_nodes + 1 ≤
          sumRightDepth a + (sumRightDepth b + sumRightDepth c + c.num_nodes) +
            (1 + b.num_nodes + c.num_nodes)
        omega

  have h_applyLD_srd :
      ∀ (d δ : ℕ) (f : _root_.BinaryTree Unit → _root_.BinaryTree Unit) (t : _root_.BinaryTree Unit),
        subtreeAtLeftDepth t d ≠ .nil →
        (f (subtreeAtLeftDepth t d)).num_nodes = (subtreeAtLeftDepth t d).num_nodes →
        sumRightDepth (subtreeAtLeftDepth t d) + δ ≤ sumRightDepth (f (subtreeAtLeftDepth t d)) →
        (applyAtLeftDepth f t d).num_nodes = t.num_nodes ∧
        sumRightDepth t + δ ≤ sumRightDepth (applyAtLeftDepth f t d) := by
    intro d
    induction d with
    | zero =>
      intro δ f t _ hfn hfs
      cases t <;> exact ⟨hfn, hfs⟩
    | succ d ih =>
      intro δ f t hne hfn hfs
      rcases t with _ | ⟨u, l, r⟩
      · exact absurd rfl hne
      · simp only [subtreeAtLeftDepth] at hne hfn hfs
        obtain ⟨hn_l, hs_l⟩ := ih δ f l hne hfn hfs
        refine ⟨by simp [applyAtLeftDepth, _root_.BinaryTree.num_nodes, hn_l], ?_⟩
        change (sumRightDepth l + sumRightDepth r + r.num_nodes) + δ ≤
          sumRightDepth (applyAtLeftDepth f l d) + sumRightDepth r + r.num_nodes
        omega

  have h_cascRoot_srd :
      ∀ (gaps : List ℕ) (s : _root_.BinaryTree Unit),
        validGappedCascadeAtRoot Δ' s gaps →
        s ≠ .nil ∧
        (execGappedCascadeAtRoot s gaps).num_nodes = s.num_nodes ∧
        sumRightDepth s + (gaps.length + 1) ≤ sumRightDepth (execGappedCascadeAtRoot s gaps) := by
    intro gaps
    induction gaps with
    | nil =>
      intro s hv
      exact h_rotR_srd s hv
    | cons g rest ih =>
      rintro (_ | ⟨u2, _ | ⟨u1, a, b⟩, c⟩) hv
      · exact False.elim hv
      · exact False.elim hv
      · obtain ⟨_, hv_rest⟩ := hv
        obtain ⟨hne_sub, hn_sub, hs_sub⟩ := ih (subtreeAtLeftDepth a g) hv_rest
        obtain ⟨hn_a, hs_a⟩ :=
          h_applyLD_srd g (rest.length + 1) (fun x => execGappedCascadeAtRoot x rest)
            a hne_sub hn_sub hs_sub
        refine ⟨by simp, ?_, ?_⟩
        · simp only [execGappedCascadeAtRoot, _root_.BinaryTree.num_nodes, hn_a]
          omega
        · change (sumRightDepth a + sumRightDepth b + b.num_nodes) + sumRightDepth c +
              c.num_nodes + (rest.length + 1 + 1) ≤
            sumRightDepth (applyAtLeftDepth (fun x => execGappedCascadeAtRoot x rest) a g) +
              (sumRightDepth b + sumRightDepth c + c.num_nodes) +
              (1 + b.num_nodes + c.num_nodes)
          omega

  have h_applyPos_srd :
      ∀ (pos : List Dir) (δ : ℕ) (f : _root_.BinaryTree Unit → _root_.BinaryTree Unit) (t : _root_.BinaryTree Unit),
        subtreeAtPos t pos ≠ .nil →
        (f (subtreeAtPos t pos)).num_nodes = (subtreeAtPos t pos).num_nodes →
        sumRightDepth (subtreeAtPos t pos) + δ ≤ sumRightDepth (f (subtreeAtPos t pos)) →
        (applyAtPos f t pos).num_nodes = t.num_nodes ∧
        sumRightDepth t + δ ≤ sumRightDepth (applyAtPos f t pos) := by
    intro pos
    induction pos with
    | nil =>
      intro δ f t _ hfn hfs
      cases t <;> exact ⟨hfn, hfs⟩
    | cons dir rest ih =>
      intro δ f t hne hfn hfs
      rcases t with _ | ⟨u, l, r⟩
      · cases dir <;> exact absurd rfl hne
      · cases dir with
        | L =>
          simp only [subtreeAtPos] at hne hfn hfs
          obtain ⟨hn_l, hs_l⟩ := ih δ f l hne hfn hfs
          refine ⟨by simp [applyAtPos, _root_.BinaryTree.num_nodes, hn_l], ?_⟩
          change (sumRightDepth l + sumRightDepth r + r.num_nodes) + δ ≤
            sumRightDepth (applyAtPos f l rest) + sumRightDepth r + r.num_nodes
          omega
        | R =>
          simp only [subtreeAtPos] at hne hfn hfs
          obtain ⟨hn_r, hs_r⟩ := ih δ f r hne hfn hfs
          refine ⟨by simp [applyAtPos, _root_.BinaryTree.num_nodes, hn_r], ?_⟩
          change (sumRightDepth l + sumRightDepth r + r.num_nodes) + δ ≤
            sumRightDepth l + sumRightDepth (applyAtPos f r rest) +
              (applyAtPos f r rest).num_nodes
          omega

  have h_quad_base :
      ∀ (k : ℕ) (u : _root_.BinaryTree Unit) (seq : List RightRotOp),
        ValidRightRotSeq Δ' k u seq →
        2 * k * countGappedCascades seq ≤ u.num_nodes * u.num_nodes := by
    intro k
    have h_aux :
        ∀ (seq : List RightRotOp) (u : _root_.BinaryTree Unit),
          ValidRightRotSeq Δ' k u seq →
          (execRightRotSeq u seq).num_nodes = u.num_nodes ∧
          sumRightDepth u + k * countGappedCascades seq ≤ sumRightDepth (execRightRotSeq u seq) := by
      intro seq
      induction seq with
      | nil =>
        intro u _
        simp [execRightRotSeq, countGappedCascades]
      | cons op rest ih =>
        intro u ⟨hop, hrest⟩
        cases op with
        | single pos =>
          obtain ⟨hne, hfn, hfs⟩ := h_rotR_srd (subtreeAtPos u pos) hop
          obtain ⟨hn_op, hs_op⟩ :=
            h_applyPos_srd pos 1 _root_.BinaryTree.rotateRight u hne hfn hfs
          obtain ⟨hn_rest, hs_rest⟩ := ih (execRightRotOp u (.single pos)) hrest
          refine ⟨by simp only [execRightRotSeq]; rw [hn_rest]; exact hn_op, ?_⟩
          simp only [countGappedCascades, execRightRotSeq, execRightRotOp] at hs_rest ⊢
          omega
        | cascade pos gaps =>
          obtain ⟨hk_eq, hv_casc⟩ := hop
          obtain ⟨hne, hfn, hfs⟩ := h_cascRoot_srd gaps (subtreeAtPos u pos) hv_casc
          rw [hk_eq] at hfs
          obtain ⟨hn_op, hs_op⟩ :=
            h_applyPos_srd pos k (fun x => execGappedCascadeAtRoot x gaps) u hne hfn hfs
          obtain ⟨hn_rest, hs_rest⟩ := ih (execRightRotOp u (.cascade pos gaps)) hrest
          refine ⟨by simp only [execRightRotSeq]; rw [hn_rest]; exact hn_op, ?_⟩
          simp only [countGappedCascades, execRightRotSeq, execRightRotOp] at hs_rest ⊢
          have hmul : k * (1 + countGappedCascades rest) = k + k * countGappedCascades rest := by
            ring
          omega
    intro u seq hv
    obtain ⟨hn_end, hs_end⟩ := h_aux seq u hv
    have hq := h_srd_quad (execRightRotSeq u seq)
    rw [hn_end] at hq
    have hmul : 2 * k * countGappedCascades seq = 2 * (k * countGappedCascades seq) := by ring
    omega




  let appendRightmost : _root_.BinaryTree Unit → _root_.BinaryTree Unit → _root_.BinaryTree Unit := fun u tail =>
    _root_.BinaryTree.rec tail (fun u0 l _ _ r_res => .node u0 l r_res) u

  have h_appR_nodes :
      ∀ (u tail : _root_.BinaryTree Unit),
        (appendRightmost u tail).num_nodes = u.num_nodes + tail.num_nodes := by
    intro u tail
    induction u with
    | nil => simp [appendRightmost, _root_.BinaryTree.num_nodes]
    | node _ l r _ ihr =>
      change 1 + l.num_nodes + (appendRightmost r tail).num_nodes =
        (1 + l.num_nodes + r.num_nodes) + tail.num_nodes
      omega

  have h_appR_cascRoot :
      ∀ (s tail : _root_.BinaryTree Unit) (gaps : List ℕ),
        validGappedCascadeAtRoot Δ' s gaps →
        validGappedCascadeAtRoot Δ' (appendRightmost s tail) gaps ∧
        execGappedCascadeAtRoot (appendRightmost s tail) gaps =
          appendRightmost (execGappedCascadeAtRoot s gaps) tail := by
    rintro (_ | ⟨u2, _ | ⟨u1, a, b⟩, c⟩) tail (_ | ⟨g, rest⟩) hv
    · simp [validGappedCascadeAtRoot, leftSpineLen] at hv
    · exact False.elim hv
    · simp [validGappedCascadeAtRoot, leftSpineLen] at hv
    · exact False.elim hv
    · exact ⟨hv, rfl⟩
    · exact ⟨hv, rfl⟩

  have h_appR_op :
      ∀ (k : ℕ) (tail : _root_.BinaryTree Unit) (op : RightRotOp) (u : _root_.BinaryTree Unit),
        validRightRotOp Δ' k u op →
        validRightRotOp Δ' k (appendRightmost u tail) op ∧
        execRightRotOp (appendRightmost u tail) op = appendRightmost (execRightRotOp u op) tail := by
    intro k tail op
    cases op with
    | single pos =>
      induction pos with
      | nil =>
        rintro (_ | ⟨u2, _ | ⟨u1, a, b⟩, c⟩) hv
        · simp [validRightRotOp, subtreeAtPos, leftSpineLen] at hv
        · simp [validRightRotOp, subtreeAtPos, leftSpineLen] at hv
        · exact ⟨hv, rfl⟩
      | cons dir rest ih =>
        rintro (_ | ⟨u0, l, r⟩) hv
        · cases dir <;> simp [validRightRotOp, subtreeAtPos, leftSpineLen] at hv
        · cases dir with
          | L => exact ⟨hv, rfl⟩
          | R =>
            obtain ⟨hv_r, hex_r⟩ := ih r hv
            exact ⟨hv_r, congrArg (_root_.BinaryTree.node u0 l) hex_r⟩
    | cascade pos gaps =>
      induction pos with
      | nil =>
        rintro (_ | ⟨u0, l, r⟩) ⟨hk_eq, hv_casc⟩
        · cases gaps <;> simp [subtreeAtPos, validGappedCascadeAtRoot, leftSpineLen] at hv_casc
        · obtain ⟨hv2, hex2⟩ := h_appR_cascRoot (.node u0 l r) tail gaps hv_casc
          exact ⟨⟨hk_eq, hv2⟩, hex2⟩
      | cons dir rest ih =>
        rintro (_ | ⟨u0, l, r⟩) hv
        · obtain ⟨_, hv_casc⟩ := hv
          cases dir <;> cases gaps <;> simp [subtreeAtPos, validGappedCascadeAtRoot, leftSpineLen] at hv_casc
        · cases dir with
          | L => exact ⟨hv, rfl⟩
          | R =>
            obtain ⟨hv_r, hex_r⟩ := ih r hv
            exact ⟨hv_r, congrArg (_root_.BinaryTree.node u0 l) hex_r⟩

  have h_appR_seq :
      ∀ (k : ℕ) (tail : _root_.BinaryTree Unit) (u_seq : List RightRotOp) (u : _root_.BinaryTree Unit),
        ValidRightRotSeq Δ' k u u_seq →
        ValidRightRotSeq Δ' k (appendRightmost u tail) u_seq ∧
        execRightRotSeq (appendRightmost u tail) u_seq =
          appendRightmost (execRightRotSeq u u_seq) tail := by
    intro k tail u_seq
    induction u_seq with
    | nil =>
      intro u _
      exact ⟨trivial, rfl⟩
    | cons op rest ih =>
      intro u ⟨hop, hrest⟩
      obtain ⟨hop', hex_op⟩ := h_appR_op k tail op u hop
      obtain ⟨hrest', hex_rest⟩ := ih (execRightRotOp u op) hrest
      refine ⟨⟨hop', ?_⟩, ?_⟩
      · rw [hex_op]
        exact hrest'
      · simp only [execRightRotSeq, hex_op, hex_rest]

  let shiftOp : List Dir → RightRotOp → RightRotOp := fun pref op =>
    match op with
    | .single pos => .single (pref ++ pos)
    | .cascade pos gaps => .cascade (pref ++ pos) gaps

  have h_shiftR_pos :
      ∀ (w tail : _root_.BinaryTree Unit) (pos : List Dir)
        (f : _root_.BinaryTree Unit → _root_.BinaryTree Unit),
        subtreeAtPos (appendRightmost w tail) (List.replicate (rightSpineLen w) Dir.R ++ pos) =
          subtreeAtPos tail pos ∧
        applyAtPos f (appendRightmost w tail) (List.replicate (rightSpineLen w) Dir.R ++ pos) =
          appendRightmost w (applyAtPos f tail pos) := by
    intro w tail pos f
    induction w with
    | nil =>
      exact ⟨rfl, rfl⟩
    | node u0 l r _ ihr =>
      have hrep :
          List.replicate (rightSpineLen (.node u0 l r)) Dir.R =
            Dir.R :: List.replicate (rightSpineLen r) Dir.R := by
        simp only [rightSpineLen]
        rw [Nat.add_comm 1 (rightSpineLen r)]
        rfl
      rw [hrep, List.cons_append]
      exact ⟨ihr.1, congrArg (_root_.BinaryTree.node u0 l) ihr.2⟩

  have h_shiftR_seq :
      ∀ (k : ℕ) (w : _root_.BinaryTree Unit) (tail_seq : List RightRotOp) (tail : _root_.BinaryTree Unit),
        ValidRightRotSeq Δ' k tail tail_seq →
        ValidRightRotSeq Δ' k (appendRightmost w tail)
          (tail_seq.map (shiftOp (List.replicate (rightSpineLen w) Dir.R))) ∧
        countGappedCascades (tail_seq.map (shiftOp (List.replicate (rightSpineLen w) Dir.R))) =
          countGappedCascades tail_seq := by
    intro k w tail_seq
    induction tail_seq with
    | nil =>
      intro tail _
      exact ⟨trivial, rfl⟩
    | cons op rest ih =>
      intro tail ⟨hop, hrest⟩
      obtain ⟨hrest_v, hrest_c⟩ := ih (execRightRotOp tail op) hrest
      cases op with
      | single pos =>
        obtain ⟨hsub, happ⟩ := h_shiftR_pos w tail pos _root_.BinaryTree.rotateRight
        refine ⟨⟨?_, ?_⟩, hrest_c⟩
        · simp only [shiftOp, validRightRotOp, hsub]
          exact hop
        · simp only [shiftOp, execRightRotOp, happ]
          exact hrest_v
      | cascade pos gaps =>
        obtain ⟨hsub, happ⟩ := h_shiftR_pos w tail pos (fun s => execGappedCascadeAtRoot s gaps)
        refine ⟨⟨?_, ?_⟩, ?_⟩
        · simp only [shiftOp, validRightRotOp, hsub]
          exact hop
        · simp only [shiftOp, execRightRotOp, happ]
          exact hrest_v
        · simp only [List.map_cons, shiftOp, countGappedCascades, hrest_c]

  have h_superadd_pad :
      ∀ (k C N_sm M_lg : ℕ),
        1 ≤ N_sm →
        N_sm ≤ M_lg →
        (∀ (v : _root_.BinaryTree Unit) (v_seq : List RightRotOp),
          v.num_nodes = M_lg →
          ValidRightRotSeq Δ' k v v_seq →
          countGappedCascades v_seq ≤ C * M_lg) →
        ∀ (u : _root_.BinaryTree Unit) (u_seq : List RightRotOp),
          u.num_nodes = N_sm →
          ValidRightRotSeq Δ' k u u_seq →
          countGappedCascades u_seq ≤ 2 * C * N_sm := by
    intro k C N_sm M_lg hN_sm hNM hM_bound u u_seq hu_nodes hu_val
    let chainTree : ℕ → _root_.BinaryTree Unit := fun m =>
      Nat.rec .nil (fun _ acc => .node () .nil acc) m
    have h_chain_nodes : ∀ m : ℕ, (chainTree m).num_nodes = m := by
      intro m
      induction m with
      | zero => rfl
      | succ m ih =>
        change 1 + 0 + (chainTree m).num_nodes = m + 1
        omega
    have h_stack :
        ∀ d : ℕ,
          ∃ (vd : _root_.BinaryTree Unit) (seq_d : List RightRotOp),
            vd.num_nodes = d * N_sm + M_lg % N_sm ∧
            ValidRightRotSeq Δ' k vd seq_d ∧
            countGappedCascades seq_d = d * countGappedCascades u_seq := by
      intro d
      induction d with
      | zero =>
        refine ⟨chainTree (M_lg % N_sm), [], ?_, trivial, ?_⟩
        · simp [h_chain_nodes]
        · simp [countGappedCascades]
      | succ d ih =>
        obtain ⟨vd, seq_d, hvd_n, hvd_v, hvd_c⟩ := ih
        let u_end := execRightRotSeq u u_seq
        let seq_shift := seq_d.map (shiftOp (List.replicate (rightSpineLen u_end) Dir.R))
        obtain ⟨hu_v', hu_ex'⟩ := h_appR_seq k vd u_seq u hu_val
        obtain ⟨hs_v, hs_c⟩ := h_shiftR_seq k u_end seq_d vd hvd_v
        obtain ⟨hcat_v, _, hcat_c⟩ := h_seq_cat k u_seq seq_shift (appendRightmost u vd)
        refine ⟨appendRightmost u vd, u_seq ++ seq_shift, ?_, ?_, ?_⟩
        · rw [h_appR_nodes, hu_nodes, hvd_n]
          ring
        · rw [hcat_v, hu_ex']
          exact ⟨hu_v', hs_v⟩
        · rw [hcat_c, hs_c, hvd_c]
          ring
    let d := M_lg / N_sm
    have hd_pos : 0 < d := Nat.div_pos hNM hN_sm
    obtain ⟨v, v_seq, hv_n, hv_v, hv_c⟩ := h_stack d
    have hv_M : v.num_nodes = M_lg := by
      rw [hv_n]
      have hdiv := Nat.div_add_mod M_lg N_sm
      dsimp (config := { failIfUnchanged := false }) only [d]
      nlinarith
    have h_v_le : countGappedCascades v_seq ≤ C * M_lg := hM_bound v v_seq hv_M hv_v
    have hmod_lt : M_lg % N_sm < N_sm := Nat.mod_lt M_lg hN_sm
    have hM_le_2dN : M_lg ≤ 2 * d * N_sm := by
      have hdiv := Nat.div_add_mod M_lg N_sm
      dsimp (config := { failIfUnchanged := false }) only [d]
      nlinarith
    have h_mul_le : d * countGappedCascades u_seq ≤ d * (2 * C * N_sm) := by
      calc d * countGappedCascades u_seq
        _ = countGappedCascades v_seq := hv_c.symm
        _ ≤ C * M_lg := h_v_le
        _ ≤ C * (2 * d * N_sm) := Nat.mul_le_mul_left C hM_le_2dN
        _ = d * (2 * C * N_sm) := by ring
    exact Nat.le_of_mul_le_mul_left h_mul_le hd_pos




  have h_rr_len : ∀ (t : _root_.BinaryTree Unit) (a : ℕ), (rightReachList a t).length = t.num_nodes := by
    intro t
    induction t with
    | nil =>
      intro _
      rfl
    | node _ l r ihl ihr =>
      intro a
      simp only [rightReachList, List.length_append, List.length_singleton,
        ihl a, ihr (a + l.num_nodes + 1), _root_.BinaryTree.num_nodes]
      omega

  have h_rr_shift :
      ∀ (t : _root_.BinaryTree Unit) (a b : ℕ),
        rightReachList (a + b) t = (rightReachList a t).map (· + b) := by
    intro t
    induction t with
    | nil =>
      intro _ _
      rfl
    | node _ l r ihl ihr =>
      intro a b
      simp only [rightReachList, List.map_append, List.map_cons, List.map_nil]
      have h1 : a + b + l.num_nodes = a + l.num_nodes + b := by omega
      have h2 : a + l.num_nodes + b + 1 = (a + l.num_nodes + 1) + b := by omega
      have h3 : a + l.num_nodes + b + r.num_nodes = a + l.num_nodes + r.num_nodes + b := by omega
      rw [ihl a b, h1, h3, h2, ihr (a + l.num_nodes + 1) b]

  have h_rr_lt :
      ∀ (t : _root_.BinaryTree Unit) (a x : ℕ),
        x ∈ rightReachList a t → x < a + t.num_nodes := by
    intro t
    induction t with
    | nil =>
      intro _ _ hx
      simp [rightReachList] at hx
    | node _ l r ihl ihr =>
      intro a x hx
      simp only [rightReachList, List.mem_append, List.mem_singleton] at hx
      simp only [_root_.BinaryTree.num_nodes]
      rcases hx with (hxl | hxm) | hxr
      · have h1 := ihl a x hxl
        omega
      · omega
      · have h1 := ihr (a + l.num_nodes + 1) x hxr
        omega

  have h_take_app_le :
      ∀ {α : Type} (xs ys : List α) (d : ℕ),
        d ≤ xs.length → (xs ++ ys).take d = xs.take d := by
    intro α xs ys
    induction xs with
    | nil =>
      intro d hd
      have hd0 : d = 0 := by simp at hd; omega
      subst hd0
      rfl
    | cons x xs ih =>
      intro d hd
      rcases d with _ | d
      · rfl
      · simp only [List.length_cons] at hd
        simp only [List.cons_append, List.take_succ_cons, ih d (by omega)]

  have h_drop_app_le :
      ∀ {α : Type} (xs ys : List α) (d : ℕ),
        d ≤ xs.length → (xs ++ ys).drop d = xs.drop d ++ ys := by
    intro α xs ys
    induction xs with
    | nil =>
      intro d hd
      have hd0 : d = 0 := by simp at hd; omega
      subst hd0
      rfl
    | cons x xs ih =>
      intro d hd
      rcases d with _ | d
      · rfl
      · simp only [List.length_cons] at hd
        simp only [List.cons_append, List.drop_succ_cons, ih d (by omega)]

  have h_mem_take_mid :
      ∀ (xs ys : List ℕ) (y d : ℕ),
        xs.length < d → y ∈ (xs ++ y :: ys).take d := by
    intro xs ys y
    induction xs with
    | nil =>
      intro d hd
      rcases d with _ | d
      · simp at hd
      · simp [List.take_succ_cons]
    | cons x xs ih =>
      intro d hd
      rcases d with _ | d
      · simp at hd
      · simp only [List.length_cons] at hd
        simp only [List.cons_append, List.take_succ_cons, List.mem_cons]
        exact Or.inr (ih d (by omega))

  have h_forall2_take :
      ∀ (xs ys : List ℕ),
        List.Forall₂ (· ≤ ·) xs ys →
        ∀ d : ℕ, List.Forall₂ (· ≤ ·) (xs.take d) (ys.take d) := by
    intro xs ys h
    induction h with
    | nil =>
      intro d
      simp
    | cons hxy _ ih =>
      intro d
      rcases d with _ | d
      · simp
      · exact List.Forall₂.cons hxy (ih d)

  have h_forall2_drop :
      ∀ (xs ys : List ℕ),
        List.Forall₂ (· ≤ ·) xs ys →
        ∀ d : ℕ, List.Forall₂ (· ≤ ·) (xs.drop d) (ys.drop d) := by
    intro xs ys h
    induction h with
    | nil =>
      intro d
      simp
    | cons hxy hrest ih =>
      intro d
      rcases d with _ | d
      · exact List.Forall₂.cons hxy hrest
      · exact ih d

  have h_forall2_ub :
      ∀ (xs ys : List ℕ) (B : ℕ),
        List.Forall₂ (· ≤ ·) xs ys →
        (∀ y ∈ ys, y < B) →
        ∀ x ∈ xs, x < B := by
    intro xs ys B h
    induction h with
    | nil =>
      intro _ x hx
      simp at hx
    | cons hxy _ ih =>
      intro hy x hx
      simp only [List.mem_cons] at hx
      rcases hx with rfl | hx_rest
      · have hy0 := hy _ List.mem_cons_self
        omega
      · exact ih (fun y hm => hy y (List.mem_cons_of_mem _ hm)) x hx_rest

  have h_mapDir_seq :
      ∀ (k : ℕ) (dir : Dir) (sub_seq : List RightRotOp),
        countGappedCascades sub_seq = 0 →
        countGappedCascades (sub_seq.map (shiftOp [dir])) = 0 ∧
        (∀ (l r : _root_.BinaryTree Unit),
          dir = .L →
          ValidRightRotSeq Δ' k l sub_seq →
          ValidRightRotSeq Δ' k (.node () l r) (sub_seq.map (shiftOp [.L])) ∧
          execRightRotSeq (.node () l r) (sub_seq.map (shiftOp [.L])) =
            .node () (execRightRotSeq l sub_seq) r) ∧
        (∀ (l r : _root_.BinaryTree Unit),
          dir = .R →
          ValidRightRotSeq Δ' k r sub_seq →
          ValidRightRotSeq Δ' k (.node () l r) (sub_seq.map (shiftOp [.R])) ∧
          execRightRotSeq (.node () l r) (sub_seq.map (shiftOp [.R])) =
            .node () l (execRightRotSeq r sub_seq)) := by
    intro k dir sub_seq
    induction sub_seq with
    | nil =>
      intro _
      refine ⟨rfl, ?_, ?_⟩
      · intro l r _ _
        exact ⟨trivial, rfl⟩
      · intro l r _ _
        exact ⟨trivial, rfl⟩
    | cons op rest ih =>
      intro hcnt0
      cases op with
      | cascade _ _ =>
        simp [countGappedCascades] at hcnt0
      | single pos =>
        simp only [countGappedCascades] at hcnt0
        obtain ⟨hc_ih, hL_ih, hR_ih⟩ := ih hcnt0
        refine ⟨hc_ih, ?_, ?_⟩
        · intro l r hdir ⟨hop, hrest⟩
          obtain ⟨hrest_v, hrest_ex⟩ := hL_ih (execRightRotOp l (.single pos)) r hdir hrest
          exact ⟨⟨hop, hrest_v⟩, hrest_ex⟩
        · intro l r hdir ⟨hop, hrest⟩
          obtain ⟨hrest_v, hrest_ex⟩ := hR_ih l (execRightRotOp r (.single pos)) hdir hrest
          exact ⟨⟨hop, hrest_v⟩, hrest_ex⟩

  have h_drop_mid :
      ∀ {α : Type} (xs ys : List α) (y : α) (n : ℕ),
        xs.length = n → (xs ++ y :: ys).drop (n + 1) = ys := by
    intro α xs ys y
    induction xs with
    | nil =>
      intro n hn
      simp at hn
      subst hn
      rfl
    | cons x xs ih =>
      intro n hn
      rcases n with _ | n
      · simp at hn
      · simp only [List.length_cons] at hn
        exact ih n (by omega)

  have h_forall2_unmap_add :
      ∀ (xs ys : List ℕ) (b : ℕ),
        List.Forall₂ (· ≤ ·) (xs.map (· + b)) (ys.map (· + b)) →
        List.Forall₂ (· ≤ ·) xs ys := by
    intro xs
    induction xs with
    | nil =>
      intro ys _ h
      cases ys with
      | nil => exact List.Forall₂.nil
      | cons _ _ => simp at h
    | cons x xs ih =>
      intro ys b h
      cases ys with
      | nil => simp at h
      | cons y ys =>
        simp only [List.map_cons, List.forall₂_cons] at h
        exact List.Forall₂.cons (by omega) (ih ys b h.2)

  have h_tamari_sim :
      ∀ (k : ℕ) (t1 t2 : _root_.BinaryTree Unit),
        t1.num_nodes = t2.num_nodes →
        List.Forall₂ (· ≤ ·) (rightReachList 0 t1) (rightReachList 0 t2) →
        ∃ seq : List RightRotOp,
          ValidRightRotSeq Δ' k t1 seq ∧
          execRightRotSeq t1 seq = t2 ∧
          countGappedCascades seq = 0 := by
    intro k
    have h_lift_root :
        ∀ (n : ℕ) (t : _root_.BinaryTree Unit) (m2 : ℕ),
          t.num_nodes = n →
          m2 < n →
          (∀ x ∈ (rightReachList 0 t).take m2, x < m2) →
          ∃ (l' r' : _root_.BinaryTree Unit) (up_ops : List RightRotOp),
            ValidRightRotSeq Δ' k t up_ops ∧
            execRightRotSeq t up_ops = .node () l' r' ∧
            countGappedCascades up_ops = 0 ∧
            l'.num_nodes = m2 ∧
            (_root_.BinaryTree.node () l' r').num_nodes = n ∧
            rightReachList 0 l' = (rightReachList 0 t).take m2 ∧
            rightReachList (m2 + 1) r' = (rightReachList 0 t).drop (m2 + 1) := by
      intro n
      induction n using Nat.strong_induction_on with
      | h n ih =>
        intro t m2 htn hm2_lt h_ub
        rcases t with _ | ⟨_, l, r⟩
        · simp [_root_.BinaryTree.num_nodes] at htn
          omega
        · simp only [_root_.BinaryTree.num_nodes] at htn
          have h_not_lt : ¬ l.num_nodes < m2 := by
            intro hlt
            have hlen_l : (rightReachList 0 l).length = l.num_nodes := h_rr_len l 0
            have hmem :
                0 + l.num_nodes + r.num_nodes ∈
                  (rightReachList 0 l ++
                    (0 + l.num_nodes + r.num_nodes) ::
                    rightReachList (0 + l.num_nodes + 1) r).take m2 :=
              h_mem_take_mid (rightReachList 0 l)
                (rightReachList (0 + l.num_nodes + 1) r)
                (0 + l.num_nodes + r.num_nodes) m2 (by omega)
            have hub_m := h_ub (0 + l.num_nodes + r.num_nodes) (by
              simpa [rightReachList, List.append_assoc] using hmem)
            omega
          by_cases hm_eq : l.num_nodes = m2
          · subst hm_eq
            have hlen_l : (rightReachList 0 l).length = l.num_nodes := h_rr_len l 0
            refine ⟨l, r, [], trivial, rfl, rfl, rfl, ?_, ?_, ?_⟩
            · simp only [_root_.BinaryTree.num_nodes]
              omega
            · simp only [rightReachList, List.append_assoc]
              rw [h_take_app_le (rightReachList 0 l) _ l.num_nodes (by omega),
                List.take_of_length_le (by omega)]
            · simp only [rightReachList, List.append_assoc, Nat.zero_add]
              exact (h_drop_mid (rightReachList 0 l) (rightReachList (l.num_nodes + 1) r)
                (l.num_nodes + r.num_nodes) l.num_nodes hlen_l).symm
          · have hm_lt_l : m2 < l.num_nodes := by omega
            have hlen_l : (rightReachList 0 l).length = l.num_nodes := h_rr_len l 0
            have h_take_t :
                (rightReachList 0 (.node () l r)).take m2 = (rightReachList 0 l).take m2 := by
              simp only [rightReachList, List.append_assoc]
              exact h_take_app_le (rightReachList 0 l) _ m2 (by omega)
            have h_ub_l : ∀ x ∈ (rightReachList 0 l).take m2, x < m2 := by
              rw [← h_take_t]
              exact h_ub
            obtain ⟨A, B, l_ops, hl_val, hl_ex, hl_cnt, hA_n, hAB_n, hA_rr, hB_rr⟩ :=
              ih l.num_nodes (by omega) l m2 rfl hm_lt_l h_ub_l
            obtain ⟨hc_map, hL_map, _⟩ := h_mapDir_seq k .L l_ops hl_cnt
            obtain ⟨hmid_val, hmid_ex⟩ := hL_map l r rfl hl_val
            rw [hl_ex] at hmid_ex
            let rot_root : List RightRotOp := [.single []]
            have hrot_val : ValidRightRotSeq Δ' k (.node () (.node () A B) r) rot_root := by
              refine ⟨?_, trivial⟩
              simp only [validRightRotOp, subtreeAtPos, leftSpineLen]
              omega
            obtain ⟨hcat_v, hcat_ex, hcat_c⟩ :=
              h_seq_cat k (l_ops.map (shiftOp [.L])) rot_root (.node () l r)
            refine ⟨A, .node () B r, l_ops.map (shiftOp [.L]) ++ rot_root, ?_, ?_, ?_, hA_n, ?_, ?_, ?_⟩
            · rw [hcat_v, hmid_ex]
              exact ⟨hmid_val, hrot_val⟩
            · rw [hcat_ex, hmid_ex]
              rfl
            · rw [hcat_c, hc_map]
              rfl
            · simp only [_root_.BinaryTree.num_nodes] at hAB_n ⊢
              omega
            · rw [hA_rr, h_take_t]
            · simp only [rightReachList, List.append_assoc, Nat.zero_add] at hB_rr ⊢
              simp only [_root_.BinaryTree.num_nodes] at hAB_n
              have h1 : m2 + 1 + B.num_nodes = l.num_nodes := by omega
              rw [h_drop_app_le (rightReachList 0 l) _ (m2 + 1) (by omega), hB_rr, h1]
    have h_ind :
        ∀ (n : ℕ) (t1 t2 : _root_.BinaryTree Unit),
          t2.num_nodes = n →
          t1.num_nodes = n →
          List.Forall₂ (· ≤ ·) (rightReachList 0 t1) (rightReachList 0 t2) →
          ∃ seq : List RightRotOp,
            ValidRightRotSeq Δ' k t1 seq ∧
            execRightRotSeq t1 seq = t2 ∧
            countGappedCascades seq = 0 := by
      intro n
      induction n using Nat.strong_induction_on with
      | h n ih =>
        intro t1 t2 ht2n ht1n hfor
        rcases t2 with _ | ⟨_, l2, r2⟩
        · simp only [_root_.BinaryTree.num_nodes] at ht2n
          subst ht2n
          rcases t1 with _ | ⟨_, _, _⟩
          · exact ⟨[], trivial, rfl, rfl⟩
          · simp [_root_.BinaryTree.num_nodes] at ht1n
        · simp only [_root_.BinaryTree.num_nodes] at ht2n
          let m2 := l2.num_nodes
          have hm2_lt : m2 < n := by omega
          have hlen_l2 : (rightReachList 0 l2).length = m2 := h_rr_len l2 0
          have h_t2_take : (rightReachList 0 (.node () l2 r2)).take m2 = rightReachList 0 l2 := by
            simp only [rightReachList, List.append_assoc]
            rw [h_take_app_le (rightReachList 0 l2) _ m2 (by omega),
              List.take_of_length_le (by omega)]
          have h_t2_drop :
              (rightReachList 0 (.node () l2 r2)).drop (m2 + 1) = rightReachList (m2 + 1) r2 := by
            simp only [rightReachList, List.append_assoc, Nat.zero_add]
            exact h_drop_mid (rightReachList 0 l2) (rightReachList (m2 + 1) r2)
              (m2 + r2.num_nodes) m2 hlen_l2
          have hfor_take := h_forall2_take _ _ hfor m2
          rw [h_t2_take] at hfor_take
          have hub_t1 : ∀ x ∈ (rightReachList 0 t1).take m2, x < m2 := by
            refine h_forall2_ub _ _ m2 hfor_take (fun y hy => ?_)
            have h1 := h_rr_lt l2 0 y hy
            dsimp (config := { failIfUnchanged := false }) only [m2]
            omega
          obtain ⟨l1', r1', up_ops, hup_v, hup_ex, hup_c, hl1_n, ht1'_n, hl1_rr, hr1_rr⟩ :=
            h_lift_root n t1 m2 ht1n hm2_lt hub_t1
          have hr1_n : r1'.num_nodes = r2.num_nodes := by
            simp only [_root_.BinaryTree.num_nodes] at ht1'_n
            omega
          have hfor_l : List.Forall₂ (· ≤ ·) (rightReachList 0 l1') (rightReachList 0 l2) := by
            rw [hl1_rr]
            exact hfor_take
          have hfor_drop := h_forall2_drop _ _ hfor (m2 + 1)
          rw [← hr1_rr, h_t2_drop] at hfor_drop
          have hfor_r : List.Forall₂ (· ≤ ·) (rightReachList 0 r1') (rightReachList 0 r2) := by
            have hs1 := h_rr_shift r1' 0 (m2 + 1)
            have hs2 := h_rr_shift r2 0 (m2 + 1)
            simp only [Nat.zero_add] at hs1 hs2
            rw [hs1, hs2] at hfor_drop
            exact h_forall2_unmap_add _ _ (m2 + 1) hfor_drop
          obtain ⟨seq_L, hsL_v, hsL_ex, hsL_c⟩ := ih m2 hm2_lt l1' l2 rfl hl1_n hfor_l
          obtain ⟨seq_R, hsR_v, hsR_ex, hsR_c⟩ :=
            ih r2.num_nodes (by omega) r1' r2 rfl hr1_n hfor_r
          obtain ⟨hc_L, hmap_L, _⟩ := h_mapDir_seq k .L seq_L hsL_c
          obtain ⟨hc_R, _, hmap_R⟩ := h_mapDir_seq k .R seq_R hsR_c
          obtain ⟨hLv, hLex⟩ := hmap_L l1' r1' rfl hsL_v
          rw [hsL_ex] at hLex
          obtain ⟨hRv, hRex⟩ := hmap_R l2 r1' rfl hsR_v
          rw [hsR_ex] at hRex
          let sL_sh := seq_L.map (shiftOp [.L])
          let sR_sh := seq_R.map (shiftOp [.R])
          obtain ⟨hc1_v, hc1_ex, hc1_c⟩ := h_seq_cat k up_ops sL_sh t1
          obtain ⟨hc2_v, hc2_ex, hc2_c⟩ := h_seq_cat k (up_ops ++ sL_sh) sR_sh t1
          refine ⟨(up_ops ++ sL_sh) ++ sR_sh, ?_, ?_, ?_⟩
          · rw [hc2_v, hc1_v, hc1_ex, hup_ex, hLex]
            exact ⟨⟨hup_v, hLv⟩, hRv⟩
          · rw [hc2_ex, hc1_ex, hup_ex, hLex, hRex]
          · rw [hc2_c, hc1_c, hup_c, hc_L, hc_R]
    intro t1 t2 hn hfor
    exact h_ind t2.num_nodes t1 t2 rfl hn hfor




  have h_global_proj_seq :
      ∀ (k' M S : ℕ),
        1 ≤ k' →
        1 ≤ M →
        D ≤ S →
        ∀ (seq : List RightRotOp) (T : _root_.BinaryTree ℕ),
          IsRangeBST 0 T →
          T.num_nodes = M * S →
          ValidRightRotSeq Δ' (k' + 2) (eraseKeys T) seq →
          ∃ g_seq : List RightRotOp,
            ValidRightRotSeq Δ' k' (globalTree D S T) g_seq ∧
            countPureInterblockCascades S T seq = countGappedCascades g_seq := by
    intro k' M S hk' hM hS seq
    induction seq with
    | nil =>
      intro T _ _ _
      exact ⟨[], trivial, rfl⟩
    | cons op rest ih =>
      intro T hbst hnodes ⟨hop, hrest⟩
      let T' := execRightRotOpGen T op
      have hek_T' : eraseKeys T' = execRightRotOp (eraseKeys T) op := h_ek_op T op
      have ⟨hG_n, hdom_step⟩ := preorder_global_single_dominance Δ' M S T hM hS hbst hnodes
      obtain ⟨hbst', hnodes', hreach⟩ := hdom_step (k' + 2) op hop
      have ⟨hG'_n, _⟩ := preorder_global_single_dominance Δ' M S T' hM hS hbst' hnodes'
      rw [← hek_T'] at hrest
      obtain ⟨g_rest, hg_rest_v, hg_rest_c⟩ := ih T' hbst' hnodes' hrest
      cases op with
      | single pos =>
        obtain ⟨step_ops, hst_v, hst_ex, hst_c⟩ :=
          h_tamari_sim k' (globalTree D S T) (globalTree D S T') (hG_n.trans hG'_n.symm) hreach
        obtain ⟨hcat_v, _, hcat_c⟩ := h_seq_cat k' step_ops g_rest (globalTree D S T)
        refine ⟨step_ops ++ g_rest, ?_, ?_⟩
        · rw [hcat_v, hst_ex]
          exact ⟨hst_v, hg_rest_v⟩
        · simp only [countPureInterblockCascades, hcat_c, hst_c, Nat.zero_add]
          exact hg_rest_c
      | cascade pos gaps =>
        cases hp : allPairsInterblock S (subtreeAtPosGen T pos) gaps with
        | false =>
          obtain ⟨step_ops, hst_v, hst_ex, hst_c⟩ :=
            h_tamari_sim k' (globalTree D S T) (globalTree D S T') (hG_n.trans hG'_n.symm) hreach
          obtain ⟨hcat_v, _, hcat_c⟩ := h_seq_cat k' step_ops g_rest (globalTree D S T)
          refine ⟨step_ops ++ g_rest, ?_, ?_⟩
          · rw [hcat_v, hst_ex]
            exact ⟨hst_v, hg_rest_v⟩
          · simp only [countPureInterblockCascades, hp, Bool.false_eq_true, ↓reduceIte,
              hcat_c, hst_c, Nat.zero_add]
            exact hg_rest_c
        | true =>
          obtain ⟨step_ops, hst_v, hst_ex, hst_c⟩ :=
            preorder_global_interblock_cascade_proj Δ' k' M S T pos gaps hk' hM hS hbst hnodes hop hp
          obtain ⟨hcat_v, _, hcat_c⟩ := h_seq_cat k' step_ops g_rest (globalTree D S T)
          refine ⟨step_ops ++ g_rest, ?_, ?_⟩
          · rw [hcat_v, hst_ex]
            exact ⟨hst_v, hg_rest_v⟩
          · simp only [countPureInterblockCascades, hp, ↓reduceIte, hcat_c, hst_c]
            dsimp (config := { failIfUnchanged := false }) only [T'] at hg_rest_c
            omega

  have h_step_comb :
      ∀ (k' M S B_blk B_glb : ℕ),
        1 ≤ k' →
        1 ≤ M →
        D ≤ S →
        (∀ (w : _root_.BinaryTree Unit) (w_seq : List RightRotOp),
          w.num_nodes = S →
          ValidRightRotSeq Δ' (k' + 2) w w_seq →
          countGappedCascades w_seq ≤ B_blk) →
        (∀ (g : _root_.BinaryTree Unit) (g_seq : List RightRotOp),
          g.num_nodes = D * M →
          ValidRightRotSeq Δ' k' g g_seq →
          countGappedCascades g_seq ≤ B_glb) →
        ∀ (u : _root_.BinaryTree Unit) (seq : List RightRotOp),
          u.num_nodes = M * S →
          ValidRightRotSeq Δ' (k' + 2) u seq →
          countGappedCascades seq ≤ M * B_blk + (D + 1) * (M * S) + B_glb := by
    intro k' M S B_blk B_glb hk' hM hS h_blk h_glb u seq hu_n hv
    have hS1 : 1 ≤ S := by omega
    obtain ⟨_, b_seqs, hb_spec, hcnt_le⟩ :=
      block_and_typeB_cascade_bound Δ' (k' + 2) M S u seq (by omega) hM hS1 hu_n hv
    have h_sum_blk : (∑ m : Fin M, countGappedCascades (b_seqs m).2) ≤ M * B_blk := by
      calc (∑ m : Fin M, countGappedCascades (b_seqs m).2)
        _ ≤ (Finset.univ : Finset (Fin M)).card • B_blk := by
            apply Finset.sum_le_card_nsmul
            intro m _
            exact h_blk (b_seqs m).1 (b_seqs m).2 (hb_spec m).1 (hb_spec m).2
        _ = M * B_blk := by simp [smul_eq_mul]
    let T0 := labelRange 0 u
    obtain ⟨hT0_bst, hT0_n, hT0_ek⟩ := h_labelRange_spec u 0
    rw [hu_n] at hT0_n
    have ⟨hG0_n, _⟩ := preorder_global_single_dominance Δ' M S T0 hM hS hT0_bst hT0_n
    have hv_T0 : ValidRightRotSeq Δ' (k' + 2) (eraseKeys T0) seq := by
      rw [hT0_ek]
      exact hv
    obtain ⟨g_seq, hg_v, hg_c⟩ := h_global_proj_seq k' M S hk' hM hS seq T0 hT0_bst hT0_n hv_T0
    have h_glb_le : countPureInterblockCascades S T0 seq ≤ B_glb := by
      rw [hg_c]
      exact h_glb (globalTree D S T0) g_seq hG0_n hg_v
    have hD1 : Δ' + 3 = D + 1 := by omega
    rw [hD1] at hcnt_le
    exact le_trans hcnt_le (Nat.add_le_add (Nat.add_le_add h_sum_blk le_rfl) h_glb_le)




  have h_k2_pow2 :
      ∀ (m : ℕ) (u : _root_.BinaryTree Unit) (seq : List RightRotOp),
        u.num_nodes = D * 2 ^ m →
        ValidRightRotSeq Δ' 2 u seq →
        countGappedCascades seq ≤ (2 * m + 1) * D * (D * 2 ^ m) := by
    intro m
    induction m with
    | zero =>
      intro u seq hu_n hv
      have hq := h_quad_base 2 u seq hv
      rw [hu_n] at hq
      simp only [Nat.pow_zero, Nat.mul_one] at hq ⊢
      nlinarith
    | succ m ih =>
      intro u seq hu_n hv
      let S := D * 2 ^ m
      have hpow_pos : 1 ≤ 2 ^ m := Nat.one_le_two_pow
      have hD2 : 2 ≤ D := by omega
      have hS1 : 1 ≤ S := by dsimp (config := { failIfUnchanged := false }) [S]; nlinarith
      have hu_2S : u.num_nodes = 2 * S := by
        rw [hu_n]
        dsimp (config := { failIfUnchanged := false }) [S]
        ring
      obtain ⟨hpure_imp, b_seqs, hb_spec, hcnt_le⟩ :=
        block_and_typeB_cascade_bound Δ' 2 2 S u seq (by omega) (by omega) hS1 hu_2S hv
      have hpure0 : countPureInterblockCascades S (labelRange 0 u) seq = 0 :=
        hpure_imp ⟨rfl, rfl⟩
      have hb0 := ih (b_seqs 0).1 (b_seqs 0).2 (hb_spec 0).1 (hb_spec 0).2
      have hb1 := ih (b_seqs 1).1 (b_seqs 1).2 (hb_spec 1).1 (hb_spec 1).2
      rw [Fin.sum_univ_two, hpure0] at hcnt_le
      have hD_le : Δ' + 3 ≤ 2 * D := by omega
      have hmid_le : (Δ' + 3) * (2 * S) ≤ 4 * D * S := by nlinarith
      have hrhs_eq :
          (2 * (m + 1) + 1) * D * (D * 2 ^ (m + 1)) =
            2 * ((2 * m + 1) * D * S) + 4 * D * S := by
        dsimp (config := { failIfUnchanged := false }) [S]
        ring
      rw [hrhs_eq]
      dsimp (config := { failIfUnchanged := false }) only [S] at hcnt_le hmid_le ⊢
      omega




  let scaleQStep : (ℕ → ℕ) → ℕ → ℕ := fun prev j =>
    match j with
    | 0 => 1
    | j' + 1 => Nat.rec (12 * prev 2) (fun _ acc => 4 * prev acc * acc) j'
  let scaleQ0 : ℕ → ℕ := fun j =>
    match j with
    | 0 => 1
    | j' + 1 => Nat.rec 12 (fun _ acc => 2 ^ (2 * acc) * acc) j'
  let scaleQ : ℕ → ℕ → ℕ := fun p =>
    Nat.rec scaleQ0 (fun _ prev => scaleQStep prev) p

  have h_scaleQ_props :
      ∀ p : ℕ,
        (∀ j : ℕ, 1 ≤ scaleQ p j) ∧
        (∀ j : ℕ, 1 ≤ j → 12 ≤ scaleQ p j) ∧
        Monotone (scaleQ p) ∧
        (∀ j : ℕ, ackermann (p + 2) j ≤ scaleQ p j) := by
    intro p
    induction p with
    | zero =>
      have h_step0 : ∀ j0 : ℕ, scaleQ 0 (j0 + 1) ≤ scaleQ 0 (j0 + 2) := by
        intro j0
        let q := scaleQ 0 (j0 + 1)
        change q ≤ 2 ^ (2 * q) * q
        have hpow : 1 ≤ 2 ^ (2 * q) := Nat.one_le_two_pow
        exact Nat.le_mul_of_pos_left q hpow
      have h_ge12 : ∀ j0 : ℕ, 12 ≤ scaleQ 0 (j0 + 1) := by
        intro j0
        induction j0 with
        | zero => exact le_rfl
        | succ j0 ih => exact le_trans ih (h_step0 j0)
      have h_pos : ∀ j : ℕ, 1 ≤ scaleQ 0 j := by
        rintro (_ | j0)
        · exact le_rfl
        · have := h_ge12 j0
          omega
      have h_mono : Monotone (scaleQ 0) := by
        apply monotone_nat_of_le_succ
        rintro (_ | j0)
        · change 1 ≤ 12
          omega
        · exact h_step0 j0
      have h_ack : ∀ j : ℕ, ackermann 2 j ≤ scaleQ 0 j := by
        intro j
        induction j with
        | zero => exact le_rfl
        | succ j ih =>
          rcases j with _ | j0
          · change 4 ≤ 12
            omega
          · let q := scaleQ 0 (j0 + 1)
            change 2 ^ ackermann 2 (j0 + 1) ≤ 2 ^ (2 * q) * q
            have hq_pos : 0 < q := h_pos (j0 + 1)
            have hexp : ackermann 2 (j0 + 1) ≤ 2 * q := by
              change ackermann 2 (j0 + 1) ≤ q at ih
              omega
            have hp1 : 2 ^ ackermann 2 (j0 + 1) ≤ 2 ^ (2 * q) :=
              Nat.pow_le_pow_right (by omega) hexp
            exact le_trans hp1 (Nat.le_mul_of_pos_right _ hq_pos)
      exact ⟨h_pos, fun j hj => by rcases j with _ | j0; omega; exact h_ge12 j0, h_mono, h_ack⟩
    | succ p ih_p =>
      obtain ⟨hp_pos, _, hp_mono, hp_ack⟩ := ih_p
      have h_stepS : ∀ j0 : ℕ, scaleQ (p + 1) (j0 + 1) ≤ scaleQ (p + 1) (j0 + 2) := by
        intro j0
        let q := scaleQ (p + 1) (j0 + 1)
        change q ≤ 4 * scaleQ p q * q
        have h1 : 1 ≤ scaleQ p q := hp_pos q
        exact Nat.le_mul_of_pos_left q (by omega)
      have h_ge12 : ∀ j0 : ℕ, 12 ≤ scaleQ (p + 1) (j0 + 1) := by
        intro j0
        induction j0 with
        | zero =>
          change 12 ≤ 12 * scaleQ p 2
          have h1 := hp_pos 2
          omega
        | succ j0 ih => exact le_trans ih (h_stepS j0)
      have h_pos : ∀ j : ℕ, 1 ≤ scaleQ (p + 1) j := by
        rintro (_ | j0)
        · exact le_rfl
        · have := h_ge12 j0
          omega
      have h_mono : Monotone (scaleQ (p + 1)) := by
        apply monotone_nat_of_le_succ
        rintro (_ | j0)
        · exact le_trans (by decide : 1 ≤ 12) (h_ge12 0)
        · exact h_stepS j0
      have h_ack : ∀ j : ℕ, ackermann (p + 3) j ≤ scaleQ (p + 1) j := by
        intro j
        induction j with
        | zero => exact le_rfl
        | succ j ih =>
