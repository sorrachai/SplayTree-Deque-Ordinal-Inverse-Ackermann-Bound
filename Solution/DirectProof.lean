            leftSpineBottomUpNat (puqPreEmbeddedState P kops t) =
              leftSpineBottomUpNat (foldBST P (keyedState kops t)).1 ∧
            _root_.BinaryTree.IsBST (spliceMinNat (puqPreEmbeddedState P kops t)) ∧
            puqPreEmbeddedState P kops (t + 1) =
              js.foldl (fun T e => rotateRightOnLeftSpine e.x T)
                (spliceMinNat (puqPreEmbeddedState P kops t)) ∧
            ∀ j (hj : j < js.length),
              let Tj := (js.take j).foldl (fun T e => rotateRightOnLeftSpine e.x T)
                (spliceMinNat (puqPreEmbeddedState P kops t))
              _root_.BinaryTree.IsBST Tj ∧
                ∃ pre suf,
                  leftSpineBottomUpNat Tj = pre ++ (js[j]'hj).x :: (js[j]'hj).y :: suf := by
    intro t ht s hop
    dsimp (config := { failIfUnchanged := false }) only
    set H := keyedState kops t
    set F := (foldBST P H).1
    set ls := leftSpineBottomUpNat H
    set js := popJumpsAt 0 t s ls
    have hstep := hkvalid.step_valid t ht
    rw [hop] at hstep
    obtain ⟨hsP, hpopStep_s, hs_eq, _, hls_head⟩ := hstep
    change ls.head? = some s at hls_head
    have hpop_next : popIdx kops (t + 1) = s + 1 := by
      rw [← hpopStep_s]
      exact hkvalid.popIdx_after_popStep s hsP
    have hls_ne : ls ≠ [] := by
      intro hnil
      simp [hnil] at hls_head
    have hF_ls := hfold.fold_leftSpine t (le_of_lt ht)
    change leftSpineBottomUpNat F = ls ++ (rightSpineTopDownNat H).tail at hF_ls
    have hF_head : (leftSpineBottomUpNat F).head? = some s := by
      rw [hF_ls, List.head?_append_of_ne_nil _ hls_ne]
      exact hls_head
    have hT_ls : leftSpineBottomUpNat (puqPreEmbeddedState P kops t) = leftSpineBottomUpNat F := by
      have h1 := (h_s1_at t (le_of_lt ht)).2.2.1 s hF_head
      rw [← hs_eq] at h1
      have hcart_nil :
          leftSpineBottomUpNat (cartesianRangeNat (birthStep kops) s s) = [] := by
        simp [cartesianRangeNat, cartesianRangeAux, leftSpineBottomUpNat, leftSpineBottomUpAux]
      rw [h1, hcart_nil, List.nil_append]
    have hbst_Tt : _root_.BinaryTree.IsBST (puqPreEmbeddedState P kops t) :=
      (h_c1 t (le_of_lt ht)).2.1
    have hbst_spTt : _root_.BinaryTree.IsBST (spliceMinNat (puqPreEmbeddedState P kops t)) :=
      (h_splice_props _ hbst_Tt).1
    obtain ⟨hbst_F, hinord_F⟩ := hfold.fold_bst_inorder t (le_of_lt ht)
    obtain ⟨hp_inF, _, hhead_inF, hsub_lsF⟩ := h_bst_props F hbst_F
    obtain ⟨hbst_spF, hinord_spF, _, _⟩ := h_splice_props F hbst_F
    have hinord_F_head : (inorderNat F).head? = some s := by
      rw [← hhead_inF]
      exact hF_head
    have hbounds_spF : ∀ k ∈ inorderNat (spliceMinNat F), s + 1 ≤ k ∧ k < P := by
      rw [hinord_spF]
      rcases hinord_F_eq : inorderNat F with _ | ⟨hd, tl⟩
      · simp [hinord_F_eq] at hinord_F_head
      · simp only [hinord_F_eq, List.head?_cons, Option.some.injEq] at hinord_F_head
        subst hinord_F_head
        simp only [List.tail_cons]
        rw [hinord_F_eq, List.pairwise_cons] at hp_inF
        intro k hk
        have hk_F : k ∈ inorderNat F := by
          rw [hinord_F_eq]
          exact List.mem_cons_of_mem hd hk
        have hkP : k < P := by
          rw [hinord_F] at hk_F
          exact (hkvalid.popIdx_bound t (le_of_lt ht) k hk_F).2
        exact ⟨hp_inF.1 k hk, hkP⟩
    have hbst_H := hkvalid.isBST_state t (le_of_lt ht)
    have hp_lsH : List.Pairwise (· < ·) ls := (h_bst_props H hbst_H).2.1
    have hjs_in_spF : ∀ u ∈ js.map JumpRecord.x, u ∈ inorderNat (spliceMinNat F) := by
      intro u hu
      rw [List.mem_map] at hu
      obtain ⟨e, he_js, rfl⟩ := hu
      simp only [js, popJumpsAt, List.mem_map, List.mem_range] at he_js
      obtain ⟨j, hj_lt, rfl⟩ := he_js
      dsimp (config := { failIfUnchanged := false }) only
      have hj_idx : 2 * j + 1 < ls.length := by omega
      have hs_lt_x : s < ls.getD (2 * j + 1) 0 := by
        rcases hls_cons : ls with _ | ⟨hd_ls, tl_ls⟩
        · simp [hls_cons] at hls_head
        · simp only [hls_cons, List.head?_cons, Option.some.injEq] at hls_head
          subst hls_head
          rw [hls_cons, List.pairwise_cons] at hp_lsH
          have htl_idx : 2 * j < tl_ls.length := by
            simp only [hls_cons, List.length_cons] at hj_idx
            omega
          have hget_tl : (hd_ls :: tl_ls).getD (2 * j + 1) 0 = tl_ls[2 * j]'htl_idx := by
            simp [List.getD, List.getElem?_eq_getElem htl_idx]
          rw [hget_tl]
          exact hp_lsH.1 _ (List.getElem_mem htl_idx)
      have hx_in_ls : ls.getD (2 * j + 1) 0 ∈ ls := by
        have hx_eq : ls.getD (2 * j + 1) 0 = ls[2 * j + 1]'hj_idx := by
          simp [List.getD, List.getElem?_eq_getElem hj_idx]
        rw [hx_eq]
        exact List.getElem_mem hj_idx
      have hx_in_F : ls.getD (2 * j + 1) 0 ∈ inorderNat F := by
        apply hsub_lsF
        rw [hF_ls]
        exact List.mem_append_left _ hx_in_ls
      rw [hinord_spF]
      rcases hinord_F_eq : inorderNat F with _ | ⟨hd_F, tl_F⟩
      · simp [hinord_F_eq] at hx_in_F
      · simp only [hinord_F_eq, List.head?_cons, Option.some.injEq] at hinord_F_head
        subst hinord_F_head
        simp only [List.tail_cons]
        rw [hinord_F_eq, List.mem_cons] at hx_in_F
        rcases hx_in_F with h_eq | h_tl
        · omega
        · exact h_tl
    have hstep_eq :
        puqPreEmbeddedState P kops (t + 1) =
          js.foldl (fun T e => rotateRightOnLeftSpine e.x T)
            (spliceMinNat (puqPreEmbeddedState P kops t)) := by
      have hfold_pop := (hfold.fold_step_pop t ht s hop).1
      have hsp_comm :
          spliceMinNat (puqPreEmbeddedState P kops t) =
            plugUnbornNat (birthStep kops) (s + 1) P (spliceMinNat F) := by
        have h := (h_s1_at t (le_of_lt ht)).2.2.2.1
        rw [← hs_eq] at h
        exact h hF_head
      have hrot_comm :=
        (h_s1 (birthStep kops) P (s + 1) P (spliceMinNat F)
          (by omega) hbst_spF hbounds_spF).2.2.2.2 (js.map JumpRecord.x) hjs_in_spF
      conv_lhs =>
        rw [puqPreEmbeddedState, hpop_next, hfold_pop]
      change plugUnbornNat (birthStep kops) (s + 1) P
        (js.foldl (fun T e => rotateRightOnLeftSpine e.x T) (spliceMinNat F)) = _
      rw [h_foldl_map_x js (spliceMinNat F), hrot_comm, ← hsp_comm, ← h_foldl_map_x]
    obtain ⟨r_ls, hspTt_ls⟩ := (h_splice_props _ hbst_Tt).2.2.1
    have hspTt_decomp :
        leftSpineBottomUpNat (spliceMinNat (puqPreEmbeddedState P kops t)) =
          r_ls ++ ls.tail ++ (rightSpineTopDownNat H).tail := by
      rw [hspTt_ls, hT_ls, hF_ls, List.tail_append_of_ne_nil hls_ne, List.append_assoc]
    have hpartial :=
      (h_s2_part3 (spliceMinNat (puqPreEmbeddedState P kops t)) hbst_spTt).2.2.2
        t s ls r_ls (rightSpineTopDownNat H).tail hls_ne hspTt_decomp
    exact ⟨hs_eq, hT_ls, hbst_spTt, hstep_eq, hpartial⟩

  have h_c4 :
      ∀ t < kops.length, ∀ v, popIdx kops (t + 1) ≤ v → v < P →
        lcrsParent P (puqPreEmbeddedState P kops t) v ≤
          lcrsParent P (puqPreEmbeddedState P kops (t + 1)) v := by
    intro t ht v hv_lo hv_hi
    set Tt := puqPreEmbeddedState P kops t
    obtain ⟨_, hbst_Tt, hinord_Tt⟩ := h_c1 t (le_of_lt ht)
    have hTt_lt_P : ∀ k ∈ inorderNat Tt, k < P := by
      intro k hk
      rw [hinord_Tt, List.Ico.mem] at hk
      exact hk.2
    rcases hop : kops[t]'ht with w | s | d
    · obtain ⟨N, hN⟩ := h_c7 t ht w hop
      rw [hN]
      exact ((h_s2_part3 Tt hbst_Tt).2.2.1 P hTt_lt_P).2 w N v
    · obtain ⟨hs_eq, _, hbst_spTt, hstep_eq, _⟩ := h_c8 t ht s hop
      have hstep := hkvalid.step_valid t ht
      rw [hop] at hstep
      obtain ⟨hsP, hpopStep_s, _⟩ := hstep
      have hpop_next : popIdx kops (t + 1) = s + 1 := by
        rw [← hpopStep_s]
        exact hkvalid.popIdx_after_popStep s hsP
      have hsv : s < v := by omega
      have hTt_head : (inorderNat Tt).head? = some s := by
        rw [hinord_Tt, ← hs_eq, List.Ico.eq_cons hsP]
        rfl
      have hsp_lcrs : lcrsParent P (spliceMinNat Tt) v = lcrsParent P Tt v :=
        (h_splice_props Tt hbst_Tt).2.2.2 P s v hTt_head hsv
      have hspTt_lt_P : ∀ k ∈ inorderNat (spliceMinNat Tt), k < P := by
        rw [(h_splice_props Tt hbst_Tt).2.1]
        intro k hk
        exact hTt_lt_P k (List.mem_of_mem_tail hk)
      have hfold_lcrs :=
        ((h_s2_part3 (spliceMinNat Tt) hbst_spTt).2.2.1 P hspTt_lt_P).1
          ((popJumpsAt 0 t s (leftSpineBottomUpNat (keyedState kops t))).map JumpRecord.x) v
      rw [hstep_eq, h_foldl_map_x, ← hsp_lcrs]
      exact hfold_lcrs
    · rcases d with _ | d'
      · rw [h_c5 t ht hop]
      · obtain ⟨_, hrot_eq, _⟩ := h_c6 t ht d' hop
        rw [hrot_eq]
        simpa using ((h_s2_part3 Tt hbst_Tt).2.2.1 P hTt_lt_P).1
          [(rightSpineTopDownNat (keyedState kops t)).getD d' 0] v

  exact ⟨h_c1, h_popIdx_mono, h_c3, h_c4, h_c5, h_c6, h_c7, h_c8, h_c9, h_c10⟩

theorem block_quotient_and_tamari_step_laws : PuqBlockQuotientLaws :=
by
  have h_forall_imp : ∀ {p q : ℕ → Prop}, (∀ x, p x → q x) →
      ∀ (T : _root_.BinaryTree ℕ), _root_.SplayDeque.Direct.ForallTree p T → _root_.SplayDeque.Direct.ForallTree q T := by
    intro p q hpq T hT
    induction hT with
    | left => exact .left
    | node l k r _ hk _ ihl ihr => exact .node l k r ihl (hpq k hk) ihr

  have h_forall_iff : ∀ (p : ℕ → Prop) (T : _root_.BinaryTree ℕ),
      _root_.SplayDeque.Direct.ForallTree p T ↔ ∀ x ∈ inorderNat T, p x := by
    intro p T
    induction T with
    | nil =>
      simp only [inorderNat, List.not_mem_nil, IsEmpty.forall_iff, implies_true, iff_true]
      exact .left
    | node k l r ihl ihr =>
      constructor
      · intro hft x hx
        cases hft with
        | node _ _ _ hl hk hr =>
          simp only [inorderNat, List.mem_append, List.mem_singleton] at hx
          rcases hx with (hxl | rfl) | hxr
          · exact ihl.mp hl x hxl
          · exact hk
          · exact ihr.mp hr x hxr
      · intro hall
        refine .node l k r (ihl.mpr fun x hx => hall x ?_) (hall k ?_) (ihr.mpr fun x hx => hall x ?_)
        · simp [inorderNat, hx]
        · simp [inorderNat]
        · simp [inorderNat, hx]

  have h_ls_aux : ∀ (t : _root_.BinaryTree ℕ) (acc : List ℕ),
      leftSpineBottomUpAux t acc = leftSpineBottomUpAux t [] ++ acc := by
    intro t
    induction t with
    | nil => intro acc; rfl
    | node k l r ihl _ =>
      intro acc
      simp only [leftSpineBottomUpAux]
      rw [ihl (k :: acc), ihl [k], List.append_assoc]
      rfl

  have h_ls_empty : leftSpineBottomUpNat .nil = [] := rfl

  have h_ls_node : ∀ (l : _root_.BinaryTree ℕ) (k : ℕ) (r : _root_.BinaryTree ℕ),
      leftSpineBottomUpNat (.node k l r) = leftSpineBottomUpNat l ++ [k] := by
    intro l k r
    unfold leftSpineBottomUpNat
    simp only [leftSpineBottomUpAux]
    exact h_ls_aux l [k]
  clear h_ls_aux

  have h_c11 : ∀ (G : _root_.BinaryTree ℕ), _root_.BinaryTree.IsBST G →
      List.Pairwise (· < ·) (leftSpineBottomUpNat G) ∧
        ∀ u ∈ leftSpineBottomUpNat G, u ∈ inorderNat G := by
    intro G hbst
    induction hbst using isBSTRec with
    | left => simp [h_ls_empty, inorderNat]
    | node k l r hfl _ _ _ ihl _ =>
      rw [h_ls_node]
      refine ⟨List.pairwise_append.mpr ⟨ihl.1, List.pairwise_singleton _ _, ?_⟩, ?_⟩
      · intro a ha b hb
        rw [List.mem_singleton] at hb
        subst hb
        exact (h_forall_iff _ l).mp hfl a (ihl.2 a ha)
      · intro u hu
        rw [List.mem_append, List.mem_singleton] at hu
        rcases hu with hu | rfl
        · have := ihl.2 u hu
          simp [inorderNat, this]
        · simp [inorderNat]

  have h_rest_forall : ∀ (p : ℕ → Prop) (lo hi : ℕ) (T : _root_.BinaryTree ℕ),
      _root_.SplayDeque.Direct.ForallTree p T → _root_.SplayDeque.Direct.ForallTree p (restrictRangeNat lo hi T) := by
    intro p lo hi T hT
    induction hT with
    | left => exact .left
    | node l k r _ hk _ ihl ihr =>
      simp only [restrictRangeNat]
      split_ifs
      · exact ihr
      · exact ihl
      · exact .node _ k _ ihl hk ihr

  have h_rest_bst : ∀ (lo hi : ℕ) (T : _root_.BinaryTree ℕ),
      _root_.BinaryTree.IsBST T → _root_.BinaryTree.IsBST (restrictRangeNat lo hi T) := by
    intro lo hi T hT
    induction hT using isBSTRec with
    | left => exact .left
    | node k l r hfl hfr _ _ ihl ihr =>
      simp only [restrictRangeNat]
      split_ifs
      · exact ihr
      · exact ihl
      · exact .node k _ _ (h_rest_forall _ lo hi l hfl) (h_rest_forall _ lo hi r hfr) ihl ihr

  have h_c6 : ∀ lo_b hi_b (T : _root_.BinaryTree ℕ), _root_.BinaryTree.IsBST T →
      ∀ x0 ∈ leftSpineBottomUpNat T, lo_b ≤ x0 →
        ∀ r, x0 ≤ r → r < hi_b →
          (r ∈ leftSpineBottomUpNat (restrictRangeNat lo_b hi_b T) ↔
            r ∈ leftSpineBottomUpNat T) := by
    intro lo_b hi_b T hbst
    induction hbst using isBSTRec with
    | left =>
      intro x0 hx0
      simp [h_ls_empty] at hx0
    | node k l R hfl _ hbst_l _ ihl _ =>
      intro x0 hx0 hlo_x0 r hx0_r hr_hi
      rw [h_ls_node, List.mem_append, List.mem_singleton] at hx0
      have hlo_k : lo_b ≤ k := by
        rcases hx0 with hx0_l | rfl
        · have hx0_lt_k : x0 < k := (h_forall_iff _ l).mp hfl x0 ((h_c11 l hbst_l).2 x0 hx0_l)
          omega
        · exact hlo_x0
      have h_not_lt : ¬(k < lo_b) := by omega
      simp only [restrictRangeNat, h_not_lt, ite_false]
      split_ifs with hhi_k
      · rcases hx0 with hx0_l | rfl
        · rw [h_ls_node, List.mem_append, List.mem_singleton]
          have hr_ne : r ≠ k := by omega
          simp only [hr_ne, or_false]
          exact ihl x0 hx0_l hlo_x0 r hx0_r hr_hi
        · omega
      · rw [h_ls_node, h_ls_node, List.mem_append, List.mem_singleton, List.mem_append, List.mem_singleton]
        by_cases hrk : r = k
        · subst hrk; simp
        · simp only [hrk, or_false]
          rcases hx0 with hx0_l | hx0_eq
          · exact ihl x0 hx0_l hlo_x0 r hx0_r hr_hi
          · have hk_lt_r : k < r := by omega
            have h1 : r ∉ leftSpineBottomUpNat (restrictRangeNat lo_b hi_b l) := by
              intro hmem
              have hbst_rl := h_rest_bst lo_b hi_b l hbst_l
              have hfl_rl := h_rest_forall (fun x => x < k) lo_b hi_b l hfl
              have := (h_forall_iff _ _).mp hfl_rl r ((h_c11 _ hbst_rl).2 r hmem)
              omega
            have h2 : r ∉ leftSpineBottomUpNat l := by
              intro hmem
              have := (h_forall_iff _ l).mp hfl r ((h_c11 l hbst_l).2 r hmem)
              omega
            simp [h1, h2]

  have h_split_pivot : ∀ (k : ℕ) (A B C D : List ℕ),
      A ++ k :: B = C ++ k :: D →
      (∀ x ∈ A, x < k) → (∀ x ∈ C, x < k) → A = C ∧ B = D := by
    intro k A
    induction A with
    | nil =>
      intro B C D heq _ hC
      rcases C with _ | ⟨c, C'⟩
      · simp at heq; exact ⟨rfl, heq⟩
      · simp only [List.nil_append, List.cons_append, List.cons.injEq] at heq
        have hc := hC c (by simp)
        omega
    | cons a A' ih =>
      intro B C D heq hA hC
      rcases C with _ | ⟨c, C'⟩
      · simp only [List.cons_append, List.nil_append, List.cons.injEq] at heq
        have ha := hA a (by simp)
        omega
      · simp only [List.cons_append, List.cons.injEq] at heq
        obtain ⟨rfl, heq'⟩ := heq
        obtain ⟨h1, h2⟩ := ih B C' D heq' (fun x hx => hA x (by simp [hx])) (fun x hx => hC x (by simp [hx]))
        exact ⟨congrArg (a :: ·) h1, h2⟩

  have h_bst_ico_split : ∀ (L : _root_.BinaryTree ℕ) (k : ℕ) (R : _root_.BinaryTree ℕ) (a b : ℕ),
      _root_.BinaryTree.IsBST (.node k L R) → inorderNat (.node k L R) = List.Ico a b →
        a ≤ k ∧ k < b ∧ inorderNat L = List.Ico a k ∧ inorderNat R = List.Ico (k + 1) b := by
    intro L k R a b hbst hin
    cases hbst using isBSTCases with
    | node _ _ _ hfl _ _ _ =>
      have hk_mem : k ∈ List.Ico a b := by
        rw [← hin]
        simp [inorderNat]
      rw [List.Ico.mem] at hk_mem
      obtain ⟨hak, hkb⟩ := hk_mem
      have hico_eq : List.Ico a b = List.Ico a k ++ k :: List.Ico (k + 1) b := by
        rw [← List.Ico.eq_cons hkb, List.Ico.append_consecutive hak (by omega)]
      have hin' : inorderNat L ++ k :: inorderNat R = List.Ico a k ++ k :: List.Ico (k + 1) b := by
        simpa [inorderNat, List.append_assoc] using hin.trans hico_eq
      have hsp := h_split_pivot k (inorderNat L) (inorderNat R) (List.Ico a k) (List.Ico (k + 1) b)
        hin' ((h_forall_iff _ L).mp hfl) (fun x hx => (List.Ico.mem.mp hx).2)
      exact ⟨hak, hkb, hsp.1, hsp.2⟩
  clear h_split_pivot

  have h_rm_ico : ∀ (R : _root_.BinaryTree ℕ) (cur b : ℕ),
      cur < b → _root_.BinaryTree.IsBST R → inorderNat R = List.Ico (cur + 1) b →
        rightmostKeyNat cur R = b - 1 := by
    intro R
    induction R with
    | nil =>
      intro cur b hcb _ hin
      simp only [inorderNat] at hin
      by_cases hlt : cur + 1 < b
      · rw [List.Ico.eq_cons hlt] at hin
        simp at hin
      · simp only [rightmostKeyNat]; omega
    | node rk rl rr _ ihrr =>
      intro cur b _ hbst hin
      obtain ⟨_, hrkb, _, hin_rr⟩ := h_bst_ico_split rl rk rr (cur + 1) b hbst hin
      cases hbst using isBSTCases with
      | node _ _ _ _ _ _ hbst_rr =>
        simp only [rightmostKeyNat]
        exact ihrr rk b hrkb hbst_rr hin_rr

  have h_c12_part1 : ∀ (G : _root_.BinaryTree ℕ) (a b : ℕ),
      _root_.BinaryTree.IsBST G → inorderNat G = List.Ico a b →
        ∀ c, a ≤ c → c < b → c ≤ subtreeMaxNat G c ∧ subtreeMaxNat G c < b := by
    intro G
    induction G with
    | nil =>
      intro a b _ hin c hac hcb
      have hlt : a < b := by omega
      rw [inorderNat, List.Ico.eq_cons hlt] at hin
      simp at hin
    | node k L R ihL ihR =>
      intro a b hbst hin c hac hcb
      obtain ⟨hak, hkb, hinL, hinR⟩ := h_bst_ico_split L k R a b hbst hin
      cases hbst using isBSTCases with
      | node _ _ _ _ _ hbstL hbstR =>
        simp only [subtreeMaxNat]
        split_ifs with hck hkc
        · have ⟨h1, h2⟩ := ihL a k hbstL hinL c hac hck
          exact ⟨h1, by omega⟩
        · exact ihR (k + 1) b hbstR hinR c hkc hcb
        · have hceqk : c = k := by omega
          subst hceqk
          rw [h_rm_ico R c b hkb hbstR hinR]
          omega

  have h_c12 : ∀ (G : _root_.BinaryTree ℕ) (a b : ℕ),
      _root_.BinaryTree.IsBST G → inorderNat G = List.Ico a b →
        (∀ c, a ≤ c → c < b → c ≤ subtreeMaxNat G c ∧ subtreeMaxNat G c < b) ∧
          (∀ u ∈ leftSpineBottomUpNat G, ∀ v ∈ leftSpineBottomUpNat G,
            u < v → subtreeMaxNat G u < v) := by
    intro G a b hbst hin
    refine ⟨h_c12_part1 G a b hbst hin, ?_⟩
    revert a b hin
    induction hbst using isBSTRec with
    | left =>
      intro a b _ u hu
      simp [h_ls_empty] at hu
    | node k L R hfl _ hbstL hbstR ihL _ =>
      intro a b hin u hu v hv huv
      obtain ⟨hak, hkb, hinL, _⟩ := h_bst_ico_split L k R a b (.node k L R hfl ‹_› hbstL hbstR) hin
      rw [h_ls_node, List.mem_append, List.mem_singleton] at hu hv
      have huL : u ∈ leftSpineBottomUpNat L := by
        rcases hu with huL | rfl
        · exact huL
        · rcases hv with hvL | rfl
          · have := (h_forall_iff _ L).mp hfl v ((h_c11 L hbstL).2 v hvL)
            omega
          · omega
      have hu_lt_k : u < k := (h_forall_iff _ L).mp hfl u ((h_c11 L hbstL).2 u huL)
      simp only [subtreeMaxNat, hu_lt_k, ite_true]
      rcases hv with hvL | hv_eq
      · exact ihL a k hinL u huL v hvL huv
      · rw [hv_eq]
        exact (h_c12_part1 L a k hbstL hinL u
          (by have := (h_c11 L hbstL).2 u huL; rw [hinL, List.Ico.mem] at this; exact this.1)
          hu_lt_k).2
  clear h_c12_part1

  have h_c10 : ∀ (G : _root_.BinaryTree ℕ) (a b u : ℕ),
      _root_.BinaryTree.IsBST G → inorderNat G = List.Ico a b →
        _root_.BinaryTree.IsBST (rotateRightOnLeftSpine u G) ∧
          inorderNat (rotateRightOnLeftSpine u G) = List.Ico a b ∧
          (∀ c ∈ leftSpineBottomUpNat (rotateRightOnLeftSpine u G),
            c ∈ leftSpineBottomUpNat G) ∧
          (∀ c, a ≤ c → c < b →
            subtreeMaxNat G c ≤ subtreeMaxNat (rotateRightOnLeftSpine u G) c) := by
    intro G a b u
    revert a b
    induction G with
    | nil =>
      intro a b hbst hin
      exact ⟨hbst, hin, fun _ h => h, fun _ _ _ => le_rfl⟩
    | node y l C ihl _ =>
      intro a b hbst hin
      rcases l with _ | ⟨x, A, B⟩
      · exact ⟨hbst, hin, fun _ h => h, fun _ _ _ => le_rfl⟩
      · obtain ⟨hay, hyb, hinL, hinC⟩ := h_bst_ico_split (.node x A B) y C a b hbst hin
        cases hbst using isBSTCases with
        | node _ _ _ hfl_y hfr_y hbstL hbstC =>
          obtain ⟨hax, hxy, hinA, hinB⟩ := h_bst_ico_split A x B a y hbstL hinL
          simp only [rotateRightOnLeftSpine]
          split_ifs with hxu
          · subst hxu
            cases hbstL using isBSTCases with
            | node _ _ _ hfl_x hfr_x hbstA hbstB =>
              cases hfl_y with
              | node _ _ _ _ _ hfl_By =>
                have hbst_ByC : _root_.BinaryTree.IsBST (.node y B C) :=
                  .node y B C hfl_By hfr_y hbstB hbstC
                have hfr_x_ByC : _root_.SplayDeque.Direct.ForallTree (fun k => x < k) (.node y B C) :=
                  .node B y C hfr_x hxy (h_forall_imp (fun k hk => lt_trans hxy hk) C hfr_y)
                have hbst' : _root_.BinaryTree.IsBST (.node x A (.node y B C)) :=
                  .node x A (.node y B C) hfl_x hfr_x_ByC hbstA hbst_ByC
                have hin_ByC : inorderNat (.node y B C) = List.Ico (x + 1) b := by
                  simp only [inorderNat, hinB, hinC, List.append_assoc, List.singleton_append]
                  rw [← List.Ico.eq_cons hyb, List.Ico.append_consecutive (by omega) (by omega)]
                have hin' : inorderNat (.node x A (.node y B C)) = List.Ico a b := by
                  change inorderNat A ++ [x] ++ inorderNat (.node y B C) = List.Ico a b
                  rw [hinA, hin_ByC]
                  simp only [List.append_assoc, List.singleton_append]
                  rw [← List.Ico.eq_cons (lt_trans hxy hyb), List.Ico.append_consecutive hax (by omega)]
                refine ⟨hbst', hin', ?_, ?_⟩
                · intro c hc
                  rw [h_ls_node] at hc
                  rw [h_ls_node, h_ls_node]
                  exact List.mem_append_left [y] hc
                · intro c hac hcb
                  by_cases hcx : c < x
                  · have hcy : c < y := lt_trans hcx hxy
                    simp [subtreeMaxNat, hcx, hcy]
                  · by_cases hxc : x < c
                    · by_cases hcy : c < y
                      · simp [subtreeMaxNat, hcx, hxc, hcy]
                      · by_cases hyc : y < c
                        · simp [subtreeMaxNat, hcx, hxc, hcy, hyc]
                        · have hceqy : c = y := by omega
                          subst hceqy
                          simp [subtreeMaxNat, hcx, hxy]
                    · have hceqx : c = x := by omega
                      subst hceqx
                      simp only [subtreeMaxNat, hxy, lt_irrefl, ite_true, ite_false]
                      rw [h_rm_ico B c y hxy hbstB hinB,
                          h_rm_ico (.node y B C) c b (lt_trans hxy hyb) hbst_ByC hin_ByC]
                      omega
          · obtain ⟨hbstL', hinL', hlsL', hmaxL'⟩ := ihl a y hbstL hinL
            have hfl_y' : _root_.SplayDeque.Direct.ForallTree (fun k => k < y) (rotateRightOnLeftSpine u (.node x A B)) :=
              (h_forall_iff _ _).mpr fun k hk => by rw [hinL', List.Ico.mem] at hk; exact hk.2
            refine ⟨.node y _ C hfl_y' hfr_y hbstL' hbstC, ?_, ?_, ?_⟩
            · simp only [inorderNat, hinL', hinC, List.append_assoc, List.singleton_append]
              rw [← List.Ico.eq_cons hyb, List.Ico.append_consecutive hay (by omega)]
            · intro c hc
              rw [h_ls_node, List.mem_append, List.mem_singleton] at hc
              rw [h_ls_node, List.mem_append, List.mem_singleton]
              rcases hc with hc | rfl
              · exact Or.inl (hlsL' c hc)
              · exact Or.inr rfl
            · intro c hac hcb
              by_cases hcy : c < y
              · simp only [subtreeMaxNat, hcy, ite_true]
                exact hmaxL' c hac hcy
              · simp only [subtreeMaxNat, hcy, ite_false]
                exact le_rfl

  have h_lcrs_le_curP : ∀ (P_top : ℕ) (U : _root_.BinaryTree ℕ) (curP x : ℕ),
      _root_.BinaryTree.IsBST U → _root_.SplayDeque.Direct.ForallTree (fun k => k < curP) U →
        x ∈ inorderNat U → lcrsParentAux P_top curP x U ≤ curP := by
    intro P_top U
    induction U with
    | nil =>
      intro curP x _ _ hx
      simp [inorderNat] at hx
    | node k l r ihl ihr =>
      intro curP x hbst hfu hx
      cases hbst using isBSTCases with
      | node _ _ _ hfl hfr hbstL hbstR =>
        cases hfu with
        | node _ _ _ hful hk_lt hfur =>
          simp only [inorderNat, List.mem_append, List.mem_singleton] at hx
          simp only [lcrsParentAux]
          split_ifs with hxk hkx
          · rcases hx with (hxl | rfl) | hxr
            · exact le_trans (ihl k x hbstL hfl hxl) (le_of_lt hk_lt)
            · omega
            · have := (h_forall_iff _ r).mp hfr x hxr; omega
          · rcases hx with (hxl | rfl) | hxr
            · have := (h_forall_iff _ l).mp hfl x hxl; omega
            · omega
            · exact ihr curP x hbstR hfur hxr
          · exact le_rfl

  have h_c13_aux : ∀ (P_top : ℕ) (B : _root_.BinaryTree ℕ) (curP x u : ℕ),
      _root_.BinaryTree.IsBST B → x ∈ inorderNat B → u ∈ leftSpineBottomUpNat B → x < u →
        lcrsParentAux P_top curP x B ≤ u := by
    intro P_top B
    induction B with
    | nil =>
      intro curP x u _ _ hu
      simp [h_ls_empty] at hu
    | node k l r ihl _ =>
      intro curP x u hbst hx hu hxu
      cases hbst using isBSTCases with
      | node _ _ _ hfl hfr hbstL _ =>
        rw [h_ls_node, List.mem_append, List.mem_singleton] at hu
        rcases hu with hul | rfl
        · have huk : u < k := (h_forall_iff _ l).mp hfl u ((h_c11 l hbstL).2 u hul)
          have hxk : x < k := lt_trans hxu huk
          have hxl : x ∈ inorderNat l := by
            simp only [inorderNat, List.mem_append, List.mem_singleton] at hx
            rcases hx with (hxl | rfl) | hxr
            · exact hxl
            · omega
            · have := (h_forall_iff _ r).mp hfr x hxr; omega
          simp only [lcrsParentAux, hxk, ite_true]
          exact ihl k x u hbstL hxl hul hxu
        · have hxl : x ∈ inorderNat l := by
            simp only [inorderNat, List.mem_append, List.mem_singleton] at hx
            rcases hx with (hxl | rfl) | hxr
            · exact hxl
            · omega
            · have := (h_forall_iff _ r).mp hfr x hxr; omega
          simp only [lcrsParentAux, hxu, ite_true]
          exact h_lcrs_le_curP P_top l u x hbstL hfl hxl

  have h_c13 : ∀ (B : _root_.BinaryTree ℕ) (P_top x u : ℕ),
      _root_.BinaryTree.IsBST B → x ∈ inorderNat B → u ∈ leftSpineBottomUpNat B → x < u →
        lcrsParent P_top B x ≤ u :=
    fun B P_top x u hbst hx hu hxu => h_c13_aux P_top B P_top x u hbst hx hu hxu
  clear h_c13_aux

  have h_getD : ∀ (xs : List (ℕ × ℕ)) (c : ℕ) (hc : c < xs.length),
      xs.getD c (0, 0) = xs[c] := by
    intro xs c hc
    simp [List.getD_eq_getElem?_getD, hc]

  have h_sbp_mono : ∀ (subs : List (ℕ × ℕ)), PuqIsSubblockPart subs →
      ∀ c d, c < d → d < subs.length → (subs.getD c (0, 0)).2 ≤ (subs.getD d (0, 0)).1 := by
    intro subs hsbp c d
    induction d with
    | zero => intro h; omega
    | succ m ih =>
      intro hcm1 hm1
      by_cases hcm : c = m
      · rw [hcm, hsbp.2.2 m hm1]
      · have h1 := ih (by omega) (by omega)
        have h2 := hsbp.2.1 m (by omega)
        have h3 := hsbp.2.2 m hm1
        omega

  have h_sbp_le_mono : ∀ (subs : List (ℕ × ℕ)), PuqIsSubblockPart subs →
      ∀ c d, c ≤ d → d < subs.length →
        (subs.getD c (0, 0)).1 ≤ (subs.getD d (0, 0)).1 ∧
          (subs.getD c (0, 0)).2 ≤ (subs.getD d (0, 0)).2 := by
    intro subs hsbp c d hcd hd
    by_cases heq : c = d
    · rw [heq]; exact ⟨le_rfl, le_rfl⟩
    · have hm := h_sbp_mono subs hsbp c d (by omega) hd
      have hc := hsbp.2.1 c (by omega)
      have hd' := hsbp.2.1 d hd
      omega

  have h_sbp_findIdx_eq : ∀ (subs : List (ℕ × ℕ)), PuqIsSubblockPart subs →
      ∀ c < subs.length, ∀ k,
        (subs.getD c (0, 0)).1 ≤ k → k < (subs.getD c (0, 0)).2 →
        subs.findIdx (fun b => decide (b.1 ≤ k ∧ k < b.2)) = c := by
    intro subs hsbp c hc k hk1 hk2
    rw [List.findIdx_eq hc]
    refine ⟨?_, ?_⟩
    · rw [← h_getD subs c hc]
      exact decide_eq_true ⟨hk1, hk2⟩
    · intro j hjc
      have hj_lt : j < subs.length := lt_trans hjc hc
      rw [← h_getD subs j hj_lt]
      have hm := h_sbp_mono subs hsbp j c hjc hc
      exact decide_eq_false (by omega)
  clear h_getD

  have h_sbp_idx : ∀ (subs : List (ℕ × ℕ)), PuqIsSubblockPart subs →
      ∀ c_lo c_hi, c_lo < c_hi → c_hi ≤ subs.length →
      ∀ k, (subs.getD c_lo (0, 0)).1 ≤ k → k < (subs.getD (c_hi - 1) (0, 0)).2 →
        let c := subs.findIdx (fun b => decide (b.1 ≤ k ∧ k < b.2))
        c_lo ≤ c ∧ c < c_hi ∧ (subs.getD c (0, 0)).1 ≤ k ∧ k < (subs.getD c (0, 0)).2 := by
    intro subs hsbp c_lo c_hi hlt hchi k hk1 hk2
    have hex : ∃ c0, c_lo ≤ c0 ∧ c0 < c_hi ∧
        (subs.getD c0 (0, 0)).1 ≤ k ∧ k < (subs.getD c0 (0, 0)).2 := by
      revert hlt hchi hk2
      induction c_hi with
      | zero => intro hlt; omega
      | succ m ih =>
        intro hlt hm1 hk2
        simp only [Nat.add_sub_cancel] at hk2
        by_cases hcm : c_lo = m
        · rw [hcm] at hk1 ⊢
          exact ⟨m, le_rfl, by omega, hk1, hk2⟩
        · by_cases hmk : (subs.getD m (0, 0)).1 ≤ k
          · exact ⟨m, by omega, by omega, hmk, hk2⟩
          · have hadj := hsbp.2.2 (m - 1) (by omega)
            have hrw : m - 1 + 1 = m := by omega
            rw [hrw] at hadj
            obtain ⟨c0, h1, h2, h3, h4⟩ := ih (by omega) (by omega) (by omega)
            exact ⟨c0, h1, by omega, h3, h4⟩
    obtain ⟨c0, hc0_lo, hc0_hi, hc0_1, hc0_2⟩ := hex
    have hceq := h_sbp_findIdx_eq subs hsbp c0 (lt_of_lt_of_le hc0_hi hchi) k hc0_1 hc0_2
    dsimp (config := { failIfUnchanged := false }) only
    rw [hceq]
    exact ⟨hc0_lo, hc0_hi, hc0_1, hc0_2⟩
  clear h_sbp_findIdx_eq

  have h_bq_empty_of_le : ∀ (subs : List (ℕ × ℕ)) (c_lo c_hi : ℕ) (U : _root_.BinaryTree ℕ),
      c_hi ≤ c_lo → puqBlockQuotient subs c_lo c_hi U = .nil := by
    intro subs c_lo c_hi U hle
    cases U with
    | nil => rfl
    | node k l r => simp [puqBlockQuotient, hle]

  have h_bq_bounds_bst : ∀ (subs : List (ℕ × ℕ)), PuqIsSubblockPart subs →
      ∀ (T : _root_.BinaryTree ℕ) (c_lo c_hi : ℕ), c_lo ≤ c_hi → c_hi ≤ subs.length →
        _root_.SplayDeque.Direct.ForallTree (fun x => c_lo ≤ x ∧ x < c_hi) (puqBlockQuotient subs c_lo c_hi T) ∧
          _root_.BinaryTree.IsBST (puqBlockQuotient subs c_lo c_hi T) := by
    intro subs hsbp T
    induction T with
    | nil =>
      intro c_lo c_hi _ _
      exact ⟨.left, .left⟩
    | node k l r ihl ihr =>
      intro c_lo c_hi hle hchi
      by_cases hge : c_hi ≤ c_lo
      · rw [h_bq_empty_of_le subs c_lo c_hi _ hge]
        exact ⟨.left, .left⟩
      · have hlt : c_lo < c_hi := by omega
        simp only [puqBlockQuotient, hge, ite_false]
        split_ifs with hk_lo hk_hi
        · exact ihr c_lo c_hi hle hchi
        · exact ihl c_lo c_hi hle hchi
        · obtain ⟨hc_lo, hc_hi, _, _⟩ :=
            h_sbp_idx subs hsbp c_lo c_hi hlt hchi k (by omega) (by omega)
          set c := subs.findIdx (fun b => decide (b.1 ≤ k ∧ k < b.2))
          obtain ⟨hfl, hbstL⟩ := ihl c_lo c hc_lo (by omega)
          obtain ⟨hfr, hbstR⟩ := ihr (c + 1) c_hi (by omega) hchi
          refine ⟨.node _ c _ (h_forall_imp (fun x hx => ⟨hx.1, lt_trans hx.2 hc_hi⟩) _ hfl)
              ⟨hc_lo, hc_hi⟩
              (h_forall_imp (fun x hx => ⟨by omega, hx.2⟩) _ hfr),
            .node c _ _ (h_forall_imp (fun x hx => hx.2) _ hfl)
              (h_forall_imp (fun x hx => by omega) _ hfr) hbstL hbstR⟩

  have h_c1 : ∀ (subs : List (ℕ × ℕ)), PuqIsSubblockPart subs →
      ∀ c_lo c_hi, c_lo ≤ c_hi → c_hi ≤ subs.length →
      ∀ T, _root_.BinaryTree.IsBST T → _root_.BinaryTree.IsBST (puqBlockQuotient subs c_lo c_hi T) :=
    fun subs hsbp c_lo c_hi hle hchi T _ => (h_bq_bounds_bst subs hsbp T c_lo c_hi hle hchi).2

  have h_c2_aux : ∀ (subs : List (ℕ × ℕ)), PuqIsSubblockPart subs →
      ∀ (T : _root_.BinaryTree ℕ) (c_lo c_hi loT hiT : ℕ),
        c_lo ≤ c_hi → c_hi ≤ subs.length →
        _root_.BinaryTree.IsBST T → inorderNat T = List.Ico loT hiT →
        (c_lo < c_hi → loT ≤ (subs.getD c_lo (0, 0)).1 ∧ (subs.getD (c_hi - 1) (0, 0)).2 ≤ hiT) →
        inorderNat (puqBlockQuotient subs c_lo c_hi T) = List.Ico c_lo c_hi := by
    intro subs hsbp T
    induction T with
    | nil =>
      intro c_lo c_hi loT hiT hle hchi _ hin hcov
      by_cases hge : c_hi ≤ c_lo
      · rw [h_bq_empty_of_le subs c_lo c_hi .nil hge, inorderNat, List.Ico.eq_nil_of_le hge]
      · have hlt : c_lo < c_hi := by omega
        obtain ⟨hcov1, hcov2⟩ := hcov hlt
        have hmono := h_sbp_le_mono subs hsbp c_lo (c_hi - 1) (by omega) (by omega)
        have hnonempty := hsbp.2.1 c_lo (by omega)
        have hlo_lt_hi : loT < hiT := by omega
        rw [inorderNat, List.Ico.eq_cons hlo_lt_hi] at hin
        simp at hin
    | node k l r ihl ihr =>
      intro c_lo c_hi loT hiT hle hchi hbst hin hcov
      by_cases hge : c_hi ≤ c_lo
      · rw [h_bq_empty_of_le subs c_lo c_hi _ hge, inorderNat, List.Ico.eq_nil_of_le hge]
      · have hlt : c_lo < c_hi := by omega
        obtain ⟨hcov1, hcov2⟩ := hcov hlt
        obtain ⟨hlo_k, hk_hi, hinL, hinR⟩ := h_bst_ico_split l k r loT hiT hbst hin
        cases hbst using isBSTCases with
        | node _ _ _ _ _ hbstL hbstR =>
          simp only [puqBlockQuotient, hge, ite_false]
          split_ifs with hk_lob hk_hib
          · exact ihr c_lo c_hi (k + 1) hiT hle hchi hbstR hinR (fun _ => ⟨by omega, hcov2⟩)
          · exact ihl c_lo c_hi loT k hle hchi hbstL hinL (fun _ => ⟨hcov1, by omega⟩)
          · obtain ⟨hc_lo, hc_hi, hck1, hck2⟩ :=
              h_sbp_idx subs hsbp c_lo c_hi hlt hchi k (by omega) (by omega)
            set c := subs.findIdx (fun b => decide (b.1 ≤ k ∧ k < b.2))
            have hin_ql : inorderNat (puqBlockQuotient subs c_lo c l) = List.Ico c_lo c := by
              refine ihl c_lo c loT k hc_lo (by omega) hbstL hinL (fun hlt_c => ⟨hcov1, ?_⟩)
              have hadj := hsbp.2.2 (c - 1) (by omega)
              have hrw : c - 1 + 1 = c := by omega
              rw [hrw] at hadj
              omega
            have hin_qr : inorderNat (puqBlockQuotient subs (c + 1) c_hi r) = List.Ico (c + 1) c_hi := by
              refine ihr (c + 1) c_hi (k + 1) hiT (by omega) hchi hbstR hinR (fun hlt_c => ⟨?_, hcov2⟩)
              have hadj := hsbp.2.2 c (by omega)
              omega
            simp only [inorderNat, hin_ql, hin_qr, List.append_assoc, List.singleton_append]
            rw [← List.Ico.eq_cons hc_hi, List.Ico.append_consecutive hc_lo (by omega)]

  have h_c2 : ∀ (subs : List (ℕ × ℕ)), PuqIsSubblockPart subs →
      ∀ c_lo c_hi, c_lo < c_hi → c_hi ≤ subs.length →
      ∀ T loT hiT, _root_.BinaryTree.IsBST T →
        inorderNat T = List.Ico loT hiT →
        loT ≤ (subs.getD c_lo (0, 0)).1 →
        (subs.getD (c_hi - 1) (0, 0)).2 ≤ hiT →
        inorderNat (puqBlockQuotient subs c_lo c_hi T) = List.Ico c_lo c_hi :=
    fun subs hsbp c_lo c_hi hlt hchi T loT hiT hbst hin h1 h2 =>
      h_c2_aux subs hsbp T c_lo c_hi loT hiT (le_of_lt hlt) hchi hbst hin (fun _ => ⟨h1, h2⟩)
  clear h_c2_aux

  have h_c3_aux : ∀ (subs : List (ℕ × ℕ)), PuqIsSubblockPart subs →
      ∀ (lo_0 hi_0 : ℕ) (T : _root_.BinaryTree ℕ) (c_lo c_hi : ℕ),
        c_lo ≤ c_hi → c_hi ≤ subs.length →
        (c_lo < c_hi → lo_0 ≤ (subs.getD c_lo (0, 0)).1 ∧ (subs.getD (c_hi - 1) (0, 0)).2 ≤ hi_0) →
        puqBlockQuotient subs c_lo c_hi (restrictRangeNat lo_0 hi_0 T) =
          puqBlockQuotient subs c_lo c_hi T := by
    intro subs hsbp lo_0 hi_0 T
    induction T with
    | nil => intro c_lo c_hi _ _ _; rfl
    | node k l r ihl ihr =>
      intro c_lo c_hi hle hchi hcov
      by_cases hge : c_hi ≤ c_lo
      · rw [h_bq_empty_of_le subs c_lo c_hi _ hge, h_bq_empty_of_le subs c_lo c_hi _ hge]
      · have hlt : c_lo < c_hi := by omega
        obtain ⟨hcov1, hcov2⟩ := hcov hlt
        have hmono := h_sbp_le_mono subs hsbp c_lo (c_hi - 1) (by omega) (by omega)
        have hnonempty := hsbp.2.1 c_lo (by omega)
        simp only [restrictRangeNat]
        split_ifs with hk_lo0 hk_hi0
        · have hk_lob : k < (subs.getD c_lo (0, 0)).1 := by omega
          simp only [puqBlockQuotient, hge, hk_lob, ite_false, ite_true]
          exact ihr c_lo c_hi hle hchi hcov
        · have hk_lob : ¬(k < (subs.getD c_lo (0, 0)).1) := by omega
          have hk_hib : (subs.getD (c_hi - 1) (0, 0)).2 ≤ k := by omega
          simp only [puqBlockQuotient, hge, hk_lob, hk_hib, ite_false, ite_true]
          exact ihl c_lo c_hi hle hchi hcov
        · simp only [puqBlockQuotient, hge, ite_false]
          split_ifs with hk_lob hk_hib
          · exact ihr c_lo c_hi hle hchi hcov
          · exact ihl c_lo c_hi hle hchi hcov
          · obtain ⟨hc_lo, hc_hi, _, _⟩ :=
              h_sbp_idx subs hsbp c_lo c_hi hlt hchi k (by omega) (by omega)
            set c := subs.findIdx (fun b => decide (b.1 ≤ k ∧ k < b.2))
            congr 1
            · refine ihl c_lo c hc_lo (by omega) (fun hlt_c => ⟨hcov1, ?_⟩)
              have hm := h_sbp_le_mono subs hsbp (c - 1) (c_hi - 1) (by omega) (by omega)
              omega
            · refine ihr (c + 1) c_hi (by omega) hchi (fun hlt_c => ⟨?_, hcov2⟩)
              have hm := h_sbp_le_mono subs hsbp c_lo (c + 1) (by omega) (by omega)
              omega

  have h_c3 : ∀ (subs : List (ℕ × ℕ)), PuqIsSubblockPart subs →
      ∀ c_lo c_hi, c_lo < c_hi → c_hi ≤ subs.length →
      ∀ T, _root_.BinaryTree.IsBST T →
        puqBlockQuotient subs c_lo c_hi T =
          puqBlockQuotient subs c_lo c_hi
            (restrictRangeNat (subs.getD c_lo (0, 0)).1 (subs.getD (c_hi - 1) (0, 0)).2 T) :=
    fun subs hsbp c_lo c_hi hlt hchi T _ =>
      (h_c3_aux subs hsbp _ _ T c_lo c_hi (le_of_lt hlt) hchi (fun _ => ⟨le_rfl, le_rfl⟩)).symm
  clear h_c3_aux

  have h_rest_empty_of_le : ∀ (a b : ℕ) (U : _root_.BinaryTree ℕ),
      b ≤ a → restrictRangeNat a b U = .nil := by
    intro a b U hba
    induction U with
    | nil => rfl
    | node k l r ihl ihr =>
      simp only [restrictRangeNat]
      split_ifs with hk_a hk_b
      · exact ihr
      · exact ihl
      · omega

  have h_rest_id : ∀ (a b : ℕ) (U : _root_.BinaryTree ℕ),
      _root_.SplayDeque.Direct.ForallTree (fun x => a ≤ x ∧ x < b) U → restrictRangeNat a b U = U := by
    intro a b U hft
    induction hft with
    | left => rfl
    | node l k r _ hk _ ihl ihr =>
      have h1 : ¬(k < a) := by omega
      have h2 : ¬(b ≤ k) := by omega
      simp [restrictRangeNat, h1, h2, ihl, ihr]

  have h_rest_hi_congr : ∀ (a c c_hi : ℕ) (U : _root_.BinaryTree ℕ),
      c ≤ c_hi → _root_.SplayDeque.Direct.ForallTree (fun x => x < c) U →
        restrictRangeNat a c_hi U = restrictRangeNat a c U := by
    intro a c c_hi U hle hft
    induction hft with
    | left => rfl
    | node l k r _ hk _ ihl ihr =>
      have h1 : ¬(c_hi ≤ k) := by omega
      have h2 : ¬(c ≤ k) := by omega
      simp only [restrictRangeNat, h1, h2, ite_false]
      split_ifs
      · exact ihr
      · rw [ihl, ihr]

  have h_c4 : ∀ (subs : List (ℕ × ℕ)), PuqIsSubblockPart subs →
      ∀ c_lo c_lo' c_hi, c_lo ≤ c_lo' → c_lo' ≤ c_hi → c_hi ≤ subs.length →
      ∀ T, _root_.BinaryTree.IsBST T →
        restrictRangeNat c_lo' c_hi (puqBlockQuotient subs c_lo c_hi T) =
          puqBlockQuotient subs c_lo' c_hi T := by
    intro subs hsbp c_lo c_lo' c_hi h1 h2 hchi T hbst
    clear hbst
    revert c_lo c_lo' c_hi h1 h2 hchi
    induction T with
    | nil =>
      intro c_lo c_lo' c_hi _ _ _
      rfl
    | node k l r ihl ihr =>
      intro c_lo c_lo' c_hi h1 h2 hchi
      by_cases hge' : c_hi ≤ c_lo'
      · rw [h_rest_empty_of_le c_lo' c_hi _ hge', h_bq_empty_of_le subs c_lo' c_hi _ hge']
      · have hlt' : c_lo' < c_hi := by omega
        have hlt : c_lo < c_hi := by omega
        have hge : ¬(c_hi ≤ c_lo) := by omega
        have hmono_lo := h_sbp_le_mono subs hsbp c_lo c_lo' h1 (by omega)
        have hmono_hi := h_sbp_le_mono subs hsbp c_lo' (c_hi - 1) (by omega) (by omega)
        have hne' := hsbp.2.1 c_lo' (by omega)
        by_cases hk_lob : k < (subs.getD c_lo (0, 0)).1
        · have hk_lob' : k < (subs.getD c_lo' (0, 0)).1 := by omega
          simp only [puqBlockQuotient, hge, hge', hk_lob, hk_lob', ite_false, ite_true]
          exact ihr c_lo c_lo' c_hi h1 h2 hchi
        · by_cases hk_hib : (subs.getD (c_hi - 1) (0, 0)).2 ≤ k
          · have hk_lob' : ¬(k < (subs.getD c_lo' (0, 0)).1) := by omega
            simp only [puqBlockQuotient, hge, hge', hk_lob, hk_lob', hk_hib, ite_false, ite_true]
            exact ihl c_lo c_lo' c_hi h1 h2 hchi
          · by_cases hk_lob' : k < (subs.getD c_lo' (0, 0)).1
            · simp only [puqBlockQuotient, hge, hge', hk_lob, hk_lob', hk_hib, ite_false, ite_true]
              obtain ⟨hc_lo, hc_hi, hck1, _⟩ :=
                h_sbp_idx subs hsbp c_lo c_hi hlt hchi k (by omega) (by omega)
              set c := subs.findIdx (fun b => decide (b.1 ≤ k ∧ k < b.2))
              have hc_lt_lo' : c < c_lo' := by
                by_contra hcon
                have hm := h_sbp_le_mono subs hsbp c_lo' c (by omega) (by omega)
                omega
              simp only [restrictRangeNat, hc_lt_lo', ite_true]
              exact ihr (c + 1) c_lo' c_hi (by omega) h2 hchi
            · simp only [puqBlockQuotient, hge, hge', hk_lob, hk_lob', hk_hib, ite_false]
              obtain ⟨hc_lo', hc_hi, _, _⟩ :=
                h_sbp_idx subs hsbp c_lo' c_hi hlt' hchi k (by omega) (by omega)
              set c := subs.findIdx (fun b => decide (b.1 ≤ k ∧ k < b.2))
              have hnc1 : ¬(c < c_lo') := by omega
              have hnc2 : ¬(c_hi ≤ c) := by omega
              simp only [restrictRangeNat, hnc1, hnc2, ite_false]
              congr 1
              · have hfl := (h_bq_bounds_bst subs hsbp l c_lo c (by omega) (by omega)).1
                rw [h_rest_hi_congr c_lo' c c_hi _ (by omega)
                  (h_forall_imp (fun x hx => hx.2) _ hfl)]
                exact ihl c_lo c_lo' c h1 hc_lo' (by omega)
              · have hfr := (h_bq_bounds_bst subs hsbp r (c + 1) c_hi (by omega) hchi).1
                exact h_rest_id c_lo' c_hi _
                  (h_forall_imp (fun x hx => ⟨by omega, hx.2⟩) _ hfr)
  clear h_rest_empty_of_le h_rest_id h_rest_hi_congr

  have h_ls_rest_hi_congr : ∀ (lo_b hi_1 hi_2 : ℕ) (l : _root_.BinaryTree ℕ),
      hi_1 ≤ hi_2 → ∀ r < hi_1,
        (r ∈ leftSpineBottomUpNat (restrictRangeNat lo_b hi_1 l) ↔
          r ∈ leftSpineBottomUpNat (restrictRangeNat lo_b hi_2 l)) := by
    intro lo_b hi_1 hi_2 l h12 r hr
    induction l with
    | nil => rfl
    | node lk ll lr ihll ihlr =>
      simp only [restrictRangeNat]
      by_cases hlk_lo : lk < lo_b
      · simp only [hlk_lo, ite_true]
        exact ihlr
      · simp only [hlk_lo, ite_false]
        by_cases hhi2 : hi_2 ≤ lk
        · have hhi1 : hi_1 ≤ lk := le_trans h12 hhi2
          simp only [hhi1, hhi2, ite_true]
          exact ihll
        · by_cases hhi1 : hi_1 ≤ lk
          · simp only [hhi1, hhi2, ite_true, ite_false, h_ls_node, List.mem_append, List.mem_singleton]
            have hr_ne : r ≠ lk := by omega
            simp [hr_ne, ihll]
          · simp only [hhi1, hhi2, ite_false, h_ls_node, List.mem_append, List.mem_singleton, ihll]

  have h_c5 : ∀ (subs : List (ℕ × ℕ)), PuqIsSubblockPart subs →
      ∀ c_lo c_hi, c_lo < c_hi → c_hi ≤ subs.length →
      ∀ T, _root_.BinaryTree.IsBST T →
        let lo_b := (subs.getD c_lo (0, 0)).1
        let hi_b := (subs.getD (c_hi - 1) (0, 0)).2
        let T' := restrictRangeNat lo_b hi_b T
        ∀ c, (c ∈ leftSpineBottomUpNat (puqBlockQuotient subs c_lo c_hi T) ↔
          c_lo ≤ c ∧ c < c_hi ∧
            ∃ r ∈ leftSpineBottomUpNat T',
              (subs.getD c (0, 0)).1 ≤ r ∧ r < (subs.getD c (0, 0)).2) := by
    intro subs hsbp c_lo c_hi hlt hchi T hbst
    revert c_lo c_hi hlt hchi
    induction hbst using isBSTRec with
    | left =>
      intro c_lo c_hi _ _
      dsimp (config := { failIfUnchanged := false }) only
      intro c
      simp [puqBlockQuotient, restrictRangeNat, h_ls_empty]
    | node k l R hfl _ hbstL _ ihl ihR =>
      intro c_lo c_hi hlt hchi
      dsimp (config := { failIfUnchanged := false }) only
      intro c
      have hge : ¬(c_hi ≤ c_lo) := by omega
      simp only [puqBlockQuotient, hge, ite_false, restrictRangeNat]
      split_ifs with hk_lob hk_hib
      · exact ihR c_lo c_hi hlt hchi c
      · exact ihl c_lo c_hi hlt hchi c
      · obtain ⟨hck_lo, hck_hi, hck1, hck2⟩ :=
          h_sbp_idx subs hsbp c_lo c_hi hlt hchi k (by omega) (by omega)
        set c_k := subs.findIdx (fun b => decide (b.1 ≤ k ∧ k < b.2))
        rw [h_ls_node, h_ls_node, List.mem_append, List.mem_singleton]
        by_cases hcck : c = c_k
        · subst hcck
          simp only [or_true, true_iff]
          exact ⟨hck_lo, hck_hi, k, by simp, hck1, hck2⟩
        · simp only [hcck, or_false]
          obtain ⟨hfl_ql, hbst_ql⟩ := h_bq_bounds_bst subs hsbp l c_lo c_k hck_lo (by omega)
          by_cases h_in_lo_ck : c_lo ≤ c ∧ c < c_k
          · obtain ⟨hc_lo, hc_lt_ck⟩ := h_in_lo_ck
            have hlt_ck : c_lo < c_k := lt_of_le_of_lt hc_lo hc_lt_ck
            rw [ihl c_lo c_k hlt_ck (by omega) c]
            have hc_lt_hi : c < c_hi := lt_trans hc_lt_ck hck_hi
            simp only [hc_lo, hc_lt_ck, hc_lt_hi, true_and]
            have hhi_le : (subs.getD (c_k - 1) (0, 0)).2 ≤ (subs.getD (c_hi - 1) (0, 0)).2 :=
              (h_sbp_le_mono subs hsbp (c_k - 1) (c_hi - 1) (by omega) (by omega)).2
            have hsc_le : (subs.getD c (0, 0)).2 ≤ (subs.getD (c_k - 1) (0, 0)).2 :=
              (h_sbp_le_mono subs hsbp c (c_k - 1) (by omega) (by omega)).2
            have hsc_le_ck : (subs.getD c (0, 0)).2 ≤ (subs.getD c_k (0, 0)).1 :=
              h_sbp_mono subs hsbp c c_k hc_lt_ck (by omega)
            constructor
            · rintro ⟨r, hr_mem, hr1, hr2⟩
              have hr_mem' := (h_ls_rest_hi_congr _ _ _ l hhi_le r (lt_of_lt_of_le hr2 hsc_le)).mp hr_mem
              exact ⟨r, List.mem_append_left [k] hr_mem', hr1, hr2⟩
            · rintro ⟨r, hr_mem, hr1, hr2⟩
              rw [List.mem_append, List.mem_singleton] at hr_mem
              rcases hr_mem with hr_l | rfl
              · exact ⟨r, (h_ls_rest_hi_congr _ _ _ l hhi_le r (lt_of_lt_of_le hr2 hsc_le)).mpr hr_l, hr1, hr2⟩
              · omega
          · constructor
            · intro hc_mem
              have hc_bounds := (h_forall_iff _ _).mp hfl_ql c ((h_c11 _ hbst_ql).2 c hc_mem)
              exact absurd hc_bounds h_in_lo_ck
            · rintro ⟨hc_lo, hc_hi, r, hr_mem, hr1, hr2⟩
              have hck_lt_c : c_k < c := by omega
              have hck_c_mono := h_sbp_mono subs hsbp c_k c hck_lt_c (by omega)
              rw [List.mem_append, List.mem_singleton] at hr_mem
              rcases hr_mem with hr_l | rfl
              · have hbst_rl := h_rest_bst (subs.getD c_lo (0, 0)).1 (subs.getD (c_hi - 1) (0, 0)).2 l hbstL
                have hfl_rl := h_rest_forall (fun x => x < k) (subs.getD c_lo (0, 0)).1 (subs.getD (c_hi - 1) (0, 0)).2 l hfl
                have hr_lt_k := (h_forall_iff _ _).mp hfl_rl r ((h_c11 _ hbst_rl).2 r hr_l)
                omega
              · omega
  clear h_ls_rest_hi_congr h_rest_forall h_rest_bst

  have h_head_append : ∀ (xs ys : List ℕ), xs ≠ [] → (xs ++ ys).head? = xs.head? := by
    intro xs ys hne
    rcases xs with _ | ⟨x, xs'⟩
    · exact absurd rfl hne
    · rfl

  have h_c7 : ∀ (subs : List (ℕ × ℕ)), PuqIsSubblockPart subs →
      ∀ c_lo c_hi, c_lo < c_hi → c_hi ≤ subs.length →
      ∀ (T : _root_.BinaryTree ℕ) (s : ℕ), _root_.BinaryTree.IsBST T →
        (inorderNat T).head? = some s →
        s < (subs.getD c_lo (0, 0)).1 →
        puqBlockQuotient subs c_lo c_hi (spliceMinNat T) = puqBlockQuotient subs c_lo c_hi T := by
    intro subs hsbp c_lo c_hi hlt hchi T s hbst hhead hslt
    revert c_lo c_hi hlt hchi hhead hslt
    induction T with
    | nil =>
      intro c_lo c_hi _ _ hhead _
      simp [inorderNat] at hhead
    | node k l R ihl _ =>
      intro c_lo c_hi hlt hchi hhead hslt
      have hge : ¬(c_hi ≤ c_lo) := by omega
      cases hbst using isBSTCases with
      | node _ _ _ _ _ hbstL _ =>
        rcases l with _ | ⟨ka, la, ra⟩
        · simp only [inorderNat, List.nil_append, List.singleton_append, List.head?_cons,
            Option.some.injEq] at hhead
          subst hhead
          simp only [spliceMinNat, puqBlockQuotient, hge, hslt, ite_false, ite_true]
        · have hsp : spliceMinNat (.node k (.node ka la ra) R) =
              .node k (spliceMinNat (.node ka la ra)) R := by simp [spliceMinNat]
          rw [hsp]
          set L := _root_.BinaryTree.node ka la ra
          have hne_l : inorderNat L ≠ [] := by simp [L, inorderNat]
          have hhead_l : (inorderNat L).head? = some s := by
            have heq_in : inorderNat (.node k L R) = inorderNat L ++ ([k] ++ inorderNat R) := by
              simp [inorderNat, List.append_assoc]
            rw [heq_in, h_head_append (inorderNat L) ([k] ++ inorderNat R) hne_l] at hhead
            exact hhead
          by_cases hk_lob : k < (subs.getD c_lo (0, 0)).1
          · simp only [puqBlockQuotient, hge, hk_lob, ite_false, ite_true]
          · by_cases hk_hib : (subs.getD (c_hi - 1) (0, 0)).2 ≤ k
            · have h1 : puqBlockQuotient subs c_lo c_hi (.node k (spliceMinNat L) R) =
                  puqBlockQuotient subs c_lo c_hi (spliceMinNat L) := by
                simp only [puqBlockQuotient, hge, hk_lob, hk_hib, ite_false, ite_true]
              have h2 : puqBlockQuotient subs c_lo c_hi (.node k L R) =
                  puqBlockQuotient subs c_lo c_hi L := by
                simp only [puqBlockQuotient, hge, hk_lob, hk_hib, ite_false, ite_true]
              rw [h1, h2]
              exact ihl hbstL c_lo c_hi hlt hchi hhead_l hslt
            · obtain ⟨hc_lo, hc_hi, _, _⟩ :=
                h_sbp_idx subs hsbp c_lo c_hi hlt hchi k (by omega) (by omega)
              set c := subs.findIdx (fun b => decide (b.1 ≤ k ∧ k < b.2))
              have h1 : puqBlockQuotient subs c_lo c_hi (.node k (spliceMinNat L) R) =
                  .node c (puqBlockQuotient subs c_lo c (spliceMinNat L))
                    (puqBlockQuotient subs (c + 1) c_hi R) := by
                simp only [puqBlockQuotient, hge, hk_lob, hk_hib, ite_false]; rfl
              have h2 : puqBlockQuotient subs c_lo c_hi (.node k L R) =
                  .node c (puqBlockQuotient subs c_lo c L)
                    (puqBlockQuotient subs (c + 1) c_hi R) := by
                simp only [puqBlockQuotient, hge, hk_lob, hk_hib, ite_false]; rfl
              rw [h1, h2]
              congr 1
              by_cases hc_eq : c ≤ c_lo
              · rw [h_bq_empty_of_le subs c_lo c _ hc_eq, h_bq_empty_of_le subs c_lo c _ hc_eq]
              · exact ihl hbstL c_lo c (by omega) (by omega) hhead_l hslt
  clear h_head_append

  have h_rot_eq_self : ∀ (w : ℕ) (U : _root_.BinaryTree ℕ),
      _root_.SplayDeque.Direct.ForallTree (fun k => k ≠ w) U → rotateRightOnLeftSpine w U = U := by
    intro w U
    induction U with
    | nil => intro _; rfl
    | node y l C ihl _ =>
      intro hft
      rcases l with _ | ⟨x, a, b⟩
      · rfl
      · cases hft with
        | node _ _ _ hfl _ _ =>
          cases hfl with
          | node _ _ _ hfla hxw hflb =>
            simp only [rotateRightOnLeftSpine, hxw, ite_false]
            rw [ihl (.node a x b hfla hxw hflb)]

  have h_bq_lt : ∀ subs c_lo c_hi l k r, c_lo < c_hi → k < (subs.getD c_lo (0, 0)).1 →
      puqBlockQuotient subs c_lo c_hi (.node k l r) = puqBlockQuotient subs c_lo c_hi r := by
    intro subs c_lo c_hi l k r hlt hk
    have hge : ¬(c_hi ≤ c_lo) := by omega
    simp only [puqBlockQuotient, hge, hk, ite_false, ite_true]

  have h_bq_ge : ∀ subs c_lo c_hi l k r, c_lo < c_hi → ¬(k < (subs.getD c_lo (0, 0)).1) →
      (subs.getD (c_hi - 1) (0, 0)).2 ≤ k →
      puqBlockQuotient subs c_lo c_hi (.node k l r) = puqBlockQuotient subs c_lo c_hi l := by
    intro subs c_lo c_hi l k r hlt hk1 hk2
    have hge : ¬(c_hi ≤ c_lo) := by omega
    simp only [puqBlockQuotient, hge, hk1, hk2, ite_false, ite_true]

  have h_bq_mid : ∀ subs c_lo c_hi l k r c, c_lo < c_hi → ¬(k < (subs.getD c_lo (0, 0)).1) →
      ¬((subs.getD (c_hi - 1) (0, 0)).2 ≤ k) →
      c = subs.findIdx (fun b => decide (b.1 ≤ k ∧ k < b.2)) →
      puqBlockQuotient subs c_lo c_hi (.node k l r) =
        .node c (puqBlockQuotient subs c_lo c l) (puqBlockQuotient subs (c + 1) c_hi r) := by
    intro subs c_lo c_hi l k r c hlt hk1 hk2 hc
    have hge : ¬(c_hi ≤ c_lo) := by omega
    subst hc
    simp only [puqBlockQuotient, hge, hk1, hk2, ite_false]

  have h_root_rot : ∀ (subs : List (ℕ × ℕ)), PuqIsSubblockPart subs →
      ∀ c_lo c_hi, c_lo < c_hi → c_hi ≤ subs.length →
      ∀ (A B D : _root_.BinaryTree ℕ) (u y : ℕ), u < y →
        let lo_b := (subs.getD c_lo (0, 0)).1
        let hi_b := (subs.getD (c_hi - 1) (0, 0)).2
        let c_u := subs.findIdx (fun b => decide (b.1 ≤ u ∧ u < b.2))
        let c_y := subs.findIdx (fun b => decide (b.1 ≤ y ∧ y < b.2))
        let G := puqBlockQuotient subs c_lo c_hi (.node y (.node u A B) D)
        let G' := puqBlockQuotient subs c_lo c_hi (.node u A (.node y B D))
        G' = G ∨
          (lo_b ≤ u ∧ y < hi_b ∧ c_lo ≤ c_u ∧ c_u < c_y ∧ c_y < c_hi ∧
            G = .node c_y (.node c_u (puqBlockQuotient subs c_lo c_u A)
                  (puqBlockQuotient subs (c_u + 1) c_y B))
                  (puqBlockQuotient subs (c_y + 1) c_hi D) ∧
            G' = .node c_u (puqBlockQuotient subs c_lo c_u A)
                  (.node c_y (puqBlockQuotient subs (c_u + 1) c_y B)
                    (puqBlockQuotient subs (c_y + 1) c_hi D))) := by
    intro subs hsbp c_lo c_hi hlt hchi A B D u y huy
    have hmono_lohi := h_sbp_le_mono subs hsbp c_lo (c_hi - 1) (by omega) (by omega)
    have hne_lo := hsbp.2.1 c_lo (by omega)
    dsimp (config := { failIfUnchanged := false }) only
    have hlo_lt_hi : (subs.getD c_lo (0, 0)).1 < (subs.getD (c_hi - 1) (0, 0)).2 := by omega
    by_cases hy_lob : y < (subs.getD c_lo (0, 0)).1
    · left
      have hu_lob : u < (subs.getD c_lo (0, 0)).1 := lt_trans huy hy_lob
      rw [h_bq_lt subs c_lo c_hi _ u _ hlt hu_lob,
          h_bq_lt subs c_lo c_hi _ y _ hlt hy_lob,
          h_bq_lt subs c_lo c_hi _ y _ hlt hy_lob]
    · by_cases hy_hib : (subs.getD (c_hi - 1) (0, 0)).2 ≤ y
      · left
        rw [h_bq_ge subs c_lo c_hi _ y _ hlt hy_lob hy_hib]
        by_cases hu_lob : u < (subs.getD c_lo (0, 0)).1
        · rw [h_bq_lt subs c_lo c_hi _ u _ hlt hu_lob,
              h_bq_lt subs c_lo c_hi _ u _ hlt hu_lob,
              h_bq_ge subs c_lo c_hi _ y _ hlt hy_lob hy_hib]
        · by_cases hu_hib : (subs.getD (c_hi - 1) (0, 0)).2 ≤ u
          · rw [h_bq_ge subs c_lo c_hi _ u _ hlt hu_lob hu_hib,
                h_bq_ge subs c_lo c_hi _ u _ hlt hu_lob hu_hib]
          · have hcu_props := h_sbp_idx subs hsbp c_lo c_hi hlt hchi u (by omega) (by omega)
            dsimp (config := { failIfUnchanged := false }) only at hcu_props
            set c_u := subs.findIdx (fun b => decide (b.1 ≤ u ∧ u < b.2))
            obtain ⟨hcu_lo, hcu_hi, _, _⟩ := hcu_props
            rw [h_bq_mid subs c_lo c_hi _ u _ c_u hlt hu_lob hu_hib rfl,
                h_bq_mid subs c_lo c_hi _ u _ c_u hlt hu_lob hu_hib rfl]
            congr 1
            by_cases hc_ge : c_hi ≤ c_u + 1
            · rw [h_bq_empty_of_le subs (c_u + 1) c_hi _ hc_ge,
                  h_bq_empty_of_le subs (c_u + 1) c_hi _ hc_ge]
            · have hm1 := h_sbp_le_mono subs hsbp (c_u + 1) (c_hi - 1) (by omega) (by omega)
              have hne1 := hsbp.2.1 (c_u + 1) (by omega)
              have hny1 : ¬(y < (subs.getD (c_u + 1) (0, 0)).1) := by omega
              exact h_bq_ge subs (c_u + 1) c_hi B y D (by omega) hny1 hy_hib
      · have hcy_props := h_sbp_idx subs hsbp c_lo c_hi hlt hchi y (by omega) (by omega)
        dsimp (config := { failIfUnchanged := false }) only at hcy_props
        set c_y := subs.findIdx (fun b => decide (b.1 ≤ y ∧ y < b.2))
        obtain ⟨hcy_lo, hcy_hi, hcy1, hcy2⟩ := hcy_props
        by_cases hu_lob : u < (subs.getD c_lo (0, 0)).1
        · left
          rw [h_bq_lt subs c_lo c_hi _ u _ hlt hu_lob,
              h_bq_mid subs c_lo c_hi B y D c_y hlt hy_lob hy_hib rfl,
              h_bq_mid subs c_lo c_hi (.node u A B) y D c_y hlt hy_lob hy_hib rfl]
          congr 1
          by_cases hcy_le : c_y ≤ c_lo
          · rw [h_bq_empty_of_le subs c_lo c_y _ hcy_le,
                h_bq_empty_of_le subs c_lo c_y _ hcy_le]
          · exact (h_bq_lt subs c_lo c_y A u B (by omega) hu_lob).symm
        · have hu_hib : ¬((subs.getD (c_hi - 1) (0, 0)).2 ≤ u) := by omega
          have hcu_props := h_sbp_idx subs hsbp c_lo c_hi hlt hchi u (by omega) (by omega)
          dsimp (config := { failIfUnchanged := false }) only at hcu_props
          set c_u := subs.findIdx (fun b => decide (b.1 ≤ u ∧ u < b.2))
          obtain ⟨hcu_lo, hcu_hi, hcu1, hcu2⟩ := hcu_props
          have hcu_le_cy : c_u ≤ c_y := by
            by_contra hcon
            have hm := h_sbp_mono subs hsbp c_y c_u (by omega) (by omega)
            omega
          by_cases hcu_eq_cy : c_u = c_y
          · left
            rw [h_bq_mid subs c_lo c_hi A u (.node y B D) c_u hlt hu_lob hu_hib rfl,
                h_bq_mid subs c_lo c_hi (.node u A B) y D c_y hlt hy_lob hy_hib rfl,
                hcu_eq_cy]
            congr 1
            · by_cases hcy_le : c_y ≤ c_lo
              · rw [h_bq_empty_of_le subs c_lo c_y _ hcy_le,
                    h_bq_empty_of_le subs c_lo c_y _ hcy_le]
              · have hadj := hsbp.2.2 (c_y - 1) (by omega)
                have hrw : c_y - 1 + 1 = c_y := by omega
                rw [hrw] at hadj
                have hu_hi' : (subs.getD (c_y - 1) (0, 0)).2 ≤ u := by
                  rw [hadj, ← hcu_eq_cy]; exact hcu1
                exact (h_bq_ge subs c_lo c_y A u B (by omega) hu_lob hu_hi').symm
            · by_cases hchi_le : c_hi ≤ c_y + 1
              · rw [h_bq_empty_of_le subs (c_y + 1) c_hi _ hchi_le,
                    h_bq_empty_of_le subs (c_y + 1) c_hi _ hchi_le]
              · have hadj := hsbp.2.2 c_y (by omega)
                have hy_lo' : y < (subs.getD (c_y + 1) (0, 0)).1 := by omega
                exact h_bq_lt subs (c_y + 1) c_hi B y D (by omega) hy_lo'
          · right
            have hcu_lt_cy : c_u < c_y := by omega
            refine ⟨by omega, by omega, hcu_lo, hcu_lt_cy, hcy_hi, ?_, ?_⟩
            · rw [h_bq_mid subs c_lo c_hi (.node u A B) y D c_y hlt hy_lob hy_hib rfl]
              congr 1
              have hm_uy := (h_sbp_le_mono subs hsbp c_u (c_y - 1) (by omega) (by omega)).2
              have hnu_hi : ¬((subs.getD (c_y - 1) (0, 0)).2 ≤ u) := by omega
              exact h_bq_mid subs c_lo c_y A u B c_u (by omega) hu_lob hnu_hi rfl
            · rw [h_bq_mid subs c_lo c_hi A u (.node y B D) c_u hlt hu_lob hu_hib rfl]
              congr 1
              have hm_uy := (h_sbp_le_mono subs hsbp (c_u + 1) c_y (by omega) (by omega)).1
              have hny_lo : ¬(y < (subs.getD (c_u + 1) (0, 0)).1) := by omega
              exact h_bq_mid subs (c_u + 1) c_hi B y D c_y (by omega) hny_lo hy_hib rfl
  clear h_bq_lt h_bq_ge h_bq_mid

  have h_c8 : ∀ (subs : List (ℕ × ℕ)), PuqIsSubblockPart subs →
      ∀ c_lo c_hi, c_lo < c_hi → c_hi ≤ subs.length →
      ∀ (T : _root_.BinaryTree ℕ) (u : ℕ), _root_.BinaryTree.IsBST T →
        let G := puqBlockQuotient subs c_lo c_hi T
        let G' := puqBlockQuotient subs c_lo c_hi (rotateRightOnLeftSpine u T)
        let lo_b := (subs.getD c_lo (0, 0)).1
        let hi_b := (subs.getD (c_hi - 1) (0, 0)).2
        ((u < lo_b ∨ hi_b ≤ u) → G' = G) ∧
          (G' = G ∨
            G' = rotateRightOnLeftSpine (subs.findIdx (fun b => decide (b.1 ≤ u ∧ u < b.2))) G) := by
    intro subs hsbp c_lo c_hi hlt hchi T u hbst
    revert c_lo c_hi hlt hchi
    induction T with
    | nil =>
      intro c_lo c_hi _ _
      exact ⟨fun _ => rfl, Or.inl rfl⟩
    | node y l D ihl _ =>
      intro c_lo c_hi hlt hchi
      rcases l with _ | ⟨x, A, B⟩
      · exact ⟨fun _ => rfl, Or.inl rfl⟩
      · cases hbst using isBSTCases with
        | node _ _ _ hfl_y _ hbstL _ =>
          cases hfl_y with
          | node _ _ _ _ hxy _ =>
            dsimp (config := { failIfUnchanged := false }) only
            simp only [rotateRightOnLeftSpine]
            split_ifs with hxu
            · subst hxu
              rcases h_root_rot subs hsbp c_lo c_hi hlt hchi A B D x y hxy with
                heq | ⟨hlo_x, hy_hi, _, _, _, hG_eq, hG'_eq⟩
              · exact ⟨fun _ => heq, Or.inl heq⟩
              · refine ⟨fun hout => by omega, Or.inr ?_⟩
                rw [hG_eq, hG'_eq]
                simp only [rotateRightOnLeftSpine, ite_true]
            · have hge : ¬(c_hi ≤ c_lo) := by omega
              by_cases hy_lob : y < (subs.getD c_lo (0, 0)).1
              · have heq : puqBlockQuotient subs c_lo c_hi
                    (.node y (rotateRightOnLeftSpine u (.node x A B)) D) =
                    puqBlockQuotient subs c_lo c_hi (.node y (.node x A B) D) := by
                  simp only [puqBlockQuotient, hge, hy_lob, ite_false, ite_true]
                exact ⟨fun _ => heq, Or.inl heq⟩
              · by_cases hy_hib : (subs.getD (c_hi - 1) (0, 0)).2 ≤ y
                · have heq1 : puqBlockQuotient subs c_lo c_hi
                      (.node y (rotateRightOnLeftSpine u (.node x A B)) D) =
                      puqBlockQuotient subs c_lo c_hi (rotateRightOnLeftSpine u (.node x A B)) := by
                    simp only [puqBlockQuotient, hge, hy_lob, hy_hib, ite_false, ite_true]
                  have heq2 : puqBlockQuotient subs c_lo c_hi (.node y (.node x A B) D) =
                      puqBlockQuotient subs c_lo c_hi (.node x A B) := by
                    simp only [puqBlockQuotient, hge, hy_lob, hy_hib, ite_false, ite_true]
                  rw [heq1, heq2]
                  exact ihl hbstL c_lo c_hi hlt hchi
                · obtain ⟨hcy_lo, hcy_hi, _, _⟩ :=
                    h_sbp_idx subs hsbp c_lo c_hi hlt hchi y (by omega) (by omega)
                  set c_y := subs.findIdx (fun b => decide (b.1 ≤ y ∧ y < b.2))
                  set c_u := subs.findIdx (fun b => decide (b.1 ≤ u ∧ u < b.2))
                  have hG : puqBlockQuotient subs c_lo c_hi (.node y (.node x A B) D) =
                      .node c_y (puqBlockQuotient subs c_lo c_y (.node x A B))
                        (puqBlockQuotient subs (c_y + 1) c_hi D) := by
                    simp only [puqBlockQuotient, hge, hy_lob, hy_hib, ite_false]; rfl
                  have hG' : puqBlockQuotient subs c_lo c_hi
                      (.node y (rotateRightOnLeftSpine u (.node x A B)) D) =
                      .node c_y (puqBlockQuotient subs c_lo c_y
                        (rotateRightOnLeftSpine u (.node x A B)))
                        (puqBlockQuotient subs (c_y + 1) c_hi D) := by
                    simp only [puqBlockQuotient, hge, hy_lob, hy_hib, ite_false]; rfl
                  rw [hG, hG']
                  by_cases hcy_le : c_y ≤ c_lo
                  · rw [h_bq_empty_of_le subs c_lo c_y _ hcy_le,
                        h_bq_empty_of_le subs c_lo c_y _ hcy_le]
                    exact ⟨fun _ => rfl, Or.inl rfl⟩
                  · obtain ⟨ih_out, ih_dich⟩ := ihl hbstL c_lo c_y (by omega) (by omega)
                    refine ⟨fun hout => ?_, ?_⟩
                    · congr 1
                      apply ih_out
                      rcases hout with h1 | h2
                      · exact Or.inl h1
                      · have hm := (h_sbp_le_mono subs hsbp (c_y - 1) (c_hi - 1)
                          (by omega) (by omega)).2
                        exact Or.inr (le_trans hm h2)
                    · set Ly := puqBlockQuotient subs c_lo c_y (.node x A B)
                      set Ly' := puqBlockQuotient subs c_lo c_y
                        (rotateRightOnLeftSpine u (.node x A B))
                      by_cases hLy_eq : Ly' = Ly
                      · left; rw [hLy_eq]
                      · rcases ih_dich with hcon | hLy_rot
                        · exact absurd hcon hLy_eq
                        · right
                          cases hLy_shape : Ly with
                          | nil =>
                            have hrot_emp : rotateRightOnLeftSpine c_u .nil = .nil := rfl
                            rw [hLy_shape, hrot_emp] at hLy_rot
                            rw [hLy_shape] at hLy_eq
                            exact absurd hLy_rot hLy_eq
                          | node kL Pa Pb =>
                            have hkL_ne : kL ≠ c_u := by
                              intro hkL_eq
                              have hLy_rot' : Ly' = rotateRightOnLeftSpine kL Ly := by
                                rw [← hkL_eq] at hLy_rot
                                exact hLy_rot
                              have hbst_Ly : _root_.BinaryTree.IsBST (.node kL Pa Pb) := by
                                rw [← hLy_shape]
                                exact h_c1 subs hsbp c_lo c_y hcy_lo (by omega) _ hbstL
                              cases hbst_Ly using isBSTCases with
                              | node _ _ _ hfl_Pa _ _ _ =>
                                have hne_Pa := h_forall_imp (fun k hk => ne_of_lt hk) Pa hfl_Pa
                                have hrot_id : rotateRightOnLeftSpine kL (.node kL Pa Pb) =
                                    .node kL Pa Pb := by
                                  rcases Pa with _ | ⟨kaa, Paa, Pab⟩
                                  · rfl
                                  · cases hne_Pa with
                                    | node _ _ _ hne_Paa hkaa_ne hne_Pab =>
                                      simp only [rotateRightOnLeftSpine, hkaa_ne, ite_false]
                                      rw [h_rot_eq_self kL _ (.node Paa kaa Pab hne_Paa hkaa_ne hne_Pab)]
                                rw [hLy_shape] at hLy_rot' hLy_eq
                                exact hLy_eq (hLy_rot'.trans hrot_id)
                            simp only [rotateRightOnLeftSpine, hkL_ne, ite_false]
                            rw [← hLy_shape, ← hLy_rot]
  clear h_rot_eq_self

  have h_snoc_inj : ∀ (xs ys : List ℕ) (a b : ℕ),
      xs ++ [a] = ys ++ [b] → xs = ys ∧ a = b := by
    intro xs ys a b heq
    have hb : [a] = [b] := List.append_inj_right' heq rfl
    have hxs : xs = ys := List.append_inj_left' heq rfl
    simp only [List.cons.injEq, and_true] at hb
    exact ⟨hxs, hb⟩

  have h_nonempty_snoc : ∀ (xs : List ℕ), xs ≠ [] → ∃ mid last, xs = mid ++ [last] := by
    intro xs
    induction xs with
    | nil => intro h; exact absurd rfl h
    | cons a rest ih =>
      intro _
      rcases rest with _ | ⟨b, rest'⟩
      · exact ⟨[], a, rfl⟩
      · obtain ⟨mid, last, h⟩ := ih (by simp)
        exact ⟨a :: mid, last, by simp [h]⟩

  have h_c9 : ∀ (subs : List (ℕ × ℕ)), PuqIsSubblockPart subs →
      ∀ c_lo c_hi, c_lo < c_hi → c_hi ≤ subs.length →
      ∀ (T : _root_.BinaryTree ℕ) (u v c : ℕ), _root_.BinaryTree.IsBST T →
        (∃ pre suf, leftSpineBottomUpNat T = pre ++ u :: v :: suf) →
        c ∈ leftSpineBottomUpNat (puqBlockQuotient subs c_lo c_hi T) →
        c ∉ leftSpineBottomUpNat (puqBlockQuotient subs c_lo c_hi (rotateRightOnLeftSpine u T)) →
        (subs.getD c_lo (0, 0)).1 ≤ u ∧ u < v ∧ v < (subs.getD (c_hi - 1) (0, 0)).2 ∧
          subs.findIdx (fun b => decide (b.1 ≤ u ∧ u < b.2)) < c ∧
          subs.findIdx (fun b => decide (b.1 ≤ v ∧ v < b.2)) = c := by
    intro subs hsbp c_lo c_hi hlt hchi T u v c hbst hex hmem hnmem
    revert c_lo c_hi hlt hchi hex hmem hnmem
    induction T with
    | nil =>
      intro c_lo c_hi _ _ _ hmem _
      simp [puqBlockQuotient, h_ls_empty] at hmem
    | node y l D ihl _ =>
      intro c_lo c_hi hlt hchi ⟨pre, suf, hls_eq⟩ hmem hnmem
      rcases l with _ | ⟨x, A, B⟩
      · rw [h_ls_node, h_ls_empty] at hls_eq
        have hlen := congrArg List.length hls_eq
        simp at hlen
        omega
      · cases hbst using isBSTCases with
        | node _ _ _ hfl_y _ hbstL _ =>
          cases hfl_y with
          | node _ _ _ _ hxy _ =>
            rcases suf with _ | ⟨s0, suf'⟩
            · rw [h_ls_node, h_ls_node] at hls_eq
              have h1 : (leftSpineBottomUpNat A ++ [x]) ++ [y] = (pre ++ [u]) ++ [v] := by
                simpa [List.append_assoc] using hls_eq
              obtain ⟨h1_left, hyv⟩ := h_snoc_inj _ _ _ _ h1
              obtain ⟨_, hxu⟩ := h_snoc_inj _ _ _ _ h1_left
              subst hxu; subst hyv
              simp only [rotateRightOnLeftSpine, ite_true] at hnmem
              rcases h_root_rot subs hsbp c_lo c_hi hlt hchi A B D x y hxy with
                heq | ⟨hlo_x, hy_hi, _, hcx_lt_cy, _, hG_eq, hG'_eq⟩
              · rw [heq] at hnmem
                exact absurd hmem hnmem
              · rw [hG_eq, h_ls_node, h_ls_node, List.mem_append, List.mem_singleton] at hmem
                rw [hG'_eq, h_ls_node] at hnmem
                rcases hmem with hmem_left | rfl
                · exact absurd hmem_left hnmem
                · exact ⟨hlo_x, hxy, hy_hi, hcx_lt_cy, rfl⟩
            · obtain ⟨mid, last, hsuf_eq⟩ := h_nonempty_snoc (s0 :: suf') (by simp)
              rw [h_ls_node, hsuf_eq] at hls_eq
              have h1 : leftSpineBottomUpNat (.node x A B) ++ [y] =
                  (pre ++ u :: v :: mid) ++ [last] := by
                simpa [List.append_assoc] using hls_eq
              obtain ⟨hls_L, _⟩ := h_snoc_inj _ _ _ _ h1
              obtain ⟨mid', last', hvmid_eq⟩ := h_nonempty_snoc (v :: mid) (by simp)
              have h2 : leftSpineBottomUpNat A ++ [x] = (pre ++ u :: mid') ++ [last'] := by
                have := hls_L
                rw [h_ls_node, hvmid_eq] at this
                simpa [List.append_assoc] using this
              obtain ⟨hls_A, _⟩ := h_snoc_inj _ _ _ _ h2
              have hu_mem_A : u ∈ leftSpineBottomUpNat A := by
                rw [hls_A]; simp
              cases hbstL using isBSTCases with
              | node _ _ _ hfl_x hfr_x hbstA hbstB =>
                have hbstL' : _root_.BinaryTree.IsBST (.node x A B) := .node x A B hfl_x hfr_x hbstA hbstB
                have hux : u < x :=
                  (h_forall_iff _ A).mp hfl_x u ((h_c11 A hbstA).2 u hu_mem_A)
                have hxu_ne : x ≠ u := ne_of_gt hux
                simp only [rotateRightOnLeftSpine, hxu_ne, ite_false] at hnmem
                have hge : ¬(c_hi ≤ c_lo) := by omega
                by_cases hy_lob : y < (subs.getD c_lo (0, 0)).1
                · have hG : puqBlockQuotient subs c_lo c_hi (.node y (.node x A B) D) =
                      puqBlockQuotient subs c_lo c_hi D := by
                    simp only [puqBlockQuotient, hge, hy_lob, ite_false, ite_true]
                  have hG' : puqBlockQuotient subs c_lo c_hi
                      (.node y (rotateRightOnLeftSpine u (.node x A B)) D) =
                      puqBlockQuotient subs c_lo c_hi D := by
                    simp only [puqBlockQuotient, hge, hy_lob, ite_false, ite_true]
                  rw [hG] at hmem
                  rw [hG'] at hnmem
                  exact absurd hmem hnmem
                · by_cases hy_hib : (subs.getD (c_hi - 1) (0, 0)).2 ≤ y
                  · have hG : puqBlockQuotient subs c_lo c_hi (.node y (.node x A B) D) =
                        puqBlockQuotient subs c_lo c_hi (.node x A B) := by
                      simp only [puqBlockQuotient, hge, hy_lob, hy_hib, ite_false, ite_true]
                    have hG' : puqBlockQuotient subs c_lo c_hi
                        (.node y (rotateRightOnLeftSpine u (.node x A B)) D) =
                        puqBlockQuotient subs c_lo c_hi
                          (rotateRightOnLeftSpine u (.node x A B)) := by
                      simp only [puqBlockQuotient, hge, hy_lob, hy_hib, ite_false, ite_true]
                    rw [hG] at hmem
                    rw [hG'] at hnmem
                    exact ihl hbstL' c_lo c_hi hlt hchi ⟨pre, mid, hls_L⟩ hmem hnmem
                  · obtain ⟨hcy_lo, hcy_hi, _, _⟩ :=
                      h_sbp_idx subs hsbp c_lo c_hi hlt hchi y (by omega) (by omega)
                    set c_y := subs.findIdx (fun b => decide (b.1 ≤ y ∧ y < b.2))
                    have hG : puqBlockQuotient subs c_lo c_hi (.node y (.node x A B) D) =
                        .node c_y (puqBlockQuotient subs c_lo c_y (.node x A B))
                          (puqBlockQuotient subs (c_y + 1) c_hi D) := by
                      simp only [puqBlockQuotient, hge, hy_lob, hy_hib, ite_false]; rfl
                    have hG' : puqBlockQuotient subs c_lo c_hi
                        (.node y (rotateRightOnLeftSpine u (.node x A B)) D) =
                        .node c_y (puqBlockQuotient subs c_lo c_y
                          (rotateRightOnLeftSpine u (.node x A B)))
                          (puqBlockQuotient subs (c_y + 1) c_hi D) := by
                      simp only [puqBlockQuotient, hge, hy_lob, hy_hib, ite_false]; rfl
                    rw [hG, h_ls_node, List.mem_append, List.mem_singleton] at hmem
                    rw [hG', h_ls_node, List.mem_append, List.mem_singleton] at hnmem
                    rcases hmem with hmem_Ly | rfl
                    · have hnmem_Ly : c ∉ leftSpineBottomUpNat
                          (puqBlockQuotient subs c_lo c_y
                            (rotateRightOnLeftSpine u (.node x A B))) :=
                        fun h => hnmem (Or.inl h)
                      have hcy_gt : c_lo < c_y := by
                        by_contra hle
                        rw [h_bq_empty_of_le subs c_lo c_y _ (by omega), h_ls_empty] at hmem_Ly
                        simp at hmem_Ly
                      obtain ⟨h1', h2', h3', h4', h5'⟩ :=
                        ihl hbstL' c_lo c_y hcy_gt (by omega) ⟨pre, mid, hls_L⟩ hmem_Ly hnmem_Ly
                      have hm := (h_sbp_le_mono subs hsbp (c_y - 1) (c_hi - 1)
                        (by omega) (by omega)).2
                      exact ⟨h1', h2', lt_of_lt_of_le h3' hm, h4', h5'⟩
                    · exact absurd (Or.inr rfl) hnmem
  clear h_root_rot h_snoc_inj h_nonempty_snoc

  have h_rm_lt : ∀ (R : _root_.BinaryTree ℕ) (cur m : ℕ),
      cur < m → _root_.SplayDeque.Direct.ForallTree (fun x => x < m) R → rightmostKeyNat cur R < m := by
    intro R
    induction R with
    | nil => intro cur m h _; exact h
    | node rk rl rr _ ihrr =>
      intro cur m _ hft
      cases hft with
      | node _ _ _ _ hrk_lt hfrr =>
        exact ihrr rk m hrk_lt hfrr

  have h_upper_aux : ∀ (subs : List (ℕ × ℕ)), PuqIsSubblockPart subs →
      ∀ (P_top c_y c_w : ℕ), c_y < c_w → c_w < subs.length →
      ∀ (U : _root_.BinaryTree ℕ) (c_lo c_hi curP : ℕ),
        _root_.BinaryTree.IsBST U → c_lo ≤ c_y → c_hi ≤ subs.length →
        (curP < (subs.getD c_w (0, 0)).2 → c_hi ≤ c_w) →
        (c_hi ≤ c_w ∨
          ∀ r, (subs.getD c_y (0, 0)).1 ≤ r → r < (subs.getD c_y (0, 0)).2 →
            r ∈ inorderNat U → lcrsParentAux P_top curP r U < (subs.getD c_w (0, 0)).2) →
        subtreeMaxNat (puqBlockQuotient subs c_lo c_hi U) c_y < c_w := by
    intro subs hsbp P_top c_y c_w hcy_lt_cw hcw_len U
    induction U with
    | nil =>
      intro c_lo c_hi curP _ _ _ _ _
      exact hcy_lt_cw
    | node k l R ihl ihR =>
      intro c_lo c_hi curP hbst hclo_cy hchi_len hI1 hI2
      by_cases hge : c_hi ≤ c_lo
