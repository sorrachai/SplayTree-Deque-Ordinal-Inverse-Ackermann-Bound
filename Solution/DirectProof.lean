private lemma epochLeafWeight_pos_master (r L : ℕ) (addr : ℕ → Fin r → ℕ)
    (haddr : ValidEpochAddress r L addr) (ℓ : ℕ) (hℓ1 : 1 ≤ ℓ) (hℓL : ℓ ≤ L) :
    1 ≤ epochLeafWeight r addr ℓ := by
  unfold epochLeafWeight
  refine Finset.one_le_prod' fun d _ => ?_
  have hc : 1 ≤ addr ℓ d := haddr.pos ℓ hℓ1 hℓL d
  have hc2 : 1 ≤ (addr ℓ d) ^ 2 := Nat.one_le_pow 2 (addr ℓ d) hc
  omega

/-- Single Epoch Grouping Tree contraction pass at depth `r ≥ 1`:
decomposes any valid core sequence of size `P ≥ 1` into subgames of total size `P`,
each of size `< 2 * S L`, at linear overhead `(62 + 66 * r) * P`. -/
theorem epoch_core_contraction_step
    (P L r : ℕ) (addr : ℕ → Fin r → ℕ) (S : ℕ → ℕ) (ops : List CoreOp)
    (hP : 1 ≤ P) (hL : 1 ≤ L) (hr : 1 ≤ r)
    (haddr : ValidEpochAddress r L addr)
    (hS0 : S 0 = P)
    (hS_def : ∀ ℓ, 1 ≤ ℓ → ℓ ≤ L →
      S ℓ = 13000 * epochLeafWeight r addr ℓ * (invAckermann (2 * S (ℓ - 1)) + 1) ^ 2)
    (hS_step : ∀ ℓ, ℓ < L → 2 * S (ℓ + 1) ≤ S ℓ)
    (hvalid : ValidCoreSeq P ops) :
    ∃ subs : List (ℕ × List CoreOp),
      (subs.map Prod.fst).sum = P ∧
      (∀ q ∈ subs, 1 ≤ q.1 ∧ q.1 < 2 * S L ∧ ValidCoreSeq q.1 q.2) ∧
      coreCascadeCost ops ≤ (62 + 66 * r) * P + (subs.map (fun q => coreCascadeCost q.2)).sum := by
  have hw_pos : ∀ ℓ, 1 ≤ ℓ → ℓ ≤ L → 1 ≤ epochLeafWeight r addr ℓ :=
    epochLeafWeight_pos_master r L addr haddr
  have hSL_pos : 1 ≤ S L := by
    rw [hS_def L hL le_rfl]
    have hwL : 1 ≤ epochLeafWeight r addr L := hw_pos L hL le_rfl
    have hi : 2 ≤ invAckermann (2 * S (L - 1)) + 1 := (ackermann_row1_spec (2 * S (L - 1))).1
    have hsq : 1 ≤ (invAckermann (2 * S (L - 1)) + 1) ^ 2 :=
      Nat.one_le_pow 2 _ (by omega)
    nlinarith
  obtain ⟨kops, _, hkvalid, hjump, hrslr, hcost_jumps⟩ :=
    primal_keyed_labeling_and_cost_bridge P ops hP hvalid
  obtain ⟨hfold, hmbase⟩ :=
    folded_dual_laws_and_mbase_bound P kops hP hkvalid hjump
  obtain ⟨hpart, hjumps_eq, hfexit, hb3p, subs, hsubs_sum, hsubs_val, hfact⟩ :=
    primal_scale_subgames_and_post_bound_omega P L S kops
      hP hL hS0 hSL_pos hS_step hkvalid hjump
  have hb1_exit_sum :=
    b1_exit_card_bound P L S kops hP hL hkvalid hjump hfold hpart
  obtain ⟨hfpre, hw_half, hblocks_sum_le, hb1, hb3i, hb2⟩ :=
    epoch_tree_weights_and_buckets P L r addr S kops
      hP hL hr haddr hS0 hS_def hS_step hkvalid hjump hfold hpart
  have hb1_exit : (B_1_exit S P L kops).card ≤ P := le_trans hb1_exit_sum hblocks_sum_le
  have hb3a :=
    active_exit_first_mover_reduction_omega P L S kops
      hP hL hS0 hSL_pos hS_step hkvalid hjump hfold hpart
  obtain ⟨pkgs, hpkgs_all, hgap⟩ :=
    plug_unborn_quotient_and_gap_breakers_omega P L S kops
      hP hL hS0 hSL_pos hS_step hkvalid hjump hfold hpart
  have hw_one : (Finset.Icc 1 L).sum (fun ℓ => (1 : ℚ) / (epochLeafWeight r addr ℓ : ℚ)) ≤ 1 :=
    le_trans hw_half (by norm_num)
  have hpkgs_only : ∀ ℓ, 1 ≤ ℓ → ℓ ≤ L →
      ∀ Xi < (scaleBlocks S P (ℓ - 1)).length,
        let X := (scaleBlocks S P (ℓ - 1)).getD Xi (0, 0)
        ValidBlockQuotientPkg ((splitBlock (S ℓ) X.1 X.2).length - 1) (pkgs ℓ Xi) :=
    fun ℓ h1 h2 Xi hXi => (hpkgs_all ℓ h1 h2 Xi hXi).1
  have hmov25 :=
    tamari_odd_cascade_and_multiscale_sum_omega gapped_right_cascade_bound ackermann_row1_spec
      P L S (epochLeafWeight r addr) hP hL hw_pos hw_one hS_def hpart pkgs hpkgs_only
  have hmov_eq :
      totalPkgMovers S P L pkgs = totalMMovCount S P L kops := by
    unfold totalPkgMovers totalMMovCount
    refine Finset.sum_congr rfl fun ℓ hℓ => ?_
    rw [Finset.mem_Icc] at hℓ
    refine Finset.sum_congr rfl fun Xi hXi => ?_
    rw [Finset.mem_range] at hXi
    refine Finset.sum_congr rfl fun p hp => ?_
    rw [Finset.mem_range] at hp
    exact (hpkgs_all ℓ hℓ.1 hℓ.2 Xi hXi).2 p hp
  rw [hmov_eq] at hmov25
  have hgap33 : totalGapWeight S P L pkgs ≤ 33 * P := by omega
  have hmov_two : 2 * totalMMovCount S P L kops ≤ 5 * P := by omega
  have hb3a48 : (B_3_act S P L kops).card ≤ 48 * P := by omega
  have hb2_bound : (B_2 S P L kops).card ≤ P + 63 * r * P := by
    have h_inner :
        5 * P + (B_3_intra S P L kops).card +
          (B_3_post S P L kops).card + (B_3_act S P L kops).card ≤ 63 * P := by
      omega
    have h_mul :
        r * (5 * P + (B_3_intra S P L kops).card +
          (B_3_post S P L kops).card + (B_3_act S P L kops).card) ≤ r * (63 * P) :=
      Nat.mul_le_mul_left r h_inner
    have h_assoc : r * (63 * P) = 63 * r * P := by ring
    omega
  refine ⟨subs, hsubs_sum, hsubs_val, ?_⟩
  have h_lin :
      P + ((B_fin_pre S P L kops).card + (B_fin_exit S P L kops).card +
        (B_1 S P L kops).card + (B_2 S P L kops).card +
        (B_3_intra S P L kops).card + (B_3_post S P L kops).card +
        (B_3_act S P L kops).card) ≤ (62 + 66 * r) * P := by
    nlinarith
  omega

private lemma validCoreSeq_zero_cost (ops : List CoreOp) (hval : ValidCoreSeq 0 ops) :
    coreCascadeCost ops = 0 := by
  obtain ⟨hpush, hpop, haux⟩ := hval
  rcases ops with _ | ⟨op, rest⟩
  · rfl
  · rcases op with _ | _ | d
    · simp [countCorePush] at hpush
    · simp [countCorePop] at hpop
    · simp [ValidCoreSeqAux, rightSpineLen] at haux

private lemma sum_cost_linear_master (K : ℕ) (xs : List (ℕ × List CoreOp))
    (hxs : ∀ q ∈ xs, coreCascadeCost q.2 ≤ K * q.1) :
    (xs.map (fun q => coreCascadeCost q.2)).sum ≤ K * (xs.map Prod.fst).sum := by
  induction xs with
  | nil => simp
  | cons x rest ih =>
    have hx := hxs x (by simp)
    have hrest := ih (fun q hq => hxs q (List.mem_cons_of_mem x hq))
    simp only [List.map_cons, List.sum_cons]
    have hring : K * (x.1 + (rest.map Prod.fst).sum) = K * x.1 + K * (rest.map Prod.fst).sum := by
      ring
    omega

/-- Unified single-pass Epoch Contraction wrapper: whether `epoch_contraction_existence` takes
Branch A (`2 * P ≤ B ^ (6 ^ r)`) or Branch B (`∃ L addr S, ...`), produces subgames of total
size `P`, each of size `≤ B ^ (6 ^ r)`, at linear overhead `(62 + 66 * r) * P`. -/
private lemma epoch_pass_unified (P r : ℕ) (ops : List CoreOp)
    (hP : 1 ≤ P) (hr : 1 ≤ r) (hval : ValidCoreSeq P ops) :
    let B := max (iteratedInvAckermannHierarchy r P) (2 ^ (6 ^ (2 * r)))
    ∃ subs : List (ℕ × List CoreOp),
      (subs.map Prod.fst).sum = P ∧
      (∀ q ∈ subs, 1 ≤ q.1 ∧ q.1 ≤ B ^ (6 ^ r) ∧ ValidCoreSeq q.1 q.2) ∧
      coreCascadeCost ops ≤ (62 + 66 * r) * P + (subs.map (fun q => coreCascadeCost q.2)).sum := by
  intro B
  rcases epoch_contraction_existence P r hP hr with h_small | ⟨L, addr, S, hL, haddr, hS0, hS_def, hS_step, hSL⟩
  · refine ⟨[(P, ops)], by simp, ?_, ?_⟩
    · intro q hq
      simp only [List.mem_singleton] at hq
      subst hq
      dsimp (config := { failIfUnchanged := false }) only [B] at *
      exact ⟨hP, by omega, hval⟩
    · simp only [List.map_cons, List.map_nil, List.sum_cons, List.sum_nil, Nat.add_zero]
      omega
  · obtain ⟨subs, hsum, hmem, hcost⟩ :=
      epoch_core_contraction_step P L r addr S ops hP hL hr haddr hS0 hS_def hS_step hval
    refine ⟨subs, hsum, ?_, hcost⟩
    intro q hq
    obtain ⟨hq1, hq_lt, hq_val⟩ := hmem q hq
    dsimp (config := { failIfUnchanged := false }) only [B] at *
    exact ⟨hq1, by omega, hq_val⟩

/-- **Three-Stage Contraction Bound for Core Sequences**:
For ALL `P : ℕ` (with zero exponential base-threshold artifact), any valid core sequence of size `P`
satisfies `coreCascadeCost ops ≤ (78 * ordinalOmegaInvAckermann P + 2794) * P`. -/
theorem core_ordinal_omega_bound (P : ℕ) (ops : List CoreOp) (hvalid : ValidCoreSeq P ops) :
    coreCascadeCost ops ≤ (78 * ordinalOmegaInvAckermann P + 2794) * P := by
  by_cases hP0 : P = 0
  · subst hP0
    rw [validCoreSeq_zero_cost ops hvalid]
    simp
  · have hP : 1 ≤ P := by omega
    set r := ordinalOmegaInvAckermann P
    obtain ⟨hr, hr_le2, _⟩ := (ordinal_omega_spec_and_universal_little_o).2.1 P
    -- Pass 0 at depth r = α_ω(P)
    obtain ⟨subs1, hsum1, hmem1, hcost1⟩ := epoch_pass_unified P r ops hP hr hvalid
    have hB0_pow :
        (max (iteratedInvAckermannHierarchy r P) (2 ^ (6 ^ (2 * r)))) ^ (6 ^ r) =
          2 ^ (6 ^ (3 * r)) := by
      have h2_le : 2 ≤ 2 ^ (6 ^ (2 * r)) := by
        have hpos : 1 ≤ 6 ^ (2 * r) := Nat.one_le_pow (2 * r) 6 (by omega)
        exact le_trans (by decide : 2 ≤ 2 ^ 1) (Nat.pow_le_pow_right (by omega) hpos)
      have hmax : max (iteratedInvAckermannHierarchy r P) (2 ^ (6 ^ (2 * r))) =
          2 ^ (6 ^ (2 * r)) := max_eq_right (le_trans hr_le2 h2_le)
      rw [hmax, ← pow_mul]
      congr 1
      have h3r : 3 * r = 2 * r + r := by omega
      rw [h3r, pow_add]
    -- Bound each Pass-0 subgame q ∈ subs1 via Pass 1 (at depth 1) + Pass 2 (bisection base bound)
    have h_sub1_each : ∀ q ∈ subs1, coreCascadeCost q.2 ≤ (12 * r + 2732) * q.1 := by
      intro q hq
      obtain ⟨hq1, hq_le0, hq_val⟩ := hmem1 q hq
      rw [hB0_pow] at hq_le0
      have h_alpha1 : iteratedInvAckermannHierarchy 1 q.1 ≤ 8 * r + 2 :=
        alpha_one_of_six_pow_three r q.1 hr hq_le0
      obtain ⟨subs2, hsum2, hmem2, hcost2⟩ :=
        epoch_pass_unified q.1 1 q.2 hq1 le_rfl hq_val
      have hB1_le :
          (max (iteratedInvAckermannHierarchy 1 q.1) (2 ^ (6 ^ (2 * 1)))) ^ (6 ^ 1) ≤
            (max (8 * r + 2) (2 ^ 36)) ^ 6 := by
        have hpow36 : 2 ^ (6 ^ (2 * 1)) = 2 ^ 36 := by norm_num
        have hpow6 : (6 : ℕ) ^ 1 = 6 := by norm_num
        rw [hpow36, hpow6]
        exact Nat.pow_le_pow_left (max_le_max h_alpha1 le_rfl) 6
      have h_sub2_each : ∀ u ∈ subs2, coreCascadeCost u.2 ≤ (12 * r + 2604) * u.1 := by
        intro u hu
        obtain ⟨hu1, hu_le1, hu_val⟩ := hmem2 u hu
        have hu_le : u.1 ≤ (max (8 * r + 2) (2 ^ 36)) ^ 6 := le_trans hu_le1 hB1_le
        have hlog : Nat.log 2 u.1 ≤ r + 216 :=
          terminal_bisection_log_bound r u.1 hr hu1 hu_le
        have hbis := bisection_core_base_bound u.1 u.2 hu1 hu_val
        have hmul : 12 * u.1 * (Nat.log 2 u.1 + 1) ≤ 12 * u.1 * (r + 217) :=
          Nat.mul_le_mul_left (12 * u.1) (by omega)
        have hring : 12 * u.1 * (r + 217) = (12 * r + 2604) * u.1 := by ring
        omega
      have hsum2_bound := sum_cost_linear_master (12 * r + 2604) subs2 h_sub2_each
      rw [hsum2] at hsum2_bound
      have hring : (62 + 66 * 1) * q.1 + (12 * r + 2604) * q.1 = (12 * r + 2732) * q.1 := by
        ring
      omega
    have hsum1_bound := sum_cost_linear_master (12 * r + 2732) subs1 h_sub1_each
    rw [hsum1] at hsum1_bound
    have hring : (62 + 66 * r) * P + (12 * r + 2732) * P = (78 * r + 2794) * P := by ring
    omega

/-- **Explicit-Constant Ordinal-`ω` Deque Theorem (`C = 5757`)**:
For every initial BST with `n` nodes and valid deque sequence of `m` operations,
`dequeSequenceCost init.tree ops ≤ 5757 * (m + n) * ordinalOmegaInvAckermann (m + n)`. -/
theorem deque_ordinal_omega_explicit_bound
    (n m : ℕ) (init : BST ℤ) (ops : Fin m → DequeOp ℤ)
    (hn : init.tree.num_nodes = n) (hvalid : ValidDequeSeq init.tree ops) :
    dequeSequenceCost init.tree ops ≤
      5757 * ((m : ℝ) + (n : ℝ)) * (ordinalOmegaInvAckermann (m + n) : ℝ) := by
  obtain ⟨d_L, d_R, ops_L, ops_R, hd_sum, hval_L, hval_R, hdeque_le⟩ :=
    three_way_deque_to_core_reduction n m init ops hn hvalid
  set D := ordinalOmegaInvAckermann (m + n)
  have hD_pos : 1 ≤ D := (ordinal_omega_spec_and_universal_little_o.2.1 (m + n)).1
  have hD_mono : Monotone ordinalOmegaInvAckermann :=
    ordinal_omega_spec_and_universal_little_o.2.2.1
  have hdL_le : ordinalOmegaInvAckermann d_L ≤ D := hD_mono (by omega)
  have hdR_le : ordinalOmegaInvAckermann d_R ≤ D := hD_mono (by omega)
  have hcost_L : coreCascadeCost ops_L ≤ (78 * D + 2794) * d_L := by
    have h1 := core_ordinal_omega_bound d_L ops_L hval_L
    exact le_trans h1 (Nat.mul_le_mul_right d_L (by omega))
  have hcost_R : coreCascadeCost ops_R ≤ (78 * D + 2794) * d_R := by
    have h1 := core_ordinal_omega_bound d_R ops_R hval_R
    exact le_trans h1 (Nat.mul_le_mul_right d_R (by omega))
  have h_nat_bound :
      2 * coreCascadeCost ops_L + 2 * coreCascadeCost ops_R + 2 * n + 13 * m ≤
        5757 * (m + n) * D := by
    have h_sum_LR :
        2 * coreCascadeCost ops_L + 2 * coreCascadeCost ops_R ≤
          (156 * D + 5588) * (d_L + d_R) := by
      have h1 : 2 * ((78 * D + 2794) * d_L) + 2 * ((78 * D + 2794) * d_R) =
          (156 * D + 5588) * (d_L + d_R) := by ring
      omega
    have h_mn_le : (156 * D + 5588) * (d_L + d_R) ≤ (156 * D + 5588) * (m + n) :=
      Nat.mul_le_mul_left (156 * D + 5588) (by omega)
    have h_lin_le : 2 * n + 13 * m ≤ 13 * (m + n) * D := by
      have h1 : 2 * n + 13 * m ≤ 13 * (m + n) := by omega
      have h2 : 13 * (m + n) * 1 ≤ 13 * (m + n) * D :=
        Nat.mul_le_mul_left (13 * (m + n)) hD_pos
      omega
    have h_5588_D : 5588 * (m + n) ≤ 5588 * (m + n) * D := by
      have := Nat.mul_le_mul_left (5588 * (m + n)) hD_pos
      omega
    have hring1 : (156 * D + 5588) * (m + n) + 13 * (m + n) * D =
        169 * (m + n) * D + 5588 * (m + n) := by ring
    have hring2 : 169 * (m + n) * D + 5588 * (m + n) * D = 5757 * (m + n) * D := by ring
    omega
  have h_real_bound :
      ((2 * coreCascadeCost ops_L + 2 * coreCascadeCost ops_R + 2 * n + 13 * m : ℕ) : ℝ) ≤
        ((5757 * (m + n) * D : ℕ) : ℝ) := by
    exact_mod_cast h_nat_bound
  refine le_trans hdeque_le (le_trans h_real_bound ?_)
  push_cast
  ring_nf
  exact le_rfl

/-- **Ordinal-`ω` Inverse-Ackermann Deque Bound for Splay Trees**:
Exact root target theorem matching `Challenge.lean`. -/
theorem deque_ordinal_omega_ackermann_bound :
    ∃ C : ℝ, 0 < C ∧
      ∀ (n m : ℕ) (init : BST ℤ) (ops : Fin m → DequeOp ℤ),
        init.tree.num_nodes = n →
        ValidDequeSeq init.tree ops →
        dequeSequenceCost init.tree ops ≤
          C * ((m : ℝ) + (n : ℝ)) * (ordinalOmegaInvAckermann (m + n) : ℝ) :=
  ⟨5757, by positivity, deque_ordinal_omega_explicit_bound⟩


