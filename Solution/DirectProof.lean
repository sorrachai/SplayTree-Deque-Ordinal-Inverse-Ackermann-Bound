private def tupleWeight (q : ℕ) (v : Fin q → ℕ) : ℕ :=
  (Finset.univ : Finset (Fin q)).prod (fun d => 4 * (v d) ^ 2)

private lemma tupleWeight_one (c : ℕ) : tupleWeight 1 (fun _ => c) = 4 * c ^ 2 := by
  simp [tupleWeight]

private lemma tupleWeight_cons (q c : ℕ) (v : Fin q → ℕ) :
    tupleWeight (q + 1) (Fin.cons c v) = 4 * c ^ 2 * tupleWeight q v := by
  simp [tupleWeight, Fin.prod_univ_succ]

private lemma tupleWeight_pos {q : ℕ} {v : Fin q → ℕ} (hv : ∀ d : Fin q, 1 ≤ v d) :
    1 ≤ tupleWeight q v := by
  unfold tupleWeight
  apply Finset.one_le_prod'
  intro d _
  have hd := hv d
  have hsq : 1 ≤ (v d) ^ 2 := Nat.one_le_pow 2 (v d) hd
  omega

private def TupleLexLt (q : ℕ) (v1 v2 : Fin q → ℕ) : Prop :=
  ∃ d : Fin q, (∀ p : Fin q, p < d → v1 p = v2 p) ∧ v1 d < v2 d

private lemma tupleLexLt_one {v1 v2 : Fin 1 → ℕ} (h : v1 0 < v2 0) :
    TupleLexLt 1 v1 v2 :=
  ⟨0, fun p hp => absurd hp (Fin.not_lt_zero p), h⟩

private lemma tupleLexLt_cons_same {q : ℕ} (c : ℕ) {v1 v2 : Fin q → ℕ}
    (h : TupleLexLt q v1 v2) :
    TupleLexLt (q + 1) (Fin.cons c v1) (Fin.cons c v2) := by
  obtain ⟨d, heq, hlt⟩ := h
  refine ⟨d.succ, ?_, ?_⟩
  · intro p
    refine Fin.cases ?_ ?_ p
    · intro _; simp
    · intro p' hp'
      have hp_lt : p' < d := Fin.succ_lt_succ_iff.mp hp'
      simpa using heq p' hp_lt
  · simpa using hlt

private lemma tupleLexLt_cons_lt {q : ℕ} {c1 c2 : ℕ} (hc : c1 < c2) (v1 v2 : Fin q → ℕ) :
    TupleLexLt (q + 1) (Fin.cons c1 v1) (Fin.cons c2 v2) :=
  ⟨0, fun p hp => absurd hp (Fin.not_lt_zero p), by simpa using hc⟩

private def outScale {α : Type} (S_in : ℕ) (items : List (α × ℕ)) : ℕ :=
  match items with
  | [] => S_in
  | (_, s) :: rest => outScale s rest

private lemma outScale_append {α : Type} (S_in : ℕ) (l1 l2 : List (α × ℕ)) :
    outScale S_in (l1 ++ l2) = outScale (outScale S_in l1) l2 := by
  induction l1 generalizing S_in with
  | nil => rfl
  | cons x rest ih => exact ih x.2

private lemma outScale_map_fst {α β : Type} (f : α → β) (S_in : ℕ) (items : List (α × ℕ)) :
    outScale S_in (items.map (fun x => (f x.1, x.2))) = outScale S_in items := by
  induction items generalizing S_in with
  | nil => rfl
  | cons x rest ih => exact ih x.2

private lemma getElem_last_eq_outScale {α : Type} :
    ∀ (S_curr : ℕ) (items : List (α × ℕ)) (hne : items ≠ []),
      (items[items.length - 1]'(by cases items <;> simp_all)).2 = outScale S_curr items
  | _, [], hne => absurd rfl hne
  | _, [x], _ => rfl
  | _, x :: y :: rest, _ => by
      have ih := getElem_last_eq_outScale x.2 (y :: rest) (List.cons_ne_nil y rest)
      simpa [outScale] using ih

private def ScaleChain (q W : ℕ) : ℕ → List ((Fin q → ℕ) × ℕ) → Prop
  | _, [] => True
  | S_curr, (v, s) :: rest =>
      s = 13000 * (W * tupleWeight q v) * (invAckermann (2 * S_curr) + 1) ^ 2 ∧
      2 * s ≤ S_curr ∧
      ScaleChain q W s rest

private lemma scaleChain_append {q W : ℕ} :
    ∀ (S_in : ℕ) (l1 l2 : List ((Fin q → ℕ) × ℕ)),
      ScaleChain q W S_in (l1 ++ l2) ↔
        ScaleChain q W S_in l1 ∧ ScaleChain q W (outScale S_in l1) l2
  | S_in, [], l2 => by simp [ScaleChain, outScale]
  | S_in, (v, s) :: rest, l2 => by
      simp only [List.cons_append, ScaleChain, outScale]
      rw [scaleChain_append s rest l2]
      tauto

private lemma scaleChain_cons_coord {q W c : ℕ} :
    ∀ (S_curr : ℕ) (items : List ((Fin q → ℕ) × ℕ)),
      ScaleChain q (4 * c ^ 2 * W) S_curr items →
        ScaleChain (q + 1) W S_curr (items.map (fun x => (Fin.cons c x.1, x.2)))
  | _, [], _ => trivial
  | S_curr, (v, s) :: rest, ⟨hs, h2s, hrest⟩ => by
      refine ⟨?_, h2s, scaleChain_cons_coord s rest hrest⟩
      have htw : W * tupleWeight (q + 1) (Fin.cons c v) = (4 * c ^ 2 * W) * tupleWeight q v := by
        rw [tupleWeight_cons]; ring
      rw [htw, hs]

private lemma scaleChain_bounds {q W : ℕ} (hW : 1 ≤ W) :
    ∀ (S_curr : ℕ) (items : List ((Fin q → ℕ) × ℕ)),
      1 ≤ S_curr →
      (∀ x ∈ items, ∀ d : Fin q, 1 ≤ x.1 d) →
      ScaleChain q W S_curr items →
      1 ≤ outScale S_curr items ∧
      outScale S_curr items ≤ S_curr ∧
      (items ≠ [] → 2 * outScale S_curr items ≤ S_curr)
  | S_curr, [], hS, _, _ => ⟨hS, le_rfl, fun h => absurd rfl h⟩
  | S_curr, (v, s) :: rest, _, hpos, ⟨hs, h2s, hrest⟩ => by
      have hv : ∀ d : Fin q, 1 ≤ v d := hpos (v, s) (by simp)
      have htw : 1 ≤ tupleWeight q v := tupleWeight_pos hv
      have hsq : 1 ≤ (invAckermann (2 * S_curr) + 1) ^ 2 := Nat.one_le_pow 2 _ (by omega)
      have hs1 : 1 ≤ s := by
        have h1 : 1 ≤ W * tupleWeight q v := Nat.mul_le_mul hW htw
        have h2 : 13000 ≤ 13000 * (W * tupleWeight q v) * (invAckermann (2 * S_curr) + 1) ^ 2 := by
          have := Nat.mul_le_mul (Nat.mul_le_mul_left 13000 h1) hsq
          omega
        omega
      obtain ⟨hout1, hout_le, _⟩ :=
        scaleChain_bounds hW s rest hs1 (fun x hx => hpos x (by simp [hx])) hrest
      exact ⟨hout1, by dsimp (config := { failIfUnchanged := false }) [outScale]; omega, fun _ => by dsimp (config := { failIfUnchanged := false }) [outScale]; omega⟩

private lemma scaleChain_getElem {q W : ℕ} :
    ∀ (S_curr : ℕ) (items : List ((Fin q → ℕ) × ℕ)),
      ScaleChain q W S_curr items →
      ∀ (k : ℕ) (hk : k < items.length),
        let prev := if k = 0 then S_curr else (items[k - 1]'(by omega)).2
        (items[k]'hk).2 = 13000 * (W * tupleWeight q (items[k]'hk).1) *
          (invAckermann (2 * prev) + 1) ^ 2 ∧
        2 * (items[k]'hk).2 ≤ prev
  | _, [], _, k, hk => absurd hk (Nat.not_lt_zero k)
  | S_curr, (v, s) :: rest, ⟨hs, h2s, hrest⟩, 0, _ => by
      simpa using ⟨hs, h2s⟩
  | S_curr, (v, s) :: rest, ⟨_, _, hrest⟩, k + 1, hk => by
      have hk' : k < rest.length := Nat.lt_of_succ_lt_succ hk
      have ih := scaleChain_getElem s rest hrest k hk'
      rcases k with _ | m
      · simpa using ih
      · simpa using ih

/-! ### General Numeric Helper: Bounding `w` from `w < M * (invAckermann w + 1) ^ 2` -/

private lemma poly44_le_pow42 : ∀ d : ℕ, (d + 44) ^ 6 ≤ 2 ^ (d + 42) := by
  intro d
  induction d with
  | zero => norm_num
  | succ d ih =>
    have hring : 2 * (d + 44) ^ 6 = (d + 1 + 44) ^ 6 +
        (d ^ 6 + 258 * d ^ 5 + 27705 * d ^ 4 + 1584860 * d ^ 3 +
         50933505 * d ^ 2 + 871825938 * d + 6208862087) := by ring
    have hpow : 2 ^ (d + 1 + 42) = 2 * 2 ^ (d + 42) := by
      have : d + 1 + 42 = (d + 42) + 1 := by omega
      rw [this, pow_succ]; ring
    omega

private lemma w_lt_of_lt_mul_invAck_sq {w M B : ℕ}
    (hw : w < M * (invAckermann w + 1) ^ 2)
    (hB1 : 1849 * M ≤ B)
    (hB2 : M ^ 3 ≤ B ^ 2) :
    w < B := by
  have hM1 : 1 ≤ M := by
    by_contra h0
    have hM0 : M = 0 := by omega
    rw [hM0, zero_mul] at hw
    omega
  by_cases hw0 : w = 0
  · omega
  · set k := invAckermann w
    by_cases hk42 : k ≤ 42
    · have hk2 : (k + 1) ^ 2 ≤ 1849 := by
        have : (k + 1) ^ 2 ≤ 43 ^ 2 := Nat.pow_le_pow_left (by omega) 2
        omega
      have h1 : M * (k + 1) ^ 2 ≤ 1849 * M := by
        calc M * (k + 1) ^ 2 ≤ M * 1849 := Nat.mul_le_mul_left M hk2
          _ = 1849 * M := by ring
      omega
    · have hk43 : 43 ≤ k := by omega
      set m := k - 1
      have h_not_ack : ¬ (w ≤ ackermann m 1) := by
        intro hle
        have : invAckermann w ≤ m := (invAck_galois w m (by omega)).mpr hle
        change k ≤ m at this
        omega
      have hm_exp : 2 ^ m < w := by
        have hexp := ack_col1_exp m (by omega)
        omega
      have hk6_lt_w : (k + 1) ^ 6 < w := by
        have hp := poly44_le_pow42 (m - 42)
        have hsub1 : m - 42 + 44 = k + 1 := by omega
        have hsub2 : m - 42 + 42 = m := by omega
        rw [hsub1, hsub2] at hp
        omega
      by_contra hge
      have hBw : B ≤ w := by omega
      have hB2w : B ^ 2 * w ≤ w ^ 3 := by
        have hmul := Nat.mul_le_mul_right w (Nat.pow_le_pow_left hBw 2)
        have hid : w ^ 2 * w = w ^ 3 := by ring
        omega
      have hw_le : w ≤ M * (k + 1) ^ 2 := by omega
      have hw3 : w ^ 3 ≤ M ^ 3 * (k + 1) ^ 6 := by
        calc w ^ 3 ≤ (M * (k + 1) ^ 2) ^ 3 := Nat.pow_le_pow_left hw_le 3
          _ = M ^ 3 * (k + 1) ^ 6 := by ring
      have hM3_pos : 0 < M ^ 3 := Nat.pos_of_ne_zero (by positivity)
      have hlt1 : M ^ 3 * (k + 1) ^ 6 < M ^ 3 * w :=
        Nat.mul_lt_mul_of_pos_left hk6_lt_w hM3_pos
      have hle2 : M ^ 3 * w ≤ B ^ 2 * w := Nat.mul_le_mul_right w hB2
      omega

/-! ### Base-Level (`q = 1`, `p = 0`) Greedy Loop and Contraction -/

private noncomputable def buildBaseLoop (W : ℕ) : ℕ → ℕ → ℕ → List ((Fin 1 → ℕ) × ℕ)
  | 0, _, _ => []
  | fuel + 1, c, S_curr =>
      let cand := 13000 * (W * tupleWeight 1 (fun _ => c)) *
        (invAckermann (2 * S_curr) + 1) ^ 2
      if 2 * cand ≤ S_curr then
        ((fun _ => c), cand) :: buildBaseLoop W fuel (c + 1) cand
      else
        []

private lemma buildBaseLoop_spec (W : ℕ) (hW : 1 ≤ W) :
    ∀ (fuel c S_curr : ℕ),
      1 ≤ c →
      S_curr ≤ fuel →
      let items := buildBaseLoop W fuel c S_curr
      let L_loc := items.length
      let S_out := outScale S_curr items
      (∀ x ∈ items, ∀ d : Fin 1, c ≤ x.1 d) ∧
      items.Pairwise (fun x y => TupleLexLt 1 x.1 y.1) ∧
      ScaleChain 1 W S_curr items ∧
      S_out < 104000 * W * (c + L_loc) ^ 2 * (invAckermann (2 * S_out) + 1) ^ 2 ∧
      ∃ S_seq : ℕ → ℕ,
        S_seq 0 = S_curr ∧
        S_seq L_loc = S_out ∧
        (∀ j < L_loc,
          S_seq (j + 1) = 52000 * W * (c + j) ^ 2 * (invAckermann (2 * S_seq j) + 1) ^ 2 ∧
          2 * S_seq (j + 1) ≤ S_seq j) := by
  intro fuel
  induction fuel with
  | zero =>
    intro c S_curr hc hS0
    have hS_eq : S_curr = 0 := by omega
    subst hS_eq
    refine ⟨by simp [buildBaseLoop], by simp [buildBaseLoop], trivial, ?_, ⟨fun _ => 0, rfl, rfl, ?_⟩⟩
    · simp only [buildBaseLoop, List.length_nil, add_zero, outScale]
      have hW0 : 0 < W := hW
      have hc0 : 0 < c := hc
      positivity
    · intro j hj; simp [buildBaseLoop] at hj
  | succ fuel ih =>
    intro c S_curr hc hS_fuel
    simp only [buildBaseLoop]
    set cand := 13000 * (W * tupleWeight 1 (fun _ => c)) * (invAckermann (2 * S_curr) + 1) ^ 2
    have hcand_eq : cand = 52000 * W * c ^ 2 * (invAckermann (2 * S_curr) + 1) ^ 2 := by
      dsimp (config := { failIfUnchanged := false }) [cand]; rw [tupleWeight_one]; ring
    have hcand_pos : 1 ≤ cand := by
      rw [hcand_eq]
      exact Nat.succ_le_of_lt (by
        have hW0 : 0 < W := hW
        have hc0 : 0 < c := hc
        positivity)
    split_ifs with h2cand
    · have hcand_fuel : cand ≤ fuel := by omega
      obtain ⟨h_coord, h_pw, h_sc, h_stop, ⟨S_seq', hseq0, hseqL, hseq_step⟩⟩ :=
        ih (c + 1) cand (by omega) hcand_fuel
      set rest := buildBaseLoop W fuel (c + 1) cand
      refine ⟨?_, ?_, ⟨rfl, h2cand, h_sc⟩, ?_, ?_⟩
      · intro x hx d
        rcases List.mem_cons.mp hx with rfl | hmem
        · exact le_rfl
        · exact le_trans (by omega) (h_coord x hmem d)
      · rw [List.pairwise_cons]
        refine ⟨?_, h_pw⟩
        intro y hy
        apply tupleLexLt_one
        have hyc := h_coord y hy 0
        dsimp (config := { failIfUnchanged := false }); omega
      · simp only [List.length_cons, outScale]
        have hidx : c + (rest.length + 1) = c + 1 + rest.length := by omega
        rw [hidx]
        exact h_stop
      · let S_seq : ℕ → ℕ := fun
          | 0 => S_curr
          | k + 1 => S_seq' k
        refine ⟨S_seq, rfl, ?_, ?_⟩
        · simpa [S_seq, outScale] using hseqL
        · intro j hj
          simp only [List.length_cons] at hj
          rcases j with _ | j'
          · dsimp (config := { failIfUnchanged := false }) only [S_seq]
            simp only [Nat.add_zero]
            rw [hseq0, ← hcand_eq]
            exact ⟨rfl, h2cand⟩
          · dsimp (config := { failIfUnchanged := false }) only [S_seq]
            obtain ⟨hs', h2s'⟩ := hseq_step j' (by omega)
            have hidx : c + (j' + 1) = c + 1 + j' := by omega
            rw [hidx]
            exact ⟨hs', h2s'⟩
    · refine ⟨by simp, by simp, trivial, ?_, ⟨fun _ => S_curr, rfl, rfl, fun j hj => by simp at hj⟩⟩
      simp only [List.length_nil, add_zero, outScale]
      have h2c : 2 * cand = 104000 * W * c ^ 2 * (invAckermann (2 * S_curr) + 1) ^ 2 := by
        rw [hcand_eq]; ring
      omega

private lemma alpha_one_double (P : ℕ) :
    iteratedInvAckermannHierarchy 1 (2 * P) ≤ iteratedInvAckermannHierarchy 1 P + 1 := by
  rcases Nat.eq_zero_or_pos P with rfl | hP
  · simp
  · have h2P_ack : 2 * P ≤ ackermann P 1 :=
      le_trans (two_mul_le_two_pow P hP) (ack_col1_exp P hP)
    have hinv : invAckermann (2 * P) ≤ P := (invAck_galois (2 * P) P hP).mpr h2P_ack
    have hs := hierarchy_step_le 0 (2 * P)
    have hmono : iteratedInvAckermannHierarchy 1 (invAckermann (2 * P)) ≤
        iteratedInvAckermannHierarchy 1 P :=
      (hierarchy_good 1).2.1 hinv
    change iteratedInvAckermannHierarchy 1 (2 * P) ≤
      1 + iteratedInvAckermannHierarchy 1 (invAckermann (2 * P)) at hs
    omega

private lemma buildBase_contraction (W S_in : ℕ) (hW : 1 ≤ W) :
    let items := buildBaseLoop W S_in 1 S_in
    let S_out := outScale S_in items
    let B := max W (max (iteratedInvAckermannHierarchy 1 S_in) (2 ^ (6 ^ 2)))
    (items = [] → 2 * S_in < 208000 * W * (invAckermann (2 * S_in) + 1) ^ 2) ∧
    2 * S_out ≤ B ^ 6 := by
  obtain ⟨_, _, _, h_stop, ⟨S_seq, hseq0, hseqL, hseq_step⟩⟩ :=
    buildBaseLoop_spec W hW S_in 1 S_in (by omega) le_rfl
  set items := buildBaseLoop W S_in 1 S_in
  set L_loc := items.length
  set S_out := outScale S_in items
  set B := max W (max (iteratedInvAckermannHierarchy 1 S_in) (2 ^ (6 ^ 2)))
  have hW_B : W ≤ B := le_max_left _ _
  have ha1_B : iteratedInvAckermannHierarchy 1 S_in ≤ B := le_trans (le_max_left _ _) (le_max_right _ _)
  have hC_B : 2 ^ 36 ≤ B := le_trans (le_max_right _ _) (le_max_right _ _)
  have hempty : items = [] → 2 * S_in < 208000 * W * (invAckermann (2 * S_in) + 1) ^ 2 := by
    intro he
    have hL0 : L_loc = 0 := by simp [L_loc, he]
    have hout : S_out = S_in := by simp [S_out, he, outScale]
    rw [hL0, hout] at h_stop
    have hid : 2 * (104000 * W * (1 + 0) ^ 2 * (invAckermann (2 * S_in) + 1) ^ 2) =
        208000 * W * (invAckermann (2 * S_in) + 1) ^ 2 := by ring
    omega
  refine ⟨hempty, ?_⟩
  have h_anti_seq : ∀ b ≤ L_loc, ∀ a ≤ b, S_seq b ≤ S_seq a := by
    intro b
    induction b with
    | zero => intro _ a ha; rw [show a = 0 by omega]
    | succ b ih =>
      intro hbL a hab
      by_cases heq : a = b + 1
      · subst heq; exact le_rfl
      · have hstep := (hseq_step b (by omega)).2
        have hih := ih (by omega) a (by omega)
        omega
  let f : ℕ → ℕ := fun u => invAckermann u + 1
  have hf_mono : Monotone f := fun a b hab => Nat.add_le_add_right (invAck_mono hab) 1
  have hf_iter : ∀ t u : ℕ, (f^[t] u) ≤ (invAckermann^[t] u) + 2 := by
    intro t
    induction t with
    | zero => intro u; simp
    | succ t ih =>
      intro u
      rw [Function.iterate_succ_apply', Function.iterate_succ_apply']
      have h1 : invAckermann (f^[t] u) ≤ invAckermann ((invAckermann^[t] u) + 2) :=
        invAck_mono (ih u)
      have h2 := invAck_shift (invAckermann^[t] u)
      change invAckermann (f^[t] u) + 1 ≤ invAckermann (invAckermann^[t] u) + 2
      omega
  let uSeq : ℕ → ℕ := fun j => invAckermann (2 * S_seq j)
  have hu_step : ∀ j < L_loc, max W (max (j + 1) 5) ≤ uSeq j → uSeq (j + 1) ≤ f (uSeq j) := by
    intro j hjL hj
    have hWj : W ≤ uSeq j := le_trans (le_max_left _ _) hj
    have hj1 : j + 1 ≤ uSeq j := le_trans (le_max_left _ _) (le_trans (le_max_right _ _) hj)
    have hj5 : 5 ≤ uSeq j := le_trans (le_max_right _ _) (le_trans (le_max_right _ _) hj)
    have hp2_j : (1 + j) ^ 2 ≤ (uSeq j) ^ 2 := Nat.pow_le_pow_left (by omega) 2
    have hp2_u : (uSeq j + 1) ^ 2 ≤ (2 * uSeq j) ^ 2 := Nat.pow_le_pow_left (by omega) 2
    have hmul : 2 * S_seq (j + 1) ≤ 2 ^ 20 * (uSeq j) ^ 6 := by
      have hs_eq := (hseq_step j hjL).1
      have h2s : 2 * S_seq (j + 1) = 104000 * W * (1 + j) ^ 2 * (uSeq j + 1) ^ 2 := by
        rw [hs_eq]; dsimp (config := { failIfUnchanged := false }) [uSeq]; ring
      have h_p1 : 104000 * W * (1 + j) ^ 2 * (uSeq j + 1) ^ 2 ≤
          104000 * uSeq j * (uSeq j) ^ 2 * (2 * uSeq j) ^ 2 := by
        have hm1 := Nat.mul_le_mul (Nat.mul_le_mul_left 104000 hWj) hp2_j
        exact Nat.mul_le_mul hm1 hp2_u
      have hid1 : 104000 * uSeq j * (uSeq j) ^ 2 * (2 * uSeq j) ^ 2 = 416000 * (uSeq j) ^ 5 := by
        ring
      have h5_6 : (uSeq j) ^ 5 ≤ (uSeq j) ^ 6 := by
        calc (uSeq j) ^ 5 = (uSeq j) ^ 5 * 1 := by ring
          _ ≤ (uSeq j) ^ 5 * uSeq j := Nat.mul_le_mul_left _ (by omega)
          _ = (uSeq j) ^ 6 := by ring
      have hc : 416000 * (uSeq j) ^ 5 ≤ 2 ^ 20 * (uSeq j) ^ 6 :=
        le_trans (Nat.mul_le_mul_left 416000 h5_6) (Nat.mul_le_mul_right _ (by norm_num))
      omega
    exact le_trans (invAck_mono hmul) (invAck_poly (uSeq j) hj5)
  set Mstar := iteratedInvAckermannHierarchy 1 (2 * S_in)
  have hM1 : 1 ≤ Mstar := (hierarchy_good 1).1 (2 * S_in)
  have hM_iter : (invAckermann^[Mstar] (2 * S_in)) ≤ 2 :=
    ((hierarchy_succ_props 0).2.1 (2 * S_in)).2.1
  have hM_le_B1 : Mstar ≤ B + 1 := by
    have hd := alpha_one_double S_in
    omega
  by_cases h_early : ∃ j : ℕ, j < L_loc ∧ j < Mstar ∧ uSeq j < max W (max (j + 1) 5)
  · obtain ⟨j, hjL, hjM, huj⟩ := h_early
    have hout_le : S_out ≤ S_seq (j + 1) := by
      rw [← hseqL]
      exact h_anti_seq L_loc le_rfl (j + 1) (by omega)
    have hj_2B : 1 + j ≤ 2 * B := by omega
    have hu_2B : uSeq j + 1 ≤ 2 * B := by
      have hmax : max W (max (j + 1) 5) ≤ 2 * B :=
        max_le (by omega) (max_le (by omega) (by omega))
      omega
    have hp_j : (1 + j) ^ 2 ≤ (2 * B) ^ 2 := Nat.pow_le_pow_left hj_2B 2
    have hp_u : (uSeq j + 1) ^ 2 ≤ (2 * B) ^ 2 := Nat.pow_le_pow_left hu_2B 2
    have hs_eq := (hseq_step j hjL).1
    have h2s : 2 * S_seq (j + 1) ≤ 1664000 * B ^ 5 := by
      have hdef : 2 * S_seq (j + 1) = 104000 * W * (1 + j) ^ 2 * (uSeq j + 1) ^ 2 := by
        rw [hs_eq]; dsimp (config := { failIfUnchanged := false }) [uSeq]; ring
      have hm := Nat.mul_le_mul (Nat.mul_le_mul (Nat.mul_le_mul_left 104000 hW_B) hp_j) hp_u
      have hid : 104000 * B * (2 * B) ^ 2 * (2 * B) ^ 2 = 1664000 * B ^ 5 := by ring
      omega
    have hB6 : 1664000 * B ^ 5 ≤ B ^ 6 := by
      calc 1664000 * B ^ 5 ≤ B * B ^ 5 := Nat.mul_le_mul_right _ (by omega)
        _ = B ^ 6 := by ring
    omega
  · have h_full : ∀ j : ℕ, j < L_loc → j < Mstar → max W (max (j + 1) 5) ≤ uSeq j := by
      intro j hjL hjM
      by_contra hlt
      exact h_early ⟨j, hjL, hjM, by omega⟩
    have hL_lt_M : L_loc < Mstar := by
      by_contra h_ge
      set r := Mstar - 1
      have hr_eq : r + 1 = Mstar := by omega
      have hu_le_f : ∀ t : ℕ, t ≤ r → uSeq t ≤ (f^[t] (uSeq 0)) := by
        intro t
        induction t with
        | zero => intro _; simp
        | succ t ih =>
          intro htr
          have hstep := hu_step t (by omega) (h_full t (by omega) (by omega))
          have hih := hf_mono (ih (by omega))
          rw [Function.iterate_succ_apply']
          exact le_trans hstep hih
      have hur1 : uSeq r ≤ (f^[r] (uSeq 0)) := hu_le_f r le_rfl
      have hur2 : (f^[r] (uSeq 0)) ≤ (invAckermann^[r] (uSeq 0)) + 2 := hf_iter r (uSeq 0)
      have hu0 : uSeq 0 = invAckermann (2 * S_in) := by simp [uSeq, hseq0]
      have hiter_eq : (invAckermann^[r] (uSeq 0)) = (invAckermann^[Mstar] (2 * S_in)) := by
        rw [hu0, ← Function.iterate_succ_apply invAckermann r (2 * S_in)]
        change (invAckermann^[r + 1] (2 * S_in)) = (invAckermann^[Mstar] (2 * S_in))
        rw [hr_eq]
      have hur5 : 5 ≤ uSeq r :=
        le_trans (le_max_right _ _) (le_trans (le_max_right _ _) (h_full r (by omega) (by omega)))
      omega
    set w := 2 * S_out
    have h1L : 1 + L_loc ≤ 2 * B := by omega
    have hw_lt : w < (2 ^ 20 * B ^ 3) * (invAckermann w + 1) ^ 2 := by
      have hp_L : (1 + L_loc) ^ 2 ≤ (2 * B) ^ 2 := Nat.pow_le_pow_left h1L 2
      have hm1 : 208000 * W * (1 + L_loc) ^ 2 ≤ 2 ^ 20 * B ^ 3 := by
        calc 208000 * W * (1 + L_loc) ^ 2
            ≤ 208000 * B * (2 * B) ^ 2 := Nat.mul_le_mul (Nat.mul_le_mul_left 208000 hW_B) hp_L
          _ = 832000 * B ^ 3 := by ring
          _ ≤ 2 ^ 20 * B ^ 3 := Nat.mul_le_mul_right _ (by norm_num)
      have hmul := Nat.mul_le_mul_right ((invAckermann w + 1) ^ 2) hm1
      have hw_2stop : w < 208000 * W * (1 + L_loc) ^ 2 * (invAckermann w + 1) ^ 2 := by
        have hid : 2 * (104000 * W * (1 + L_loc) ^ 2 * (invAckermann w + 1) ^ 2) =
            208000 * W * (1 + L_loc) ^ 2 * (invAckermann w + 1) ^ 2 := by ring
        omega
      exact lt_of_lt_of_le hw_2stop hmul
    have hB_pow3 : 2 ^ 108 ≤ B ^ 3 := by
      calc 2 ^ 108 = (2 ^ 36) ^ 3 := by norm_num
        _ ≤ B ^ 3 := Nat.pow_le_pow_left hC_B 3
    have hcond1 : 1849 * (2 ^ 20 * B ^ 3) ≤ B ^ 6 := by
      calc 1849 * (2 ^ 20 * B ^ 3) = (1849 * 2 ^ 20) * B ^ 3 := by ring
        _ ≤ 2 ^ 108 * B ^ 3 := Nat.mul_le_mul_right _ (by norm_num)
        _ ≤ B ^ 3 * B ^ 3 := Nat.mul_le_mul_right _ hB_pow3
        _ = B ^ 6 := by ring
    have hcond2 : (2 ^ 20 * B ^ 3) ^ 3 ≤ (B ^ 6) ^ 2 := by
      calc (2 ^ 20 * B ^ 3) ^ 3 = 2 ^ 60 * B ^ 9 := by ring
        _ ≤ 2 ^ 108 * B ^ 9 := Nat.mul_le_mul_right _ (by norm_num)
        _ ≤ B ^ 3 * B ^ 9 := Nat.mul_le_mul_right _ hB_pow3
        _ = (B ^ 6) ^ 2 := by ring
    exact le_of_lt (w_lt_of_lt_mul_invAck_sq hw_lt hcond1 hcond2)

/-! ### Internal-Level (`q = p + 2 ≥ 2`) Loop and Contraction -/

private noncomputable def buildInternalLoop (p W : ℕ)
    (childFn : ℕ → ℕ → List ((Fin (p + 1) → ℕ) × ℕ)) :
    ℕ → ℕ → ℕ → List ((Fin (p + 2) → ℕ) × ℕ)
  | 0, _, _ => []
  | rem + 1, c, S_curr =>
      let sub := childFn (4 * c ^ 2 * W) S_curr
      if sub.isEmpty then
        []
      else
        let mapped := sub.map (fun x => (Fin.cons (α := fun _ => ℕ) c x.1, x.2))
        let S_next := outScale S_curr sub
        mapped ++ buildInternalLoop p W childFn rem (c + 1) S_next

private noncomputable def buildEpochAux : (p : ℕ) → ℕ → ℕ → List ((Fin (p + 1) → ℕ) × ℕ)
  | 0, W, S_in => buildBaseLoop W S_in 1 S_in
  | p + 1, W, S_in =>
      let m_star := iteratedInvAckermannHierarchy (p + 2) S_in
      buildInternalLoop p W (buildEpochAux p) (2 * m_star) 1 S_in

private lemma buildInternalLoop_structural (p W : ℕ) (hW : 1 ≤ W)
    (childFn : ℕ → ℕ → List ((Fin (p + 1) → ℕ) × ℕ))
    (hchild_struct : ∀ W' S', 1 ≤ W' → 1 ≤ S' →
      let items := childFn W' S'
      (∀ x ∈ items, ∀ d : Fin (p + 1), 1 ≤ x.1 d) ∧
      items.Pairwise (fun x y => TupleLexLt (p + 1) x.1 y.1) ∧
      ScaleChain (p + 1) W' S' items) :
    ∀ (rem c S_curr : ℕ),
      1 ≤ c →
      1 ≤ S_curr →
      let items := buildInternalLoop p W childFn rem c S_curr
      let S_out := outScale S_curr items
      (∀ x ∈ items, c ≤ x.1 0 ∧ ∀ d : Fin (p + 2), 1 ≤ x.1 d) ∧
      items.Pairwise (fun x y => TupleLexLt (p + 2) x.1 y.1) ∧
      ScaleChain (p + 2) W S_curr items ∧
      (1 ≤ rem → items = [] → childFn (4 * c ^ 2 * W) S_curr = []) ∧
      ((∃ c_stop S_stop,
          c ≤ c_stop ∧ c_stop < c + rem ∧ 1 ≤ S_stop ∧ S_out = S_stop ∧
          childFn (4 * c_stop ^ 2 * W) S_stop = []) ∨
       (∃ seq : ℕ → ℕ,
          seq 0 = S_curr ∧
          seq rem = S_out ∧
          ∀ k < rem,
            let sub := childFn (4 * (c + k) ^ 2 * W) (seq k)
            sub ≠ [] ∧
            seq (k + 1) = outScale (seq k) sub ∧
            1 ≤ seq (k + 1) ∧
            2 * seq (k + 1) ≤ seq k)) := by
  intro rem
  induction rem with
  | zero =>
    intro c S_curr _ _
    refine ⟨by simp [buildInternalLoop], by simp [buildInternalLoop], trivial,
      fun h => by omega, Or.inr ⟨fun _ => S_curr, rfl, rfl, fun k hk => by omega⟩⟩
  | succ rem ih =>
    intro c S_curr hc hS
    have hWc : 1 ≤ 4 * c ^ 2 * W := by
      have hc2 : 1 ≤ c ^ 2 := Nat.one_le_pow 2 c hc
      have h1 := Nat.mul_le_mul (show 1 ≤ 4 by omega) hc2
      have h2 := Nat.mul_le_mul h1 hW
      omega
    obtain ⟨hc_pos, hc_pw, hc_sc⟩ := hchild_struct (4 * c ^ 2 * W) S_curr hWc hS
    set sub := childFn (4 * c ^ 2 * W) S_curr
    by_cases hemp_sub : sub.isEmpty = true
    · have hcall_nil : childFn (4 * c ^ 2 * W) S_curr = [] := List.isEmpty_iff.mp hemp_sub
      have hloop_nil : buildInternalLoop p W childFn (rem + 1) c S_curr = [] := by
        dsimp (config := { failIfUnchanged := false }) [buildInternalLoop]
        exact if_pos hemp_sub
      dsimp (config := { failIfUnchanged := false }) only
      rw [hloop_nil]
      refine ⟨by simp, by simp, trivial, fun _ _ => hcall_nil, ?_⟩
      exact Or.inl ⟨c, S_curr, le_rfl, by omega, hS, rfl, hcall_nil⟩
    · have hsub_ne : sub ≠ [] := fun h => hemp_sub (List.isEmpty_iff.mpr h)
      set mapped : List ((Fin (p + 2) → ℕ) × ℕ) :=
        sub.map (fun x => (Fin.cons (α := fun _ => ℕ) c x.1, x.2))
      set S_next := outScale S_curr sub
      set rest := buildInternalLoop p W childFn rem (c + 1) S_next
      have hloop_cons : buildInternalLoop p W childFn (rem + 1) c S_curr = mapped ++ rest := by
        dsimp (config := { failIfUnchanged := false }) [buildInternalLoop]
        exact if_neg hemp_sub
      dsimp (config := { failIfUnchanged := false }) only
      rw [hloop_cons]
      obtain ⟨hS_next1, _, h2S_next⟩ := scaleChain_bounds hWc S_curr sub hS hc_pos hc_sc
      have h2S_next' : 2 * S_next ≤ S_curr := h2S_next hsub_ne
      obtain ⟨hr_pos, hr_pw, hr_sc, _, hr_dich⟩ := ih (c + 1) S_next (by omega) hS_next1
      have hout_map : outScale S_curr mapped = S_next :=
        outScale_map_fst (Fin.cons (α := fun _ => ℕ) c) S_curr sub
      have hout_tot : outScale S_curr (mapped ++ rest) = outScale S_next rest := by
        rw [outScale_append, hout_map]
      refine ⟨?_, ?_, ?_, ?_, ?_⟩
      · intro x hx
        rcases List.mem_append.mp hx with hxm | hxr
        · obtain ⟨y, hy, rfl⟩ := List.mem_map.mp hxm
          refine ⟨by simp, ?_⟩
          intro d
          refine Fin.cases ?_ ?_ d
          · simpa using hc
          · intro d'; simpa using hc_pos y hy d'
        · obtain ⟨h0, hd_all⟩ := hr_pos x hxr
          exact ⟨by omega, hd_all⟩
      · rw [List.pairwise_append]
        refine ⟨?_, hr_pw, ?_⟩
        · rw [List.pairwise_map]
          exact hc_pw.imp (fun h => tupleLexLt_cons_same c h)
        · intro x hx y hy
          obtain ⟨x0, _, rfl⟩ := List.mem_map.mp hx
          have hy0 : c + 1 ≤ y.1 0 := (hr_pos y hy).1
          refine ⟨0, fun q hq => absurd hq (Fin.not_lt_zero q), ?_⟩
          change c < y.1 0
          omega
      · rw [scaleChain_append, hout_map]
        exact ⟨scaleChain_cons_coord S_curr sub hc_sc, hr_sc⟩
      · intro _ hemp
        have hmap_ne : mapped ≠ [] := by
          intro hm
          exact hsub_ne (List.map_eq_nil_iff.mp hm)
        exact absurd (List.append_eq_nil_iff.mp hemp).1 hmap_ne
      · rw [hout_tot]
        rcases hr_dich with ⟨c_stop, S_stop, hc1, hc2, hS1, hout_s, hnil_s⟩ | ⟨seq', hs0, hsrem, hsk⟩
        · exact Or.inl ⟨c_stop, S_stop, by omega, by omega, hS1, hout_s, hnil_s⟩
        · let seq : ℕ → ℕ := fun
            | 0 => S_curr
            | k + 1 => seq' k
          refine Or.inr ⟨seq, rfl, hsrem, ?_⟩
          intro k hk
          rcases k with _ | k'
          · dsimp (config := { failIfUnchanged := false }) only [seq]
            simp only [Nat.add_zero]
            rw [hs0]
            exact ⟨hsub_ne, rfl, hS_next1, h2S_next'⟩
          · dsimp (config := { failIfUnchanged := false }) only [seq]
            have hidx : c + (k' + 1) = c + 1 + k' := by omega
            rw [hidx]
            exact hsk k' (by omega)

/-! ### Pair-Step Arithmetic Lemmas for Internal Contraction (`q ≥ 2`) -/

private lemma sq_le_two_pow : ∀ d : ℕ, (d + 4) ^ 2 ≤ 2 ^ (d + 4) := by
  intro d
  induction d with
  | zero => norm_num
  | succ d ih =>
    have hring : 2 * (d + 4) ^ 2 = (d + 1 + 4) ^ 2 + (d ^ 2 + 6 * d + 7) := by ring
    have hpow : 2 ^ (d + 1 + 4) = 2 * 2 ^ (d + 4) := by
      have : d + 1 + 4 = (d + 4) + 1 := by omega
      rw [this, pow_succ]; ring
    omega

private lemma add_two_le_two_pow : ∀ d : ℕ, d + 5 ≤ 2 ^ (d + 3) := by
  intro d
  induction d with
  | zero => norm_num
  | succ d ih =>
    have hpow : 2 ^ (d + 1 + 3) = 2 * 2 ^ (d + 3) := by
      have : d + 1 + 3 = (d + 3) + 1 := by omega
      rw [this, pow_succ]; ring
    omega

private lemma six_pow_two_q_ge_lin (q : ℕ) (hq : 2 ≤ q) :
    6 * q + 54 ≤ 6 ^ (2 * q) := by
  have h_ind : ∀ k : ℕ, 6 * (k + 2) + 54 ≤ 6 ^ (2 * (k + 2)) := by
    intro k
    induction k with
    | zero => norm_num
    | succ k ih =>
      have hpow : 6 ^ (2 * (k + 1 + 2)) = 36 * 6 ^ (2 * (k + 2)) := by
        have : 2 * (k + 1 + 2) = 2 * (k + 2) + 2 := by omega
        rw [this, pow_add]; ring
      omega
  have hk := h_ind (q - 2)
  have hsub : q - 2 + 2 = q := by omega
  rw [hsub] at hk
  exact hk

private lemma pair_step_collapse (q X0 X1 X2 : ℕ) (hq : 2 ≤ q)
    (hs_gt : 2 ^ (6 ^ (2 * q)) < iteratedInvAckermannHierarchy (q - 1) X0)
    (hX1 : X1 ≤ (iteratedInvAckermannHierarchy (q - 1) X0) ^ (6 ^ (q - 1)))
    (hX2 : X2 ≤ (iteratedInvAckermannHierarchy (q - 1) X1) ^ (6 ^ (q - 1))) :
    iteratedInvAckermannHierarchy q X2 + 1 ≤ iteratedInvAckermannHierarchy q X0 := by
  set s := iteratedInvAckermannHierarchy (q - 1) X0
  have hs_ge_pow : 2 ^ (6 ^ (2 * q)) ≤ s := le_of_lt hs_gt
  have hs_pos : 0 < s := by
    have : 1 ≤ 2 ^ (6 ^ (2 * q)) := Nat.one_le_two_pow
    omega
  set t := Nat.log 2 s
  have ht_ge_6 : 6 ^ (2 * q) ≤ t := Nat.le_log_of_pow_le (by decide) hs_ge_pow
  have h2t_le_s : 2 ^ t ≤ s := Nat.pow_log_le_self 2 (by omega)
  have hs_lt_2t1 : s < 2 ^ (t + 1) := Nat.lt_pow_succ_log_self (by decide) s
  have h5q_le_6 : 2 ^ (5 * q) ≤ 6 ^ (2 * q) := by
    calc 2 ^ (5 * q) = (2 ^ 5) ^ q := by rw [pow_mul]
      _ ≤ (6 ^ 2) ^ q := Nat.pow_le_pow_left (by norm_num) q
      _ = 6 ^ (2 * q) := by rw [← pow_mul]
  have ht_ge_2_5q : 2 ^ (5 * q) ≤ t := le_trans h5q_le_6 ht_ge_6
  have ht_pos : 0 < t := by
    have : 1 ≤ 2 ^ (5 * q) := Nat.one_le_two_pow
    omega
  set r_log := Nat.log 2 t
  have hr_ge_5q : 5 * q ≤ r_log := Nat.le_log_of_pow_le (by decide) ht_ge_2_5q
  have h2r_le_t : 2 ^ r_log ≤ t := Nat.pow_log_le_self 2 (by omega)
  have ht_lt_2r1 : t < 2 ^ (r_log + 1) := Nat.lt_pow_succ_log_self (by decide) t
  have hX1_tower : X1 ≤ 2 ^ (2 ^ (r_log + 3 * q)) := by
    have hs_2t : s ≤ 2 ^ (2 * t) :=
      le_trans (le_of_lt hs_lt_2t1) (Nat.pow_le_pow_right (by omega) (by omega))
    have hp1 : s ^ (6 ^ (q - 1)) ≤ 2 ^ (2 * t * 6 ^ (q - 1)) := by
      calc s ^ (6 ^ (q - 1)) ≤ (2 ^ (2 * t)) ^ (6 ^ (q - 1)) := Nat.pow_le_pow_left hs_2t _
        _ = 2 ^ (2 * t * 6 ^ (q - 1)) := by rw [← pow_mul]
    have h6_pow : 6 ^ (q - 1) ≤ 2 ^ (3 * (q - 1)) := by
      calc 6 ^ (q - 1) ≤ (2 ^ 3) ^ (q - 1) := Nat.pow_le_pow_left (by norm_num) _
        _ = 2 ^ (3 * (q - 1)) := by rw [← pow_mul]
    have h2t_pow : 2 * t ≤ 2 ^ (r_log + 2) := by
      have hpow : 2 ^ (r_log + 2) = 2 * 2 ^ (r_log + 1) := by rw [pow_succ]; ring
      omega
    have hexp_le : 2 * t * 6 ^ (q - 1) ≤ 2 ^ (r_log + 3 * q) := by
      calc 2 * t * 6 ^ (q - 1)
          ≤ 2 ^ (r_log + 2) * 2 ^ (3 * (q - 1)) := Nat.mul_le_mul h2t_pow h6_pow
        _ = 2 ^ (r_log + 2 + 3 * (q - 1)) := by rw [← pow_add]
        _ ≤ 2 ^ (r_log + 3 * q) := Nat.pow_le_pow_right (by omega) (by omega)
    exact le_trans hX1 (le_trans hp1 (Nat.pow_le_pow_right (by omega) hexp_le))
  have ha1_X1 : iteratedInvAckermannHierarchy (q - 1) X1 ≤ 2 * r_log := by
    have h_anti : iteratedInvAckermannHierarchy (q - 1) X1 ≤ iteratedInvAckermannHierarchy 1 X1 :=
      hierarchy_anti_level (by omega) X1
    have h_tw := alpha_one_two_pow_two_pow (r_log + 3 * q) X1 (by omega) hX1_tower
    omega
  set u := Nat.log 2 r_log
  have hr_ge8 : 2 ^ 3 ≤ r_log := by omega
  have hu_ge3 : 3 ≤ u := Nat.le_log_of_pow_le (by decide) hr_ge8
  have h2u_le_r : 2 ^ u ≤ r_log := Nat.pow_log_le_self 2 (by omega)
  have hr_lt_2u1 : r_log < 2 ^ (u + 1) := Nat.lt_pow_succ_log_self (by decide) r_log
  have h2r_2u2 : 2 * r_log ≤ 2 ^ (u + 2) := by
    have hpow : 2 ^ (u + 2) = 2 * 2 ^ (u + 1) := by rw [pow_succ]; ring
    omega
  have hu2_le_r : u + 2 ≤ r_log := by
    have hd := add_two_le_two_pow (u - 3)
    have hs1 : u - 3 + 5 = u + 2 := by omega
    have hs2 : u - 3 + 3 = u := by omega
    rw [hs1, hs2] at hd
    exact le_trans hd h2u_le_r
  have hr_sq_le_t : r_log ^ 2 ≤ t := by
    have hd := sq_le_two_pow (r_log - 4)
    have hs1 : r_log - 4 + 4 = r_log := by omega
    rw [hs1] at hd
    exact le_trans hd h2r_le_t
  have hu2_sq_le_t : (u + 2) ^ 2 ≤ t := le_trans (Nat.pow_le_pow_left hu2_le_r 2) hr_sq_le_t
  have h6_sq_le_t : (6 ^ (q - 1)) ^ 2 ≤ t := by
    have hid : 6 ^ (2 * q) = 36 * (6 ^ (q - 1)) ^ 2 := by
      have hq_eq : 2 * q = 2 + (q - 1) * 2 := by omega
      rw [hq_eq, pow_add, pow_mul]; ring
    omega
  have hprod_le_t : (u + 2) * 6 ^ (q - 1) ≤ t := by
    have hsq : ((u + 2) * 6 ^ (q - 1)) ^ 2 ≤ t ^ 2 := by
      calc ((u + 2) * 6 ^ (q - 1)) ^ 2
          = (u + 2) ^ 2 * (6 ^ (q - 1)) ^ 2 := by ring
        _ ≤ t * t := Nat.mul_le_mul hu2_sq_le_t h6_sq_le_t
        _ = t ^ 2 := by ring
    by_contra hlt
    have hge : t + 1 ≤ (u + 2) * 6 ^ (q - 1) := by omega
    nlinarith
  have hX2_le_s : X2 ≤ s := by
    have ha_u : iteratedInvAckermannHierarchy (q - 1) X1 ≤ 2 ^ (u + 2) :=
      le_trans ha1_X1 h2r_2u2
    calc X2 ≤ (iteratedInvAckermannHierarchy (q - 1) X1) ^ (6 ^ (q - 1)) := hX2
      _ ≤ (2 ^ (u + 2)) ^ (6 ^ (q - 1)) := Nat.pow_le_pow_left ha_u _
      _ = 2 ^ ((u + 2) * 6 ^ (q - 1)) := by rw [← pow_mul]
      _ ≤ 2 ^ t := Nat.pow_le_pow_right (by omega) hprod_le_t
      _ ≤ s := h2t_le_s
  have hq_eq : (q - 1) + 1 = q := by omega
  have hs_gt2 : 2 < s := by
    have h2 : 2 ≤ 2 ^ (6 ^ (2 * q)) :=
      calc 2 = 2 ^ 1 := by norm_num
        _ ≤ 2 ^ (6 ^ (2 * q)) := Nat.pow_le_pow_right (by omega) (Nat.one_le_pow _ 6 (by omega))
    omega
  have hrec : iteratedInvAckermannHierarchy q X0 =
      1 + iteratedInvAckermannHierarchy q s := by
    have hr := (hierarchy_succ_props (q - 1)).2.2.2 X0 hs_gt2
    rw [hq_eq] at hr
    exact hr
  have hmono_X2 : iteratedInvAckermannHierarchy q X2 ≤ iteratedInvAckermannHierarchy q s :=
    (hierarchy_good q).2.1 hX2_le_s
  omega

/-! ### Full Inductive Specification of `buildEpochAux` -/

private lemma buildEpochAux_spec :
    ∀ (p W S_in : ℕ),
      1 ≤ W →
      1 ≤ S_in →
      let q := p + 1
      let items := buildEpochAux p W S_in
      let S_out := outScale S_in items
      let B := max W (max (iteratedInvAckermannHierarchy q S_in) (2 ^ (6 ^ (2 * q))))
      (∀ x ∈ items, ∀ d : Fin q, 1 ≤ x.1 d) ∧
      items.Pairwise (fun x y => TupleLexLt q x.1 y.1) ∧
      ScaleChain q W S_in items ∧
      (items = [] → 2 * S_in < 208000 * 4 ^ p * W * (invAckermann (2 * S_in) + 1) ^ 2) ∧
      2 * S_out ≤ B ^ (6 ^ q) := by
  intro p
  induction p with
  | zero =>
    intro W S_in hW _hS
    obtain ⟨h_coord, h_pw, h_sc, _, _⟩ := buildBaseLoop_spec W hW S_in 1 S_in (by omega) le_rfl
    obtain ⟨h_emp, h_con⟩ := buildBase_contraction W S_in hW
    refine ⟨h_coord, h_pw, h_sc, ?_, ?_⟩
    · simpa [buildEpochAux] using h_emp
    · simpa [buildEpochAux] using h_con
  | succ p ih =>
    intro W S_in hW hS
    set q := p + 2
    set m_star := iteratedInvAckermannHierarchy q S_in
    have hm1 : 1 ≤ m_star := (hierarchy_good q).1 S_in
    have hchild_struct : ∀ W' S', 1 ≤ W' → 1 ≤ S' →
        let items := buildEpochAux p W' S'
        (∀ x ∈ items, ∀ d : Fin (p + 1), 1 ≤ x.1 d) ∧
        items.Pairwise (fun x y => TupleLexLt (p + 1) x.1 y.1) ∧
        ScaleChain (p + 1) W' S' items :=
      fun W' S' hW' hS' =>
        ⟨(ih W' S' hW' hS').1, (ih W' S' hW' hS').2.1, (ih W' S' hW' hS').2.2.1⟩
    obtain ⟨h_pos, h_pw, h_sc, h_nil, h_dich⟩ :=
      buildInternalLoop_structural p W hW (buildEpochAux p) hchild_struct
        (2 * m_star) 1 S_in (by omega) hS
    set items := buildEpochAux (p + 1) W S_in
    have hitems_def : items = buildInternalLoop p W (buildEpochAux p) (2 * m_star) 1 S_in := rfl
    rw [← hitems_def] at h_pos h_pw h_sc h_nil h_dich
    set S_out := outScale S_in items
    set C_q := 2 ^ (6 ^ (2 * q))
    set C_prev := 2 ^ (6 ^ (2 * (p + 1)))
    set U := max W (max m_star C_q)
    have hW_U : W ≤ U := le_max_left _ _
    have hm_U : m_star ≤ U := le_trans (le_max_left _ _) (le_max_right _ _)
    have hC_U : C_q ≤ U := le_trans (le_max_right _ _) (le_max_right _ _)
    have hq2 : 2 ≤ q := by omega
    have hlin_6 : 6 * q + 54 ≤ 6 ^ (2 * q) := six_pow_two_q_ge_lin q hq2
    refine ⟨fun x hx d => (h_pos x hx).2 d, h_pw, h_sc, ?_, ?_⟩
    · intro hemp
      have hsub_nil : buildEpochAux p (4 * 1 ^ 2 * W) S_in = [] := h_nil (by omega) hemp
      have h4W : 1 ≤ 4 * 1 ^ 2 * W := by omega
      have h_ih_emp := (ih (4 * 1 ^ 2 * W) S_in h4W hS).2.2.2.1 hsub_nil
      have hid : 208000 * 4 ^ p * (4 * 1 ^ 2 * W) = 208000 * 4 ^ (p + 1) * W := by
        rw [pow_succ]; ring
      rw [hid] at h_ih_emp
      exact h_ih_emp
    · change 2 * S_out ≤ U ^ (6 ^ q)
      rcases h_dich with ⟨c_stop, S_stop, hc1, hc2, hS_stop1, hout_eq, hsub_nil⟩ |
          ⟨seq, hseq0, hseq_end, hseq_step⟩
      · -- Early stop at some child `c_stop`
        set W_c := 4 * c_stop ^ 2 * W
        have hWc1 : 1 ≤ W_c := by
          have hc_sq : 1 ≤ c_stop ^ 2 := Nat.one_le_pow 2 _ hc1
          have h1 := Nat.mul_le_mul (show 1 ≤ 4 by omega) hc_sq
          have h2 := Nat.mul_le_mul h1 hW
          omega
        have h_emp := (ih W_c S_stop hWc1 hS_stop1).2.2.2.1 hsub_nil
        set w := 2 * S_stop
        have hc_2U : c_stop ≤ 2 * U := by omega
        have hWc_U3 : W_c ≤ 16 * U ^ 3 := by
          have hc_sq : c_stop ^ 2 ≤ (2 * U) ^ 2 := Nat.pow_le_pow_left hc_2U 2
          calc W_c = 4 * c_stop ^ 2 * W := rfl
            _ ≤ 4 * (2 * U) ^ 2 * U := Nat.mul_le_mul (Nat.mul_le_mul_left 4 hc_sq) hW_U
            _ = 16 * U ^ 3 := by ring
        set M := 2 ^ (2 * q + 18) * U ^ 3
        have hM_bound : 208000 * 4 ^ p * W_c ≤ M := by
          have h4p : 4 ^ p = 2 ^ (2 * p) := by
            calc 4 ^ p = (2 ^ 2) ^ p := by norm_num
              _ = 2 ^ (2 * p) := by rw [← pow_mul]
          have h208 : 208000 ≤ 2 ^ 18 := by norm_num
          calc 208000 * 4 ^ p * W_c
              ≤ 2 ^ 18 * 2 ^ (2 * p) * (16 * U ^ 3) := by
                rw [h4p]
                exact Nat.mul_le_mul (Nat.mul_le_mul_right _ h208) hWc_U3
            _ = 2 ^ 18 * 2 ^ (2 * p) * 2 ^ 4 * U ^ 3 := by ring
            _ = 2 ^ (18 + 2 * p + 4) * U ^ 3 := by rw [← pow_add, ← pow_add]
            _ ≤ 2 ^ (2 * q + 18) * U ^ 3 :=
                Nat.mul_le_mul_right _ (Nat.pow_le_pow_right (by omega) (by omega))
        have hw_lt : w < M * (invAckermann w + 1) ^ 2 := by
          have hm := Nat.mul_le_mul_right ((invAckermann w + 1) ^ 2) hM_bound
          omega
        have hU1 : 1 ≤ U := by omega
        have hcond1 : 1849 * M ≤ U ^ 6 := by
          have hpow_le_C : 1849 * 2 ^ (2 * q + 18) ≤ C_q := by
            calc 1849 * 2 ^ (2 * q + 18)
                ≤ 2 ^ 11 * 2 ^ (2 * q + 18) := Nat.mul_le_mul_right _ (by norm_num)
              _ = 2 ^ (11 + (2 * q + 18)) := by rw [← pow_add]
              _ ≤ 2 ^ (6 ^ (2 * q)) := Nat.pow_le_pow_right (by omega) (by omega)
          calc 1849 * M = (1849 * 2 ^ (2 * q + 18)) * U ^ 3 := by dsimp (config := { failIfUnchanged := false }) [M]; ring
            _ ≤ C_q * U ^ 3 := Nat.mul_le_mul_right _ hpow_le_C
            _ ≤ U * U ^ 3 := Nat.mul_le_mul_right _ hC_U
            _ = U ^ 4 * 1 := by ring
            _ ≤ U ^ 4 * U ^ 2 := Nat.mul_le_mul_left _ (Nat.one_le_pow 2 U hU1)
            _ = U ^ 6 := by ring
        have hcond2 : M ^ 3 ≤ (U ^ 6) ^ 2 := by
          have hpow_le_C : 2 ^ ((2 * q + 18) * 3) ≤ C_q :=
            Nat.pow_le_pow_right (by omega) (by omega)
          calc M ^ 3 = (2 ^ (2 * q + 18)) ^ 3 * U ^ 9 := by dsimp (config := { failIfUnchanged := false }) [M]; ring
            _ = 2 ^ ((2 * q + 18) * 3) * U ^ 9 := by rw [← pow_mul]
            _ ≤ C_q * U ^ 9 := Nat.mul_le_mul_right _ hpow_le_C
            _ ≤ U * U ^ 9 := Nat.mul_le_mul_right _ hC_U
            _ = U ^ 10 * 1 := by ring
            _ ≤ U ^ 10 * U ^ 2 := Nat.mul_le_mul_left _ (Nat.one_le_pow 2 U hU1)
            _ = (U ^ 6) ^ 2 := by ring
        have hw_lt_U6 : w < U ^ 6 := w_lt_of_lt_mul_invAck_sq hw_lt hcond1 hcond2
        have hU6_Uq : U ^ 6 ≤ U ^ (6 ^ q) := by
          have h6_le : 6 ≤ 6 ^ q := by
            calc 6 = 6 ^ 1 := by ring
              _ ≤ 6 ^ q := Nat.pow_le_pow_right (by omega) (by omega)
          exact Nat.pow_le_pow_right hU1 h6_le
        rw [hout_eq]
        exact le_trans (le_of_lt hw_lt_U6) hU6_Uq
      · -- Full run of all `2 * m_star` children
        set M_floor := max (16 * W * m_star ^ 2) C_q
        have hU_ge16 : 16 ≤ U := by
          have : 16 ≤ C_q := by
            calc 16 = 2 ^ 4 := by norm_num
              _ ≤ 2 ^ (6 ^ (2 * q)) := Nat.pow_le_pow_right (by omega) (by omega)
          omega
        have hMfloor_U6 : M_floor ≤ U ^ 6 := by
          apply max_le
          · calc 16 * W * m_star ^ 2
                ≤ U * U * U ^ 2 :=
                  Nat.mul_le_mul (Nat.mul_le_mul hU_ge16 hW_U) (Nat.pow_le_pow_left hm_U 2)
              _ = U ^ 4 * 1 := by ring
              _ ≤ U ^ 4 * U ^ 2 := Nat.mul_le_mul_left _ (Nat.one_le_pow 2 U (by omega))
              _ = U ^ 6 := by ring
          · calc C_q ≤ U := hC_U
              _ = U * 1 := by ring
              _ ≤ U * U ^ 5 := Nat.mul_le_mul_left _ (Nat.one_le_pow 5 U (by omega))
              _ = U ^ 6 := by ring
        have hMfloor_pow : M_floor ^ (6 ^ (p + 1)) ≤ U ^ (6 ^ q) := by
          calc M_floor ^ (6 ^ (p + 1))
              ≤ (U ^ 6) ^ (6 ^ (p + 1)) := Nat.pow_le_pow_left hMfloor_U6 _
            _ = U ^ (6 * 6 ^ (p + 1)) := by rw [← pow_mul]
            _ = U ^ (6 ^ q) := by
                congr 1
                have : q = (p + 1) + 1 := by omega
                rw [this, pow_succ]; ring
        by_cases h_le_floor : 2 * S_out ≤ M_floor ^ (6 ^ (p + 1))
        · exact le_trans h_le_floor hMfloor_pow
        · exfalso
          have h_gt_floor : M_floor ^ (6 ^ (p + 1)) < 2 * S_out := by omega
          have h_seq_pos : ∀ k ≤ 2 * m_star, 1 ≤ seq k := by
            intro k hk
            rcases k with _ | k'
            · rw [hseq0]; exact hS
            · exact (hseq_step k' (by omega)).2.2.1
          have h_seq_anti : ∀ b ≤ 2 * m_star, ∀ a ≤ b, seq b ≤ seq a := by
            intro b
            induction b with
            | zero => intro _ a ha; rw [show a = 0 by omega]
            | succ b ih_b =>
              intro hb a hab
              by_cases heq : a = b + 1
              · subst heq; exact le_rfl
              · have hs := (hseq_step b (by omega)).2.2.2
                have hih := ih_b (by omega) a (by omega)
                omega
          have h_child_force : ∀ k < 2 * m_star,
              C_q < iteratedInvAckermannHierarchy (p + 1) (seq k) ∧
              seq (k + 1) ≤ (iteratedInvAckermannHierarchy (p + 1) (seq k)) ^ (6 ^ (p + 1)) := by
            intro k hk
            set c := 1 + k
            set W_c := 4 * c ^ 2 * W
            have hWc1 : 1 ≤ W_c := by
              have hc2 : 1 ≤ c ^ 2 := Nat.one_le_pow 2 c (by omega)
              have h1 := Nat.mul_le_mul (show 1 ≤ 4 by omega) hc2
              have h2 := Nat.mul_le_mul h1 hW
              omega
            have hsk1 : 1 ≤ seq k := h_seq_pos k (by omega)
            have h_ih_con := (ih W_c (seq k) hWc1 hsk1).2.2.2.2
            obtain ⟨_, hseq_eq, _, _⟩ := hseq_step k hk
            rw [← hseq_eq] at h_ih_con
            have h_out_le : S_out ≤ seq (k + 1) := by
              rw [← hseq_end]
              exact h_seq_anti (2 * m_star) le_rfl (k + 1) (by omega)
            set B_child := max W_c (max (iteratedInvAckermannHierarchy (p + 1) (seq k)) C_prev)
            have hB_pow_gt : M_floor ^ (6 ^ (p + 1)) < B_child ^ (6 ^ (p + 1)) := by omega
            have hM_lt_B : M_floor < B_child := by
              by_contra hle
              have hp := Nat.pow_le_pow_left (show B_child ≤ M_floor by omega) (6 ^ (p + 1))
              omega
            have hWc_le_M : W_c ≤ M_floor := by
              have hc_le : c ≤ 2 * m_star := by omega
              have hc_sq : c ^ 2 ≤ (2 * m_star) ^ 2 := Nat.pow_le_pow_left hc_le 2
              have h1 : W_c ≤ 16 * W * m_star ^ 2 := by
                calc W_c = 4 * c ^ 2 * W := rfl
                  _ ≤ 4 * (2 * m_star) ^ 2 * W :=
                    Nat.mul_le_mul_right W (Nat.mul_le_mul_left 4 hc_sq)
                  _ = 16 * W * m_star ^ 2 := by ring
              exact le_trans h1 (le_max_left _ _)
            have hCprev_le_M : C_prev ≤ M_floor := by
              have hle_C : C_prev ≤ C_q :=
                Nat.pow_le_pow_right (by omega) (Nat.pow_le_pow_right (by omega) (by omega))
              exact le_trans hle_C (le_max_right _ _)
            have hB_eq : B_child = iteratedInvAckermannHierarchy (p + 1) (seq k) := by
              by_contra hne
              have ha_le_M : iteratedInvAckermannHierarchy (p + 1) (seq k) ≤ M_floor := by
                by_contra hgt
                have hm1 : max (iteratedInvAckermannHierarchy (p + 1) (seq k)) C_prev =
                    iteratedInvAckermannHierarchy (p + 1) (seq k) := max_eq_left (by omega)
                have hm2 : B_child = iteratedInvAckermannHierarchy (p + 1) (seq k) := by
                  dsimp (config := { failIfUnchanged := false }) [B_child]; rw [hm1]; exact max_eq_right (by omega)
                exact hne hm2
              have hB_le_M : B_child ≤ M_floor :=
                max_le hWc_le_M (max_le ha_le_M hCprev_le_M)
              omega
            rw [hB_eq] at hM_lt_B h_ih_con
            have hCq_M : C_q ≤ M_floor := le_max_right _ _
            exact ⟨by omega, by omega⟩
          have h_pair_drop : ∀ m ≤ m_star,
              iteratedInvAckermannHierarchy q (seq (2 * m)) + m ≤ m_star := by
            intro m
            induction m with
            | zero =>
              intro _
              simp [hseq0, m_star]
            | succ m ih_m =>
              intro hm_le
              have h1 := h_child_force (2 * m) (by omega)
              have h2 := h_child_force (2 * m + 1) (by omega)
              have hqp : q - 1 = p + 1 := by omega
              have hp_col : iteratedInvAckermannHierarchy q (seq (2 * m + 2)) + 1 ≤
                  iteratedInvAckermannHierarchy q (seq (2 * m)) := by
                apply pair_step_collapse q (seq (2 * m)) (seq (2 * m + 1)) (seq (2 * m + 2)) hq2
                · rw [hqp]; exact h1.1
                · rw [hqp]; exact h1.2
                · rw [hqp]; exact h2.2
              have h_idx : 2 * (m + 1) = 2 * m + 2 := by omega
              rw [h_idx]
              have hih := ih_m (by omega)
              omega
          have h_end := h_pair_drop m_star le_rfl
          have h_pos_end := (hierarchy_good q).1 (seq (2 * m_star))
          omega

/-! ### Main Public Theorem 5: `epoch_contraction_existence` -/

theorem epoch_contraction_existence (P r : ℕ) (hP : 1 ≤ P) (hr : 1 ≤ r) :
    let B := max (SplayTree.iteratedInvAckermannHierarchy r P) (2 ^ (6 ^ (2 * r)))
    2 * P ≤ B ^ (6 ^ r) ∨
      ∃ (L : ℕ) (addr : ℕ → Fin r → ℕ) (S : ℕ → ℕ),
        1 ≤ L ∧
        ValidEpochAddress r L addr ∧
        S 0 = P ∧
        (∀ ℓ, 1 ≤ ℓ → ℓ ≤ L →
          S ℓ = 13000 * epochLeafWeight r addr ℓ *
            (SplayTree.invAckermann (2 * S (ℓ - 1)) + 1) ^ 2) ∧
        (∀ ℓ, ℓ < L → 2 * S (ℓ + 1) ≤ S ℓ) ∧
        2 * S L ≤ B ^ (6 ^ r) := by
  obtain ⟨p, rfl⟩ : ∃ p, r = p + 1 := ⟨r - 1, by omega⟩
  intro B
  obtain ⟨h_pos, h_pw, h_sc, _, h_con⟩ := buildEpochAux_spec p 1 P (by omega) hP
  set items : List ((Fin (p + 1) → ℕ) × ℕ) := buildEpochAux p 1 P
  have h1_le_B : 1 ≤ B := le_trans Nat.one_le_two_pow (le_max_right _ _)
  have hB_eq : max 1 (max (iteratedInvAckermannHierarchy (p + 1) P) (2 ^ (6 ^ (2 * (p + 1))))) =
      B := max_eq_right h1_le_B
  change 2 * outScale P items ≤
    (max 1 (max (iteratedInvAckermannHierarchy (p + 1) P) (2 ^ (6 ^ (2 * (p + 1)))))) ^
      (6 ^ (p + 1)) at h_con
  rw [hB_eq] at h_con
  by_cases hemp : items = []
  · left
    simpa [hemp, outScale] using h_con
  · right
    set L := items.length
    have hL1 : 1 ≤ L := List.length_pos_iff.mpr hemp
    let addr : ℕ → Fin (p + 1) → ℕ := fun ℓ =>
      if h : 1 ≤ ℓ ∧ ℓ ≤ L then (items[ℓ - 1]'(by omega)).1 else fun _ => 1
    let S : ℕ → ℕ := fun ℓ =>
      if ℓ = 0 then P else if h : ℓ ≤ L then (items[ℓ - 1]'(by omega)).2 else 0
    refine ⟨L, addr, S, hL1, ?_, ?_, ?_, ?_, ?_⟩
    · refine ⟨?_, ?_⟩
      · intro ℓ hℓ1 hℓL d
        have hcond : 1 ≤ ℓ ∧ ℓ ≤ L := ⟨hℓ1, hℓL⟩
        simp only [addr, dif_pos hcond]
        exact h_pos _ (List.getElem_mem _) d
      · intro ℓ1 ℓ2 hℓ1 hlt hℓ2
        have hc1 : 1 ≤ ℓ1 ∧ ℓ1 ≤ L := ⟨hℓ1, by omega⟩
        have hc2 : 1 ≤ ℓ2 ∧ ℓ2 ≤ L := ⟨by omega, hℓ2⟩
        simp only [addr, dif_pos hc1, dif_pos hc2]
        exact List.pairwise_iff_getElem.mp h_pw (ℓ1 - 1) (ℓ2 - 1) (by omega) (by omega) (by omega)
    · simp [S]
    · intro ℓ hℓ1 hℓL
      have h_elem := (scaleChain_getElem P items h_sc (ℓ - 1) (by omega)).1
      have hS_curr : S ℓ = (items[ℓ - 1]'(by omega)).2 := by
        have h0 : ℓ ≠ 0 := by omega
        simp [S, h0, hℓL]
      have h_addr : addr ℓ = (items[ℓ - 1]'(by omega)).1 := by
        have hc : 1 ≤ ℓ ∧ ℓ ≤ L := ⟨hℓ1, hℓL⟩
        simp [addr, dif_pos hc]
      have hS_prev :
          (if ℓ - 1 = 0 then P else (items[ℓ - 1 - 1]'(by omega)).2) = S (ℓ - 1) := by
        by_cases h1 : ℓ = 1
        · subst h1; simp [S]
        · have hsub0 : ℓ - 1 ≠ 0 := by omega
          have hsubL : ℓ - 1 ≤ L := by omega
          simp [S, hsub0, hsubL]
      rw [hS_curr, h_elem, hS_prev, ← h_addr]
      simp [epochLeafWeight, tupleWeight]
    · intro ℓ hℓL
      have h_half := (scaleChain_getElem P items h_sc ℓ hℓL).2
      have hS_succ : S (ℓ + 1) = (items[ℓ]'hℓL).2 := by
        have hle : ℓ + 1 ≤ L := by omega
        simp [S, hle]
      have hS_curr : (if ℓ = 0 then P else (items[ℓ - 1]'(by omega)).2) = S ℓ := by
        by_cases h0 : ℓ = 0
        · subst h0; simp [S]
        · have hle : ℓ ≤ L := by omega
          simp [S, h0, hle]
      rw [hS_succ, ← hS_curr]
      exact h_half
    · have hSL : S L = outScale P items := by
        have h0 : L ≠ 0 := by omega
        have hle : L ≤ L := le_rfl
        simp only [S, h0, ↓reduceIte, hle, ↓reduceDIte]
        exact getElem_last_eq_outScale P items hemp
      rw [hSL]
      exact h_con

-- Keep finite-set membership abstract in the legacy bucket proofs.
set_option backward.whnf.reducibleClassField false

-- === BEGIN OmegaGrouping ===
private theorem primal_scale_subgames_and_post_bound_omega_full (P L : ℕ) (S : ℕ → ℕ)
    (kops : List KeyedCoreOp)
    (hP : 1 ≤ P) (hL : 1 ≤ L) (hS0 : S 0 = P) (hSL_pos : 1 ≤ S L)
    (hS_step : ∀ ℓ : ℕ, ℓ < L → 2 * S (ℓ + 1) ≤ S ℓ)
    (hkvalid : ValidKeyedCoreSeq P kops) (hjump : PrimalJumpLaws P kops) :
    ScalePartitionLawsOmega S P L ∧
    (jumps kops).length =
      (B_fin_pre S P L kops).card + (B_fin_exit S P L kops).card +
        (B_fin_act S P L kops).card + (B_1 S P L kops).card +
        (B_2 S P L kops).card + (B_3_intra S P L kops).card +
        (B_3_post S P L kops).card + (B_3_act S P L kops).card ∧
    (B_fin_exit S P L kops).card ≤ P ∧
    (B_3_post S P L kops).card ≤ countKeyedRslr kops ∧
    ∃ subs : List (ℕ × List CoreOp),
      subs.map Prod.fst = (scaleBlocks S P L).map (fun b => b.2 - b.1) ∧
      (∀ q ∈ subs, 1 ≤ q.1 ∧ q.1 < 2 * S L ∧ ValidCoreSeq q.1 q.2) ∧
      (B_fin_act S P L kops).card ≤ (subs.map (fun q => coreCascadeCost q.2)).sum :=
by



  have _ := hL
  have hpart : ScalePartitionLawsOmega S P L := by
    have hS_ge_1 : ∀ k ℓ : ℕ, ℓ + k = L → 1 ≤ S ℓ := by
      intro k
      induction k with
      | zero =>
        intro ℓ h
        have : ℓ = L := by omega
        subst this
        exact hSL_pos
      | succ k ih =>
        intro ℓ h
        have h1 := ih (ℓ + 1) (by omega)
        have h2 := hS_step ℓ (by omega)
        omega
    have hS_pos : ∀ ℓ ≤ L, 1 ≤ S ℓ := fun ℓ hℓ => hS_ge_1 (L - ℓ) ℓ (by omega)

    have h_getD : ∀ {β : Type} (xs : List β) (d : β) (i : ℕ) (hi : i < xs.length),
        xs.getD i d = xs[i] := by
      intro β xs d i hi
      simp [List.getD_eq_getElem?_getD, hi]

    have h_contig_sep : ∀ (B lo hi : ℕ) (bs : List (ℕ × ℕ)),
        psspContig B lo hi bs →
        ∀ c1 c2, c1 < c2 → c2 < bs.length →
          (bs.getD c1 (0, 0)).2 ≤ (bs.getD c2 (0, 0)).1 := by
      intro B lo hi bs h c1 c2
      induction c2 with
      | zero => intro hlt _; omega
      | succ c2 ih =>
        intro hlt hc2
        by_cases heq : c1 = c2
        · subst heq
          have hadj := h.2.2.2.2 c1 hc2
          omega
        · have h1 := ih (by omega) (by omega)
          have h2 := (h.2.2.2.1 c2 (by omega)).2.1
          have h3 := h.2.2.2.2 c2 hc2
          omega

    have h_chain_sum : ∀ (bs : List (ℕ × ℕ)),
        1 ≤ bs.length →
        (∀ c < bs.length, (bs.getD c (0, 0)).1 ≤ (bs.getD c (0, 0)).2) →
        (∀ c, c + 1 < bs.length → (bs.getD c (0, 0)).2 = (bs.getD (c + 1) (0, 0)).1) →
        (bs.getD 0 (0, 0)).1 ≤ (bs.getD (bs.length - 1) (0, 0)).2 ∧
          (bs.map (fun b => b.2 - b.1)).sum =
            (bs.getD (bs.length - 1) (0, 0)).2 - (bs.getD 0 (0, 0)).1 := by
      intro bs
      induction bs with
      | nil => intro h; simp at h
      | cons x rest ih =>
        intro _ hle hadj
        rcases rest with _ | ⟨y, rest'⟩
        · have hx := hle 0 (by simp)
          simp only [List.length_singleton, Nat.sub_self, List.getD_cons_zero,
            List.map_cons, List.map_nil, List.sum_cons, List.sum_nil] at hx ⊢
          omega
        · have hx : x.1 ≤ x.2 := by simpa using hle 0 (by simp)
          have hxy : x.2 = y.1 := by simpa using hadj 0 (by simp)
          have hle' : ∀ c < (y :: rest').length,
              ((y :: rest').getD c (0, 0)).1 ≤ ((y :: rest').getD c (0, 0)).2 := by
            intro c hc
            simp only [List.length_cons] at hc
            simpa using hle (c + 1) (by simp only [List.length_cons]; omega)
          have hadj' : ∀ c, c + 1 < (y :: rest').length →
              ((y :: rest').getD c (0, 0)).2 = ((y :: rest').getD (c + 1) (0, 0)).1 := by
            intro c hc
            simp only [List.length_cons] at hc
            simpa using hadj (c + 1) (by simp only [List.length_cons]; omega)
          obtain ⟨hy_last, hsum'⟩ := ih (by simp) hle' hadj'
          have hlast_eq : (x :: y :: rest').getD ((x :: y :: rest').length - 1) (0, 0) =
              (y :: rest').getD ((y :: rest').length - 1) (0, 0) := by
            simp
          rw [hlast_eq]
          simp only [List.getD_cons_zero, List.map_cons, List.sum_cons] at hy_last hsum' ⊢
          omega

    have h_chain_cover : ∀ (bs : List (ℕ × ℕ)),
        1 ≤ bs.length →
        (∀ c, c + 1 < bs.length → (bs.getD c (0, 0)).2 = (bs.getD (c + 1) (0, 0)).1) →
        ∀ u, (bs.getD 0 (0, 0)).1 ≤ u → u < (bs.getD (bs.length - 1) (0, 0)).2 →
          ∃ c < bs.length, (bs.getD c (0, 0)).1 ≤ u ∧ u < (bs.getD c (0, 0)).2 := by
      intro bs
      induction bs with
      | nil => intro h; simp at h
      | cons x rest ih =>
        intro _ hadj u hu1 hu2
        rcases rest with _ | ⟨y, rest'⟩
        · simp at hu1 hu2
          exact ⟨0, by simp, hu1, hu2⟩
        · simp only [List.getD_cons_zero] at hu1
          by_cases hux : u < x.2
          · exact ⟨0, by simp, hu1, hux⟩
          · have hxy : x.2 = y.1 := by simpa using hadj 0 (by simp)
            have hadj' : ∀ c, c + 1 < (y :: rest').length →
                ((y :: rest').getD c (0, 0)).2 = ((y :: rest').getD (c + 1) (0, 0)).1 := by
              intro c hc
              simp only [List.length_cons] at hc
              simpa using hadj (c + 1) (by simp only [List.length_cons]; omega)
            have hu2' : u < ((y :: rest').getD ((y :: rest').length - 1) (0, 0)).2 := by
              simpa using hu2
            obtain ⟨c', hc', hc1, hc2⟩ := ih (by simp) hadj' u (by simp; omega) hu2'
            simp only [List.length_cons] at hc'
            refine ⟨c' + 1, by simp only [List.length_cons]; omega, ?_, ?_⟩
            · simpa using hc1
            · simpa using hc2

    have h_contig_findIdx : ∀ (B lo hi : ℕ) (bs : List (ℕ × ℕ)),
        psspContig B lo hi bs →
        ∀ c < bs.length, ∀ u,
          (bs.getD c (0, 0)).1 ≤ u → u < (bs.getD c (0, 0)).2 →
          bs.findIdx (fun b => decide (b.1 ≤ u ∧ u < b.2)) = c := by
      intro B lo hi bs h c hc u hu1 hu2
      rw [List.findIdx_eq hc]
      rw [h_getD bs (0, 0) c hc] at hu1 hu2
      refine ⟨by simp [hu1, hu2], ?_⟩
      intro j hj
      have hsep := h_contig_sep B lo hi bs h j c hj hc
      rw [h_getD bs (0, 0) j (lt_trans hj hc), h_getD bs (0, 0) c hc] at hsep
      simp only [decide_eq_false_iff_not]
      omega

    have h_contig_append : ∀ (B lo mid hi : ℕ) (bs1 bs2 : List (ℕ × ℕ)),
        psspContig B lo mid bs1 → psspContig B mid hi bs2 →
        psspContig B lo hi (bs1 ++ bs2) := by
      intro B lo mid hi bs1 bs2 h1 h2
      obtain ⟨hlen1, hlo1, hhi1, hbnd1, hadj1⟩ := h1
      obtain ⟨hlen2, hlo2, hhi2, hbnd2, hadj2⟩ := h2
      have hlo_mid : lo ≤ mid := by
        have hb0 := hbnd1 0 (by omega)
        omega
      have hmid_hi : mid ≤ hi := by
        have hb0 := hbnd2 0 (by omega)
        omega
      have h_app_getD : ∀ c < (bs1 ++ bs2).length,
          (bs1 ++ bs2).getD c (0, 0) =
            if c < bs1.length then bs1.getD c (0, 0) else bs2.getD (c - bs1.length) (0, 0) := by
        intro c hc
        rw [List.length_append] at hc
        by_cases hc1 : c < bs1.length
        · rw [if_pos hc1, h_getD (bs1 ++ bs2) (0, 0) c (by rw [List.length_append]; omega),
              h_getD bs1 (0, 0) c hc1, List.getElem_append_left hc1]
        · rw [if_neg hc1, h_getD (bs1 ++ bs2) (0, 0) c (by rw [List.length_append]; omega),
              h_getD bs2 (0, 0) (c - bs1.length) (by omega),
              List.getElem_append_right (by omega)]
      refine ⟨by rw [List.length_append]; omega, ?_, ?_, ?_, ?_⟩
      · rw [h_app_getD 0 (by rw [List.length_append]; omega), if_pos (by omega)]
        exact hlo1
      · rw [h_app_getD ((bs1 ++ bs2).length - 1) (by rw [List.length_append]; omega)]
        simp only [List.length_append]
        rw [if_neg (by omega)]
        have hidx : bs1.length + bs2.length - 1 - bs1.length = bs2.length - 1 := by omega
        rw [hidx]
        exact hhi2
      · intro c hc
        rw [h_app_getD c hc]
        rw [List.length_append] at hc
        by_cases hc1 : c < bs1.length
        · rw [if_pos hc1]
          have hb := hbnd1 c hc1
          omega
        · rw [if_neg hc1]
          have hb := hbnd2 (c - bs1.length) (by omega)
          omega
      · intro c hc
        have hc_lt : c < (bs1 ++ bs2).length := by omega
        rw [h_app_getD c hc_lt, h_app_getD (c + 1) hc]
        rw [List.length_append] at hc
        by_cases hc1 : c + 1 < bs1.length
        · rw [if_pos (by omega), if_pos hc1]
          exact hadj1 c hc1
        · by_cases hceq : c + 1 = bs1.length
          · rw [if_pos (by omega), if_neg (by omega)]
            have hc_eq : c = bs1.length - 1 := by omega
            have hsub : c + 1 - bs1.length = 0 := by omega
            rw [hsub, hc_eq, hhi1, hlo2]
          · rw [if_neg (by omega), if_neg (by omega)]
            have hsub : c + 1 - bs1.length = (c - bs1.length) + 1 := by omega
            rw [hsub]
            exact hadj2 (c - bs1.length) (by omega)

    have h_contig_flatMap : ∀ (B : ℕ) (f : ℕ × ℕ → List (ℕ × ℕ)) (bs : List (ℕ × ℕ)) (lo hi : ℕ),
        1 ≤ bs.length →
        (bs.getD 0 (0, 0)).1 = lo →
        (bs.getD (bs.length - 1) (0, 0)).2 = hi →
        (∀ c, c + 1 < bs.length → (bs.getD c (0, 0)).2 = (bs.getD (c + 1) (0, 0)).1) →
        (∀ b ∈ bs, psspContig B b.1 b.2 (f b)) →
        psspContig B lo hi (bs.flatMap f) := by
      intro B f bs
      induction bs with
      | nil => intro _ _ h; simp at h
      | cons x rest ih =>
        intro lo hi _ hlo hhi hadj hf
        rcases rest with _ | ⟨y, rest'⟩
        · simp only [List.getD_cons_zero, List.length_singleton, Nat.sub_self] at hlo hhi
          simp only [List.flatMap_cons, List.flatMap_nil, List.append_nil]
          rw [← hlo, ← hhi]
          exact hf x (by simp)
        · simp only [List.getD_cons_zero] at hlo
          have hxy : x.2 = y.1 := by simpa using hadj 0 (by simp)
          have hhi' : ((y :: rest').getD ((y :: rest').length - 1) (0, 0)).2 = hi := by
            simpa using hhi
          have hadj' : ∀ c, c + 1 < (y :: rest').length →
              ((y :: rest').getD c (0, 0)).2 = ((y :: rest').getD (c + 1) (0, 0)).1 := by
            intro c hc
            simp only [List.length_cons] at hc
            simpa using hadj (c + 1) (by simp only [List.length_cons]; omega)
          have hf1 : psspContig B lo x.2 (f x) := by
            rw [← hlo]
            exact hf x (by simp)
          have hf2 : psspContig B x.2 hi ((y :: rest').flatMap f) := by
            rw [hxy]
            exact ih y.1 hi (by simp) (by simp) hhi' hadj'
              (fun b hb => hf b (List.mem_cons_of_mem x hb))
          simp only [List.flatMap_cons]
          exact h_contig_append B lo x.2 hi (f x) ((y :: rest').flatMap f) hf1 hf2

    have h_splitBlock : ∀ (B lo hi : ℕ),
        1 ≤ B → lo < hi → 2 * B ≤ hi - lo →
        2 ≤ (splitBlock B lo hi).length ∧ psspContig B lo hi (splitBlock B lo hi) := by
      intro B lo hi hB hlt h2B
      set D := hi - lo with hD_def
      set K := D / B with hK_def
      have hdiv := Nat.div_add_mod D B
      change B * K + D % B = D at hdiv
      have hD_eq : D = hi - lo := rfl
      have hmod := Nat.mod_lt D (by omega : 0 < B)
      have hK_ge2 : 2 ≤ K := by
        by_contra hK1
        have hK_le : K ≤ 1 := by omega
        have hBK : B * K ≤ B * 1 := Nat.mul_le_mul_left B hK_le
        omega
      have hK_not1 : ¬(K ≤ 1) := by omega
      have hsplit_eq : splitBlock B lo hi =
          (List.range (K - 1)).map (fun c => (lo + c * B, lo + (c + 1) * B)) ++
            [(lo + (K - 1) * B, hi)] := by
        unfold splitBlock
        rw [← hD_def, ← hK_def, if_neg hK_not1]
      set subs := splitBlock B lo hi
      have hlen : subs.length = K := by
        rw [hsplit_eq, List.length_append, List.length_map, List.length_range, List.length_singleton]
        omega
      have hsubs_getD : ∀ c < K,
          subs.getD c (0, 0) =
            if c < K - 1 then (lo + c * B, lo + (c + 1) * B)
            else (lo + (K - 1) * B, hi) := by
        intro c hc
        rw [h_getD subs (0, 0) c (by omega)]
        simp only [subs, hsplit_eq]
        by_cases hc1 : c < K - 1
        · rw [if_pos hc1, List.getElem_append_left (by simp [hc1])]
          simp
        · rw [if_neg hc1, List.getElem_append_right (by simp; omega)]
          simp
      have hlast_bounds : B ≤ hi - (lo + (K - 1) * B) ∧ hi - (lo + (K - 1) * B) < 2 * B := by
        have hmul : (K - 1) * B + B = B * K := by
          have hk1 : (K - 1) + 1 = K := by omega
          calc (K - 1) * B + B = ((K - 1) + 1) * B := by ring
            _ = K * B := by rw [hk1]
            _ = B * K := by ring
        omega
      refine ⟨by omega, ⟨by omega, ?_, ?_, ?_, ?_⟩⟩
      · rw [hsubs_getD 0 (by omega), if_pos (by omega)]
        simp
      · rw [hlen, hsubs_getD (K - 1) (by omega), if_neg (by omega)]
      · intro c hc
        rw [hlen] at hc
        rw [hsubs_getD c hc]
        by_cases hc1 : c < K - 1
        · rw [if_pos hc1]
          dsimp (config := { failIfUnchanged := false }) only
          have hc_le : (c + 1) * B ≤ (K - 1) * B := Nat.mul_le_mul_right B (by omega)
          have hdiff : (lo + (c + 1) * B) - (lo + c * B) = B := by
            have : (c + 1) * B = c * B + B := by ring
            omega
          omega
        · rw [if_neg hc1]
          dsimp (config := { failIfUnchanged := false }) only
          omega
      · intro c hc
        rw [hlen] at hc
        rw [hsubs_getD c (by omega), hsubs_getD (c + 1) hc, if_pos (by omega)]
        by_cases hc2 : c + 1 < K - 1
        · rw [if_pos hc2]
        · rw [if_neg hc2]
          have : c + 1 = K - 1 := by omega
          simp [this]

    have h_scale_contig : ∀ ℓ ≤ L, psspContig (S ℓ) 0 P (scaleBlocks S P ℓ) := by
      intro ℓ
      induction ℓ with
      | zero =>
        intro _
        refine ⟨by simp [scaleBlocks], by simp [scaleBlocks], by simp [scaleBlocks], ?_, ?_⟩
        · intro c hc
          simp only [scaleBlocks, List.length_singleton] at hc
          have hc0 : c = 0 := by omega
          subst hc0
          simp only [scaleBlocks, List.getD_cons_zero, hS0]
          omega
        · intro c hc
          simp [scaleBlocks] at hc
      | succ ℓ ih =>
        intro hℓ1
        have hprev := ih (by omega)
        have hstep := hS_step ℓ (by omega)
        have hB1 : 1 ≤ S (ℓ + 1) := by
          have := hS_pos (ℓ + 1) hℓ1
          omega
        simp only [scaleBlocks]
        refine h_contig_flatMap (S (ℓ + 1)) (fun b => splitBlock (S (ℓ + 1)) b.1 b.2)
          (scaleBlocks S P ℓ) 0 P hprev.1 hprev.2.1 hprev.2.2.1 hprev.2.2.2.2 ?_
        intro b hb
        obtain ⟨idx, hidx, rfl⟩ := List.getElem_of_mem hb
        have hb_bnd := hprev.2.2.2.1 idx hidx
        rw [h_getD (scaleBlocks S P ℓ) (0, 0) idx hidx] at hb_bnd
        exact (h_splitBlock (S (ℓ + 1)) _ _ hB1 hb_bnd.2.1 (by omega)).2

    have h_blocks_sum : ∀ ℓ ≤ L, ((scaleBlocks S P ℓ).map (fun b => b.2 - b.1)).sum = P := by
      intro ℓ hℓ
      have hc := h_scale_contig ℓ hℓ
      have hsum := (h_chain_sum (scaleBlocks S P ℓ) hc.1
        (fun c hlt => le_of_lt (hc.2.2.2.1 c hlt).2.1) hc.2.2.2.2).2
      rw [hc.2.1, hc.2.2.1] at hsum
      omega

    have h_blocks_bounds : ∀ ℓ ≤ L, ∀ b ∈ scaleBlocks S P ℓ,
        b.1 < b.2 ∧ b.2 ≤ P ∧ S ℓ ≤ b.2 - b.1 ∧ b.2 - b.1 < 2 * S ℓ := by
      intro ℓ hℓ b hb
      have hc := h_scale_contig ℓ hℓ
      obtain ⟨i, hi, rfl⟩ := List.getElem_of_mem hb
      have hbnd := hc.2.2.2.1 i hi
      rw [h_getD (scaleBlocks S P ℓ) (0, 0) i hi] at hbnd
      exact ⟨hbnd.2.1, hbnd.2.2.1, hbnd.2.2.2.1, hbnd.2.2.2.2⟩

    have h_blocks_partition : ∀ ℓ ≤ L, ∀ u < P,
        blockIdx S P ℓ u < (scaleBlocks S P ℓ).length ∧
          (blockOf S P ℓ u).1 ≤ u ∧ u < (blockOf S P ℓ u).2 ∧
          (scaleBlocks S P ℓ)[blockIdx S P ℓ u]? = some (blockOf S P ℓ u) := by
      intro ℓ hℓ u hu
      have hc := h_scale_contig ℓ hℓ
      obtain ⟨c, hc_lt, hu1, hu2⟩ := h_chain_cover (scaleBlocks S P ℓ) hc.1 hc.2.2.2.2 u
        (by rw [hc.2.1]; omega) (by rw [hc.2.2.1]; exact hu)
      have hfidx : blockIdx S P ℓ u = c :=
        h_contig_findIdx (S ℓ) 0 P (scaleBlocks S P ℓ) hc c hc_lt u hu1 hu2
      unfold blockOf
      rw [hfidx]
      refine ⟨hc_lt, hu1, hu2, ?_⟩
      rw [h_getD (scaleBlocks S P ℓ) (0, 0) c hc_lt, List.getElem?_eq_getElem hc_lt]

    have h_blocks_eq_iff : ∀ ℓ ≤ L, ∀ u < P, ∀ v < P,
        (blockIdx S P ℓ u = blockIdx S P ℓ v ↔
          (blockOf S P ℓ u).1 ≤ v ∧ v < (blockOf S P ℓ u).2) := by
      intro ℓ hℓ u hu v hv
      obtain ⟨hcu, hu1, hu2, _⟩ := h_blocks_partition ℓ hℓ u hu
      obtain ⟨hcv, hv1, hv2, _⟩ := h_blocks_partition ℓ hℓ v hv
      constructor
      · intro heq
        unfold blockOf at hv1 hv2 ⊢
        rw [heq]
        exact ⟨hv1, hv2⟩
      · intro ⟨h1, h2⟩
        have hc := h_scale_contig ℓ hℓ
        symm
        exact h_contig_findIdx (S ℓ) 0 P (scaleBlocks S P ℓ) hc (blockIdx S P ℓ u) hcu v h1 h2

    have h_blocks_mono : ∀ ℓ ≤ L, ∀ u v, u ≤ v → v < P →
        blockIdx S P ℓ u ≤ blockIdx S P ℓ v := by
      intro ℓ hℓ u v huv hv
      have hu : u < P := lt_of_le_of_lt huv hv
      obtain ⟨hcu, hu1, hu2, _⟩ := h_blocks_partition ℓ hℓ u hu
      obtain ⟨hcv, hv1, hv2, _⟩ := h_blocks_partition ℓ hℓ v hv
      by_contra hgt
      have hlt : blockIdx S P ℓ v < blockIdx S P ℓ u := by omega
      have hsep := h_contig_sep (S ℓ) 0 P (scaleBlocks S P ℓ) (h_scale_contig ℓ hℓ)
        (blockIdx S P ℓ v) (blockIdx S P ℓ u) hlt hcu
      unfold blockOf at hu1 hv2
      omega

    have h_child_blocks : ∀ ℓ, 1 ≤ ℓ → ℓ ≤ L → ∀ Xi < (scaleBlocks S P (ℓ - 1)).length,
        let X := (scaleBlocks S P (ℓ - 1)).getD Xi (0, 0)
        let subs := splitBlock (S ℓ) X.1 X.2
        2 ≤ subs.length ∧
          (subs.getD 0 (0, 0)).1 = X.1 ∧
          (subs.getD (subs.length - 1) (0, 0)).2 = X.2 ∧
          (∀ c < subs.length,
            let sc := subs.getD c (0, 0)
            X.1 ≤ sc.1 ∧ sc.1 < sc.2 ∧ sc.2 ≤ X.2 ∧ S ℓ ≤ sc.2 - sc.1 ∧ sc.2 - sc.1 < 2 * S ℓ) ∧
          (∀ c, c + 1 < subs.length →
            (subs.getD c (0, 0)).2 = (subs.getD (c + 1) (0, 0)).1) ∧
          (∀ u < P, (blockIdx S P (ℓ - 1) u = Xi ↔ X.1 ≤ u ∧ u < X.2)) ∧
          (∀ u, X.1 ≤ u → u < X.2 →
            let c := subs.findIdx (fun b => decide (b.1 ≤ u ∧ u < b.2))
            c < subs.length ∧ subs.getD c (0, 0) = blockOf S P ℓ u) ∧
          (∀ u1, X.1 ≤ u1 → u1 < X.2 → ∀ u2, X.1 ≤ u2 → u2 < X.2 →
            (subs.findIdx (fun b => decide (b.1 ≤ u1 ∧ u1 < b.2)) =
              subs.findIdx (fun b => decide (b.1 ≤ u2 ∧ u2 < b.2)) ↔
                blockIdx S P ℓ u1 = blockIdx S P ℓ u2)) := by
      intro ℓ hℓ1 hℓL Xi hXi
      dsimp (config := { failIfUnchanged := false }) only
      set bs_prev := scaleBlocks S P (ℓ - 1)
      set X := bs_prev.getD Xi (0, 0)
      set subs := splitBlock (S ℓ) X.1 X.2
      have hc_prev := h_scale_contig (ℓ - 1) (by omega)
      have hX_bnd : 0 ≤ X.1 ∧ X.1 < X.2 ∧ X.2 ≤ P ∧
          S (ℓ - 1) ≤ X.2 - X.1 ∧ X.2 - X.1 < 2 * S (ℓ - 1) := hc_prev.2.2.2.1 Xi hXi
      have hstep : 2 * S ℓ ≤ S (ℓ - 1) := by
        have h := hS_step (ℓ - 1) (by omega)
        have hsub : ℓ - 1 + 1 = ℓ := by omega
        rw [hsub] at h
        exact h
      have hSℓ_pos : 1 ≤ S ℓ := by
        have := hS_pos ℓ hℓL
        omega
      obtain ⟨hsubs_ge2, hsubs_contig⟩ := h_splitBlock (S ℓ) X.1 X.2 hSℓ_pos hX_bnd.2.1 (by omega)
      have hX_mem : X ∈ bs_prev := by
        have hxeq : X = bs_prev[Xi] := h_getD bs_prev (0, 0) Xi hXi
        rw [hxeq]
        exact List.getElem_mem hXi
      have h6 : ∀ u < P, (blockIdx S P (ℓ - 1) u = Xi ↔ X.1 ≤ u ∧ u < X.2) := by
        intro u hu
        constructor
        · intro heq
          obtain ⟨_, hu1, hu2, _⟩ := h_blocks_partition (ℓ - 1) (by omega) u hu
          unfold blockOf at hu1 hu2
          rw [heq] at hu1 hu2
          exact ⟨hu1, hu2⟩
        · intro ⟨hu1, hu2⟩
          exact h_contig_findIdx (S (ℓ - 1)) 0 P bs_prev hc_prev Xi hXi u hu1 hu2
      have h7 : ∀ u, X.1 ≤ u → u < X.2 →
          let c := subs.findIdx (fun b => decide (b.1 ≤ u ∧ u < b.2))
          c < subs.length ∧ subs.getD c (0, 0) = blockOf S P ℓ u := by
        intro u hu1 hu2
        dsimp (config := { failIfUnchanged := false }) only
        obtain ⟨c, hc_lt, hcu1, hcu2⟩ := h_chain_cover subs hsubs_contig.1 hsubs_contig.2.2.2.2 u
          (by rw [hsubs_contig.2.1]; exact hu1) (by rw [hsubs_contig.2.2.1]; exact hu2)
        have hfidx := h_contig_findIdx (S ℓ) X.1 X.2 subs hsubs_contig c hc_lt u hcu1 hcu2
        rw [hfidx]
        refine ⟨hc_lt, ?_⟩
        set sc := subs.getD c (0, 0)
        have hsc_mem_subs : sc ∈ subs := by
          have hsceq : sc = subs[c] := h_getD subs (0, 0) c hc_lt
          rw [hsceq]
          exact List.getElem_mem hc_lt
        have hℓ_eq : scaleBlocks S P ℓ = bs_prev.flatMap (fun b => splitBlock (S ℓ) b.1 b.2) := by
          obtain ⟨k, rfl⟩ := Nat.exists_eq_add_of_le' hℓ1
          rfl
        have hsc_mem_ℓ : sc ∈ scaleBlocks S P ℓ := by
          rw [hℓ_eq, List.mem_flatMap]
          exact ⟨X, hX_mem, hsc_mem_subs⟩
        obtain ⟨idx, hidx, hsc_idx⟩ := List.getElem_of_mem hsc_mem_ℓ
        have hgetD_idx : (scaleBlocks S P ℓ).getD idx (0, 0) = sc := by
          rw [h_getD (scaleBlocks S P ℓ) (0, 0) idx hidx, hsc_idx]
        have hbidx_u : blockIdx S P ℓ u = idx := by
          apply h_contig_findIdx (S ℓ) 0 P (scaleBlocks S P ℓ) (h_scale_contig ℓ hℓL) idx hidx u
          · rw [hgetD_idx]; exact hcu1
          · rw [hgetD_idx]; exact hcu2
        unfold blockOf
        rw [hbidx_u, hgetD_idx]
      have h8 : ∀ u1, X.1 ≤ u1 → u1 < X.2 → ∀ u2, X.1 ≤ u2 → u2 < X.2 →
          (subs.findIdx (fun b => decide (b.1 ≤ u1 ∧ u1 < b.2)) =
            subs.findIdx (fun b => decide (b.1 ≤ u2 ∧ u2 < b.2)) ↔
              blockIdx S P ℓ u1 = blockIdx S P ℓ u2) := by
        intro u1 hu1_lo hu1_hi u2 hu2_lo hu2_hi
        have hu1_P : u1 < P := lt_of_lt_of_le hu1_hi hX_bnd.2.2.1
        have hu2_P : u2 < P := lt_of_lt_of_le hu2_hi hX_bnd.2.2.1
        obtain ⟨hc1_lt, hc1_eq⟩ := h7 u1 hu1_lo hu1_hi
        obtain ⟨hc2_lt, hc2_eq⟩ := h7 u2 hu2_lo hu2_hi
        rw [h_blocks_eq_iff ℓ hℓL u1 hu1_P u2 hu2_P, ← hc1_eq]
        constructor
        · intro heq
          rw [heq, hc2_eq]
          have hp2 := h_blocks_partition ℓ hℓL u2 hu2_P
          exact ⟨hp2.2.1, hp2.2.2.1⟩
        · intro ⟨h1, h2⟩
          symm
          exact h_contig_findIdx (S ℓ) X.1 X.2 subs hsubs_contig
            (subs.findIdx (fun b => decide (b.1 ≤ u1 ∧ u1 < b.2))) hc1_lt u2 h1 h2
      exact ⟨hsubs_ge2, hsubs_contig.2.1, hsubs_contig.2.2.1,
        hsubs_contig.2.2.2.1, hsubs_contig.2.2.2.2, h6, h7, h8⟩

    have h_sep_symm : ∀ u v, sepScale S P L u v = sepScale S P L v u := by
      intro u v
      unfold sepScale
      have hor : (P ≤ u ∨ P ≤ v) ↔ (P ≤ v ∨ P ≤ u) := Or.comm
      have hfun : (fun ℓ => blockIdx S P ℓ u != blockIdx S P ℓ v) =
          (fun ℓ => blockIdx S P ℓ v != blockIdx S P ℓ u) := by
        funext ℓ
        exact bne_comm
      by_cases h : P ≤ u ∨ P ≤ v
      · rw [if_pos h, if_pos (hor.mp h)]
      · rw [if_neg h, if_neg (mt hor.mpr h), hfun]

    have h_sep_top : ∀ u, sepScale S P L u P = 0 ∧ sepScale S P L P u = 0 := by
      intro u
      unfold sepScale
      simp

    have h_sep_range : ∀ u < P, ∀ v < P, u ≠ v →
        1 ≤ sepScale S P L u v ∧ sepScale S P L u v ≤ L + 1 := by
      intro u hu v hv _
      unfold sepScale
      rw [if_neg (by omega)]
      cases hfind : (List.Ico 1 (L + 1)).find? (fun ℓ => blockIdx S P ℓ u != blockIdx S P ℓ v) with
      | none =>
        dsimp (config := { failIfUnchanged := false }) only
        omega
      | some ℓ =>
        dsimp (config := { failIfUnchanged := false }) only
        have hmem := List.mem_of_find?_eq_some hfind
        simp at hmem
        omega

    have h_sep_self : ∀ u < P, sepScale S P L u u = L + 1 := by
      intro u hu
      unfold sepScale
      rw [if_neg (by omega)]
      have hnone : (List.Ico 1 (L + 1)).find? (fun ℓ => blockIdx S P ℓ u != blockIdx S P ℓ u) = none := by
        rw [List.find?_eq_none]
        intro ℓ _
        simp
      rw [hnone]

    have h_refine_step : ∀ ℓ, 1 ≤ ℓ → ℓ ≤ L → ∀ u < P, ∀ v < P,
        blockIdx S P ℓ u = blockIdx S P ℓ v →
        blockIdx S P (ℓ - 1) u = blockIdx S P (ℓ - 1) v := by
      intro ℓ hℓ1 hℓL u hu v hv heq
      set Xi := blockIdx S P (ℓ - 1) u
      obtain ⟨hXi_lt, hX_u1, hX_u2, _⟩ := h_blocks_partition (ℓ - 1) (by omega) u hu
      obtain ⟨_, _, _, hsubs_bnd, _, h6, h7, _⟩ := h_child_blocks ℓ hℓ1 hℓL Xi hXi_lt
      unfold blockOf at hX_u1 hX_u2
      obtain ⟨hc_lt, hc_eq⟩ := h7 u hX_u1 hX_u2
      have hsc_bnd := hsubs_bnd _ hc_lt
      have hv_in : (blockOf S P ℓ u).1 ≤ v ∧ v < (blockOf S P ℓ u).2 :=
        (h_blocks_eq_iff ℓ hℓL u hu v hv).mp heq
      rw [← hc_eq] at hv_in
      have hv_X : ((scaleBlocks S P (ℓ - 1)).getD Xi (0, 0)).1 ≤ v ∧
          v < ((scaleBlocks S P (ℓ - 1)).getD Xi (0, 0)).2 := ⟨by omega, by omega⟩
      symm
      exact (h6 v hv).mpr hv_X

    have h_refine_le : ∀ k m, m + k ≤ L → ∀ u < P, ∀ v < P,
        blockIdx S P (m + k) u = blockIdx S P (m + k) v →
        blockIdx S P m u = blockIdx S P m v := by
      intro k
      induction k with
      | zero => intro m _ _ _ _ _ h; simpa using h
      | succ k ih =>
        intro m hmk u hu v hv h
        have h1 := h_refine_step (m + k + 1) (by omega) hmk u hu v hv h
        exact ih m (by omega) u hu v hv (by simpa using h1)

    have h_ico_pairwise : ∀ a b : ℕ, List.Pairwise (· < ·) (List.Ico a b) := by
      intro a b
      set d := b - a with hd
      have h_aux : ∀ k a b, b - a ≤ k → List.Pairwise (· < ·) (List.Ico a b) := by
        intro k
        induction k with
        | zero =>
          intro a b h
          have hab : b ≤ a := by omega
          have hempty : List.Ico a b = [] := by
            rw [List.eq_nil_iff_forall_not_mem]
            intro x hx
            simp at hx
            omega
          rw [hempty]
          exact List.Pairwise.nil
        | succ k ih =>
          intro a b h
          by_cases hlt : a < b
          · rw [List.Ico.eq_cons hlt]
            refine List.Pairwise.cons ?_ (ih (a + 1) b (by omega))
            intro x hx
            simp at hx
            omega
          · have hempty : List.Ico a b = [] := by
              rw [List.eq_nil_iff_forall_not_mem]
              intro x hx
              simp at hx
              omega
            rw [hempty]
            exact List.Pairwise.nil
      exact h_aux d a b le_rfl

    have h_sep_gt_iff : ∀ m ≤ L, ∀ u < P, ∀ v < P,
        (m < sepScale S P L u v ↔ blockIdx S P m u = blockIdx S P m v) := by
      intro m hm u hu v hv
      by_cases hm0 : m = 0
      · subst hm0
        have h0_u : blockIdx S P 0 u = 0 := by
          have := (h_blocks_partition 0 (by omega) u hu).1
          simp [scaleBlocks] at this
          omega
        have h0_v : blockIdx S P 0 v = 0 := by
          have := (h_blocks_partition 0 (by omega) v hv).1
          simp [scaleBlocks] at this
          omega
        rw [h0_u, h0_v]
        simp only [iff_true]
        unfold sepScale
        rw [if_neg (by omega)]
        cases hfind : (List.Ico 1 (L + 1)).find? (fun ℓ => blockIdx S P ℓ u != blockIdx S P ℓ v) with
        | none =>
          dsimp (config := { failIfUnchanged := false }) only
          omega
        | some ℓ =>
          dsimp (config := { failIfUnchanged := false }) only
          have hmem := List.mem_of_find?_eq_some hfind
          simp at hmem
          omega
      · have hm1 : 1 ≤ m := by omega
        unfold sepScale
        rw [if_neg (by omega)]
        cases hfind : (List.Ico 1 (L + 1)).find? (fun ℓ => blockIdx S P ℓ u != blockIdx S P ℓ v) with
        | none =>
          dsimp (config := { failIfUnchanged := false }) only
          have h_all := List.find?_eq_none.mp hfind m (by simp; omega)
          simp at h_all
          exact ⟨fun _ => h_all, fun _ => by omega⟩
        | some ℓ0 =>
          dsimp (config := { failIfUnchanged := false }) only
          have hmem0 := List.mem_of_find?_eq_some hfind
          simp only [List.Ico.mem] at hmem0
          obtain ⟨hp_ℓ0, as, bs, happ, has⟩ := List.find?_eq_some_iff_append.mp hfind
          simp only [bne_iff_ne, ne_eq] at hp_ℓ0
          have hp_lt : ∀ k, 1 ≤ k → k < ℓ0 → blockIdx S P k u = blockIdx S P k v := by
            intro k hk1 hk_lt
            have hk_mem : k ∈ List.Ico 1 (L + 1) := by simp; omega
            rw [happ, List.mem_append, List.mem_cons] at hk_mem
            rcases hk_mem with h_in_as | h_eq | h_in_bs
            · have hnot := has k h_in_as
              simpa using hnot
            · omega
            · have hpw := h_ico_pairwise 1 (L + 1)
              rw [happ, List.pairwise_append] at hpw
              have hrel := (List.pairwise_cons.mp hpw.2.1).1 k h_in_bs
              omega
          constructor
          · intro hm_lt
            exact hp_lt m hm1 hm_lt
          · intro heq_m
            by_contra hle
            have hℓ0_le_m : ℓ0 ≤ m := by omega
            have heq_ℓ0 := h_refine_le (m - ℓ0) ℓ0 (by omega) u hu v hv (by
              have : ℓ0 + (m - ℓ0) = m := by omega
              rw [this]
              exact heq_m)
            exact hp_ℓ0 heq_ℓ0

    have h_sep_ultrametric : ∀ a b c, a ≤ b → b ≤ c → c < P →
        sepScale S P L a c = min (sepScale S P L a b) (sepScale S P L b c) := by
      intro a b c hab hbc hc
      have ha : a < P := by omega
      have hb : b < P := by omega
      have h_range_any : ∀ x < P, ∀ y < P, 1 ≤ sepScale S P L x y ∧ sepScale S P L x y ≤ L + 1 := by
        intro x hx y hy
        by_cases hxy : x = y
        · subst hxy
          rw [h_sep_self x hx]
          omega
        · exact h_sep_range x hx y hy hxy
      have h_ac := h_range_any a ha c hc
      have h_ab := h_range_any a ha b hb
      have h_bc := h_range_any b hb c hc
      set lhs := sepScale S P L a c
      set rhs := min (sepScale S P L a b) (sepScale S P L b c)
      have hrhs : 1 ≤ rhs ∧ rhs ≤ L + 1 := ⟨by omega, by omega⟩
      have h_iff : ∀ m ≤ L, (m < lhs ↔ m < rhs) := by
        intro m hm
        rw [lt_min_iff, h_sep_gt_iff m hm a ha c hc,
            h_sep_gt_iff m hm a ha b hb, h_sep_gt_iff m hm b hb c hc]
        have hm1 := h_blocks_mono m hm a b hab hb
        have hm2 := h_blocks_mono m hm b c hbc hc
        omega
      by_contra hne
      rcases lt_trichotomy lhs rhs with hlt | heq | hgt
      · have := (h_iff lhs (by omega)).mpr hlt
        omega
      · exact hne heq
      · have := (h_iff rhs (by omega)).mp hgt
        omega

    exact {
      blocks_sum := h_blocks_sum
      blocks_bounds := h_blocks_bounds
      blocks_partition := h_blocks_partition
      blocks_eq_iff := h_blocks_eq_iff
      blocks_mono := h_blocks_mono
      child_blocks := h_child_blocks
      sep_symm := h_sep_symm
      sep_top := h_sep_top
      sep_range := h_sep_range
      sep_self := h_sep_self
      sep_gt_iff := h_sep_gt_iff
      sep_ultrametric := h_sep_ultrametric
    }




  have hbuckets :
      (jumps kops).length =
        (B_fin_pre S P L kops).card + (B_fin_exit S P L kops).card +
          (B_fin_act S P L kops).card + (B_1 S P L kops).card +
          (B_2 S P L kops).card + (B_3_intra S P L kops).card +
          (B_3_post S P L kops).card + (B_3_act S P L kops).card ∧
      (B_fin_exit S P L kops).card ≤ P ∧
      (B_fin_act S P L kops).card ≤
        ((scaleBlocks S P L).map (fun b =>
          ((Finset.range (jumps kops).length).filter (fun id =>
            (match (jumps kops)[id]? with
            | none => false
            | some e => decide (b.1 ≤ e.s ∧ e.z < b.2)) = true)).card)).sum := by
    have h_forall_and : ∀ {p q : ℕ → Prop} {T : _root_.BinaryTree ℕ},
        _root_.SplayDeque.Direct.ForallTree p T → _root_.SplayDeque.Direct.ForallTree q T →
        _root_.SplayDeque.Direct.ForallTree (fun x => p x ∧ q x) T := by
      intro p q T hp hq
      induction hp with
      | left => exact .left
      | node l key r hl hk hr ihl ihr =>
        cases hq with
        | node _ _ _ hl' hk' hr' =>
          exact .node l key r (ihl hl') ⟨hk, hk'⟩ (ihr hr')

    have h_forall_imp : ∀ {p q : ℕ → Prop} {T : _root_.BinaryTree ℕ},
        (∀ x, p x → q x) → _root_.SplayDeque.Direct.ForallTree p T → _root_.SplayDeque.Direct.ForallTree q T := by
      intro p q T hpq hT
      induction hT with
      | left => exact .left
      | node l key r _ hk _ ihl ihr => exact .node l key r ihl (hpq key hk) ihr

    have h_bst_ls_aux : ∀ (T : _root_.BinaryTree ℕ) (acc : List ℕ),
        _root_.BinaryTree.IsBST T →
        List.Pairwise (· < ·) acc →
        _root_.SplayDeque.Direct.ForallTree (fun x => ∀ a ∈ acc, x < a) T →
        List.Pairwise (· < ·) (leftSpineBottomUpAux T acc) := by
      intro T
      induction T with
      | nil =>
        intro acc _ hpw _
        exact hpw
      | node k l r ihl _ =>
        intro acc hbst hpw hfa
        cases hbst using isBSTCases with
        | node _ _ _ hl_lt _ hl_bst _ =>
          cases hfa with
          | node _ _ _ hl_fa hk_acc _ =>
            simp only [leftSpineBottomUpAux]
            apply ihl (k :: acc) hl_bst (List.Pairwise.cons hk_acc hpw)
            refine h_forall_imp ?_ (h_forall_and hl_lt hl_fa)
            intro x ⟨hxk, hxacc⟩ a ha
            rcases List.mem_cons.mp ha with rfl | ha'
            · exact hxk
            · exact hxacc a ha'

    have h_bst_ls : ∀ T : _root_.BinaryTree ℕ,
        _root_.BinaryTree.IsBST T → List.Pairwise (· < ·) (leftSpineBottomUpNat T) := by
      intro T hbst
      refine h_bst_ls_aux T [] hbst List.Pairwise.nil ?_
      have h_true : ∀ U : _root_.BinaryTree ℕ, _root_.SplayDeque.Direct.ForallTree (fun x => ∀ a ∈ ([] : List ℕ), x < a) U := by
        intro U
        induction U with
        | nil => exact .left
        | node k l r ihl ihr => exact .node l k r ihl (by simp) ihr
      exact h_true T

    have h_part8 : (jumps kops).length =
        (B_fin_pre S P L kops).card + (B_fin_exit S P L kops).card +
          (B_fin_act S P L kops).card + (B_1 S P L kops).card +
          (B_2 S P L kops).card + (B_3_intra S P L kops).card +
          (B_3_post S P L kops).card + (B_3_act S P L kops).card := by
      unfold B_fin_pre B_fin_exit B_fin_act B_1 B_2 B_3_intra B_3_post B_3_act
      simp only [Finset.card_filter]
      have h_sum_add : ∀ (s : Finset ℕ) (f1 f2 f3 f4 f5 f6 f7 f8 : ℕ → ℕ),
          (∑ i ∈ s, f1 i) + (∑ i ∈ s, f2 i) + (∑ i ∈ s, f3 i) + (∑ i ∈ s, f4 i) +
            (∑ i ∈ s, f5 i) + (∑ i ∈ s, f6 i) + (∑ i ∈ s, f7 i) + (∑ i ∈ s, f8 i) =
            ∑ i ∈ s, (f1 i + f2 i + f3 i + f4 i + f5 i + f6 i + f7 i + f8 i) := by
        intro s f1 f2 f3 f4 f5 f6 f7 f8
        simp only [Finset.sum_add_distrib]
      rw [h_sum_add]
      have h_each_one : ∀ id ∈ Finset.range (jumps kops).length,
          (if isBFinPre S P L kops id = true then 1 else 0) +
          (if isBFinExit S P L kops id = true then 1 else 0) +
          (if isBFinAct S P L kops id = true then 1 else 0) +
          (if isB1 S P L kops id = true then 1 else 0) +
          (if isB2 S P L kops id = true then 1 else 0) +
          (if isB3Intra S P L kops id = true then 1 else 0) +
          (if isB3Post S P L kops id = true then 1 else 0) +
          (if isB3Act S P L kops id = true then 1 else 0) = 1 := by
        intro id hid
        rw [Finset.mem_range] at hid
        obtain ⟨_, _, _, _, hsx, hxy, hyz, hzP, _, _⟩ := hjump.jump_anatomies id hid
        set e := (jumps kops)[id]
        have hget : (jumps kops)[id]? = some e := List.getElem?_eq_getElem hid
        have hex_lt : e.x < P := by omega
        have hey_lt : e.y < P := by omega
        have hex_ne : e.x ≠ e.y := by omega
        have hsep_rng := hpart.sep_range e.x hex_lt e.y hey_lt hex_ne
        unfold isBFinPre isBFinExit isBFinAct isB1 isB2 isB3Intra isB3Post isB3Act
        rw [hget]
        dsimp (config := { failIfUnchanged := false }) only
        simp only [decide_eq_true_eq]
        split_ifs <;> omega
      rw [Finset.sum_congr rfl h_each_one]
      simp

    have h_fin_exit : (B_fin_exit S P L kops).card ≤ P := by
      let f : ℕ → ℕ := fun id =>
        match (jumps kops)[id]? with
        | none => 0
        | some e => e.s
      have h_maps : Set.MapsTo f ↑(B_fin_exit S P L kops) ↑(Finset.range P) := by
        intro id hid
        simp only [Finset.mem_coe, B_fin_exit, Finset.mem_filter, Finset.mem_range] at hid
        obtain ⟨_, _, _, _, hsx, hxy, hyz, hzP, _, _⟩ := hjump.jump_anatomies id hid.1
        simp only [Finset.mem_coe, Finset.mem_range, f, List.getElem?_eq_getElem hid.1]
        omega
      have h_lt_absurd : ∀ id1 id2 : ℕ,
          id1 ∈ B_fin_exit S P L kops → id2 ∈ B_fin_exit S P L kops →
          id1 < id2 → f id1 = f id2 → False := by
        intro id1 id2 hm1 hm2 hlt hfeq
        simp only [B_fin_exit, Finset.mem_filter, Finset.mem_range, isBFinExit] at hm1 hm2
        obtain ⟨hid1, hb1⟩ := hm1
        obtain ⟨hid2, hb2⟩ := hm2
        rw [List.getElem?_eq_getElem hid1] at hb1
        rw [List.getElem?_eq_getElem hid2] at hb2
        simp only [decide_eq_true_eq] at hb1 hb2
        obtain ⟨_, hstep1_lt, hk1_opt, _, hsx1, hxy1, hyz1, hzP1, ⟨_, _, _, _, hz1_opt⟩, _⟩ :=
          hjump.jump_anatomies id1 hid1
        obtain ⟨_, hstep2_lt, hk2_opt, _, hsx2, hxy2, hyz2, hzP2, ⟨_, _, _, hy2_opt, _⟩, _⟩ :=
          hjump.jump_anatomies id2 hid2
        set e1 := (jumps kops)[id1]
        set e2 := (jumps kops)[id2]
        have hs_eq : e1.s = e2.s := by
          simpa [f, List.getElem?_eq_getElem hid1, List.getElem?_eq_getElem hid2] using hfeq
        have hk1 : kops[e1.step] = .pop e1.s := by
          rw [List.getElem?_eq_getElem hstep1_lt] at hk1_opt
          exact Option.some.inj hk1_opt
        have hk2 : kops[e2.step] = .pop e2.s := by
          rw [List.getElem?_eq_getElem hstep2_lt] at hk2_opt
          exact Option.some.inj hk2_opt
        have hsv1 := hkvalid.step_valid e1.step hstep1_lt
        rw [hk1] at hsv1
        have hsv2 := hkvalid.step_valid e2.step hstep2_lt
        rw [hk2] at hsv2
        have hstep_eq : e1.step = e2.step := by
          rw [← hsv1.2.1, ← hsv2.2.1, hs_eq]
        have hj_lt : e1.j < e2.j := by
          rcases hjump.jump_order id1 hid1 id2 hid2 hlt with hst | ⟨_, hj⟩
          · change e1.step < e2.step at hst
            omega
          · exact hj
        set ls := leftSpineBottomUpNat (keyedState kops e1.step)
        have hls_pw : List.Pairwise (· < ·) ls :=
          h_bst_ls (keyedState kops e1.step) (hkvalid.isBST_state e1.step (by omega))
        have hz1_ls : ls[2 * e1.j + 3]? = some e1.z := hz1_opt
        have hy2_ls : ls[2 * e2.j + 2]? = some e2.y := by
          change (leftSpineBottomUpNat (keyedState kops e2.step))[2 * e2.j + 2]? = some e2.y at hy2_opt
          simpa [ls, hstep_eq] using hy2_opt
        obtain ⟨hz1_lt, hz1_eq⟩ := List.getElem?_eq_some_iff.mp hz1_ls
        obtain ⟨hy2_lt, hy2_eq⟩ := List.getElem?_eq_some_iff.mp hy2_ls
        have hz1_lt_y2 : e1.z < e2.y := by
          rw [← hz1_eq, ← hy2_eq]
          exact (List.pairwise_iff_getElem.mp hls_pw) (2 * e1.j + 3) (2 * e2.j + 2)
            hz1_lt hy2_lt (by omega)
        have he1x_P : e1.x < P := by omega
        have he2x_P : e2.x < P := by omega
        have he2y_P : e2.y < P := by omega
        have hs_P : e1.s < P := by omega
        have hp1 := hpart.blocks_partition L le_rfl e1.x he1x_P
        have hp2 := hpart.blocks_partition L le_rfl e2.x he2x_P
        have hbidx1 : blockIdx S P L e1.x = blockIdx S P L e1.s :=
          (hpart.blocks_eq_iff L le_rfl e1.x he1x_P e1.s hs_P).mpr ⟨hb1.2.1, by omega⟩
        have hbidx2 : blockIdx S P L e2.x = blockIdx S P L e1.s :=
          (hpart.blocks_eq_iff L le_rfl e2.x he2x_P e1.s hs_P).mpr
            ⟨by rw [hs_eq]; exact hb2.2.1, by omega⟩
        have hQ_eq : blockOf S P L e1.x = blockOf S P L e2.x := by
          unfold blockOf
          rw [hbidx1, hbidx2]
        have hbidx2_xy : blockIdx S P L e2.x = blockIdx S P L e2.y :=
          (hpart.sep_gt_iff L le_rfl e2.x he2x_P e2.y he2y_P).mp (by omega)
        have hy2_in_Q2 : (blockOf S P L e2.x).1 ≤ e2.y ∧ e2.y < (blockOf S P L e2.x).2 :=
          (hpart.blocks_eq_iff L le_rfl e2.x he2x_P e2.y he2y_P).mp hbidx2_xy
        rw [← hQ_eq] at hy2_in_Q2
        have hQ_le_z1 : (blockOf S P L e1.x).2 ≤ e1.z := hb1.2.2
        omega
      have h_inj : Set.InjOn f ↑(B_fin_exit S P L kops) := by
        intro id1 hm1 id2 hm2 hfeq
        by_contra hne
        rcases lt_trichotomy id1 id2 with hlt | heq | hgt
        · exact h_lt_absurd id1 id2 hm1 hm2 hlt hfeq
        · exact hne heq
        · exact h_lt_absurd id2 id1 hm2 hm1 hgt hfeq.symm
      have hcard := Finset.card_le_card_of_injOn f h_maps h_inj
      simpa using hcard

    have h_fin_act : (B_fin_act S P L kops).card ≤
        ((scaleBlocks S P L).map (fun b =>
          ((Finset.range (jumps kops).length).filter (fun id =>
            (match (jumps kops)[id]? with
            | none => false
            | some e => decide (b.1 ≤ e.s ∧ e.z < b.2)) = true)).card)).sum := by
      let F : ℕ × ℕ → Finset ℕ := fun b =>
        (Finset.range (jumps kops).length).filter (fun id =>
          (match (jumps kops)[id]? with
          | none => false
          | some e => decide (b.1 ≤ e.s ∧ e.z < b.2)) = true)
      set bs := scaleBlocks S P L
      have h_sub : B_fin_act S P L kops ⊆
          (Finset.range bs.length).biUnion (fun i => F (bs.getD i (0, 0))) := by
        intro id hid
        simp only [B_fin_act, Finset.mem_filter, Finset.mem_range, isBFinAct] at hid
        obtain ⟨hid_lt, hact⟩ := hid
        rw [List.getElem?_eq_getElem hid_lt] at hact
        simp only [decide_eq_true_eq] at hact
        obtain ⟨_, _, _, _, hsx, hxy, hyz, hzP, _, _⟩ := hjump.jump_anatomies id hid_lt
        set e := (jumps kops)[id]
        have hex_P : e.x < P := by omega
        have hp := hpart.blocks_partition L le_rfl e.x hex_P
        rw [Finset.mem_biUnion]
        refine ⟨blockIdx S P L e.x, Finset.mem_range.mpr hp.1, ?_⟩
        have hbof : bs.getD (blockIdx S P L e.x) (0, 0) = blockOf S P L e.x := rfl
        rw [hbof]
        simp only [F, Finset.mem_filter, Finset.mem_range, List.getElem?_eq_getElem hid_lt,
          decide_eq_true_eq]
        exact ⟨hid_lt, hact.2.1, hact.2.2⟩
      have h1 := Finset.card_le_card h_sub
      have h2 : ((Finset.range bs.length).biUnion (fun i => F (bs.getD i (0, 0)))).card ≤
          ∑ i ∈ Finset.range bs.length, (F (bs.getD i (0, 0))).card := Finset.card_biUnion_le
      have h_range_sum : ∀ xs : List (ℕ × ℕ),
          (∑ i ∈ Finset.range xs.length, (F (xs.getD i (0, 0))).card) =
            (xs.map (fun b => (F b).card)).sum := by
        intro xs
        induction xs with
        | nil => simp
        | cons x rest ih =>
          rw [List.length_cons, Finset.sum_range_succ']
          simp only [List.getD_cons_zero, List.getD_cons_succ, List.map_cons, List.sum_cons, ih]
          omega
      rw [h_range_sum bs] at h2
      exact le_trans h1 h2

    exact ⟨h_part8, h_fin_exit, h_fin_act⟩




  have hpost : (B_3_post S P L kops).card ≤ countKeyedRslr kops := by
    have h_forall_and : ∀ {p q : ℕ → Prop} {T : _root_.BinaryTree ℕ},
        _root_.SplayDeque.Direct.ForallTree p T → _root_.SplayDeque.Direct.ForallTree q T →
        _root_.SplayDeque.Direct.ForallTree (fun x => p x ∧ q x) T := by
      intro p q T hp hq
      induction hp with
      | left => exact .left
      | node l key r _ hk _ ihl ihr =>
        cases hq with
        | node _ _ _ hl' hk' hr' => exact .node l key r (ihl hl') ⟨hk, hk'⟩ (ihr hr')

    have h_forall_imp : ∀ {p q : ℕ → Prop} {T : _root_.BinaryTree ℕ},
        (∀ x, p x → q x) → _root_.SplayDeque.Direct.ForallTree p T → _root_.SplayDeque.Direct.ForallTree q T := by
      intro p q T hpq hT
      induction hT with
      | left => exact .left
      | node l key r _ hk _ ihl ihr => exact .node l key r ihl (hpq key hk) ihr

    have h_bst_ls_aux : ∀ (T : _root_.BinaryTree ℕ) (acc : List ℕ),
        _root_.BinaryTree.IsBST T →
        List.Pairwise (· < ·) acc →
        _root_.SplayDeque.Direct.ForallTree (fun x => ∀ a ∈ acc, x < a) T →
        List.Pairwise (· < ·) (leftSpineBottomUpAux T acc) := by
      intro T
      induction T with
      | nil => intro acc _ hpw _; exact hpw
      | node k l r ihl _ =>
        intro acc hbst hpw hfa
        cases hbst using isBSTCases with
        | node _ _ _ hl_lt _ hl_bst _ =>
          cases hfa with
          | node _ _ _ hl_fa hk_acc _ =>
            simp only [leftSpineBottomUpAux]
            apply ihl (k :: acc) hl_bst (List.Pairwise.cons hk_acc hpw)
            refine h_forall_imp ?_ (h_forall_and hl_lt hl_fa)
            intro x ⟨hxk, hxacc⟩ a ha
            rcases List.mem_cons.mp ha with rfl | ha'
            · exact hxk
            · exact hxacc a ha'

    have h_bst_ls : ∀ T : _root_.BinaryTree ℕ,
        _root_.BinaryTree.IsBST T → List.Pairwise (· < ·) (leftSpineBottomUpNat T) := by
      intro T hbst
      refine h_bst_ls_aux T [] hbst List.Pairwise.nil ?_
      have h_true : ∀ U : _root_.BinaryTree ℕ, _root_.SplayDeque.Direct.ForallTree (fun x => ∀ a ∈ ([] : List ℕ), x < a) U := by
        intro U; induction U with
        | nil => exact .left
        | node k l r ihl ihr => exact .node l k r ihl (by simp) ihr
      exact h_true T

    have h_exec_append : ∀ (H : _root_.BinaryTree ℕ) (xs ys : List KeyedCoreOp),
        execKeyedList H (xs ++ ys) = execKeyedList (execKeyedList H xs) ys := by
      intro H xs ys
      induction xs generalizing H with
      | nil => rfl
      | cons op rest ih => exact ih (execKeyedOp H op)

    have h_take_succ : ∀ (xs : List KeyedCoreOp) (t : ℕ) (ht : t < xs.length),
        xs.take (t + 1) = xs.take t ++ [xs[t]] := by
      intro xs
      induction xs with
      | nil => intro t ht; simp at ht
      | cons x rest ih =>
        intro t ht
        rcases t with _ | t
        · rfl
        · simp only [List.take_succ_cons, List.cons_append, List.getElem_cons_succ]
          rw [ih t (by simp at ht; omega)]

    have h_state_step : ∀ t (ht : t < kops.length),
        keyedState kops (t + 1) = execKeyedOp (keyedState kops t) kops[t] := by
      intro t ht
      unfold keyedState
      rw [h_take_succ kops t ht, h_exec_append]
      rfl

    have h_popIdx_step : ∀ (xs : List KeyedCoreOp) (t : ℕ),
        (xs.take t).countP isKeyedPop ≤ (xs.take (t + 1)).countP isKeyedPop := by
      intro xs
      induction xs with
      | nil => intro t; simp
      | cons x rest ih =>
        intro t
        rcases t with _ | t
        · simp
        · simp only [List.take_succ_cons, List.countP_cons]
          have h := ih t
          omega

    have h_popIdx_mono : ∀ t1 t2 : ℕ, t1 ≤ t2 → popIdx kops t1 ≤ popIdx kops t2 := by
      have h_aux : ∀ (d t1 : ℕ), popIdx kops t1 ≤ popIdx kops (t1 + d) := by
        intro d
        induction d with
        | zero => intro t1; simp
        | succ d ih =>
          intro t1
          exact le_trans (ih t1) (by simpa [popIdx, Nat.add_assoc] using h_popIdx_step kops (t1 + d))
      intro t1 t2 hle
      have := h_aux (t2 - t1) t1
      rwa [Nat.add_sub_of_le hle] at this

    have h_hasKey_iff : ∀ (lo hi : ℕ) (T : _root_.BinaryTree ℕ),
        psspHasKeyIn lo hi T = true ↔ ∃ v ∈ inorderNat T, lo ≤ v ∧ v < hi := by
      intro lo hi T
      induction T with
      | nil => simp [psspHasKeyIn, inorderNat]
      | node k l r ihl ihr =>
        simp only [psspHasKeyIn, inorderNat, Bool.or_eq_true, decide_eq_true_eq, ihl, ihr,
          List.mem_append, List.mem_singleton]
        constructor
        · rintro ((hk | ⟨v, hv, hvb⟩) | ⟨v, hv, hvb⟩)
          · exact ⟨k, Or.inl (Or.inr rfl), hk⟩
          · exact ⟨v, Or.inl (Or.inl hv), hvb⟩
          · exact ⟨v, Or.inr hv, hvb⟩
        · rintro ⟨v, (hv | rfl) | hv, hvb⟩
          · exact Or.inl (Or.inr ⟨v, hv, hvb⟩)
          · exact Or.inl (Or.inl hvb)
          · exact Or.inr ⟨v, hv, hvb⟩

    have h_ancDesc_imp_hasKey : ∀ (lo_p hi_p lo_q hi_q : ℕ) (T : _root_.BinaryTree ℕ),
        psspHasAncDesc lo_p hi_p lo_q hi_q T = true →
        psspHasKeyIn lo_p hi_p T = true := by
      intro lo_p hi_p lo_q hi_q T
      induction T with
      | nil => simp [psspHasAncDesc]
      | node k l r ihl ihr =>
        simp only [psspHasAncDesc, psspHasKeyIn, Bool.or_eq_true, Bool.and_eq_true]
        rintro ((⟨_, hlr⟩ | hl) | hr)
        · rcases hlr with hl | hr
          · exact Or.inl (Or.inr hl)
          · exact Or.inr hr
        · exact Or.inl (Or.inr (ihl hl))
        · exact Or.inr (ihr hr)

    have h_forall_no_key : ∀ (lo hi : ℕ) (T : _root_.BinaryTree ℕ),
        _root_.SplayDeque.Direct.ForallTree (fun v => v < lo ∨ hi ≤ v) T →
        psspHasKeyIn lo hi T = false := by
      intro lo hi T hfa
      induction hfa with
      | left => rfl
      | node l k r _ hk _ ihl ihr =>
        have hk_f : decide (lo ≤ k ∧ k < hi) = false := by
          rw [decide_eq_false_iff_not]; omega
        simp [psspHasKeyIn, hk_f, ihl, ihr]

    have h_forall_no_ancDesc : ∀ (lo_p hi_p lo_q hi_q : ℕ) (T : _root_.BinaryTree ℕ),
        _root_.SplayDeque.Direct.ForallTree (fun v => v < lo_q ∨ hi_q ≤ v) T →
        psspHasAncDesc lo_p hi_p lo_q hi_q T = false := by
      intro lo_p hi_p lo_q hi_q T hfa
      induction hfa with
      | left => rfl
      | node l k r _ hk _ ihl ihr =>
        have hk_f : decide (lo_q ≤ k ∧ k < hi_q) = false := by
          rw [decide_eq_false_iff_not]; omega
        simp [psspHasAncDesc, hk_f, ihl, ihr]

    have h_hasKey_rotL : ∀ (lo hi d : ℕ) (T : _root_.BinaryTree ℕ),
        psspHasKeyIn lo hi (rotateLeftAtRightDepthNat T d) = psspHasKeyIn lo hi T := by
      intro lo hi d
      induction d with
      | zero =>
        intro T
        rcases T with _ | ⟨x, a, _ | ⟨y, b, c⟩⟩
        · rfl
        · rfl
        · simp only [rotateLeftAtRightDepthNat, _root_.BinaryTree.rotateLeft, psspHasKeyIn]
          cases decide (lo ≤ x ∧ x < hi) <;> cases decide (lo ≤ y ∧ y < hi) <;>
            cases psspHasKeyIn lo hi a <;> cases psspHasKeyIn lo hi b <;>
            cases psspHasKeyIn lo hi c <;> rfl
      | succ d ih =>
        intro T
        rcases T with _ | ⟨k, l, r⟩
        · rfl
        · simp only [rotateLeftAtRightDepthNat, psspHasKeyIn, ih r]

    have h_ancDesc_rotL_gain : ∀ (lo_p hi_p lo_q hi_q d : ℕ) (T : _root_.BinaryTree ℕ),
        psspHasAncDesc lo_p hi_p lo_q hi_q (rotateLeftAtRightDepthNat T d) = true →
        psspHasAncDesc lo_p hi_p lo_q hi_q T = false →
        let y := (rightSpineTopDownNat T).getD (d + 1) 0
        y ∈ inorderNat T ∧ lo_q ≤ y ∧ y < hi_q ∧ psspHasKeyIn lo_p hi_p T = true := by
      intro lo_p hi_p lo_q hi_q d
      induction d with
      | zero =>
        intro T h1 h2
        rcases T with _ | ⟨x, a, _ | ⟨y, b, c⟩⟩
        · simp [rotateLeftAtRightDepthNat, _root_.BinaryTree.rotateLeft, psspHasAncDesc] at h1
        · simp [rotateLeftAtRightDepthNat, _root_.BinaryTree.rotateLeft] at h1
          rw [h1] at h2; cases h2
        · dsimp (config := { failIfUnchanged := false }) only [rotateLeftAtRightDepthNat, _root_.BinaryTree.rotateLeft] at h1
          have hy_mem : (rightSpineTopDownNat (.node x a (.node y b c))).getD 1 0 ∈
              inorderNat (.node x a (.node y b c)) := by
            simp [rightSpineTopDownNat, inorderNat]
          have hy_eq : (rightSpineTopDownNat (.node x a (.node y b c))).getD 1 0 = y := rfl
          rw [hy_eq] at hy_mem ⊢
          simp only [psspHasAncDesc, psspHasKeyIn, Bool.or_eq_false_iff] at h2
          obtain ⟨⟨hroot_x, ha_f⟩, ⟨hroot_y, hb_f⟩, hc_f⟩ := h2
          have hx_sub_f : (decide (lo_q ≤ x ∧ x < hi_q) &&
              (psspHasKeyIn lo_p hi_p a || psspHasKeyIn lo_p hi_p b)) = false := by
            revert hroot_x
            cases decide (lo_q ≤ x ∧ x < hi_q) <;> cases psspHasKeyIn lo_p hi_p a <;>
              cases psspHasKeyIn lo_p hi_p b <;> simp
          have hab_f : psspHasAncDesc lo_p hi_p lo_q hi_q (.node x a b) = false := by
            unfold psspHasAncDesc
            rw [hx_sub_f, ha_f, hb_f]
            rfl
          simp only [rotateLeftAtRightDepthNat,
            _root_.BinaryTree.rotateLeft] at h1
          unfold psspHasAncDesc at h1
          rw [hab_f, hc_f] at h1
          simp only [Bool.or_false, Bool.and_eq_true, decide_eq_true_eq] at h1
          obtain ⟨⟨hy_lo, hy_hi⟩, hp_key⟩ := h1
          have hp_T : psspHasKeyIn lo_p hi_p (.node x a (.node y b c)) = true := by
            revert hp_key
            simp only [psspHasKeyIn]
            cases decide (lo_p ≤ y ∧ y < hi_p) <;> cases decide (lo_p ≤ x ∧ x < hi_p) <;>
              cases psspHasKeyIn lo_p hi_p a <;> cases psspHasKeyIn lo_p hi_p b <;>
              cases psspHasKeyIn lo_p hi_p c <;> simp
          exact ⟨hy_mem, hy_lo, hy_hi, hp_T⟩
      | succ d ih =>
        intro T h1 h2
        rcases T with _ | ⟨k, l, r⟩
        · simp [rotateLeftAtRightDepthNat, psspHasAncDesc] at h1
        · simp only [rotateLeftAtRightDepthNat, psspHasAncDesc, h_hasKey_rotL lo_p hi_p d r] at h1
          simp only [psspHasAncDesc, Bool.or_eq_false_iff] at h2
          obtain ⟨⟨hroot_k, hl_f⟩, hr_f⟩ := h2
          rw [hroot_k, hl_f] at h1
          simp only [Bool.false_or] at h1
          obtain ⟨hy_mem, hy_lo, hy_hi, hp_r⟩ := ih r h1 hr_f
          have hy_eq : (rightSpineTopDownNat (.node k l r)).getD (d + 1 + 1) 0 =
              (rightSpineTopDownNat r).getD (d + 1) 0 := rfl
          rw [hy_eq]
          refine ⟨?_, hy_lo, hy_hi, ?_⟩
          · simp only [inorderNat, List.mem_append]; exact Or.inr hy_mem
          · simp [psspHasKeyIn, hp_r]

    have h_descend_decomp : ∀ (T : _root_.BinaryTree ℕ) (acc : List (ℕ × _root_.BinaryTree ℕ)),
        T ≠ .nil →
        ∃ s0 : ℕ,
          leftSpineBottomUpAux T (acc.map Prod.fst) =
            s0 :: (descendLeftNat T acc).2.map Prod.fst ∧
          twAttachPoly (.node s0 .nil (descendLeftNat T acc).1) (descendLeftNat T acc).2 =
            twAttachPoly T acc := by
      intro T
      induction T with
      | nil => intro _ h; exact absurd rfl h
      | node k l r ihl _ =>
        intro acc _
        rcases l with _ | ⟨lk, ll, lr⟩
        · refine ⟨k, ?_, ?_⟩ <;> simp [leftSpineBottomUpAux, descendLeftNat]
        · simpa [leftSpineBottomUpAux, descendLeftNat, twAttachPoly] using
            ihl ((k, r) :: acc) (by simp)

    have h_attach_append : ∀ (U : _root_.BinaryTree ℕ) (p1 p2 : List (ℕ × _root_.BinaryTree ℕ)),
        twAttachPoly U (p1 ++ p2) = twAttachPoly (twAttachPoly U p1) p2 := by
      intro U p1 p2
      induction p1 generalizing U with
      | nil => rfl
      | cons kr rest ih => exact ih (.node kr.1 U kr.2)

    have h_attach_bst : ∀ (ps : List (ℕ × _root_.BinaryTree ℕ)) (U : _root_.BinaryTree ℕ),
        _root_.BinaryTree.IsBST (twAttachPoly U ps) →
        _root_.BinaryTree.IsBST U ∧
          ∀ p ∈ ps,
            _root_.SplayDeque.Direct.ForallTree (fun v => v < p.1) U ∧
            _root_.SplayDeque.Direct.ForallTree (fun v => p.1 < v) p.2 := by
      intro ps
      induction ps with
      | nil =>
        intro U hbst
        exact ⟨hbst, by simp⟩
      | cons kr rest ih =>
        intro U hbst
        obtain ⟨hbst_node, hrest⟩ := ih (.node kr.1 U kr.2) hbst
        cases hbst_node using isBSTCases with
        | node _ _ _ hl_lt hr_gt hl_bst _ =>
          refine ⟨hl_bst, ?_⟩
          intro p hp
          rcases List.mem_cons.mp hp with rfl | hp_rest
          · exact ⟨hl_lt, hr_gt⟩
          · obtain ⟨hnode_lt, hp2_gt⟩ := hrest p hp_rest
            cases hnode_lt with
            | node _ _ _ hU_lt _ _ => exact ⟨hU_lt, hp2_gt⟩

    have h_attach_hasKey : ∀ (lo hi : ℕ) (ps : List (ℕ × _root_.BinaryTree ℕ)) (U : _root_.BinaryTree ℕ),
        psspHasKeyIn lo hi U = true → psspHasKeyIn lo hi (twAttachPoly U ps) = true := by
      intro lo hi ps
      induction ps with
      | nil => intro U h; exact h
      | cons kr rest ih =>
        intro U h
        apply ih (.node kr.1 U kr.2)
        simp [psspHasKeyIn, h]

    have h_attach_ancDesc : ∀ (lo_p hi_p lo_q hi_q : ℕ)
        (ps : List (ℕ × _root_.BinaryTree ℕ)) (U : _root_.BinaryTree ℕ),
        psspHasAncDesc lo_p hi_p lo_q hi_q U = true →
        psspHasAncDesc lo_p hi_p lo_q hi_q (twAttachPoly U ps) = true := by
      intro lo_p hi_p lo_q hi_q ps
      induction ps with
      | nil => intro U h; exact h
      | cons kr rest ih =>
        intro U h
        apply ih (.node kr.1 U kr.2)
        simp [psspHasAncDesc, h]

    have h_splay_sub_attach : ∀ (lo_p hi_p lo_q hi_q n : ℕ)
        (path : List (ℕ × _root_.BinaryTree ℕ)) (c t0 : _root_.BinaryTree ℕ),
        path.length ≤ n →
        psspHasKeyIn lo_p hi_p t0 = true →
        (psspHasAncDesc lo_p hi_p lo_q hi_q c = true →
          psspHasAncDesc lo_p hi_p lo_q hi_q t0 = true) →
        psspHasAncDesc lo_p hi_p lo_q hi_q (splayLeftSpineNat c path) = true →
        psspHasAncDesc lo_p hi_p lo_q hi_q (twAttachPoly t0 path) = true := by
      intro lo_p hi_p lo_q hi_q n
      induction n with
      | zero =>
        intro path c t0 hlen _ hct hs
        rcases path with _ | ⟨kr, rest⟩
        · exact hct hs
        · simp at hlen
      | succ n ih =>
        intro path c t0 hlen ht0 hct hs
        rcases path with _ | ⟨⟨k1, r1⟩, _ | ⟨⟨k2, r2⟩, rest⟩⟩
        · exact hct hs
        · simp only [splayLeftSpineNat, psspHasAncDesc, Bool.or_eq_true, Bool.and_eq_true] at hs
          simp only [twAttachPoly, psspHasAncDesc, ht0, Bool.true_or, Bool.and_true, Bool.or_eq_true]
          rcases hs with (⟨hk1, _⟩ | hc) | hr1
          · exact Or.inl (Or.inl hk1)
          · exact Or.inl (Or.inr (hct hc))
          · exact Or.inr hr1
        · simp only [splayLeftSpineNat] at hs
          simp only [twAttachPoly]
          apply ih rest (.node k1 c (.node k2 r1 r2)) (.node k2 (.node k1 t0 r1) r2)
            (by simp at hlen; omega)
          · simp [psspHasKeyIn, ht0]
          · intro hc'
            have ht0_1 : psspHasKeyIn lo_p hi_p (.node k1 t0 r1) = true := by
              simp [psspHasKeyIn, ht0]
            simp only [psspHasAncDesc, Bool.or_eq_true, Bool.and_eq_true] at hc'
            simp only [psspHasAncDesc, ht0, ht0_1, Bool.true_or, Bool.and_true, Bool.or_eq_true]
            rcases hc' with (⟨hk1, _⟩ | hc) | ((⟨hk2, _⟩ | hr1) | hr2)
            · exact Or.inl (Or.inr (Or.inl (Or.inl hk1)))
            · exact Or.inl (Or.inr (Or.inl (Or.inr (hct hc))))
            · exact Or.inl (Or.inl hk2)
            · exact Or.inl (Or.inr (Or.inr hr1))
            · exact Or.inr hr2
          · exact hs

    have h_splay_even_append : ∀ (j : ℕ) (pre post : List (ℕ × _root_.BinaryTree ℕ)) (c : _root_.BinaryTree ℕ),
        pre.length = 2 * j →
        splayLeftSpineNat c (pre ++ post) = splayLeftSpineNat (splayLeftSpineNat c pre) post := by
      intro j
      induction j with
      | zero =>
        intro pre post c hlen
        rcases pre with _ | ⟨_, _⟩
        · rfl
        · simp at hlen
      | succ j ih =>
        intro pre post c hlen
        rcases pre with _ | ⟨⟨k1, r1⟩, _ | ⟨⟨k2, r2⟩, rest⟩⟩
        · simp at hlen
        · simp at hlen; omega
        · simp only [List.cons_append, splayLeftSpineNat]
          exact ih rest post (.node k1 c (.node k2 r1 r2)) (by simp at hlen; omega)

    have h_splay_forall : ∀ (p : ℕ → Prop) (n : ℕ) (path : List (ℕ × _root_.BinaryTree ℕ))
        (c : _root_.BinaryTree ℕ),
        path.length ≤ n →
        _root_.SplayDeque.Direct.ForallTree p c →
        (∀ kr ∈ path, p kr.1 ∧ _root_.SplayDeque.Direct.ForallTree p kr.2) →
        _root_.SplayDeque.Direct.ForallTree p (splayLeftSpineNat c path) := by
      intro p n
      induction n with
      | zero =>
        intro path c hlen hc _
        rcases path with _ | ⟨_, _⟩
        · exact hc
        · simp at hlen
      | succ n ih =>
        intro path c hlen hc hpath
        rcases path with _ | ⟨⟨k1, r1⟩, _ | ⟨⟨k2, r2⟩, rest⟩⟩
        · exact hc
        · obtain ⟨hk1, hr1⟩ := hpath (k1, r1) (by simp)
          exact .node c k1 r1 hc hk1 hr1
        · obtain ⟨hk1, hr1⟩ := hpath (k1, r1) (by simp)
          obtain ⟨hk2, hr2⟩ := hpath (k2, r2) (by simp)
          refine ih rest (.node k1 c (.node k2 r1 r2)) (by simp at hlen; omega)
            (.node c k1 (.node k2 r1 r2) hc hk1 (.node r1 k2 r2 hr1 hk2 hr2)) ?_
          intro kr hkr
          exact hpath kr (by simp [hkr])

    have h_splay_kill_tail : ∀ (lo_p hi_p lo_q hi_q n : ℕ)
        (tail : List (ℕ × _root_.BinaryTree ℕ)) (c : _root_.BinaryTree ℕ),
        tail.length ≤ n →
        psspHasAncDesc lo_p hi_p lo_q hi_q c = false →
        (∀ kr ∈ tail, hi_q ≤ kr.1 ∧ _root_.SplayDeque.Direct.ForallTree (fun v => hi_q ≤ v) kr.2) →
        psspHasAncDesc lo_p hi_p lo_q hi_q (splayLeftSpineNat c tail) = false := by
      intro lo_p hi_p lo_q hi_q n
      induction n with
      | zero =>
        intro tail c hlen hc _
        rcases tail with _ | ⟨_, _⟩
        · exact hc
        · simp at hlen
      | succ n ih =>
        intro tail c hlen hc htail
        rcases tail with _ | ⟨⟨k1, r1⟩, _ | ⟨⟨k2, r2⟩, rest⟩⟩
        · exact hc
        · obtain ⟨hk1, hr1⟩ := htail (k1, r1) (by simp)
          have hk1_f : decide (lo_q ≤ k1 ∧ k1 < hi_q) = false := by
            rw [decide_eq_false_iff_not]; omega
          have hr1_f : psspHasAncDesc lo_p hi_p lo_q hi_q r1 = false :=
            h_forall_no_ancDesc lo_p hi_p lo_q hi_q r1
              (h_forall_imp (fun _ hv => Or.inr hv) hr1)
          simp [splayLeftSpineNat, psspHasAncDesc, hk1_f, hc, hr1_f]
        · obtain ⟨hk1, hr1⟩ := htail (k1, r1) (by simp)
          obtain ⟨hk2, hr2⟩ := htail (k2, r2) (by simp)
          have hk1_f : decide (lo_q ≤ k1 ∧ k1 < hi_q) = false := by
            rw [decide_eq_false_iff_not]; omega
          have hk2_f : decide (lo_q ≤ k2 ∧ k2 < hi_q) = false := by
            rw [decide_eq_false_iff_not]; omega
          have hr1_f : psspHasAncDesc lo_p hi_p lo_q hi_q r1 = false :=
            h_forall_no_ancDesc lo_p hi_p lo_q hi_q r1
              (h_forall_imp (fun _ hv => Or.inr hv) hr1)
          have hr2_f : psspHasAncDesc lo_p hi_p lo_q hi_q r2 = false :=
            h_forall_no_ancDesc lo_p hi_p lo_q hi_q r2
              (h_forall_imp (fun _ hv => Or.inr hv) hr2)
          have hc' : psspHasAncDesc lo_p hi_p lo_q hi_q (.node k1 c (.node k2 r1 r2)) = false := by
            simp [psspHasAncDesc, hk1_f, hk2_f, hc, hr1_f, hr2_f]
          refine ih rest (.node k1 c (.node k2 r1 r2)) (by simp at hlen; omega) hc' ?_
          intro kr hkr
          exact htail kr (by simp [hkr])

    have h_drop_cons : ∀ {β : Type} (xs : List β) (i : ℕ) (hi : i < xs.length),
        xs.drop i = xs[i] :: xs.drop (i + 1) := by
      intro β xs
      induction xs with
      | nil => intro i hi; simp at hi
      | cons x rest ih =>
        intro i hi
        rcases i with _ | i
        · rfl
        · exact ih i (by simp at hi; omega)

    let U : Finset (ℕ × ℕ × ℕ × ℕ) :=
      (Finset.Icc 1 L).biUnion (fun ℓ =>
        (Finset.range (scaleBlocks S P (ℓ - 1)).length).biUnion (fun Xi =>
          let X := (scaleBlocks S P (ℓ - 1)).getD Xi (0, 0)
          let subs := splitBlock (S ℓ) X.1 X.2
          (Finset.range subs.length).biUnion (fun p =>
            (Finset.Ico (p + 1) subs.length).map
              ⟨fun q => (ℓ, Xi, p, q), fun a b hab => by cases hab; rfl⟩)))

    have h_mem_U : ∀ q0 : ℕ × ℕ × ℕ × ℕ,
        q0 ∈ U ↔
          1 ≤ q0.1 ∧ q0.1 ≤ L ∧
          q0.2.1 < (scaleBlocks S P (q0.1 - 1)).length ∧
          q0.2.2.1 < q0.2.2.2 ∧
          q0.2.2.2 < (splitBlock (S q0.1)
            ((scaleBlocks S P (q0.1 - 1)).getD q0.2.1 (0, 0)).1
            ((scaleBlocks S P (q0.1 - 1)).getD q0.2.1 (0, 0)).2).length := by
      rintro ⟨ℓ, Xi, p, q⟩
      simp only [U, Finset.mem_biUnion, Finset.mem_Icc, Finset.mem_range, Finset.mem_map,
        Finset.mem_Ico, Function.Embedding.coeFn_mk]
      constructor
      · rintro ⟨ℓ', ⟨h1, h2⟩, Xi', hXi, p', hp, q', ⟨hpq, hq⟩, heq⟩
        cases heq
        exact ⟨h1, h2, hXi, hpq, hq⟩
      · rintro ⟨h1, h2, hXi, hpq, hq⟩
        exact ⟨ℓ, ⟨h1, h2⟩, Xi, hXi, p, by omega, q, ⟨hpq, hq⟩, rfl⟩

    let subP : (ℕ × ℕ × ℕ × ℕ) → ℕ × ℕ := fun q0 =>
      let X := (scaleBlocks S P (q0.1 - 1)).getD q0.2.1 (0, 0)
      (splitBlock (S q0.1) X.1 X.2).getD q0.2.2.1 (0, 0)

    let subQ : (ℕ × ℕ × ℕ × ℕ) → ℕ × ℕ := fun q0 =>
      let X := (scaleBlocks S P (q0.1 - 1)).getD q0.2.1 (0, 0)
      (splitBlock (S q0.1) X.1 X.2).getD q0.2.2.2 (0, 0)

    have h_U_intervals : ∀ q0 ∈ U,
        (subP q0).1 < (subP q0).2 ∧
        (subP q0).2 ≤ (subQ q0).1 ∧
        (subQ q0).1 < (subQ q0).2 ∧
        (subQ q0).2 ≤ P := by
      rintro ⟨ℓ, Xi, p, q⟩ hq0
      rw [h_mem_U] at hq0
      dsimp (config := { failIfUnchanged := false }) only at hq0
      obtain ⟨hℓ1, hℓL, hXi, hpq, hq⟩ := hq0
      set X := (scaleBlocks S P (ℓ - 1)).getD Xi (0, 0)
      have hX_mem : X ∈ scaleBlocks S P (ℓ - 1) := by
        have : (scaleBlocks S P (ℓ - 1))[Xi]? = some X := by
          simp [X, List.getD_eq_getElem?_getD, List.getElem?_eq_getElem hXi]
        exact List.mem_of_getElem? this
      have hX_bnd := hpart.blocks_bounds (ℓ - 1) (by omega) X hX_mem
      obtain ⟨_, _, _, hc_bnd, hc_adj, _, _, _⟩ := hpart.child_blocks ℓ hℓ1 hℓL Xi hXi
      set subs := splitBlock (S ℓ) X.1 X.2
      have h_sep : ∀ c1 c2 : ℕ, c1 < c2 → c2 < subs.length →
          (subs.getD c1 (0, 0)).2 ≤ (subs.getD c2 (0, 0)).1 := by
        intro c1 c2 hlt hc2
        induction c2 with
        | zero => omega
        | succ c2 ih =>
          by_cases h : c1 = c2
          · subst h; rw [hc_adj c1 hc2]
          · have h1 := ih (by omega) (by omega)
            have h2 := (hc_bnd c2 (by omega)).2.1
            have h3 := hc_adj c2 hc2
            omega
      have hp_bnd := hc_bnd p (by omega)
      have hq_bnd := hc_bnd q hq
      have hpq_sep := h_sep p q hpq hq
      have hX2_P : X.2 ≤ P := hX_bnd.2.1
      have hq_X2 : (subs.getD q (0, 0)).2 ≤ X.2 := hq_bnd.2.2.1
      change (subs.getD p (0, 0)).1 < (subs.getD p (0, 0)).2 ∧
        (subs.getD p (0, 0)).2 ≤ (subs.getD q (0, 0)).1 ∧
        (subs.getD q (0, 0)).1 < (subs.getD q (0, 0)).2 ∧
        (subs.getD q (0, 0)).2 ≤ P
      omega

    have h_tEmpty_props : ∀ (lo_p hi_p : ℕ), lo_p < hi_p → hi_p ≤ P →
        popStep kops lo_p ≤ tEmpty kops lo_p hi_p ∧
        tEmpty kops lo_p hi_p ≤ popStep kops (hi_p - 1) + 1 ∧
        popStep kops (hi_p - 1) + 1 ≤ kops.length ∧
        psspHasKeyIn lo_p hi_p (keyedState kops (tEmpty kops lo_p hi_p)) = false := by
      intro lo_p hi_p hlt hhiP
      have hlo_P : lo_p < P := by omega
      have hhi1_P : hi_p - 1 < P := by omega
      have hpop_hi : popStep kops (hi_p - 1) < kops.length := (hkvalid.birth_lt_pop (hi_p - 1) hhi1_P).2
      have hts_le_te : popStep kops lo_p ≤ popStep kops (hi_p - 1) + 1 := by
        by_cases heq : lo_p = hi_p - 1
        · rw [heq]; omega
        · have := hkvalid.popStep_mono lo_p (hi_p - 1) (by omega) hhi1_P; omega
      unfold tEmpty
      dsimp (config := { failIfUnchanged := false }) only
      cases hfind : (List.Ico (popStep kops lo_p) (popStep kops (hi_p - 1) + 1 + 1)).find?
          (fun t => (inorderNat (keyedState kops t)).all (fun v => decide (v < lo_p ∨ hi_p ≤ v))) with
      | none =>
        dsimp (config := { failIfUnchanged := false }) only
        refine ⟨hts_le_te, le_rfl, by omega, ?_⟩
        rw [Bool.eq_false_iff]
        intro htrue
        obtain ⟨v, hv_mem, hv_lo, hv_hi⟩ := (h_hasKey_iff lo_p hi_p _).mp htrue
        have hpbound := hkvalid.popIdx_bound (popStep kops (hi_p - 1) + 1) (by omega) v hv_mem
        have hpidx := hkvalid.popIdx_after_popStep (hi_p - 1) hhi1_P
        omega
      | some tstar =>
        dsimp (config := { failIfUnchanged := false }) only
        have hmem : tstar ∈ List.Ico (popStep kops lo_p) (popStep kops (hi_p - 1) + 1 + 1) :=
          List.mem_of_find?_eq_some hfind
        rw [List.Ico.mem] at hmem
        have hall := List.find?_some hfind
        rw [List.all_eq_true] at hall
        refine ⟨hmem.1, by omega, by omega, ?_⟩
        rw [Bool.eq_false_iff]
        intro htrue
        obtain ⟨v, hv_mem, hv_lo, hv_hi⟩ := (h_hasKey_iff lo_p hi_p _).mp htrue
        have hv_out := of_decide_eq_true (hall v hv_mem)
        omega

    let active : (ℕ × ℕ × ℕ × ℕ) → ℕ → Bool := fun q0 t =>
      let sp := subP q0
      let sq := subQ q0
      decide (tEmpty kops sp.1 sp.2 ≤ t) &&
        psspHasAncDesc sp.1 sp.2 sq.1 sq.2 (keyedState kops t)

    let psiSet : ℕ → Finset (ℕ × ℕ × ℕ × ℕ) := fun t =>
      U.filter (fun q0 => active q0 t = true)

    let psiPost : ℕ → ℕ := fun t => (psiSet t).card

    have h_psi_zero : psiPost 0 = 0 := by
      have hempty : psiSet 0 = ∅ := by
        rw [Finset.eq_empty_iff_forall_notMem]
        intro q0 hmem
        simp only [psiSet, Finset.mem_filter, active, keyedState, List.take_zero,
          execKeyedList, psspHasAncDesc, Bool.and_false, reduceCtorEq, and_false] at hmem
      simp [psiPost, hempty]

    have h_psi_end : psiPost kops.length = 0 := by
      have hempty : psiSet kops.length = ∅ := by
        rw [Finset.eq_empty_iff_forall_notMem]
        intro q0 hmem
        simp only [psiSet, Finset.mem_filter, active, hkvalid.end_empty,
          psspHasAncDesc, Bool.and_false, reduceCtorEq, and_false] at hmem
      simp [psiPost, hempty]

    have h_active_at_tEmpty : ∀ q0 ∈ U, active q0 (tEmpty kops (subP q0).1 (subP q0).2) = false := by
      intro q0 hq0
      obtain ⟨hp_lt, hpq_le, hq_lt, hq_P⟩ := h_U_intervals q0 hq0
      obtain ⟨_, _, _, hno_key⟩ := h_tEmpty_props (subP q0).1 (subP q0).2 hp_lt (by omega)
      rw [Bool.eq_false_iff]
      intro hact
      simp only [active, Bool.and_eq_true] at hact
      have hkey := h_ancDesc_imp_hasKey _ _ _ _ _ hact.2
      rw [hno_key] at hkey
      cases hkey

    let b3pSetAt : ℕ → Finset ℕ := fun t =>
      (B_3_post S P L kops).filter (fun id =>
        (match (jumps kops)[id]? with
        | none => false
        | some e => decide (e.step = t)) = true)

    let isRslrNat : ℕ → ℕ := fun t =>
      match kops[t]? with
      | some (.rslr _) => 1
      | _ => 0

    have h_b3p_nonpop : ∀ t (ht : t < kops.length),
        (∀ s, kops[t] ≠ .pop s) → (b3pSetAt t).card = 0 := by
      intro t ht hnp
      rw [Finset.card_eq_zero, Finset.eq_empty_iff_forall_notMem]
      intro id hid
      simp only [b3pSetAt, Finset.mem_filter, B_3_post, Finset.mem_range] at hid
      obtain ⟨⟨hid_lt, _⟩, hstep⟩ := hid
      rw [List.getElem?_eq_getElem hid_lt, decide_eq_true_eq] at hstep
      obtain ⟨_, hstep_lt, hkop_opt, _⟩ := hjump.jump_anatomies id hid_lt
      set e := (jumps kops)[id]
      have hkop : kops[e.step] = .pop e.s := by
        rw [List.getElem?_eq_getElem hstep_lt] at hkop_opt
        exact Option.some.inj hkop_opt
      subst hstep
      exact hnp e.s hkop

    have h_step_ineq : ∀ t (ht : t < kops.length),
        (b3pSetAt t).card + psiPost (t + 1) ≤ psiPost t + isRslrNat t := by
      intro t ht
      have hnext := h_state_step t ht
      have hsv := hkvalid.step_valid t ht
      cases hkop : kops[t] with
      | push w =>
        rw [hkop] at hsv hnext
        obtain ⟨hw_P, _, hforall_w⟩ := hsv
        have hb0 : (b3pSetAt t).card = 0 := h_b3p_nonpop t ht (by simp [hkop])
        have hr0 : isRslrNat t = 0 := by simp [isRslrNat, List.getElem?_eq_getElem ht, hkop]
        have hset_eq : psiSet (t + 1) = psiSet t := by
          ext q0
          simp only [psiSet, Finset.mem_filter]
          by_cases hq0 : q0 ∈ U
          · simp only [hq0, true_and]
            obtain ⟨hp_lt, hpq_le, _, _⟩ := h_U_intervals q0 hq0
            by_cases htE : tEmpty kops (subP q0).1 (subP q0).2 ≤ t
            · have htE1 : tEmpty kops (subP q0).1 (subP q0).2 ≤ t + 1 := by omega
              simp only [active, decide_eq_true htE, decide_eq_true htE1, Bool.true_and,
                hnext, execKeyedOp]
              simp only [psspHasAncDesc, psspHasKeyIn, Bool.false_or, Bool.or_false]
              by_cases hw_q : (subQ q0).1 ≤ w ∧ w < (subQ q0).2
              · have h_no_p : psspHasKeyIn (subP q0).1 (subP q0).2 (keyedState kops t) = false :=
                  h_forall_no_key (subP q0).1 (subP q0).2 (keyedState kops t)
                    (h_forall_imp (fun v hv => Or.inr (by omega)) hforall_w)
                simp [h_no_p]
              · have hw_f : decide ((subQ q0).1 ≤ w ∧ w < (subQ q0).2) = false :=
                  decide_eq_false hw_q
                simp [hw_f]
            · by_cases htE1 : t + 1 = tEmpty kops (subP q0).1 (subP q0).2
              · rw [htE1, h_active_at_tEmpty q0 hq0]
                have hf : decide (tEmpty kops (subP q0).1 (subP q0).2 ≤ t) = false :=
                  decide_eq_false htE
                simp [active, hf]
              · have hf : decide (tEmpty kops (subP q0).1 (subP q0).2 ≤ t) = false :=
                  decide_eq_false htE
                have hf1 : decide (tEmpty kops (subP q0).1 (subP q0).2 ≤ t + 1) = false := by
                  rw [decide_eq_false_iff_not]; omega
                simp [active, hf, hf1]
          · simp [hq0]
        simp only [psiPost, hset_eq, hb0, hr0]
        omega

      | rslr d =>
        rw [hkop] at hsv hnext
        have hb0 : (b3pSetAt t).card = 0 := h_b3p_nonpop t ht (by simp [hkop])
        have hr1 : isRslrNat t = 1 := by simp [isRslrNat, List.getElem?_eq_getElem ht, hkop]
        have h_diff_le1 : (psiSet (t + 1) \ psiSet t).card ≤ 1 := by
          rw [Finset.card_le_one_iff]
          intro q1 q2 hq1 hq2
          simp only [Finset.mem_sdiff, psiSet, Finset.mem_filter] at hq1 hq2
          obtain ⟨⟨hq1_U, hact1_next⟩, hn1_cur⟩ := hq1
          obtain ⟨⟨hq2_U, hact2_next⟩, hn2_cur⟩ := hq2
          have hact1_cur_f : active q1 t = false := by
            cases h : active q1 t
            · rfl
            · exact absurd ⟨hq1_U, h⟩ hn1_cur
          have hact2_cur_f : active q2 t = false := by
            cases h : active q2 t
            · rfl
            · exact absurd ⟨hq2_U, h⟩ hn2_cur
          have htE1 : tEmpty kops (subP q1).1 (subP q1).2 ≤ t := by
            by_contra hlt
            by_cases heq : t + 1 = tEmpty kops (subP q1).1 (subP q1).2
            · rw [heq, h_active_at_tEmpty q1 hq1_U] at hact1_next; cases hact1_next
            · have hf : decide (tEmpty kops (subP q1).1 (subP q1).2 ≤ t + 1) = false := by
                rw [decide_eq_false_iff_not]; omega
              simp [active, hf] at hact1_next
          have htE2 : tEmpty kops (subP q2).1 (subP q2).2 ≤ t := by
            by_contra hlt
            by_cases heq : t + 1 = tEmpty kops (subP q2).1 (subP q2).2
            · rw [heq, h_active_at_tEmpty q2 hq2_U] at hact2_next; cases hact2_next
            · have hf : decide (tEmpty kops (subP q2).1 (subP q2).2 ≤ t + 1) = false := by
                rw [decide_eq_false_iff_not]; omega
              simp [active, hf] at hact2_next
          have hanc1_next : psspHasAncDesc (subP q1).1 (subP q1).2 (subQ q1).1 (subQ q1).2
              (rotateLeftAtRightDepthNat (keyedState kops t) d) = true := by
            have h := (Bool.and_eq_true _ _).mp hact1_next |>.2
            rwa [hnext, execKeyedOp] at h
          have hanc1_cur : psspHasAncDesc (subP q1).1 (subP q1).2 (subQ q1).1 (subQ q1).2
              (keyedState kops t) = false := by
            simpa [active, decide_eq_true htE1] using hact1_cur_f
          have hanc2_next : psspHasAncDesc (subP q2).1 (subP q2).2 (subQ q2).1 (subQ q2).2
              (rotateLeftAtRightDepthNat (keyedState kops t) d) = true := by
            have h := (Bool.and_eq_true _ _).mp hact2_next |>.2
            rwa [hnext, execKeyedOp] at h
          have hanc2_cur : psspHasAncDesc (subP q2).1 (subP q2).2 (subQ q2).1 (subQ q2).2
              (keyedState kops t) = false := by
            simpa [active, decide_eq_true htE2] using hact2_cur_f
          set y := (rightSpineTopDownNat (keyedState kops t)).getD (d + 1) 0
          obtain ⟨hy_mem, hy1_lo, hy1_hi, hp1_key⟩ :=
            h_ancDesc_rotL_gain (subP q1).1 (subP q1).2 (subQ q1).1 (subQ q1).2 d
              (keyedState kops t) hanc1_next hanc1_cur
          obtain ⟨_, hy2_lo, hy2_hi, hp2_key⟩ :=
            h_ancDesc_rotL_gain (subP q2).1 (subP q2).2 (subQ q2).1 (subQ q2).2 d
              (keyedState kops t) hanc2_next hanc2_cur
          have hy_P : y < P := (hkvalid.popIdx_bound t (by omega) y hy_mem).2
          obtain ⟨v1, hv1_mem, _, hv1_hi⟩ := (h_hasKey_iff _ _ _).mp hp1_key
          obtain ⟨v2, hv2_mem, _, hv2_hi⟩ := (h_hasKey_iff _ _ _).mp hp2_key
          set ino := inorderNat (keyedState kops t)
          have hino_ne : ino ≠ [] := List.ne_nil_of_mem hv1_mem
          rcases hino_cons : ino with _ | ⟨m0, ino_rest⟩
          · exact absurd hino_cons hino_ne
          have hm0_mem : m0 ∈ inorderNat (keyedState kops t) := by
            change m0 ∈ ino; simp [hino_cons]
          have hm0_P : m0 < P := (hkvalid.popIdx_bound t (by omega) m0 hm0_mem).2
          have hino_pw : List.Pairwise (· < ·) (m0 :: ino_rest) := by
            rw [← hino_cons]
            exact hkvalid.inorder_strictMono t (by omega)
          have hm0_le : ∀ v ∈ inorderNat (keyedState kops t), m0 ≤ v := by
            intro v hv
            change v ∈ ino at hv
            rw [hino_cons] at hv
            rcases List.mem_cons.mp hv with rfl | hv_rest
            · exact le_rfl
            · exact le_of_lt ((List.pairwise_cons.mp hino_pw).1 v hv_rest)
          have h_pin : ∀ (qi : ℕ × ℕ × ℕ × ℕ) (hqi_U : qi ∈ U),
              tEmpty kops (subP qi).1 (subP qi).2 ≤ t →
              (subQ qi).1 ≤ y → y < (subQ qi).2 →
              (∃ v ∈ inorderNat (keyedState kops t), v < (subP qi).2) →
              qi.1 = sepScale S P L m0 y ∧
              qi.2.1 = blockIdx S P (sepScale S P L m0 y - 1) m0 ∧
              qi.2.2.1 = (splitBlock (S (sepScale S P L m0 y))
                ((scaleBlocks S P (sepScale S P L m0 y - 1)).getD
                  (blockIdx S P (sepScale S P L m0 y - 1) m0) (0, 0)).1
                ((scaleBlocks S P (sepScale S P L m0 y - 1)).getD
                  (blockIdx S P (sepScale S P L m0 y - 1) m0) (0, 0)).2).findIdx
                  (fun b => decide (b.1 ≤ m0 ∧ m0 < b.2)) ∧
              qi.2.2.2 = (splitBlock (S (sepScale S P L m0 y))
                ((scaleBlocks S P (sepScale S P L m0 y - 1)).getD
                  (blockIdx S P (sepScale S P L m0 y - 1) m0) (0, 0)).1
                ((scaleBlocks S P (sepScale S P L m0 y - 1)).getD
                  (blockIdx S P (sepScale S P L m0 y - 1) m0) (0, 0)).2).findIdx
                  (fun b => decide (b.1 ≤ y ∧ y < b.2)) := by
            rintro ⟨ℓ, Xi, p, q⟩ hqi_U htE hy_lo hy_hi ⟨v, hv_mem, hv_hi⟩
            obtain ⟨hp_lt, hpq_le, hq_lt, hq_P⟩ := h_U_intervals (ℓ, Xi, p, q) hqi_U
            obtain ⟨hts_le, _, _, _⟩ := h_tEmpty_props (subP (ℓ, Xi, p, q)).1 (subP (ℓ, Xi, p, q)).2
              hp_lt (by omega)
            have hlo_P : (subP (ℓ, Xi, p, q)).1 < P := by omega
            have hm0_lo : (subP (ℓ, Xi, p, q)).1 ≤ m0 := by
              have h1 := hkvalid.popIdx_at_popStep (subP (ℓ, Xi, p, q)).1 hlo_P
              have h2 := h_popIdx_mono (popStep kops (subP (ℓ, Xi, p, q)).1) t (le_trans hts_le htE)
              have h3 := (hkvalid.popIdx_bound t (by omega) m0 hm0_mem).1
              omega
            have hm0_hi : m0 < (subP (ℓ, Xi, p, q)).2 := lt_of_le_of_lt (hm0_le v hv_mem) hv_hi
            rw [h_mem_U] at hqi_U
            dsimp (config := { failIfUnchanged := false }) only at hqi_U ⊢
            obtain ⟨hℓ1, hℓL, hXi, hpq, hq_len⟩ := hqi_U
            obtain ⟨_, _, _, hc_bnd, hc_adj, hXi_iff, hsub_of, hsub_eq_iff⟩ :=
              hpart.child_blocks ℓ hℓ1 hℓL Xi hXi
            set X := (scaleBlocks S P (ℓ - 1)).getD Xi (0, 0)
            set subs := splitBlock (S ℓ) X.1 X.2
            have h_sep : ∀ c1 c2 : ℕ, c1 < c2 → c2 < subs.length →
                (subs.getD c1 (0, 0)).2 ≤ (subs.getD c2 (0, 0)).1 := by
              intro c1 c2 hlt hc2
              induction c2 with
              | zero => omega
              | succ c2 ih =>
                by_cases h : c1 = c2
                · subst h; rw [hc_adj c1 hc2]
                · have h1 := ih (by omega) (by omega)
                  have h2 := (hc_bnd c2 (by omega)).2.1
                  have h3 := hc_adj c2 hc2
                  omega
            have h_findIdx_eq : ∀ c < subs.length, ∀ u : ℕ,
                (subs.getD c (0, 0)).1 ≤ u → u < (subs.getD c (0, 0)).2 →
                subs.findIdx (fun b => decide (b.1 ≤ u ∧ u < b.2)) = c := by
              intro c hc u hu1 hu2
              rw [List.findIdx_eq hc]
              refine ⟨?_, ?_⟩
              · have hget : subs[c] = subs.getD c (0, 0) := by
                  simp [List.getD_eq_getElem?_getD, List.getElem?_eq_getElem hc]
                rw [hget]
                exact decide_eq_true ⟨hu1, hu2⟩
              · intro j hj
                have hj_lt : j < subs.length := lt_trans hj hc
                have hget : subs[j] = subs.getD j (0, 0) := by
                  simp [List.getD_eq_getElem?_getD, List.getElem?_eq_getElem hj_lt]
                rw [hget, decide_eq_false_iff_not]
                have hsep := h_sep j c hj hc
                omega
            have hp_bnd := hc_bnd p (by omega)
            have hq_bnd := hc_bnd q hq_len
            change (subs.getD p (0, 0)).1 ≤ m0 at hm0_lo
            change m0 < (subs.getD p (0, 0)).2 at hm0_hi
            change (subs.getD q (0, 0)).1 ≤ y at hy_lo
            change y < (subs.getD q (0, 0)).2 at hy_hi
            have hm0_X : X.1 ≤ m0 ∧ m0 < X.2 := ⟨by omega, by omega⟩
            have hy_X : X.1 ≤ y ∧ y < X.2 := ⟨by omega, by omega⟩
            have hp_fidx : subs.findIdx (fun b => decide (b.1 ≤ m0 ∧ m0 < b.2)) = p :=
              h_findIdx_eq p (by omega) m0 hm0_lo hm0_hi
            have hq_fidx : subs.findIdx (fun b => decide (b.1 ≤ y ∧ y < b.2)) = q :=
              h_findIdx_eq q hq_len y hy_lo hy_hi
            have hXi_m0 : blockIdx S P (ℓ - 1) m0 = Xi := (hXi_iff m0 hm0_P).mpr hm0_X
            have hXi_y : blockIdx S P (ℓ - 1) y = Xi := (hXi_iff y hy_P).mpr hy_X
            have hℓ_gt : ℓ - 1 < sepScale S P L m0 y :=
              (hpart.sep_gt_iff (ℓ - 1) (by omega) m0 hm0_P y hy_P).mpr (hXi_m0.trans hXi_y.symm)
            have hℓ_not_gt : ¬(ℓ < sepScale S P L m0 y) := by
              intro hgt
              have hb_eq := (hpart.sep_gt_iff ℓ hℓL m0 hm0_P y hy_P).mp hgt
              have hpq_eq := (hsub_eq_iff m0 hm0_X.1 hm0_X.2 y hy_X.1 hy_X.2).mpr hb_eq
              rw [hp_fidx, hq_fidx] at hpq_eq
              omega
            have hℓ_eq : ℓ = sepScale S P L m0 y := by omega
            subst hℓ_eq
            subst hXi_m0
            exact ⟨rfl, rfl, hp_fidx.symm, hq_fidx.symm⟩
          have hp1 := h_pin q1 hq1_U htE1 hy1_lo hy1_hi ⟨v1, hv1_mem, hv1_hi⟩
          have hp2 := h_pin q2 hq2_U htE2 hy2_lo hy2_hi ⟨v2, hv2_mem, hv2_hi⟩
          rcases q1 with ⟨ℓ1, Xi1, p1, qq1⟩
          rcases q2 with ⟨ℓ2, Xi2, p2, qq2⟩
          dsimp (config := { failIfUnchanged := false }) only at hp1 hp2
          rw [hp1.1, hp2.1, hp1.2.1, hp2.2.1, hp1.2.2.1, hp2.2.2.1, hp1.2.2.2, hp2.2.2.2]
        have h_sub_union : psiSet (t + 1) ⊆ psiSet t ∪ (psiSet (t + 1) \ psiSet t) := by
          intro q0 hq0
          by_cases h : q0 ∈ psiSet t
          · exact Finset.mem_union.mpr (Or.inl h)
          · exact Finset.mem_union.mpr (Or.inr (Finset.mem_sdiff.mpr ⟨hq0, h⟩))
        have hcard1 := Finset.card_le_card h_sub_union
        have hcard2 := Finset.card_union_le (psiSet t) (psiSet (t + 1) \ psiSet t)
        simp only [psiPost, hb0, hr1]
        omega

      | pop s =>
        rw [hkop] at hsv hnext
        obtain ⟨hs_P, hpop_s, hs_pidx, hHt_ne, hls_head⟩ := hsv
        have hr0 : isRslrNat t = 0 := by simp [isRslrNat, List.getElem?_eq_getElem ht, hkop]
        set Ht := keyedState kops t
        set c0 := (descendLeftNat Ht []).1
        set path := (descendLeftNat Ht []).2
        obtain ⟨s0, hls_eq0, hattach0⟩ := h_descend_decomp Ht [] hHt_ne
        simp only [List.map_nil, twAttachPoly] at hls_eq0 hattach0
        have hs0_eq : s0 = s := by
          change (leftSpineBottomUpNat Ht).head? = some s at hls_head
          change leftSpineBottomUpNat Ht = s0 :: path.map Prod.fst at hls_eq0
          rw [hls_eq0, List.head?_cons] at hls_head
          exact Option.some.inj hls_head
        rw [hs0_eq] at hls_eq0 hattach0
        have hls_eq : leftSpineBottomUpNat Ht = s :: path.map Prod.fst := hls_eq0
        have hHt_attach : Ht = twAttachPoly (.node s .nil c0) path := hattach0.symm
        have hHt_next : keyedState kops (t + 1) = splayLeftSpineNat c0 path := by
          rw [hnext]
          rfl
        have h_sub : psiSet (t + 1) ⊆ psiSet t := by
          intro q0 hq0_next
          simp only [psiSet, Finset.mem_filter] at hq0_next ⊢
          obtain ⟨hq0_U, hact_next⟩ := hq0_next
          refine ⟨hq0_U, ?_⟩
          obtain ⟨hp_lt, _, _, hq_P⟩ := h_U_intervals q0 hq0_U
          have htE : tEmpty kops (subP q0).1 (subP q0).2 ≤ t := by
            by_contra hlt
            by_cases heq : t + 1 = tEmpty kops (subP q0).1 (subP q0).2
            · rw [heq, h_active_at_tEmpty q0 hq0_U] at hact_next; cases hact_next
            · have hf : decide (tEmpty kops (subP q0).1 (subP q0).2 ≤ t + 1) = false := by
                rw [decide_eq_false_iff_not]; omega
              simp [active, hf] at hact_next
          obtain ⟨hts_le, _, _, _⟩ := h_tEmpty_props (subP q0).1 (subP q0).2 hp_lt (by omega)
          have hlo_P : (subP q0).1 < P := by omega
          have hs_ge_lo : (subP q0).1 ≤ s := by
            have h1 := hkvalid.popIdx_at_popStep (subP q0).1 hlo_P
            have h2 := h_popIdx_mono (popStep kops (subP q0).1) t (le_trans hts_le htE)
            omega
          have hanc_next : psspHasAncDesc (subP q0).1 (subP q0).2 (subQ q0).1 (subQ q0).2
              (keyedState kops (t + 1)) = true :=
            (Bool.and_eq_true _ _).mp hact_next |>.2
          have hs_lt_hi : s < (subP q0).2 := by
            have hkey_next := h_ancDesc_imp_hasKey _ _ _ _ _ hanc_next
            obtain ⟨v, hv_mem, _, hv_hi⟩ := (h_hasKey_iff _ _ _).mp hkey_next
            have hpbound := hkvalid.popIdx_bound (t + 1) (by omega) v hv_mem
            have hpidx_after : popIdx kops (t + 1) = s + 1 := by
              rw [← hpop_s]
              exact hkvalid.popIdx_after_popStep s hs_P
            omega
          rw [hHt_next] at hanc_next
          have ht0_key : psspHasKeyIn (subP q0).1 (subP q0).2 (.node s .nil c0) = true := by
            have hs_dec : decide ((subP q0).1 ≤ s ∧ s < (subP q0).2) = true :=
              decide_eq_true ⟨hs_ge_lo, hs_lt_hi⟩
            simp [psspHasKeyIn, hs_dec]
          have hanc_cur : psspHasAncDesc (subP q0).1 (subP q0).2 (subQ q0).1 (subQ q0).2 Ht = true := by
            rw [hHt_attach]
            exact h_splay_sub_attach (subP q0).1 (subP q0).2 (subQ q0).1 (subQ q0).2
              path.length path c0 (.node s .nil c0) le_rfl ht0_key
              (fun hc => by simp [psspHasAncDesc, hc]) hanc_next
          simp only [active, Bool.and_eq_true, decide_eq_true_eq]
          exact ⟨htE, hanc_cur⟩

        let phi : ℕ → ℕ × ℕ × ℕ × ℕ := fun id =>
          match (jumps kops)[id]? with
          | none => (0, 0, 0, 0)
          | some e =>
              let ℓ := sepScale S P L e.x e.y
              let Xi := blockIdx S P (ℓ - 1) e.x
              let X := (scaleBlocks S P (ℓ - 1)).getD Xi (0, 0)
              let subs := splitBlock (S ℓ) X.1 X.2
              let p := subs.findIdx (fun b => decide (b.1 ≤ e.s ∧ e.s < b.2))
              let q := subs.findIdx (fun b => decide (b.1 ≤ e.y ∧ e.y < b.2))
              (ℓ, Xi, p, q)

        have h_phi_maps : Set.MapsTo phi ↑(b3pSetAt t) ↑(psiSet t \ psiSet (t + 1)) := by
          intro id hid
          simp only [Finset.mem_coe, b3pSetAt, Finset.mem_filter, B_3_post,
            Finset.mem_range, isB3Post] at hid
          obtain ⟨⟨hid_lt, hb3p⟩, hstep_dec⟩ := hid
          rw [List.getElem?_eq_getElem hid_lt] at hb3p hstep_dec
          simp only [decide_eq_true_eq] at hb3p hstep_dec
          obtain ⟨hℓ1, hℓL, hsep_sx, hz_ge_by, htE_le⟩ := hb3p
          obtain ⟨_, hstep_lt, hkop_e, _, hsx, hxy, hyz, hzP,
            ⟨_, _, hex_ls, hey_ls, hez_ls⟩, _⟩ := hjump.jump_anatomies id hid_lt
          set e := (jumps kops)[id]
          have hes_eq : e.s = s := by
            have h1 : kops[e.step]? = some (.pop e.s) := hkop_e
            rw [hstep_dec, List.getElem?_eq_getElem ht, hkop] at h1
            cases h1; rfl
          set ℓ := sepScale S P L e.x e.y
          set Xi := blockIdx S P (ℓ - 1) e.x
          have hex_P : e.x < P := by omega
          have hey_P : e.y < P := by omega
          have hXi_lt : Xi < (scaleBlocks S P (ℓ - 1)).length :=
            (hpart.blocks_partition (ℓ - 1) (by omega) e.x hex_P).1
          obtain ⟨_, _, _, hc_bnd, hc_adj, hXi_iff, hsub_of, hsub_eq_iff⟩ :=
            hpart.child_blocks ℓ hℓ1 hℓL Xi hXi_lt
          set X := (scaleBlocks S P (ℓ - 1)).getD Xi (0, 0)
          set subs := splitBlock (S ℓ) X.1 X.2
          have h_sep : ∀ c1 c2 : ℕ, c1 < c2 → c2 < subs.length →
              (subs.getD c1 (0, 0)).2 ≤ (subs.getD c2 (0, 0)).1 := by
            intro c1 c2 hlt hc2
            induction c2 with
            | zero => omega
            | succ c2 ih =>
              by_cases h : c1 = c2
              · subst h; rw [hc_adj c1 hc2]
              · have h1 := ih (by omega) (by omega)
                have h2 := (hc_bnd c2 (by omega)).2.1
                have h3 := hc_adj c2 hc2
                omega
          have hex_X : X.1 ≤ e.x ∧ e.x < X.2 := (hXi_iff e.x hex_P).mp rfl
          have hey_Xi : blockIdx S P (ℓ - 1) e.y = Xi := by
            symm
            exact (hpart.sep_gt_iff (ℓ - 1) (by omega) e.x hex_P e.y hey_P).mp (by omega)
          have hey_X : X.1 ≤ e.y ∧ e.y < X.2 := (hXi_iff e.y hey_P).mp hey_Xi
          have hs_Xi : blockIdx S P (ℓ - 1) e.s = Xi :=
            (hpart.sep_gt_iff (ℓ - 1) (by omega) e.s (by omega) e.x hex_P).mp (by omega)
          have hs_X : X.1 ≤ e.s ∧ e.s < X.2 := (hXi_iff e.s (by omega)).mp hs_Xi
          set p := subs.findIdx (fun b => decide (b.1 ≤ e.s ∧ e.s < b.2))
          set bx := subs.findIdx (fun b => decide (b.1 ≤ e.x ∧ e.x < b.2))
          set q := subs.findIdx (fun b => decide (b.1 ≤ e.y ∧ e.y < b.2))
          obtain ⟨hp_lt, hsp_eq⟩ := hsub_of e.s hs_X.1 hs_X.2
          obtain ⟨hbx_lt, hsbx_eq⟩ := hsub_of e.x hex_X.1 hex_X.2
          obtain ⟨hq_lt, hsq_eq⟩ := hsub_of e.y hey_X.1 hey_X.2
          have hp_part := hpart.blocks_partition ℓ hℓL e.s (by omega)
          have hbx_part := hpart.blocks_partition ℓ hℓL e.x hex_P
          have hq_part := hpart.blocks_partition ℓ hℓL e.y hey_P
          have hp_ne_bx : p ≠ bx := by
            intro heq
            have hb_eq := (hsub_eq_iff e.s hs_X.1 hs_X.2 e.x hex_X.1 hex_X.2).mp heq
            have := (hpart.sep_gt_iff ℓ hℓL e.s (by omega) e.x hex_P).mpr hb_eq
            omega
          have hp_lt_bx : p < bx := by
            by_contra hge
            have hlt : bx < p := by omega
            have hsep := h_sep bx p hlt hp_lt
            rw [hsbx_eq, hsp_eq] at hsep
            omega
          have hbx_ne_q : bx ≠ q := by
            intro heq
            have hb_eq := (hsub_eq_iff e.x hex_X.1 hex_X.2 e.y hey_X.1 hey_X.2).mp heq
            have := (hpart.sep_gt_iff ℓ hℓL e.x hex_P e.y hey_P).mpr hb_eq
            omega
          have hbx_lt_q : bx < q := by
            by_contra hge
            have hlt : q < bx := by omega
            have hsep := h_sep q bx hlt hbx_lt
            rw [hsq_eq, hsbx_eq] at hsep
            omega
          have hp_lt_q : p < q := lt_trans hp_lt_bx hbx_lt_q
          have hsp_hi_le_x : (subs.getD p (0, 0)).2 ≤ e.x := by
            have hsep := h_sep p bx hp_lt_bx hbx_lt
            rw [hsbx_eq] at hsep
            omega
          have hx_lt_sq_lo : e.x < (subs.getD q (0, 0)).1 := by
            have hsep := h_sep bx q hbx_lt_q hq_lt
            rw [hsbx_eq] at hsep
            omega
          have hsq_hi_le_z : (subs.getD q (0, 0)).2 ≤ e.z := by
            rw [hsq_eq]; exact hz_ge_by
          have hphi_eq : phi id = (ℓ, Xi, p, q) := by
            simp [phi, List.getElem?_eq_getElem hid_lt, e, ℓ, Xi, X, subs, p, q]
          rw [hphi_eq]
          have hq0_U : (ℓ, Xi, p, q) ∈ U := by
            rw [h_mem_U]
            exact ⟨hℓ1, hℓL, hXi_lt, hp_lt_q, hq_lt⟩
          have hsubP_eq : subP (ℓ, Xi, p, q) = subs.getD p (0, 0) := rfl
          have hsubQ_eq : subQ (ℓ, Xi, p, q) = subs.getD q (0, 0) := rfl
          have htE_cur : tEmpty kops (subP (ℓ, Xi, p, q)).1 (subP (ℓ, Xi, p, q)).2 ≤ t := by
            rw [hsubP_eq, hsp_eq, ← hstep_dec]
            exact htE_le
          have hex_p : (path.map Prod.fst)[2 * e.j]? = some e.x := by
            change (leftSpineBottomUpNat (keyedState kops e.step))[2 * e.j + 1]? = some e.x at hex_ls
            rw [hstep_dec] at hex_ls
            change (leftSpineBottomUpNat Ht)[2 * e.j + 1]? = some e.x at hex_ls
            rw [hls_eq] at hex_ls
            exact hex_ls
          have hey_p : (path.map Prod.fst)[2 * e.j + 1]? = some e.y := by
            change (leftSpineBottomUpNat (keyedState kops e.step))[2 * e.j + 2]? = some e.y at hey_ls
            rw [hstep_dec] at hey_ls
            change (leftSpineBottomUpNat Ht)[2 * e.j + 2]? = some e.y at hey_ls
            rw [hls_eq] at hey_ls
            exact hey_ls
          have hez_p : (path.map Prod.fst)[2 * e.j + 2]? = some e.z := by
            change (leftSpineBottomUpNat (keyedState kops e.step))[2 * e.j + 3]? = some e.z at hez_ls
            rw [hstep_dec] at hez_ls
            change (leftSpineBottomUpNat Ht)[2 * e.j + 3]? = some e.z at hez_ls
            rw [hls_eq] at hez_ls
            exact hez_ls
          obtain ⟨hj2_lt_m, hez_eq⟩ := List.getElem?_eq_some_iff.mp hez_p
          rw [List.length_map] at hj2_lt_m
          have hj0_lt : 2 * e.j < path.length := by omega
          have hj1_lt : 2 * e.j + 1 < path.length := by omega
          have hex_fst : (path[2 * e.j]).1 = e.x := by
            rw [List.getElem?_eq_getElem (by simp [hj0_lt])] at hex_p
            simpa using Option.some.inj hex_p
          have hey_fst : (path[2 * e.j + 1]).1 = e.y := by
            rw [List.getElem?_eq_getElem (by simp [hj1_lt])] at hey_p
            simpa using Option.some.inj hey_p
          have hez_fst : (path[2 * e.j + 2]).1 = e.z := by
            simpa using hez_eq
          set path_pre := path.take (2 * e.j)
          set rx := (path[2 * e.j]).2
          set ry := (path[2 * e.j + 1]).2
          set rz := (path[2 * e.j + 2]).2
          set path_post := path.drop (2 * e.j + 3)
          have hpath_split : path = path_pre ++
              [(e.x, rx), (e.y, ry), (e.z, rz)] ++ path_post := by
            have hd0 := h_drop_cons path (2 * e.j) hj0_lt
            have hd1 := h_drop_cons path (2 * e.j + 1) hj1_lt
            have hd2 := h_drop_cons path (2 * e.j + 2) hj2_lt_m
            have hx_pair : path[2 * e.j] = (e.x, rx) := Prod.ext hex_fst rfl
            have hy_pair : path[2 * e.j + 1] = (e.y, ry) := Prod.ext hey_fst rfl
            have hz_pair : path[2 * e.j + 2] = (e.z, rz) := Prod.ext hez_fst rfl
            calc path = path.take (2 * e.j) ++ path.drop (2 * e.j) :=
                  (List.take_append_drop (2 * e.j) path).symm
              _ = path_pre ++ (path[2 * e.j] :: path[2 * e.j + 1] :: path[2 * e.j + 2] :: path_post) := by
                  rw [hd0, hd1, hd2]
              _ = path_pre ++ [(e.x, rx), (e.y, ry), (e.z, rz)] ++ path_post := by
                  rw [hx_pair, hy_pair, hz_pair]; simp [List.append_assoc]
          have hpre_len : path_pre.length = 2 * e.j := by
            simp [path_pre]; omega
          set T_pre := twAttachPoly (.node s .nil c0) path_pre
          have hHt_decomp : Ht = twAttachPoly
              (.node e.z (.node e.y (.node e.x T_pre rx) ry) rz) path_post := by
            rw [hHt_attach, hpath_split, List.append_assoc, h_attach_append]
            rfl
          have hs_in_sp : (subP (ℓ, Xi, p, q)).1 ≤ s ∧ s < (subP (ℓ, Xi, p, q)).2 := by
            rw [hsubP_eq, hsp_eq, ← hes_eq]
            exact ⟨hp_part.2.1, hp_part.2.2.1⟩
          have hy_in_sq : (subQ (ℓ, Xi, p, q)).1 ≤ e.y ∧ e.y < (subQ (ℓ, Xi, p, q)).2 := by
            rw [hsubQ_eq, hsq_eq]
            exact ⟨hq_part.2.1, hq_part.2.2.1⟩
          have hTpre_key : psspHasKeyIn (subP (ℓ, Xi, p, q)).1 (subP (ℓ, Xi, p, q)).2 T_pre = true := by
            apply h_attach_hasKey
            have hs_dec : decide ((subP (ℓ, Xi, p, q)).1 ≤ s ∧ s < (subP (ℓ, Xi, p, q)).2) = true :=
              decide_eq_true hs_in_sp
            simp [psspHasKeyIn, hs_dec]
          have hanc_t : psspHasAncDesc (subP (ℓ, Xi, p, q)).1 (subP (ℓ, Xi, p, q)).2
              (subQ (ℓ, Xi, p, q)).1 (subQ (ℓ, Xi, p, q)).2 Ht = true := by
            rw [hHt_decomp]
            apply h_attach_ancDesc
            have hy_dec : decide ((subQ (ℓ, Xi, p, q)).1 ≤ e.y ∧ e.y < (subQ (ℓ, Xi, p, q)).2) = true :=
              decide_eq_true hy_in_sq
            have hx_key : psspHasKeyIn (subP (ℓ, Xi, p, q)).1 (subP (ℓ, Xi, p, q)).2
                (.node e.x T_pre rx) = true := by
              simp [psspHasKeyIn, hTpre_key]
            have hy_anc : psspHasAncDesc (subP (ℓ, Xi, p, q)).1 (subP (ℓ, Xi, p, q)).2
                (subQ (ℓ, Xi, p, q)).1 (subQ (ℓ, Xi, p, q)).2
                (.node e.y (.node e.x T_pre rx) ry) = true := by
              simp [psspHasAncDesc, hy_dec, hx_key]
            unfold psspHasAncDesc
            rw [hy_anc]
            simp
          have hHt_bst : _root_.BinaryTree.IsBST Ht := hkvalid.isBST_state t (by omega)
          rw [hHt_decomp] at hHt_bst
          obtain ⟨hbst_z, hpost_bst⟩ := h_attach_bst path_post _ hHt_bst
          cases hbst_z using isBSTCases with
          | node _ _ _ _ hrz_gt hbst_y _ =>
            cases hbst_y using isBSTCases with
            | node _ _ _ _ hry_gt hbst_x _ =>
              cases hbst_x using isBSTCases with
              | node _ _ _ hTpre_lt hrx_gt hTpre_bst _ =>
                have h_attach_forall : ∀ (ps : List (ℕ × _root_.BinaryTree ℕ)) (U : _root_.BinaryTree ℕ),
                    _root_.SplayDeque.Direct.ForallTree (fun v => v < e.x) (twAttachPoly U ps) →
                    _root_.SplayDeque.Direct.ForallTree (fun v => v < e.x) U ∧
                      ∀ kr ∈ ps, kr.1 < e.x ∧ _root_.SplayDeque.Direct.ForallTree (fun v => v < e.x) kr.2 := by
                  intro ps
                  induction ps with
                  | nil =>
                    intro U hf; exact ⟨hf, by simp⟩
                  | cons kr rest ih =>
                    intro U hf
                    obtain ⟨hnode_f, hrest_f⟩ := ih (.node kr.1 U kr.2) hf
                    cases hnode_f with
                    | node _ _ _ hU_f hkr1 hkr2 =>
                      refine ⟨hU_f, ?_⟩
                      intro kr' hkr'
                      rcases List.mem_cons.mp hkr' with rfl | hmem
                      · exact ⟨hkr1, hkr2⟩
                      · exact hrest_f kr' hmem
                obtain ⟨hnode_s_lt, hpre_lt⟩ := h_attach_forall path_pre (.node s .nil c0) hTpre_lt
                have hc0_lt : _root_.SplayDeque.Direct.ForallTree (fun v => v < e.x) c0 := by
                  cases hnode_s_lt with
                  | node _ _ _ _ _ hc0_f => exact hc0_f
                set cj := splayLeftSpineNat c0 path_pre
                have hcj_lt : _root_.SplayDeque.Direct.ForallTree (fun v => v < e.x) cj :=
                  h_splay_forall (fun v => v < e.x) path_pre.length path_pre c0 le_rfl hc0_lt hpre_lt
                have hcj_anc_f : psspHasAncDesc (subP (ℓ, Xi, p, q)).1 (subP (ℓ, Xi, p, q)).2
                    (subQ (ℓ, Xi, p, q)).1 (subQ (ℓ, Xi, p, q)).2 cj = false :=
                  h_forall_no_ancDesc _ _ _ _ cj
                    (h_forall_imp (fun v hv => Or.inl (by rw [hsubQ_eq]; omega)) hcj_lt)
                have hrxy_gt_sp : _root_.SplayDeque.Direct.ForallTree
                    (fun v => v < (subP (ℓ, Xi, p, q)).1 ∨ (subP (ℓ, Xi, p, q)).2 ≤ v)
                    (.node e.y rx ry) := by
                  refine .node rx e.y ry ?_ (Or.inr (by rw [hsubP_eq]; omega)) ?_
                  · exact h_forall_imp (fun v hv => Or.inr (by rw [hsubP_eq]; omega)) hrx_gt
                  · exact h_forall_imp (fun v hv => Or.inr (by rw [hsubP_eq]; omega)) hry_gt
                have hrxy_key_f : psspHasKeyIn (subP (ℓ, Xi, p, q)).1 (subP (ℓ, Xi, p, q)).2
                    (.node e.y rx ry) = false :=
                  h_forall_no_key _ _ _ hrxy_gt_sp
                have hrxy_anc_f : psspHasAncDesc (subP (ℓ, Xi, p, q)).1 (subP (ℓ, Xi, p, q)).2
                    (subQ (ℓ, Xi, p, q)).1 (subQ (ℓ, Xi, p, q)).2 (.node e.y rx ry) = false := by
                  cases h : psspHasAncDesc (subP (ℓ, Xi, p, q)).1
                      (subP (ℓ, Xi, p, q)).2 (subQ (ℓ, Xi, p, q)).1 (subQ (ℓ, Xi, p, q)).2
                      (.node e.y rx ry)
                  · rfl
                  · have hkey := h_ancDesc_imp_hasKey _ _ _ _ _ h
                    rw [hrxy_key_f] at hkey; cases hkey
                have hx_q_f : decide ((subQ (ℓ, Xi, p, q)).1 ≤ e.x ∧ e.x < (subQ (ℓ, Xi, p, q)).2) = false := by
                  rw [decide_eq_false_iff_not, hsubQ_eq]; omega
                have hcinit_anc_f : psspHasAncDesc (subP (ℓ, Xi, p, q)).1 (subP (ℓ, Xi, p, q)).2
                    (subQ (ℓ, Xi, p, q)).1 (subQ (ℓ, Xi, p, q)).2
                    (.node e.x cj (.node e.y rx ry)) = false := by
                  unfold psspHasAncDesc
                  rw [hx_q_f, hcj_anc_f, hrxy_anc_f]
                  rfl
                have hnext_splay : keyedState kops (t + 1) =
                    splayLeftSpineNat (.node e.x cj (.node e.y rx ry))
                      ((e.z, rz) :: path_post) := by
                  rw [hHt_next, hpath_split, List.append_assoc,
                    h_splay_even_append e.j path_pre _ c0 hpre_len]
                  rfl
                have hanc_next_f : psspHasAncDesc (subP (ℓ, Xi, p, q)).1 (subP (ℓ, Xi, p, q)).2
                    (subQ (ℓ, Xi, p, q)).1 (subQ (ℓ, Xi, p, q)).2
                    (keyedState kops (t + 1)) = false := by
                  rw [hnext_splay]
                  refine h_splay_kill_tail _ _ _ _ ((e.z, rz) :: path_post).length
                    ((e.z, rz) :: path_post) _ le_rfl hcinit_anc_f ?_
                  intro kr hkr
                  rcases List.mem_cons.mp hkr with rfl | hkr_post
                  · refine ⟨by rw [hsubQ_eq]; omega, ?_⟩
                    exact h_forall_imp (fun v hv => by rw [hsubQ_eq]; omega) hrz_gt
                  · obtain ⟨hz_lt_kr, hkr2_gt⟩ := hpost_bst kr hkr_post
                    have hez_lt_kr1 : e.z < kr.1 := by
                      cases hz_lt_kr with
                      | node _ _ _ _ hk _ => exact hk
                    refine ⟨by rw [hsubQ_eq]; omega, ?_⟩
                    exact h_forall_imp (fun v hv => by rw [hsubQ_eq]; omega) hkr2_gt
                simp only [Finset.mem_coe, Finset.mem_sdiff, psiSet, Finset.mem_filter]
                refine ⟨⟨hq0_U, ?_⟩, ?_⟩
                · simp only [active, Bool.and_eq_true, decide_eq_true_eq]
                  exact ⟨htE_cur, hanc_t⟩
                · simp [active, hanc_next_f]

        have h_phi_lt_absurd : ∀ id1 id2 : ℕ,
            id1 ∈ b3pSetAt t → id2 ∈ b3pSetAt t →
            id1 < id2 → phi id1 = phi id2 → False := by
          intro id1 id2 hm1 hm2 hlt hfeq
          simp only [b3pSetAt, Finset.mem_filter, B_3_post, Finset.mem_range, isB3Post] at hm1 hm2
          obtain ⟨⟨hid1, hb1⟩, hst1⟩ := hm1
          obtain ⟨⟨hid2, hb2⟩, hst2⟩ := hm2
          rw [List.getElem?_eq_getElem hid1] at hb1 hst1
          rw [List.getElem?_eq_getElem hid2] at hb2 hst2
          simp only [decide_eq_true_eq] at hb1 hb2 hst1 hst2
          simp only [phi, List.getElem?_eq_getElem hid1, List.getElem?_eq_getElem hid2,
            Prod.mk.injEq] at hfeq
          obtain ⟨_, _, _, _, _, _, _, _, ⟨_, _, _, _, hz1_ls⟩, _⟩ := hjump.jump_anatomies id1 hid1
          obtain ⟨_, _, _, _, _, _, _, hzP2, ⟨_, _, _, hy2_ls, _⟩, _⟩ := hjump.jump_anatomies id2 hid2
          set e1 := (jumps kops)[id1]
          set e2 := (jumps kops)[id2]
          have hj_lt : e1.j < e2.j := by
            rcases hjump.jump_order id1 hid1 id2 hid2 hlt with hst | ⟨_, hj⟩
            · change e1.step < e2.step at hst; omega
            · exact hj
          have hls_pw : List.Pairwise (· < ·) (leftSpineBottomUpNat Ht) :=
            h_bst_ls Ht (hkvalid.isBST_state t (by omega))
          change (leftSpineBottomUpNat (keyedState kops e1.step))[2 * e1.j + 3]? = some e1.z at hz1_ls
          change (leftSpineBottomUpNat (keyedState kops e2.step))[2 * e2.j + 2]? = some e2.y at hy2_ls
          rw [hst1] at hz1_ls
          rw [hst2] at hy2_ls
          obtain ⟨hz1_lt, hz1_eq⟩ := List.getElem?_eq_some_iff.mp hz1_ls
          obtain ⟨hy2_lt, hy2_eq⟩ := List.getElem?_eq_some_iff.mp hy2_ls
          have hz1_lt_y2 : e1.z < e2.y := by
            rw [← hz1_eq, ← hy2_eq]
            exact (List.pairwise_iff_getElem.mp hls_pw) (2 * e1.j + 3) (2 * e2.j + 2)
              hz1_lt hy2_lt (by omega)
          obtain ⟨hℓ_eq, hXi_eq, _, hq_eq⟩ := hfeq
          set ℓ1 := sepScale S P L e1.x e1.y
          set ℓ2 := sepScale S P L e2.x e2.y
          set Xi1 := blockIdx S P (ℓ1 - 1) e1.x
          set Xi2 := blockIdx S P (ℓ2 - 1) e2.x
          have hex2_P : e2.x < P := by omega
          have hey2_P : e2.y < P := by omega
          have hXi2_lt : Xi2 < (scaleBlocks S P (ℓ2 - 1)).length :=
            (hpart.blocks_partition _ (by omega) e2.x hex2_P).1
          obtain ⟨_, _, _, _, _, hXi2_iff, hsub2_of, _⟩ :=
            hpart.child_blocks ℓ2 hb2.1 hb2.2.1 Xi2 hXi2_lt
          have hey2_Xi : blockIdx S P (ℓ2 - 1) e2.y = Xi2 := by
            symm
            exact (hpart.sep_gt_iff _ (by omega) e2.x hex2_P e2.y hey2_P).mp (by omega)
          have hey2_X := (hXi2_iff e2.y hey2_P).mp hey2_Xi
          have hsq2 := (hsub2_of e2.y hey2_X.1 hey2_X.2).2
          have hex1_P : e1.x < P := by omega
          have hey1_P : e1.y < P := by omega
          have hXi1_lt : Xi1 < (scaleBlocks S P (ℓ1 - 1)).length :=
            (hpart.blocks_partition _ (by omega) e1.x hex1_P).1
          obtain ⟨_, _, _, _, _, hXi1_iff, hsub1_of, _⟩ :=
            hpart.child_blocks ℓ1 hb1.1 hb1.2.1 Xi1 hXi1_lt
          have hey1_Xi : blockIdx S P (ℓ1 - 1) e1.y = Xi1 := by
            symm
            exact (hpart.sep_gt_iff _ (by omega) e1.x hex1_P e1.y hey1_P).mp (by omega)
          have hey1_X := (hXi1_iff e1.y hey1_P).mp hey1_Xi
          have hsq1 := (hsub1_of e1.y hey1_X.1 hey1_X.2).2
          have hby_eq : blockOf S P ℓ1 e1.y = blockOf S P ℓ2 e2.y := by
            rw [← hsq1, ← hsq2, hq_eq, hXi_eq, hℓ_eq]
          have hy2_lt_b2 : e2.y < (blockOf S P ℓ2 e2.y).2 :=
            (hpart.blocks_partition _ hb2.2.1 e2.y hey2_P).2.2.1
          rw [← hby_eq] at hy2_lt_b2
          have hb1_le_z1 : (blockOf S P ℓ1 e1.y).2 ≤ e1.z := hb1.2.2.2.1
          omega

        have h_phi_inj : Set.InjOn phi ↑(b3pSetAt t) := by
          intro id1 hm1 id2 hm2 hfeq
          by_contra hne
          rcases lt_trichotomy id1 id2 with hlt | heq | hgt
          · exact h_phi_lt_absurd id1 id2 hm1 hm2 hlt hfeq
          · exact hne heq
          · exact h_phi_lt_absurd id2 id1 hm2 hm1 hgt hfeq.symm

        have hcard_b3p := Finset.card_le_card_of_injOn phi h_phi_maps h_phi_inj
        have hcard_sdiff := Finset.card_sdiff_add_card_eq_card h_sub
        simp only [psiPost, hr0]
        omega

    have h_sum_b3p : (∑ t ∈ Finset.range kops.length, (b3pSetAt t).card) =
        (B_3_post S P L kops).card := by
      have h_biU : (Finset.range kops.length).biUnion b3pSetAt = B_3_post S P L kops := by
        ext id
        simp only [Finset.mem_biUnion, Finset.mem_range, b3pSetAt, Finset.mem_filter]
        constructor
        · rintro ⟨_, _, hid, _⟩; exact hid
        · intro hid
          have hid_lt : id < (jumps kops).length := by
            simp only [B_3_post, Finset.mem_filter, Finset.mem_range] at hid
            exact hid.1
          obtain ⟨_, hstep_lt, _⟩ := hjump.jump_anatomies id hid_lt
          refine ⟨((jumps kops)[id]).step, hstep_lt, hid, ?_⟩
          simp [List.getElem?_eq_getElem hid_lt]
      have h_disj : Set.PairwiseDisjoint ↑(Finset.range kops.length) b3pSetAt := by
        intro t1 _ t2 _ hne
        change Disjoint (b3pSetAt t1) (b3pSetAt t2)
        rw [Finset.disjoint_left]
        intro id hm1 hm2
        simp only [b3pSetAt, Finset.mem_filter] at hm1 hm2
        obtain ⟨hid_b3p, h1⟩ := hm1
        obtain ⟨_, h2⟩ := hm2
        have hid_lt : id < (jumps kops).length := by
          simp only [B_3_post, Finset.mem_filter, Finset.mem_range] at hid_b3p
          exact hid_b3p.1
        rw [List.getElem?_eq_getElem hid_lt, decide_eq_true_eq] at h1 h2
        exact hne (h1.symm.trans h2)
      rw [← h_biU, Finset.card_biUnion h_disj]

    have h_sum_rslr : (∑ t ∈ Finset.range kops.length, isRslrNat t) = countKeyedRslr kops := by
      have h_aux : ∀ xs : List KeyedCoreOp,
          (∑ t ∈ Finset.range xs.length,
            match xs[t]? with
            | some (.rslr _) => 1
            | _ => 0) = countKeyedRslr xs := by
        intro xs
        induction xs with
        | nil => simp [countKeyedRslr]
        | cons op rest ih =>
          rw [List.length_cons, Finset.sum_range_succ']
          simp only [List.getElem?_cons_zero, List.getElem?_cons_succ, ih]
          rcases op with _ | _ | _
          · simp [countKeyedRslr]
          · simp [countKeyedRslr]
          · simp [countKeyedRslr]; omega
      exact h_aux kops

    have h_sum_tele : ∀ (N : ℕ) (f : ℕ → ℕ),
        (∑ t ∈ Finset.range N, f (t + 1)) + f 0 = (∑ t ∈ Finset.range N, f t) + f N := by
      intro N f
      induction N with
      | zero => simp
      | succ N ih =>
        rw [Finset.sum_range_succ, Finset.sum_range_succ]
        omega

    have h_sum_ineq :
        ∑ t ∈ Finset.range kops.length, ((b3pSetAt t).card + psiPost (t + 1)) ≤
        ∑ t ∈ Finset.range kops.length, (psiPost t + isRslrNat t) := by
      apply Finset.sum_le_sum
      intro t ht
      exact h_step_ineq t (Finset.mem_range.mp ht)

    rw [Finset.sum_add_distrib, Finset.sum_add_distrib, h_sum_b3p, h_sum_rslr] at h_sum_ineq
    have htele := h_sum_tele kops.length psiPost
    rw [h_psi_zero, h_psi_end] at htele
    omega




  have hproj : ∀ (lo hi : ℕ), lo < hi → hi ≤ P →
      ∃ subOps : List CoreOp,
        ValidCoreSeq (hi - lo) subOps ∧
        ((Finset.range (jumps kops).length).filter (fun id =>
          (match (jumps kops)[id]? with
          | none => false
          | some e => decide (lo ≤ e.s ∧ e.z < hi)) = true)).card ≤
            coreCascadeCost subOps := by
    intro lo hi hlo_hi hhi_P
    have h_forall_and : ∀ {p q : ℕ → Prop} {T : _root_.BinaryTree ℕ},
        _root_.SplayDeque.Direct.ForallTree p T → _root_.SplayDeque.Direct.ForallTree q T →
        _root_.SplayDeque.Direct.ForallTree (fun x => p x ∧ q x) T := by
      intro p q T hp hq
      induction hp with
      | left => exact .left
      | node l key r _ hk _ ihl ihr =>
        cases hq with
        | node _ _ _ hl' hk' hr' => exact .node l key r (ihl hl') ⟨hk, hk'⟩ (ihr hr')

    have h_forall_imp : ∀ {p q : ℕ → Prop} {T : _root_.BinaryTree ℕ},
        (∀ x, p x → q x) → _root_.SplayDeque.Direct.ForallTree p T → _root_.SplayDeque.Direct.ForallTree q T := by
      intro p q T hpq hT
      induction hT with
      | left => exact .left
      | node l key r _ hk _ ihl ihr => exact .node l key r ihl (hpq key hk) ihr

    have h_bst_ls_aux : ∀ (T : _root_.BinaryTree ℕ) (acc : List ℕ),
        _root_.BinaryTree.IsBST T →
        List.Pairwise (· < ·) acc →
        _root_.SplayDeque.Direct.ForallTree (fun x => ∀ a ∈ acc, x < a) T →
        List.Pairwise (· < ·) (leftSpineBottomUpAux T acc) := by
      intro T
      induction T with
      | nil => intro acc _ hpw _; exact hpw
      | node k l r ihl _ =>
        intro acc hbst hpw hfa
        cases hbst using isBSTCases with
        | node _ _ _ hl_lt _ hl_bst _ =>
          cases hfa with
          | node _ _ _ hl_fa hk_acc _ =>
            simp only [leftSpineBottomUpAux]
            apply ihl (k :: acc) hl_bst (List.Pairwise.cons hk_acc hpw)
            refine h_forall_imp ?_ (h_forall_and hl_lt hl_fa)
            intro x ⟨hxk, hxacc⟩ a ha
            rcases List.mem_cons.mp ha with rfl | ha'
            · exact hxk
            · exact hxacc a ha'

    have h_bst_ls : ∀ T : _root_.BinaryTree ℕ,
        _root_.BinaryTree.IsBST T → List.Pairwise (· < ·) (leftSpineBottomUpNat T) := by
      intro T hbst
      refine h_bst_ls_aux T [] hbst List.Pairwise.nil ?_
      have h_true : ∀ U : _root_.BinaryTree ℕ, _root_.SplayDeque.Direct.ForallTree (fun x => ∀ a ∈ ([] : List ℕ), x < a) U := by
        intro U; induction U with
        | nil => exact .left
        | node k l r ihl ihr => exact .node l k r ihl (by simp) ihr
      exact h_true T

    have h_erase_eq_empty : ∀ T : _root_.BinaryTree ℕ, eraseNatKeys T = .nil ↔ T = .nil := by
      intro T
      cases T <;> simp [eraseNatKeys]

    have h_erase_rs : ∀ T : _root_.BinaryTree ℕ,
        rightSpineLen (eraseNatKeys T) = (rightSpineTopDownNat T).length := by
      intro T
      induction T with
      | nil => rfl
      | node k l r _ ihr =>
        simp only [eraseNatKeys, rightSpineLen, rightSpineTopDownNat, List.length_cons, ihr]
        omega

    have h_erase_rotL : ∀ (d : ℕ) (T : _root_.BinaryTree ℕ),
        eraseNatKeys (rotateLeftAtRightDepthNat T d) = rotateLeftAtRightDepth (eraseNatKeys T) d := by
      intro d
      induction d with
      | zero =>
        intro T
        rcases T with _ | ⟨x, a, _ | ⟨y, b, c⟩⟩ <;> rfl
      | succ d ih =>
        intro T
        rcases T with _ | ⟨k, l, r⟩
        · rfl
        · simp only [rotateLeftAtRightDepthNat, eraseNatKeys, rotateLeftAtRightDepth, ih r]

    have h_erase_descend : ∀ (T : _root_.BinaryTree ℕ) (acc : List (ℕ × _root_.BinaryTree ℕ)),
        descendLeft (eraseNatKeys T) (acc.map (fun p => eraseNatKeys p.2)) =
          (eraseNatKeys (descendLeftNat T acc).1,
            (descendLeftNat T acc).2.map (fun p => eraseNatKeys p.2)) := by
      intro T
      induction T with
      | nil => intro acc; simp [eraseNatKeys, descendLeft, descendLeftNat]
      | node k l r ihl _ =>
        intro acc
        rcases l with _ | ⟨lk, ll, lr⟩
        · simp [eraseNatKeys, descendLeft, descendLeftNat]
        · simpa [eraseNatKeys, descendLeft, descendLeftNat] using ihl ((k, r) :: acc)

    have h_erase_splay : ∀ (n : ℕ) (path : List (ℕ × _root_.BinaryTree ℕ)) (c : _root_.BinaryTree ℕ),
        path.length ≤ n →
        splayLeftSpine (eraseNatKeys c) (path.map (fun p => eraseNatKeys p.2)) =
          eraseNatKeys (splayLeftSpineNat c path) := by
      intro n
      induction n with
      | zero =>
        intro path c hlen
        rcases path with _ | ⟨_, _⟩
        · rfl
        · simp at hlen
      | succ n ih =>
        intro path c hlen
        rcases path with _ | ⟨⟨k1, r1⟩, _ | ⟨⟨k2, r2⟩, rest⟩⟩
        · rfl
        · rfl
        · simp only [List.map_cons, splayLeftSpine, splayLeftSpineNat]
          exact ih rest (.node k1 c (.node k2 r1 r2)) (by simp at hlen; omega)

    have h_erase_pop : ∀ T : _root_.BinaryTree ℕ,
        eraseNatKeys (popNat T) = popUnlabeled (eraseNatKeys T) := by
      intro T
      unfold popNat popUnlabeled
      have hd := h_erase_descend T []
      simp only [List.map_nil] at hd
      rw [hd]
      exact (h_erase_splay (descendLeftNat T []).2.length (descendLeftNat T []).2
        (descendLeftNat T []).1 le_rfl).symm

    have h_erase_ls_len : ∀ (T : _root_.BinaryTree ℕ) (acc : List (ℕ × _root_.BinaryTree ℕ)),
        T ≠ .nil →
        (descendLeftNat T acc).2.length + 1 = leftSpineLen (eraseNatKeys T) + acc.length := by
      intro T
      induction T with
      | nil => intro _ h; exact absurd rfl h
      | node k l r ihl _ =>
        intro acc _
        rcases l with _ | ⟨lk, ll, lr⟩
        · simp [descendLeftNat, eraseNatKeys, leftSpineLen]; omega
        · have h1 := ihl ((k, r) :: acc) (by simp)
          simp only [descendLeftNat, List.length_cons, eraseNatKeys, leftSpineLen] at h1 ⊢
          omega

    let listNodes : List (_root_.BinaryTree Unit) → ℕ := fun xs =>
      xs.foldr (fun x acc => 1 + x.num_nodes + acc) 0

    have h_rotL_nodes :
        ∀ (d : ℕ) (t : _root_.BinaryTree Unit), (rotateLeftAtRightDepth t d).num_nodes = t.num_nodes := by
      intro d
      induction d with
      | zero =>
        intro t
        rcases t with _ | ⟨u1, a, _ | ⟨u2, b, c⟩⟩ <;>
          (simp [rotateLeftAtRightDepth, _root_.BinaryTree.rotateLeft, _root_.BinaryTree.num_nodes]; try omega)
      | succ d ih =>
        intro t
        rcases t with _ | ⟨u, l, r⟩
        · rfl
        · simp only [rotateLeftAtRightDepth, _root_.BinaryTree.num_nodes, ih r]

    have h_descend_nodes :
        ∀ (u : _root_.BinaryTree Unit) (acc : List (_root_.BinaryTree Unit)),
          u ≠ .nil →
          (descendLeft u acc).1.num_nodes + listNodes (descendLeft u acc).2 + 1 =
            u.num_nodes + listNodes acc := by
      intro u
      induction u with
      | nil => intro _ h; exact absurd rfl h
      | node u0 l r ihl _ =>
        intro acc _
        rcases l with _ | ⟨lu, ll, lr⟩
        · simp only [descendLeft]
          change r.num_nodes + listNodes acc + 1 = (1 + 0 + r.num_nodes) + listNodes acc
          omega
        · have h1 := ihl (r :: acc) (by simp)
          simp only [descendLeft]
          change (descendLeft (.node lu ll lr) (r :: acc)).1.num_nodes +
            listNodes (descendLeft (.node lu ll lr) (r :: acc)).2 + 1 =
            (1 + (1 + ll.num_nodes + lr.num_nodes) + r.num_nodes) + listNodes acc
          change (descendLeft (.node lu ll lr) (r :: acc)).1.num_nodes +
            listNodes (descendLeft (.node lu ll lr) (r :: acc)).2 + 1 =
            (1 + ll.num_nodes + lr.num_nodes) + (1 + r.num_nodes + listNodes acc) at h1
          omega

    have h_splay_nodes :
        ∀ (n : ℕ) (c : _root_.BinaryTree Unit) (path : List (_root_.BinaryTree Unit)),
          path.length ≤ n →
          (splayLeftSpine c path).num_nodes = c.num_nodes + listNodes path := by
      intro n
      induction n with
      | zero =>
        intro c path hlen
        rcases path with _ | ⟨r1, rest⟩
        · change c.num_nodes = c.num_nodes + 0; omega
        · simp at hlen
      | succ n ih =>
        intro c path hlen
        rcases path with _ | ⟨r1, _ | ⟨r2, rest⟩⟩
        · change c.num_nodes = c.num_nodes + 0; omega
        · change 1 + c.num_nodes + r1.num_nodes = c.num_nodes + (1 + r1.num_nodes + 0); omega
        · have hrest : rest.length ≤ n := by simp at hlen; omega
          have h1 := ih (.node () c (.node () r1 r2)) rest hrest
          change (splayLeftSpine (.node () c (.node () r1 r2)) rest).num_nodes =
            c.num_nodes + (1 + r1.num_nodes + (1 + r2.num_nodes + listNodes rest))
          simp only [_root_.BinaryTree.num_nodes] at h1
          omega

    have h_pop_nodes :
        ∀ t : _root_.BinaryTree Unit, t ≠ .nil → (popUnlabeled t).num_nodes + 1 = t.num_nodes := by
      intro t ht
      unfold popUnlabeled
      have hd := h_descend_nodes t [] ht
      have hs := h_splay_nodes (descendLeft t []).2.length (descendLeft t []).1
        (descendLeft t []).2 le_rfl
      change (descendLeft t []).1.num_nodes + listNodes (descendLeft t []).2 + 1 =
        t.num_nodes + 0 at hd
      dsimp (config := { failIfUnchanged := false }) only at hs ⊢
      omega

    have h_steps_append : ∀ (ops1 ops2 : List CoreOp) (u1 u2 u3 : _root_.BinaryTree Unit),
        TwValidCoreSteps u1 ops1 u2 → TwValidCoreSteps u2 ops2 u3 →
        TwValidCoreSteps u1 (ops1 ++ ops2) u3 := by
      intro ops1
      induction ops1 with
      | nil =>
        intro ops2 u1 u2 u3 h1 h2
        subst h1; exact h2
      | cons op rest ih =>
        intro ops2 u1 u2 u3 h1 h2
        cases op with
        | push => exact ih ops2 (.node () .nil u1) u2 u3 h1 h2
        | pop => exact ⟨h1.1, ih ops2 (popUnlabeled u1) u2 u3 h1.2 h2⟩
        | rslr d => exact ⟨h1.1, ih ops2 (rotateLeftAtRightDepth u1 d) u2 u3 h1.2 h2⟩

    have h_steps_to_aux : ∀ (ops : List CoreOp) (u : _root_.BinaryTree Unit),
        TwValidCoreSteps u ops .nil → ValidCoreSeqAux u ops := by
      intro ops
      induction ops with
      | nil => intro u h; exact h
      | cons op rest ih =>
        intro u h
        cases op with
        | push => exact ih (.node () .nil u) h
        | pop => exact ⟨h.1, ih (popUnlabeled u) h.2⟩
        | rslr d => exact ⟨h.1, ih (rotateLeftAtRightDepth u d) h.2⟩

    have h_cost_append : ∀ (ops1 ops2 : List CoreOp) (u1 u2 : _root_.BinaryTree Unit),
        TwValidCoreSteps u1 ops1 u2 →
        coreCascadeCostAux u1 (ops1 ++ ops2) =
          coreCascadeCostAux u1 ops1 + coreCascadeCostAux u2 ops2 := by
      intro ops1
      induction ops1 with
      | nil =>
        intro ops2 u1 u2 h1
        subst h1; simp [coreCascadeCostAux]
      | cons op rest ih =>
        intro ops2 u1 u2 h1
        cases op with
        | push =>
          simp only [List.cons_append, coreCascadeCostAux, execCoreOp, ih ops2 _ u2 h1]
          omega
        | pop =>
          simp only [List.cons_append, coreCascadeCostAux, execCoreOp, ih ops2 _ u2 h1.2]
          omega
        | rslr d =>
          simp only [List.cons_append, coreCascadeCostAux, execCoreOp, ih ops2 _ u2 h1.2]
          omega

    have h_push_append : ∀ (ops1 ops2 : List CoreOp),
        countCorePush (ops1 ++ ops2) = countCorePush ops1 + countCorePush ops2 := by
      intro ops1 ops2
      induction ops1 with
      | nil => simp [countCorePush]
      | cons op rest ih =>
        rcases op with _ | _ | _
        · simp [countCorePush, ih]; omega
        · simp [countCorePush, ih]
        · simp [countCorePush, ih]

    have h_pop_append : ∀ (ops1 ops2 : List CoreOp),
        countCorePop (ops1 ++ ops2) = countCorePop ops1 + countCorePop ops2 := by
      intro ops1 ops2
      induction ops1 with
      | nil => simp [countCorePop]
      | cons op rest ih =>
        rcases op with _ | _ | _
        · simp [countCorePop, ih]
        · simp [countCorePop, ih]; omega
        · simp [countCorePop, ih]

    have h_steps_nodes : ∀ (ops : List CoreOp) (u1 u2 : _root_.BinaryTree Unit),
        TwValidCoreSteps u1 ops u2 →
        u1.num_nodes + countCorePush ops = u2.num_nodes + countCorePop ops := by
      intro ops
      induction ops with
      | nil =>
        intro u1 u2 h
        subst h; simp [countCorePush, countCorePop]
      | cons op rest ih =>
        intro u1 u2 h
        cases op with
        | push =>
          have h1 := ih (.node () .nil u1) u2 h
          simp only [_root_.BinaryTree.num_nodes, countCorePush, countCorePop] at h1 ⊢
          omega
        | pop =>
          have h1 := ih (popUnlabeled u1) u2 h.2
          have hp := h_pop_nodes u1 h.1
          simp only [countCorePush, countCorePop]
          omega
        | rslr d =>
          have h1 := ih (rotateLeftAtRightDepth u1 d) u2 h.2
          rw [h_rotL_nodes d u1] at h1
          simpa [countCorePush, countCorePop] using h1

    have h_rs_le_nodes : ∀ u : _root_.BinaryTree Unit, rightSpineLen u ≤ u.num_nodes := by
      intro u
      induction u with
      | nil => simp [rightSpineLen, _root_.BinaryTree.num_nodes]
      | node _ l r _ ihr =>
        simp only [rightSpineLen, _root_.BinaryTree.num_nodes]
        omega

    have h_build_aux : ∀ (fuel : ℕ) (u : _root_.BinaryTree Unit),
        2 * u.num_nodes - rightSpineLen u ≤ fuel →
        TwValidCoreSteps .nil (twBuildFromEmptyAux fuel u) u ∧
        countCorePush (twBuildFromEmptyAux fuel u) = u.num_nodes ∧
        countCorePop (twBuildFromEmptyAux fuel u) = 0 := by
      intro fuel
      induction fuel with
      | zero =>
        intro u hfuel
        rcases u with _ | ⟨_, l, r⟩
        · exact ⟨rfl, rfl, rfl⟩
        · have hrs := h_rs_le_nodes r
          simp only [_root_.BinaryTree.num_nodes, rightSpineLen] at hfuel
          omega
      | succ fuel ih =>
        intro u hfuel
        rcases u with _ | ⟨_, _ | ⟨_, a, b⟩, r⟩
        · exact ⟨rfl, rfl, rfl⟩
        · have hrs := h_rs_le_nodes r
          have hsub : 2 * r.num_nodes - rightSpineLen r ≤ fuel := by
            simp only [_root_.BinaryTree.num_nodes, rightSpineLen] at hfuel
            omega
          obtain ⟨hst, hpush, hpop⟩ := ih r hsub
          simp only [twBuildFromEmptyAux]
          refine ⟨h_steps_append _ [.push] .nil r _ hst rfl, ?_, ?_⟩
          · rw [h_push_append, hpush]; simp [countCorePush, _root_.BinaryTree.num_nodes]; omega
          · rw [h_pop_append, hpop]; rfl
        · have hrs := h_rs_le_nodes r
          let u' : _root_.BinaryTree Unit := .node () a (.node () b r)
          have hsub : 2 * u'.num_nodes - rightSpineLen u' ≤ fuel := by
            simp only [u', _root_.BinaryTree.num_nodes, rightSpineLen] at hfuel ⊢
            omega
          obtain ⟨hst, hpush, hpop⟩ := ih u' hsub
          simp only [twBuildFromEmptyAux]
          have hrslr_step : TwValidCoreSteps u' [.rslr 0] (.node () (.node () a b) r) := by
            refine ⟨?_, rfl⟩
            simp [u', rightSpineLen]
            omega
          refine ⟨h_steps_append _ [.rslr 0] .nil u' _ hst hrslr_step, ?_, ?_⟩
          · rw [h_push_append, hpush]
            simp [u', countCorePush, _root_.BinaryTree.num_nodes]
            omega
          · rw [h_pop_append, hpop]; rfl

    have h_build : ∀ u : _root_.BinaryTree Unit,
        TwValidCoreSteps .nil (twBuildFromEmpty u) u ∧
        countCorePush (twBuildFromEmpty u) = u.num_nodes ∧
        countCorePop (twBuildFromEmpty u) = 0 :=
      fun u => h_build_aux (2 * u.num_nodes - rightSpineLen u) u le_rfl

    have hR_node : ∀ (l : _root_.BinaryTree ℕ) (k : ℕ) (r : _root_.BinaryTree ℕ),
        restrictRangeNat 0 hi (.node k l r) =
          if hi ≤ k then restrictRangeNat 0 hi l
          else .node k (restrictRangeNat 0 hi l) (restrictRangeNat 0 hi r) := by
      intro l k r
      simp [restrictRangeNat]

    have hR_all_ge : ∀ T : _root_.BinaryTree ℕ,
        _root_.SplayDeque.Direct.ForallTree (fun v => hi ≤ v) T → restrictRangeNat 0 hi T = .nil := by
      intro T hfa
      induction hfa with
      | left => rfl
      | node l k r _ hk _ ihl _ =>
        rw [hR_node, if_pos hk, ihl]

    have h_rs_forall : ∀ {p : ℕ → Prop} (idx : ℕ) (T : _root_.BinaryTree ℕ),
        _root_.SplayDeque.Direct.ForallTree p T →
        idx < (rightSpineTopDownNat T).length →
        p ((rightSpineTopDownNat T).getD idx hi) := by
      intro p idx
      induction idx with
      | zero =>
        intro T hfa hlen
        rcases T with _ | ⟨k, l, r⟩
        · simp [rightSpineTopDownNat] at hlen
        · cases hfa with
          | node _ _ _ _ hk _ => exact hk
      | succ idx ih =>
        intro T hfa hlen
        rcases T with _ | ⟨k, l, r⟩
        · simp [rightSpineTopDownNat] at hlen
        · cases hfa with
          | node _ _ _ _ _ hr =>
            exact ih r hr (by simp [rightSpineTopDownNat] at hlen; omega)

    have hR_rslr : ∀ (d : ℕ) (T : _root_.BinaryTree ℕ),
        _root_.BinaryTree.IsBST T →
        d + 2 ≤ (rightSpineTopDownNat T).length →
        let y := (rightSpineTopDownNat T).getD (d + 1) hi
        if y < hi then
          d + 2 ≤ (rightSpineTopDownNat (restrictRangeNat 0 hi T)).length ∧
          restrictRangeNat 0 hi (rotateLeftAtRightDepthNat T d) =
            rotateLeftAtRightDepthNat (restrictRangeNat 0 hi T) d
        else
          restrictRangeNat 0 hi (rotateLeftAtRightDepthNat T d) =
            restrictRangeNat 0 hi T := by
      intro d
      induction d with
      | zero =>
        intro T hbst hlen
        rcases T with _ | ⟨x, a, _ | ⟨y, b, c⟩⟩
        · simp [rightSpineTopDownNat] at hlen
        · simp [rightSpineTopDownNat] at hlen
        · cases hbst using isBSTCases with
          | node _ _ _ _ hx_gt _ hbc_bst =>
            cases hx_gt with
            | node _ _ _ _ hxy _ =>
              have hy_eq : (rightSpineTopDownNat (.node x a (.node y b c))).getD 1 hi = y := rfl
              dsimp (config := { failIfUnchanged := false }) only
              rw [hy_eq]
              by_cases hy_lt : y < hi
              · rw [if_pos hy_lt]
                have hx_not : ¬(hi ≤ x) := by omega
                have hy_not : ¬(hi ≤ y) := by omega
                refine ⟨?_, ?_⟩
                · simp only [hR_node, if_neg hx_not, if_neg hy_not, rightSpineTopDownNat,
                    List.length_cons]
                  omega
                · simp only [rotateLeftAtRightDepthNat, _root_.BinaryTree.rotateLeft, hR_node,
                    if_neg hx_not, if_neg hy_not]
              · rw [if_neg hy_lt]
                have hy_ge : hi ≤ y := by omega
                simp only [rotateLeftAtRightDepthNat, _root_.BinaryTree.rotateLeft]
                rw [hR_node (.node x a b) y c, if_pos hy_ge]
                by_cases hx_ge : hi ≤ x
                · rw [hR_node a x b, if_pos hx_ge, hR_node a x (.node y b c), if_pos hx_ge]
                · rw [hR_node a x b, if_neg hx_ge, hR_node a x (.node y b c), if_neg hx_ge,
                    hR_node b y c, if_pos hy_ge]
      | succ d ih =>
        intro T hbst hlen
        rcases T with _ | ⟨k, l, r⟩
        · simp [rightSpineTopDownNat] at hlen
        · cases hbst using isBSTCases with
          | node _ _ _ _ hk_gt _ hr_bst =>
            have hr_len : d + 2 ≤ (rightSpineTopDownNat r).length := by
              simp [rightSpineTopDownNat] at hlen; omega
            have hk_lt_y : k < (rightSpineTopDownNat r).getD (d + 1) hi :=
              h_rs_forall (d + 1) r hk_gt (by omega)
            have hy_eq : (rightSpineTopDownNat (.node k l r)).getD (d + 1 + 1) hi =
                (rightSpineTopDownNat r).getD (d + 1) hi := rfl
            dsimp (config := { failIfUnchanged := false }) only
            rw [hy_eq]
            have h_ih := ih r hr_bst hr_len
            dsimp (config := { failIfUnchanged := false }) only at h_ih
            by_cases hy_lt : (rightSpineTopDownNat r).getD (d + 1) hi < hi
            · rw [if_pos hy_lt] at h_ih ⊢
              have hk_not : ¬(hi ≤ k) := by omega
              refine ⟨?_, ?_⟩
              · simp only [hR_node, if_neg hk_not, rightSpineTopDownNat, List.length_cons]
                have := h_ih.1
                omega
              · simp only [rotateLeftAtRightDepthNat, hR_node, if_neg hk_not, h_ih.2]
            · rw [if_neg hy_lt] at h_ih ⊢
              simp only [rotateLeftAtRightDepthNat]
              by_cases hk_ge : hi ≤ k
              · rw [hR_node l k _, if_pos hk_ge, hR_node l k r, if_pos hk_ge]
              · rw [hR_node l k _, if_neg hk_ge, hR_node l k r, if_neg hk_ge, h_ih]

    have h_descend_decomp : ∀ (T : _root_.BinaryTree ℕ) (acc : List (ℕ × _root_.BinaryTree ℕ)),
        T ≠ .nil →
        ∃ s0 : ℕ,
          leftSpineBottomUpAux T (acc.map Prod.fst) =
            s0 :: (descendLeftNat T acc).2.map Prod.fst ∧
          twAttachPoly (.node s0 .nil (descendLeftNat T acc).1) (descendLeftNat T acc).2 =
            twAttachPoly T acc := by
      intro T
      induction T with
      | nil => intro _ h; exact absurd rfl h
      | node k l r ihl _ =>
        intro acc _
        rcases l with _ | ⟨lk, ll, lr⟩
        · refine ⟨k, ?_, ?_⟩ <;> simp [leftSpineBottomUpAux, descendLeftNat]
        · simpa [leftSpineBottomUpAux, descendLeftNat, twAttachPoly] using
            ihl ((k, r) :: acc) (by simp)

    have h_descend_nat_append : ∀ (T : _root_.BinaryTree ℕ) (a1 a2 : List (ℕ × _root_.BinaryTree ℕ)),
        T ≠ .nil →
        descendLeftNat T (a1 ++ a2) = ((descendLeftNat T a1).1, (descendLeftNat T a1).2 ++ a2) := by
      intro T
      induction T with
      | nil => intro _ _ h; exact absurd rfl h
      | node k l r ihl _ =>
        intro a1 a2 _
        rcases l with _ | ⟨lk, ll, lr⟩
        · simp [descendLeftNat]
        · simp only [descendLeftNat]
          rw [← List.cons_append]
          exact ihl ((k, r) :: a1) a2 (by simp)

    have h_descend_attach : ∀ (ps : List (ℕ × _root_.BinaryTree ℕ)) (V : _root_.BinaryTree ℕ)
        (acc : List (ℕ × _root_.BinaryTree ℕ)),
        V ≠ .nil →
        twAttachPoly V ps ≠ .nil ∧
        descendLeftNat (twAttachPoly V ps) acc =
          ((descendLeftNat V []).1, (descendLeftNat V []).2 ++ ps ++ acc) := by
      intro ps
      induction ps with
      | nil =>
        intro V acc hV
        simp only [twAttachPoly]
        have hd := h_descend_nat_append V [] acc hV
        exact ⟨hV, by simpa using hd⟩
      | cons kr rest ih =>
        intro V acc hV
        rcases V with _ | ⟨vk, vl, vr⟩
        · exact absurd rfl hV
        · obtain ⟨hne, hdesc⟩ := ih (.node kr.1 (.node vk vl vr) kr.2) acc (by simp)
          have hstep : descendLeftNat (.node kr.1 (.node vk vl vr) kr.2) [] =
              ((descendLeftNat (.node vk vl vr) []).1,
                (descendLeftNat (.node vk vl vr) []).2 ++ [kr]) := by
            simp only [descendLeftNat]
            have hd := h_descend_nat_append (.node vk vl vr) [] [kr] (by simp)
            simpa using hd
          rw [hstep] at hdesc
          simp only [twAttachPoly, List.append_assoc, List.singleton_append] at hdesc ⊢
          exact ⟨hne, hdesc⟩

    have h_attach_bst : ∀ (ps : List (ℕ × _root_.BinaryTree ℕ)) (U : _root_.BinaryTree ℕ),
        _root_.BinaryTree.IsBST (twAttachPoly U ps) →
        _root_.BinaryTree.IsBST U ∧
          ∀ p ∈ ps,
            _root_.SplayDeque.Direct.ForallTree (fun v => v < p.1) U ∧
            _root_.SplayDeque.Direct.ForallTree (fun v => p.1 < v) p.2 := by
      intro ps
      induction ps with
      | nil =>
        intro U hbst
        exact ⟨hbst, by simp⟩
      | cons kr rest ih =>
        intro U hbst
        obtain ⟨hbst_node, hrest⟩ := ih (.node kr.1 U kr.2) hbst
        cases hbst_node using isBSTCases with
        | node _ _ _ hl_lt hr_gt hl_bst _ =>
          refine ⟨hl_bst, ?_⟩
          intro p hp
          rcases List.mem_cons.mp hp with rfl | hp_rest
          · exact ⟨hl_lt, hr_gt⟩
          · obtain ⟨hnode_lt, hp2_gt⟩ := hrest p hp_rest
            cases hnode_lt with
            | node _ _ _ hU_lt _ _ => exact ⟨hU_lt, hp2_gt⟩

    have hR_attach_tail : ∀ (ps : List (ℕ × _root_.BinaryTree ℕ)) (V : _root_.BinaryTree ℕ),
        (∀ p ∈ ps, hi ≤ p.1) →
        restrictRangeNat 0 hi (twAttachPoly V ps) = restrictRangeNat 0 hi V := by
      intro ps
      induction ps with
      | nil => intro V _; rfl
      | cons kr rest ih =>
        intro V hge
        have hkr : hi ≤ kr.1 := hge kr (by simp)
        rw [twAttachPoly, ih (.node kr.1 V kr.2) (fun p hp => hge p (by simp [hp])),
          hR_node, if_pos hkr]

    have hR_attach_comm : ∀ (ps : List (ℕ × _root_.BinaryTree ℕ)) (U : _root_.BinaryTree ℕ),
        _root_.BinaryTree.IsBST (twAttachPoly U ps) →
        restrictRangeNat 0 hi (twAttachPoly U ps) =
          twAttachPoly (restrictRangeNat 0 hi U) (psspProjPath hi ps) := by
      intro ps
      induction ps with
      | nil => intro U _; rfl
      | cons kr rest ih =>
        rcases kr with ⟨k, r⟩
        intro U hbst
        by_cases hk : k < hi
        · have hk_not : ¬(hi ≤ k) := by omega
          simp only [psspProjPath, if_pos hk, twAttachPoly]
          rw [ih (.node k U r) hbst, hR_node U k r, if_neg hk_not]
        · simp only [psspProjPath, if_neg hk, twAttachPoly]
          obtain ⟨_, hrest_gt⟩ := h_attach_bst rest (.node k U r) hbst
          have htail_ge : ∀ p ∈ (k, r) :: rest, hi ≤ p.1 := by
            intro p hp
            rcases List.mem_cons.mp hp with rfl | hp_rest
            · omega
            · obtain ⟨hnode_lt, _⟩ := hrest_gt p hp_rest
              cases hnode_lt with
              | node _ _ _ _ hk_lt_p _ => omega
          exact hR_attach_tail ((k, r) :: rest) U htail_ge

    have hR_splay_tail : ∀ (n : ℕ) (ps : List (ℕ × _root_.BinaryTree ℕ)) (c : _root_.BinaryTree ℕ),
        ps.length ≤ n →
        (∀ p ∈ ps, hi ≤ p.1) →
        restrictRangeNat 0 hi (splayLeftSpineNat c ps) = restrictRangeNat 0 hi c := by
      intro n
      induction n with
      | zero =>
        intro ps c hlen _
        rcases ps with _ | ⟨_, _⟩
        · rfl
        · simp at hlen
      | succ n ih =>
        intro ps c hlen hge
        rcases ps with _ | ⟨⟨k1, r1⟩, _ | ⟨⟨k2, r2⟩, rest⟩⟩
        · rfl
        · have hk1 : hi ≤ k1 := hge (k1, r1) (by simp)
          simp only [splayLeftSpineNat, hR_node, if_pos hk1]
        · have hk1 : hi ≤ k1 := hge (k1, r1) (by simp)
          simp only [splayLeftSpineNat]
          rw [ih rest (.node k1 c (.node k2 r1 r2)) (by simp at hlen; omega)
            (fun p hp => hge p (by simp [hp])), hR_node, if_pos hk1]

    have hR_splay_comm : ∀ (n : ℕ) (path : List (ℕ × _root_.BinaryTree ℕ)) (c : _root_.BinaryTree ℕ),
        path.length ≤ n →
        List.Pairwise (· < ·) (path.map Prod.fst) →
        restrictRangeNat 0 hi (splayLeftSpineNat c path) =
          splayLeftSpineNat (restrictRangeNat 0 hi c) (psspProjPath hi path) := by
      intro n
      induction n with
      | zero =>
        intro path c hlen _
        rcases path with _ | ⟨_, _⟩
        · rfl
        · simp at hlen
      | succ n ih =>
        intro path c hlen hpw
        rcases path with _ | ⟨⟨k1, r1⟩, _ | ⟨⟨k2, r2⟩, rest⟩⟩
        · rfl
        · by_cases hk1 : k1 < hi
          · have hk1_not : ¬(hi ≤ k1) := by omega
            simp [splayLeftSpineNat, psspProjPath, if_pos hk1, hR_node, if_neg hk1_not]
          · have hk1_ge : hi ≤ k1 := by omega
            simp [splayLeftSpineNat, psspProjPath, if_neg hk1, hR_node, if_pos hk1_ge]
        · simp only [List.map_cons, List.pairwise_cons] at hpw
          obtain ⟨hk1_lt_all, hk2_lt_rest, hrest_pw⟩ := hpw
          have hk1_lt_k2 : k1 < k2 := hk1_lt_all k2 (by simp)
          by_cases hk1 : k1 < hi
          · have hk1_not : ¬(hi ≤ k1) := by omega
            by_cases hk2 : k2 < hi
            · have hk2_not : ¬(hi ≤ k2) := by omega
              simp only [psspProjPath, if_pos hk1, if_pos hk2, splayLeftSpineNat]
              rw [ih rest (.node k1 c (.node k2 r1 r2)) (by simp at hlen; omega) hrest_pw,
                hR_node c k1 _, if_neg hk1_not, hR_node r1 k2 r2, if_neg hk2_not]
            · simp only [psspProjPath, if_pos hk1, if_neg hk2, splayLeftSpineNat]
              have hk2_ge : hi ≤ k2 := by omega
              have hrest_ge : ∀ p ∈ rest, hi ≤ p.1 := by
                intro p hp
                have : k2 < p.1 := hk2_lt_rest p.1 (List.mem_map_of_mem hp)
                omega
              rw [hR_splay_tail rest.length rest (.node k1 c (.node k2 r1 r2)) le_rfl hrest_ge,
                hR_node c k1 _, if_neg hk1_not, hR_node r1 k2 r2, if_pos hk2_ge]
          · simp only [psspProjPath, if_neg hk1, splayLeftSpineNat]
            have hk1_ge : hi ≤ k1 := by omega
            have hall_ge : ∀ p ∈ (k1, r1) :: (k2, r2) :: rest, hi ≤ p.1 := by
              intro p hp
              rcases List.mem_cons.mp hp with rfl | hp'
              · exact hk1_ge
              · have : k1 < p.1 := hk1_lt_all p.1 (List.mem_map_of_mem hp')
                omega
            have htail := hR_splay_tail ((k1, r1) :: (k2, r2) :: rest).length
              ((k1, r1) :: (k2, r2) :: rest) c le_rfl hall_ge
            simpa [splayLeftSpineNat] using htail

    have h_projPath_prefix_len : ∀ (m : ℕ) (ps : List (ℕ × _root_.BinaryTree ℕ)),
        ∀ hm : m ≤ ps.length,
        (∀ idx (h : idx < m), (ps[idx]'(lt_of_lt_of_le h hm)).1 < hi) →
        m ≤ (psspProjPath hi ps).length := by
      intro m
      induction m with
      | zero => intro ps _ _; omega
      | succ m ih =>
        intro ps hm hlt
        rcases ps with _ | ⟨⟨k0, r0⟩, rest⟩
        · simp at hm
        · have hk0 : k0 < hi := hlt 0 (by omega)
          simp only [psspProjPath, if_pos hk0, List.length_cons]
          have hm' : m ≤ rest.length := by simp at hm; omega
          have hsub := ih rest hm' (fun idx h => hlt (idx + 1) (by omega))
          omega

    have hlo_P : lo < P := by omega
    have hhi1_P : hi - 1 < P := by omega
    set t0 := popStep kops lo
    set t1 := popStep kops (hi - 1) + 1
    have ht1_le_len : t1 ≤ kops.length := by
      have := (hkvalid.birth_lt_pop (hi - 1) hhi1_P).2
      omega
    have ht0_lt_t1 : t0 < t1 := by
      by_cases heq : lo = hi - 1
      · dsimp (config := { failIfUnchanged := false }) only [t0, t1]; rw [heq]; omega
      · have := hkvalid.popStep_mono lo (hi - 1) (by omega) hhi1_P
        omega

    let UState : ℕ → _root_.BinaryTree Unit := fun t =>
      eraseNatKeys (restrictRangeNat 0 hi (keyedState kops t))

    have h_inorder_forall : ∀ {p : ℕ → Prop} (T : _root_.BinaryTree ℕ),
        (∀ v ∈ inorderNat T, p v) → _root_.SplayDeque.Direct.ForallTree p T := by
      intro p T
      induction T with
      | nil => intro _; exact .left
      | node k l r ihl ihr =>
        intro h
        refine .node l k r (ihl ?_) (h k (by simp [inorderNat])) (ihr ?_)
        · intro v hv; exact h v (by simp [inorderNat, hv])
        · intro v hv; exact h v (by simp [inorderNat, hv])

    have hUt1_empty : UState t1 = .nil := by
      have hpidx : popIdx kops t1 = hi := by
        have := hkvalid.popIdx_after_popStep (hi - 1) hhi1_P
        dsimp (config := { failIfUnchanged := false }) only [t1]
        omega
      have hfa : _root_.SplayDeque.Direct.ForallTree (fun v => hi ≤ v) (keyedState kops t1) := by
        apply h_inorder_forall
        intro v hv
        have hb := hkvalid.popIdx_bound t1 ht1_le_len v hv
        omega
      simp [UState, hR_all_ge _ hfa, eraseNatKeys]

    have h_exec_append : ∀ (H : _root_.BinaryTree ℕ) (xs ys : List KeyedCoreOp),
        execKeyedList H (xs ++ ys) = execKeyedList (execKeyedList H xs) ys := by
      intro H xs ys
      induction xs generalizing H with
      | nil => rfl
      | cons op rest ih => exact ih (execKeyedOp H op)

    have h_take_succ : ∀ (xs : List KeyedCoreOp) (t : ℕ) (ht : t < xs.length),
        xs.take (t + 1) = xs.take t ++ [xs[t]] := by
      intro xs
      induction xs with
      | nil => intro t ht; simp at ht
      | cons x rest ih =>
        intro t ht
        rcases t with _ | t
        · rfl
        · simp only [List.take_succ_cons, List.cons_append, List.getElem_cons_succ]
          rw [ih t (by simp at ht; omega)]

    have h_state_step : ∀ t (ht : t < kops.length),
        keyedState kops (t + 1) = execKeyedOp (keyedState kops t) kops[t] := by
      intro t ht
      unfold keyedState
      rw [h_take_succ kops t ht, h_exec_append]
      rfl

    have h_popIdx_step_eq : ∀ t (ht : t < kops.length),
        popIdx kops (t + 1) = popIdx kops t + (if isKeyedPop kops[t] then 1 else 0) := by
      intro t ht
      unfold popIdx
      rw [h_take_succ kops t ht, List.countP_append]
      simp only [List.countP_cons, List.countP_nil]
      cases isKeyedPop kops[t] <;> simp

    let emitOp : ℕ → List CoreOp := fun t =>
      match kops[t]? with
      | some (.push w) => if w < hi then [.push] else []
      | some (.pop _) => [.pop]
      | some (.rslr d) =>
          if (rightSpineTopDownNat (keyedState kops t)).getD (d + 1) hi < hi then
            [.rslr d]
          else
            []
      | none => []

    let jSetAt : ℕ → Finset ℕ := fun t =>
      (Finset.range (jumps kops).length).filter (fun id =>
        (match (jumps kops)[id]? with
        | none => false
        | some e => decide (lo ≤ e.s ∧ e.z < hi ∧ e.step = t)) = true)

    have h_sim_step : ∀ t, t0 ≤ t → t < t1 →
        TwValidCoreSteps (UState t) (emitOp t) (UState (t + 1)) ∧
        countCorePop (emitOp t) = popIdx kops (t + 1) - popIdx kops t ∧
        (jSetAt t).card ≤ coreCascadeCostAux (UState t) (emitOp t) := by
      intro t ht_lo ht_hi
      have ht_lt : t < kops.length := by omega
      have hnext := h_state_step t ht_lt
      have hpidx_step := h_popIdx_step_eq t ht_lt
      have hsv := hkvalid.step_valid t ht_lt
      have h_jSet_nonpop : (∀ s, kops[t] ≠ .pop s) → (jSetAt t).card = 0 := by
        intro hnp
        rw [Finset.card_eq_zero, Finset.eq_empty_iff_forall_notMem]
        intro id hid
        simp only [jSetAt, Finset.mem_filter, Finset.mem_range] at hid
        obtain ⟨hid_lt, hdec⟩ := hid
        rw [List.getElem?_eq_getElem hid_lt, decide_eq_true_eq] at hdec
        obtain ⟨_, _, hkop_opt, _⟩ := hjump.jump_anatomies id hid_lt
        set e := (jumps kops)[id]
        have h1 : kops[e.step]? = some (.pop e.s) := hkop_opt
        rw [hdec.2.2, List.getElem?_eq_getElem ht_lt] at h1
        exact hnp e.s (Option.some.inj h1)

      cases hkop : kops[t] with
      | push w =>
        rw [hkop] at hsv hnext hpidx_step
        obtain ⟨_, _, hforall_w⟩ := hsv
        have hj0 : (jSetAt t).card = 0 := h_jSet_nonpop (by simp [hkop])
        simp only [emitOp, List.getElem?_eq_getElem ht_lt, hkop]
        by_cases hw : w < hi
        · rw [if_pos hw]
          have hw_not : ¬(hi ≤ w) := by omega
          have hU_next : UState (t + 1) = .node () .nil (UState t) := by
            simp only [UState, hnext, execKeyedOp, hR_node, if_neg hw_not]
            simp [restrictRangeNat, eraseNatKeys]
          refine ⟨by rw [hU_next]; rfl, ?_, by simp [hj0]⟩
          simp [countCorePop, isKeyedPop] at hpidx_step ⊢
          omega
        · rw [if_neg hw]
          have hw_ge : hi ≤ w := by omega
          have hHt_emp : restrictRangeNat 0 hi (keyedState kops t) = .nil :=
            hR_all_ge _ (h_forall_imp (fun v hv => by omega) hforall_w)
          have hU_eq : UState (t + 1) = UState t := by
            simp only [UState, hnext, execKeyedOp, hR_node, if_pos hw_ge, hHt_emp]
            simp [restrictRangeNat, eraseNatKeys]
          refine ⟨by rw [hU_eq]; rfl, ?_, by simp [hj0]⟩
          simp [countCorePop, isKeyedPop] at hpidx_step ⊢
          omega

      | rslr d =>
        rw [hkop] at hsv hnext hpidx_step
        have hj0 : (jSetAt t).card = 0 := h_jSet_nonpop (by simp [hkop])
        have hbst := hkvalid.isBST_state t (by omega)
        have hr := hR_rslr d (keyedState kops t) hbst hsv
        dsimp (config := { failIfUnchanged := false }) only at hr
        simp only [emitOp, List.getElem?_eq_getElem ht_lt, hkop]
        by_cases hy : (rightSpineTopDownNat (keyedState kops t)).getD (d + 1) hi < hi
        · rw [if_pos hy] at hr ⊢
          have hlen_u : d + 2 ≤ rightSpineLen (UState t) := by
            rw [h_erase_rs]; exact hr.1
          have hU_next : UState (t + 1) = rotateLeftAtRightDepth (UState t) d := by
            simp only [UState, hnext, execKeyedOp, hr.2, h_erase_rotL]
          refine ⟨⟨hlen_u, by rw [hU_next]; rfl⟩, ?_, by simp [hj0]⟩
          simp [countCorePop, isKeyedPop] at hpidx_step ⊢
          omega
        · rw [if_neg hy] at hr ⊢
          have hU_eq : UState (t + 1) = UState t := by
            simp only [UState, hnext, execKeyedOp, hr]
          refine ⟨by rw [hU_eq]; rfl, ?_, by simp [hj0]⟩
          simp [countCorePop, isKeyedPop] at hpidx_step ⊢
          omega

      | pop s =>
        rw [hkop] at hsv hnext hpidx_step
        obtain ⟨hs_P, hpop_s, _, hHt_ne, hls_head⟩ := hsv
        have hs_lt_hi : s < hi := by
          by_contra hge
          have hmono : popStep kops (hi - 1) < popStep kops s :=
            hkvalid.popStep_mono (hi - 1) s (by omega) hs_P
          omega
        simp only [emitOp, List.getElem?_eq_getElem ht_lt, hkop]
        set Ht := keyedState kops t
        set c0 := (descendLeftNat Ht []).1
        set path := (descendLeftNat Ht []).2
        obtain ⟨s0, hls_eq0, hattach0⟩ := h_descend_decomp Ht [] hHt_ne
        simp only [List.map_nil, twAttachPoly] at hls_eq0 hattach0
        have hs0_eq : s0 = s := by
          change (leftSpineBottomUpNat Ht).head? = some s at hls_head
          change leftSpineBottomUpNat Ht = s0 :: path.map Prod.fst at hls_eq0
          rw [hls_eq0, List.head?_cons] at hls_head
          exact Option.some.inj hls_head
        rw [hs0_eq] at hls_eq0 hattach0
        have hHt_bst : _root_.BinaryTree.IsBST Ht := hkvalid.isBST_state t (by omega)
        have hls_pw : List.Pairwise (· < ·) (leftSpineBottomUpNat Ht) := h_bst_ls Ht hHt_bst
        have hpath_pw : List.Pairwise (· < ·) (path.map Prod.fst) := by
          change leftSpineBottomUpNat Ht = s :: path.map Prod.fst at hls_eq0
          rw [hls_eq0, List.pairwise_cons] at hls_pw
          exact hls_pw.2
        have hHt_attach : Ht = twAttachPoly (.node s .nil c0) path := hattach0.symm
        have hs_not_ge : ¬(hi ≤ s) := by omega
        have hR_Ht : restrictRangeNat 0 hi Ht =
            twAttachPoly (.node s .nil (restrictRangeNat 0 hi c0)) (psspProjPath hi path) := by
          rw [hHt_attach, hR_attach_comm path (.node s .nil c0) (hHt_attach ▸ hHt_bst),
            hR_node, if_neg hs_not_ge]
          rfl
        obtain ⟨hRHt_ne, hdesc_RHt⟩ :=
          h_descend_attach (psspProjPath hi path)
            (.node s .nil (restrictRangeNat 0 hi c0)) [] (by simp)
        simp only [descendLeftNat, List.nil_append, List.append_nil] at hdesc_RHt
        have hUt_ne : UState t ≠ .nil := by
          intro hemp
          change eraseNatKeys (restrictRangeNat 0 hi Ht) = .nil at hemp
          rw [hR_Ht] at hemp
          exact hRHt_ne ((h_erase_eq_empty _).mp hemp)
        have hR_pop : restrictRangeNat 0 hi (popNat Ht) = popNat (restrictRangeNat 0 hi Ht) := by
          have hlhs : restrictRangeNat 0 hi (popNat Ht) =
              splayLeftSpineNat (restrictRangeNat 0 hi c0) (psspProjPath hi path) :=
            hR_splay_comm path.length path c0 le_rfl hpath_pw
          have hrhs : popNat (restrictRangeNat 0 hi Ht) =
              splayLeftSpineNat (restrictRangeNat 0 hi c0) (psspProjPath hi path) := by
            unfold popNat
            rw [hR_Ht, hdesc_RHt]
          exact hlhs.trans hrhs.symm
        have hU_next : UState (t + 1) = popUnlabeled (UState t) := by
          change eraseNatKeys (restrictRangeNat 0 hi (keyedState kops (t + 1))) =
            popUnlabeled (eraseNatKeys (restrictRangeNat 0 hi Ht))
          rw [hnext, execKeyedOp, hR_pop, h_erase_pop]
        have hls_len_Ut : leftSpineLen (UState t) = (psspProjPath hi path).length + 1 := by
          have hlen := h_erase_ls_len (restrictRangeNat 0 hi Ht) []
            (by rw [hR_Ht]; exact hRHt_ne)
          have h1 : (descendLeftNat (restrictRangeNat 0 hi Ht) []).2 = psspProjPath hi path := by
            rw [hR_Ht, hdesc_RHt]
          rw [h1, List.length_nil, Nat.add_zero] at hlen
          exact hlen.symm
        let fj : ℕ → ℕ := fun id =>
          match (jumps kops)[id]? with
          | none => 0
          | some e => e.j
        have hfj_maps : Set.MapsTo fj ↑(jSetAt t)
            ↑(Finset.range (coreCascadeStepCost (UState t) .pop)) := by
          intro id hid
          simp only [Finset.mem_coe, jSetAt, Finset.mem_filter, Finset.mem_range] at hid
          obtain ⟨hid_lt, hdec⟩ := hid
          rw [List.getElem?_eq_getElem hid_lt, decide_eq_true_eq] at hdec
          obtain ⟨_, hz_lt_hi, hstep_eq⟩ := hdec
          obtain ⟨_, _, _, _, _, _, _, _, ⟨_, _, _, _, hez_ls⟩, _⟩ :=
            hjump.jump_anatomies id hid_lt
          set e := (jumps kops)[id]
          change (leftSpineBottomUpNat (keyedState kops e.step))[2 * e.j + 3]? = some e.z at hez_ls
          rw [hstep_eq] at hez_ls
          change (leftSpineBottomUpNat Ht)[2 * e.j + 3]? = some e.z at hez_ls
          change leftSpineBottomUpNat Ht = s :: path.map Prod.fst at hls_eq0
          rw [hls_eq0] at hez_ls
          have hez_map : (path.map Prod.fst)[2 * e.j + 2]? = some e.z := hez_ls
          obtain ⟨hj2_lt, hez_eq⟩ := List.getElem?_eq_some_iff.mp hez_map
          rw [List.length_map] at hj2_lt
          have hprefix_lt : ∀ idx (h : idx < 2 * e.j + 3),
              (path[idx]'(by omega)).1 < hi := by
            intro idx hidx
            by_cases heq : idx = 2 * e.j + 2
            · subst heq
              have : (path[2 * e.j + 2]).1 = e.z := by simpa using hez_eq
              omega
            · have hlt_idx : idx < 2 * e.j + 2 := by omega
              have hpw_get := (List.pairwise_iff_getElem.mp hpath_pw) idx (2 * e.j + 2)
                (by simp; omega) (by simp; omega) hlt_idx
              have h1 : (path.map Prod.fst)[idx] = (path[idx]).1 := by simp
              have h2 : (path.map Prod.fst)[2 * e.j + 2] = e.z := hez_eq
              rw [h1, h2] at hpw_get
              omega
          have hproj_ge := h_projPath_prefix_len (2 * e.j + 3) path (by omega) hprefix_lt
          have hfj_eq : fj id = e.j := by simp [fj, List.getElem?_eq_getElem hid_lt, e]
          simp only [Finset.mem_coe, Finset.mem_range, hfj_eq,
            coreCascadeStepCost, hls_len_Ut]
          omega
        have hfj_inj : Set.InjOn fj ↑(jSetAt t) := by
          intro id1 hm1 id2 hm2 hfeq
          simp only [Finset.mem_coe, jSetAt, Finset.mem_filter, Finset.mem_range] at hm1 hm2
          obtain ⟨hid1, hdec1⟩ := hm1
          obtain ⟨hid2, hdec2⟩ := hm2
          rw [List.getElem?_eq_getElem hid1, decide_eq_true_eq] at hdec1
          rw [List.getElem?_eq_getElem hid2, decide_eq_true_eq] at hdec2
          simp only [fj, List.getElem?_eq_getElem hid1, List.getElem?_eq_getElem hid2] at hfeq
          by_contra hne
          rcases lt_trichotomy id1 id2 with hlt | heq | hgt
          · rcases hjump.jump_order id1 hid1 id2 hid2 hlt with hst | ⟨_, hj⟩
            · omega
            · omega
          · exact hne heq
          · rcases hjump.jump_order id2 hid2 id1 hid1 hgt with hst | ⟨_, hj⟩
            · omega
            · omega
        have hcard_j := Finset.card_le_card_of_injOn fj hfj_maps hfj_inj
        simp only [Finset.card_range] at hcard_j
        refine ⟨⟨hUt_ne, by rw [hU_next]; rfl⟩, ?_, ?_⟩
        · simp [countCorePop, isKeyedPop] at hpidx_step ⊢
          omega
        · simpa [coreCascadeCostAux] using hcard_j

    have h_sim_range : ∀ (k t : ℕ),
        t0 ≤ t → t + k = t1 →
        let ops := (List.Ico t t1).flatMap emitOp
        TwValidCoreSteps (UState t) ops (UState t1) ∧
        countCorePop ops + popIdx kops t = popIdx kops t1 ∧
        (∑ s ∈ Finset.Ico t t1, (jSetAt s).card) ≤ coreCascadeCostAux (UState t) ops := by
      intro k
      induction k with
      | zero =>
        intro t _ htk
        have ht_eq : t = t1 := by omega
        subst ht_eq
        simp [TwValidCoreSteps, countCorePop, coreCascadeCostAux]
      | succ k ih =>
        intro t ht_lo htk
        have ht_lt : t < t1 := by omega
        obtain ⟨hst1, hpop1, hcost1⟩ := h_sim_step t ht_lo ht_lt
        obtain ⟨hst2, hpop2, hcost2⟩ := ih (t + 1) (by omega) (by omega)
        have hico_cons : List.Ico t t1 = t :: List.Ico (t + 1) t1 :=
          List.Ico.eq_cons ht_lt
        dsimp (config := { failIfUnchanged := false }) only at hst2 hpop2 hcost2 ⊢
        rw [hico_cons, List.flatMap_cons]
        have hst_all := h_steps_append (emitOp t) _ (UState t) (UState (t + 1)) (UState t1) hst1 hst2
        have hcost_eq := h_cost_append (emitOp t) ((List.Ico (t + 1) t1).flatMap emitOp)
          (UState t) (UState (t + 1)) hst1
        have hpop_le : popIdx kops t ≤ popIdx kops (t + 1) := by
          rw [h_popIdx_step_eq t (by omega)]; omega
        have hsum_ico : ∑ s ∈ Finset.Ico t t1, (jSetAt s).card =
            (jSetAt t).card + ∑ s ∈ Finset.Ico (t + 1) t1, (jSetAt s).card := by
          rw [← Finset.insert_Ico_add_one_left_eq_Ico ht_lt,
            Finset.sum_insert (by simp)]
        refine ⟨hst_all, ?_, ?_⟩
        · rw [h_pop_append]; omega
        · rw [hsum_ico, hcost_eq]; omega

    obtain ⟨h_act_steps, h_act_pop, h_act_cost⟩ :=
      h_sim_range (t1 - t0) t0 le_rfl (by omega)
    set activeOps := (List.Ico t0 t1).flatMap emitOp

    let targetJumps : Finset ℕ :=
      (Finset.range (jumps kops).length).filter (fun id =>
        (match (jumps kops)[id]? with
        | none => false
        | some e => decide (lo ≤ e.s ∧ e.z < hi)) = true)

    have h_jumps_eq_sum : targetJumps.card = ∑ s ∈ Finset.Ico t0 t1, (jSetAt s).card := by
      have h_biU : (Finset.Ico t0 t1).biUnion jSetAt = targetJumps := by
        ext id
        simp only [Finset.mem_biUnion, Finset.mem_Ico, jSetAt, targetJumps, Finset.mem_filter,
          Finset.mem_range]
        constructor
        · rintro ⟨t, _, hid_lt, hdec⟩
          rw [List.getElem?_eq_getElem hid_lt, decide_eq_true_eq] at hdec ⊢
          exact ⟨hid_lt, hdec.1, hdec.2.1⟩
        · rintro ⟨hid_lt, hdec⟩
          rw [List.getElem?_eq_getElem hid_lt, decide_eq_true_eq] at hdec
          obtain ⟨_, hstep_lt, hkop_opt, _, hsx, hxy, hyz, _⟩ := hjump.jump_anatomies id hid_lt
          set e := (jumps kops)[id]
          have hkop_e : kops[e.step] = .pop e.s := by
            rw [List.getElem?_eq_getElem hstep_lt] at hkop_opt
            exact Option.some.inj hkop_opt
          have hsv_e := hkvalid.step_valid e.step hstep_lt
          rw [hkop_e] at hsv_e
          have hpop_es : popStep kops e.s = e.step := hsv_e.2.1
          have hes_lo : t0 ≤ e.step := by
            by_cases heq : lo = e.s
            · dsimp (config := { failIfUnchanged := false }) only [t0]; rw [heq, hpop_es]
            · have := hkvalid.popStep_mono lo e.s (by omega) hsv_e.1
              dsimp (config := { failIfUnchanged := false }) only [t0]; omega
          have hes_hi : e.step < t1 := by
            by_cases heq : e.s = hi - 1
            · dsimp (config := { failIfUnchanged := false }) only [t1]; rw [← hpop_es, heq]; omega
            · have := hkvalid.popStep_mono e.s (hi - 1) (by omega) hhi1_P
              dsimp (config := { failIfUnchanged := false }) only [t1]; omega
          refine ⟨e.step, ⟨hes_lo, hes_hi⟩, hid_lt, ?_⟩
          rw [List.getElem?_eq_getElem hid_lt, decide_eq_true_eq]
          exact ⟨hdec.1, hdec.2, rfl⟩
      have h_disj : Set.PairwiseDisjoint ↑(Finset.Ico t0 t1) jSetAt := by
        intro s1 _ s2 _ hne
        change Disjoint (jSetAt s1) (jSetAt s2)
        rw [Finset.disjoint_left]
        intro id hm1 hm2
        simp only [jSetAt, Finset.mem_filter, Finset.mem_range] at hm1 hm2
        obtain ⟨hid_lt, h1⟩ := hm1
        obtain ⟨_, h2⟩ := hm2
        rw [List.getElem?_eq_getElem hid_lt, decide_eq_true_eq] at h1 h2
        exact hne (h1.2.2.symm.trans h2.2.2)
      rw [← h_biU, Finset.card_biUnion h_disj]

    obtain ⟨h_bld_steps, h_bld_push, h_bld_pop⟩ := h_build (UState t0)
    let subOps := twBuildFromEmpty (UState t0) ++ activeOps
    refine ⟨subOps, ?_, ?_⟩
    · have hpidx_t0 : popIdx kops t0 = lo := hkvalid.popIdx_at_popStep lo hlo_P
      have hpidx_t1 : popIdx kops t1 = hi := by
        have := hkvalid.popIdx_after_popStep (hi - 1) hhi1_P
        dsimp (config := { failIfUnchanged := false }) only [t1]; omega
      have hact_steps_emp : TwValidCoreSteps (UState t0) activeOps .nil := by
        rwa [hUt1_empty] at h_act_steps
      have hnodes_eq := h_steps_nodes activeOps (UState t0) .nil hact_steps_emp
      simp only [_root_.BinaryTree.num_nodes] at hnodes_eq
      have hfull_steps : TwValidCoreSteps .nil subOps .nil :=
        h_steps_append _ activeOps .nil (UState t0) .nil h_bld_steps hact_steps_emp
      refine ⟨?_, ?_, h_steps_to_aux subOps .nil hfull_steps⟩
      · dsimp (config := { failIfUnchanged := false }) only [subOps]
        rw [h_push_append, h_bld_push]
        omega
      · dsimp (config := { failIfUnchanged := false }) only [subOps]
        rw [h_pop_append, h_bld_pop]
        omega
    · have hcost_full := h_cost_append _ activeOps .nil (UState t0) h_bld_steps
      rw [h_jumps_eq_sum]
      unfold coreCascadeCost
      dsimp (config := { failIfUnchanged := false }) only [subOps]
      rw [hcost_full]
      omega




  refine ⟨hpart, hbuckets.1, hbuckets.2.1, hpost, ?_⟩
  let mkSub : ℕ × ℕ → ℕ × List CoreOp := fun b =>
    if hb : b.1 < b.2 ∧ b.2 ≤ P then
      (b.2 - b.1, Classical.choose (hproj b.1 b.2 hb.1 hb.2))
    else
      (b.2 - b.1, [])
  let subs : List (ℕ × List CoreOp) := (scaleBlocks S P L).map mkSub
  refine ⟨subs, ?_, ?_, ?_⟩
  · simp only [subs, List.map_map]
    congr 1
    funext b
    by_cases hb : b.1 < b.2 ∧ b.2 ≤ P <;> simp [mkSub, hb]
  · intro q hq
    rcases List.mem_map.mp hq with ⟨b, hb_mem, rfl⟩
    have hbnd := hpart.blocks_bounds L le_rfl b hb_mem
    have hb : b.1 < b.2 ∧ b.2 ≤ P := ⟨hbnd.1, hbnd.2.1⟩
    simp only [mkSub, dif_pos hb]
    have hspec := Classical.choose_spec (hproj b.1 b.2 hb.1 hb.2)
    exact ⟨by omega, hbnd.2.2.2, hspec.1⟩
  · have h_sum_le : ∀ bs : List (ℕ × ℕ),
        (∀ b ∈ bs, b.1 < b.2 ∧ b.2 ≤ P) →
        (bs.map (fun b =>
          ((Finset.range (jumps kops).length).filter (fun id =>
            (match (jumps kops)[id]? with
            | none => false
            | some e => decide (b.1 ≤ e.s ∧ e.z < b.2)) = true)).card)).sum ≤
        ((bs.map mkSub).map (fun q => coreCascadeCost q.2)).sum := by
      intro bs
      induction bs with
      | nil => intro _; simp
      | cons b rest ih =>
        intro hall
        have hb : b.1 < b.2 ∧ b.2 ≤ P := hall b (by simp)
        have hrest := ih (fun x hx => hall x (List.mem_cons_of_mem b hx))
        simp only [List.map_cons, List.sum_cons]
        have hmk_b : mkSub b = (b.2 - b.1, Classical.choose (hproj b.1 b.2 hb.1 hb.2)) := by
          dsimp (config := { failIfUnchanged := false }) only [mkSub]
          rw [dif_pos hb]
        rw [hmk_b]
        have hspec := (Classical.choose_spec (hproj b.1 b.2 hb.1 hb.2)).2
        exact Nat.add_le_add hspec hrest
    exact le_trans hbuckets.2.2 (h_sum_le (scaleBlocks S P L) (fun b hb =>
      ⟨(hpart.blocks_bounds L le_rfl b hb).1, (hpart.blocks_bounds L le_rfl b hb).2.1⟩))


theorem primal_scale_subgames_and_post_bound_omega (P L : ℕ) (S : ℕ → ℕ) (kops : List KeyedCoreOp)
    (hP : 1 ≤ P) (hL : 1 ≤ L) (hS0 : S 0 = P) (hSL_pos : 1 ≤ S L)
    (hS_step : ∀ ℓ : ℕ, ℓ < L → 2 * S (ℓ + 1) ≤ S ℓ)
    (hkvalid : ValidKeyedCoreSeq P kops) (hjump : PrimalJumpLaws P kops) :
    ScalePartitionLawsOmega S P L ∧
    (jumps kops).length =
      (B_fin_pre S P L kops).card + (B_fin_exit S P L kops).card +
        (B_fin_act S P L kops).card + (B_1 S P L kops).card +
        (B_2 S P L kops).card + (B_3_intra S P L kops).card +
        (B_3_post S P L kops).card + (B_3_act S P L kops).card ∧
    (B_fin_exit S P L kops).card ≤ P ∧
    (B_3_post S P L kops).card ≤ countKeyedRslr kops ∧
    ∃ subs : List (ℕ × List CoreOp),
      (subs.map Prod.fst).sum = P ∧
      (∀ q ∈ subs, 1 ≤ q.1 ∧ q.1 < 2 * S L ∧ ValidCoreSeq q.1 q.2) ∧
      (B_fin_act S P L kops).card ≤ (subs.map (fun q => coreCascadeCost q.2)).sum := by
  obtain ⟨hpart, hjumps, hfexit, hpost, subs, hmap_eq, hval, hact⟩ :=
    primal_scale_subgames_and_post_bound_omega_full P L S kops
      hP hL hS0 hSL_pos hS_step hkvalid hjump
  refine ⟨hpart, hjumps, hfexit, hpost, subs, ?_, hval, hact⟩
  rw [hmap_eq]
  exact hpart.blocks_sum L le_rfl

/-!
================================================================================
Section 2: Elementary Bisection Base Bound (`bisection_core_base_bound`)
================================================================================
-/

private theorem bisection_core_base_bound_with_full
    (h_omega_full : ∀ (P L : ℕ) (S : ℕ → ℕ) (kops : List KeyedCoreOp),
      1 ≤ P → 1 ≤ L → S 0 = P → 1 ≤ S L →
      (∀ ℓ : ℕ, ℓ < L → 2 * S (ℓ + 1) ≤ S ℓ) →
      ValidKeyedCoreSeq P kops → PrimalJumpLaws P kops →
      ScalePartitionLawsOmega S P L ∧
      (jumps kops).length =
        (B_fin_pre S P L kops).card + (B_fin_exit S P L kops).card +
          (B_fin_act S P L kops).card + (B_1 S P L kops).card +
          (B_2 S P L kops).card + (B_3_intra S P L kops).card +
          (B_3_post S P L kops).card + (B_3_act S P L kops).card ∧
      (B_fin_exit S P L kops).card ≤ P ∧
      (B_3_post S P L kops).card ≤ countKeyedRslr kops ∧
      ∃ subs : List (ℕ × List CoreOp),
        subs.map Prod.fst = (scaleBlocks S P L).map (fun b => b.2 - b.1) ∧
        (∀ q ∈ subs, 1 ≤ q.1 ∧ q.1 < 2 * S L ∧ ValidCoreSeq q.1 q.2) ∧
        (B_fin_act S P L kops).card ≤ (subs.map (fun q => coreCascadeCost q.2)).sum)
    (P : ℕ) (ops : List CoreOp)
    (hP : 1 ≤ P) (hvalid : ValidCoreSeq P ops) :
    coreCascadeCost ops ≤ 12 * P * (Nat.log 2 P + 1) := by
  have h_small : ∀ (P0 : ℕ) (ops0 : List CoreOp),
      1 ≤ P0 → P0 ≤ 3 → ValidCoreSeq P0 ops0 → coreCascadeCost ops0 ≤ P0 := by
    intro P0 ops0 hP0_lo hP0_hi hval0
    obtain ⟨kops, _, _, hjump, _, hcost_jumps⟩ :=
      primal_keyed_labeling_and_cost_bridge P0 ops0 hP0_lo hval0
    have hj_zero : (jumps kops).length = 0 := by
      by_contra hne
      have hpos : 0 < (jumps kops).length := by omega
      obtain ⟨_, _, _, _, hsx, hxy, hyz, hzP, _, _⟩ := hjump.jump_anatomies 0 hpos
      omega
    omega

  have h_list_sum : ∀ (k : ℕ) (xs : List (ℕ × List CoreOp)),
      (∀ q ∈ xs, coreCascadeCost q.2 ≤ 7 * q.1 * k + q.1) →
      (xs.map (fun q => coreCascadeCost q.2)).sum ≤ (7 * k + 1) * (xs.map Prod.fst).sum := by
    intro k xs
    induction xs with
    | nil => intro _; simp
    | cons x rest ih =>
      intro hall
      have hx := hall x (by simp)
      have hrest := ih (fun q hq => hall q (List.mem_cons_of_mem x hq))
      simp only [List.map_cons, List.sum_cons]
      nlinarith

  have h_pow : ∀ (k P0 : ℕ) (ops0 : List CoreOp),
      1 ≤ P0 → P0 ≤ 2 ^ k → ValidCoreSeq P0 ops0 →
      coreCascadeCost ops0 ≤ 7 * P0 * k + P0 := by
    intro k
    induction k with
    | zero =>
      intro P0 ops0 hP0_lo hP0_hi hval0
      have hle3 : P0 ≤ 3 := by simpa using le_trans hP0_hi (by decide : 1 ≤ 3)
      have hc := h_small P0 ops0 hP0_lo hle3 hval0
      omega
    | succ k ih =>
      intro P0 ops0 hP0_lo hP0_hi hval0
      by_cases hP3 : P0 ≤ 3
      · have hc := h_small P0 ops0 hP0_lo hP3 hval0
        nlinarith
      · have hP4 : 4 ≤ P0 := by omega
        obtain ⟨kops, _, hkvalid, hjump, _, hcost_jumps⟩ :=
          primal_keyed_labeling_and_cost_bridge P0 ops0 hP0_lo hval0
        obtain ⟨hfold, _⟩ := folded_dual_laws_and_mbase_bound P0 kops hP0_lo hkvalid hjump
        let S : ℕ → ℕ
          | 0 => P0
          | _ + 1 => P0 / 2
        have hS0 : S 0 = P0 := rfl
        have hS1 : S 1 = P0 / 2 := rfl
        have hSL_le : 1 ≤ S 1 := by rw [hS1]; omega
        have hS_step : ∀ ℓ : ℕ, ℓ < 1 → 2 * S (ℓ + 1) ≤ S ℓ := by
          intro ℓ hℓ
          have h0 : ℓ = 0 := by omega
          subst h0
          change 2 * (P0 / 2) ≤ P0
          omega
        have h_div2 : P0 / (P0 / 2) = 2 := by
          set B := P0 / 2
          have hB : 2 ≤ B := by omega
          have hlo : 2 ≤ P0 / B := (Nat.le_div_iff_mul_le (by omega)).mpr (by omega)
          have hhi : P0 / B < 3 := (Nat.div_lt_iff_lt_mul (by omega)).mpr (by omega)
          omega
        have h_sb1 : scaleBlocks S P0 1 = [(0, P0 / 2), (P0 / 2, P0)] := by
          simp only [scaleBlocks, List.flatMap_cons, List.flatMap_nil, List.append_nil, hS1]
          unfold splitBlock
          simp [h_div2]
        have h_sb1_len : (scaleBlocks S P0 1).length = 2 := by
          rw [h_sb1]
          rfl
        obtain ⟨hpart_om, hjumps_eq, hfexit, _, subs, hmap_eq, hsubs_val, hfact⟩ :=
          h_omega_full P0 1 S kops
            hP0_lo le_rfl hS0 hSL_le hS_step hkvalid hjump
        have hpart_std : ScalePartitionLaws S P0 1 := {
          blocks_sum := hpart_om.blocks_sum
          blocks_bounds := hpart_om.blocks_bounds
          blocks_partition := hpart_om.blocks_partition
          blocks_eq_iff := hpart_om.blocks_eq_iff
          blocks_mono := hpart_om.blocks_mono
          child_blocks := hpart_om.child_blocks
          finest_count_bound := by rw [h_sb1_len]; omega
          sep_symm := hpart_om.sep_symm
          sep_top := hpart_om.sep_top
          sep_range := hpart_om.sep_range
          sep_self := hpart_om.sep_self
          sep_gt_iff := hpart_om.sep_gt_iff
          sep_ultrametric := hpart_om.sep_ultrametric
        }
        obtain ⟨hfpre, _, _, hb2⟩ :=
          folded_spine_lock_and_confinement_buckets P0 1 S kops
            hP0_lo le_rfl hS0 hSL_le hS_step hkvalid hjump hfold hpart_std
        have hb1_zero : (B_1 S P0 1 kops).card = 0 := by
          rw [Finset.card_eq_zero, Finset.eq_empty_iff_forall_notMem]
          intro id hid
          simp only [B_1, Finset.mem_filter, Finset.mem_range, isB1] at hid
          obtain ⟨hid_lt, his⟩ := hid
          rw [List.getElem?_eq_getElem hid_lt, decide_eq_true_eq] at his
          obtain ⟨_, _, _, _, hsx, hxy, hyz, hzP, _, _⟩ := hjump.jump_anatomies id hid_lt
          have hrng := hpart_om.sep_range ((jumps kops)[id]).s (by omega)
            ((jumps kops)[id]).x (by omega) (by omega)
          omega
        have h_no_sep11 : ∀ id (hid : id < (jumps kops).length),
            sepScale S P0 1 ((jumps kops)[id]).x ((jumps kops)[id]).y = 1 →
            sepScale S P0 1 ((jumps kops)[id]).s ((jumps kops)[id]).x = 1 → False := by
          intro id hid hxy1 hsx1
          obtain ⟨_, _, _, _, hsx, hxy, hyz, hzP, _, _⟩ := hjump.jump_anatomies id hid
          set e := (jumps kops)[id]
          have hsP : e.s < P0 := by omega
          have hxP : e.x < P0 := by omega
          have hyP : e.y < P0 := by omega
          have hne_sx : blockIdx S P0 1 e.s ≠ blockIdx S P0 1 e.x := by
            intro heq
            have := (hpart_om.sep_gt_iff 1 le_rfl e.s hsP e.x hxP).mpr heq
            omega
          have hne_xy : blockIdx S P0 1 e.x ≠ blockIdx S P0 1 e.y := by
            intro heq
            have := (hpart_om.sep_gt_iff 1 le_rfl e.x hxP e.y hyP).mpr heq
            omega
          have hle_sx := hpart_om.blocks_mono 1 le_rfl e.s e.x (by omega) hxP
          have hle_xy := hpart_om.blocks_mono 1 le_rfl e.x e.y (by omega) hyP
          have hy_idx := (hpart_om.blocks_partition 1 le_rfl e.y hyP).1
          rw [h_sb1_len] at hy_idx
          omega
        have hb3i_zero : (B_3_intra S P0 1 kops).card = 0 := by
          rw [Finset.card_eq_zero, Finset.eq_empty_iff_forall_notMem]
          intro id hid
          simp only [B_3_intra, Finset.mem_filter, Finset.mem_range, isB3Intra] at hid
          obtain ⟨hid_lt, his⟩ := hid
          rw [List.getElem?_eq_getElem hid_lt, decide_eq_true_eq] at his
          exact h_no_sep11 id hid_lt (by omega) (by omega)
        have hb3p_zero : (B_3_post S P0 1 kops).card = 0 := by
          rw [Finset.card_eq_zero, Finset.eq_empty_iff_forall_notMem]
          intro id hid
          simp only [B_3_post, Finset.mem_filter, Finset.mem_range, isB3Post] at hid
          obtain ⟨hid_lt, his⟩ := hid
          rw [List.getElem?_eq_getElem hid_lt, decide_eq_true_eq] at his
          exact h_no_sep11 id hid_lt (by omega) (by omega)
        have hb3a_zero : (B_3_act S P0 1 kops).card = 0 := by
          rw [Finset.card_eq_zero, Finset.eq_empty_iff_forall_notMem]
          intro id hid
          simp only [B_3_act, Finset.mem_filter, Finset.mem_range, isB3Act] at hid
          obtain ⟨hid_lt, his⟩ := hid
          rw [List.getElem?_eq_getElem hid_lt, decide_eq_true_eq] at his
          exact h_no_sep11 id hid_lt (by omega) (by omega)
        have hsubs_fst : subs.map Prod.fst = [P0 / 2, P0 - P0 / 2] := by
          rw [hmap_eq, h_sb1]
          simp
        have hsubs_sum : (subs.map Prod.fst).sum = P0 := by
          rw [hsubs_fst]
          simp
          omega
        have hpow_succ : 2 ^ (k + 1) = 2 * 2 ^ k := by
          rw [pow_succ]
          ring
        have hsubs_ih : ∀ q ∈ subs, coreCascadeCost q.2 ≤ 7 * q.1 * k + q.1 := by
          intro q hq
          obtain ⟨hq1, _, hq_val⟩ := hsubs_val q hq
          have hq_mem : q.1 ∈ subs.map Prod.fst := List.mem_map_of_mem hq
          rw [hsubs_fst] at hq_mem
          have hq_le : q.1 ≤ 2 ^ k := by
            simp only [List.mem_cons, List.not_mem_nil, or_false] at hq_mem
            rcases hq_mem with hq_eq | hq_eq
            · omega
            · omega
          exact ih q.1 q.2 hq1 hq_le hq_val
        have hsum_cost := h_list_sum k subs hsubs_ih
        rw [hsubs_sum] at hsum_cost
        rw [h_sb1_len] at hb2
        nlinarith

  have hlt_pow : P < 2 ^ (Nat.log 2 P + 1) := Nat.lt_pow_succ_log_self (by decide) P
  have h7 := h_pow (Nat.log 2 P + 1) P ops hP (le_of_lt hlt_pow) hvalid
  nlinarith

theorem bisection_core_base_bound (P : ℕ) (ops : List CoreOp)
    (hP : 1 ≤ P) (hvalid : ValidCoreSeq P ops) :
    coreCascadeCost ops ≤ 12 * P * (Nat.log 2 P + 1) :=
  bisection_core_base_bound_with_full primal_scale_subgames_and_post_bound_omega_full P ops hP hvalid

/-!
================================================================================
Section 3: Height-Independent `B_1_exit` Bound (`b1_exit_card_bound`)
================================================================================
-/

theorem b1_exit_card_bound (P L : ℕ) (S : ℕ → ℕ) (kops : List KeyedCoreOp)
    (hP : 1 ≤ P) (hL : 1 ≤ L)
    (hkvalid : ValidKeyedCoreSeq P kops) (hjump : PrimalJumpLaws P kops)
    (hfold : ValidFoldedCoreLaws P kops) (hpart : ScalePartitionLawsOmega S P L) :
    (B_1_exit S P L kops).card ≤ (Finset.Icc 1 L).sum (fun ℓ => (scaleBlocks S P ℓ).length) := by
  have _ := hP
  have _ := hL
  have h_primal_ls : ∀ t ≤ kops.length, ∀ (i u : ℕ),
      (leftSpineBottomUpNat (keyedState kops t))[i]? = some u →
      u ∈ leftSpineBottomUpNat (foldBST P (keyedState kops t)).1 := by
    intro t ht i u hget
    rw [hfold.fold_leftSpine t ht]
    exact List.mem_append_left _ (List.mem_of_getElem? hget)

  have h_jump_bounds : ∀ id (hid : id < (jumps kops).length),
      let e := (jumps kops)[id]
      e.step < kops.length ∧ e.j < e.m ∧
        e.s < e.x ∧ e.x < e.y ∧ e.y < e.z ∧ e.z < P := by
    intro id hid
    obtain ⟨_, hstep, _, hjm, hsx, hxy, hyz, hzP, _, _⟩ := hjump.jump_anatomies id hid
    exact ⟨hstep, hjm, hsx, hxy, hyz, hzP⟩

  have h_jump_popStep : ∀ id (hid : id < (jumps kops).length),
      popStep kops ((jumps kops)[id]).s = ((jumps kops)[id]).step := by
    intro id hid
    obtain ⟨_, hstep, hpop_opt, _, _, _, _, _, _, _⟩ := hjump.jump_anatomies id hid
    have hget : kops[((jumps kops)[id]).step] = .pop ((jumps kops)[id]).s := by
      rw [List.getElem?_eq_getElem hstep] at hpop_opt
      exact Option.some.inj hpop_opt
    have hsv := hkvalid.step_valid ((jumps kops)[id]).step hstep
    rw [hget] at hsv
    exact hsv.2.1

  have h_jump_y_ls : ∀ id (hid : id < (jumps kops).length),
      let e := (jumps kops)[id]
      e.y ∈ leftSpineBottomUpNat (foldBST P (keyedState kops e.step)).1 := by
    intro id hid
    obtain ⟨_, hstep, _, _, _, _, _, _, ⟨_, _, _, hy, _⟩, _⟩ := hjump.jump_anatomies id hid
    exact h_primal_ls _ (Nat.le_of_lt hstep) _ _ hy

  have h_adj_step : ∀ id1 (h2 : id1 + 1 < (jumps kops).length),
      ((jumps kops)[id1]).step = ((jumps kops)[id1 + 1]).step →
      ((jumps kops)[id1]).z = ((jumps kops)[id1 + 1]).x := by
    intro id1 h2 hst
    have h1 : id1 < (jumps kops).length := by omega
    have hord := hjump.jump_order id1 h1 (id1 + 1) h2 (by omega)
    have hj_lt : ((jumps kops)[id1]).j < ((jumps kops)[id1 + 1]).j := by
      rcases hord with hlt | ⟨_, hj⟩
      · omega
      · exact hj
    obtain ⟨_, _, _, _, _, _, _, _, ⟨hm1, _⟩, hsucc1⟩ := hjump.jump_anatomies id1 h1
    obtain ⟨_, _, _, hj2m2, _, _, _, _, ⟨hm2, _⟩, _⟩ := hjump.jump_anatomies (id1 + 1) h2
    have hm_eq : ((jumps kops)[id1]).m = ((jumps kops)[id1 + 1]).m := by
      rw [hm1, hm2, hst]
    have hjm1 : ((jumps kops)[id1]).j + 1 < ((jumps kops)[id1]).m := by omega
    obtain ⟨_, _, _, _, _, hx_eq⟩ := hsucc1 hjm1
    exact hx_eq.symm

  have h_same_step : ∀ id1 (hid1 : id1 < (jumps kops).length)
      id2 (hid2 : id2 < (jumps kops).length),
      id1 < id2 →
      ((jumps kops)[id1]).step = ((jumps kops)[id2]).step →
      ((jumps kops)[id1]).z ≤ ((jumps kops)[id2]).x := by
    have h_ind : ∀ id2 (hid2 : id2 < (jumps kops).length)
        id1 (hid1 : id1 < (jumps kops).length),
        id1 < id2 →
        ((jumps kops)[id1]).step = ((jumps kops)[id2]).step →
        ((jumps kops)[id1]).z ≤ ((jumps kops)[id2]).x := by
      intro id2
      induction id2 with
      | zero => intro _ _ _ hlt; omega
      | succ id2 ih =>
        intro hid2 id1 hid1 hlt hst
        by_cases heq : id1 = id2
        · subst heq
          have hadj := h_adj_step id1 hid2 hst
          omega
        · have hlt' : id1 < id2 := by omega
          have hid2' : id2 < (jumps kops).length := by omega
          have hord1 := hjump.jump_order id1 hid1 id2 hid2' hlt'
          have hord2 := hjump.jump_order id2 hid2' (id2 + 1) hid2 (by omega)
          have hst1 : ((jumps kops)[id1]).step = ((jumps kops)[id2]).step := by
            rcases hord1 with h1 | ⟨h1, _⟩ <;> rcases hord2 with h2 | ⟨h2, _⟩ <;> omega
          have hst2 : ((jumps kops)[id2]).step = ((jumps kops)[id2 + 1]).step := by omega
          have hrec := ih hid2' id1 hid1 hlt' hst1
          have hadj := h_adj_step id2 hid2 hst2
          have hb2 := h_jump_bounds id2 hid2'
          dsimp (config := { failIfUnchanged := false }) only at hb2
          omega
    intro id1 hid1 id2 hid2 hlt hst
    exact h_ind id2 hid2 id1 hid1 hlt hst

  have h_lock_contra : ∀ id1 (hid1 : id1 < (jumps kops).length)
      id2 (hid2 : id2 < (jumps kops).length),
      ((jumps kops)[id1]).step < ((jumps kops)[id2]).step →
      ((jumps kops)[id2]).s < ((jumps kops)[id1]).x →
      ∀ u ∈ leftSpineBottomUpNat (foldBST P (keyedState kops ((jumps kops)[id2]).step)).1,
        ((jumps kops)[id1]).x < u → u < ((jumps kops)[id1]).z → False := by
    intro id1 hid1 id2 hid2 hst_lt hs_lt u hu_ls hux huz
    have hb1 := h_jump_bounds id1 hid1
    dsimp (config := { failIfUnchanged := false }) only at hb1
    have hx1P : ((jumps kops)[id1]).x < P := by omega
    have hp2 := h_jump_popStep id2 hid2
    have hpmono := hkvalid.popStep_mono ((jumps kops)[id2]).s ((jumps kops)[id1]).x hs_lt hx1P
    exact ((hfold.spine_lock id1 hid1).2 ((jumps kops)[id2]).step (by omega) (by omega)).1
      u hu_ls ⟨hux, huz⟩

  let targetSet : Finset (ℕ × ℕ) :=
    (Finset.Icc 1 L).biUnion (fun ℓ =>
      (Finset.range (scaleBlocks S P ℓ).length).image (fun q => (ℓ, q)))

  have h_target_card :
      targetSet.card = (Finset.Icc 1 L).sum (fun ℓ => (scaleBlocks S P ℓ).length) := by
    dsimp (config := { failIfUnchanged := false }) only [targetSet]
    rw [Finset.card_biUnion]
    · refine Finset.sum_congr rfl ?_
      intro ℓ _
      rw [Finset.card_image_of_injective _ (fun a b h => (Prod.mk.inj h).2), Finset.card_range]
    · intro ℓ1 _ ℓ2 _ hne
      dsimp (config := { failIfUnchanged := false }) only [Function.onFun]
      rw [Finset.disjoint_left]
      intro p hp1 hp2
      obtain ⟨_, _, hp1_eq⟩ := Finset.mem_image.mp hp1
      obtain ⟨_, _, hp2_eq⟩ := Finset.mem_image.mp hp2
      rw [← hp1_eq] at hp2_eq
      exact hne (Prod.mk.inj hp2_eq).1.symm

  let f : ℕ → ℕ × ℕ := fun id =>
    let e := (jumps kops).getD id default
    let ℓ := sepScale S P L e.x e.y
    (ℓ, blockIdx S P ℓ e.y)

  have h_inj : (B_1_exit S P L kops).card ≤ targetSet.card := by
    refine Finset.card_le_card_of_injOn f ?_ ?_
    · intro id hid
      have hid' := Finset.mem_coe.mp hid
      simp only [B_1_exit, Finset.mem_filter, Finset.mem_range, isB1Exit] at hid'
      obtain ⟨hlt, his⟩ := hid'
      rw [List.getElem?_eq_getElem hlt, decide_eq_true_eq] at his
      obtain ⟨hℓ1, hℓL, _, _⟩ := his
      have hb := h_jump_bounds id hlt
      dsimp (config := { failIfUnchanged := false }) only at hb
      have hyP : ((jumps kops)[id]).y < P := by omega
      have hidx := (hpart.blocks_partition _ hℓL _ hyP).1
      dsimp (config := { failIfUnchanged := false }) only [f, targetSet]
      rw [List.getD_eq_getElem _ _ hlt]
      refine Finset.mem_biUnion.mpr ⟨_, Finset.mem_Icc.mpr ⟨hℓ1, hℓL⟩, ?_⟩
      exact Finset.mem_image.mpr ⟨_, Finset.mem_range.mpr hidx, rfl⟩
    · intro a ha b hb heq
      have hne_lt : ∀ id1 ∈ B_1_exit S P L kops, ∀ id2 ∈ B_1_exit S P L kops,
          id1 < id2 → f id1 = f id2 → False := by
        intro id1 hid1 id2 hid2 hlt hfeq
        simp only [B_1_exit, Finset.mem_filter, Finset.mem_range, isB1Exit] at hid1 hid2
        obtain ⟨h1_lt, his1⟩ := hid1
        obtain ⟨h2_lt, his2⟩ := hid2
        rw [List.getElem?_eq_getElem h1_lt, decide_eq_true_eq] at his1
        rw [List.getElem?_eq_getElem h2_lt, decide_eq_true_eq] at his2
        obtain ⟨hℓ1, hℓL, _, hz1_exit⟩ := his1
        obtain ⟨_, _, hsep_sx2, _⟩ := his2
        dsimp (config := { failIfUnchanged := false }) only [f] at hfeq
        rw [List.getD_eq_getElem _ _ h1_lt, List.getD_eq_getElem _ _ h2_lt] at hfeq
        obtain ⟨hℓ_eq, hq_eq⟩ := Prod.mk.inj hfeq
        have hb1 := h_jump_bounds id1 h1_lt
        have hb2 := h_jump_bounds id2 h2_lt
        dsimp (config := { failIfUnchanged := false }) only at hb1 hb2
        set e1 := (jumps kops)[id1]
        set e2 := (jumps kops)[id2]
        set ℓ := sepScale S P L e1.x e1.y
        rw [← hℓ_eq] at hq_eq hsep_sx2
        have hx1P : e1.x < P := by omega
        have hy1P : e1.y < P := by omega
        have hs2P : e2.s < P := by omega
        have hx2P : e2.x < P := by omega
        have hy2P : e2.y < P := by omega
        have hQ_eq : blockOf S P ℓ e1.y = blockOf S P ℓ e2.y := by
          simp only [blockOf, hq_eq]
        obtain ⟨_, hQ2_lo, hQ2_hi, _⟩ := hpart.blocks_partition ℓ hℓL e2.y hy2P
        have hx1_lt_Q : e1.x < (blockOf S P ℓ e1.y).1 := by
          obtain ⟨_, hx1_lo, _, _⟩ := hpart.blocks_partition ℓ hℓL e1.x hx1P
          by_contra hcon
          have hy1_hi := (hpart.blocks_partition ℓ hℓL e1.y hy1P).2.2.1
          have h_same : blockIdx S P ℓ e1.y = blockIdx S P ℓ e1.x :=
            (hpart.blocks_eq_iff ℓ hℓL e1.y hy1P e1.x hx1P).mpr ⟨by omega, by omega⟩
          have hgt := (hpart.sep_gt_iff ℓ hℓL e1.x hx1P e1.y hy1P).mpr h_same.symm
          omega
        rcases hjump.jump_order id1 h1_lt id2 h2_lt hlt with hst_lt | ⟨hst_eq, _⟩
        · by_cases hs2_lt_x1 : e2.s < e1.x
          · have hy2_ls := h_jump_y_ls id2 h2_lt
            rw [hQ_eq] at hx1_lt_Q hz1_exit
            exact h_lock_contra id1 h1_lt id2 h2_lt hst_lt hs2_lt_x1 e2.y hy2_ls
              (by dsimp (config := { failIfUnchanged := false }) only [e1, e2] at *; omega) (by dsimp (config := { failIfUnchanged := false }) only [e1, e2] at *; omega)
          · have hx1_le_s2 : e1.x ≤ e2.s := by omega
            have hidx_p1 : blockIdx S P (ℓ - 1) e1.x = blockIdx S P (ℓ - 1) e1.y :=
              (hpart.sep_gt_iff (ℓ - 1) (by omega) e1.x hx1P e1.y hy1P).mp (by omega)
            have hsep_y12 : ℓ < sepScale S P L e1.y e2.y :=
              (hpart.sep_gt_iff ℓ hℓL e1.y hy1P e2.y hy2P).mpr hq_eq
            have hidx_py : blockIdx S P (ℓ - 1) e1.y = blockIdx S P (ℓ - 1) e2.y :=
              (hpart.sep_gt_iff (ℓ - 1) (by omega) e1.y hy1P e2.y hy2P).mp (by omega)
            have hm1 := hpart.blocks_mono (ℓ - 1) (by omega) e1.x e2.s hx1_le_s2 hs2P
            have hm2 := hpart.blocks_mono (ℓ - 1) (by omega) e2.s e2.x (by omega) hx2P
            have hm3 := hpart.blocks_mono (ℓ - 1) (by omega) e2.x e2.y (by omega) hy2P
            have hidx_sx2 : blockIdx S P (ℓ - 1) e2.s = blockIdx S P (ℓ - 1) e2.x := by omega
            have hgt_sx2 := (hpart.sep_gt_iff (ℓ - 1) (by omega) e2.s hs2P e2.x hx2P).mpr hidx_sx2
            omega
        · have hchain := h_same_step id1 h1_lt id2 h2_lt hlt hst_eq
          rw [hQ_eq] at hz1_exit
          dsimp (config := { failIfUnchanged := false }) only [e1, e2] at *
          omega
      have ha' := Finset.mem_coe.mp ha
      have hb' := Finset.mem_coe.mp hb
      rcases lt_trichotomy a b with hlt | rfl | hgt
      · exact False.elim (hne_lt a ha' b hb' hlt heq)
      · rfl
      · exact False.elim (hne_lt b hb' a ha' hgt heq.symm)
  rw [← h_target_card]
  exact h_inj

/-!
================================================================================
Section 4: Epoch Grouping Tree Weights & Confinement Buckets
(`epoch_tree_weights_and_buckets`)
================================================================================
-/

private def stepsToStop (Stop : Finset ℕ) : ℕ → ℕ → ℕ
  | 0, _ => 0
  | fuel + 1, a => if a ∈ Stop then 0 else 1 + stepsToStop Stop fuel (a + 1)

private theorem omega_chain_card_bound (r : ℕ) (A Stop : Finset ℕ) (rem : ℕ → ℕ)
    (hrem : ∀ a ∈ A, rem a < r)
    (hstep : ∀ a ∈ A, a ∉ Stop → a + 1 ∈ A ∧ rem (a + 1) < rem a) :
    A.card ≤ r * Stop.card := by
  have h_fuel : ∀ (fuel a : ℕ), a ∈ A → rem a < fuel →
      stepsToStop Stop fuel a < fuel ∧ a + stepsToStop Stop fuel a ∈ Stop := by
    intro fuel
    induction fuel with
    | zero =>
      intro a _ hlt
      omega
    | succ fuel ih =>
      intro a ha hlt
      simp only [stepsToStop]
      split_ifs with hmem
      · exact ⟨by omega, by simpa using hmem⟩
      · obtain ⟨ha1, hrem1⟩ := hstep a ha hmem
        obtain ⟨hk_lt, hstop⟩ := ih (a + 1) ha1 (by omega)
        refine ⟨by omega, ?_⟩
        have heq : a + (1 + stepsToStop Stop fuel (a + 1)) =
            (a + 1) + stepsToStop Stop fuel (a + 1) := by omega
        rw [heq]
        exact hstop
  let f : ℕ → ℕ × ℕ := fun a => (stepsToStop Stop r a, a + stepsToStop Stop r a)
  have hle : A.card ≤ ((Finset.range r) ×ˢ Stop).card := by
    refine Finset.card_le_card_of_injOn f ?_ ?_
    · intro a ha
      obtain ⟨hk, hst⟩ := h_fuel r a (Finset.mem_coe.mp ha) (hrem a (Finset.mem_coe.mp ha))
      exact Finset.mem_product.mpr ⟨Finset.mem_range.mpr hk, hst⟩
    · intro a1 _ a2 _ heq
      obtain ⟨h1, h2⟩ := Prod.mk.inj heq
      omega
  simpa only [Finset.card_product, Finset.card_range] using hle

private def listWeight (p : List ℕ) : ℕ :=
  (p.map (fun c => 4 * c ^ 2)).prod

private theorem sum_inv_four_sq_le_half (M : ℕ) :
    (Finset.Icc 1 M).sum (fun c : ℕ => (1 : ℚ) / (4 * (c : ℚ) ^ 2)) ≤ 1 / 2 := by
  rcases M with _ | k
  · simp
  · have h_tele : ∀ n : ℕ,
        (Finset.Icc 1 (n + 1)).sum (fun c : ℕ => (1 : ℚ) / (4 * (c : ℚ) ^ 2)) ≤
          1 / 2 - 1 / (4 * ((n + 1 : ℕ) : ℚ)) := by
      intro n
      induction n with
      | zero =>
        norm_num
      | succ n ih =>
        have h_ins : Finset.Icc 1 (n + 2) = insert (n + 2) (Finset.Icc 1 (n + 1)) := by
          ext x
          simp only [Finset.mem_Icc, Finset.mem_insert]
          omega
        have h_not : n + 2 ∉ Finset.Icc 1 (n + 1) := by
          simp only [Finset.mem_Icc]
          omega
        rw [h_ins, Finset.sum_insert h_not]
        set a : ℚ := ((n + 1 : ℕ) : ℚ)
        have ha_pos : 0 < a := by positivity
        have ha1_pos : 0 < a + 1 := by positivity
        have h_cast : ((n + 2 : ℕ) : ℚ) = a + 1 := by
          dsimp (config := { failIfUnchanged := false }) only [a]
          push_cast
          ring
        rw [h_cast]
        have h_ident :
            1 / (4 * a) - 1 / (4 * (a + 1)) - 1 / (4 * (a + 1) ^ 2) =
              1 / (4 * a * (a + 1) ^ 2) := by
          field_simp
          ring
        have h_nonneg : 0 ≤ 1 / (4 * a * (a + 1) ^ 2) := by positivity
        linarith
    have hk := h_tele k
    have h_pos : 0 ≤ 1 / (4 * ((k + 1 : ℕ) : ℚ)) := by positivity
    linarith

private theorem sum_inv_listWeight_le : ∀ (n M : ℕ) (A : Finset (List ℕ)),
    (∀ p ∈ A, p.length = n ∧ ∀ c ∈ p, 1 ≤ c ∧ c ≤ M) →
    A.sum (fun p => (1 : ℚ) / (listWeight p : ℚ)) ≤ (1 / 2 : ℚ) ^ n := by
  intro n
  induction n with
  | zero =>
    intro M A hA
    have hsub : A ⊆ {[]} := by
      intro p hp
      have hlen := (hA p hp).1
      have hp_nil : p = [] := List.eq_nil_of_length_eq_zero hlen
      subst hp_nil
      simp
    have hle :
        A.sum (fun p => (1 : ℚ) / (listWeight p : ℚ)) ≤
          ({[]} : Finset (List ℕ)).sum (fun p => (1 : ℚ) / (listWeight p : ℚ)) :=
      Finset.sum_le_sum_of_subset_of_nonneg hsub (fun _ _ _ => by positivity)
    simpa [listWeight] using hle
  | succ n ih =>
    intro M A hA
    let B : Finset (List ℕ) := A.image List.tail
    have hB : ∀ tl ∈ B, tl.length = n ∧ ∀ c ∈ tl, 1 ≤ c ∧ c ≤ M := by
      intro tl htl
      obtain ⟨p, hp, rfl⟩ := Finset.mem_image.mp htl
      obtain ⟨hlen, hc⟩ := hA p hp
      rcases p with _ | ⟨hd, tl⟩
      · simp at hlen
      · simp only [List.length_cons, List.tail_cons] at hlen ⊢
        exact ⟨by omega, fun c hcm => hc c (List.mem_cons_of_mem hd hcm)⟩
    have h_fib :
        A.sum (fun p => (1 : ℚ) / (listWeight p : ℚ)) =
          B.sum (fun tl =>
            (A.filter (fun p => p.tail = tl)).sum (fun p => (1 : ℚ) / (listWeight p : ℚ))) := by
      exact (Finset.sum_fiberwise_of_maps_to
        (fun p hp => Finset.mem_image_of_mem List.tail hp) _).symm
    rw [h_fib]
    have h_inner : ∀ tl ∈ B,
        (A.filter (fun p => p.tail = tl)).sum (fun p => (1 : ℚ) / (listWeight p : ℚ)) ≤
          ((1 : ℚ) / (listWeight tl : ℚ)) * (1 / 2) := by
      intro tl _
      let F := A.filter (fun p => p.tail = tl)
      have h_eq_sum :
          F.sum (fun p => (1 : ℚ) / (listWeight p : ℚ)) =
            ((1 : ℚ) / (listWeight tl : ℚ)) *
              F.sum (fun p => (1 : ℚ) / (4 * ((p.headD 0 : ℕ) : ℚ) ^ 2)) := by
        rw [Finset.mul_sum]
        refine Finset.sum_congr rfl ?_
        intro p hp
        obtain ⟨hpA, htl_eq⟩ := Finset.mem_filter.mp hp
        have hlen := (hA p hpA).1
        rcases p with _ | ⟨c, tl'⟩
        · simp at hlen
        · simp only [List.tail_cons] at htl_eq
          subst htl_eq
          simp only [List.headD_cons, listWeight, List.map_cons, List.prod_cons, Nat.cast_mul,
            Nat.cast_pow, Nat.cast_ofNat]
          ring
      rw [h_eq_sum]
      have h_inj : Set.InjOn (fun p : List ℕ => p.headD 0) ↑F := by
        intro p1 hp1 p2 hp2 hhd
        obtain ⟨hp1A, htl1⟩ := Finset.mem_filter.mp (Finset.mem_coe.mp hp1)
        obtain ⟨hp2A, htl2⟩ := Finset.mem_filter.mp (Finset.mem_coe.mp hp2)
        have hlen1 := (hA p1 hp1A).1
        have hlen2 := (hA p2 hp2A).1
        rcases p1 with _ | ⟨c1, t1⟩
        · simp at hlen1
        · rcases p2 with _ | ⟨c2, t2⟩
          · simp at hlen2
          · simp only [List.headD_cons, List.tail_cons] at hhd htl1 htl2
            rw [hhd, htl1, htl2]
      have h_img_sub : F.image (fun p : List ℕ => p.headD 0) ⊆ Finset.Icc 1 M := by
        intro c hc
        obtain ⟨p, hp, rfl⟩ := Finset.mem_image.mp hc
        obtain ⟨hpA, _⟩ := Finset.mem_filter.mp hp
        obtain ⟨hlen, hcp⟩ := hA p hpA
        rcases p with _ | ⟨c0, t0⟩
        · simp at hlen
        · simp only [List.headD_cons, Finset.mem_Icc]
          exact hcp c0 (by simp)
      have h_sum_c :
          F.sum (fun p => (1 : ℚ) / (4 * ((p.headD 0 : ℕ) : ℚ) ^ 2)) ≤ 1 / 2 := by
        have h_img_eq :
            (F.image (fun p : List ℕ => p.headD 0)).sum
              (fun c : ℕ => (1 : ℚ) / (4 * (c : ℚ) ^ 2)) =
              F.sum (fun p => (1 : ℚ) / (4 * ((p.headD 0 : ℕ) : ℚ) ^ 2)) :=
          Finset.sum_image h_inj
        rw [← h_img_eq]
        have h_sub_le :
            (F.image (fun p : List ℕ => p.headD 0)).sum
              (fun c : ℕ => (1 : ℚ) / (4 * (c : ℚ) ^ 2)) ≤
              (Finset.Icc 1 M).sum (fun c : ℕ => (1 : ℚ) / (4 * (c : ℚ) ^ 2)) :=
          Finset.sum_le_sum_of_subset_of_nonneg h_img_sub (fun _ _ _ => by positivity)
        exact le_trans h_sub_le (sum_inv_four_sq_le_half M)
      exact mul_le_mul_of_nonneg_left h_sum_c (by positivity)
    have h_le_B := Finset.sum_le_sum h_inner
    rw [← Finset.sum_mul] at h_le_B
    have h_ih := ih M B hB
    have h_pow : (1 / 2 : ℚ) ^ (n + 1) = (1 / 2 : ℚ) ^ n * (1 / 2) := by
      rw [pow_succ]
    linarith

theorem epoch_tree_weights_and_buckets (P L r : ℕ) (addr : ℕ → Fin r → ℕ) (S : ℕ → ℕ)
    (kops : List KeyedCoreOp)
    (hP : 1 ≤ P) (hL : 1 ≤ L) (hr : 1 ≤ r)
    (haddr : ValidEpochAddress r L addr)
    (hS0 : S 0 = P)
    (hS_def : ∀ ℓ, 1 ≤ ℓ → ℓ ≤ L →
      S ℓ = 13000 * epochLeafWeight r addr ℓ * (SplayTree.invAckermann (2 * S (ℓ - 1)) + 1) ^ 2)
    (hS_step : ∀ ℓ, ℓ < L → 2 * S (ℓ + 1) ≤ S ℓ)
    (hkvalid : ValidKeyedCoreSeq P kops) (hjump : PrimalJumpLaws P kops)
    (hfold : ValidFoldedCoreLaws P kops) (hpart : ScalePartitionLawsOmega S P L) :
    (B_fin_pre S P L kops).card ≤ P ∧
    (Finset.Icc 1 L).sum (fun ℓ => (1 : ℚ) / (epochLeafWeight r addr ℓ : ℚ)) ≤ 1 / 2 ∧
    (Finset.Icc 1 L).sum (fun ℓ => (scaleBlocks S P ℓ).length) ≤ P ∧
    (B_1 S P L kops).card ≤ 3 * r * P ∧
    (B_3_intra S P L kops).card ≤ 6 * P + countKeyedRslr kops ∧
    (B_2 S P L kops).card ≤
      P + r * (5 * P + (B_3_intra S P L kops).card +
        (B_3_post S P L kops).card + (B_3_act S P L kops).card) := by
  have _ := hP
  have _ := hL
  have _ := hS0
  have _ := hS_step

  -- =========================================================================
  -- Shared Spine-Lock, Jump, and Scale-Partition Helpers
  -- =========================================================================
  have h_ls_aux : ∀ (T : _root_.BinaryTree ℕ) (acc : List ℕ) (u : ℕ),
      u ∈ leftSpineBottomUpAux T acc → u ∈ inorderNat T ∨ u ∈ acc := by
    intro T
    induction T with
    | nil => intro acc u hu; exact Or.inr hu
    | node k l r ihl _ =>
      intro acc u hu
      simp only [leftSpineBottomUpAux] at hu
      rcases ihl (k :: acc) u hu with hl | hacc
      · left
        simp only [inorderNat, List.mem_append]
        exact Or.inl (Or.inl hl)
      · rcases List.mem_cons.mp hacc with rfl | hacc'
        · left; simp [inorderNat]
        · exact Or.inr hacc'

  have h_ls_mem_inorder : ∀ (T : _root_.BinaryTree ℕ) (u : ℕ),
      u ∈ leftSpineBottomUpNat T → u ∈ inorderNat T := by
    intro T u hu
    rcases h_ls_aux T [] u hu with h | h
    · exact h
    · simp at h

  have h_primal_ls : ∀ t ≤ kops.length, ∀ (i u : ℕ),
      (leftSpineBottomUpNat (keyedState kops t))[i]? = some u →
      u ∈ leftSpineBottomUpNat (foldBST P (keyedState kops t)).1 := by
    intro t ht i u hget
    rw [hfold.fold_leftSpine t ht]
    exact List.mem_append_left _ (List.mem_of_getElem? hget)

  have h_jump_bounds : ∀ id (hid : id < (jumps kops).length),
      let e := (jumps kops)[id]
      e.step < kops.length ∧ e.j < e.m ∧
        e.s < e.x ∧ e.x < e.y ∧ e.y < e.z ∧ e.z < P := by
    intro id hid
    obtain ⟨_, hstep, _, hjm, hsx, hxy, hyz, hzP, _, _⟩ := hjump.jump_anatomies id hid
    exact ⟨hstep, hjm, hsx, hxy, hyz, hzP⟩

  have h_jump_popStep : ∀ id (hid : id < (jumps kops).length),
      popStep kops ((jumps kops)[id]).s = ((jumps kops)[id]).step := by
    intro id hid
    obtain ⟨_, hstep, hpop_opt, _, _, _, _, _, _, _⟩ := hjump.jump_anatomies id hid
    have hget : kops[((jumps kops)[id]).step] = .pop ((jumps kops)[id]).s := by
      rw [List.getElem?_eq_getElem hstep] at hpop_opt
      exact Option.some.inj hpop_opt
    have hsv := hkvalid.step_valid ((jumps kops)[id]).step hstep
    rw [hget] at hsv
    exact hsv.2.1

  have h_jump_ls : ∀ id (hid : id < (jumps kops).length),
      let e := (jumps kops)[id]
      e.x ∈ leftSpineBottomUpNat (foldBST P (keyedState kops e.step)).1 ∧
        e.y ∈ leftSpineBottomUpNat (foldBST P (keyedState kops e.step)).1 ∧
        e.z ∈ leftSpineBottomUpNat (foldBST P (keyedState kops e.step)).1 := by
    intro id hid
    obtain ⟨_, hstep, _, _, _, _, _, _, ⟨_, _, hx, hy, hz⟩, _⟩ := hjump.jump_anatomies id hid
    have hle : ((jumps kops)[id]).step ≤ kops.length := Nat.le_of_lt hstep
    exact ⟨h_primal_ls _ hle _ _ hx, h_primal_ls _ hle _ _ hy, h_primal_ls _ hle _ _ hz⟩

  have h_jump_succ : ∀ id (hid : id < (jumps kops).length),
      ((jumps kops)[id]).j + 1 < ((jumps kops)[id]).m →
      ∃ hid' : id + 1 < (jumps kops).length,
        let e := (jumps kops)[id]
        let e' := (jumps kops)[id + 1]
        e'.step = e.step ∧ e'.s = e.s ∧ e'.j = e.j + 1 ∧ e'.m = e.m ∧ e'.x = e.z := by
    intro id hid hjm
    obtain ⟨_, _, _, _, _, _, _, _, _, hsucc⟩ := hjump.jump_anatomies id hid
    exact hsucc hjm

  have h_adj_step : ∀ id1 (h2 : id1 + 1 < (jumps kops).length),
      ((jumps kops)[id1]).step = ((jumps kops)[id1 + 1]).step →
      ((jumps kops)[id1]).j + 1 < ((jumps kops)[id1]).m ∧
        ((jumps kops)[id1]).z = ((jumps kops)[id1 + 1]).x := by
    intro id1 h2 hst
    have h1 : id1 < (jumps kops).length := by omega
    have hord := hjump.jump_order id1 h1 (id1 + 1) h2 (by omega)
    have hj_lt : ((jumps kops)[id1]).j < ((jumps kops)[id1 + 1]).j := by
      rcases hord with hlt | ⟨_, hj⟩
      · omega
      · exact hj
    obtain ⟨_, _, _, _, _, _, _, _, ⟨hm1, _⟩, hsucc1⟩ := hjump.jump_anatomies id1 h1
    obtain ⟨_, _, _, hj2m2, _, _, _, _, ⟨hm2, _⟩, _⟩ := hjump.jump_anatomies (id1 + 1) h2
    have hm_eq : ((jumps kops)[id1]).m = ((jumps kops)[id1 + 1]).m := by
      rw [hm1, hm2, hst]
    have hjm1 : ((jumps kops)[id1]).j + 1 < ((jumps kops)[id1]).m := by omega
    obtain ⟨_, _, _, _, _, hx_eq⟩ := hsucc1 hjm1
    exact ⟨hjm1, hx_eq.symm⟩

  have h_same_step : ∀ id1 (hid1 : id1 < (jumps kops).length)
      id2 (hid2 : id2 < (jumps kops).length),
      id1 < id2 →
      ((jumps kops)[id1]).step = ((jumps kops)[id2]).step →
      ((jumps kops)[id1]).z ≤ ((jumps kops)[id2]).x := by
    have h_ind : ∀ id2 (hid2 : id2 < (jumps kops).length)
        id1 (hid1 : id1 < (jumps kops).length),
        id1 < id2 →
        ((jumps kops)[id1]).step = ((jumps kops)[id2]).step →
        ((jumps kops)[id1]).z ≤ ((jumps kops)[id2]).x := by
      intro id2
      induction id2 with
      | zero => intro _ _ _ hlt; omega
      | succ id2 ih =>
        intro hid2 id1 hid1 hlt hst
        by_cases heq : id1 = id2
        · subst heq
          have hadj := (h_adj_step id1 hid2 hst).2
          omega
        · have hlt' : id1 < id2 := by omega
          have hid2' : id2 < (jumps kops).length := by omega
          have hord1 := hjump.jump_order id1 hid1 id2 hid2' hlt'
          have hord2 := hjump.jump_order id2 hid2' (id2 + 1) hid2 (by omega)
          have hst1 : ((jumps kops)[id1]).step = ((jumps kops)[id2]).step := by
            rcases hord1 with h1 | ⟨h1, _⟩ <;> rcases hord2 with h2 | ⟨h2, _⟩ <;> omega
          have hst2 : ((jumps kops)[id2]).step = ((jumps kops)[id2 + 1]).step := by omega
          have hrec := ih hid2' id1 hid1 hlt' hst1
          have hadj := (h_adj_step id2 hid2 hst2).2
          have hb2 := h_jump_bounds id2 hid2'
          dsimp (config := { failIfUnchanged := false }) only at hb2
          omega
    intro id1 hid1 id2 hid2 hlt hst
    exact h_ind id2 hid2 id1 hid1 hlt hst

  have h_lock_contra : ∀ id1 (hid1 : id1 < (jumps kops).length)
      id2 (hid2 : id2 < (jumps kops).length),
      ((jumps kops)[id1]).step < ((jumps kops)[id2]).step →
      ((jumps kops)[id2]).s < ((jumps kops)[id1]).x →
      ∀ u ∈ leftSpineBottomUpNat (foldBST P (keyedState kops ((jumps kops)[id2]).step)).1,
        ((jumps kops)[id1]).x < u → u < ((jumps kops)[id1]).z → False := by
    intro id1 hid1 id2 hid2 hst_lt hs_lt u hu_ls hux huz
    have hb1 := h_jump_bounds id1 hid1
    dsimp (config := { failIfUnchanged := false }) only at hb1
    have hx1P : ((jumps kops)[id1]).x < P := by omega
    have hp2 := h_jump_popStep id2 hid2
    have hpmono := hkvalid.popStep_mono ((jumps kops)[id2]).s ((jumps kops)[id1]).x hs_lt hx1P
    exact ((hfold.spine_lock id1 hid1).2 ((jumps kops)[id2]).step (by omega) (by omega)).1
      u hu_ls ⟨hux, huz⟩

  have h_last_jump_contra : ∀ id1 (hid1 : id1 < (jumps kops).length)
      id2 (hid2 : id2 < (jumps kops).length),
      id1 < id2 →
      ((jumps kops)[id1]).s = ((jumps kops)[id2]).s →
      ¬(((jumps kops)[id1]).j + 1 < ((jumps kops)[id1]).m) → False := by
    intro id1 hid1 id2 hid2 hlt hs_eq hnot
    have hst1 := h_jump_popStep id1 hid1
    have hst2 := h_jump_popStep id2 hid2
    rw [hs_eq] at hst1
    have hst_eq : ((jumps kops)[id1]).step = ((jumps kops)[id2]).step := hst1.symm.trans hst2
    have hord := hjump.jump_order id1 hid1 id2 hid2 hlt
    have hj_lt : ((jumps kops)[id1]).j < ((jumps kops)[id2]).j := by
      rcases hord with h | ⟨_, hj⟩
      · omega
      · exact hj
    obtain ⟨_, _, _, _, _, _, _, _, ⟨hm1, _⟩, _⟩ := hjump.jump_anatomies id1 hid1
    obtain ⟨_, _, _, hj2m2, _, _, _, _, ⟨hm2, _⟩, _⟩ := hjump.jump_anatomies id2 hid2
    have hm_eq : ((jumps kops)[id1]).m = ((jumps kops)[id2]).m := by
      rw [hm1, hm2, hst_eq]
    omega

  have h_block_bounds_of : ∀ ℓ ≤ L, ∀ u < P,
      (blockOf S P ℓ u).1 ≤ u ∧ u < (blockOf S P ℓ u).2 ∧
        (blockOf S P ℓ u).2 ≤ P ∧ blockIdx S P ℓ u < (scaleBlocks S P ℓ).length := by
    intro ℓ hℓ u hu
    obtain ⟨hidx, hlo, hhi, hget⟩ := hpart.blocks_partition ℓ hℓ u hu
    have hmem : blockOf S P ℓ u ∈ scaleBlocks S P ℓ := List.mem_of_getElem? hget
    obtain ⟨_, hP_le, _, _⟩ := hpart.blocks_bounds ℓ hℓ (blockOf S P ℓ u) hmem
    exact ⟨hlo, hhi, hP_le, hidx⟩

  have h_block_disj : ∀ ℓ ≤ L, ∀ u v, u < v → v < P →
      blockIdx S P ℓ u ≠ blockIdx S P ℓ v →
      u < (blockOf S P ℓ v).1 ∧ (blockOf S P ℓ u).2 ≤ v := by
    intro ℓ hℓ u v huv hvP hne
    have huP : u < P := by omega
    obtain ⟨hlo_u, _, _, _⟩ := h_block_bounds_of ℓ hℓ u huP
    obtain ⟨_, hhi_v, _, _⟩ := h_block_bounds_of ℓ hℓ v hvP
    refine ⟨?_, ?_⟩
    · by_contra hcon
      have hv_u : (blockOf S P ℓ v).1 ≤ u ∧ u < (blockOf S P ℓ v).2 := ⟨by omega, by omega⟩
      exact hne ((hpart.blocks_eq_iff ℓ hℓ v hvP u huP).mpr hv_u).symm
    · by_contra hcon
      have hu_v : (blockOf S P ℓ u).1 ≤ v ∧ v < (blockOf S P ℓ u).2 := ⟨by omega, by omega⟩
      exact hne ((hpart.blocks_eq_iff ℓ hℓ u huP v hvP).mpr hu_v)

  have h_block_nest : ∀ m n, m ≤ n → n ≤ L → ∀ y < P,
      (blockOf S P m y).1 ≤ (blockOf S P n y).1 ∧
        (blockOf S P n y).2 ≤ (blockOf S P m y).2 := by
    intro m n hmn hnL y hy
    by_cases hmeq : m = n
    · subst hmeq; exact ⟨le_rfl, le_rfl⟩
    · have hm_lt : m < n := by omega
      have hmL : m ≤ L := by omega
      obtain ⟨hlo_m, hhi_m, _, _⟩ := h_block_bounds_of m hmL y hy
      obtain ⟨hlo_n, hhi_n, hP_n, _⟩ := h_block_bounds_of n hnL y hy
      refine ⟨?_, ?_⟩
      · by_contra hcon
        set v := (blockOf S P n y).1
        have hvP : v < P := by omega
        have hidx_n : blockIdx S P n y = blockIdx S P n v :=
          (hpart.blocks_eq_iff n hnL y hy v hvP).mpr ⟨le_rfl, by omega⟩
        have hsep_n : n < sepScale S P L y v :=
          (hpart.sep_gt_iff n hnL y hy v hvP).mpr hidx_n
        have hidx_m : blockIdx S P m y = blockIdx S P m v :=
          (hpart.sep_gt_iff m hmL y hy v hvP).mp (by omega)
        have hmem_m := (hpart.blocks_eq_iff m hmL y hy v hvP).mp hidx_m
        omega
      · by_contra hcon
        set w := (blockOf S P m y).2
        have hwP : w < P := by omega
        have hidx_n : blockIdx S P n y = blockIdx S P n w :=
          (hpart.blocks_eq_iff n hnL y hy w hwP).mpr ⟨by omega, by omega⟩
        have hsep_n : n < sepScale S P L y w :=
          (hpart.sep_gt_iff n hnL y hy w hwP).mpr hidx_n
        have hidx_m : blockIdx S P m y = blockIdx S P m w :=
          (hpart.sep_gt_iff m hmL y hy w hwP).mp (by omega)
        have hmem_m := (hpart.blocks_eq_iff m hmL y hy w hwP).mp hidx_m
        omega

  have h_anc_eq_of : ∀ m n, m ≤ n → n ≤ L → ∀ u < P, ∀ v < P,
      blockIdx S P n u = blockIdx S P n v →
      blockIdx S P m u = blockIdx S P m v ∧ blockOf S P m u = blockOf S P m v := by
    intro m n hmn hnL u hu v hv hidx_n
    have hsep : n < sepScale S P L u v := (hpart.sep_gt_iff n hnL u hu v hv).mpr hidx_n
    have hmL : m ≤ L := by omega
    have hidx_m : blockIdx S P m u = blockIdx S P m v :=
      (hpart.sep_gt_iff m hmL u hu v hv).mp (by omega)
    exact ⟨hidx_m, by simp only [blockOf, hidx_m]⟩

  have h_card_inj : ∀ {β : Type} (A : Finset ℕ) (B : Finset β) (f : ℕ → β),
      (∀ a ∈ A, f a ∈ B) →
      (∀ a ∈ A, ∀ b ∈ A, a < b → f a = f b → False) →
      A.card ≤ B.card := by
    intro β A B f hmap hlt_ne
    refine Finset.card_le_card_of_injOn f (fun a ha => hmap a (Finset.mem_coe.mp ha)) ?_
    intro a ha b hb heq
    have ha' := Finset.mem_coe.mp ha
    have hb' := Finset.mem_coe.mp hb
    rcases lt_trichotomy a b with hlt | rfl | hgt
    · exact False.elim (hlt_ne a ha' b hb' hlt heq)
    · rfl
    · exact False.elim (hlt_ne b hb' a ha' hgt heq.symm)

  -- =========================================================================
  -- Conjunct 1: `(B_fin_pre S P L kops).card ≤ P`
  -- =========================================================================
  have h_conj1 : (B_fin_pre S P L kops).card ≤ P := by
    have hle := h_card_inj (B_fin_pre S P L kops) (Finset.range P)
      (fun id => ((jumps kops).getD id default).y)
      (fun id hid => by
        simp only [B_fin_pre, Finset.mem_filter, Finset.mem_range] at hid
        obtain ⟨hid_lt, _⟩ := hid
        dsimp (config := { failIfUnchanged := false }) only
        rw [List.getD_eq_getElem _ _ hid_lt, Finset.mem_range]
        have hb := h_jump_bounds id hid_lt
        dsimp (config := { failIfUnchanged := false }) only at hb
        omega)
      (fun id1 hid1 id2 hid2 hlt heq => by
        simp only [B_fin_pre, Finset.mem_filter, Finset.mem_range] at hid1 hid2
        obtain ⟨h1_lt, his1⟩ := hid1
        obtain ⟨h2_lt, his2⟩ := hid2
        dsimp (config := { failIfUnchanged := false }) only at heq
        rw [List.getD_eq_getElem _ _ h1_lt, List.getD_eq_getElem _ _ h2_lt] at heq
        simp only [isBFinPre, List.getElem?_eq_getElem h1_lt,
          List.getElem?_eq_getElem h2_lt, decide_eq_true_eq] at his1 his2
        have hb1 := h_jump_bounds id1 h1_lt
        have hb2 := h_jump_bounds id2 h2_lt
        dsimp (config := { failIfUnchanged := false }) only at hb1 hb2
        rcases hjump.jump_order id1 h1_lt id2 h2_lt hlt with hst_lt | ⟨hst_eq, _⟩
        · have hx1P : ((jumps kops)[id1]).x < P := by omega
          have hy1P : ((jumps kops)[id1]).y < P := by omega
          have hx2P : ((jumps kops)[id2]).x < P := by omega
          have hy2P : ((jumps kops)[id2]).y < P := by omega
          have hidx1 : blockIdx S P L ((jumps kops)[id1]).x =
              blockIdx S P L ((jumps kops)[id1]).y :=
            (hpart.sep_gt_iff L le_rfl _ hx1P _ hy1P).mp (by omega)
          have hidx2 : blockIdx S P L ((jumps kops)[id2]).x =
              blockIdx S P L ((jumps kops)[id2]).y :=
            (hpart.sep_gt_iff L le_rfl _ hx2P _ hy2P).mp (by omega)
          have hbo_eq : blockOf S P L ((jumps kops)[id2]).x =
              blockOf S P L ((jumps kops)[id1]).x := by
            simp only [blockOf, hidx1, hidx2, heq]
          have hlo1 := (h_block_bounds_of L le_rfl _ hx1P).1
          have hs2x1 : ((jumps kops)[id2]).s < ((jumps kops)[id1]).x := by
            rw [hbo_eq] at his2
            omega
          have hy2_ls := (h_jump_ls id2 h2_lt).2.1
          exact h_lock_contra id1 h1_lt id2 h2_lt hst_lt hs2x1
            ((jumps kops)[id2]).y hy2_ls (by omega) (by omega)
        · have hchain := h_same_step id1 h1_lt id2 h2_lt hlt hst_eq
          omega)
    simpa only [Finset.card_range] using hle

  -- =========================================================================
  -- Epoch Grouping Tree Prefix Weights, Conjuncts 2 & 3, and Node Capacity
  -- =========================================================================
  let addrAt (ℓ i : ℕ) : ℕ := if h : i < r then addr ℓ ⟨i, h⟩ else 0
  let addrPref (k ℓ : ℕ) : List ℕ := (List.range k).map (addrAt ℓ)

  have h_addrPref_eq_iff : ∀ k ≤ r, ∀ ℓ1 ℓ2 : ℕ,
      addrPref k ℓ1 = addrPref k ℓ2 ↔
        ∀ q : Fin r, q.val < k → addr ℓ1 q = addr ℓ2 q := by
    intro k hk ℓ1 ℓ2
    simp only [addrPref, List.map_eq_map_iff, List.mem_range]
    constructor
    · intro hall q hqk
      have hi := hall q.val hqk
      simp only [addrAt, q.isLt, ↓reduceDIte] at hi
      exact hi
    · intro hall i hik
      have hir : i < r := Nat.lt_of_lt_of_le hik hk
      simp only [addrAt, hir, ↓reduceDIte]
      exact hall ⟨i, hir⟩ hik

  have h_listWeight_full : ∀ ℓ : ℕ, listWeight (addrPref r ℓ) = epochLeafWeight r addr ℓ := by
    intro ℓ
    have h_range_prod : ∀ (n : ℕ) (g : ℕ → ℕ),
        ((List.range n).map g).prod = (Finset.range n).prod g := by
      intro n g
      induction n with
      | zero => simp
      | succ n ih =>
        rw [List.range_succ, List.map_append, List.prod_append, List.map_singleton,
          List.prod_singleton, Finset.prod_range_succ, ih]
    dsimp (config := { failIfUnchanged := false }) only [listWeight, addrPref, epochLeafWeight]
    rw [List.map_map, h_range_prod]
    symm
    refine Finset.prod_bij (fun (d : Fin r) _ => d.val) ?_ ?_ ?_ ?_
    · intro d _; exact Finset.mem_range.mpr d.isLt
    · intro d1 _ d2 _ h; exact Fin.ext h
    · intro j hj; exact ⟨⟨j, Finset.mem_range.mp hj⟩, Finset.mem_univ _, rfl⟩
    · intro d _
      simp only [Function.comp_apply, addrAt, d.isLt, ↓reduceDIte]

  have h_pref_le_full : ∀ ℓ, 1 ≤ ℓ → ℓ ≤ L → ∀ d : Fin r,
      listWeight (addrPref d.val ℓ) * (4 * (addr ℓ d) ^ 2) ≤ epochLeafWeight r addr ℓ := by
    intro ℓ hℓ1 hℓL d
    rw [← h_listWeight_full ℓ]
    have h_step_w : ∀ k, k < r →
        listWeight (addrPref (k + 1) ℓ) =
          listWeight (addrPref k ℓ) * (4 * (addrAt ℓ k) ^ 2) := by
      intro k _
      dsimp (config := { failIfUnchanged := false }) only [listWeight, addrPref]
      rw [List.range_succ, List.map_append, List.map_append, List.prod_append]
      simp
    have h_mono_w : ∀ m k, k + m ≤ r →
        listWeight (addrPref k ℓ) ≤ listWeight (addrPref (k + m) ℓ) := by
      intro m
      induction m with
      | zero => intro k _; simp
      | succ m ih =>
        intro k hkm
        have h1 := ih k (by omega)
        have h2 := h_step_w (k + m) (by omega)
        have hpos_c : 1 ≤ addr ℓ ⟨k + m, by omega⟩ := haddr.pos ℓ hℓ1 hℓL ⟨k + m, by omega⟩
        have h4 : 1 ≤ 4 * (addrAt ℓ (k + m)) ^ 2 := by
          have hlt_r : k + m < r := by omega
          simp only [addrAt, hlt_r, ↓reduceDIte]
          nlinarith
        rw [show k + (m + 1) = (k + m) + 1 by omega, h2]
        exact le_trans h1 (Nat.le_mul_of_pos_right _ (by omega))
    have hd1 := h_step_w d.val d.isLt
    simp only [addrAt, d.isLt, ↓reduceDIte] at hd1
    rw [← hd1]
    have hm := h_mono_w (r - (d.val + 1)) (d.val + 1) (by omega)
    simpa [show (d.val + 1) + (r - (d.val + 1)) = r by omega] using hm

  let M_coord : ℕ :=
    (Finset.Icc 1 L).sup (fun ℓ => (Finset.univ : Finset (Fin r)).sup (addr ℓ))

  have h_coord_bounds : ∀ ℓ, 1 ≤ ℓ → ℓ ≤ L → ∀ k ≤ r,
      (addrPref k ℓ).length = k ∧ ∀ c ∈ addrPref k ℓ, 1 ≤ c ∧ c ≤ M_coord := by
    intro ℓ hℓ1 hℓL k hk
    refine ⟨by simp [addrPref], ?_⟩
    intro c hc
    simp only [addrPref, List.mem_map, List.mem_range] at hc
    obtain ⟨i, hik, rfl⟩ := hc
    have hir : i < r := Nat.lt_of_lt_of_le hik hk
    simp only [addrAt, hir, ↓reduceDIte]
    refine ⟨haddr.pos ℓ hℓ1 hℓL ⟨i, hir⟩, ?_⟩
    have h1 : addr ℓ ⟨i, hir⟩ ≤ (Finset.univ : Finset (Fin r)).sup (addr ℓ) :=
      Finset.le_sup (f := addr ℓ) (Finset.mem_univ (⟨i, hir⟩ : Fin r))
    have h2 : (Finset.univ : Finset (Fin r)).sup (addr ℓ) ≤ M_coord :=
      Finset.le_sup (f := fun m => (Finset.univ : Finset (Fin r)).sup (addr m))
        (Finset.mem_Icc.mpr ⟨hℓ1, hℓL⟩)
    exact le_trans h1 h2

  have h_conj2 :
      (Finset.Icc 1 L).sum (fun ℓ => (1 : ℚ) / (epochLeafWeight r addr ℓ : ℚ)) ≤ 1 / 2 := by
    have h_inj_full : Set.InjOn (addrPref r) ↑(Finset.Icc 1 L) := by
      intro ℓ1 h1 ℓ2 h2 heq
      obtain ⟨h1_lo, h1_hi⟩ := Finset.mem_Icc.mp (Finset.mem_coe.mp h1)
      obtain ⟨h2_lo, h2_hi⟩ := Finset.mem_Icc.mp (Finset.mem_coe.mp h2)
      have hall := (h_addrPref_eq_iff r le_rfl ℓ1 ℓ2).mp heq
      rcases lt_trichotomy ℓ1 ℓ2 with hlt | rfl | hgt
      · obtain ⟨d, _, hd_lt⟩ := haddr.lex_strictMono ℓ1 ℓ2 h1_lo hlt h2_hi
        have := hall d d.isLt
        omega
      · rfl
      · obtain ⟨d, _, hd_lt⟩ := haddr.lex_strictMono ℓ2 ℓ1 h2_lo hgt h1_hi
        have := hall d d.isLt
        omega
    have h_eq :
        (Finset.Icc 1 L).sum (fun ℓ => (1 : ℚ) / (epochLeafWeight r addr ℓ : ℚ)) =
          ((Finset.Icc 1 L).image (addrPref r)).sum
            (fun p => (1 : ℚ) / (listWeight p : ℚ)) := by
      rw [Finset.sum_image h_inj_full]
      refine Finset.sum_congr rfl ?_
      intro ℓ _
      rw [h_listWeight_full ℓ]
    rw [h_eq]
    have h_pow_r :
        ((Finset.Icc 1 L).image (addrPref r)).sum (fun p => (1 : ℚ) / (listWeight p : ℚ)) ≤
          (1 / 2 : ℚ) ^ r := by
      refine sum_inv_listWeight_le r M_coord _ ?_
      intro p hp
      obtain ⟨ℓ, hℓ, rfl⟩ := Finset.mem_image.mp hp
      obtain ⟨hℓ1, hℓL⟩ := Finset.mem_Icc.mp hℓ
      exact h_coord_bounds ℓ hℓ1 hℓL r le_rfl
    have h_r_le : (1 / 2 : ℚ) ^ r ≤ 1 / 2 := by
      obtain ⟨k, rfl⟩ : ∃ k, r = k + 1 := ⟨r - 1, by omega⟩
      rw [pow_succ]
      have hk1 : (1 / 2 : ℚ) ^ k ≤ 1 := pow_le_one₀ (by norm_num) (by norm_num)
      linarith
    exact le_trans h_pow_r h_r_le

  have h_len_mul_S : ∀ ℓ, 1 ≤ ℓ → ℓ ≤ L →
      13000 * epochLeafWeight r addr ℓ * (scaleBlocks S P ℓ).length ≤ P ∧
        1 ≤ epochLeafWeight r addr ℓ := by
    intro ℓ hℓ1 hℓL
    have h_list_lb : ∀ (B : ℕ) (xs : List ℕ), (∀ x ∈ xs, B ≤ x) → xs.length * B ≤ xs.sum := by
      intro B xs
      induction xs with
      | nil => intro _; simp
      | cons x rest ih =>
        intro hall
        have hx := hall x (by simp)
        have hr_sum := ih (fun y hy => hall y (List.mem_cons_of_mem x hy))
        simp only [List.length_cons, List.sum_cons]
        nlinarith
    have h_sum_P := hpart.blocks_sum ℓ hℓL
    have h_lb : (scaleBlocks S P ℓ).length * S ℓ ≤ P := by
      have h1 := h_list_lb (S ℓ) ((scaleBlocks S P ℓ).map (fun b => b.2 - b.1)) (by
        intro x hx
        obtain ⟨b, hb, rfl⟩ := List.mem_map.mp hx
        exact (hpart.blocks_bounds ℓ hℓL b hb).2.2.1)
      simpa only [List.length_map, h_sum_P] using h1
    have hS_eq := hS_def ℓ hℓ1 hℓL
    have h_ack_ge : 1 ≤ (SplayTree.invAckermann (2 * S (ℓ - 1)) + 1) ^ 2 :=
      Nat.one_le_pow 2 _ (by omega)
    have h_S_ge : 13000 * epochLeafWeight r addr ℓ ≤ S ℓ := by
      rw [hS_eq]
      exact Nat.le_mul_of_pos_right _ (by omega)
    have hw_pos : 1 ≤ epochLeafWeight r addr ℓ := by
      dsimp (config := { failIfUnchanged := false }) only [epochLeafWeight]
      refine Finset.one_le_prod' ?_
      intro d _
      have hd := haddr.pos ℓ hℓ1 hℓL d
      nlinarith
    exact ⟨by nlinarith, hw_pos⟩

  have h_conj3 : (Finset.Icc 1 L).sum (fun ℓ => (scaleBlocks S P ℓ).length) ≤ P := by
    have h_q :
        (((Finset.Icc 1 L).sum (fun ℓ => (scaleBlocks S P ℓ).length) : ℕ) : ℚ) ≤ (P : ℚ) := by
      rw [Nat.cast_sum]
      have h_term : ∀ ℓ ∈ Finset.Icc 1 L,
          ((scaleBlocks S P ℓ).length : ℚ) ≤
            (P : ℚ) * ((1 : ℚ) / (epochLeafWeight r addr ℓ : ℚ)) := by
        intro ℓ hℓ
        obtain ⟨hℓ1, hℓL⟩ := Finset.mem_Icc.mp hℓ
        obtain ⟨hprod_le, hw1⟩ := h_len_mul_S ℓ hℓ1 hℓL
        have hw_le : epochLeafWeight r addr ℓ * (scaleBlocks S P ℓ).length ≤ P := by nlinarith
        have hw_q :
            (epochLeafWeight r addr ℓ : ℚ) * ((scaleBlocks S P ℓ).length : ℚ) ≤ (P : ℚ) := by
          exact_mod_cast hw_le
        have hw_pos : (0 : ℚ) < (epochLeafWeight r addr ℓ : ℚ) := by
          have : (1 : ℚ) ≤ (epochLeafWeight r addr ℓ : ℚ) := by exact_mod_cast hw1
          linarith
        have hdiv :
            ((scaleBlocks S P ℓ).length : ℚ) ≤ (P : ℚ) / (epochLeafWeight r addr ℓ : ℚ) :=
          (le_div_iff₀' hw_pos).mpr hw_q
        have h_eq_rhs :
            (P : ℚ) / (epochLeafWeight r addr ℓ : ℚ) =
              (P : ℚ) * ((1 : ℚ) / (epochLeafWeight r addr ℓ : ℚ)) := by
          ring
        linarith
      have h_sum_le := Finset.sum_le_sum h_term
      rw [← Finset.mul_sum] at h_sum_le
      have hP_nn : (0 : ℚ) ≤ (P : ℚ) := by positivity
      have h_mul := mul_le_mul_of_nonneg_left h_conj2 hP_nn
      linarith
    exact_mod_cast h_q

  -- =========================================================================
  -- Epoch Tree LCA, Prefix Convexity, and Active Node Capacity `CapSet`
  -- =========================================================================
  let lcaDepth (ℓ1 ℓ2 : ℕ) : Fin r :=
    if h : 1 ≤ ℓ1 ∧ ℓ1 < ℓ2 ∧ ℓ2 ≤ L then
      Classical.choose (haddr.lex_strictMono ℓ1 ℓ2 h.1 h.2.1 h.2.2)
    else
      ⟨0, hr⟩

  have h_lca_spec : ∀ ℓ1 ℓ2, 1 ≤ ℓ1 → ℓ1 < ℓ2 → ℓ2 ≤ L →
      let d := lcaDepth ℓ1 ℓ2
      addrPref d.val ℓ1 = addrPref d.val ℓ2 ∧
        (∀ q : Fin r, q < d → addr ℓ1 q = addr ℓ2 q) ∧
        addr ℓ1 d < addr ℓ2 d := by
    intro ℓ1 ℓ2 h1 hlt h2
    have hc : 1 ≤ ℓ1 ∧ ℓ1 < ℓ2 ∧ ℓ2 ≤ L := ⟨h1, hlt, h2⟩
    have hspec := Classical.choose_spec (haddr.lex_strictMono ℓ1 ℓ2 h1 hlt h2)
    have hd_eq : lcaDepth ℓ1 ℓ2 = Classical.choose (haddr.lex_strictMono ℓ1 ℓ2 h1 hlt h2) :=
      dif_pos hc
    dsimp (config := { failIfUnchanged := false }) only
    rw [hd_eq]
    refine ⟨?_, hspec.1, hspec.2⟩
    exact (h_addrPref_eq_iff _
      (Nat.le_of_lt (Classical.choose (haddr.lex_strictMono ℓ1 ℓ2 h1 hlt h2)).isLt) ℓ1 ℓ2).mpr
      (fun q hq => hspec.1 q hq)

  have h_lca_lt_of_ne : ∀ ℓ1 ℓ2 (d : Fin r),
      1 ≤ ℓ1 → ℓ1 < ℓ2 → ℓ2 ≤ L →
      addrPref d.val ℓ1 ≠ addrPref d.val ℓ2 →
      lcaDepth ℓ1 ℓ2 < d := by
    intro ℓ1 ℓ2 d h1 hlt h2 hne
    obtain ⟨_, heq_lt, _⟩ := h_lca_spec ℓ1 ℓ2 h1 hlt h2
    by_contra hcon
    have hd_le : d ≤ lcaDepth ℓ1 ℓ2 := Fin.not_lt.mp hcon
    apply hne
    refine (h_addrPref_eq_iff d.val (Nat.le_of_lt d.isLt) ℓ1 ℓ2).mpr ?_
    intro q hqd
    exact heq_lt q (Nat.lt_of_lt_of_le hqd hd_le)

  have h_gt_lca_of_eq : ∀ ℓ1 ℓ2 (d : Fin r),
      1 ≤ ℓ1 → ℓ1 < ℓ2 → ℓ2 ≤ L →
      addrPref d.val ℓ1 = addrPref d.val ℓ2 →
      addr ℓ1 d = addr ℓ2 d →
      d < lcaDepth ℓ1 ℓ2 := by
    intro ℓ1 ℓ2 d h1 hlt h2 hpref hc_eq
    obtain ⟨_, _, hlt_lca⟩ := h_lca_spec ℓ1 ℓ2 h1 hlt h2
    have hall := (h_addrPref_eq_iff d.val (Nat.le_of_lt d.isLt) ℓ1 ℓ2).mp hpref
    by_contra hcon
    have hlca_le : lcaDepth ℓ1 ℓ2 ≤ d := Fin.not_lt.mp hcon
    rcases lt_or_eq_of_le hlca_le with h_lt | h_eq
    · have := hall (lcaDepth ℓ1 ℓ2) h_lt
      omega
    · rw [h_eq] at hlt_lca
      omega

  have h_pref_mono : ∀ a b (d : Fin r),
      1 ≤ a → a ≤ b → b ≤ L →
      addrPref d.val a = addrPref d.val b →
      addr a d ≤ addr b d := by
    intro a b d ha hab hb hpref
    rcases eq_or_lt_of_le hab with rfl | hlt
    · exact le_rfl
    · obtain ⟨_, heq_lt, hlt_lca⟩ := h_lca_spec a b ha hlt hb
      have hall := (h_addrPref_eq_iff d.val (Nat.le_of_lt d.isLt) a b).mp hpref
      rcases lt_trichotomy d (lcaDepth a b) with hd_lt | hd_eq | hd_gt
      · exact le_of_eq (heq_lt d hd_lt)
      · rw [hd_eq]; exact le_of_lt hlt_lca
      · exfalso
        have := hall (lcaDepth a b) hd_gt
        omega

  have h_pref_convex : ∀ a b c (d : Fin r),
      1 ≤ a → a ≤ b → b ≤ c → c ≤ L →
      addrPref d.val a = addrPref d.val c →
      addrPref d.val b = addrPref d.val a ∧ addr a d ≤ addr b d ∧ addr b d ≤ addr c d := by
    intro a b c d ha hab hbc hc hpref_ac
    have hall_ac := (h_addrPref_eq_iff d.val (Nat.le_of_lt d.isLt) a c).mp hpref_ac
    have h_ind : ∀ k : ℕ, k ≤ d.val → addrPref k b = addrPref k a := by
      intro k
      induction k with
      | zero => intro _; simp [addrPref]
      | succ k ih =>
        intro hk
        have hprev := ih (by omega)
        have hprev_ab : addrPref k a = addrPref k b := hprev.symm
        have hprev_bc : addrPref k b = addrPref k c := by
          rw [hprev]
          exact (h_addrPref_eq_iff k (by omega) a c).mpr (fun q hq => hall_ac q (by omega))
        let qk : Fin r := ⟨k, by omega⟩
        have hle1 := h_pref_mono a b qk ha hab (by omega) hprev_ab
        have hle2 := h_pref_mono b c qk (by omega) hbc hc hprev_bc
        have heq_ac : addr a qk = addr c qk := hall_ac qk hk
        have heq_ba : addr b qk = addr a qk := by omega
        refine (h_addrPref_eq_iff (k + 1) (by omega) b a).mpr ?_
        intro q hq
        rcases eq_or_lt_of_le (Nat.le_of_lt_succ hq) with hq_eq | hq_lt
        · have hq_qk : q = qk := Fin.ext hq_eq
          rw [hq_qk]
          exact heq_ba
        · exact (h_addrPref_eq_iff k (by omega) b a).mp hprev q hq_lt
    have hpref_ba := h_ind d.val le_rfl
    refine ⟨hpref_ba, ?_, ?_⟩
    · exact h_pref_mono a b d ha hab (by omega) hpref_ba.symm
    · exact h_pref_mono b c d (by omega) hbc hc (hpref_ba.trans hpref_ac)

  let leafSet (d : Fin r) (p : List ℕ) : Finset ℕ :=
    (Finset.Icc 1 L).filter (fun ℓ => addrPref d.val ℓ = p)
  let mStar (d : Fin r) (p : List ℕ) : ℕ :=
    if h : (leafSet d p).Nonempty then (leafSet d p).max' h else 0
  let kNode (d : Fin r) (p : List ℕ) : ℕ :=
    addr (mStar d p) d

  let ActiveNodes : Finset (Fin r × List ℕ) :=
    (Finset.univ : Finset (Fin r)).biUnion (fun d =>
      (Finset.Icc 1 L).image (fun ℓ => (d, addrPref d.val ℓ)))

  let CapSet : Finset (Fin r × List ℕ × ℕ × ℕ) :=
    ActiveNodes.biUnion (fun ν =>
      ((Finset.Icc 1 (kNode ν.1 ν.2)) ×ˢ
        (Finset.range (scaleBlocks S P (mStar ν.1 ν.2)).length)).image
        (fun cq => (ν.1, ν.2, cq.1, cq.2)))

  have h_mStar_props : ∀ (d : Fin r) (p : List ℕ) (ℓ : ℕ),
      1 ≤ ℓ → ℓ ≤ L → addrPref d.val ℓ = p →
      (d, p) ∈ ActiveNodes ∧
        1 ≤ mStar d p ∧ mStar d p ≤ L ∧ addrPref d.val (mStar d p) = p ∧
        ℓ ≤ mStar d p ∧ 1 ≤ addr ℓ d ∧ addr ℓ d ≤ kNode d p := by
    intro d p ℓ hℓ1 hℓL hp
    have hmem_leaf : ℓ ∈ leafSet d p :=
      Finset.mem_filter.mpr ⟨Finset.mem_Icc.mpr ⟨hℓ1, hℓL⟩, hp⟩
    have hne : (leafSet d p).Nonempty := ⟨ℓ, hmem_leaf⟩
    have hm_eq : mStar d p = (leafSet d p).max' hne := dif_pos hne
    have hm_mem : mStar d p ∈ leafSet d p := by
      rw [hm_eq]
      exact Finset.max'_mem _ hne
    obtain ⟨hm_icc, hm_pref⟩ := Finset.mem_filter.mp hm_mem
    obtain ⟨hm1, hmL⟩ := Finset.mem_Icc.mp hm_icc
    have hℓ_le_m : ℓ ≤ mStar d p := by
      rw [hm_eq]
      exact Finset.le_max' _ ℓ hmem_leaf
    have hc_le : addr ℓ d ≤ kNode d p :=
      h_pref_mono ℓ (mStar d p) d hℓ1 hℓ_le_m hmL (hp.trans hm_pref.symm)
    have hact : (d, p) ∈ ActiveNodes := by
      refine Finset.mem_biUnion.mpr ⟨d, Finset.mem_univ d, ?_⟩
      exact Finset.mem_image.mpr ⟨ℓ, Finset.mem_Icc.mpr ⟨hℓ1, hℓL⟩, by rw [hp]⟩
    exact ⟨hact, hm1, hmL, hm_pref, hℓ_le_m, haddr.pos ℓ hℓ1 hℓL d, hc_le⟩

  have h_CapSet_twice_le_P : 2 * CapSet.card ≤ P := by
    have h_cap_card :
        CapSet.card = ActiveNodes.sum (fun ν =>
          kNode ν.1 ν.2 * (scaleBlocks S P (mStar ν.1 ν.2)).length) := by
      dsimp (config := { failIfUnchanged := false }) only [CapSet]
      rw [Finset.card_biUnion]
      · refine Finset.sum_congr rfl ?_
        intro ν _
        rw [Finset.card_image_of_injective _ (fun a b h =>
          Prod.ext (Prod.mk.inj (Prod.mk.inj (Prod.mk.inj h).2).2).1
            (Prod.mk.inj (Prod.mk.inj (Prod.mk.inj h).2).2).2)]
        rw [Finset.card_product, Nat.card_Icc, Finset.card_range]
        have : kNode ν.1 ν.2 + 1 - 1 = kNode ν.1 ν.2 := by omega
        rw [this]
      · intro ν1 _ ν2 _ hne
        dsimp (config := { failIfUnchanged := false }) only [Function.onFun]
        rw [Finset.disjoint_left]
        intro x hx1 hx2
        obtain ⟨_, _, hx1_eq⟩ := Finset.mem_image.mp hx1
        obtain ⟨_, _, hx2_eq⟩ := Finset.mem_image.mp hx2
        rw [← hx1_eq] at hx2_eq
        have h1 : ν1.1 = ν2.1 := (Prod.mk.inj hx2_eq).1.symm
        have h2 : ν1.2 = ν2.2 := (Prod.mk.inj (Prod.mk.inj hx2_eq).2).1.symm
        exact hne (Prod.ext h1 h2)

    have h_act_sum :
        ActiveNodes.sum (fun ν =>
          kNode ν.1 ν.2 * (scaleBlocks S P (mStar ν.1 ν.2)).length) =
        (Finset.univ : Finset (Fin r)).sum (fun d =>
          ((Finset.Icc 1 L).image (addrPref d.val)).sum (fun p =>
            kNode d p * (scaleBlocks S P (mStar d p)).length)) := by
      dsimp (config := { failIfUnchanged := false }) only [ActiveNodes]
      rw [Finset.sum_biUnion]
      · refine Finset.sum_congr rfl ?_
        intro d _
        have h_img_eq :
            (Finset.Icc 1 L).image (fun ℓ => (d, addrPref d.val ℓ)) =
              ((Finset.Icc 1 L).image (addrPref d.val)).image (fun p => (d, p)) := by
          ext x
          simp only [Finset.mem_image]
          constructor
          · rintro ⟨ℓ, hℓ, rfl⟩; exact ⟨addrPref d.val ℓ, ⟨ℓ, hℓ, rfl⟩, rfl⟩
          · rintro ⟨p, ⟨ℓ, hℓ, rfl⟩, rfl⟩; exact ⟨ℓ, hℓ, rfl⟩
        rw [h_img_eq, Finset.sum_image (fun p1 _ p2 _ h => (Prod.mk.inj h).2)]
      · intro d1 _ d2 _ hne
        dsimp (config := { failIfUnchanged := false }) only [Function.onFun]
        rw [Finset.disjoint_left]
        intro x hx1 hx2
        obtain ⟨_, _, hx1_eq⟩ := Finset.mem_image.mp hx1
        obtain ⟨_, _, hx2_eq⟩ := Finset.mem_image.mp hx2
        rw [← hx1_eq] at hx2_eq
        exact hne (Prod.mk.inj hx2_eq).1.symm

    have h_geom : ∀ n : ℕ,
        (Finset.range n).sum (fun i => (1 / 2 : ℚ) ^ i) = 2 - 2 * (1 / 2 : ℚ) ^ n := by
      intro n
      induction n with
      | zero => norm_num
      | succ n ih =>
        rw [Finset.sum_range_succ, ih, pow_succ]
        ring

    have h_q_bound : ((CapSet.card : ℕ) : ℚ) ≤ (P : ℚ) / 26000 := by
      rw [h_cap_card, h_act_sum, Nat.cast_sum]
      have h_d_bound : ∀ d ∈ (Finset.univ : Finset (Fin r)),
          ((((Finset.Icc 1 L).image (addrPref d.val)).sum (fun p =>
            kNode d p * (scaleBlocks S P (mStar d p)).length) : ℕ) : ℚ) ≤
            ((P : ℚ) / 52000) * (1 / 2 : ℚ) ^ d.val := by
        intro d _
        rw [Nat.cast_sum]
        have h_p_bound : ∀ p ∈ (Finset.Icc 1 L).image (addrPref d.val),
            ((kNode d p * (scaleBlocks S P (mStar d p)).length : ℕ) : ℚ) ≤
              ((P : ℚ) / 52000) * ((1 : ℚ) / (listWeight p : ℚ)) := by
          intro p hp
          obtain ⟨ℓ0, hℓ0, hp_eq⟩ := Finset.mem_image.mp hp
          obtain ⟨hℓ0_1, hℓ0_L⟩ := Finset.mem_Icc.mp hℓ0
          obtain ⟨_, hm1, hmL, hm_pref, _, _, _⟩ := h_mStar_props d p ℓ0 hℓ0_1 hℓ0_L hp_eq
          obtain ⟨hS_prod, _⟩ := h_len_mul_S (mStar d p) hm1 hmL
          have hw_pref := h_pref_le_full (mStar d p) hm1 hmL d
          rw [hm_pref] at hw_pref
          have hk_pos : 1 ≤ kNode d p := haddr.pos (mStar d p) hm1 hmL d
          have hk_sq : kNode d p ≤ (kNode d p) ^ 2 := by nlinarith
          have h_nat :
              52000 * listWeight p * (kNode d p * (scaleBlocks S P (mStar d p)).length) ≤ P := by
            dsimp (config := { failIfUnchanged := false }) only [kNode] at hk_sq ⊢
            nlinarith
          have h_rat :
              (52000 : ℚ) * (listWeight p : ℚ) *
                ((kNode d p * (scaleBlocks S P (mStar d p)).length : ℕ) : ℚ) ≤ (P : ℚ) := by
            exact_mod_cast h_nat
          have hlw_pos : 1 ≤ listWeight p := by
            dsimp (config := { failIfUnchanged := false }) only [listWeight]
            have h_prod_ge_one : ∀ xs : List ℕ, (∀ x ∈ xs, 1 ≤ x) → 1 ≤ xs.prod := by
              intro xs
              induction xs with
              | nil => intro _; simp
              | cons x tl ih =>
                intro hall
                simp only [List.prod_cons]
                have hx := hall x (by simp)
                have htl := ih (fun y hy => hall y (List.mem_cons_of_mem x hy))
                nlinarith
            refine h_prod_ge_one _ ?_
            intro x hx
            obtain ⟨c, hc_mem, rfl⟩ := List.mem_map.mp hx
            have hc1 := ((h_coord_bounds ℓ0 hℓ0_1 hℓ0_L d.val (Nat.le_of_lt d.isLt)).2 c
              (hp_eq ▸ hc_mem)).1
            nlinarith
          have hlw_q : (0 : ℚ) < (listWeight p : ℚ) := by
            have : (1 : ℚ) ≤ (listWeight p : ℚ) := by exact_mod_cast hlw_pos
            linarith
          have h_div := (le_div_iff₀' (show (0 : ℚ) < 52000 * (listWeight p : ℚ) by positivity)).mpr
            h_rat
          have h_eq_rhs :
              (P : ℚ) / (52000 * (listWeight p : ℚ)) =
                ((P : ℚ) / 52000) * ((1 : ℚ) / (listWeight p : ℚ)) := by
            ring
          linarith
        have h_sum_p := Finset.sum_le_sum h_p_bound
        rw [← Finset.mul_sum] at h_sum_p
        have h_inv_le :
            ((Finset.Icc 1 L).image (addrPref d.val)).sum (fun p => (1 : ℚ) / (listWeight p : ℚ)) ≤
              (1 / 2 : ℚ) ^ d.val := by
          refine sum_inv_listWeight_le d.val M_coord _ ?_
          intro p hp
          obtain ⟨ℓ, hℓ, rfl⟩ := Finset.mem_image.mp hp
          obtain ⟨hℓ1, hℓL⟩ := Finset.mem_Icc.mp hℓ
          exact h_coord_bounds ℓ hℓ1 hℓL d.val (Nat.le_of_lt d.isLt)
        exact le_trans h_sum_p (mul_le_mul_of_nonneg_left h_inv_le (by positivity))
      have h_sum_d := Finset.sum_le_sum h_d_bound
      rw [← Finset.mul_sum] at h_sum_d
      have h_univ_range :
          (Finset.univ : Finset (Fin r)).sum (fun d => (1 / 2 : ℚ) ^ d.val) =
            (Finset.range r).sum (fun i => (1 / 2 : ℚ) ^ i) := by
        refine Finset.sum_bij (fun (d : Fin r) _ => d.val) ?_ ?_ ?_ ?_
        · intro d _; exact Finset.mem_range.mpr d.isLt
        · intro d1 _ d2 _ h; exact Fin.ext h
        · intro j hj; exact ⟨⟨j, Finset.mem_range.mp hj⟩, Finset.mem_univ _, rfl⟩
        · intro _ _; rfl
      rw [h_univ_range, h_geom r] at h_sum_d
      have h_pow_nn : (0 : ℚ) ≤ (1 / 2 : ℚ) ^ r := by positivity
      have h_2 : 2 - 2 * (1 / 2 : ℚ) ^ r ≤ 2 := by linarith
      have h_mul2 := mul_le_mul_of_nonneg_left h_2 (show (0 : ℚ) ≤ (P : ℚ) / 52000 by positivity)
      linarith
    have h_26000 : (26000 : ℚ) * ((CapSet.card : ℕ) : ℚ) ≤ (P : ℚ) := by linarith
    have h_nat : 26000 * CapSet.card ≤ P := by exact_mod_cast h_26000
    omega

  -- =========================================================================
  -- Child Subtree Scale-Interval Helper (`geSet` / `leSet`)
  -- =========================================================================
  let geSet (d : Fin r) (p : List ℕ) (c : ℕ) : Finset ℕ :=
    (leafSet d p).filter (fun ℓ => c ≤ addr ℓ d)
  let leSet (d : Fin r) (p : List ℕ) (c : ℕ) : Finset ℕ :=
    (leafSet d p).filter (fun ℓ => addr ℓ d ≤ c)
  let mFirstChild (d : Fin r) (p : List ℕ) (c : ℕ) : ℕ :=
    if h : (geSet d p c).Nonempty then (geSet d p c).min' h else 0
  let mLoChild (d : Fin r) (p : List ℕ) (c : ℕ) : ℕ :=
    mFirstChild d p c - 1
  let mHiChild (d : Fin r) (p : List ℕ) (c : ℕ) : ℕ :=
    if h : (leSet d p c).Nonempty then (leSet d p c).max' h else 0

  have h_child_bounds : ∀ (d : Fin r) (p : List ℕ) (c ℓ : ℕ),
      1 ≤ ℓ → ℓ ≤ L → addrPref d.val ℓ = p → addr ℓ d = c →
      1 ≤ mFirstChild d p c ∧ mFirstChild d p c ≤ ℓ ∧
        mLoChild d p c ≤ ℓ - 1 ∧ ℓ ≤ mHiChild d p c ∧ mHiChild d p c ≤ mStar d p ∧
        (∀ ℓ0, 1 ≤ ℓ0 → ℓ0 ≤ L → addrPref d.val ℓ0 = p → addr ℓ0 d < c →
          ℓ0 ≤ mLoChild d p c) ∧
        (∀ ℓ2, 1 ≤ ℓ2 → ℓ2 ≤ L → addrPref d.val ℓ2 = p → c < addr ℓ2 d →
          mHiChild d p c < ℓ2) ∧
        (∀ a, mFirstChild d p c ≤ a → a ≤ mHiChild d p c →
          addrPref d.val a = p ∧ addr a d = c) := by
    intro d p c ℓ hℓ1 hℓL hp hc_eq
    have hmem_leaf : ℓ ∈ leafSet d p :=
      Finset.mem_filter.mpr ⟨Finset.mem_Icc.mpr ⟨hℓ1, hℓL⟩, hp⟩
    have hmem_ge : ℓ ∈ geSet d p c := Finset.mem_filter.mpr ⟨hmem_leaf, by omega⟩
    have hmem_le : ℓ ∈ leSet d p c := Finset.mem_filter.mpr ⟨hmem_leaf, by omega⟩
    have hne_ge : (geSet d p c).Nonempty := ⟨ℓ, hmem_ge⟩
    have hne_le : (leSet d p c).Nonempty := ⟨ℓ, hmem_le⟩
    have hfirst_eq : mFirstChild d p c = (geSet d p c).min' hne_ge := dif_pos hne_ge
    have hhi_eq : mHiChild d p c = (leSet d p c).max' hne_le := dif_pos hne_le
    have hfirst_mem : mFirstChild d p c ∈ geSet d p c := by
      rw [hfirst_eq]; exact Finset.min'_mem _ hne_ge
    have hhi_mem : mHiChild d p c ∈ leSet d p c := by
      rw [hhi_eq]; exact Finset.max'_mem _ hne_le
    obtain ⟨hf_leaf, hf_ge⟩ := Finset.mem_filter.mp hfirst_mem
    obtain ⟨hf_icc, hf_pref⟩ := Finset.mem_filter.mp hf_leaf
    obtain ⟨hf1, hfL⟩ := Finset.mem_Icc.mp hf_icc
    obtain ⟨hh_leaf, hh_le⟩ := Finset.mem_filter.mp hhi_mem
    obtain ⟨hh_icc, hh_pref⟩ := Finset.mem_filter.mp hh_leaf
    obtain ⟨hh1, hhL⟩ := Finset.mem_Icc.mp hh_icc
    have hf_le_ℓ : mFirstChild d p c ≤ ℓ := by
      rw [hfirst_eq]; exact Finset.min'_le _ ℓ hmem_ge
    have hℓ_le_hh : ℓ ≤ mHiChild d p c := by
      rw [hhi_eq]; exact Finset.le_max' _ ℓ hmem_le
    obtain ⟨_, _, _, _, hh_le_ms, _, _⟩ := h_mStar_props d p (mHiChild d p c) hh1 hhL hh_pref
    refine ⟨hf1, hf_le_ℓ, by dsimp (config := { failIfUnchanged := false }) [mLoChild]; omega, hℓ_le_hh, hh_le_ms, ?_, ?_, ?_⟩
    · intro ℓ0 hℓ0_1 hℓ0_L hp0 hc0_lt
      by_contra hcon
      have hf_le_0 : mFirstChild d p c ≤ ℓ0 := by dsimp (config := { failIfUnchanged := false }) [mLoChild] at hcon; omega
      have hmono := h_pref_mono (mFirstChild d p c) ℓ0 d hf1 hf_le_0 hℓ0_L
        (hf_pref.trans hp0.symm)
      omega
    · intro ℓ2 hℓ2_1 hℓ2_L hp2 hc2_gt
      by_contra hcon
      have h2_le_hh : ℓ2 ≤ mHiChild d p c := by omega
      have hmono := h_pref_mono ℓ2 (mHiChild d p c) d hℓ2_1 h2_le_hh hhL
        (hp2.trans hh_pref.symm)
      omega
    · intro a ha_lo ha_hi
      obtain ⟨ha_pref, ha_ge, ha_le⟩ := h_pref_convex (mFirstChild d p c) a (mHiChild d p c) d
        hf1 ha_lo ha_hi hhL (hf_pref.trans hh_pref.symm)
      exact ⟨ha_pref.trans hf_pref, by omega⟩

  -- =========================================================================
  -- Conjunct 4: `(B_1 S P L kops).card ≤ 3 * r * P` + Stopping Set `S_1`
  -- =========================================================================
  let b1Node (id : ℕ) : Fin r × List ℕ × ℕ :=
    let e := (jumps kops).getD id default
    let ℓ0 := sepScale S P L e.s e.x
    let ℓ1 := sepScale S P L e.x e.y
    let d := lcaDepth ℓ0 ℓ1
    (d, addrPref d.val ℓ1, addr ℓ1 d)

  let b1MStar (id : ℕ) : ℕ :=
    let info := b1Node id
    mStar info.1 info.2.1

  have h_b1_anatomies : ∀ id ∈ B_1 S P L kops,
      ∃ hid : id < (jumps kops).length,
        let e := (jumps kops)[id]
        let ℓ0 := sepScale S P L e.s e.x
        let ℓ1 := sepScale S P L e.x e.y
        let info := b1Node id
        let d := info.1
        let p := info.2.1
        let c := info.2.2
        let ms := b1MStar id
        let mlo := mLoChild d p c
        let Q := blockOf S P ms e.y
        1 ≤ ℓ0 ∧ ℓ0 < ℓ1 ∧ ℓ1 ≤ ms ∧ ms ≤ L ∧
          d = lcaDepth ℓ0 ℓ1 ∧ addrPref d.val ℓ0 = p ∧ addrPref d.val ℓ1 = p ∧
          addr ℓ0 d < c ∧ addr ℓ1 d = c ∧
          ℓ0 ≤ mlo ∧ mlo ≤ ℓ1 - 1 ∧
          (d, p) ∈ ActiveNodes ∧ 1 ≤ c ∧ c ≤ kNode d p ∧
          blockIdx S P ms e.y < (scaleBlocks S P ms).length ∧
          e.s < (blockOf S P mlo e.y).1 ∧ (blockOf S P mlo e.y).1 ≤ e.x ∧
          e.x < Q.1 ∧ Q.1 ≤ e.y ∧ e.y < Q.2 := by
    intro id hid
    simp only [B_1, Finset.mem_filter, Finset.mem_range] at hid
    obtain ⟨hlt, his⟩ := hid
    refine ⟨hlt, ?_⟩
    simp only [isB1, List.getElem?_eq_getElem hlt, decide_eq_true_eq] at his
    obtain ⟨hℓ1_1, hℓ1_L, hsep_sx⟩ := his
    have hb := h_jump_bounds id hlt
    dsimp (config := { failIfUnchanged := false }) only at hb
    set e := (jumps kops)[id]
    set ℓ0 := sepScale S P L e.s e.x
    set ℓ1 := sepScale S P L e.x e.y
    have hsP : e.s < P := by omega
    have hxP : e.x < P := by omega
    have hyP : e.y < P := by omega
    have hℓ0_rng := hpart.sep_range e.s hsP e.x hxP (by omega)
    have hℓ0_1 : 1 ≤ ℓ0 := hℓ0_rng.1
    have h_info : b1Node id =
        (lcaDepth ℓ0 ℓ1, addrPref (lcaDepth ℓ0 ℓ1).val ℓ1, addr ℓ1 (lcaDepth ℓ0 ℓ1)) := by
      simp only [b1Node, List.getD_eq_getElem _ _ hlt, e, ℓ0, ℓ1]
    set d := lcaDepth ℓ0 ℓ1
    set p := addrPref d.val ℓ1
    set c := addr ℓ1 d
    obtain ⟨hpref_01, _, hc0_lt⟩ := h_lca_spec ℓ0 ℓ1 hℓ0_1 hsep_sx hℓ1_L
    obtain ⟨hact, _, hms_L, _, hℓ1_ms, hc_1, hc_k⟩ :=
      h_mStar_props d p ℓ1 hℓ1_1 hℓ1_L rfl
    obtain ⟨_, _, hmlo_le, _, _, h0_le_mlo, _, _⟩ :=
      h_child_bounds d p c ℓ1 hℓ1_1 hℓ1_L rfl rfl
    have hℓ0_mlo : ℓ0 ≤ mLoChild d p c :=
      h0_le_mlo ℓ0 hℓ0_1 (by omega) hpref_01 hc0_lt
    have hms_eq : b1MStar id = mStar d p := by
      dsimp (config := { failIfUnchanged := false }) only [b1MStar]
      rw [h_info]
    set ms := mStar d p
    set mlo := mLoChild d p c
    have hmlo_L : mlo ≤ L := by omega
    have hidx_mlo_xy : blockIdx S P mlo e.x = blockIdx S P mlo e.y :=
      (hpart.sep_gt_iff mlo hmlo_L e.x hxP e.y hyP).mp (by omega)
    have hbo_mlo_xy : blockOf S P mlo e.x = blockOf S P mlo e.y := by
      simp only [blockOf, hidx_mlo_xy]
    have hx_ge_mlo : (blockOf S P mlo e.y).1 ≤ e.x := by
      rw [← hbo_mlo_xy]
      exact (h_block_bounds_of mlo hmlo_L e.x hxP).1
    have hne_mlo_sx : blockIdx S P mlo e.s ≠ blockIdx S P mlo e.x := by
      intro heq
      have := (hpart.sep_gt_iff mlo hmlo_L e.s hsP e.x hxP).mpr heq
      omega
    have hs_lt_mlo : e.s < (blockOf S P mlo e.y).1 := by
      rw [← hbo_mlo_xy]
      exact (h_block_disj mlo hmlo_L e.s e.x hb.2.2.1 hxP hne_mlo_sx).1
    have hne_ℓ1_xy : blockIdx S P ℓ1 e.x ≠ blockIdx S P ℓ1 e.y := by
      intro heq
      have := (hpart.sep_gt_iff ℓ1 hℓ1_L e.x hxP e.y hyP).mpr heq
      omega
    have hx_lt_ℓ1 : e.x < (blockOf S P ℓ1 e.y).1 :=
      (h_block_disj ℓ1 hℓ1_L e.x e.y hb.2.2.2.1 hyP hne_ℓ1_xy).1
    have hnest_ℓ1_ms := (h_block_nest ℓ1 ms hℓ1_ms hms_L e.y hyP).1
    obtain ⟨hq_lo, hq_hi, _, hq_idx⟩ := h_block_bounds_of ms hms_L e.y hyP
    dsimp (config := { failIfUnchanged := false }) only
    rw [h_info, hms_eq]
    exact ⟨hℓ0_1, hsep_sx, hℓ1_ms, hms_L, rfl, hpref_01, rfl, hc0_lt, rfl,
      hℓ0_mlo, hmlo_le, hact, hc_1, hc_k, hq_idx, hs_lt_mlo, hx_ge_mlo,
      by omega, hq_lo, hq_hi⟩

  let A1 := (B_1 S P L kops).filter (fun id =>
    (blockOf S P (b1MStar id) ((jumps kops).getD id default).y).2 ≤
      ((jumps kops).getD id default).z)
  let R1_b1 := (B_1 S P L kops).filter (fun id =>
    ¬((blockOf S P (b1MStar id) ((jumps kops).getD id default).y).2 ≤
      ((jumps kops).getD id default).z))
  let B11 := R1_b1.filter (fun id =>
    ¬(((jumps kops).getD id default).j + 1 < ((jumps kops).getD id default).m))
  let R2_b1 := R1_b1.filter (fun id =>
    ((jumps kops).getD id default).j + 1 < ((jumps kops).getD id default).m)
  let B12a := R2_b1.filter (fun id =>
    (blockOf S P (b1MStar id) ((jumps kops).getD id default).y).2 ≤
      ((jumps kops).getD (id + 1) default).y)
  let S_1 : Finset ℕ := A1 ∪ B11 ∪ B12a

  let b1CapMap (id : ℕ) : Fin r × List ℕ × ℕ × ℕ :=
    let info := b1Node id
    (info.1, info.2.1, info.2.2,
      blockIdx S P (b1MStar id) ((jumps kops).getD id default).y)

  have h_b1Cap_mem : ∀ id ∈ B_1 S P L kops, b1CapMap id ∈ CapSet := by
    intro id hid
    obtain ⟨hlt, _, _, _, _, _, _, _, _, _, _, _, hact, hc1, hck, hq_idx, _, _, _, _, _⟩ :=
      h_b1_anatomies id hid
    dsimp (config := { failIfUnchanged := false }) only [b1CapMap, CapSet, b1MStar]
    rw [List.getD_eq_getElem _ _ hlt]
    refine Finset.mem_biUnion.mpr ⟨((b1Node id).1, (b1Node id).2.1), hact, ?_⟩
    refine Finset.mem_image.mpr ⟨((b1Node id).2.2,
      blockIdx S P (mStar (b1Node id).1 (b1Node id).2.1) ((jumps kops)[id]).y), ?_, rfl⟩
    exact Finset.mem_product.mpr ⟨Finset.mem_Icc.mpr ⟨hc1, hck⟩, Finset.mem_range.mpr hq_idx⟩

  have hA1_le : A1.card ≤ CapSet.card := by
    refine h_card_inj A1 CapSet b1CapMap
      (fun id hid => h_b1Cap_mem id (Finset.mem_filter.mp hid).1)
      (fun id1 hid1 id2 hid2 hlt heq => by
        obtain ⟨hb1_1, ha1_1⟩ := Finset.mem_filter.mp hid1
        obtain ⟨hb1_2, _⟩ := Finset.mem_filter.mp hid2
        obtain ⟨h1_lt, _, _, _, hms1_L, _, _, _, _, _, _, hmlo1_le, _, _, _, _,
          _, hx1_ge_mlo, hx1_lt_Q, _, _⟩ := h_b1_anatomies id1 hb1_1
        obtain ⟨h2_lt, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _,
          hs2_lt_mlo, _, _, hq2_lo, hq2_hi⟩ := h_b1_anatomies id2 hb1_2
        dsimp (config := { failIfUnchanged := false }) only [b1CapMap] at heq
        rw [List.getD_eq_getElem _ _ h1_lt, List.getD_eq_getElem _ _ h2_lt] at heq
        rw [List.getD_eq_getElem _ _ h1_lt] at ha1_1
        have hd_eq : (b1Node id1).1 = (b1Node id2).1 := (Prod.mk.inj heq).1
        have hp_eq : (b1Node id1).2.1 = (b1Node id2).2.1 := (Prod.mk.inj (Prod.mk.inj heq).2).1
        have hc_eq : (b1Node id1).2.2 = (b1Node id2).2.2 :=
          (Prod.mk.inj (Prod.mk.inj (Prod.mk.inj heq).2).2).1
        have hq_eq : blockIdx S P (b1MStar id1) ((jumps kops)[id1]).y =
            blockIdx S P (b1MStar id2) ((jumps kops)[id2]).y :=
          (Prod.mk.inj (Prod.mk.inj (Prod.mk.inj heq).2).2).2
        have hms_eq : b1MStar id1 = b1MStar id2 := by
          dsimp (config := { failIfUnchanged := false }) only [b1MStar]; rw [hd_eq, hp_eq]
        rw [← hms_eq] at hq_eq hq2_lo hq2_hi
        have hmlo_eq : mLoChild (b1Node id1).1 (b1Node id1).2.1 (b1Node id1).2.2 =
            mLoChild (b1Node id2).1 (b1Node id2).2.1 (b1Node id2).2.2 := by
          rw [hd_eq, hp_eq, hc_eq]
        rw [← hmlo_eq] at hs2_lt_mlo
        have hb_j1 := h_jump_bounds id1 h1_lt
        have hb_j2 := h_jump_bounds id2 h2_lt
        dsimp (config := { failIfUnchanged := false }) only at hb_j1 hb_j2
        have hQ_eq : blockOf S P (b1MStar id1) ((jumps kops)[id1]).y =
            blockOf S P (b1MStar id1) ((jumps kops)[id2]).y := by
          simp only [blockOf, hq_eq]
        have hmlo_bo_eq :
            blockOf S P (mLoChild (b1Node id1).1 (b1Node id1).2.1 (b1Node id1).2.2)
              ((jumps kops)[id1]).y =
            blockOf S P (mLoChild (b1Node id1).1 (b1Node id1).2.1 (b1Node id1).2.2)
              ((jumps kops)[id2]).y :=
          (h_anc_eq_of _ (b1MStar id1) (by omega) hms1_L _ (by omega) _ (by omega) hq_eq).2
        rcases hjump.jump_order id1 h1_lt id2 h2_lt hlt with hst_lt | ⟨hst_eq, _⟩
        · rw [hQ_eq] at ha1_1 hx1_lt_Q
          rw [← hmlo_bo_eq] at hs2_lt_mlo
          have hy2_ls := (h_jump_ls id2 h2_lt).2.1
          exact h_lock_contra id1 h1_lt id2 h2_lt hst_lt (by omega)
            ((jumps kops)[id2]).y hy2_ls (by omega) (by omega)
        · have hchain := h_same_step id1 h1_lt id2 h2_lt hlt hst_eq
          rw [hQ_eq] at ha1_1
          omega)

  have hB11_le : B11.card ≤ P := by
    have hle := h_card_inj B11 (Finset.range P)
      (fun id => ((jumps kops).getD id default).s)
      (fun id hid => by
        obtain ⟨hr1, _⟩ := Finset.mem_filter.mp hid
        obtain ⟨hb1, _⟩ := Finset.mem_filter.mp hr1
        obtain ⟨hlt, _⟩ := h_b1_anatomies id hb1
        dsimp (config := { failIfUnchanged := false }) only
        rw [List.getD_eq_getElem _ _ hlt, Finset.mem_range]
        have hb := h_jump_bounds id hlt
        dsimp (config := { failIfUnchanged := false }) only at hb
        omega)
      (fun id1 hid1 id2 hid2 hlt heq => by
        obtain ⟨hr1_1, hnot1⟩ := Finset.mem_filter.mp hid1
        obtain ⟨hb1_1, _⟩ := Finset.mem_filter.mp hr1_1
        obtain ⟨hr1_2, _⟩ := Finset.mem_filter.mp hid2
        obtain ⟨hb1_2, _⟩ := Finset.mem_filter.mp hr1_2
        obtain ⟨h1_lt, _⟩ := h_b1_anatomies id1 hb1_1
        obtain ⟨h2_lt, _⟩ := h_b1_anatomies id2 hb1_2
        simp only [List.getD_eq_getElem _ _ h1_lt, List.getD_eq_getElem _ _ h2_lt] at hnot1 heq
        exact h_last_jump_contra id1 h1_lt id2 h2_lt hlt heq hnot1)
    simpa only [Finset.card_range] using hle

  have hB12a_le : B12a.card ≤ CapSet.card := by
    refine h_card_inj B12a CapSet b1CapMap
      (fun id hid =>
        h_b1Cap_mem id (Finset.mem_filter.mp (Finset.mem_filter.mp (Finset.mem_filter.mp hid).1).1).1)
      (fun id1 hid1 id2 hid2 hlt heq => by
        obtain ⟨hr2_1, hnh1⟩ := Finset.mem_filter.mp hid1
        obtain ⟨hr1_1, hjm1⟩ := Finset.mem_filter.mp hr2_1
        obtain ⟨hb1_1, hna1⟩ := Finset.mem_filter.mp hr1_1
        obtain ⟨hr2_2, _⟩ := Finset.mem_filter.mp hid2
        obtain ⟨hr1_2, _⟩ := Finset.mem_filter.mp hr2_2
        obtain ⟨hb1_2, hna2⟩ := Finset.mem_filter.mp hr1_2
        obtain ⟨h1_lt, _, _, _, hms1_L, _, _, _, _, _, _, hmlo1_le, _, _, _, _,
          _, hx1_ge_mlo, hx1_lt_Q, _, _⟩ := h_b1_anatomies id1 hb1_1
        obtain ⟨h2_lt, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _,
          hs2_lt_mlo, _, _, hq2_lo, hq2_hi⟩ := h_b1_anatomies id2 hb1_2
        rw [List.getD_eq_getElem _ _ h1_lt] at hjm1 hna1
        rw [List.getD_eq_getElem _ _ h2_lt] at hna2
        obtain ⟨h1_succ_lt, hst_s1, _, _, _, hx_s1⟩ := h_jump_succ id1 h1_lt hjm1
        rw [List.getD_eq_getElem _ _ h1_lt, List.getD_eq_getElem _ _ h1_succ_lt] at hnh1
        dsimp (config := { failIfUnchanged := false }) only [b1CapMap] at heq
        rw [List.getD_eq_getElem _ _ h1_lt, List.getD_eq_getElem _ _ h2_lt] at heq
        have hd_eq : (b1Node id1).1 = (b1Node id2).1 := (Prod.mk.inj heq).1
        have hp_eq : (b1Node id1).2.1 = (b1Node id2).2.1 := (Prod.mk.inj (Prod.mk.inj heq).2).1
        have hc_eq : (b1Node id1).2.2 = (b1Node id2).2.2 :=
          (Prod.mk.inj (Prod.mk.inj (Prod.mk.inj heq).2).2).1
        have hq_eq : blockIdx S P (b1MStar id1) ((jumps kops)[id1]).y =
            blockIdx S P (b1MStar id2) ((jumps kops)[id2]).y :=
          (Prod.mk.inj (Prod.mk.inj (Prod.mk.inj heq).2).2).2
        have hms_eq : b1MStar id1 = b1MStar id2 := by
          dsimp (config := { failIfUnchanged := false }) only [b1MStar]; rw [hd_eq, hp_eq]
        rw [← hms_eq] at hq_eq hq2_lo hq2_hi hna2
        have hmlo_eq : mLoChild (b1Node id1).1 (b1Node id1).2.1 (b1Node id1).2.2 =
            mLoChild (b1Node id2).1 (b1Node id2).2.1 (b1Node id2).2.2 := by
          rw [hd_eq, hp_eq, hc_eq]
        rw [← hmlo_eq] at hs2_lt_mlo
        have hb_j1 := h_jump_bounds id1 h1_lt
        have hb_j1s := h_jump_bounds (id1 + 1) h1_succ_lt
        have hb_j2 := h_jump_bounds id2 h2_lt
        dsimp (config := { failIfUnchanged := false }) only at hb_j1 hb_j1s hb_j2
        have hQ_eq : blockOf S P (b1MStar id1) ((jumps kops)[id1]).y =
            blockOf S P (b1MStar id1) ((jumps kops)[id2]).y := by
          simp only [blockOf, hq_eq]
        have hmlo_bo_eq :
            blockOf S P (mLoChild (b1Node id1).1 (b1Node id1).2.1 (b1Node id1).2.2)
              ((jumps kops)[id1]).y =
            blockOf S P (mLoChild (b1Node id1).1 (b1Node id1).2.1 (b1Node id1).2.2)
              ((jumps kops)[id2]).y :=
          (h_anc_eq_of _ (b1MStar id1) (by omega) hms1_L _ (by omega) _ (by omega) hq_eq).2
        rcases hjump.jump_order id1 h1_lt id2 h2_lt hlt with hst_lt | ⟨hst_eq, _⟩
        · rw [← hmlo_bo_eq] at hs2_lt_mlo
          rw [hQ_eq] at hna1 hnh1 hx1_lt_Q
          have hs2x1 : ((jumps kops)[id2]).s < ((jumps kops)[id1]).x := by omega
          have hs2x1s : ((jumps kops)[id2]).s < ((jumps kops)[id1 + 1]).x := by omega
          have hst_lt_s : ((jumps kops)[id1 + 1]).step < ((jumps kops)[id2]).step := by omega
          obtain ⟨_, hy2_ls, hz2_ls⟩ := h_jump_ls id2 h2_lt
          rcases lt_trichotomy ((jumps kops)[id2]).y ((jumps kops)[id1]).z with
            hy_lt | hy_eq | hy_gt
          · exact h_lock_contra id1 h1_lt id2 h2_lt hst_lt hs2x1
              ((jumps kops)[id2]).y hy2_ls (by omega) hy_lt
          · exact h_lock_contra (id1 + 1) h1_succ_lt id2 h2_lt hst_lt_s hs2x1s
              ((jumps kops)[id2]).z hz2_ls (by omega) (by omega)
          · exact h_lock_contra (id1 + 1) h1_succ_lt id2 h2_lt hst_lt_s hs2x1s
              ((jumps kops)[id2]).y hy2_ls (by omega) (by omega)
        · rw [hQ_eq] at hnh1
          by_cases hid_adj : id2 = id1 + 1
          · subst hid_adj; omega
          · have hlt_s : id1 + 1 < id2 := by omega
            have hchain := h_same_step (id1 + 1) h1_succ_lt id2 h2_lt hlt_s (by omega)
            omega)

  have hS1_sub : S_1 ⊆ B_1 S P L kops := by
    intro id hid
    rcases Finset.mem_union.mp hid with h12 | h3
    · rcases Finset.mem_union.mp h12 with h1 | h2
      · exact (Finset.mem_filter.mp h1).1
      · exact (Finset.mem_filter.mp (Finset.mem_filter.mp h2).1).1
    · exact (Finset.mem_filter.mp (Finset.mem_filter.mp (Finset.mem_filter.mp h3).1).1).1

  have hS1_card : S_1.card ≤ 2 * P := by
    have u1 := Finset.card_union_le (A1 ∪ B11) B12a
    have u2 := Finset.card_union_le A1 B11
    dsimp (config := { failIfUnchanged := false }) only [S_1]
    omega

  have h_b1_step_out : ∀ id ∈ B_1 S P L kops \ S_1,
      ∃ hid : id < (jumps kops).length,
        ((jumps kops)[id]).j + 1 < ((jumps kops)[id]).m ∧
        ((jumps kops)[id]).z <
          (blockOf S P (sepScale S P L ((jumps kops)[id]).x ((jumps kops)[id]).y)
            ((jumps kops)[id]).y).2 ∧
        (id + 1 ∈ B_fin_pre S P L kops ∨
          (id + 1 ∈ B_1 S P L kops ∧ (b1Node (id + 1)).1.val < (b1Node id).1.val)) := by
    intro id hid_sd
    obtain ⟨hb1, hnot_S1⟩ := Finset.mem_sdiff.mp hid_sd
    obtain ⟨hlt, hℓ0_1, hsep_sx, hℓ1_ms, hms_L, hd_eq, hpref0, _, _, _, _, _,
      _, _, _, _, _, _, _, hq_lo, _⟩ := h_b1_anatomies id hb1
    have hnot_A1 : id ∉ A1 := fun h => hnot_S1 (Finset.mem_union_left _ (Finset.mem_union_left _ h))
    have hnot_B11 : id ∉ B11 :=
      fun h => hnot_S1 (Finset.mem_union_left _ (Finset.mem_union_right _ h))
    have hnot_B12a : id ∉ B12a := fun h => hnot_S1 (Finset.mem_union_right _ h)
    have hz_lt_Q : ((jumps kops)[id]).z < (blockOf S P (b1MStar id) ((jumps kops)[id]).y).2 := by
      by_contra hge
      apply hnot_A1
      refine Finset.mem_filter.mpr ⟨hb1, ?_⟩
      rw [List.getD_eq_getElem _ _ hlt]
      omega
    have h_in_R1 : id ∈ R1_b1 := by
      refine Finset.mem_filter.mpr ⟨hb1, ?_⟩
      rw [List.getD_eq_getElem _ _ hlt]
      omega
    have hjm : ((jumps kops)[id]).j + 1 < ((jumps kops)[id]).m := by
      by_contra hn
      apply hnot_B11
      refine Finset.mem_filter.mpr ⟨h_in_R1, ?_⟩
      rw [List.getD_eq_getElem _ _ hlt]
      exact hn
    have h_in_R2 : id ∈ R2_b1 := by
      refine Finset.mem_filter.mpr ⟨h_in_R1, ?_⟩
      rw [List.getD_eq_getElem _ _ hlt]
      exact hjm
    obtain ⟨h_succ_lt, _, hs_eq, _, _, hx_eq⟩ := h_jump_succ id hlt hjm
    have hy'_lt_Q :
        ((jumps kops)[id + 1]).y < (blockOf S P (b1MStar id) ((jumps kops)[id]).y).2 := by
      by_contra hge
      apply hnot_B12a
      refine Finset.mem_filter.mpr ⟨h_in_R2, ?_⟩
      rw [List.getD_eq_getElem _ _ hlt, List.getD_eq_getElem _ _ h_succ_lt]
      omega
    have hb := h_jump_bounds id hlt
    have hbs := h_jump_bounds (id + 1) h_succ_lt
    dsimp (config := { failIfUnchanged := false }) only at hb hbs
    set e := (jumps kops)[id]
    set e' := (jumps kops)[id + 1]
    set ℓ0 := sepScale S P L e.s e.x
    set ℓ1 := sepScale S P L e.x e.y
    set ms := b1MStar id
    have hyP : e.y < P := by omega
    have hzP : e.z < P := by omega
    have hysP : e'.y < P := by omega
    have hnest_ℓ1_ms := (h_block_nest ℓ1 ms hℓ1_ms hms_L e.y hyP).2
    have hz_lt_ℓ1 : e.z < (blockOf S P ℓ1 e.y).2 := by omega
    refine ⟨hlt, hjm, hz_lt_ℓ1, ?_⟩
    have hidx_ms_yz : blockIdx S P ms e.y = blockIdx S P ms e.z :=
      (hpart.blocks_eq_iff ms hms_L e.y hyP e.z hzP).mpr ⟨by omega, hz_lt_Q⟩
    have hidx_ms_yy' : blockIdx S P ms e.y = blockIdx S P ms e'.y :=
      (hpart.blocks_eq_iff ms hms_L e.y hyP e'.y hysP).mpr ⟨by omega, hy'_lt_Q⟩
    have hsep_yz_ms : ms < sepScale S P L e.y e.z :=
      (hpart.sep_gt_iff ms hms_L e.y hyP e.z hzP).mpr hidx_ms_yz
    have hsep_x'y'_ms : ms < sepScale S P L e'.x e'.y := by
      rw [hx_eq]
      exact (hpart.sep_gt_iff ms hms_L e.z hzP e'.y hysP).mpr (hidx_ms_yz.symm.trans hidx_ms_yy')
    have hult_xz := hpart.sep_ultrametric e.x e.y e.z (by omega) (by omega) hzP
    have hsep_xz : sepScale S P L e.x e.z = ℓ1 := by
      rw [hult_xz]
      exact min_eq_left (by omega)
    have hult_sz := hpart.sep_ultrametric e.s e.x e.z (by omega) (by omega) hzP
    have hℓ0'_eq : sepScale S P L e'.s e'.x = ℓ0 := by
      rw [hs_eq, hx_eq, hult_sz, hsep_xz]
      exact min_eq_left (by omega)
    set ℓ1' := sepScale S P L e'.x e'.y
    have hℓ1'_rng := hpart.sep_range e'.x (by omega) e'.y hysP (by omega)
    by_cases hℓ1'_L1 : ℓ1' = L + 1
    · left
      have hne_L : blockIdx S P L e'.s ≠ blockIdx S P L e'.x := by
        intro heq
        have := (hpart.sep_gt_iff L le_rfl _ (by omega) _ (by omega)).mpr heq
        omega
      have hs_lt_bo := (h_block_disj L le_rfl _ _ hbs.2.2.1 (by omega) hne_L).1
      simp only [B_fin_pre, Finset.mem_filter, Finset.mem_range, isBFinPre,
        List.getElem?_eq_getElem h_succ_lt, decide_eq_true_eq]
      exact ⟨h_succ_lt, hℓ1'_L1, hs_lt_bo⟩
    · right
      have hℓ1'_L : ℓ1' ≤ L := by omega
      have hb1_succ : id + 1 ∈ B_1 S P L kops := by
        simp only [B_1, Finset.mem_filter, Finset.mem_range, isB1,
          List.getElem?_eq_getElem h_succ_lt, decide_eq_true_eq]
        exact ⟨h_succ_lt, by dsimp (config := { failIfUnchanged := false }) only [e, e', ℓ0, ℓ1, ℓ1', ms] at *; omega, hℓ1'_L,
          by dsimp (config := { failIfUnchanged := false }) only [e, e', ℓ0, ℓ1, ℓ1', ms] at *; omega⟩
      refine ⟨hb1_succ, ?_⟩
      set d := (b1Node id).1
      set p := (b1Node id).2.1
      have hms_def : ms = mStar d p := rfl
      have hnot_pref : addrPref d.val ℓ0 ≠ addrPref d.val ℓ1' := by
        intro heq_pref
        have hp1' : addrPref d.val ℓ1' = p := heq_pref.symm.trans hpref0
        obtain ⟨_, _, _, _, hℓ1'_le_ms, _, _⟩ := h_mStar_props d p ℓ1' (by omega) hℓ1'_L hp1'
        omega
      have hlca_lt := h_lca_lt_of_ne ℓ0 ℓ1' d hℓ0_1 (by omega) hℓ1'_L hnot_pref
      have hd'_eq : (b1Node (id + 1)).1 = lcaDepth ℓ0 ℓ1' := by
        simp only [b1Node, List.getD_eq_getElem _ _ h_succ_lt, e', hℓ0'_eq, ℓ1']
      rw [hd'_eq]
      exact hlca_lt

  let B1_to_fin := (B_1 S P L kops \ S_1).filter (fun id => id + 1 ∈ B_fin_pre S P L kops)
  let Stop_1 := S_1 ∪ B1_to_fin

  have hB1_to_fin_le : B1_to_fin.card ≤ (B_fin_pre S P L kops).card := by
    refine h_card_inj B1_to_fin (B_fin_pre S P L kops) (fun id => id + 1)
      (fun id hid => (Finset.mem_filter.mp hid).2)
      (fun _ _ _ _ _ heq => by dsimp (config := { failIfUnchanged := false }) only at heq; omega)

  have hStop1_le : Stop_1.card ≤ 3 * P := by
    have u1 := Finset.card_union_le S_1 B1_to_fin
    dsimp (config := { failIfUnchanged := false }) only [Stop_1]
    omega

  have h_conj4 : (B_1 S P L kops).card ≤ 3 * r * P := by
    have hchain := omega_chain_card_bound r (B_1 S P L kops) Stop_1
      (fun id => (b1Node id).1.val)
      (fun id _ => (b1Node id).1.isLt)
      (fun id hid hnot_stop => by
        have hnot_S1 : id ∉ S_1 := fun h => hnot_stop (Finset.mem_union_left _ h)
        have h_sd : id ∈ B_1 S P L kops \ S_1 := Finset.mem_sdiff.mpr ⟨hid, hnot_S1⟩
        obtain ⟨_, _, _, hcases⟩ := h_b1_step_out id h_sd
        rcases hcases with hfin | ⟨hb1_s, hlt_d⟩
        · exfalso
          exact hnot_stop (Finset.mem_union_right _ (Finset.mem_filter.mpr ⟨h_sd, hfin⟩))
        · exact ⟨hb1_s, hlt_d⟩)
    have hmul := Nat.mul_le_mul_left r hStop1_le
    nlinarith

  -- =========================================================================
  -- Entry Transitions `E_enter` into `B_1 ∪ B_fin_pre` (`card ≤ 3 * P`)
  -- =========================================================================
  let B_pre_all : Finset ℕ := B_1 S P L kops ∪ B_fin_pre S P L kops
  let E_enter : Finset ℕ :=
    (Finset.range (jumps kops).length).filter (fun id =>
      id ∉ (B_1 S P L kops \ S_1) ∧
        ((jumps kops).getD id default).j + 1 < ((jumps kops).getD id default).m ∧
        id + 1 ∈ B_pre_all)

  have hE_enter_card : E_enter.card ≤ 3 * P := by
    have h_disj : Disjoint (B_1 S P L kops \ S_1) E_enter := by
      rw [Finset.disjoint_left]
      intro id hid1 hid2
      exact (Finset.mem_filter.mp hid2).2.1 hid1
    have h_inj_union :
        ((B_1 S P L kops \ S_1) ∪ E_enter).card ≤ B_pre_all.card := by
      refine h_card_inj ((B_1 S P L kops \ S_1) ∪ E_enter) B_pre_all (fun id => id + 1)
        (fun id hid => by
          rcases Finset.mem_union.mp hid with h1 | h2
          · obtain ⟨_, _, _, hcases⟩ := h_b1_step_out id h1
            rcases hcases with hfin | ⟨hb1_s, _⟩
            · exact Finset.mem_union_right _ hfin
            · exact Finset.mem_union_left _ hb1_s
          · exact (Finset.mem_filter.mp h2).2.2.2)
        (fun _ _ _ _ _ heq => by dsimp (config := { failIfUnchanged := false }) only at heq; omega)
    rw [Finset.card_union_of_disjoint h_disj] at h_inj_union
    have h_b1_split : (B_1 S P L kops).card = (B_1 S P L kops \ S_1).card + S_1.card :=
      (Finset.card_sdiff_add_card_eq_card hS1_sub).symm
    have h_pre_le : B_pre_all.card ≤ (B_1 S P L kops).card + (B_fin_pre S P L kops).card :=
      Finset.card_union_le _ _
    omega

  -- =========================================================================
  -- Conjunct 5: `(B_3_intra S P L kops).card ≤ 6 * P + countKeyedRslr kops`
  -- =========================================================================
  have h_conj5 : (B_3_intra S P L kops).card ≤ 6 * P + countKeyedRslr kops := by
    have h_len_aux : ∀ xs : List KeyedCoreOp,
        xs.length = (pushKeys xs).length + (popKeys xs).length + countKeyedRslr xs := by
      intro xs
      induction xs with
      | nil => rfl
      | cons op rest ih =>
        rcases op with w | s | d
        · simp only [List.length_cons, pushKeys, popKeys, countKeyedRslr]; omega
        · simp only [List.length_cons, pushKeys, popKeys, countKeyedRslr]; omega
        · simp only [List.length_cons, pushKeys, popKeys, countKeyedRslr]; omega
    have h_kops_len : kops.length = 2 * P + countKeyedRslr kops := by
      have h1 := h_len_aux kops
      have h2 : (pushKeys kops).length = P := by simpa using hkvalid.push_perm.length_eq
      have h3 : (popKeys kops).length = P := by simpa using congrArg List.length hkvalid.pop_eq
      omega

    let V : ℕ → Finset ℕ := fun t => (inorderNat (keyedState kops t)).toFinset
    let pi : ℕ → ℕ → ℕ := fun t v => lcrsParent P (foldBST P (keyedState kops t)).1 v
    let phi : ℕ → ℕ → ℕ := fun t v =>
      if 1 ≤ sepScale S P L v (pi t v) ∧
          sepScale S P L v (pi t v) ≤ L ∧
          sepScale S P L v (pi t v) < sepScale S P L (pi t v) (pi t (pi t v))
      then 1 else 0
    let Phi : ℕ → ℕ := fun t => (V t).sum (fun v => phi t v)
    let b3t : ℕ → ℕ := fun t =>
      ((B_3_intra S P L kops).filter (fun id => ((jumps kops).getD id default).step = t)).card
    let eentert : ℕ → ℕ := fun t =>
      (E_enter.filter (fun id => ((jumps kops).getD id default).step = t)).card

    have h_phi_le_one : ∀ t v, phi t v ≤ 1 := by
      intro t v; dsimp (config := { failIfUnchanged := false }) only [phi]; split_ifs <;> omega

    have h_V_iff : ∀ t ≤ kops.length, ∀ v,
        v ∈ V t ↔ v < P ∧ birthStep kops v < t ∧ t ≤ popStep kops v := by
      intro t ht v
      simp only [V, List.mem_toFinset, hkvalid.mem_inorder_iff t ht v]

    have h_birth_eq : ∀ t (ht : t < kops.length) v, v < P →
        (birthStep kops v = t ↔ kops[t] = .push v) := by
      intro t ht v hv
      constructor
      · intro hb
        have hopt := hkvalid.birth_op v hv
        rw [hb, List.getElem?_eq_getElem ht] at hopt
        exact Option.some.inj hopt
      · intro hop
        have hsv := hkvalid.step_valid t ht
        rw [hop] at hsv
        exact hsv.2.1

    have h_pop_eq : ∀ t (ht : t < kops.length) v, v < P →
        (popStep kops v = t ↔ kops[t] = .pop v) := by
      intro t ht v hv
      constructor
      · intro hp
        have hopt := hkvalid.pop_op v hv
        rw [hp, List.getElem?_eq_getElem ht] at hopt
        exact Option.some.inj hopt
      · intro hop
        have hsv := hkvalid.step_valid t ht
        rw [hop] at hsv
        exact hsv.2.1

    have h_no_jumps_nonpop : ∀ t (ht : t < kops.length),
        (∀ s, kops[t] ≠ .pop s) → b3t t = 0 ∧ eentert t = 0 := by
      intro t ht hnp
      have hempty : ∀ A : Finset ℕ, A ⊆ Finset.range (jumps kops).length →
          (A.filter (fun id => ((jumps kops).getD id default).step = t)).card = 0 := by
        intro A hsub
        rw [Finset.card_eq_zero, Finset.filter_eq_empty_iff]
        intro id hid hst
        have hlt : id < (jumps kops).length := Finset.mem_range.mp (hsub hid)
        rw [List.getD_eq_getElem _ _ hlt] at hst
        obtain ⟨_, hstep, hopt, _⟩ := hjump.jump_anatomies id hlt
        rw [hst, List.getElem?_eq_getElem ht] at hopt
        exact hnp _ (Option.some.inj hopt)
      exact ⟨hempty _ (fun _ hid => (Finset.mem_filter.mp hid).1),
        hempty _ (fun _ hid => (Finset.mem_filter.mp hid).1)⟩

    have h_step_bound : ∀ t < kops.length,
        b3t t + Phi (t + 1) ≤ Phi t + 1 + eentert t := by
      intro t ht
      rcases hop : kops[t] with w | s | d0
      · obtain ⟨hb3_0, he_0⟩ := h_no_jumps_nonpop t ht (by simp [hop])
        have hsv := hkvalid.step_valid t ht
        rw [hop] at hsv
        obtain ⟨hwP, hbw, _⟩ := hsv
        have hw_lt_pop := (hkvalid.birth_lt_pop w hwP).1
        have hw_not_Vt : w ∉ V t := by
          rw [h_V_iff t (by omega) w]; omega
        have hV_next : V (t + 1) = insert w (V t) := by
          ext v
          simp only [Finset.mem_insert, h_V_iff t (by omega) v, h_V_iff (t + 1) (by omega) v]
          by_cases hvw : v = w
          · subst hvw; omega
          · by_cases hvP : v < P
            · have hne_b : birthStep kops v ≠ t := by
                intro hb
                have hpush := (h_birth_eq t ht v hvP).mp hb
                rw [hop] at hpush
                exact hvw (KeyedCoreOp.push.inj hpush).symm
              have hne_p : popStep kops v ≠ t := by
                intro hp
                have hpop := (h_pop_eq t ht v hvP).mp hp
                rw [hop] at hpop
                cases hpop
              omega
            · omega
        obtain ⟨_, _, hpi_other⟩ := hfold.fold_step_push t ht w hop
        have hsum_eq : (V t).sum (fun v => phi (t + 1) v) = Phi t := by
          refine Finset.sum_congr rfl ?_
          intro v hv
          have hvw : v ≠ w := fun heq => hw_not_Vt (heq ▸ hv)
          have hpi1 : pi (t + 1) v = pi t v := hpi_other v hvw
          have hv_in : v ∈ inorderNat (keyedState kops t) := List.mem_toFinset.mp hv
          obtain ⟨_, _, hp_cases⟩ := hfold.lcrs_bounds t (by omega) v hv_in
          have hpw : pi t v ≠ w := by
            rcases hp_cases with hpP | hp_in
            · dsimp (config := { failIfUnchanged := false }) only [pi]; rw [hpP]; omega
            · intro heq; exact hw_not_Vt (List.mem_toFinset.mpr (heq ▸ hp_in))
          have hpi2 : pi (t + 1) (pi t v) = pi t (pi t v) := hpi_other (pi t v) hpw
          dsimp (config := { failIfUnchanged := false }) only [phi]; rw [hpi1, hpi2]
        have hPhi_next : Phi (t + 1) = phi (t + 1) w + Phi t := by
          dsimp (config := { failIfUnchanged := false }) only [Phi]; rw [hV_next, Finset.sum_insert hw_not_Vt, hsum_eq]
        have hphi_w := h_phi_le_one (t + 1) w
        omega

      · have hsv := hkvalid.step_valid t ht
        rw [hop] at hsv
        obtain ⟨hsP, hps, _⟩ := hsv
        have hV_next : V (t + 1) = (V t).erase s := by
          ext v
          simp only [Finset.mem_erase, h_V_iff t (by omega) v, h_V_iff (t + 1) (by omega) v]
          by_cases hvs : v = s
          · subst hvs; omega
          · by_cases hvP : v < P
            · have hne_b : birthStep kops v ≠ t := by
                intro hb
                have hpush := (h_birth_eq t ht v hvP).mp hb
                rw [hop] at hpush; cases hpush
              have hne_p : popStep kops v ≠ t := by
                intro hp
                have hpop := (h_pop_eq t ht v hvP).mp hp
                rw [hop] at hpop
                exact hvs (KeyedCoreOp.pop.inj hpop).symm
              omega
            · omega
        have hV_sub : V (t + 1) ⊆ V t := by
          rw [hV_next]; exact Finset.erase_subset s (V t)
        obtain ⟨baseId, hbase_le, hbase_iff⟩ := hjump.pop_step_jumps t ht s hop
        set m := ((leftSpineBottomUpNat (keyedState kops t)).length - 2) / 2
        let Jt : Finset ℕ := Finset.Ico baseId (baseId + m)
        let mu : ℕ → ℕ := fun id => ((jumps kops).getD id default).x
        let Mt : Finset ℕ := Jt.image mu

        have h_Jt_mem : ∀ id, id ∈ Jt ↔
            ∃ hid : id < (jumps kops).length, ((jumps kops)[id]).step = t := by
          intro id
          simp only [Jt, Finset.mem_Ico]
          constructor
          · intro hico
            have hid : id < (jumps kops).length := by omega
            exact ⟨hid, (hbase_iff id hid).mpr hico⟩
          · rintro ⟨hid, hst⟩; exact (hbase_iff id hid).mp hst

        have h_sub_filter : ∀ A : Finset ℕ, A ⊆ Finset.range (jumps kops).length →
            A.filter (fun id => ((jumps kops).getD id default).step = t) =
              Jt.filter (fun id => id ∈ A) := by
          intro A hA
          ext id
          simp only [Finset.mem_filter, h_Jt_mem]
          constructor
          · rintro ⟨ha, hst⟩
            have hid : id < (jumps kops).length := Finset.mem_range.mp (hA ha)
            rw [List.getD_eq_getElem _ _ hid] at hst
            exact ⟨⟨hid, hst⟩, ha⟩
          · rintro ⟨⟨hid, hst⟩, ha⟩
            rw [List.getD_eq_getElem _ _ hid]
            exact ⟨ha, hst⟩

        have hb3t_eq : b3t t = (Jt.filter (fun id => id ∈ B_3_intra S P L kops)).card :=
          congrArg Finset.card (h_sub_filter _ (fun _ hid => (Finset.mem_filter.mp hid).1))
        have heentert_eq : eentert t = (Jt.filter (fun id => id ∈ E_enter)).card :=
          congrArg Finset.card (h_sub_filter _ (fun _ hid => (Finset.mem_filter.mp hid).1))

        have h_mu_inj : Set.InjOn mu ↑Jt := by
          intro id1 hid1 id2 hid2 heq
          obtain ⟨h1_lt, hst1⟩ := (h_Jt_mem id1).mp (Finset.mem_coe.mp hid1)
          obtain ⟨h2_lt, hst2⟩ := (h_Jt_mem id2).mp (Finset.mem_coe.mp hid2)
          simp only [mu, List.getD_eq_getElem _ _ h1_lt, List.getD_eq_getElem _ _ h2_lt] at heq
          have hb1 := h_jump_bounds id1 h1_lt
          have hb2 := h_jump_bounds id2 h2_lt
          dsimp (config := { failIfUnchanged := false }) only at hb1 hb2
          rcases lt_trichotomy id1 id2 with hlt | rfl | hgt
          · have := h_same_step id1 h1_lt id2 h2_lt hlt (hst1.trans hst2.symm); omega
          · rfl
          · have := h_same_step id2 h2_lt id1 h1_lt hgt (hst2.trans hst1.symm); omega

        have h_Mt_sub : Mt ⊆ V (t + 1) := by
          intro v hv
          obtain ⟨id, hid_Jt, rfl⟩ := Finset.mem_image.mp hv
          obtain ⟨hid, hst⟩ := (h_Jt_mem id).mp hid_Jt
          simp only [mu, List.getD_eq_getElem _ _ hid]
          have hls1 := (hfold.spine_lock id hid).1
          rw [hst] at hls1
          have hin_f := h_ls_mem_inorder _ _ hls1
          rw [(hfold.fold_bst_inorder (t + 1) (by omega)).2] at hin_f
          exact List.mem_toFinset.mpr hin_f

        have h_nonmover : ∀ v ∈ V (t + 1) \ Mt, phi (t + 1) v ≤ phi t v := by
          intro v hv_sdiff
          obtain ⟨hv_t1, hv_not_Mt⟩ := Finset.mem_sdiff.mp hv_sdiff
          have hv_in1 : v ∈ inorderNat (keyedState kops (t + 1)) := List.mem_toFinset.mp hv_t1
          have hnot_x : ∀ id (hid : id < (jumps kops).length),
              ((jumps kops)[id]).step = t → v ≠ ((jumps kops)[id]).x := by
            intro id hid hst heq
            apply hv_not_Mt
            refine Finset.mem_image.mpr ⟨id, (h_Jt_mem id).mpr ⟨hid, hst⟩, ?_⟩
            simp only [mu, List.getD_eq_getElem _ _ hid, heq]
          have hpi_v : pi (t + 1) v = pi t v :=
            (hfold.fold_step_pop t ht s hop).2 v hv_in1 hnot_x
          dsimp (config := { failIfUnchanged := false }) only [phi]
          split_ifs with hc1 hc0
          · rfl
          · exfalso
            apply hc0
            rw [hpi_v] at hc1
            obtain ⟨h1_le, hL_ge, hgt⟩ := hc1
            refine ⟨h1_le, hL_ge, ?_⟩
            set u := pi t v
            have hu_ne_P : u ≠ P := by
              intro huP; rw [huP, (hpart.sep_top v).1] at h1_le; omega
            obtain ⟨_, _, hu_cases⟩ := hfold.lcrs_bounds (t + 1) (by omega) v hv_in1
            have hlcrs_u : lcrsParent P (foldBST P (keyedState kops (t + 1))).1 v = u := hpi_v
            have hu_in1 : u ∈ inorderNat (keyedState kops (t + 1)) := by
              rcases hu_cases with hP_eq | hin
              · exact False.elim (hu_ne_P (hlcrs_u.symm.trans hP_eq))
              · rwa [hlcrs_u] at hin
            have hu_in0 : u ∈ inorderNat (keyedState kops t) :=
              List.mem_toFinset.mp (hV_sub (List.mem_toFinset.mpr hu_in1))
            set p := pi t u
            set q := pi (t + 1) u
            have hup : u < p := (hfold.lcrs_bounds t (by omega) u hu_in0).1
            have hpq : p ≤ q := hfold.lcrs_mono t ht u hu_in0 hu_in1
            have hq_le_P : q ≤ P := (hfold.lcrs_bounds (t + 1) (by omega) u hu_in1).2.1
            have hq_ne_P : q ≠ P := by
              intro hqP; rw [hqP, (hpart.sep_top u).1] at hgt; omega
            have hult := hpart.sep_ultrametric u p q (by omega) hpq (by omega)
            rw [hult] at hgt
            exact lt_of_lt_of_le hgt (Nat.min_le_left _ _)
          · exact Nat.zero_le _
          · exact le_rfl

        have h_precancel : ∀ id ∈ Jt,
            (if id ∈ B_3_intra S P L kops then 1 else 0) ≤ phi t (mu id) := by
          intro id hid_Jt
          split_ifs with hb3
          · obtain ⟨hid, hst⟩ := (h_Jt_mem id).mp hid_Jt
            simp only [mu, List.getD_eq_getElem _ _ hid]
            simp only [B_3_intra, Finset.mem_filter, Finset.mem_range, isB3Intra,
              List.getElem?_eq_getElem hid, decide_eq_true_eq] at hb3
            obtain ⟨_, hℓ1, hℓL, _, hz_lt⟩ := hb3
            obtain ⟨hlcrs_x, hlcrs_y, _⟩ := hfold.jump_lcrs id hid
            rw [hst] at hlcrs_x hlcrs_y
            have hpi_x : pi t ((jumps kops)[id]).x = ((jumps kops)[id]).y := hlcrs_x
            have hpi_y : pi t ((jumps kops)[id]).y = ((jumps kops)[id]).z := hlcrs_y
            have hb := h_jump_bounds id hid
            dsimp (config := { failIfUnchanged := false }) only at hb
            have hyP : ((jumps kops)[id]).y < P := by omega
            have hzP : ((jumps kops)[id]).z < P := by omega
            set ℓ := sepScale S P L ((jumps kops)[id]).x ((jumps kops)[id]).y
            have hy_lo := (h_block_bounds_of ℓ hℓL _ hyP).1
            have hidx_yz : blockIdx S P ℓ ((jumps kops)[id]).y =
                blockIdx S P ℓ ((jumps kops)[id]).z :=
              (hpart.blocks_eq_iff ℓ hℓL _ hyP _ hzP).mpr ⟨by omega, hz_lt⟩
            have hsep_yz : ℓ < sepScale S P L ((jumps kops)[id]).y ((jumps kops)[id]).z :=
              (hpart.sep_gt_iff ℓ hℓL _ hyP _ hzP).mpr hidx_yz
            dsimp (config := { failIfUnchanged := false }) only [phi]
            rw [hpi_x, hpi_y, if_pos ⟨hℓ1, hℓL, hsep_yz⟩]
          · exact Nat.zero_le _

        have h_movers_combined :
            b3t t + Jt.sum (fun id => phi (t + 1) (mu id)) ≤
              Jt.sum (fun id => phi t (mu id)) + 1 + eentert t := by
          have hb3_boole : b3t t = Jt.sum (fun id => if id ∈ B_3_intra S P L kops then 1 else 0) := by
            rw [hb3t_eq]
            symm
            simpa only [Nat.cast_id] using
              (Finset.sum_boole (R := ℕ) (fun id => id ∈ B_3_intra S P L kops) Jt)
          have he_boole : eentert t = Jt.sum (fun id => if id ∈ E_enter then 1 else 0) := by
            rw [heentert_eq]
            symm
            simpa only [Nat.cast_id] using
              (Finset.sum_boole (R := ℕ) (fun id => id ∈ E_enter) Jt)
          rw [hb3_boole, he_boole]
          rcases hm_cases : m with _ | m'
          · have hJt_emp : Jt = ∅ := by
              simp only [Jt, hm_cases, Nat.add_zero, Finset.Ico_self]
            simp [hJt_emp]
          · let Jlow : Finset ℕ := Finset.Ico baseId (baseId + m')
            have hJt_ins : Jt = insert (baseId + m') Jlow := by
              ext id
              simp only [Jt, Jlow, hm_cases, Finset.mem_insert, Finset.mem_Ico]
              omega
            have hnot_mem : baseId + m' ∉ Jlow := by
              simp only [Jlow, Finset.mem_Ico]; omega
            have htop_Jt : baseId + m' ∈ Jt := by
              rw [hJt_ins]; exact Finset.mem_insert_self _ _
            have htop_pre := h_precancel (baseId + m') htop_Jt
            have htop_post := h_phi_le_one (t + 1) (mu (baseId + m'))
            have h_low_item : ∀ id ∈ Jlow,
                (if id ∈ B_3_intra S P L kops then 1 else 0) + phi (t + 1) (mu id) ≤
                  phi t (mu id) + (if id ∈ E_enter then 1 else 0) := by
              intro id hid_low
              have hico_low := Finset.mem_Ico.mp hid_low
              have hid_Jt : id ∈ Jt := by rw [hJt_ins]; exact Finset.mem_insert_of_mem hid_low
              have hid1_Jt : id + 1 ∈ Jt := by
                simp only [Jt, hm_cases, Finset.mem_Ico]; omega
              have hpre_id := h_precancel id hid_Jt
              by_cases hp1_one : phi (t + 1) (mu id) = 0
              · rw [hp1_one]; omega
              · have hp1_pos : phi (t + 1) (mu id) = 1 := by
                  have hle1 := h_phi_le_one (t + 1) (mu id); omega
                by_cases hid_b1s : id ∈ B_1 S P L kops \ S_1
                · have hb1_mem : id ∈ B_1 S P L kops := (Finset.mem_sdiff.mp hid_b1s).1
                  obtain ⟨hid_lt, _, hz_lt_ℓ1, _⟩ := h_b1_step_out id hid_b1s
                  have hnot_b3 : id ∉ B_3_intra S P L kops := by
                    intro hb3
                    simp only [B_1, B_3_intra, Finset.mem_filter, isB1, isB3Intra,
                      List.getElem?_eq_getElem hid_lt, decide_eq_true_eq] at hb1_mem hb3
                    omega
                  obtain ⟨_, hst⟩ := (h_Jt_mem id).mp hid_Jt
                  obtain ⟨hlcrs_x, hlcrs_y, _⟩ := hfold.jump_lcrs id hid_lt
                  rw [hst] at hlcrs_x hlcrs_y
                  have hb := h_jump_bounds id hid_lt
                  dsimp (config := { failIfUnchanged := false }) only at hb
                  have hyP : ((jumps kops)[id]).y < P := by omega
                  have hzP : ((jumps kops)[id]).z < P := by omega
                  simp only [B_1, Finset.mem_filter, isB1,
                    List.getElem?_eq_getElem hid_lt, decide_eq_true_eq] at hb1_mem
                  obtain ⟨_, hℓ1_lo, hℓ1_hi, _⟩ := hb1_mem
                  set ℓ := sepScale S P L ((jumps kops)[id]).x ((jumps kops)[id]).y
                  have hy_lo := (h_block_bounds_of ℓ hℓ1_hi _ hyP).1
                  have hidx_yz : blockIdx S P ℓ ((jumps kops)[id]).y =
                      blockIdx S P ℓ ((jumps kops)[id]).z :=
                    (hpart.blocks_eq_iff ℓ hℓ1_hi _ hyP _ hzP).mpr ⟨by omega, hz_lt_ℓ1⟩
                  have hsep_yz : ℓ < sepScale S P L ((jumps kops)[id]).y ((jumps kops)[id]).z :=
                    (hpart.sep_gt_iff ℓ hℓ1_hi _ hyP _ hzP).mpr hidx_yz
                  have hphi0_one : phi t (mu id) = 1 := by
                    simp only [mu, List.getD_eq_getElem _ _ hid_lt]
                    dsimp (config := { failIfUnchanged := false }) only [phi, pi]
                    rw [hlcrs_x, hlcrs_y, if_pos ⟨hℓ1_lo, hℓ1_hi, hsep_yz⟩]
                  rw [if_neg hnot_b3, hp1_pos, hphi0_one]
                  omega
                · obtain ⟨hid, hst⟩ := (h_Jt_mem id).mp hid_Jt
                  obtain ⟨hid1, hst1⟩ := (h_Jt_mem (id + 1)).mp hid1_Jt
                  obtain ⟨hjm, _⟩ := h_adj_step id hid1 (hst.trans hst1.symm)
                  obtain ⟨_, _, hs_eq, _, _, hx_eq⟩ := h_jump_succ id hid hjm
                  obtain ⟨_, _, hlcrs_x1⟩ := hfold.jump_lcrs id hid
                  obtain ⟨_, _, hlcrs_z1⟩ := hfold.jump_lcrs (id + 1) hid1
                  rw [hst] at hlcrs_x1
                  rw [hst1, hx_eq] at hlcrs_z1
                  have hp1_cond :
                      1 ≤ sepScale S P L ((jumps kops)[id]).x ((jumps kops)[id]).z ∧
                      sepScale S P L ((jumps kops)[id]).x ((jumps kops)[id]).z ≤ L ∧
                      sepScale S P L ((jumps kops)[id]).x ((jumps kops)[id]).z <
                        sepScale S P L ((jumps kops)[id]).z ((jumps kops)[id + 1]).z := by
                    dsimp (config := { failIfUnchanged := false }) only [phi, mu] at hp1_pos
                    rw [List.getD_eq_getElem _ _ hid] at hp1_pos
                    dsimp (config := { failIfUnchanged := false }) only [pi] at hp1_pos
                    rw [hlcrs_x1, hlcrs_z1] at hp1_pos
                    split_ifs at hp1_pos with hc
                    exact hc
                  obtain ⟨hℓ1_lo, hℓ1_hi, hsep_gt⟩ := hp1_cond
                  have hb := h_jump_bounds id hid
                  have hb1 := h_jump_bounds (id + 1) hid1
                  dsimp (config := { failIfUnchanged := false }) only at hb hb1
                  set ℓ1 := sepScale S P L ((jumps kops)[id]).x ((jumps kops)[id]).z
                  set ℓ' := sepScale S P L ((jumps kops)[id + 1]).x ((jumps kops)[id + 1]).y
                  have hult1 := hpart.sep_ultrametric ((jumps kops)[id]).z
                    ((jumps kops)[id + 1]).y ((jumps kops)[id + 1]).z
                    (by omega) (by omega) (by omega)
                  have hℓ'_gt : ℓ1 < ℓ' := by
                    dsimp (config := { failIfUnchanged := false }) only [ℓ']
                    rw [hx_eq]
                    rw [hult1] at hsep_gt
                    exact lt_of_lt_of_le hsep_gt (Nat.min_le_left _ _)
                  have hult2 := hpart.sep_ultrametric ((jumps kops)[id]).s
                    ((jumps kops)[id]).x ((jumps kops)[id]).z
                    (by omega) (by omega) (by omega)
                  have hsx'_le : sepScale S P L ((jumps kops)[id + 1]).s
                      ((jumps kops)[id + 1]).x ≤ ℓ1 := by
                    rw [hs_eq, hx_eq, hult2]
                    exact Nat.min_le_right _ _
                  have hℓ'_rng := hpart.sep_range ((jumps kops)[id + 1]).x (by omega)
                    ((jumps kops)[id + 1]).y (by omega) (by omega)
                  have hid1_pre : id + 1 ∈ B_pre_all := by
                    by_cases hℓ'_L : ℓ' ≤ L
                    · refine Finset.mem_union_left _ ?_
                      simp only [B_1, Finset.mem_filter, Finset.mem_range, isB1,
                        List.getElem?_eq_getElem hid1, decide_eq_true_eq]
                      exact ⟨hid1, by omega, hℓ'_L, by omega⟩
                    · have hℓ'_eq : ℓ' = L + 1 := by omega
                      refine Finset.mem_union_right _ ?_
                      have hne_L : blockIdx S P L ((jumps kops)[id + 1]).s ≠
                          blockIdx S P L ((jumps kops)[id + 1]).x := by
                        intro heq
                        have := (hpart.sep_gt_iff L le_rfl _ (by omega) _ (by omega)).mpr heq
                        omega
                      have hs_lt_bo := (h_block_disj L le_rfl _ _ hb1.2.2.1 (by omega) hne_L).1
                      simp only [B_fin_pre, Finset.mem_filter, Finset.mem_range, isBFinPre,
                        List.getElem?_eq_getElem hid1, decide_eq_true_eq]
                      exact ⟨hid1, hℓ'_eq, hs_lt_bo⟩
                  have hid_enter : id ∈ E_enter := by
                    refine Finset.mem_filter.mpr ⟨Finset.mem_range.mpr hid, hid_b1s, ?_, hid1_pre⟩
                    rw [List.getD_eq_getElem _ _ hid]
                    exact hjm
                  rw [if_pos hid_enter, hp1_pos]
                  omega
            have h_sum_low := Finset.sum_le_sum h_low_item
            rw [Finset.sum_add_distrib, Finset.sum_add_distrib] at h_sum_low
            rw [hJt_ins, Finset.sum_insert hnot_mem, Finset.sum_insert hnot_mem,
              Finset.sum_insert hnot_mem, Finset.sum_insert hnot_mem]
            omega

        have hMt_sum0 : Mt.sum (fun v => phi t v) = Jt.sum (fun id => phi t (mu id)) :=
          Finset.sum_image h_mu_inj
        have hMt_sum1 : Mt.sum (fun v => phi (t + 1) v) = Jt.sum (fun id => phi (t + 1) (mu id)) :=
          Finset.sum_image h_mu_inj
        have hsdiff1 : (V (t + 1) \ Mt).sum (fun v => phi (t + 1) v) +
            Mt.sum (fun v => phi (t + 1) v) = Phi (t + 1) :=
          Finset.sum_sdiff h_Mt_sub
        have hsdiff0 : (V (t + 1) \ Mt).sum (fun v => phi t v) +
            Mt.sum (fun v => phi t v) = (V (t + 1)).sum (fun v => phi t v) :=
          Finset.sum_sdiff h_Mt_sub
        have hsdiff_le : (V (t + 1) \ Mt).sum (fun v => phi (t + 1) v) ≤
            (V (t + 1) \ Mt).sum (fun v => phi t v) :=
          Finset.sum_le_sum h_nonmover
        have hVt1_le : (V (t + 1)).sum (fun v => phi t v) ≤ Phi t :=
          Finset.sum_le_sum_of_subset hV_sub
        omega

      · obtain ⟨hb3_0, he_0⟩ := h_no_jumps_nonpop t ht (by simp [hop])
        have hV_next : V (t + 1) = V t := by
          ext v
          simp only [h_V_iff t (by omega) v, h_V_iff (t + 1) (by omega) v]
          by_cases hvP : v < P
          · have hne_b : birthStep kops v ≠ t := by
              intro hb
              have hpush := (h_birth_eq t ht v hvP).mp hb
              rw [hop] at hpush; cases hpush
            have hne_p : popStep kops v ≠ t := by
              intro hp
              have hpop := (h_pop_eq t ht v hvP).mp hp
              rw [hop] at hpop; cases hpop
            omega
          · omega
        rcases d0 with _ | d
        · have hf_eq := hfold.fold_step_rslr_zero t ht hop
          have hPhi_eq : Phi (t + 1) = Phi t := by
            dsimp (config := { failIfUnchanged := false }) only [Phi]; rw [hV_next]
            refine Finset.sum_congr rfl ?_
            intro v _; dsimp (config := { failIfUnchanged := false }) only [phi, pi]; rw [hf_eq]
          omega
        · obtain ⟨hu_in, hp_in, hup, _, hpi_u0, hpi_u1, hpi_other⟩ :=
            hfold.fold_step_rslr_succ t ht d hop
          set rs := rightSpineTopDownNat (keyedState kops t)
          set u := rs.getD d 0
          set p := rs.getD (d + 1) 0
          have hu_Vt : u ∈ V t := List.mem_toFinset.mpr hu_in
          have herase_le : ((V t).erase u).sum (fun v => phi (t + 1) v) ≤
              ((V t).erase u).sum (fun v => phi t v) := by
            refine Finset.sum_le_sum ?_
            intro v hv_er
            obtain ⟨hv_ne_u, _⟩ := Finset.mem_erase.mp hv_er
            have hpi_v : pi (t + 1) v = pi t v := hpi_other v hv_ne_u
            dsimp (config := { failIfUnchanged := false }) only [phi]
            split_ifs with hc1 hc0
            · rfl
            · exfalso
              apply hc0
              rw [hpi_v] at hc1
              obtain ⟨h1_le, hL_ge, hgt⟩ := hc1
              refine ⟨h1_le, hL_ge, ?_⟩
              by_cases hpv_u : pi t v = u
              · rw [hpv_u] at h1_le hgt ⊢
                have hpi1_u : pi (t + 1) u = pi t p := hpi_u1
                have hpi0_u : pi t u = p := hpi_u0
                rw [hpi1_u] at hgt; rw [hpi0_u]
                set q := pi t p
                have hp_lt_q : p < q := (hfold.lcrs_bounds t (by omega) p hp_in).1
                have hq_le_P : q ≤ P := (hfold.lcrs_bounds t (by omega) p hp_in).2.1
                have hq_ne_P : q ≠ P := by
                  intro hqP; rw [hqP, (hpart.sep_top u).1] at hgt; omega
                have hult := hpart.sep_ultrametric u p q (by omega) (by omega) (by omega)
                rw [hult] at hgt
                exact lt_of_lt_of_le hgt (Nat.min_le_left _ _)
              · have hpi2 : pi (t + 1) (pi t v) = pi t (pi t v) := hpi_other (pi t v) hpv_u
                rw [hpi2] at hgt; exact hgt
            · exact Nat.zero_le _
            · exact le_rfl
          have hPhi1_split : phi (t + 1) u + ((V t).erase u).sum (fun v => phi (t + 1) v) =
              Phi (t + 1) := by
            dsimp (config := { failIfUnchanged := false }) only [Phi]; rw [hV_next]
            exact Finset.add_sum_erase (V t) (fun v => phi (t + 1) v) hu_Vt
          have hPhi0_split : phi t u + ((V t).erase u).sum (fun v => phi t v) = Phi t :=
            Finset.add_sum_erase (V t) (fun v => phi t v) hu_Vt
          have hphi_u := h_phi_le_one (t + 1) u
          omega

    have h_telescope : ∀ N ≤ kops.length,
        (Finset.range N).sum b3t + Phi N ≤ Phi 0 + N + (Finset.range N).sum eentert := by
      intro N
      induction N with
      | zero => simp
      | succ N ih =>
        intro hN
        have hrec := ih (by omega)
        have hst := h_step_bound N (by omega)
        rw [Finset.sum_range_succ, Finset.sum_range_succ]
        dsimp (config := { failIfUnchanged := false }) only [b3t, eentert] at hrec hst ⊢
        omega

    have hPhi0 : Phi 0 = 0 := by
      have h0 : keyedState kops 0 = .nil := rfl
      simp [Phi, V, h0, inorderNat]
    have hPhi_end : Phi kops.length = 0 := by
      simp [Phi, V, hkvalid.end_empty, inorderNat]

    have h_fiber_card : ∀ A : Finset ℕ, A ⊆ Finset.range (jumps kops).length →
        A.card = (Finset.range kops.length).sum
          (fun t => (A.filter (fun id => ((jumps kops).getD id default).step = t)).card) := by
      intro A hsub
      refine Finset.card_eq_sum_card_fiberwise ?_
      intro id hid
      have hlt : id < (jumps kops).length := Finset.mem_range.mp (hsub (Finset.mem_coe.mp hid))
      dsimp (config := { failIfUnchanged := false }) only
      rw [Finset.mem_coe, Finset.mem_range, List.getD_eq_getElem _ _ hlt]
      exact (h_jump_bounds id hlt).1

    have hb3_tot : (B_3_intra S P L kops).card = (Finset.range kops.length).sum b3t :=
      h_fiber_card _ (fun _ hid => (Finset.mem_filter.mp hid).1)
    have he_tot : E_enter.card = (Finset.range kops.length).sum eentert :=
      h_fiber_card _ (fun _ hid => (Finset.mem_filter.mp hid).1)
    have htel := h_telescope kops.length le_rfl
    omega

  -- =========================================================================
  -- Conjunct 6: `(B_2 S P L kops).card ≤ P + r * (5 * P + B_3_intra + B_3_post + B_3_act)`
  -- =========================================================================
  let pC1 : ℕ → Prop := fun id =>
    ((jumps kops).getD id default).x < (blockOf S P L ((jumps kops).getD id default).s).2
  let C1 := (B_2 S P L kops).filter pC1
  let B2_main := (B_2 S P L kops).filter (fun id => ¬pC1 id)

  have hB2_split_C1 : (B_2 S P L kops).card = C1.card + B2_main.card :=
    (Finset.card_filter_add_card_filter_not (s := B_2 S P L kops) pC1).symm

  have hC1_le : C1.card ≤ P := by
    have hle := h_card_inj C1 (Finset.range P)
      (fun id => ((jumps kops).getD id default).s)
      (fun id hid => by
        obtain ⟨hb2, _⟩ := Finset.mem_filter.mp hid
        have hlt : id < (jumps kops).length := Finset.mem_range.mp (Finset.mem_filter.mp hb2).1
        dsimp (config := { failIfUnchanged := false }) only
        rw [List.getD_eq_getElem _ _ hlt, Finset.mem_range]
        have hb := h_jump_bounds id hlt
        dsimp (config := { failIfUnchanged := false }) only at hb; omega)
      (fun id1 hid1 id2 hid2 hlt heq => by
        obtain ⟨hb2_1, _⟩ := Finset.mem_filter.mp hid1
        obtain ⟨hb2_2, hc1_2⟩ := Finset.mem_filter.mp hid2
        simp only [B_2, Finset.mem_filter, Finset.mem_range, isB2] at hb2_1 hb2_2
        obtain ⟨h1_lt, his1⟩ := hb2_1
        obtain ⟨h2_lt, _⟩ := hb2_2
        rw [List.getElem?_eq_getElem h1_lt, decide_eq_true_eq] at his1
        obtain ⟨_, hℓL, hsep_sx1⟩ := his1
        simp only [pC1, List.getD_eq_getElem _ _ h1_lt, List.getD_eq_getElem _ _ h2_lt]
          at hc1_2 heq
        have hb1 := h_jump_bounds id1 h1_lt
        dsimp (config := { failIfUnchanged := false }) only at hb1
        set e1 := (jumps kops)[id1]
        set ℓ := sepScale S P L e1.x e1.y
        have hs1P : e1.s < P := by omega
        have hx1P : e1.x < P := by omega
        have hy1P : e1.y < P := by omega
        have hidx_sx : blockIdx S P ℓ e1.s = blockIdx S P ℓ e1.x :=
          (hpart.sep_gt_iff ℓ hℓL e1.s hs1P e1.x hx1P).mp hsep_sx1
        have hbo_sx : blockOf S P ℓ e1.x = blockOf S P ℓ e1.s := by simp only [blockOf, hidx_sx]
        have hne_xy : blockIdx S P ℓ e1.x ≠ blockIdx S P ℓ e1.y := by
          intro hsame
          have := (hpart.sep_gt_iff ℓ hℓL e1.x hx1P e1.y hy1P).mpr hsame
          omega
        have hy1_lo : (blockOf S P ℓ e1.s).2 ≤ e1.y := by
          rw [← hbo_sx]
          exact (h_block_disj ℓ hℓL e1.x e1.y hb1.2.2.2.1 hy1P hne_xy).2
        have hnest_L := (h_block_nest ℓ L hℓL le_rfl e1.s hs1P).2
        have hst1 := h_jump_popStep id1 h1_lt
        have hst2 := h_jump_popStep id2 h2_lt
        rw [heq] at hst1
        have hchain := h_same_step id1 h1_lt id2 h2_lt hlt (hst1.symm.trans hst2)
        rw [← heq] at hc1_2
        dsimp (config := { failIfUnchanged := false }) only [e1, ℓ] at *
        omega)
    simpa only [Finset.card_range] using hle

  let b2Node (id : ℕ) : Fin r × List ℕ × ℕ :=
    let e := (jumps kops).getD id default
    let ℓ1 := sepScale S P L e.x e.y
    let ℓ0 := sepScale S P L e.s e.x
    let d := lcaDepth ℓ1 ℓ0
    (d, addrPref d.val ℓ1, addr ℓ1 d)

  let b2MStar (id : ℕ) : ℕ :=
    let info := b2Node id
    mStar info.1 info.2.1

  let b2MLo (id : ℕ) : ℕ :=
    let info := b2Node id
    mLoChild info.1 info.2.1 info.2.2

  let b2MMid (id : ℕ) : ℕ :=
    let info := b2Node id
    mHiChild info.1 info.2.1 info.2.2

  have h_b2_shell_omega : ∀ id ∈ B2_main,
      ∃ hid : id < (jumps kops).length,
        let e := (jumps kops)[id]
        let ℓ1 := sepScale S P L e.x e.y
        let ℓ0 := sepScale S P L e.s e.x
        let info := b2Node id
        let d := info.1
        let p := info.2.1
        let c1 := info.2.2
        let mlo := b2MLo id
        let mmid := b2MMid id
        let ms := b2MStar id
        let Qs := blockOf S P ms e.s
        let Bm := blockOf S P mmid e.s
        let Bp := blockOf S P mlo e.s
        1 ≤ ℓ1 ∧ ℓ1 < ℓ0 ∧ ℓ0 ≤ ms ∧ ms ≤ L ∧
          d = lcaDepth ℓ1 ℓ0 ∧ addrPref d.val ℓ1 = p ∧ addr ℓ1 d = c1 ∧
          1 ≤ mFirstChild d p c1 ∧ mFirstChild d p c1 ≤ ℓ1 ∧
          mlo ≤ ℓ1 - 1 ∧ ℓ1 ≤ mmid ∧ mmid < ℓ0 ∧
          (d, p) ∈ ActiveNodes ∧ 1 ≤ c1 ∧ c1 ≤ kNode d p ∧
          blockIdx S P ms e.s < (scaleBlocks S P ms).length ∧
          Bp.1 ≤ e.s ∧ e.s < Qs.2 ∧ Qs.2 ≤ e.x ∧
          e.x < Bm.2 ∧ Bm.2 ≤ e.y ∧ e.y < Bp.2 := by
    intro id hid
    obtain ⟨hb2, hnot_c1⟩ := Finset.mem_filter.mp hid
    simp only [B_2, Finset.mem_filter, Finset.mem_range, isB2] at hb2
    obtain ⟨hlt, his⟩ := hb2
    refine ⟨hlt, ?_⟩
    rw [List.getElem?_eq_getElem hlt, decide_eq_true_eq] at his
    obtain ⟨hℓ1_1, hℓ1_L, hsep_sx⟩ := his
    simp only [pC1, List.getD_eq_getElem _ _ hlt] at hnot_c1
    have hb := h_jump_bounds id hlt
    dsimp (config := { failIfUnchanged := false }) only at hb
    set e := (jumps kops)[id]
    set ℓ1 := sepScale S P L e.x e.y
    set ℓ0 := sepScale S P L e.s e.x
    have hsP : e.s < P := by omega
    have hxP : e.x < P := by omega
    have hyP : e.y < P := by omega
    have hℓ0_L : ℓ0 ≤ L := by
      have hrng := hpart.sep_range e.s hsP e.x hxP (by omega)
      by_contra hgt
      have hL_lt : L < ℓ0 := by omega
      have hidxL := (hpart.sep_gt_iff L le_rfl e.s hsP e.x hxP).mp hL_lt
      have hx_lt_L := ((hpart.blocks_eq_iff L le_rfl e.s hsP e.x hxP).mp hidxL).2
      exact hnot_c1 hx_lt_L
    have h_info : b2Node id =
        (lcaDepth ℓ1 ℓ0, addrPref (lcaDepth ℓ1 ℓ0).val ℓ1, addr ℓ1 (lcaDepth ℓ1 ℓ0)) := by
      simp only [b2Node, List.getD_eq_getElem _ _ hlt, e, ℓ1, ℓ0]
    set d := lcaDepth ℓ1 ℓ0
    set p := addrPref d.val ℓ1
    set c1 := addr ℓ1 d
    obtain ⟨hpref_10, _, hc1_lt_0⟩ := h_lca_spec ℓ1 ℓ0 hℓ1_1 hsep_sx hℓ0_L
    obtain ⟨hact, _, hms_L, _, _, hc1_1, hc1_k⟩ := h_mStar_props d p ℓ1 hℓ1_1 hℓ1_L rfl
    obtain ⟨_, _, _, _, hℓ0_ms, _, _⟩ := h_mStar_props d p ℓ0 (by omega) hℓ0_L hpref_10.symm
    obtain ⟨hf1, hf_le_ℓ1, hmlo_le, hℓ1_mmid, _, _, hmmid_lt, _⟩ :=
      h_child_bounds d p c1 ℓ1 hℓ1_1 hℓ1_L rfl rfl
    have hmmid_lt_0 : mHiChild d p c1 < ℓ0 :=
      hmmid_lt ℓ0 (by omega) hℓ0_L hpref_10.symm hc1_lt_0
    have hms_eq : b2MStar id = mStar d p := by dsimp (config := { failIfUnchanged := false }) only [b2MStar]; rw [h_info]
    have hmlo_eq : b2MLo id = mLoChild d p c1 := by dsimp (config := { failIfUnchanged := false }) only [b2MLo]; rw [h_info]
    have hmmid_eq : b2MMid id = mHiChild d p c1 := by dsimp (config := { failIfUnchanged := false }) only [b2MMid]; rw [h_info]
    set mlo := mLoChild d p c1
    set mmid := mHiChild d p c1
    set ms := mStar d p
    have hmlo_L : mlo ≤ L := by omega
    have hmmid_L : mmid ≤ L := by omega
    -- At `ms`: `ℓ0 ≤ ms`, so `e.s` and `e.x` are separated at `ℓ0`, hence `(blockOf ms s).2 ≤ x`
    have hne_ℓ0_sx : blockIdx S P ℓ0 e.s ≠ blockIdx S P ℓ0 e.x := by
      intro heq
      have := (hpart.sep_gt_iff ℓ0 hℓ0_L e.s hsP e.x hxP).mpr heq
      omega
    have hs_hi_ℓ0 : (blockOf S P ℓ0 e.s).2 ≤ e.x :=
      (h_block_disj ℓ0 hℓ0_L e.s e.x hb.2.2.1 hxP hne_ℓ0_sx).2
    have hnest_ℓ0_ms := (h_block_nest ℓ0 ms hℓ0_ms hms_L e.s hsP).2
    obtain ⟨_, hqs_hi, _, hqs_idx⟩ := h_block_bounds_of ms hms_L e.s hsP
    -- At `mmid`: `ℓ1 ≤ mmid < ℓ0`, so `e.x < (blockOf mmid s).2 ≤ e.y`
    have hidx_mmid_sx : blockIdx S P mmid e.s = blockIdx S P mmid e.x :=
      (hpart.sep_gt_iff mmid hmmid_L e.s hsP e.x hxP).mp hmmid_lt_0
    have hbo_mmid_sx : blockOf S P mmid e.x = blockOf S P mmid e.s := by
      simp only [blockOf, hidx_mmid_sx]
    have hx_lt_bm : e.x < (blockOf S P mmid e.s).2 :=
      ((hpart.blocks_eq_iff mmid hmmid_L e.s hsP e.x hxP).mp hidx_mmid_sx).2
    have hne_mmid_xy : blockIdx S P mmid e.x ≠ blockIdx S P mmid e.y := by
      intro heq
      have := (hpart.sep_gt_iff mmid hmmid_L e.x hxP e.y hyP).mpr heq
      omega
    have hy_ge_bm : (blockOf S P mmid e.s).2 ≤ e.y := by
      rw [← hbo_mmid_sx]
      exact (h_block_disj mmid hmmid_L e.x e.y hb.2.2.2.1 hyP hne_mmid_xy).2
    -- At `mlo`: `mlo ≤ ℓ1 - 1 < ℓ1 < ℓ0`, so `e.y < (blockOf mlo s).2`
    have hidx_mlo_sx : blockIdx S P mlo e.s = blockIdx S P mlo e.x :=
      (hpart.sep_gt_iff mlo hmlo_L e.s hsP e.x hxP).mp (by omega)
    have hidx_mlo_xy : blockIdx S P mlo e.x = blockIdx S P mlo e.y :=
      (hpart.sep_gt_iff mlo hmlo_L e.x hxP e.y hyP).mp (by omega)
    have hy_lt_bp : e.y < (blockOf S P mlo e.s).2 :=
      ((hpart.blocks_eq_iff mlo hmlo_L e.s hsP e.y hyP).mp (hidx_mlo_sx.trans hidx_mlo_xy)).2
    have hbp_lo := (h_block_bounds_of mlo hmlo_L e.s hsP).1
    dsimp (config := { failIfUnchanged := false }) only
    rw [h_info, hms_eq, hmlo_eq, hmmid_eq]
    exact ⟨hℓ1_1, hsep_sx, hℓ0_ms, hms_L, rfl, rfl, rfl, hf1, hf_le_ℓ1, hmlo_le, hℓ1_mmid,
      hmmid_lt_0, hact, hc1_1, hc1_k, hqs_idx, hbp_lo, hqs_hi, by omega,
      hx_lt_bm, hy_ge_bm, hy_lt_bp⟩

  let C2A := B2_main.filter (fun id =>
    (blockOf S P (b2MLo id) ((jumps kops).getD id default).s).2 ≤
      ((jumps kops).getD id default).z)
  let R2_b2 := B2_main.filter (fun id =>
    ¬((blockOf S P (b2MLo id) ((jumps kops).getD id default).s).2 ≤
      ((jumps kops).getD id default).z))
  let C2B1 := R2_b2.filter (fun id =>
    ¬(((jumps kops).getD id default).j + 1 < ((jumps kops).getD id default).m))
  let R3_b2 := R2_b2.filter (fun id =>
    ((jumps kops).getD id default).j + 1 < ((jumps kops).getD id default).m)
  let C2B2a := R3_b2.filter (fun id =>
    (blockOf S P (b2MLo id) ((jumps kops).getD id default).s).2 ≤
      ((jumps kops).getD (id + 1) default).y)
  let S_2 : Finset ℕ := C2A ∪ C2B1 ∪ C2B2a

  let b2CapMap (id : ℕ) : Fin r × List ℕ × ℕ × ℕ :=
    let info := b2Node id
    (info.1, info.2.1, info.2.2,
      blockIdx S P (b2MStar id) ((jumps kops).getD id default).s)

  have h_b2Cap_mem : ∀ id ∈ B2_main, b2CapMap id ∈ CapSet := by
    intro id hid
    obtain ⟨hlt, _, _, _, _, _, _, _, _, _, _, _, _, hact, hc1, hck, hq_idx, _, _, _, _, _, _⟩ :=
      h_b2_shell_omega id hid
    dsimp (config := { failIfUnchanged := false }) only [b2CapMap, CapSet, b2MStar]
    rw [List.getD_eq_getElem _ _ hlt]
    refine Finset.mem_biUnion.mpr ⟨((b2Node id).1, (b2Node id).2.1), hact, ?_⟩
    refine Finset.mem_image.mpr ⟨((b2Node id).2.2,
      blockIdx S P (mStar (b2Node id).1 (b2Node id).2.1) ((jumps kops)[id]).s), ?_, rfl⟩
    exact Finset.mem_product.mpr ⟨Finset.mem_Icc.mpr ⟨hc1, hck⟩, Finset.mem_range.mpr hq_idx⟩

  have hC2A_le : C2A.card ≤ CapSet.card := by
    refine h_card_inj C2A CapSet b2CapMap
      (fun id hid => h_b2Cap_mem id (Finset.mem_filter.mp hid).1)
      (fun id1 hid1 id2 hid2 hlt heq => by
        obtain ⟨hm1, hc2a_1⟩ := Finset.mem_filter.mp hid1
        obtain ⟨hm2, _⟩ := Finset.mem_filter.mp hid2
        obtain ⟨h1_lt, _, _, _, hms1_L, _, _, _, _, _, _, _, _, _, _, _, _,
          _, _, hqs1_le_x, hx1_lt_bm, _, _⟩ := h_b2_shell_omega id1 hm1
        obtain ⟨h2_lt, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _,
          _, hs2_lt_qs, _, _, hy2_ge_bm, hy2_lt_bp⟩ := h_b2_shell_omega id2 hm2
        dsimp (config := { failIfUnchanged := false }) only [b2CapMap] at heq
        rw [List.getD_eq_getElem _ _ h1_lt, List.getD_eq_getElem _ _ h2_lt] at heq
        rw [List.getD_eq_getElem _ _ h1_lt] at hc2a_1
        have hd_eq : (b2Node id1).1 = (b2Node id2).1 := (Prod.mk.inj heq).1
        have hp_eq : (b2Node id1).2.1 = (b2Node id2).2.1 := (Prod.mk.inj (Prod.mk.inj heq).2).1
        have hc_eq : (b2Node id1).2.2 = (b2Node id2).2.2 :=
          (Prod.mk.inj (Prod.mk.inj (Prod.mk.inj heq).2).2).1
        have hq_eq : blockIdx S P (b2MStar id1) ((jumps kops)[id1]).s =
            blockIdx S P (b2MStar id2) ((jumps kops)[id2]).s :=
          (Prod.mk.inj (Prod.mk.inj (Prod.mk.inj heq).2).2).2
        have hms_eq : b2MStar id1 = b2MStar id2 := by dsimp (config := { failIfUnchanged := false }) only [b2MStar]; rw [hd_eq, hp_eq]
        have hmmid_eq : b2MMid id1 = b2MMid id2 := by
          dsimp (config := { failIfUnchanged := false }) only [b2MMid]; rw [hd_eq, hp_eq, hc_eq]
        have hmlo_eq : b2MLo id1 = b2MLo id2 := by
          dsimp (config := { failIfUnchanged := false }) only [b2MLo]; rw [hd_eq, hp_eq, hc_eq]
        rw [← hms_eq] at hq_eq hs2_lt_qs
        rw [← hmmid_eq] at hy2_ge_bm
        rw [← hmlo_eq] at hy2_lt_bp
        have hb_j1 := h_jump_bounds id1 h1_lt
        have hb_j2 := h_jump_bounds id2 h2_lt
        dsimp (config := { failIfUnchanged := false }) only at hb_j1 hb_j2
        have h_le1 : b2MMid id1 ≤ b2MStar id1 := by
          obtain ⟨_, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _⟩ := h_b2_shell_omega id1 hm1
          omega
        have h_le2 : b2MLo id1 ≤ b2MStar id1 := by
          obtain ⟨_, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _⟩ := h_b2_shell_omega id1 hm1
          omega
        have hQs_eq : blockOf S P (b2MStar id1) ((jumps kops)[id1]).s =
            blockOf S P (b2MStar id1) ((jumps kops)[id2]).s := by
          simp only [blockOf, hq_eq]
        have hBm_eq : blockOf S P (b2MMid id1) ((jumps kops)[id1]).s =
            blockOf S P (b2MMid id1) ((jumps kops)[id2]).s :=
          (h_anc_eq_of _ (b2MStar id1) h_le1 hms1_L _ (by omega) _ (by omega) hq_eq).2
        have hBp_eq : blockOf S P (b2MLo id1) ((jumps kops)[id1]).s =
            blockOf S P (b2MLo id1) ((jumps kops)[id2]).s :=
          (h_anc_eq_of _ (b2MStar id1) h_le2 hms1_L _ (by omega) _ (by omega) hq_eq).2
        rcases hjump.jump_order id1 h1_lt id2 h2_lt hlt with hst_lt | ⟨hst_eq, _⟩
        · rw [hQs_eq] at hqs1_le_x
          rw [hBm_eq] at hx1_lt_bm
          rw [hBp_eq] at hc2a_1
          have hy2_ls := (h_jump_ls id2 h2_lt).2.1
          exact h_lock_contra id1 h1_lt id2 h2_lt hst_lt (by omega)
            ((jumps kops)[id2]).y hy2_ls (by omega) (by omega)
        · have hchain := h_same_step id1 h1_lt id2 h2_lt hlt hst_eq
          rw [hBm_eq] at hx1_lt_bm
          rw [hBp_eq] at hc2a_1
          omega)

  have hC2B1_le : C2B1.card ≤ P := by
    have hle := h_card_inj C2B1 (Finset.range P)
      (fun id => ((jumps kops).getD id default).s)
      (fun id hid => by
        obtain ⟨hr2, _⟩ := Finset.mem_filter.mp hid
        obtain ⟨hm, _⟩ := Finset.mem_filter.mp hr2
        obtain ⟨hlt, _⟩ := h_b2_shell_omega id hm
        dsimp (config := { failIfUnchanged := false }) only
        rw [List.getD_eq_getElem _ _ hlt, Finset.mem_range]
        have hb := h_jump_bounds id hlt
        dsimp (config := { failIfUnchanged := false }) only at hb; omega)
      (fun id1 hid1 id2 hid2 hlt heq => by
        obtain ⟨hr2_1, hnot1⟩ := Finset.mem_filter.mp hid1
        obtain ⟨hm1, _⟩ := Finset.mem_filter.mp hr2_1
        obtain ⟨hr2_2, _⟩ := Finset.mem_filter.mp hid2
        obtain ⟨hm2, _⟩ := Finset.mem_filter.mp hr2_2
        obtain ⟨h1_lt, _⟩ := h_b2_shell_omega id1 hm1
        obtain ⟨h2_lt, _⟩ := h_b2_shell_omega id2 hm2
        simp only [List.getD_eq_getElem _ _ h1_lt, List.getD_eq_getElem _ _ h2_lt] at hnot1 heq
        exact h_last_jump_contra id1 h1_lt id2 h2_lt hlt heq hnot1)
    simpa only [Finset.card_range] using hle

  have hC2B2a_le : C2B2a.card ≤ CapSet.card := by
    refine h_card_inj C2B2a CapSet b2CapMap
      (fun id hid =>
        h_b2Cap_mem id (Finset.mem_filter.mp (Finset.mem_filter.mp (Finset.mem_filter.mp hid).1).1).1)
      (fun id1 hid1 id2 hid2 hlt heq => by
        obtain ⟨hr3_1, hnh1⟩ := Finset.mem_filter.mp hid1
        obtain ⟨hr2_1, hjm1⟩ := Finset.mem_filter.mp hr3_1
        obtain ⟨hm1, hnc2a_1⟩ := Finset.mem_filter.mp hr2_1
        obtain ⟨hr3_2, _⟩ := Finset.mem_filter.mp hid2
        obtain ⟨hr2_2, _⟩ := Finset.mem_filter.mp hr3_2
        obtain ⟨hm2, hnc2a_2⟩ := Finset.mem_filter.mp hr2_2
        obtain ⟨h1_lt, _, _, _, hms1_L, _, _, _, _, _, _, _, _, _, _, _, _,
          _, _, hqs1_le_x, hx1_lt_bm, hy1_ge_bm, _⟩ := h_b2_shell_omega id1 hm1
        obtain ⟨h2_lt, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _,
          _, hs2_lt_qs, _, _, hy2_ge_bm, hy2_lt_bp⟩ := h_b2_shell_omega id2 hm2
        rw [List.getD_eq_getElem _ _ h1_lt] at hjm1 hnc2a_1
        rw [List.getD_eq_getElem _ _ h2_lt] at hnc2a_2
        obtain ⟨h1_succ_lt, hst_s1, _, _, _, hx_s1⟩ := h_jump_succ id1 h1_lt hjm1
        rw [List.getD_eq_getElem _ _ h1_lt, List.getD_eq_getElem _ _ h1_succ_lt] at hnh1
        dsimp (config := { failIfUnchanged := false }) only [b2CapMap] at heq
        rw [List.getD_eq_getElem _ _ h1_lt, List.getD_eq_getElem _ _ h2_lt] at heq
        have hd_eq : (b2Node id1).1 = (b2Node id2).1 := (Prod.mk.inj heq).1
        have hp_eq : (b2Node id1).2.1 = (b2Node id2).2.1 := (Prod.mk.inj (Prod.mk.inj heq).2).1
        have hc_eq : (b2Node id1).2.2 = (b2Node id2).2.2 :=
          (Prod.mk.inj (Prod.mk.inj (Prod.mk.inj heq).2).2).1
        have hq_eq : blockIdx S P (b2MStar id1) ((jumps kops)[id1]).s =
            blockIdx S P (b2MStar id2) ((jumps kops)[id2]).s :=
          (Prod.mk.inj (Prod.mk.inj (Prod.mk.inj heq).2).2).2
        have hms_eq : b2MStar id1 = b2MStar id2 := by dsimp (config := { failIfUnchanged := false }) only [b2MStar]; rw [hd_eq, hp_eq]
        have hmmid_eq : b2MMid id1 = b2MMid id2 := by
          dsimp (config := { failIfUnchanged := false }) only [b2MMid]; rw [hd_eq, hp_eq, hc_eq]
        have hmlo_eq : b2MLo id1 = b2MLo id2 := by
          dsimp (config := { failIfUnchanged := false }) only [b2MLo]; rw [hd_eq, hp_eq, hc_eq]
        rw [← hms_eq] at hq_eq hs2_lt_qs
        rw [← hmmid_eq] at hy2_ge_bm
        rw [← hmlo_eq] at hy2_lt_bp hnc2a_2
        have hb_j1 := h_jump_bounds id1 h1_lt
        have hb_j1s := h_jump_bounds (id1 + 1) h1_succ_lt
        have hb_j2 := h_jump_bounds id2 h2_lt
        dsimp (config := { failIfUnchanged := false }) only at hb_j1 hb_j1s hb_j2
        have h_le1 : b2MMid id1 ≤ b2MStar id1 := by
          obtain ⟨_, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _⟩ := h_b2_shell_omega id1 hm1
          omega
        have h_le2 : b2MLo id1 ≤ b2MStar id1 := by
          obtain ⟨_, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _⟩ := h_b2_shell_omega id1 hm1
          omega
        have hQs_eq : blockOf S P (b2MStar id1) ((jumps kops)[id1]).s =
            blockOf S P (b2MStar id1) ((jumps kops)[id2]).s := by
          simp only [blockOf, hq_eq]
        have hBm_eq : blockOf S P (b2MMid id1) ((jumps kops)[id1]).s =
            blockOf S P (b2MMid id1) ((jumps kops)[id2]).s :=
          (h_anc_eq_of _ (b2MStar id1) h_le1 hms1_L _ (by omega) _ (by omega) hq_eq).2
        have hBp_eq : blockOf S P (b2MLo id1) ((jumps kops)[id1]).s =
            blockOf S P (b2MLo id1) ((jumps kops)[id2]).s :=
          (h_anc_eq_of _ (b2MStar id1) h_le2 hms1_L _ (by omega) _ (by omega) hq_eq).2
        rcases hjump.jump_order id1 h1_lt id2 h2_lt hlt with hst_lt | ⟨hst_eq, _⟩
        · rw [hQs_eq] at hqs1_le_x
          rw [hBm_eq] at hx1_lt_bm hy1_ge_bm
          rw [hBp_eq] at hnc2a_1 hnh1
          have hs2x1 : ((jumps kops)[id2]).s < ((jumps kops)[id1]).x := by omega
          have hs2x1s : ((jumps kops)[id2]).s < ((jumps kops)[id1 + 1]).x := by omega
          have hst_lt_s : ((jumps kops)[id1 + 1]).step < ((jumps kops)[id2]).step := by omega
          obtain ⟨_, hy2_ls, hz2_ls⟩ := h_jump_ls id2 h2_lt
          rcases lt_trichotomy ((jumps kops)[id2]).y ((jumps kops)[id1]).z with
            hy_lt | hy_eq | hy_gt
          · exact h_lock_contra id1 h1_lt id2 h2_lt hst_lt hs2x1
              ((jumps kops)[id2]).y hy2_ls (by omega) hy_lt
          · exact h_lock_contra (id1 + 1) h1_succ_lt id2 h2_lt hst_lt_s hs2x1s
              ((jumps kops)[id2]).z hz2_ls (by omega) (by omega)
          · exact h_lock_contra (id1 + 1) h1_succ_lt id2 h2_lt hst_lt_s hs2x1s
              ((jumps kops)[id2]).y hy2_ls (by omega) (by omega)
        · rw [hBm_eq] at hy1_ge_bm
          rw [hBp_eq] at hnh1
          by_cases hid_adj : id2 = id1 + 1
          · subst hid_adj; omega
          · have hlt_s : id1 + 1 < id2 := by omega
            have hchain := h_same_step (id1 + 1) h1_succ_lt id2 h2_lt hlt_s (by omega)
            omega)

  have hS2_card : S_2.card ≤ 2 * P := by
    have u1 := Finset.card_union_le (C2A ∪ C2B1) C2B2a
    have u2 := Finset.card_union_le C2A C2B1
    dsimp (config := { failIfUnchanged := false }) only [S_2]
    omega

  let B_3_all : Finset ℕ :=
    B_3_intra S P L kops ∪ B_3_post S P L kops ∪ B_3_act S P L kops
  let B2_to_enter := (B2_main \ S_2).filter (fun id => id ∈ E_enter)
  let B2_to_b3 := (B2_main \ S_2).filter (fun id => id + 1 ∈ B_3_all)
  let Stop_2 := S_2 ∪ B2_to_enter ∪ B2_to_b3

  have hB2_to_enter_le : B2_to_enter.card ≤ E_enter.card :=
    Finset.card_le_card (fun _ hid => (Finset.mem_filter.mp hid).2)

  have hB2_to_b3_le : B2_to_b3.card ≤ B_3_all.card := by
    refine h_card_inj B2_to_b3 B_3_all (fun id => id + 1)
      (fun id hid => (Finset.mem_filter.mp hid).2)
      (fun _ _ _ _ _ heq => by dsimp (config := { failIfUnchanged := false }) only at heq; omega)

  have hStop2_le :
      Stop_2.card ≤
        5 * P + (B_3_intra S P L kops).card +
          (B_3_post S P L kops).card + (B_3_act S P L kops).card := by
    have u1 := Finset.card_union_le (S_2 ∪ B2_to_enter) B2_to_b3
    have u2 := Finset.card_union_le S_2 B2_to_enter
    have b1 := Finset.card_union_le (B_3_intra S P L kops ∪ B_3_post S P L kops)
      (B_3_act S P L kops)
    have b2 := Finset.card_union_le (B_3_intra S P L kops) (B_3_post S P L kops)
    dsimp (config := { failIfUnchanged := false }) only [Stop_2, B_3_all] at *
    omega

  have h_b2_step_out : ∀ id ∈ B2_main, id ∉ Stop_2 →
      id + 1 ∈ B2_main ∧
        r - 1 - (b2Node (id + 1)).1.val < r - 1 - (b2Node id).1.val := by
    intro id hm hnot_stop
    have hnot_S2 : id ∉ S_2 :=
      fun h => hnot_stop (Finset.mem_union_left _ (Finset.mem_union_left _ h))
    have h_sd : id ∈ B2_main \ S_2 := Finset.mem_sdiff.mpr ⟨hm, hnot_S2⟩
    have hnot_enter : id ∉ E_enter :=
      fun h => hnot_stop (Finset.mem_union_left _ (Finset.mem_union_right _
        (Finset.mem_filter.mpr ⟨h_sd, h⟩)))
    have hnot_b3 : id + 1 ∉ B_3_all :=
      fun h => hnot_stop (Finset.mem_union_right _ (Finset.mem_filter.mpr ⟨h_sd, h⟩))
    have hnot_C2A : id ∉ C2A :=
      fun h => hnot_S2 (Finset.mem_union_left _ (Finset.mem_union_left _ h))
    have hnot_C2B1 : id ∉ C2B1 :=
      fun h => hnot_S2 (Finset.mem_union_left _ (Finset.mem_union_right _ h))
    have hnot_C2B2a : id ∉ C2B2a := fun h => hnot_S2 (Finset.mem_union_right _ h)
    obtain ⟨hlt, hℓ1_1, hsep_sx, hℓ0_ms, hms_L, hd_eq, hpref1, hc1_eq, hf1, _,
      hmlo_le, hℓ1_mmid, hmmid_lt_0, _, _, _, _, hbp_lo, _, _, _, hy_ge_bm, _⟩ :=
      h_b2_shell_omega id hm
    have hz_lt_bp : ((jumps kops)[id]).z < (blockOf S P (b2MLo id) ((jumps kops)[id]).s).2 := by
      by_contra hge
      apply hnot_C2A
      refine Finset.mem_filter.mpr ⟨hm, ?_⟩
      rw [List.getD_eq_getElem _ _ hlt]; omega
    have h_in_R2 : id ∈ R2_b2 := by
      refine Finset.mem_filter.mpr ⟨hm, ?_⟩
      rw [List.getD_eq_getElem _ _ hlt]; omega
    have hjm : ((jumps kops)[id]).j + 1 < ((jumps kops)[id]).m := by
      by_contra hn
      apply hnot_C2B1
      refine Finset.mem_filter.mpr ⟨h_in_R2, ?_⟩
      rw [List.getD_eq_getElem _ _ hlt]; exact hn
    have h_in_R3 : id ∈ R3_b2 := by
      refine Finset.mem_filter.mpr ⟨h_in_R2, ?_⟩
      rw [List.getD_eq_getElem _ _ hlt]; exact hjm
    obtain ⟨h_succ_lt, _, hs_eq, _, _, hx_eq⟩ := h_jump_succ id hlt hjm
    have hy'_lt_bp :
        ((jumps kops)[id + 1]).y < (blockOf S P (b2MLo id) ((jumps kops)[id]).s).2 := by
      by_contra hge
      apply hnot_C2B2a
      refine Finset.mem_filter.mpr ⟨h_in_R3, ?_⟩
      rw [List.getD_eq_getElem _ _ hlt, List.getD_eq_getElem _ _ h_succ_lt]; omega
    have hb := h_jump_bounds id hlt
    have hbs := h_jump_bounds (id + 1) h_succ_lt
    dsimp (config := { failIfUnchanged := false }) only at hb hbs
    set e := (jumps kops)[id]
    set e' := (jumps kops)[id + 1]
    set d := (b2Node id).1
    set p := (b2Node id).2.1
    set c1 := (b2Node id).2.2
    have hmlo_def : b2MLo id = mLoChild d p c1 := rfl
    have hmmid_def : b2MMid id = mHiChild d p c1 := rfl
    have hsP : e.s < P := by omega
    have hxsP : e'.x < P := by omega
    have hysP : e'.y < P := by omega
    have hmlo_L : b2MLo id ≤ L := by omega
    have hmmid_L : b2MMid id ≤ L := by omega
    have hidx_mlo_sx' : blockIdx S P (b2MLo id) e.s = blockIdx S P (b2MLo id) e'.x :=
      (hpart.blocks_eq_iff (b2MLo id) hmlo_L e.s hsP e'.x hxsP).mpr ⟨by omega, by omega⟩
    have hidx_mlo_sy' : blockIdx S P (b2MLo id) e.s = blockIdx S P (b2MLo id) e'.y :=
      (hpart.blocks_eq_iff (b2MLo id) hmlo_L e.s hsP e'.y hysP).mpr ⟨by omega, hy'_lt_bp⟩
    set ℓ0' := sepScale S P L e'.s e'.x
    set ℓ1' := sepScale S P L e'.x e'.y
    have hℓ0'_gt_mlo : b2MLo id < ℓ0' := by
      rw [show ℓ0' = sepScale S P L e.s e'.x by rw [← hs_eq]]
      exact (hpart.sep_gt_iff (b2MLo id) hmlo_L e.s hsP e'.x hxsP).mpr hidx_mlo_sx'
    have hℓ1'_gt_mlo : b2MLo id < ℓ1' :=
      (hpart.sep_gt_iff (b2MLo id) hmlo_L e'.x hxsP e'.y hysP).mpr
        (hidx_mlo_sx'.symm.trans hidx_mlo_sy')
    have hℓ0'_le_mmid : ℓ0' ≤ b2MMid id := by
      by_contra hgt
      have hidx_mm := (hpart.sep_gt_iff (b2MMid id) hmmid_L e.s hsP e'.x hxsP).mp
        (by rw [← hs_eq]; omega)
      have hx'_lt_bm := ((hpart.blocks_eq_iff (b2MMid id) hmmid_L e.s hsP e'.x hxsP).mp hidx_mm).2
      omega
    have hf_le_0' : mFirstChild d p c1 ≤ ℓ0' := by
      rw [hmlo_def] at hℓ0'_gt_mlo; dsimp (config := { failIfUnchanged := false }) only [mLoChild] at hℓ0'_gt_mlo; omega
    have hf_le_1' : mFirstChild d p c1 ≤ ℓ1' := by
      rw [hmlo_def] at hℓ1'_gt_mlo; dsimp (config := { failIfUnchanged := false }) only [mLoChild] at hℓ1'_gt_mlo; omega
    have hℓ1'_rng := hpart.sep_range e'.x hxsP e'.y hysP (by omega)
    rcases lt_trichotomy ℓ1' ℓ0' with h_lt_10 | h_eq_10 | h_gt_10
    · -- Case III (`ℓ1' < ℓ0'`): stays in `B2_main` and LCA depth strictly increases!
      have hb2_succ : id + 1 ∈ B_2 S P L kops := by
        simp only [B_2, Finset.mem_filter, Finset.mem_range, isB2,
          List.getElem?_eq_getElem h_succ_lt, decide_eq_true_eq]
        exact ⟨h_succ_lt, by dsimp (config := { failIfUnchanged := false }) only [e, e', ℓ0', ℓ1'] at *; omega,
          by dsimp (config := { failIfUnchanged := false }) only [e, e', ℓ0', ℓ1'] at *; omega, h_lt_10⟩
      have hnot_c1_succ : ¬pC1 (id + 1) := by
        simp only [pC1, List.getD_eq_getElem _ _ h_succ_lt]
        intro hx'_lt_L
        have hs'_lo := (h_block_bounds_of L le_rfl e'.s (by omega)).1
        have hidx_L := (hpart.blocks_eq_iff L le_rfl e'.s (by omega) e'.x hxsP).mpr
          ⟨by dsimp (config := { failIfUnchanged := false }) only [e, e', ℓ0', ℓ1'] at *; omega, hx'_lt_L⟩
        have hgt_L := (hpart.sep_gt_iff L le_rfl e'.s (by omega) e'.x hxsP).mpr hidx_L
        dsimp (config := { failIfUnchanged := false }) only [e, e', ℓ0', ℓ1'] at *
        omega
      refine ⟨Finset.mem_filter.mpr ⟨hb2_succ, hnot_c1_succ⟩, ?_⟩
      obtain ⟨_, _, _, _, _, _, _, hconv_child⟩ :=
        h_child_bounds d p c1 (sepScale S P L e.x e.y) hℓ1_1 (by omega) hpref1 hc1_eq
      obtain ⟨hp_1', hc_1'⟩ := hconv_child ℓ1' hf_le_1' (by rw [← hmmid_def]; omega)
      obtain ⟨hp_0', hc_0'⟩ := hconv_child ℓ0' hf_le_0' (by rw [← hmmid_def]; exact hℓ0'_le_mmid)
      have hd_lt_succ : d < lcaDepth ℓ1' ℓ0' :=
        h_gt_lca_of_eq ℓ1' ℓ0' d (by omega) h_lt_10 (by omega)
          (hp_1'.trans hp_0'.symm) (hc_1'.trans hc_0'.symm)
      have hd'_eq : (b2Node (id + 1)).1 = lcaDepth ℓ1' ℓ0' := by
        simp only [b2Node, List.getD_eq_getElem _ _ h_succ_lt, e', ℓ1', ℓ0']
      rw [hd'_eq]
      have hd_lt_val : d.val < (lcaDepth ℓ1' ℓ0').val := hd_lt_succ
      have hd'_lt_r : (lcaDepth ℓ1' ℓ0').val < r := (lcaDepth ℓ1' ℓ0').isLt
      omega
    · -- Case II (`ℓ1' = ℓ0'`): `id + 1 ∈ B_3_all`, contradiction!
      exfalso
      apply hnot_b3
      have hℓ1'_L : ℓ1' ≤ L := by omega
      by_cases hz_intra : e'.z < (blockOf S P ℓ1' e'.y).2
      · refine Finset.mem_union_left _ (Finset.mem_union_left _ ?_)
        simp only [B_3_intra, Finset.mem_filter, Finset.mem_range, isB3Intra,
          List.getElem?_eq_getElem h_succ_lt, decide_eq_true_eq]
        exact ⟨h_succ_lt, by dsimp (config := { failIfUnchanged := false }) only [e, e', ℓ0', ℓ1'] at *; omega,
          hℓ1'_L, h_eq_10.symm, hz_intra⟩
      · by_cases ht_post :
            tEmpty kops (blockOf S P ℓ1' e'.s).1 (blockOf S P ℓ1' e'.s).2 ≤ e'.step
        · refine Finset.mem_union_left _ (Finset.mem_union_right _ ?_)
          simp only [B_3_post, Finset.mem_filter, Finset.mem_range, isB3Post,
            List.getElem?_eq_getElem h_succ_lt, decide_eq_true_eq]
          exact ⟨h_succ_lt, by dsimp (config := { failIfUnchanged := false }) only [e, e', ℓ0', ℓ1'] at *; omega,
            hℓ1'_L, h_eq_10.symm, by dsimp (config := { failIfUnchanged := false }) only [e, e', ℓ0', ℓ1'] at *; omega, ht_post⟩
        · refine Finset.mem_union_right _ ?_
          simp only [B_3_act, Finset.mem_filter, Finset.mem_range, isB3Act,
            List.getElem?_eq_getElem h_succ_lt, decide_eq_true_eq]
          exact ⟨h_succ_lt, by dsimp (config := { failIfUnchanged := false }) only [e, e', ℓ0', ℓ1'] at *; omega,
            hℓ1'_L, h_eq_10.symm, by dsimp (config := { failIfUnchanged := false }) only [e, e', ℓ0', ℓ1'] at *; omega,
            by dsimp (config := { failIfUnchanged := false }) only [e, e', ℓ0', ℓ1'] at *; omega⟩
    · -- Case I (`ℓ0' < ℓ1'`): `id ∈ E_enter`, contradiction!
      exfalso
      apply hnot_enter
      have hnot_b1s : id ∉ B_1 S P L kops \ S_1 := by
        intro hb1s
        have hb1_id := (Finset.mem_sdiff.mp hb1s).1
        simp only [B_1, Finset.mem_filter, isB1, List.getElem?_eq_getElem hlt,
          decide_eq_true_eq] at hb1_id
        dsimp (config := { failIfUnchanged := false }) only [e, e'] at *
        omega
      have hid1_pre : id + 1 ∈ B_pre_all := by
        by_cases hℓ1'_L : ℓ1' ≤ L
        · refine Finset.mem_union_left _ ?_
          simp only [B_1, Finset.mem_filter, Finset.mem_range, isB1,
            List.getElem?_eq_getElem h_succ_lt, decide_eq_true_eq]
          exact ⟨h_succ_lt, by dsimp (config := { failIfUnchanged := false }) only [e, e', ℓ0', ℓ1'] at *; omega, hℓ1'_L, h_gt_10⟩
        · have hℓ1'_L1 : ℓ1' = L + 1 := by omega
          refine Finset.mem_union_right _ ?_
          have hne_L : blockIdx S P L e'.s ≠ blockIdx S P L e'.x := by
            intro heq
            have := (hpart.sep_gt_iff L le_rfl _ (by omega) _ hxsP).mpr heq
            omega
          have hs_lt_bo := (h_block_disj L le_rfl _ _ hbs.2.2.1 hxsP hne_L).1
          simp only [B_fin_pre, Finset.mem_filter, Finset.mem_range, isBFinPre,
            List.getElem?_eq_getElem h_succ_lt, decide_eq_true_eq]
          exact ⟨h_succ_lt, hℓ1'_L1, hs_lt_bo⟩
      refine Finset.mem_filter.mpr ⟨Finset.mem_range.mpr hlt, hnot_b1s, ?_, hid1_pre⟩
      rw [List.getD_eq_getElem _ _ hlt]
      exact hjm

  have h_conj6 :
      (B_2 S P L kops).card ≤
        P + r * (5 * P + (B_3_intra S P L kops).card +
          (B_3_post S P L kops).card + (B_3_act S P L kops).card) := by
    have hB2_main_le : B2_main.card ≤ r * Stop_2.card :=
      omega_chain_card_bound r B2_main Stop_2
        (fun id => r - 1 - (b2Node id).1.val)
        (fun _ _ => by dsimp (config := { failIfUnchanged := false }) only; omega)
        h_b2_step_out
    have hmul := Nat.mul_le_mul_left r hStop2_le
    omega

  exact ⟨h_conj1, h_conj2, h_conj3, h_conj4, h_conj5, h_conj6⟩

-- === BEGIN OmegaB3 ===
private theorem blockOf_nested_omega (S : ℕ → ℕ) (P L : ℕ)
    (hpart : ScalePartitionLawsOmega S P L) :
    ∀ m1 m2, m1 ≤ m2 → m2 ≤ L → ∀ v < P,
      (blockOf S P m1 v).1 ≤ (blockOf S P m2 v).1 ∧
      (blockOf S P m2 v).2 ≤ (blockOf S P m1 v).2 := by
  have h_step : ∀ m, m + 1 ≤ L → ∀ v < P,
      (blockOf S P m v).1 ≤ (blockOf S P (m + 1) v).1 ∧
      (blockOf S P (m + 1) v).2 ≤ (blockOf S P m v).2 := by
    intro m hm1L v hv
    obtain ⟨hXi_lt, hv1, hv2, _⟩ := hpart.blocks_partition m (by omega) v hv
    have hcb := hpart.child_blocks (m + 1) (by omega) hm1L (blockIdx S P m v) hXi_lt
    dsimp (config := { failIfUnchanged := false }) only at hcb
    rw [Nat.add_sub_cancel] at hcb
    obtain ⟨_, _, _, hbounds, _, _, hsub_get, _⟩ := hcb
    have hX_eq : (scaleBlocks S P m).getD (blockIdx S P m v) (0, 0) = blockOf S P m v := rfl
    rw [hX_eq] at hbounds hsub_get
    obtain ⟨hc_lt, hc_eq⟩ := hsub_get v hv1 hv2
    have hb := hbounds _ hc_lt
    rw [hc_eq] at hb
    exact ⟨hb.1, hb.2.2.1⟩
  have h_ind : ∀ m1 d, m1 + d ≤ L → ∀ v < P,
      (blockOf S P m1 v).1 ≤ (blockOf S P (m1 + d) v).1 ∧
      (blockOf S P (m1 + d) v).2 ≤ (blockOf S P m1 v).2 := by
    intro m1 d
    induction d with
    | zero =>
      intro _ v _
      simp
    | succ d ih =>
      intro hmdL v hv
      rw [← Nat.add_assoc] at hmdL ⊢
      obtain ⟨h1, h2⟩ := ih (by omega) v hv
      obtain ⟨h3, h4⟩ := h_step (m1 + d) hmdL v hv
      exact ⟨le_trans h1 h3, le_trans h4 h2⟩
  intro m1 m2 hm12 hm2L v hv
  obtain ⟨d, rfl⟩ := Nat.exists_eq_add_of_le hm12
  exact h_ind m1 d hm2L v hv

theorem active_exit_first_mover_reduction_omega (P L : ℕ) (S : ℕ → ℕ) (kops : List KeyedCoreOp)
    (hP : 1 ≤ P) (hL : 1 ≤ L) (hS0 : S 0 = P) (hSL_pos : 1 ≤ S L)
    (hS_step : ∀ ℓ : ℕ, ℓ < L → 2 * S (ℓ + 1) ≤ S ℓ)
    (hkvalid : ValidKeyedCoreSeq P kops) (hjump : PrimalJumpLaws P kops)
    (hfold : ValidFoldedCoreLaws P kops) (hpart : ScalePartitionLawsOmega S P L) :
    (B_3_act S P L kops).card ≤
      2 * totalMMovCount S P L kops + (MBaseSet kops).card + P + countKeyedRslr kops +
        3 * ((B_fin_pre S P L kops).card + (B_1_exit S P L kops).card +
          (B_3_intra S P L kops).card + (B_3_post S P L kops).card) := by
  have _ := hL; have _ := hS0; have _ := hSL_pos; have _ := hS_step
  classical
  have h_nested := blockOf_nested_omega S P L hpart
  have h_pop_mono : ∀ t1 t2, t1 ≤ t2 → popIdx kops t1 ≤ popIdx kops t2 :=
    (plug_unborn_trajectory_laws P kops hP hkvalid hjump hfold).2.1

  have h_forall_inorder : ∀ {p : ℕ → Prop} {T : _root_.BinaryTree ℕ},
      _root_.SplayDeque.Direct.ForallTree p T → ∀ w ∈ inorderNat T, p w := by
    intro p T hft
    induction hft with
    | left => intro w hw; simp [inorderNat] at hw
    | node l key r _ hk _ ihl ihr =>
      intro w hw
      simp only [inorderNat, List.mem_append, List.mem_singleton] at hw
      rcases hw with (hw | rfl) | hw
      · exact ihl w hw
      · exact hk
      · exact ihr w hw

  have h_ls_aux : ∀ (T : _root_.BinaryTree ℕ) (acc : List ℕ),
      leftSpineBottomUpAux T acc = leftSpineBottomUpAux T [] ++ acc := by
    intro T
    induction T with
    | nil => intro acc; rfl
    | node k l _ ihl _ =>
      intro acc
      simp only [leftSpineBottomUpAux]
      rw [ihl (k :: acc), ihl [k]]
      simp

  have h_ls_node : ∀ (l : _root_.BinaryTree ℕ) (k : ℕ) (r : _root_.BinaryTree ℕ),
      leftSpineBottomUpNat (.node k l r) = leftSpineBottomUpNat l ++ [k] := by
    intro l k r
    unfold leftSpineBottomUpNat
    simpa [leftSpineBottomUpAux] using h_ls_aux l [k]

  have h_ls_sub_inorder : ∀ (T : _root_.BinaryTree ℕ), ∀ u ∈ leftSpineBottomUpNat T, u ∈ inorderNat T := by
    intro T
    induction T with
    | nil => intro u hu; simp [leftSpineBottomUpNat, leftSpineBottomUpAux] at hu
    | node k l r ihl _ =>
      intro u hu
      rw [h_ls_node, List.mem_append, List.mem_singleton] at hu
      simp only [inorderNat, List.mem_append, List.mem_singleton]
      rcases hu with hu | rfl
      · exact Or.inl (Or.inl (ihl u hu))
      · exact Or.inl (Or.inr rfl)

  have h_find_of_any :
      ∀ (xs : List ℕ) (pred : ℕ → Bool),
        xs.any pred = true →
        (xs.find? pred).getD 0 ∈ xs ∧ pred ((xs.find? pred).getD 0) = true := by
    intro xs pred h
    cases hf : xs.find? pred with
    | none =>
      rw [List.find?_eq_none] at hf
      rw [List.any_eq_true] at h
      obtain ⟨x, hx1, hx2⟩ := h
      exact absurd hx2 (hf x hx1)
    | some w =>
      exact ⟨List.mem_of_find?_eq_some hf, List.find?_some hf⟩

  have h_step_trans : ∀ (Q : ℕ → Prop) (a b : ℕ),
      a < b → Q a → ¬ Q b → ∃ t, a ≤ t ∧ t < b ∧ Q t ∧ ¬ Q (t + 1) := by
    intro Q a b
    induction b with
    | zero => intro h; omega
    | succ b ih =>
      intro hab hQa hQbs
      by_cases hQb : Q b
      · exact ⟨b, by omega, by omega, hQb, hQbs⟩
      · rcases eq_or_lt_of_le (Nat.le_of_lt_succ hab) with rfl | hlt
        · exact absurd hQa hQb
        · obtain ⟨t, hat, htb, hQt, hQt1⟩ := ih hlt hQa hQb
          exact ⟨t, hat, by omega, hQt, hQt1⟩

  have h_sub_disj : ∀ (ℓ Xi : ℕ), 1 ≤ ℓ → ℓ ≤ L → Xi < (scaleBlocks S P (ℓ - 1)).length →
      ∀ c1 c2, c1 < c2 →
        c2 < (splitBlock (S ℓ) ((scaleBlocks S P (ℓ - 1)).getD Xi (0, 0)).1
          ((scaleBlocks S P (ℓ - 1)).getD Xi (0, 0)).2).length →
        ((splitBlock (S ℓ) ((scaleBlocks S P (ℓ - 1)).getD Xi (0, 0)).1
          ((scaleBlocks S P (ℓ - 1)).getD Xi (0, 0)).2).getD c1 (0, 0)).2 ≤
        ((splitBlock (S ℓ) ((scaleBlocks S P (ℓ - 1)).getD Xi (0, 0)).1
          ((scaleBlocks S P (ℓ - 1)).getD Xi (0, 0)).2).getD c2 (0, 0)).1 := by
    intro ℓ Xi hℓ1 hℓL hXi c1 c2 hc12 hc2
    have hcb := hpart.child_blocks ℓ hℓ1 hℓL Xi hXi
    dsimp (config := { failIfUnchanged := false }) only at hcb
    obtain ⟨_, _, _, hbounds, hadj, _, _, _⟩ := hcb
    set subs := splitBlock (S ℓ) ((scaleBlocks S P (ℓ - 1)).getD Xi (0, 0)).1
      ((scaleBlocks S P (ℓ - 1)).getD Xi (0, 0)).2
    have hstep : ∀ d, c1 + 1 + d < subs.length →
        (subs.getD c1 (0, 0)).2 ≤ (subs.getD (c1 + 1 + d) (0, 0)).1 := by
      intro d
      induction d with
      | zero =>
        intro hd
        simp only [Nat.add_zero] at hd ⊢
        exact le_of_eq (hadj c1 hd)
      | succ d ih =>
        intro hd
        have h1 := ih (by omega)
        have h2 := (hbounds (c1 + 1 + d) (by omega)).2.1
        have h3 := hadj (c1 + 1 + d) (by simpa [Nat.add_assoc] using hd)
        rw [show c1 + 1 + (d + 1) = c1 + 1 + d + 1 by omega]
        omega
    have h_eq : c1 + 1 + (c2 - (c1 + 1)) = c2 := by omega
    have hd := hstep (c2 - (c1 + 1)) (by rw [h_eq]; exact hc2)
    rwa [h_eq] at hd

  have h_coord_rec :
      ∀ ℓ, 1 ≤ ℓ → ℓ ≤ L → ∀ Xi < (scaleBlocks S P (ℓ - 1)).length,
        let X := (scaleBlocks S P (ℓ - 1)).getD Xi (0, 0)
        let subs := splitBlock (S ℓ) X.1 X.2
        ∀ i j, i < j → j < subs.length →
          ∀ u v,
            (subs.getD i (0, 0)).1 ≤ u → u < (subs.getD i (0, 0)).2 →
            (subs.getD j (0, 0)).1 ≤ v → v < (subs.getD j (0, 0)).2 →
            u < P ∧ v < P ∧
              sepScale S P L u v = ℓ ∧
              blockIdx S P (ℓ - 1) v = Xi ∧
              subs.findIdx (fun b => decide (b.1 ≤ u ∧ u < b.2)) = i ∧
              subs.findIdx (fun b => decide (b.1 ≤ v ∧ v < b.2)) = j := by
    intro ℓ hℓ1 hℓL Xi hXi
    have hX_mem : (scaleBlocks S P (ℓ - 1)).getD Xi (0, 0) ∈ scaleBlocks S P (ℓ - 1) := by
      rw [List.getD_eq_getElem?_getD, List.getElem?_eq_getElem hXi]
      exact List.getElem_mem hXi
    have hXP : ((scaleBlocks S P (ℓ - 1)).getD Xi (0, 0)).2 ≤ P :=
      (hpart.blocks_bounds (ℓ - 1) (by omega) _ hX_mem).2.1
    obtain ⟨_, _, _, h_sub, _, h_memX, h_fidx, h_feq⟩ := hpart.child_blocks ℓ hℓ1 hℓL Xi hXi
    dsimp (config := { failIfUnchanged := false }) only at h_sub h_memX h_fidx h_feq ⊢
    have hdisj := h_sub_disj ℓ Xi hℓ1 hℓL hXi
    set X := (scaleBlocks S P (ℓ - 1)).getD Xi (0, 0)
    set subs := splitBlock (S ℓ) X.1 X.2
    have h_fidx_unique : ∀ idx < subs.length, ∀ w,
        (subs.getD idx (0, 0)).1 ≤ w → w < (subs.getD idx (0, 0)).2 →
        subs.findIdx (fun b => decide (b.1 ≤ w ∧ w < b.2)) = idx := by
      intro idx hidx w hw1 hw2
      obtain ⟨hs1, _, hs3, _, _⟩ := h_sub idx hidx
      obtain ⟨hcw_lt, hcw_eq⟩ := h_fidx w (by omega) (by omega)
      obtain ⟨_, hb1, hb2, _⟩ := hpart.blocks_partition ℓ hℓL w (by omega)
      rw [← hcw_eq] at hb1 hb2
      set cw := subs.findIdx (fun b => decide (b.1 ≤ w ∧ w < b.2))
      rcases lt_trichotomy cw idx with hlt | heq | hgt
      · have := hdisj cw idx hlt hidx; omega
      · exact heq
      · have := hdisj idx cw hgt hcw_lt; omega
    intro i j hij hj u v hu1 hu2 hv1 hv2
    have hi : i < subs.length := by omega
    obtain ⟨hsi1, _, hsi3, _, _⟩ := h_sub i hi
    obtain ⟨hsj1, _, hsj3, _, _⟩ := h_sub j hj
    have huX1 : X.1 ≤ u := by omega
    have huX2 : u < X.2 := by omega
    have hvX1 : X.1 ≤ v := by omega
    have hvX2 : v < X.2 := by omega
    have huP : u < P := by omega
    have hvP : v < P := by omega
    have hfu := h_fidx_unique i hi u hu1 hu2
    have hfv := h_fidx_unique j hj v hv1 hv2
    have hbu : blockIdx S P (ℓ - 1) u = Xi := (h_memX u huP).mpr ⟨huX1, huX2⟩
    have hbv : blockIdx S P (ℓ - 1) v = Xi := (h_memX v hvP).mpr ⟨hvX1, hvX2⟩
    have hsep_gt : ℓ - 1 < sepScale S P L u v :=
      (hpart.sep_gt_iff (ℓ - 1) (by omega) u huP v hvP).mpr (hbu.trans hbv.symm)
    have hnot_sep_gt : ¬ ℓ < sepScale S P L u v := by
      intro hlt
      have hbeq := (hpart.sep_gt_iff ℓ hℓL u huP v hvP).mp hlt
      have hfeq_uv := (h_feq u huX1 huX2 v hvX1 hvX2).mpr hbeq
      omega
    exact ⟨huP, hvP, by omega, hbv, hfu, hfv⟩

  have h_inord_head_window : ∀ (lo hi t : ℕ),
      lo < hi → hi ≤ P →
      popStep kops lo ≤ t → t < tEmpty kops lo hi →
      t < kops.length ∧
      lo ≤ (inorderNat (keyedState kops t)).headD 0 ∧
      (inorderNat (keyedState kops t)).headD 0 < hi := by
    intro lo hi t hlo_hi hhi_P hts_t ht_te
    let tmax := popStep kops (hi - 1) + 1
    have htmax_le : tmax ≤ kops.length := by
      have := (hkvalid.birth_lt_pop (hi - 1) (by omega)).2; omega
    let pred : ℕ → Bool := fun t' =>
      (inorderNat (keyedState kops t')).all (fun v => decide (v < lo ∨ hi ≤ v))
    have h_false_to_v0 : ∀ t', ¬ (pred t' = true) →
        ∃ v0 ∈ inorderNat (keyedState kops t'), lo ≤ v0 ∧ v0 < hi := by
      intro t' hnp
      by_contra hno
      apply hnp
      rw [List.all_eq_true]
      intro v hv
      rw [decide_eq_true_iff]
      by_contra hnv
      exact hno ⟨v, hv, by omega, by omega⟩
    have h_win : t < kops.length ∧ ∃ v0 ∈ inorderNat (keyedState kops t), lo ≤ v0 ∧ v0 < hi := by
      unfold tEmpty at ht_te
      dsimp (config := { failIfUnchanged := false }) only at ht_te
      rcases hfind : (List.Ico (popStep kops lo) (tmax + 1)).find? pred with _ | t0
      · rw [hfind] at ht_te; dsimp (config := { failIfUnchanged := false }) only at ht_te
        have ht_mem : t ∈ List.Ico (popStep kops lo) (tmax + 1) :=
          List.Ico.mem.mpr ⟨hts_t, Nat.lt_succ_of_lt ht_te⟩
        exact ⟨by omega, h_false_to_v0 t (List.find?_eq_none.mp hfind t ht_mem)⟩
      · rw [hfind] at ht_te; dsimp (config := { failIfUnchanged := false }) only at ht_te
        have ht0_mem := List.Ico.mem.mp (List.mem_of_find?_eq_some hfind)
        have ht_mem : t ∈ List.Ico (popStep kops lo) (tmax + 1) :=
          List.Ico.mem.mpr ⟨hts_t, by omega⟩
        obtain ⟨_, as, bs, h_eq, has_false⟩ := List.find?_eq_some_iff_append.mp hfind
        have hpw := List.Ico.pairwise_lt (popStep kops lo) (tmax + 1)
        rw [h_eq] at ht_mem hpw
        have hbs_gt : ∀ b ∈ bs, t0 < b :=
          (List.pairwise_cons.mp (List.pairwise_append.mp hpw).2.1).1
        rcases List.mem_append.mp ht_mem with h_in_as | h_in_tail
        · exact ⟨by omega, h_false_to_v0 t (by simpa using has_false t h_in_as)⟩
        · rcases List.mem_cons.mp h_in_tail with rfl | h_in_bs
          · omega
          · have := hbs_gt t h_in_bs; omega
    obtain ⟨ht_lt, v0, hv0_mem, hv0_1, hv0_2⟩ := h_win
    rcases hinord : inorderNat (keyedState kops t) with _ | ⟨m0, rest⟩
    · simp [hinord] at hv0_mem
    · refine ⟨ht_lt, ?_, ?_⟩
      · simp only [List.headD_cons]
        have hm0_mem : m0 ∈ inorderNat (keyedState kops t) := by simp [hinord]
        have hm0_ge := (hkvalid.popIdx_bound t (le_of_lt ht_lt) m0 hm0_mem).1
        have hpop_lo : popIdx kops (popStep kops lo) = lo :=
          hkvalid.popIdx_at_popStep lo (by omega)
        have hpm := h_pop_mono (popStep kops lo) t hts_t
        omega
      · simp only [List.headD_cons]
        have hpw := hkvalid.inorder_strictMono t (le_of_lt ht_lt)
        rw [hinord] at hpw hv0_mem
        rcases List.mem_cons.mp hv0_mem with rfl | hv0_rest
        · exact hv0_2
        · have := (List.pairwise_cons.mp hpw).1 v0 hv0_rest; omega

  let isRslrAt : List KeyedCoreOp → ℕ → Bool := fun xs t =>
    match xs[t]? with
    | some (.rslr _) => true
    | _ => false
  let rslrSteps : Finset ℕ :=
    (Finset.range kops.length).filter (fun t => isRslrAt kops t = true)

  have h_rslr_append :
      ∀ (xs : List KeyedCoreOp) (op : KeyedCoreOp),
        countKeyedRslr (xs ++ [op]) =
          countKeyedRslr xs + (match op with | .rslr _ => 1 | _ => 0) := by
    intro xs op
    induction xs with
    | nil => cases op <;> simp [countKeyedRslr]
    | cons a rest ih =>
      cases a with
      | push _ => simp [countKeyedRslr, ih]
      | pop _ => simp [countKeyedRslr, ih]
      | rslr _ => simp [countKeyedRslr, ih]; omega

  have h_rslr_card_aux :
      ∀ xs : List KeyedCoreOp,
        ((Finset.range xs.length).filter (fun t => isRslrAt xs t = true)).card =
          countKeyedRslr xs := by
    intro xs
    refine List.reverseRecOn xs ?_ (fun ys op ih => ?_)
    · simp [countKeyedRslr]
    · rw [List.length_append, List.length_singleton, Finset.range_add_one, Finset.filter_insert]
      have hcongr :
          (Finset.range ys.length).filter (fun t => isRslrAt (ys ++ [op]) t = true) =
            (Finset.range ys.length).filter (fun t => isRslrAt ys t = true) := by
        refine Finset.filter_congr ?_
        intro t ht
        rw [Finset.mem_range] at ht
        simp only [isRslrAt, List.getElem?_append_left ht]
      have hlast : isRslrAt (ys ++ [op]) ys.length =
          (match op with | .rslr _ => true | _ => false) := by
        cases op <;> simp [isRslrAt]
      have hnotmem :
          ys.length ∉ (Finset.range ys.length).filter (fun t => isRslrAt ys t = true) := by
        simp [Finset.mem_filter, Finset.mem_range]
      rw [hcongr, hlast, h_rslr_append]
      cases op with
      | push _ => simp [ih]
      | pop _ => simp [ih]
      | rslr _ => simp [Finset.card_insert_of_notMem hnotmem, ih]

  have h_rslr_card : rslrSteps.card = countKeyedRslr kops := h_rslr_card_aux kops

  have h_b3act_props : ∀ id ∈ B_3_act S P L kops,
      ∃ hid : id < (jumps kops).length,
        let e := (jumps kops)[id]
        1 ≤ sepScale S P L e.x e.y ∧
        sepScale S P L e.x e.y ≤ L ∧
        sepScale S P L e.s e.x = sepScale S P L e.x e.y ∧
        (blockOf S P (sepScale S P L e.x e.y) e.y).2 ≤ e.z ∧
        e.step < tEmpty kops (blockOf S P (sepScale S P L e.x e.y) e.s).1
          (blockOf S P (sepScale S P L e.x e.y) e.s).2 := by
    intro id hid_mem
    simp only [B_3_act, Finset.mem_filter, Finset.mem_range] at hid_mem
    obtain ⟨hid, hb3⟩ := hid_mem
    unfold isB3Act at hb3
    rw [List.getElem?_eq_getElem hid] at hb3
    simp only [decide_eq_true_eq] at hb3
    exact ⟨hid, hb3.1, hb3.2.1, hb3.2.2.1, hb3.2.2.2.1, hb3.2.2.2.2⟩

  let jScale : ℕ → ℕ := fun id =>
    match (jumps kops)[id]? with
    | none => 0
    | some e => sepScale S P L e.x e.y

  let Xi_of : ℕ → ℕ := fun id =>
    match (jumps kops)[id]? with
    | none => 0
    | some e => blockIdx S P (jScale id - 1) e.x

  let subs_of : ℕ → List (ℕ × ℕ) := fun id =>
    let X := (scaleBlocks S P (jScale id - 1)).getD (Xi_of id) (0, 0)
    splitBlock (S (jScale id)) X.1 X.2

  let p_of : ℕ → ℕ := fun id =>
    match (jumps kops)[id]? with
    | none => 0
    | some e => (subs_of id).findIdx (fun b => decide (b.1 ≤ e.s ∧ e.s < b.2))

  let cx_of : ℕ → ℕ := fun id =>
    match (jumps kops)[id]? with
    | none => 0
    | some e => (subs_of id).findIdx (fun b => decide (b.1 ≤ e.x ∧ e.x < b.2))

  let cy_of : ℕ → ℕ := fun id =>
    match (jumps kops)[id]? with
    | none => 0
    | some e => (subs_of id).findIdx (fun b => decide (b.1 ≤ e.y ∧ e.y < b.2))

  have h_partition : ∀ (A : Finset ℕ), A ⊆ B_3_act S P L kops →
      A.card =
        (Finset.Icc 1 L).sum (fun ℓ =>
          (Finset.range (scaleBlocks S P (ℓ - 1)).length).sum (fun Xi =>
            let X := (scaleBlocks S P (ℓ - 1)).getD Xi (0, 0)
            let KX := (splitBlock (S ℓ) X.1 X.2).length
            (Finset.range (KX - 1)).sum (fun p =>
              (VActSet S P L kops ℓ Xi p ∩ A).card))) := by
    intro A hA
    have hmap1 : Set.MapsTo jScale (A : Set ℕ) (Finset.Icc 1 L : Set ℕ) := by
      intro id hidA
      obtain ⟨hid, h1, h2, _, _, _⟩ := h_b3act_props id (hA hidA)
      simp only [Finset.mem_coe, Finset.mem_Icc, jScale, List.getElem?_eq_getElem hid]
      exact ⟨h1, h2⟩
    rw [Finset.card_eq_sum_card_fiberwise hmap1]
    refine Finset.sum_congr rfl ?_
    intro ℓ hℓ
    rw [Finset.mem_Icc] at hℓ
    let fXi : ℕ → ℕ := fun id =>
      match (jumps kops)[id]? with
      | none => 0
      | some e => blockIdx S P (ℓ - 1) e.x
    have hmap2 : Set.MapsTo fXi ((A.filter (fun id => jScale id = ℓ)) : Set ℕ)
        (Finset.range (scaleBlocks S P (ℓ - 1)).length : Set ℕ) := by
      intro id hid1
      simp only [Finset.mem_coe, Finset.mem_filter] at hid1
      obtain ⟨hid, _, _, _, _, _⟩ := h_b3act_props id (hA hid1.1)
      have hxP : ((jumps kops)[id]).x < P := by
        have hja := hjump.jump_anatomies id hid
        omega
      simp only [Finset.mem_coe, Finset.mem_range, fXi, List.getElem?_eq_getElem hid]
      exact (hpart.blocks_partition (ℓ - 1) (by omega) _ hxP).1
    rw [Finset.card_eq_sum_card_fiberwise hmap2]
    refine Finset.sum_congr rfl ?_
    intro Xi hXi
    rw [Finset.mem_range] at hXi
    dsimp (config := { failIfUnchanged := false }) only
    have hcb := hpart.child_blocks ℓ hℓ.1 hℓ.2 Xi hXi
    dsimp (config := { failIfUnchanged := false }) only at hcb
    obtain ⟨_, _, _, _, _, hX_iff, hsub_get, hsub_eq_iff⟩ := hcb
    have hdisj_here := h_sub_disj ℓ Xi hℓ.1 hℓ.2 hXi
    set X := (scaleBlocks S P (ℓ - 1)).getD Xi (0, 0)
    set subs := splitBlock (S ℓ) X.1 X.2
    let fp : ℕ → ℕ := fun id =>
      match (jumps kops)[id]? with
      | none => 0
      | some e => subs.findIdx (fun b => decide (b.1 ≤ e.s ∧ e.s < b.2))
    let A2 := (A.filter (fun id => jScale id = ℓ)).filter (fun id => fXi id = Xi)
    have hA2_sub : ∀ id ∈ A2,
        ∃ hid : id < (jumps kops).length,
          sepScale S P L ((jumps kops)[id]).x ((jumps kops)[id]).y = ℓ ∧
          blockIdx S P (ℓ - 1) ((jumps kops)[id]).x = Xi ∧
          X.1 ≤ ((jumps kops)[id]).s ∧ ((jumps kops)[id]).s < X.2 ∧
          X.1 ≤ ((jumps kops)[id]).x ∧ ((jumps kops)[id]).x < X.2 ∧
          fp id < subs.length - 1 ∧
          subs.getD (fp id) (0, 0) = blockOf S P ℓ ((jumps kops)[id]).s := by
      intro id hid2
      simp only [A2, Finset.mem_filter] at hid2
      obtain ⟨⟨hidA, hjs⟩, hfxi⟩ := hid2
      obtain ⟨hid, _, _, hsx_eq, _, _⟩ := h_b3act_props id (hA hidA)
      simp only [jScale, fXi, List.getElem?_eq_getElem hid] at hjs hfxi
      have hja := hjump.jump_anatomies id hid
      have hsx : ((jumps kops)[id]).s < ((jumps kops)[id]).x := hja.2.2.2.2.1
      have hxP : ((jumps kops)[id]).x < P := by omega
      have hsP : ((jumps kops)[id]).s < P := by omega
      have hx_in_X : X.1 ≤ ((jumps kops)[id]).x ∧ ((jumps kops)[id]).x < X.2 :=
        (hX_iff _ hxP).mp hfxi
      have h_bidx_s : blockIdx S P (ℓ - 1) ((jumps kops)[id]).s = Xi := by
        have := (hpart.sep_gt_iff (ℓ - 1) (by omega) _ hsP _ hxP).mp (by omega)
        omega
      have hs_in_X : X.1 ≤ ((jumps kops)[id]).s ∧ ((jumps kops)[id]).s < X.2 :=
        (hX_iff _ hsP).mp h_bidx_s
      obtain ⟨hp_lt, hp_eq⟩ := hsub_get _ hs_in_X.1 hs_in_X.2
      obtain ⟨_, hcx_eq⟩ := hsub_get _ hx_in_X.1 hx_in_X.2
      set cx := subs.findIdx (fun b => decide (b.1 ≤ ((jumps kops)[id]).x ∧ ((jumps kops)[id]).x < b.2))
      have hfp_def : fp id = subs.findIdx (fun b => decide (b.1 ≤ ((jumps kops)[id]).s ∧ ((jumps kops)[id]).s < b.2)) := by
        simp [fp, List.getElem?_eq_getElem hid]
      have h_ne : fp id ≠ cx := by
        intro heq_idx
        rw [hfp_def] at heq_idx
        have hbidx := (hsub_eq_iff _ hs_in_X.1 hs_in_X.2 _ hx_in_X.1 hx_in_X.2).mp heq_idx
        have hgt := (hpart.sep_gt_iff ℓ hℓ.2 _ hsP _ hxP).mpr hbidx
        omega
      have h_lt_cx : fp id < cx := by
        by_contra hge
        have hgt_cx : cx < fp id := by omega
        have hdisj := hdisj_here cx (fp id) hgt_cx (by rw [hfp_def]; exact hp_lt)
        rw [hfp_def] at hdisj
        rw [hcx_eq, hp_eq] at hdisj
        have hbs := (hpart.blocks_partition ℓ hℓ.2 _ hsP).2.1
        have hbx := (hpart.blocks_partition ℓ hℓ.2 _ hxP).2.2.1
        omega
      refine ⟨hid, hjs, hfxi, hs_in_X.1, hs_in_X.2, hx_in_X.1, hx_in_X.2, by omega, ?_⟩
      rw [hfp_def]
      exact hp_eq
    have hmap3 : Set.MapsTo fp (A2 : Set ℕ) (Finset.range (subs.length - 1) : Set ℕ) := by
      intro id hid2
      obtain ⟨_, _, _, _, _, _, _, hplt, _⟩ := hA2_sub id hid2
      exact Finset.mem_coe.mpr (Finset.mem_range.mpr hplt)
    rw [Finset.card_eq_sum_card_fiberwise hmap3]
    refine Finset.sum_congr rfl ?_
    intro p hp
    rw [Finset.mem_range] at hp
    congr 1
    ext id
    simp only [A2, VActSet, Finset.mem_filter, Finset.mem_inter]
    constructor
    · rintro ⟨⟨⟨hidA, hjs⟩, hfxi⟩, hfp_eq⟩
      have hid_mem2 : id ∈ A2 := by simp [A2, hidA, hjs, hfxi]
      obtain ⟨hid, h_sep, h_bidx, _, _, _, _, _, h_sp_eq⟩ := hA2_sub id hid_mem2
      refine ⟨⟨hA hidA, ?_⟩, hidA⟩
      unfold isVAct
      dsimp (config := { failIfUnchanged := false }) only
      rw [List.getElem?_eq_getElem hid]
      simp only [decide_eq_true_eq]
      have hsP : ((jumps kops)[id]).s < P := by
        have hja := hjump.jump_anatomies id hid; omega
      have hbs := hpart.blocks_partition ℓ hℓ.2 _ hsP
      have hsp_bo : subs.getD p (0, 0) = blockOf S P ℓ ((jumps kops)[id]).s := by
        rw [← hfp_eq]; exact h_sp_eq
      change sepScale S P L ((jumps kops)[id]).x ((jumps kops)[id]).y = ℓ ∧
        blockIdx S P (ℓ - 1) ((jumps kops)[id]).x = Xi ∧
        (subs.getD p (0, 0)).1 ≤ ((jumps kops)[id]).s ∧
        ((jumps kops)[id]).s < (subs.getD p (0, 0)).2
      rw [hsp_bo]
      exact ⟨h_sep, h_bidx, hbs.2.1, hbs.2.2.1⟩
    · rintro ⟨⟨hb3, hvact⟩, hidA⟩
      obtain ⟨hid, _, _, _, _, _⟩ := h_b3act_props id hb3
      unfold isVAct at hvact
      rw [List.getElem?_eq_getElem hid] at hvact
      simp only [decide_eq_true_eq] at hvact
      have hjs : jScale id = ℓ := by simp [jScale, List.getElem?_eq_getElem hid, hvact.1]
      have hfxi : fXi id = Xi := by simp [fXi, List.getElem?_eq_getElem hid, hvact.2.1]
      have hid_mem2 : id ∈ A2 := by simp [A2, hidA, hjs, hfxi]
      obtain ⟨_, _, _, _, _, _, _, hfp_lt, h_sp_eq⟩ := hA2_sub id hid_mem2
      refine ⟨⟨⟨hidA, hjs⟩, hfxi⟩, ?_⟩
      have hsP : ((jumps kops)[id]).s < P := by
        have hja := hjump.jump_anatomies id hid; omega
      have hbs := hpart.blocks_partition ℓ hℓ.2 _ hsP
      rw [← h_sp_eq] at hbs
      have hsp1 : (subs.getD p (0, 0)).1 ≤ ((jumps kops)[id]).s := hvact.2.2.1
      have hsp2 : ((jumps kops)[id]).s < (subs.getD p (0, 0)).2 := hvact.2.2.2
      by_contra hne
      rcases lt_or_gt_of_ne hne with hlt | hgt
      · have hdisj := hdisj_here (fp id) p hlt (by omega); omega
      · have hdisj := hdisj_here p (fp id) hgt (by omega); omega

  have h_jump_popStep : ∀ id (hid : id < (jumps kops).length),
      ((jumps kops)[id]).s < P ∧ popStep kops ((jumps kops)[id]).s = ((jumps kops)[id]).step := by
    intro id hid
    have hja := hjump.jump_anatomies id hid
    have hst : ((jumps kops)[id]).step < kops.length := hja.2.1
    have hop : kops[((jumps kops)[id]).step] = .pop ((jumps kops)[id]).s := by
      have h1 := hja.2.2.1
      rw [List.getElem?_eq_getElem hst] at h1
      exact Option.some.inj h1
    have hsv := hkvalid.step_valid _ hst
    rw [hop] at hsv
    exact ⟨hsv.1, hsv.2.1⟩

  have h_s_lt_of_step_lt : ∀ id1 (hid1 : id1 < (jumps kops).length)
      id2 (hid2 : id2 < (jumps kops).length),
      ((jumps kops)[id1]).step < ((jumps kops)[id2]).step →
      ((jumps kops)[id1]).s < ((jumps kops)[id2]).s := by
    intro id1 hid1 id2 hid2 hlt
    obtain ⟨hs1P, hp1⟩ := h_jump_popStep id1 hid1
    obtain ⟨_, hp2⟩ := h_jump_popStep id2 hid2
    by_contra hge
    rcases eq_or_lt_of_le (Nat.not_lt.mp hge) with heq | hgt
    · rw [← heq] at hp1; omega
    · have hm := hkvalid.popStep_mono _ _ hgt hs1P; omega

  have h_s_le_of_step_le : ∀ id1 (hid1 : id1 < (jumps kops).length)
      id2 (hid2 : id2 < (jumps kops).length),
      ((jumps kops)[id1]).step ≤ ((jumps kops)[id2]).step →
      ((jumps kops)[id1]).s ≤ ((jumps kops)[id2]).s := by
    intro id1 hid1 id2 hid2 hle
    obtain ⟨hs1P, hp1⟩ := h_jump_popStep id1 hid1
    obtain ⟨_, hp2⟩ := h_jump_popStep id2 hid2
    by_contra hgt_not
    have hgt : ((jumps kops)[id2]).s < ((jumps kops)[id1]).s := by omega
    have hm := hkvalid.popStep_mono _ _ hgt hs1P
    omega

  have h_same_step_z_le_x : ∀ id1 (hid1 : id1 < (jumps kops).length)
      id2 (hid2 : id2 < (jumps kops).length),
      id1 < id2 →
      ((jumps kops)[id1]).step = ((jumps kops)[id2]).step →
      ((jumps kops)[id1]).z ≤ ((jumps kops)[id2]).x := by
    intro id1 hid1 id2 hid2 hid12 hsteq
    have hja1 := hjump.jump_anatomies id1 hid1
    have hst1 : ((jumps kops)[id1]).step < kops.length := hja1.2.1
    have hop1 : kops[((jumps kops)[id1]).step] = .pop ((jumps kops)[id1]).s := by
      have h1 := hja1.2.2.1
      rw [List.getElem?_eq_getElem hst1] at h1
      exact Option.some.inj h1
    obtain ⟨baseId, _, hbm_iff⟩ := hjump.pop_step_jumps _ hst1 _ hop1
    have hb1 := (hbm_iff id1 hid1).mp rfl
    have hb2 := (hbm_iff id2 hid2).mp hsteq.symm
    have hadj_zx : ∀ k (hk : k < (jumps kops).length) (hk1 : k + 1 < (jumps kops).length),
        baseId ≤ k → k + 1 ≤ id2 →
        ((jumps kops)[k]).z = ((jumps kops)[k + 1]).x := by
      intro k hk hk1 hbk hkid2
      have hsk : ((jumps kops)[k]).step = ((jumps kops)[id1]).step :=
        (hbm_iff k hk).mpr ⟨hbk, by omega⟩
      have hsk1 : ((jumps kops)[k + 1]).step = ((jumps kops)[id1]).step :=
        (hbm_iff (k + 1) hk1).mpr ⟨by omega, by omega⟩
      have hjo := hjump.jump_order k hk (k + 1) hk1 (by omega)
      have hjk_lt : ((jumps kops)[k]).j < ((jumps kops)[k + 1]).j := by
        rcases hjo with hlt | ⟨_, hjlt⟩
        · omega
        · exact hjlt
      have hjak := hjump.jump_anatomies k hk
      have hjak1 := hjump.jump_anatomies (k + 1) hk1
      have hmk : ((jumps kops)[k]).m = ((jumps kops)[k + 1]).m := by
        have hm1 := hjak.2.2.2.2.2.2.2.2.1.1
        have hm2 := hjak1.2.2.2.2.2.2.2.2.1.1
        rw [hsk] at hm1
        rw [hsk1] at hm2
        exact hm1.trans hm2.symm
      have hj1_lt_m : ((jumps kops)[k]).j + 1 < ((jumps kops)[k]).m := by
        have := hjak1.2.2.2.1
        omega
      obtain ⟨_, _, _, _, _, hxeq⟩ := hjak.2.2.2.2.2.2.2.2.2 hj1_lt_m
      exact hxeq.symm
    have hchain : ∀ d (hd : id1 + 1 + d ≤ id2),
        ((jumps kops)[id1]).z ≤ ((jumps kops)[id1 + 1 + d]'(lt_of_le_of_lt hd hid2)).x := by
      intro d
      induction d with
      | zero =>
        intro hd
        simp only [Nat.add_zero] at hd ⊢
        exact le_of_eq (hadj_zx id1 hid1 (lt_of_le_of_lt hd hid2) hb1.1 hd)
      | succ d ih =>
        intro hd
        have hk_le : id1 + 1 + d ≤ id2 := by omega
        have hprev := ih hk_le
        have hk_lt : id1 + 1 + d < (jumps kops).length := lt_of_le_of_lt hk_le hid2
        have hk1_lt : id1 + 1 + d + 1 < (jumps kops).length :=
          lt_of_le_of_lt (by simpa [Nat.add_assoc] using hd) hid2
        have hjak := hjump.jump_anatomies (id1 + 1 + d) hk_lt
        have hxz : ((jumps kops)[id1 + 1 + d]).x < ((jumps kops)[id1 + 1 + d]).z := by omega
        have hzx := hadj_zx (id1 + 1 + d) hk_lt hk1_lt (by omega) (by simpa [Nat.add_assoc] using hd)
        have h_idx : id1 + 1 + (d + 1) = id1 + 1 + d + 1 := by omega
        simpa [h_idx] using le_trans hprev (le_trans (le_of_lt hxz) (le_of_eq hzx))
    have h_eq : id1 + 1 + (id2 - (id1 + 1)) = id2 := by omega
    have hres := hchain (id2 - (id1 + 1)) (by omega)
    simpa [h_eq] using hres

  have h_jump_mem_inorder : ∀ id (hid : id < (jumps kops).length),
      ((jumps kops)[id]).x ∈ inorderNat (keyedState kops ((jumps kops)[id]).step) ∧
      ((jumps kops)[id]).x ∈ inorderNat (keyedState kops (((jumps kops)[id]).step + 1)) ∧
      ((jumps kops)[id]).y ∈ inorderNat (keyedState kops ((jumps kops)[id]).step) := by
    intro id hid
    have hja := hjump.jump_anatomies id hid
    have hst : ((jumps kops)[id]).step < kops.length := hja.2.1
    obtain ⟨_, _, hx_ls, hy_ls, _⟩ := hja.2.2.2.2.2.2.2.2.1
    have hx_in : ((jumps kops)[id]).x ∈ inorderNat (keyedState kops ((jumps kops)[id]).step) :=
      h_ls_sub_inorder _ _ (List.mem_of_getElem? hx_ls)
    have hy_in : ((jumps kops)[id]).y ∈ inorderNat (keyedState kops ((jumps kops)[id]).step) :=
      h_ls_sub_inorder _ _ (List.mem_of_getElem? hy_ls)
    obtain ⟨_, hps⟩ := h_jump_popStep id hid
    have hxP : ((jumps kops)[id]).x < P := by omega
    have hsx : ((jumps kops)[id]).s < ((jumps kops)[id]).x := hja.2.2.2.2.1
    have hp_lt : ((jumps kops)[id]).step < popStep kops ((jumps kops)[id]).x := by
      rw [← hps]; exact hkvalid.popStep_mono _ _ hsx hxP
    have hbx := (hkvalid.mem_inorder_iff _ (le_of_lt hst) _).mp hx_in
    have hx_in1 : ((jumps kops)[id]).x ∈ inorderNat (keyedState kops (((jumps kops)[id]).step + 1)) :=
      (hkvalid.mem_inorder_iff _ hst _).mpr ⟨hxP, by omega, by omega⟩
    exact ⟨hx_in, hx_in1, hy_in⟩

  have h_lcrs_mono_interval : ∀ (ta tb v : ℕ),
      ta ≤ tb → tb ≤ kops.length →
      v ∈ inorderNat (keyedState kops ta) →
      v ∈ inorderNat (keyedState kops tb) →
      lcrsParent P (foldBST P (keyedState kops ta)).1 v ≤
        lcrsParent P (foldBST P (keyedState kops tb)).1 v := by
    intro ta tb v htab htb_len hva hvb
    have ha_iff := (hkvalid.mem_inorder_iff ta (le_trans htab htb_len) v).mp hva
    have hb_iff := (hkvalid.mem_inorder_iff tb htb_len v).mp hvb
    have hmem_all : ∀ t, ta ≤ t → t ≤ tb → v ∈ inorderNat (keyedState kops t) := by
      intro t h1 h2
      exact (hkvalid.mem_inorder_iff t (le_trans h2 htb_len) v).mpr ⟨ha_iff.1, by omega, by omega⟩
    have hstep : ∀ d, ta + d ≤ tb →
        lcrsParent P (foldBST P (keyedState kops ta)).1 v ≤
          lcrsParent P (foldBST P (keyedState kops (ta + d))).1 v := by
      intro d
      induction d with
      | zero => intro _; simp
      | succ d ih =>
        intro hd
        have h1 := ih (by omega)
        have h2 := hfold.lcrs_mono (ta + d) (by omega) v
          (hmem_all (ta + d) (by omega) (by omega))
          (hmem_all (ta + d + 1) (by omega) (by simpa [Nat.add_assoc] using hd))
        exact le_trans h1 (by simpa [Nat.add_assoc] using h2)
    have hres := hstep (tb - ta) (by omega)
    rwa [Nat.add_sub_of_le htab] at hres

  have h_vact_full : ∀ (ℓ Xi p : ℕ), 1 ≤ ℓ → ℓ ≤ L →
      Xi < (scaleBlocks S P (ℓ - 1)).length →
      p < (splitBlock (S ℓ) ((scaleBlocks S P (ℓ - 1)).getD Xi (0, 0)).1
        ((scaleBlocks S P (ℓ - 1)).getD Xi (0, 0)).2).length - 1 →
      let X := (scaleBlocks S P (ℓ - 1)).getD Xi (0, 0)
      let subs := splitBlock (S ℓ) X.1 X.2
      let sp := subs.getD p (0, 0)
      sp.1 < sp.2 ∧ sp.2 ≤ P ∧
      (∀ id ∈ VActSet S P L kops ℓ Xi p,
        ∃ hid : id < (jumps kops).length,
          jScale id = ℓ ∧ Xi_of id = Xi ∧ p_of id = p ∧ subs_of id = subs ∧
          sepScale S P L ((jumps kops)[id]).x ((jumps kops)[id]).y = ℓ ∧
          sepScale S P L ((jumps kops)[id]).s ((jumps kops)[id]).x = ℓ ∧
          blockIdx S P (ℓ - 1) ((jumps kops)[id]).x = Xi ∧
          X.1 ≤ ((jumps kops)[id]).x ∧ ((jumps kops)[id]).x < X.2 ∧
          X.1 ≤ ((jumps kops)[id]).y ∧ ((jumps kops)[id]).y < X.2 ∧
          sp.1 ≤ ((jumps kops)[id]).s ∧ ((jumps kops)[id]).s < sp.2 ∧
          sp = blockOf S P ℓ ((jumps kops)[id]).s ∧
          p < cx_of id ∧ cx_of id < cy_of id ∧ cy_of id < subs.length ∧
          subs.getD (cx_of id) (0, 0) = blockOf S P ℓ ((jumps kops)[id]).x ∧
          subs.getD (cy_of id) (0, 0) = blockOf S P ℓ ((jumps kops)[id]).y ∧
          (subs.getD (cx_of id) (0, 0)).1 ≤ ((jumps kops)[id]).x ∧
          ((jumps kops)[id]).x < (subs.getD (cx_of id) (0, 0)).2 ∧
          (subs.getD (cy_of id) (0, 0)).1 ≤ ((jumps kops)[id]).y ∧
          ((jumps kops)[id]).y < (subs.getD (cy_of id) (0, 0)).2 ∧
          sp.2 ≤ (blockOf S P ℓ ((jumps kops)[id]).x).1 ∧
          (blockOf S P ℓ ((jumps kops)[id]).y).2 ≤ ((jumps kops)[id]).z ∧
          popStep kops sp.1 ≤ ((jumps kops)[id]).step ∧
          ((jumps kops)[id]).step < tEmpty kops sp.1 sp.2) ∧
      (∀ id1 ∈ VActSet S P L kops ℓ Xi p, ∀ id2 ∈ VActSet S P L kops ℓ Xi p,
        cy_of id1 = cy_of id2 → id1 = id2) := by
    intro ℓ Xi p hℓ1 hℓL hXi hp
    have hcb := hpart.child_blocks ℓ hℓ1 hℓL Xi hXi
    dsimp (config := { failIfUnchanged := false }) only at hcb ⊢
    obtain ⟨_, _, _, hsub_bounds, _, hX_iff, hsub_get, hsub_eq_iff⟩ := hcb
    have hdisj_here := h_sub_disj ℓ Xi hℓ1 hℓL hXi
    have hX_mem : (scaleBlocks S P (ℓ - 1)).getD Xi (0, 0) ∈ scaleBlocks S P (ℓ - 1) := by
      rw [List.getD_eq_getElem?_getD, List.getElem?_eq_getElem hXi]
      exact List.getElem_mem hXi
    have hX_le_P : ((scaleBlocks S P (ℓ - 1)).getD Xi (0, 0)).2 ≤ P :=
      (hpart.blocks_bounds (ℓ - 1) (by omega) _ hX_mem).2.1
    set X := (scaleBlocks S P (ℓ - 1)).getD Xi (0, 0)
    set subs := splitBlock (S ℓ) X.1 X.2
    set sp := subs.getD p (0, 0)
    have hp_lt : p < subs.length := by omega
    have hsp_bounds := hsub_bounds p hp_lt
    have hsp_lt : sp.1 < sp.2 := hsp_bounds.2.1
    have hsp_le_P : sp.2 ≤ P := le_trans hsp_bounds.2.2.1 hX_le_P
    have h_props : ∀ id ∈ VActSet S P L kops ℓ Xi p,
        ∃ hid : id < (jumps kops).length,
          jScale id = ℓ ∧ Xi_of id = Xi ∧ p_of id = p ∧ subs_of id = subs ∧
          sepScale S P L ((jumps kops)[id]).x ((jumps kops)[id]).y = ℓ ∧
          sepScale S P L ((jumps kops)[id]).s ((jumps kops)[id]).x = ℓ ∧
          blockIdx S P (ℓ - 1) ((jumps kops)[id]).x = Xi ∧
          X.1 ≤ ((jumps kops)[id]).x ∧ ((jumps kops)[id]).x < X.2 ∧
          X.1 ≤ ((jumps kops)[id]).y ∧ ((jumps kops)[id]).y < X.2 ∧
          sp.1 ≤ ((jumps kops)[id]).s ∧ ((jumps kops)[id]).s < sp.2 ∧
          sp = blockOf S P ℓ ((jumps kops)[id]).s ∧
          p < cx_of id ∧ cx_of id < cy_of id ∧ cy_of id < subs.length ∧
          subs.getD (cx_of id) (0, 0) = blockOf S P ℓ ((jumps kops)[id]).x ∧
          subs.getD (cy_of id) (0, 0) = blockOf S P ℓ ((jumps kops)[id]).y ∧
          (subs.getD (cx_of id) (0, 0)).1 ≤ ((jumps kops)[id]).x ∧
          ((jumps kops)[id]).x < (subs.getD (cx_of id) (0, 0)).2 ∧
          (subs.getD (cy_of id) (0, 0)).1 ≤ ((jumps kops)[id]).y ∧
          ((jumps kops)[id]).y < (subs.getD (cy_of id) (0, 0)).2 ∧
          sp.2 ≤ (blockOf S P ℓ ((jumps kops)[id]).x).1 ∧
          (blockOf S P ℓ ((jumps kops)[id]).y).2 ≤ ((jumps kops)[id]).z ∧
          popStep kops sp.1 ≤ ((jumps kops)[id]).step ∧
          ((jumps kops)[id]).step < tEmpty kops sp.1 sp.2 := by
      intro id hidV
      simp only [VActSet, Finset.mem_filter] at hidV
      obtain ⟨hb3, hvact⟩ := hidV
      obtain ⟨hid, _, _, hsx_eq, hby_z, hte_bs⟩ := h_b3act_props id hb3
      unfold isVAct at hvact
      rw [List.getElem?_eq_getElem hid] at hvact
      simp only [decide_eq_true_eq] at hvact
      obtain ⟨hxy_ℓ, hbidx_x, hs_sp1, hs_sp2⟩ := hvact
      have hs_sp1' : sp.1 ≤ ((jumps kops)[id]).s := hs_sp1
      have hs_sp2' : ((jumps kops)[id]).s < sp.2 := hs_sp2
      have hs_sub1 : (subs.getD p (0, 0)).1 ≤ ((jumps kops)[id]).s := hs_sp1'
      have hs_sub2 : ((jumps kops)[id]).s < (subs.getD p (0, 0)).2 := hs_sp2'
      rw [hxy_ℓ] at hsx_eq hby_z hte_bs
      have hja := hjump.jump_anatomies id hid
      have hsx : ((jumps kops)[id]).s < ((jumps kops)[id]).x := hja.2.2.2.2.1
      have hxy : ((jumps kops)[id]).x < ((jumps kops)[id]).y := hja.2.2.2.2.2.1
      have hxP : ((jumps kops)[id]).x < P := by omega
      have hyP : ((jumps kops)[id]).y < P := by omega
      have hsP : ((jumps kops)[id]).s < P := by omega
      have hx_in_X := (hX_iff _ hxP).mp hbidx_x
      have hbidx_y : blockIdx S P (ℓ - 1) ((jumps kops)[id]).y = Xi := by
        have := (hpart.sep_gt_iff (ℓ - 1) (by omega) _ hxP _ hyP).mp (by omega)
        omega
      have hy_in_X := (hX_iff _ hyP).mp hbidx_y
      have hs_in_X : X.1 ≤ ((jumps kops)[id]).s ∧ ((jumps kops)[id]).s < X.2 :=
        ⟨le_trans hsp_bounds.1 hs_sp1', lt_of_lt_of_le hs_sp2' hsp_bounds.2.2.1⟩
      have hjs_eq : jScale id = ℓ := by simp [jScale, List.getElem?_eq_getElem hid, hxy_ℓ]
      have hxi_eq : Xi_of id = Xi := by simp [Xi_of, hjs_eq, List.getElem?_eq_getElem hid, hbidx_x]
      have hsubs_eq : subs_of id = subs := by simp [subs_of, hjs_eq, hxi_eq, X, subs]
      obtain ⟨hcs_lt, hcs_eq⟩ := hsub_get _ hs_in_X.1 hs_in_X.2
      obtain ⟨hcx_lt, hcx_eq⟩ := hsub_get _ hx_in_X.1 hx_in_X.2
      obtain ⟨hcy_lt, hcy_eq⟩ := hsub_get _ hy_in_X.1 hy_in_X.2
      have hp_def : p_of id = subs.findIdx (fun b => decide (b.1 ≤ ((jumps kops)[id]).s ∧ ((jumps kops)[id]).s < b.2)) := by
        simp [p_of, hsubs_eq, List.getElem?_eq_getElem hid]
      have hcx_def : cx_of id = subs.findIdx (fun b => decide (b.1 ≤ ((jumps kops)[id]).x ∧ ((jumps kops)[id]).x < b.2)) := by
        simp [cx_of, hsubs_eq, List.getElem?_eq_getElem hid]
      have hcy_def : cy_of id = subs.findIdx (fun b => decide (b.1 ≤ ((jumps kops)[id]).y ∧ ((jumps kops)[id]).y < b.2)) := by
        simp [cy_of, hsubs_eq, List.getElem?_eq_getElem hid]
      rw [← hp_def] at hcs_lt hcs_eq
      rw [← hcx_def] at hcx_lt hcx_eq
      rw [← hcy_def] at hcy_lt hcy_eq
      have hbs := hpart.blocks_partition ℓ hℓL _ hsP
      have hbx := hpart.blocks_partition ℓ hℓL _ hxP
      have hby := hpart.blocks_partition ℓ hℓL _ hyP
      have hp_eq : p_of id = p := by
        rw [← hcs_eq] at hbs
        by_contra hne
        rcases lt_or_gt_of_ne hne with hlt | hgt
        · have hdisj := hdisj_here (p_of id) p hlt hp_lt; omega
        · have hdisj := hdisj_here p (p_of id) hgt hcs_lt; omega
      have hsp_eq_bo : sp = blockOf S P ℓ ((jumps kops)[id]).s := by
        rw [← hcs_eq, hp_eq]
      have hp_lt_cx : p < cx_of id := by
        have hne : p_of id ≠ cx_of id := by
          intro heq
          rw [hp_def, hcx_def] at heq
          have hbidx := (hsub_eq_iff _ hs_in_X.1 hs_in_X.2 _ hx_in_X.1 hx_in_X.2).mp heq
          have hgt := (hpart.sep_gt_iff ℓ hℓL _ hsP _ hxP).mpr hbidx
          omega
        rw [hp_eq] at hne
        by_contra hge
        have hlt_cx : cx_of id < p := by omega
        have hdisj := hdisj_here (cx_of id) p hlt_cx hp_lt
        rw [hcx_eq] at hdisj
        omega
      have hcx_lt_cy : cx_of id < cy_of id := by
        have hne : cx_of id ≠ cy_of id := by
          intro heq
          rw [hcx_def, hcy_def] at heq
          have hbidx := (hsub_eq_iff _ hx_in_X.1 hx_in_X.2 _ hy_in_X.1 hy_in_X.2).mp heq
          have hgt := (hpart.sep_gt_iff ℓ hℓL _ hxP _ hyP).mpr hbidx
          omega
        by_contra hge
        have hlt_cy : cy_of id < cx_of id := by omega
        have hdisj := hdisj_here (cy_of id) (cx_of id) hlt_cy hcx_lt
        rw [hcy_eq, hcx_eq] at hdisj
        omega
      have hsp2_le_bx1 : sp.2 ≤ (blockOf S P ℓ ((jumps kops)[id]).x).1 := by
        have hdisj := hdisj_here p (cx_of id) hp_lt_cx hcx_lt
        rwa [hcx_eq] at hdisj
      obtain ⟨_, hps⟩ := h_jump_popStep id hid
      have hts_le_st : popStep kops sp.1 ≤ ((jumps kops)[id]).step := by
        rcases eq_or_lt_of_le hs_sp1' with heq | hlt
        · rw [heq, hps]
        · rw [← hps]; exact le_of_lt (hkvalid.popStep_mono _ _ hlt hsP)
      rw [← hsp_eq_bo] at hte_bs
      exact ⟨hid, hjs_eq, hxi_eq, hp_eq, hsubs_eq, hxy_ℓ, hsx_eq, hbidx_x,
        hx_in_X.1, hx_in_X.2, hy_in_X.1, hy_in_X.2, hs_sp1', hs_sp2', hsp_eq_bo,
        hp_lt_cx, hcx_lt_cy, hcy_lt, hcx_eq, hcy_eq,
        by rw [hcx_eq]; exact hbx.2.1, by rw [hcx_eq]; exact hbx.2.2.1,
        by rw [hcy_eq]; exact hby.2.1, by rw [hcy_eq]; exact hby.2.2.1,
        hsp2_le_bx1, hby_z, hts_le_st, hte_bs⟩
    have h_inj_cy : ∀ id1 ∈ VActSet S P L kops ℓ Xi p, ∀ id2 ∈ VActSet S P L kops ℓ Xi p,
        cy_of id1 = cy_of id2 → id1 = id2 := by
      have h_no_lt : ∀ id1 ∈ VActSet S P L kops ℓ Xi p, ∀ id2 ∈ VActSet S P L kops ℓ Xi p,
          id1 < id2 → cy_of id1 = cy_of id2 → False := by
        intro id1 hid1V id2 hid2V hid12 hcy_eq
        obtain ⟨h1_lt, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, hcx1_cy1, hcy1_lt,
          hcx1_bo, hcy1_bo, hcx1_lo, hcx1_hi, hcy1_lo, _, hsp2_bx1, hby1_z, _, _⟩ := h_props id1 hid1V
        obtain ⟨h2_lt, _, _, _, _, _, _, _, _, _, _, _, _, hs2_sp2, _, _, _, _,
          _, _, _, _, hcy2_lo, hcy2_hi, _, _, _, _⟩ := h_props id2 hid2V
        have hja1 := hjump.jump_anatomies id1 h1_lt
        have hja2 := hjump.jump_anatomies id2 h2_lt
        have hx1P : ((jumps kops)[id1]).x < P := by omega
        have hcx1_le_cy1 := hdisj_here (cx_of id1) (cy_of id1) hcx1_cy1 hcy1_lt
        rw [← hcy1_bo] at hby1_z
        rw [hcy_eq] at hcx1_le_cy1 hby1_z hcy1_lo
        have hstep12 : ((jumps kops)[id1]).step < ((jumps kops)[id2]).step := by
          rcases hjump.jump_order id1 h1_lt id2 h2_lt hid12 with hlt | ⟨heq_st, _⟩
          · exact hlt
          · have hzx := h_same_step_z_le_x id1 h1_lt id2 h2_lt hid12 heq_st
            omega
        obtain ⟨_, hps2⟩ := h_jump_popStep id2 h2_lt
        rw [← hcx1_bo] at hsp2_bx1
        have hs2_lt_x1 : ((jumps kops)[id2]).s < ((jumps kops)[id1]).x := by omega
        have hst2_lt_popx1 : ((jumps kops)[id2]).step < popStep kops ((jumps kops)[id1]).x := by
          rw [← hps2]; exact hkvalid.popStep_mono _ _ hs2_lt_x1 hx1P
        obtain ⟨_, _, _, hy2_ls_get, _⟩ := hja2.2.2.2.2.2.2.2.2.1
        have hy2_ls : ((jumps kops)[id2]).y ∈
            leftSpineBottomUpNat (foldBST P (keyedState kops ((jumps kops)[id2]).step)).1 := by
          rw [hfold.fold_leftSpine _ (le_of_lt hja2.2.1)]
          exact List.mem_append_left _ (List.mem_of_getElem? hy2_ls_get)
        have hslock := ((hfold.spine_lock id1 h1_lt).2 ((jumps kops)[id2]).step
          (by omega) (le_of_lt hst2_lt_popx1)).1 ((jumps kops)[id2]).y hy2_ls
        exact hslock ⟨by omega, by omega⟩
      intro id1 h1 id2 h2 heq
      rcases lt_trichotomy id1 id2 with hlt | rfl | hgt
      · exact False.elim (h_no_lt id1 h1 id2 h2 hlt heq)
      · rfl
      · exact False.elim (h_no_lt id2 h2 id1 h1 hgt heq.symm)
    exact ⟨hsp_lt, hsp_le_P, h_props, h_inj_cy⟩

  have h_b3_in_vact : ∀ id ∈ B_3_act S P L kops,
      1 ≤ jScale id ∧ jScale id ≤ L ∧
      Xi_of id < (scaleBlocks S P (jScale id - 1)).length ∧
      p_of id < (subs_of id).length - 1 ∧
      id ∈ VActSet S P L kops (jScale id) (Xi_of id) (p_of id) := by
    intro id hb3
    obtain ⟨hid, hℓ1, hℓL, hsx_eq, _, _⟩ := h_b3act_props id hb3
    have hja := hjump.jump_anatomies id hid
    have hsx : ((jumps kops)[id]).s < ((jumps kops)[id]).x := hja.2.2.2.2.1
    have hxP : ((jumps kops)[id]).x < P := by omega
    have hsP : ((jumps kops)[id]).s < P := by omega
    have hjs : jScale id = sepScale S P L ((jumps kops)[id]).x ((jumps kops)[id]).y := by
      simp [jScale, List.getElem?_eq_getElem hid]
    rw [← hjs] at hℓ1 hℓL hsx_eq
    have hxi_lt : Xi_of id < (scaleBlocks S P (jScale id - 1)).length := by
      simp only [Xi_of, List.getElem?_eq_getElem hid]
      exact (hpart.blocks_partition (jScale id - 1) (by omega) _ hxP).1
    have hcb := hpart.child_blocks (jScale id) hℓ1 hℓL (Xi_of id) hxi_lt
    dsimp (config := { failIfUnchanged := false }) only at hcb
    obtain ⟨_, _, _, _, _, hX_iff, hsub_get, hsub_eq_iff⟩ := hcb
    have hdisj_here := h_sub_disj (jScale id) (Xi_of id) hℓ1 hℓL hxi_lt
    have hx_in_X : ((scaleBlocks S P (jScale id - 1)).getD (Xi_of id) (0, 0)).1 ≤ ((jumps kops)[id]).x ∧
        ((jumps kops)[id]).x < ((scaleBlocks S P (jScale id - 1)).getD (Xi_of id) (0, 0)).2 := by
      refine (hX_iff _ hxP).mp ?_
      simp [Xi_of, List.getElem?_eq_getElem hid]
    have hbidx_s : blockIdx S P (jScale id - 1) ((jumps kops)[id]).s = Xi_of id := by
      have hgt : jScale id - 1 < sepScale S P L ((jumps kops)[id]).s ((jumps kops)[id]).x := by omega
      have := (hpart.sep_gt_iff (jScale id - 1) (by omega) _ hsP _ hxP).mp hgt
      simpa [Xi_of, List.getElem?_eq_getElem hid] using this
    have hs_in_X := (hX_iff _ hsP).mp hbidx_s
    obtain ⟨hp_lt, hp_eq⟩ := hsub_get _ hs_in_X.1 hs_in_X.2
    obtain ⟨hcx_lt, hcx_eq⟩ := hsub_get _ hx_in_X.1 hx_in_X.2
    have hsubs_def : splitBlock (S (jScale id))
        ((scaleBlocks S P (jScale id - 1)).getD (Xi_of id) (0, 0)).1
        ((scaleBlocks S P (jScale id - 1)).getD (Xi_of id) (0, 0)).2 = subs_of id := rfl
    rw [hsubs_def] at hp_lt hp_eq hcx_lt hcx_eq
    have hp_def : p_of id = (subs_of id).findIdx (fun b => decide (b.1 ≤ ((jumps kops)[id]).s ∧ ((jumps kops)[id]).s < b.2)) := by
      simp [p_of, List.getElem?_eq_getElem hid]
    have hcx_def : cx_of id = (subs_of id).findIdx (fun b => decide (b.1 ≤ ((jumps kops)[id]).x ∧ ((jumps kops)[id]).x < b.2)) := by
      simp [cx_of, List.getElem?_eq_getElem hid]
    rw [← hp_def] at hp_lt hp_eq
    rw [← hcx_def] at hcx_lt hcx_eq
    have hne : p_of id ≠ cx_of id := by
      intro heq
      rw [hp_def, hcx_def] at heq
      have hbidx := (hsub_eq_iff _ hs_in_X.1 hs_in_X.2 _ hx_in_X.1 hx_in_X.2).mp heq
      have hgt := (hpart.sep_gt_iff (jScale id) hℓL _ hsP _ hxP).mpr hbidx
      omega
    have hbs := hpart.blocks_partition (jScale id) hℓL _ hsP
    have hbx := hpart.blocks_partition (jScale id) hℓL _ hxP
    have hp_lt_cx : p_of id < cx_of id := by
      by_contra hge
      have hgt_cx : cx_of id < p_of id := by omega
      have hdisj := hdisj_here (cx_of id) (p_of id) hgt_cx hp_lt
      change ((subs_of id).getD (cx_of id) (0, 0)).2 ≤ ((subs_of id).getD (p_of id) (0, 0)).1 at hdisj
      rw [hcx_eq, hp_eq] at hdisj
      omega
    have hp_lt_m1 : p_of id < (subs_of id).length - 1 := by omega
    refine ⟨hℓ1, hℓL, hxi_lt, hp_lt_m1, Finset.mem_filter.mpr ⟨hb3, ?_⟩⟩
    unfold isVAct
    dsimp (config := { failIfUnchanged := false }) only
    rw [List.getElem?_eq_getElem hid]
    simp only [decide_eq_true_eq]
    change sepScale S P L ((jumps kops)[id]).x ((jumps kops)[id]).y = jScale id ∧
      blockIdx S P (jScale id - 1) ((jumps kops)[id]).x = Xi_of id ∧
      ((subs_of id).getD (p_of id) (0, 0)).1 ≤ ((jumps kops)[id]).s ∧
      ((jumps kops)[id]).s < ((subs_of id).getD (p_of id) (0, 0)).2
    rw [hp_eq]
    exact ⟨hjs.symm, by simp [Xi_of, List.getElem?_eq_getElem hid], hbs.2.1, hbs.2.2.1⟩

  let isFirstMover : ℕ → Prop := fun id =>
    ∀ id' ∈ VActSet S P L kops (jScale id) (Xi_of id) (p_of id), id' < id → cx_of id' ≠ cx_of id

  have h_nonfirst_prev : ∀ id ∈ B_3_act S P L kops,
      ¬ isFirstMover id → id ∉ MBaseSet kops →
      ∃ (hid : id < (jumps kops).length) (hidR : upperPrevWin kops id < (jumps kops).length),
        let ℓ := jScale id
        let sp := (subs_of id).getD (p_of id) (0, 0)
        let sq := (subs_of id).getD (cy_of id) (0, 0)
        let e := (jumps kops)[id]
        let eR := (jumps kops)[upperPrevWin kops id]
        1 ≤ ℓ ∧ ℓ ≤ L ∧
        eR.x = e.y ∧
        sp.1 ≤ eR.s ∧ eR.s < sp.2 ∧
        sp = blockOf S P ℓ eR.s ∧
        sq = blockOf S P ℓ e.y ∧
        sq.1 ≤ e.y ∧ e.y < sq.2 ∧ sq.2 ≤ e.z ∧
        sepScale S P L eR.s eR.x = ℓ ∧
        popStep kops sp.1 ≤ eR.step ∧
        eR.step < e.step ∧
        e.step < tEmpty kops sp.1 sp.2 := by
    intro id hb3 hnot_fm hnotm
    obtain ⟨hℓ1, hℓL, hxi_lt, hp_lt_m1, hidV⟩ := h_b3_in_vact id hb3
    have hv_all := h_vact_full (jScale id) (Xi_of id) (p_of id) hℓ1 hℓL hxi_lt hp_lt_m1
    dsimp (config := { failIfUnchanged := false }) only at hv_all
    obtain ⟨hsp_lt, hsp_le_P, hv_props, _⟩ := hv_all
    have hex1 : ∃ id1 ∈ VActSet S P L kops (jScale id) (Xi_of id) (p_of id),
        id1 < id ∧ cx_of id1 = cx_of id := by
      unfold isFirstMover at hnot_fm
      push_neg at hnot_fm
      exact hnot_fm
    obtain ⟨id1, hid1V, hid1_lt, hcx1_eq⟩ := hex1
    have hv_id := hv_props id hidV
    have hv_id1 := hv_props id1 hid1V
    have hdisj_here := h_sub_disj (jScale id) (Xi_of id) hℓ1 hℓL hxi_lt
    have hcb := hpart.child_blocks (jScale id) hℓ1 hℓL (Xi_of id) hxi_lt
    dsimp (config := { failIfUnchanged := false }) only at hcb
    set X := (scaleBlocks S P (jScale id - 1)).getD (Xi_of id) (0, 0)
    set subs := splitBlock (S (jScale id)) X.1 X.2
    obtain ⟨hid, _, _, _, _, _, _, _, _, _, hy_X1, hy_X2, hs_sp1, hs_sp2, _,
      hp_lt_cx, hcx_lt_cy, hcy_lt, hcx_bo, hcy_bo, hcx_lo, hcx_hi, hcy_lo, hcy_hi,
      hsp2_bx, hby_z, _, hte_lt⟩ := hv_id
    obtain ⟨hid1, _, _, _, _, _, _, _, _, _, _, _, hs1_sp1, hs1_sp2, _,
      _, hcx1_cy1, hcy1_lt, _, hcy1_bo, hcx1_lo, hcx1_hi, _, _,
      _, hby1_z, _, _⟩ := hv_id1
    obtain ⟨hidL, hidR, _, _, hLx_eq, hLz_eq, hRx_eq, hLR_step, hLR_s, hstL_lt, hmaxL⟩ :=
      hfold.outside_mbase id hid hnotm
    have hja := hjump.jump_anatomies id hid
    have hja1 := hjump.jump_anatomies id1 hid1
    have hjaL := hjump.jump_anatomies (prevWin kops id) hidL
    have hjaR := hjump.jump_anatomies (upperPrevWin kops id) hidR
    have hx1P : ((jumps kops)[id1]).x < P := by omega
    have hxLP : ((jumps kops)[prevWin kops id]).x < P := by omega
    have hcx1_le_cy1 := hdisj_here (cx_of id1) (cy_of id1) hcx1_cy1 hcy1_lt
    have hcx_le_cy := hdisj_here (cx_of id) (cy_of id) hcx_lt_cy hcy_lt
    rw [← hcy1_bo] at hby1_z
    rw [hcx1_eq] at hcx1_le_cy1 hcx1_lo hcx1_hi
    have hstep1_lt : ((jumps kops)[id1]).step < ((jumps kops)[id]).step := by
      rcases hjump.jump_order id1 hid1 id hid hid1_lt with hlt | ⟨heq_st, _⟩
      · exact hlt
      · have hzx := h_same_step_z_le_x id1 hid1 id hid hid1_lt heq_st
        omega
    have hsL_lt_s := h_s_lt_of_step_lt (prevWin kops id) hidL id hid hstL_lt
    have hsL_ge_sp1 : (subs.getD (p_of id) (0, 0)).1 ≤ ((jumps kops)[prevWin kops id]).s := by
      rcases lt_trichotomy ((jumps kops)[id1]).x ((jumps kops)[id]).x with hx_lt | hx_eq | hx_gt
      · exfalso
        obtain ⟨_, hps⟩ := h_jump_popStep id hid
        rw [← hcx_bo] at hsp2_bx
        have hs_lt_x1 : ((jumps kops)[id]).s < ((jumps kops)[id1]).x := by omega
        have hst_lt_popx1 : ((jumps kops)[id]).step < popStep kops ((jumps kops)[id1]).x := by
          rw [← hps]; exact hkvalid.popStep_mono _ _ hs_lt_x1 hx1P
        obtain ⟨_, _, hx_ls_get, _, _⟩ := hja.2.2.2.2.2.2.2.2.1
        have hx_ls : ((jumps kops)[id]).x ∈
            leftSpineBottomUpNat (foldBST P (keyedState kops ((jumps kops)[id]).step)).1 := by
          rw [hfold.fold_leftSpine _ (le_of_lt hja.2.1)]
          exact List.mem_append_left _ (List.mem_of_getElem? hx_ls_get)
        have hslock := ((hfold.spine_lock id1 hid1).2 ((jumps kops)[id]).step
          (by omega) (le_of_lt hst_lt_popx1)).1 ((jumps kops)[id]).x hx_ls
        exact hslock ⟨hx_lt, by omega⟩
      · have hid1_le_L : id1 ≤ prevWin kops id := hmaxL id1 hid1_lt hx_eq
        have hst1_le_L : ((jumps kops)[id1]).step ≤ ((jumps kops)[prevWin kops id]).step := by
          rcases eq_or_lt_of_le hid1_le_L with rfl | hlt
          · exact le_rfl
          · rcases hjump.jump_order id1 hid1 (prevWin kops id) hidL hlt with h1 | ⟨h1, _⟩
            · exact le_of_lt h1
            · exact le_of_eq h1
        have hs1_le_sL := h_s_le_of_step_le id1 hid1 (prevWin kops id) hidL hst1_le_L
        omega
      · by_contra hlt_sp1
        have hsL_lt_s1 : ((jumps kops)[prevWin kops id]).s < ((jumps kops)[id1]).s := by omega
        obtain ⟨hs1P, hps1⟩ := h_jump_popStep id1 hid1
        obtain ⟨_, hpsL⟩ := h_jump_popStep (prevWin kops id) hidL
        have hstL_lt_st1 : ((jumps kops)[prevWin kops id]).step < ((jumps kops)[id1]).step := by
          rw [← hpsL, ← hps1]; exact hkvalid.popStep_mono _ _ hsL_lt_s1 hs1P
        rw [← hcx_bo] at hsp2_bx
        have hs1_lt_xL : ((jumps kops)[id1]).s < ((jumps kops)[prevWin kops id]).x := by omega
        have hst1_lt_popxL : ((jumps kops)[id1]).step < popStep kops ((jumps kops)[prevWin kops id]).x := by
          rw [← hps1]; exact hkvalid.popStep_mono _ _ hs1_lt_xL hxLP
        obtain ⟨_, _, hx1_ls_get, _, _⟩ := hja1.2.2.2.2.2.2.2.2.1
        have hx1_ls : ((jumps kops)[id1]).x ∈
            leftSpineBottomUpNat (foldBST P (keyedState kops ((jumps kops)[id1]).step)).1 := by
          rw [hfold.fold_leftSpine _ (le_of_lt hja1.2.1)]
          exact List.mem_append_left _ (List.mem_of_getElem? hx1_ls_get)
        have hslock := ((hfold.spine_lock (prevWin kops id) hidL).2 ((jumps kops)[id1]).step
          (by omega) (le_of_lt hst1_lt_popxL)).1 ((jumps kops)[id1]).x hx1_ls
        exact hslock ⟨by omega, by omega⟩
    have hsR_sp1 : (subs.getD (p_of id) (0, 0)).1 ≤ ((jumps kops)[upperPrevWin kops id]).s := by omega
    have hsR_sp2 : ((jumps kops)[upperPrevWin kops id]).s < (subs.getD (p_of id) (0, 0)).2 := by omega
    have hrec := h_coord_rec (jScale id) hℓ1 hℓL (Xi_of id) hxi_lt (p_of id) (cy_of id)
      (lt_trans hp_lt_cx hcx_lt_cy) hcy_lt
      ((jumps kops)[upperPrevWin kops id]).s ((jumps kops)[id]).y
      hsR_sp1 hsR_sp2 hcy_lo hcy_hi
    have hsep_sR_x : sepScale S P L ((jumps kops)[upperPrevWin kops id]).s
        ((jumps kops)[upperPrevWin kops id]).x = jScale id := by
      rw [hRx_eq]; exact hrec.2.2.1
    have hsp_bo_sR : subs.getD (p_of id) (0, 0) =
        blockOf S P (jScale id) ((jumps kops)[upperPrevWin kops id]).s := by
      obtain ⟨_, _, _, hsub_bds, _, _, hsub_get, _⟩ := hcb
      have hp_bds := hsub_bds (p_of id) (lt_trans hp_lt_cx (lt_trans hcx_lt_cy hcy_lt))
      obtain ⟨_, hbo_eq⟩ := hsub_get ((jumps kops)[upperPrevWin kops id]).s (by omega) (by omega)
      have hfidx_sR : subs.findIdx (fun b =>
          decide (b.1 ≤ ((jumps kops)[upperPrevWin kops id]).s ∧
            ((jumps kops)[upperPrevWin kops id]).s < b.2)) = p_of id := hrec.2.2.2.2.1
      rw [hfidx_sR] at hbo_eq
      exact hbo_eq
    obtain ⟨hsRP, hpsR⟩ := h_jump_popStep (upperPrevWin kops id) hidR
    have hts_le_stR : popStep kops (subs.getD (p_of id) (0, 0)).1 ≤
        ((jumps kops)[upperPrevWin kops id]).step := by
      rcases eq_or_lt_of_le hsR_sp1 with heq | hlt
      · rw [heq, hpsR]
      · rw [← hpsR]; exact le_of_lt (hkvalid.popStep_mono _ _ hlt hsRP)
    have hby_z' : (subs.getD (cy_of id) (0, 0)).2 ≤ ((jumps kops)[id]).z := by rwa [hcy_bo]
    exact ⟨hid, hidR, hℓ1, hℓL, hRx_eq, hsR_sp1, hsR_sp2, hsp_bo_sR, hcy_bo, hcy_lo, hcy_hi,
      hby_z', hsep_sR_x, hts_le_stR, by omega, hte_lt⟩

  set A_esc : Finset ℕ := (B_3_act S P L kops).filter (fun id =>
    decide ((¬ isFirstMover id) ∧
      (id ∈ MBaseSet kops ∨ upperPrevWin kops id ∉ B_3_act S P L kops)))

  have h_epoch_bound : ∀ (ℓ Xi p : ℕ), 1 ≤ ℓ → ℓ ≤ L →
      Xi < (scaleBlocks S P (ℓ - 1)).length →
      p < (splitBlock (S ℓ) ((scaleBlocks S P (ℓ - 1)).getD Xi (0, 0)).1
        ((scaleBlocks S P (ℓ - 1)).getD Xi (0, 0)).2).length - 1 →
      (VActSet S P L kops ℓ Xi p).card ≤
        2 * (MMovSet S P L kops ℓ Xi p).card +
          (VActSet S P L kops ℓ Xi p ∩ A_esc).card := by
    intro ℓ Xi p hℓ1 hℓL hXi hp
    obtain ⟨_, _, hv_props, hinj_cy⟩ := h_vact_full ℓ Xi p hℓ1 hℓL hXi hp
    set X := (scaleBlocks S P (ℓ - 1)).getD Xi (0, 0)
    set subs := splitBlock (S ℓ) X.1 X.2
    let V := VActSet S P L kops ℓ Xi p
    let phi_x : ℕ → ℕ := fun id =>
      match (jumps kops)[id]? with
      | none => 0
      | some e => subs.findIdx (fun b => decide (b.1 ≤ e.x ∧ e.x < b.2))
    let phi_y : ℕ → ℕ := fun id =>
      match (jumps kops)[id]? with
      | none => 0
      | some e => subs.findIdx (fun b => decide (b.1 ≤ e.y ∧ e.y < b.2))
    have hM_eq : MMovSet S P L kops ℓ Xi p = V.image phi_x := rfl
    have hphi_x_eq : ∀ id ∈ V, phi_x id = cx_of id := by
      intro id hidV
      obtain ⟨hid, _, _, _, hsubs_eq, _⟩ := hv_props id hidV
      simp [phi_x, cx_of, hsubs_eq, subs, List.getElem?_eq_getElem hid]
    have hphi_y_eq : ∀ id ∈ V, phi_y id = cy_of id := by
      intro id hidV
      obtain ⟨hid, _, _, _, hsubs_eq, _⟩ := hv_props id hidV
      simp [phi_y, cy_of, hsubs_eq, subs, List.getElem?_eq_getElem hid]

    let N_tilde := V.filter (fun id => decide (isFirstMover id))
    let D_der := (V \ N_tilde).filter (fun id =>
      decide (id ∉ MBaseSet kops ∧ upperPrevWin kops id ∈ B_3_act S P L kops))

    have hV_sub : V ⊆ N_tilde ∪ D_der ∪ (V ∩ A_esc) := by
      intro id hidV
      have hb3 : id ∈ B_3_act S P L kops := (Finset.mem_filter.mp hidV).1
      by_cases hfm : isFirstMover id
      · exact Finset.mem_union_left _ (Finset.mem_union_left _
          (Finset.mem_filter.mpr ⟨hidV, decide_eq_true hfm⟩))
      · have hid_vn : id ∈ V \ N_tilde := by
          simp [N_tilde, hidV, hfm]
        by_cases hder : id ∉ MBaseSet kops ∧ upperPrevWin kops id ∈ B_3_act S P L kops
        · exact Finset.mem_union_left _ (Finset.mem_union_right _
            (Finset.mem_filter.mpr ⟨hid_vn, decide_eq_true hder⟩))
        · refine Finset.mem_union_right _ (Finset.mem_inter.mpr ⟨hidV, ?_⟩)
          refine Finset.mem_filter.mpr ⟨hb3, decide_eq_true ⟨hfm, ?_⟩⟩
          by_cases hm : id ∈ MBaseSet kops
          · exact Or.inl hm
          · exact Or.inr fun hr => hder ⟨hm, hr⟩

    have hV_cover : V.card ≤ N_tilde.card + D_der.card + (V ∩ A_esc).card := by
      have h0 := Finset.card_le_card hV_sub
      have h1 := Finset.card_union_le (N_tilde ∪ D_der) (V ∩ A_esc)
      have h2 := Finset.card_union_le N_tilde D_der
      omega

    have hN_le : N_tilde.card ≤ (MMovSet S P L kops ℓ Xi p).card := by
      rw [hM_eq]
      refine Finset.card_le_card_of_injOn phi_x ?_ ?_
      · intro id hidN
        simp only [Finset.mem_coe, N_tilde, Finset.mem_filter] at hidN
        exact Finset.mem_coe.mpr (Finset.mem_image_of_mem phi_x hidN.1)
      · intro a ha b hb heq
        simp only [Finset.mem_coe, N_tilde, Finset.mem_filter, decide_eq_true_eq] at ha hb
        obtain ⟨_, hjs_b, hxi_b, hp_b, _⟩ := hv_props b hb.1
        obtain ⟨_, hjs_a, hxi_a, hp_a, _⟩ := hv_props a ha.1
        rw [hphi_x_eq a ha.1, hphi_x_eq b hb.1] at heq
        rcases lt_trichotomy a b with hlt | rfl | hgt
        · exfalso
          have hfm_b := hb.2
          unfold isFirstMover at hfm_b
          rw [hjs_b, hxi_b, hp_b] at hfm_b
          exact hfm_b a ha.1 hlt heq
        · rfl
        · exfalso
          have hfm_a := ha.2
          unfold isFirstMover at hfm_a
          rw [hjs_a, hxi_a, hp_a] at hfm_a
          exact hfm_a b hb.1 hgt heq.symm

    have hD_le : D_der.card ≤ (MMovSet S P L kops ℓ Xi p).card := by
      rw [hM_eq]
      refine Finset.card_le_card_of_injOn phi_y ?_ ?_
      · intro id hidD
        simp only [Finset.mem_coe, D_der, N_tilde, Finset.mem_filter, Finset.mem_sdiff,
          decide_eq_true_eq] at hidD
        obtain ⟨⟨hidV, hnot_fm_v⟩, hnotm, hR_b3⟩ := hidD
        have hnot_fm : ¬ isFirstMover id := fun h => hnot_fm_v ⟨hidV, h⟩
        have hb3 : id ∈ B_3_act S P L kops := (Finset.mem_filter.mp hidV).1
        obtain ⟨hid, hjs_id, hxi_id, hp_id, hsubs_id, _, _, _, _, _, hy_X1, hy_X2, _⟩ :=
          hv_props id hidV
        obtain ⟨_, hidR, _, _, hRx_eq, hsR_sp1, hsR_sp2, _, _, _, _, _, hsep_sR_x, _, _, _⟩ :=
          h_nonfirst_prev id hb3 hnot_fm hnotm
        rw [hp_id, hsubs_id] at hsR_sp1 hsR_sp2
        rw [hjs_id] at hsep_sR_x
        obtain ⟨_, _, _, hsxR_eq, _, _⟩ := h_b3act_props (upperPrevWin kops id) hR_b3
        have hxyR_ℓ : sepScale S P L ((jumps kops)[upperPrevWin kops id]).x
            ((jumps kops)[upperPrevWin kops id]).y = ℓ := by
          rw [← hsxR_eq]; exact hsep_sR_x
        have hcb := hpart.child_blocks ℓ hℓ1 hℓL Xi hXi
        dsimp (config := { failIfUnchanged := false }) only at hcb
        have hyP : ((jumps kops)[id]).y < P := by
          have := hjump.jump_anatomies id hid; omega
        have hbidx_Rx : blockIdx S P (ℓ - 1) ((jumps kops)[upperPrevWin kops id]).x = Xi := by
          rw [hRx_eq]
          exact (hcb.2.2.2.2.2.1 _ hyP).mpr ⟨hy_X1, hy_X2⟩
        have hidR_V : upperPrevWin kops id ∈ V := by
          refine Finset.mem_filter.mpr ⟨hR_b3, ?_⟩
          unfold isVAct
          dsimp (config := { failIfUnchanged := false }) only
          rw [List.getElem?_eq_getElem hidR]
          simp only [decide_eq_true_eq]
          exact ⟨hxyR_ℓ, hbidx_Rx, hsR_sp1, hsR_sp2⟩
        have hphi_eq : phi_y id = phi_x (upperPrevWin kops id) := by
          simp [phi_y, phi_x, List.getElem?_eq_getElem hid, List.getElem?_eq_getElem hidR, hRx_eq]
        rw [Finset.mem_coe, hphi_eq]
        exact Finset.mem_image_of_mem phi_x hidR_V
      · intro a ha b hb heq
        simp only [Finset.mem_coe, D_der, Finset.mem_filter, Finset.mem_sdiff] at ha hb
        rw [hphi_y_eq a ha.1.1, hphi_y_eq b hb.1.1] at heq
        exact hinj_cy a ha.1.1 b hb.1.1 heq

    change V.card ≤ 2 * (MMovSet S P L kops ℓ Xi p).card + (V ∩ A_esc).card
    omega

  have h_vact_pair_inj_card :
      ∀ (Q T : Finset ℕ) (f u_of v_of : ℕ → ℕ),
        Q ⊆ B_3_act S P L kops →
        (∀ id ∈ Q,
          let sp := (subs_of id).getD (p_of id) (0, 0)
          let sq := (subs_of id).getD (cy_of id) (0, 0)
          f id ∈ T ∧
            sp.1 ≤ u_of (f id) ∧ u_of (f id) < sp.2 ∧
            sq.1 ≤ v_of (f id) ∧ v_of (f id) < sq.2) →
        Q.card ≤ T.card := by
    intro Q T f u_of v_of hQB hQ
    refine Finset.card_le_card_of_injOn f (fun id hid => (hQ id hid).1) ?_
    intro id1 hid1 id2 hid2 hfeq
    obtain ⟨hℓ1_lo, hℓ1_hi, hXi1, hp1_lt, hid1V⟩ := h_b3_in_vact id1 (hQB hid1)
    obtain ⟨hℓ2_lo, hℓ2_hi, hXi2, hp2_lt, hid2V⟩ := h_b3_in_vact id2 (hQB hid2)
    obtain ⟨_, _, hv1_props, hinj1_cy⟩ :=
      h_vact_full (jScale id1) (Xi_of id1) (p_of id1) hℓ1_lo hℓ1_hi hXi1 hp1_lt
    obtain ⟨_, _, hv2_props, _⟩ :=
      h_vact_full (jScale id2) (Xi_of id2) (p_of id2) hℓ2_lo hℓ2_hi hXi2 hp2_lt
    obtain ⟨_, _, _, _, _, _, _, _, _, _, _, _, _, _, _, hp1_cx1, hcx1_cy1, hcy1_lt, _⟩ :=
      hv1_props id1 hid1V
    obtain ⟨_, _, _, _, _, _, _, _, _, _, _, _, _, _, _, hp2_cx2, hcx2_cy2, hcy2_lt, _⟩ :=
      hv2_props id2 hid2V
    obtain ⟨_, hu1_1, hu1_2, hv1_1, hv1_2⟩ := hQ id1 hid1
    obtain ⟨_, hu2_1, hu2_2, hv2_1, hv2_2⟩ := hQ id2 hid2
    rw [← hfeq] at hu2_1 hu2_2 hv2_1 hv2_2
    have hrec1 := h_coord_rec (jScale id1) hℓ1_lo hℓ1_hi (Xi_of id1) hXi1
      (p_of id1) (cy_of id1) (lt_trans hp1_cx1 hcx1_cy1) hcy1_lt
      (u_of (f id1)) (v_of (f id1)) hu1_1 hu1_2 hv1_1 hv1_2
    have hrec2 := h_coord_rec (jScale id2) hℓ2_lo hℓ2_hi (Xi_of id2) hXi2
      (p_of id2) (cy_of id2) (lt_trans hp2_cx2 hcx2_cy2) hcy2_lt
      (u_of (f id1)) (v_of (f id1)) hu2_1 hu2_2 hv2_1 hv2_2
    have hℓ_eq : jScale id1 = jScale id2 := hrec1.2.2.1.symm.trans hrec2.2.2.1
    have hXi_eq : Xi_of id1 = Xi_of id2 := by
      have hb := hrec2.2.2.2.1
      rw [← hℓ_eq] at hb
      exact hrec1.2.2.2.1.symm.trans hb
    have hsubs_eq : subs_of id1 = subs_of id2 := by simp [subs_of, hℓ_eq, hXi_eq]
    have hp_eq : p_of id1 = p_of id2 := by
      have hf2 := hrec2.2.2.2.2.1
      change (subs_of id2).findIdx _ = p_of id2 at hf2
      rw [← hsubs_eq] at hf2
      exact hrec1.2.2.2.2.1.symm.trans hf2
    have hcy_eq : cy_of id1 = cy_of id2 := by
      have hf2 := hrec2.2.2.2.2.2
      change (subs_of id2).findIdx _ = cy_of id2 at hf2
      rw [← hsubs_eq] at hf2
      exact hrec1.2.2.2.2.2.symm.trans hf2
    rw [← hℓ_eq, ← hXi_eq, ← hp_eq] at hid2V
    exact hinj1_cy id1 hid1V id2 hid2V hcy_eq

  have h_esc_bound : A_esc.card ≤
      (MBaseSet kops).card + P + countKeyedRslr kops +
        2 * ((B_fin_pre S P L kops).card + (B_1_exit S P L kops).card +
          (B_3_intra S P L kops).card + (B_3_post S P L kops).card) := by
    let E_omega : Finset ℕ :=
      B_fin_pre S P L kops ∪ B_1_exit S P L kops ∪ B_3_intra S P L kops
    have hE_card : E_omega.card ≤
        (B_fin_pre S P L kops).card + (B_1_exit S P L kops).card +
          (B_3_intra S P L kops).card := by
      have h1 := Finset.card_union_le
        (B_fin_pre S P L kops ∪ B_1_exit S P L kops) (B_3_intra S P L kops)
      have h2 := Finset.card_union_le (B_fin_pre S P L kops) (B_1_exit S P L kops)
      dsimp (config := { failIfUnchanged := false }) only [E_omega]
      omega

    let y_of : ℕ → ℕ := fun id =>
      match (jumps kops)[id]? with | none => 0 | some e => e.y
    let zR_of : ℕ → ℕ := fun id =>
      match (jumps kops)[upperPrevWin kops id]? with | none => 0 | some eR => eR.z

    let CatA := A_esc.filter (fun id => id ∈ MBaseSet kops)
    let CatB := A_esc.filter (fun id =>
      id ∉ MBaseSet kops ∧ jScale (upperPrevWin kops id) < jScale id)
    let CatCD := A_esc.filter (fun id =>
      id ∉ MBaseSet kops ∧ jScale id ≤ jScale (upperPrevWin kops id) ∧
        (jScale id = jScale (upperPrevWin kops id) ∨
          (blockOf S P (jScale id) (y_of id)).2 ≤ zR_of id))
    let CatE := A_esc.filter (fun id =>
      id ∉ MBaseSet kops ∧ jScale id < jScale (upperPrevWin kops id) ∧
        zR_of id < (blockOf S P (jScale id) (y_of id)).2)

    have hAesc_sub : A_esc ⊆ CatA ∪ CatB ∪ CatCD ∪ CatE := by
      intro id hidA
      by_cases hm : id ∈ MBaseSet kops
      · exact Finset.mem_union_left _ (Finset.mem_union_left _ (Finset.mem_union_left _
          (Finset.mem_filter.mpr ⟨hidA, hm⟩)))
      · rcases lt_trichotomy (jScale id) (jScale (upperPrevWin kops id)) with hlt | heq | hgt
        · by_cases hz : (blockOf S P (jScale id) (y_of id)).2 ≤ zR_of id
          · exact Finset.mem_union_left _ (Finset.mem_union_right _
              (Finset.mem_filter.mpr ⟨hidA, hm, le_of_lt hlt, Or.inr hz⟩))
          · exact Finset.mem_union_right _
              (Finset.mem_filter.mpr ⟨hidA, hm, hlt, by omega⟩)
        · exact Finset.mem_union_left _ (Finset.mem_union_right _
            (Finset.mem_filter.mpr ⟨hidA, hm, le_of_eq heq, Or.inl heq⟩))
        · exact Finset.mem_union_left _ (Finset.mem_union_left _ (Finset.mem_union_right _
            (Finset.mem_filter.mpr ⟨hidA, hm, hgt⟩)))

    have hAesc_cover : A_esc.card ≤ CatA.card + CatB.card + CatCD.card + CatE.card := by
      have h0 := Finset.card_le_card hAesc_sub
      have h1 := Finset.card_union_le (CatA ∪ CatB ∪ CatCD) CatE
      have h2 := Finset.card_union_le (CatA ∪ CatB) CatCD
      have h3 := Finset.card_union_le CatA CatB
      omega

    have hCatA_le : CatA.card ≤ (MBaseSet kops).card :=
      Finset.card_le_card fun _ h => (Finset.mem_filter.mp h).2

    have hCatB_le : CatB.card ≤ P := by
      let wKey : ℕ → ℕ := fun id =>
        match (jumps kops)[id]? with
        | none => 0
        | some e => e.x
      have hcard : CatB.card ≤ (Finset.range P).card := by
        refine Finset.card_le_card_of_injOn wKey ?_ ?_
        · intro id hidB
          simp only [Finset.mem_coe, CatB, A_esc, Finset.mem_filter] at hidB
          obtain ⟨hid, _, _, _, _, _⟩ := h_b3act_props id hidB.1.1
          have hja := hjump.jump_anatomies id hid
          simp only [Finset.mem_coe, Finset.mem_range, wKey, List.getElem?_eq_getElem hid]
          omega
        · intro a ha b hb hw_eq
          have h_no_lt : ∀ id1 ∈ CatB, ∀ id2 ∈ CatB, id1 < id2 → wKey id1 = wKey id2 → False := by
            intro id1 hid1B id2 hid2B hid12 hweq
            simp only [CatB, A_esc, Finset.mem_filter] at hid1B hid2B
            obtain ⟨h1_lt, hℓ1_1, hℓ1_L, hsx1_eq, _, _⟩ := h_b3act_props id1 hid1B.1.1
            obtain ⟨h2_lt, hℓ2_1, hℓ2_L, hsx2_eq, _, _⟩ := h_b3act_props id2 hid2B.1.1
            simp only [wKey, List.getElem?_eq_getElem h1_lt, List.getElem?_eq_getElem h2_lt] at hweq
            have hja1 := hjump.jump_anatomies id1 h1_lt
            have hja2 := hjump.jump_anatomies id2 h2_lt
            have hstep12 : ((jumps kops)[id1]).step < ((jumps kops)[id2]).step := by
              rcases hjump.jump_order id1 h1_lt id2 h2_lt hid12 with hlt | ⟨heq_st, _⟩
              · exact hlt
              · have hzx := h_same_step_z_le_x id1 h1_lt id2 h2_lt hid12 heq_st
                omega
            have hs12 : ((jumps kops)[id1]).s < ((jumps kops)[id2]).s :=
              h_s_lt_of_step_lt id1 h1_lt id2 h2_lt hstep12
            have hℓ1_le_ℓ2 : sepScale S P L ((jumps kops)[id1]).x ((jumps kops)[id1]).y ≤
                sepScale S P L ((jumps kops)[id2]).x ((jumps kops)[id2]).y := by
              have hult := hpart.sep_ultrametric
                ((jumps kops)[id1]).s ((jumps kops)[id2]).s ((jumps kops)[id2]).x
                (by omega) (by omega) (by omega)
              rw [← hweq] at hult
              have hsx2' : sepScale S P L ((jumps kops)[id2]).s ((jumps kops)[id1]).x =
                  sepScale S P L ((jumps kops)[id2]).x ((jumps kops)[id2]).y := by
                simpa [← hweq] using hsx2_eq
              omega
            obtain ⟨_, hidR1, _, _, _, _, hR1x_eq, _, _, _, _⟩ :=
              hfold.outside_mbase id1 h1_lt hid1B.2.1
            have hscale_lt := hid1B.2.2
            simp only [jScale, List.getElem?_eq_getElem h1_lt, List.getElem?_eq_getElem hidR1] at hscale_lt
            set ℓR1 := sepScale S P L ((jumps kops)[upperPrevWin kops id1]).x
              ((jumps kops)[upperPrevWin kops id1]).y
            have hjaR1 := hjump.jump_anatomies (upperPrevWin kops id1) hidR1
            have hℓR1_L : ℓR1 ≤ L := by omega
            have hxP : ((jumps kops)[id1]).x < P := by omega
            have hy1P : ((jumps kops)[id1]).y < P := by omega
            have hy2P : ((jumps kops)[id2]).y < P := by omega
            have hyR1P : ((jumps kops)[upperPrevWin kops id1]).y < P := by omega
            have hbidx_xy1 : blockIdx S P ℓR1 ((jumps kops)[id1]).x =
                blockIdx S P ℓR1 ((jumps kops)[id1]).y :=
              (hpart.sep_gt_iff ℓR1 hℓR1_L _ hxP _ hy1P).mp hscale_lt
            have hbo_xy1 : blockOf S P ℓR1 ((jumps kops)[id1]).x =
                blockOf S P ℓR1 ((jumps kops)[id1]).y := by
              simp only [blockOf, hbidx_xy1]
            have hB2_le_yR1 : (blockOf S P ℓR1 ((jumps kops)[id1]).x).2 ≤
                ((jumps kops)[upperPrevWin kops id1]).y := by
              by_contra hlt_B2
              have hy1_lo := (hpart.blocks_partition ℓR1 hℓR1_L _ hy1P).2.1
              rw [← hbo_xy1] at hy1_lo
              have hbidx_R1 := (hpart.blocks_eq_iff ℓR1 hℓR1_L _ hxP _ hyR1P).mpr
                ⟨by omega, by omega⟩
              have hbidx_yR1 : blockIdx S P ℓR1 ((jumps kops)[upperPrevWin kops id1]).x =
                  blockIdx S P ℓR1 ((jumps kops)[upperPrevWin kops id1]).y := by
                rw [hR1x_eq, ← hbidx_xy1]; exact hbidx_R1
              have hgt := (hpart.sep_gt_iff ℓR1 hℓR1_L _ (by omega) _ hyR1P).mpr hbidx_yR1
              omega
            have hmemR1 := h_jump_mem_inorder (upperPrevWin kops id1) hidR1
            have hmem1 := h_jump_mem_inorder id1 h1_lt
            have hmem2 := h_jump_mem_inorder id2 h2_lt
            have hy1_in_R11 : ((jumps kops)[id1]).y ∈
                inorderNat (keyedState kops (((jumps kops)[upperPrevWin kops id1]).step + 1)) := by
              rw [← hR1x_eq]; exact hmemR1.2.1
            have hmono_y1 := h_lcrs_mono_interval
              (((jumps kops)[upperPrevWin kops id1]).step + 1)
              ((jumps kops)[id1]).step
              ((jumps kops)[id1]).y
              (by omega) (le_of_lt hja1.2.1) hy1_in_R11 hmem1.2.2
            have hjlR1 := (hfold.jump_lcrs (upperPrevWin kops id1) hidR1).2.2
            rw [hR1x_eq] at hjlR1
            have hjl1_y := (hfold.jump_lcrs id1 h1_lt).2.1
            have hx_in_2 : ((jumps kops)[id1]).x ∈
                inorderNat (keyedState kops ((jumps kops)[id2]).step) := by
              rw [hweq]; exact hmem2.1
            have hmono_x := h_lcrs_mono_interval
              (((jumps kops)[id1]).step + 1)
              ((jumps kops)[id2]).step
              ((jumps kops)[id1]).x
              (by omega) (le_of_lt hja2.2.1) hmem1.2.1 hx_in_2
            have hjl1_x := (hfold.jump_lcrs id1 h1_lt).2.2
            have hjl2_x := (hfold.jump_lcrs id2 h2_lt).1
            rw [← hweq] at hjl2_x
            have hℓ2_le_ℓR1 : sepScale S P L ((jumps kops)[id2]).x ((jumps kops)[id2]).y ≤ ℓR1 := by
              by_contra hgt_ℓ2
              have hlt_ℓR1 : ℓR1 < sepScale S P L ((jumps kops)[id1]).x ((jumps kops)[id2]).y := by
                rw [hweq]; omega
              have hbidx_xy2 := (hpart.sep_gt_iff ℓR1 hℓR1_L _ hxP _ hy2P).mp hlt_ℓR1
              have hy2_lt := ((hpart.blocks_eq_iff ℓR1 hℓR1_L _ hxP _ hy2P).mp hbidx_xy2).2
              omega
            omega
          simp only [Finset.mem_coe] at ha hb
          rcases lt_trichotomy a b with hlt | heq | hgt
          · exact False.elim (h_no_lt a ha b hb hlt hw_eq)
          · exact heq
          · exact False.elim (h_no_lt b hb a ha hgt hw_eq.symm)
      simpa using hcard

    have hCatCD_le : CatCD.card ≤ E_omega.card := by
      refine Finset.card_le_card_of_injOn (upperPrevWin kops) ?_ ?_
      · intro id hidCD
        simp only [Finset.mem_coe, CatCD, A_esc, Finset.mem_filter, decide_eq_true_eq] at hidCD
        obtain ⟨⟨hb3, hnot_fm, hor_esc⟩, hnotm, hscale_le, hcd_or⟩ := hidCD
        have hnot3aR : upperPrevWin kops id ∉ B_3_act S P L kops := by
          rcases hor_esc with hm | hr
          · exact absurd hm hnotm
          · exact hr
        obtain ⟨hid, hidR, hℓ1, hℓL, hRx_eq, _, _, hsp_bo_sR, _, _, _, _,
          hsep_sR_x, _, hstR_lt_st, hst_lt_te⟩ := h_nonfirst_prev id hb3 hnot_fm hnotm
        have hja := hjump.jump_anatomies id hid
        have hjaR := hjump.jump_anatomies (upperPrevWin kops id) hidR
        have hℓR_def : jScale (upperPrevWin kops id) =
            sepScale S P L ((jumps kops)[upperPrevWin kops id]).x
              ((jumps kops)[upperPrevWin kops id]).y := by
          simp [jScale, List.getElem?_eq_getElem hidR]
        have hy_def : y_of id = ((jumps kops)[id]).y := by
          simp [y_of, List.getElem?_eq_getElem hid]
        have hzR_def : zR_of id = ((jumps kops)[upperPrevWin kops id]).z := by
          simp [zR_of, List.getElem?_eq_getElem hidR]
        rw [Finset.mem_coe]
        rcases hcd_or with heq_scale | hz_ge
        · rw [hℓR_def] at heq_scale
          have hnot_z_ge : ¬ ((blockOf S P (jScale id) ((jumps kops)[upperPrevWin kops id]).y).2 ≤
              ((jumps kops)[upperPrevWin kops id]).z) := by
            intro hz_ge'
            apply hnot3aR
            simp only [B_3_act, isB3Act, Finset.mem_filter, Finset.mem_range,
              List.getElem?_eq_getElem hidR, decide_eq_true_eq, ← heq_scale]
            rw [← hsp_bo_sR]
            exact ⟨hidR, hℓ1, hℓL, hsep_sR_x, hz_ge', lt_trans hstR_lt_st hst_lt_te⟩
          refine Finset.mem_union_right _ ?_
          simp only [B_3_intra, isB3Intra, Finset.mem_filter, Finset.mem_range,
            List.getElem?_eq_getElem hidR, decide_eq_true_eq, ← heq_scale]
          exact ⟨hidR, hℓ1, hℓL, hsep_sR_x, by omega⟩
        · rcases eq_or_lt_of_le hscale_le with heq_scale | hlt_scale
          · rw [hℓR_def] at heq_scale
            have hnot_z_ge : ¬ ((blockOf S P (jScale id) ((jumps kops)[upperPrevWin kops id]).y).2 ≤
                ((jumps kops)[upperPrevWin kops id]).z) := by
              intro hz_ge'
              apply hnot3aR
              simp only [B_3_act, isB3Act, Finset.mem_filter, Finset.mem_range,
                List.getElem?_eq_getElem hidR, decide_eq_true_eq, ← heq_scale]
              rw [← hsp_bo_sR]
              exact ⟨hidR, hℓ1, hℓL, hsep_sR_x, hz_ge', lt_trans hstR_lt_st hst_lt_te⟩
            refine Finset.mem_union_right _ ?_
            simp only [B_3_intra, isB3Intra, Finset.mem_filter, Finset.mem_range,
              List.getElem?_eq_getElem hidR, decide_eq_true_eq, ← heq_scale]
            exact ⟨hidR, hℓ1, hℓL, hsep_sR_x, by omega⟩
          · rw [hy_def, hzR_def] at hz_ge
            rw [hℓR_def] at hlt_scale
            set ℓR := sepScale S P L ((jumps kops)[upperPrevWin kops id]).x
              ((jumps kops)[upperPrevWin kops id]).y
            have hxRP : ((jumps kops)[upperPrevWin kops id]).x < P := by omega
            have hyRP : ((jumps kops)[upperPrevWin kops id]).y < P := by omega
            have hsRP : ((jumps kops)[upperPrevWin kops id]).s < P := by omega
            have hℓR_range := hpart.sep_range _ hxRP _ hyRP (by omega)
            by_cases htop : ℓR = L + 1
            · refine Finset.mem_union_left _ (Finset.mem_union_left _ ?_)
              simp only [B_fin_pre, isBFinPre, Finset.mem_filter, Finset.mem_range,
                List.getElem?_eq_getElem hidR, decide_eq_true_eq]
              refine ⟨hidR, htop, ?_⟩
              by_contra hge_bo
              have hbx2 := (hpart.blocks_partition L le_rfl _ hxRP).2.2.1
              have hbidx := (hpart.blocks_eq_iff L le_rfl _ hxRP _ hsRP).mpr ⟨by omega, by omega⟩
              have hgt := (hpart.sep_gt_iff L le_rfl _ hsRP _ hxRP).mpr hbidx.symm
              omega
            · have hℓR_L : ℓR ≤ L := by omega
              have hbidx_xyR : blockIdx S P (jScale id) ((jumps kops)[id]).y =
                  blockIdx S P (jScale id) ((jumps kops)[upperPrevWin kops id]).y := by
                rw [← hRx_eq]
                exact (hpart.sep_gt_iff (jScale id) hℓL _ hxRP _ hyRP).mp hlt_scale
              have hbo_xyR : blockOf S P (jScale id) ((jumps kops)[id]).y =
                  blockOf S P (jScale id) ((jumps kops)[upperPrevWin kops id]).y := by
                simp only [blockOf, hbidx_xyR]
              have hnest := (h_nested (jScale id) ℓR (le_of_lt hlt_scale) hℓR_L _ hyRP).2
              rw [hbo_xyR] at hz_ge
              have h_exit_R : (blockOf S P (sepScale S P L ((jumps kops)[upperPrevWin kops id]).x
                  ((jumps kops)[upperPrevWin kops id]).y) ((jumps kops)[upperPrevWin kops id]).y).2 ≤
                  ((jumps kops)[upperPrevWin kops id]).z :=
                le_trans hnest hz_ge
              have h1_R : 1 ≤ sepScale S P L ((jumps kops)[upperPrevWin kops id]).x
                  ((jumps kops)[upperPrevWin kops id]).y := le_trans hℓ1 (le_of_lt hlt_scale)
              have hsx_lt_R : sepScale S P L ((jumps kops)[upperPrevWin kops id]).s
                  ((jumps kops)[upperPrevWin kops id]).x <
                  sepScale S P L ((jumps kops)[upperPrevWin kops id]).x
                    ((jumps kops)[upperPrevWin kops id]).y := by
                rw [hsep_sR_x]; exact hlt_scale
              refine Finset.mem_union_left _ (Finset.mem_union_right _ ?_)
              simp only [B_1_exit, isB1Exit, Finset.mem_filter, Finset.mem_range,
                List.getElem?_eq_getElem hidR, decide_eq_true_eq]
              exact ⟨hidR, h1_R, hℓR_L, hsx_lt_R, h_exit_R⟩
      · intro id1 hid1 id2 hid2 heq
        simp only [Finset.mem_coe, CatCD, A_esc, Finset.mem_filter] at hid1 hid2
        obtain ⟨h1_lt, _, _, _, _, _⟩ := h_b3act_props id1 hid1.1.1
        obtain ⟨h2_lt, _, _, _, _, _⟩ := h_b3act_props id2 hid2.1.1
        exact hfold.upperPrevWin_inj id1 h1_lt hid1.2.1 id2 h2_lt hid2.2.1 heq

    have hCatE_le : CatE.card ≤
        countKeyedRslr kops + (B_fin_pre S P L kops).card + (B_1_exit S P L kops).card := by
      let predCross : ℕ → ℕ → Bool := fun id t =>
        let y := y_of id
        let sq2 := (blockOf S P (jScale id) y).2
        decide (lcrsParent P (foldBST P (keyedState kops t)).1 y < sq2 ∧
          sq2 ≤ lcrsParent P (foldBST P (keyedState kops (t + 1))).1 y)
      let tCross : ℕ → ℕ := fun id =>
        let t0 := match (jumps kops)[upperPrevWin kops id]? with | none => 0 | some eR => eR.step + 1
        let t1 := match (jumps kops)[id]? with | none => 0 | some e => e.step
        ((List.Ico t0 t1).find? (predCross id)).getD 0

      have htCross_props : ∀ id ∈ CatE,
          ∃ (hid : id < (jumps kops).length) (hidR : upperPrevWin kops id < (jumps kops).length),
            let sp := (subs_of id).getD (p_of id) (0, 0)
            let sq := (subs_of id).getD (cy_of id) (0, 0)
            let e := (jumps kops)[id]
            let eR := (jumps kops)[upperPrevWin kops id]
            let t := tCross id
            sp.1 < sp.2 ∧ sp.2 ≤ P ∧
            eR.step + 1 ≤ t ∧ t < e.step ∧
            popStep kops sp.1 ≤ t ∧ t < tEmpty kops sp.1 sp.2 ∧ t < kops.length ∧
            sq = blockOf S P (jScale id) e.y ∧
            sq.1 ≤ e.y ∧ e.y < sq.2 ∧
            e.y ∈ inorderNat (keyedState kops t) ∧
            e.y ∈ inorderNat (keyedState kops (t + 1)) ∧
            lcrsParent P (foldBST P (keyedState kops t)).1 e.y < sq.2 ∧
            sq.2 ≤ lcrsParent P (foldBST P (keyedState kops (t + 1))).1 e.y := by
        intro id hidE
        have hidE' := hidE
        simp only [CatE, A_esc, Finset.mem_filter, decide_eq_true_eq] at hidE'
        obtain ⟨⟨hb3, hnot_fm, _⟩, hnotm, _, hzR_lt⟩ := hidE'
        obtain ⟨hℓ1, hℓL, hXi, hp_lt, hidV⟩ := h_b3_in_vact id hb3
        obtain ⟨hsp_lt, hsp_le_P, _, _⟩ :=
          h_vact_full (jScale id) (Xi_of id) (p_of id) hℓ1 hℓL hXi hp_lt
        obtain ⟨hid, hidR, _, _, hRx_eq, _, _, _, hsq_bo, hsq_lo, hsq_hi, hsq_le_ez,
          _, hts_le_stR, hstR_lt_st, hst_lt_te⟩ := h_nonfirst_prev id hb3 hnot_fm hnotm
        have hy_def : y_of id = ((jumps kops)[id]).y := by
          simp [y_of, List.getElem?_eq_getElem hid]
        have hzR_def : zR_of id = ((jumps kops)[upperPrevWin kops id]).z := by
          simp [zR_of, List.getElem?_eq_getElem hidR]
        rw [hy_def, hzR_def, ← hsq_bo] at hzR_lt
        have hja := hjump.jump_anatomies id hid
        have hmemR := h_jump_mem_inorder (upperPrevWin kops id) hidR
        have hmem := h_jump_mem_inorder id hid
        have hy_in_R1 : ((jumps kops)[id]).y ∈
            inorderNat (keyedState kops (((jumps kops)[upperPrevWin kops id]).step + 1)) := by
          rw [← hRx_eq]; exact hmemR.2.1
        have hjlR := (hfold.jump_lcrs (upperPrevWin kops id) hidR).2.2
        rw [hRx_eq] at hjlR
        have hjl := (hfold.jump_lcrs id hid).2.1
        have hstR1_lt : ((jumps kops)[upperPrevWin kops id]).step + 1 < ((jumps kops)[id]).step := by
          rcases eq_or_lt_of_le (Nat.succ_le_of_lt hstR_lt_st) with heq | hlt
          · have heq' : ((jumps kops)[upperPrevWin kops id]).step + 1 = ((jumps kops)[id]).step := heq
            rw [heq'] at hjlR
            omega
          · exact hlt
        obtain ⟨t_wit, htw1, htw2, hQ1, hQ2⟩ := h_step_trans
          (fun t => lcrsParent P (foldBST P (keyedState kops t)).1 ((jumps kops)[id]).y <
            ((subs_of id).getD (cy_of id) (0, 0)).2)
          (((jumps kops)[upperPrevWin kops id]).step + 1)
          ((jumps kops)[id]).step
          hstR1_lt (by omega) (by omega)
        have hany : (List.Ico (((jumps kops)[upperPrevWin kops id]).step + 1)
            ((jumps kops)[id]).step).any (predCross id) = true := by
          rw [List.any_eq_true]
          refine ⟨t_wit, List.Ico.mem.mpr ⟨htw1, htw2⟩, ?_⟩
          simp only [predCross, hy_def, ← hsq_bo, decide_eq_true_eq]
          exact ⟨hQ1, by omega⟩
        have htCross_eq : tCross id =
            ((List.Ico (((jumps kops)[upperPrevWin kops id]).step + 1)
              ((jumps kops)[id]).step).find? (predCross id)).getD 0 := by
          simp [tCross, List.getElem?_eq_getElem hidR, List.getElem?_eq_getElem hid]
        obtain ⟨hmem_ico, hpred⟩ := h_find_of_any _ _ hany
        rw [← htCross_eq, List.Ico.mem] at hmem_ico
        rw [← htCross_eq] at hpred
        simp only [predCross, hy_def, ← hsq_bo, decide_eq_true_eq] at hpred
        have hR1_iff := (hkvalid.mem_inorder_iff _ (by omega) _).mp hy_in_R1
        have he_iff := (hkvalid.mem_inorder_iff _ (le_of_lt hja.2.1) _).mp hmem.2.2
        have hy_t : ((jumps kops)[id]).y ∈ inorderNat (keyedState kops (tCross id)) :=
          (hkvalid.mem_inorder_iff _ (by omega) _).mpr ⟨hR1_iff.1, by omega, by omega⟩
        have hy_t1 : ((jumps kops)[id]).y ∈ inorderNat (keyedState kops (tCross id + 1)) :=
          (hkvalid.mem_inorder_iff _ (by omega) _).mpr ⟨hR1_iff.1, by omega, by omega⟩
        exact ⟨hid, hidR, hsp_lt, hsp_le_P, hmem_ico.1, hmem_ico.2,
          by omega, by omega, by omega, hsq_bo, hsq_lo, hsq_hi, hy_t, hy_t1, hpred.1, hpred.2⟩

      let CatE_rslr := CatE.filter (fun id => isRslrAt kops (tCross id) = true)
      let CatE_pop := CatE.filter (fun id => isRslrAt kops (tCross id) = false)

      have hCatE_sub : CatE ⊆ CatE_rslr ∪ CatE_pop := by
        intro id hidE
        cases hr : isRslrAt kops (tCross id)
        · exact Finset.mem_union_right _ (Finset.mem_filter.mpr ⟨hidE, hr⟩)
        · exact Finset.mem_union_left _ (Finset.mem_filter.mpr ⟨hidE, hr⟩)

      have hCatE_cover : CatE.card ≤ CatE_rslr.card + CatE_pop.card :=
        le_trans (Finset.card_le_card hCatE_sub) (Finset.card_union_le CatE_rslr CatE_pop)

      have hCatE_B3 : CatE ⊆ B_3_act S P L kops :=
        Finset.Subset.trans (Finset.filter_subset _ _) (Finset.filter_subset _ _)

      have hErslr_le : CatE_rslr.card ≤ rslrSteps.card := by
        refine h_vact_pair_inj_card CatE_rslr rslrSteps tCross
          (fun t => (inorderNat (keyedState kops t)).headD 0)
          (fun t => match kops[t]? with
            | some (.rslr (d + 1)) => (rightSpineTopDownNat (keyedState kops t)).getD d 0
            | _ => 0)
          (Finset.Subset.trans (Finset.filter_subset _ _) hCatE_B3) ?_
        intro id hidEr
        obtain ⟨hidE, his_rslr⟩ := Finset.mem_filter.mp hidEr
        obtain ⟨hid, _, hsp_lt, hsp_le_P, _, _, hts_le_t, ht_lt_te, ht_len, _,
          hsq_lo, hsq_hi, _, _, hlcrs_lt, hlcrs_ge⟩ := htCross_props id hidE
        obtain ⟨_, hm0_lo, hm0_hi⟩ :=
          h_inord_head_window _ _ (tCross id) hsp_lt hsp_le_P hts_le_t ht_lt_te
        have ht_rslr : tCross id ∈ rslrSteps :=
          Finset.mem_filter.mpr ⟨Finset.mem_range.mpr ht_len, his_rslr⟩
        dsimp (config := { failIfUnchanged := false }) only [isRslrAt] at his_rslr
        rw [List.getElem?_eq_getElem ht_len] at his_rslr
        rcases hop : kops[tCross id] with w | s | d0
        · rw [hop] at his_rslr; cases his_rslr
        · rw [hop] at his_rslr; cases his_rslr
        · rcases d0 with _ | d
          · have heq := hfold.fold_step_rslr_zero (tCross id) ht_len hop
            rw [heq] at hlcrs_ge; omega
          · have hsucc := hfold.fold_step_rslr_succ (tCross id) ht_len d hop
            have hy_eq : ((jumps kops)[id]).y =
                (rightSpineTopDownNat (keyedState kops (tCross id))).getD d 0 := by
              by_contra hne
              have heq := hsucc.2.2.2.2.2.2 ((jumps kops)[id]).y hne
              omega
            refine ⟨ht_rslr, hm0_lo, hm0_hi, ?_, ?_⟩
            · simp only [List.getElem?_eq_getElem ht_len, hop, Nat.add_one, ← hy_eq]; exact hsq_lo
            · simp only [List.getElem?_eq_getElem ht_len, hop, Nat.add_one, ← hy_eq]; exact hsq_hi

      let B01 : Finset ℕ := B_fin_pre S P L kops ∪ B_1_exit S P L kops
      have hB01_card : B01.card ≤ (B_fin_pre S P L kops).card + (B_1_exit S P L kops).card :=
        Finset.card_union_le _ _

      let predJCross : ℕ → ℕ → Bool := fun id jid =>
        match (jumps kops)[jid]?, (jumps kops)[id]? with
        | some ej, some e => decide (ej.step = tCross id ∧ ej.x = e.y)
        | _, _ => false
      let jidCross : ℕ → ℕ := fun id =>
        ((List.range (jumps kops).length).find? (predJCross id)).getD 0

      have hEpop_le : CatE_pop.card ≤ B01.card := by
        refine h_vact_pair_inj_card CatE_pop B01 jidCross
          (fun jid => match (jumps kops)[jid]? with | some ej => ej.s | none => 0)
          (fun jid => match (jumps kops)[jid]? with | some ej => ej.x | none => 0)
          (Finset.Subset.trans (Finset.filter_subset _ _) hCatE_B3) ?_
        intro id hidEp
        obtain ⟨hidE, hnot_rslr⟩ := Finset.mem_filter.mp hidEp
        have hidE' := hidE
        simp only [CatE, A_esc, Finset.mem_filter, decide_eq_true_eq] at hidE'
        obtain ⟨⟨hb3, hnot_fm, _⟩, hnotm, _, _⟩ := hidE'
        obtain ⟨hℓ1, hℓL, hXi, hp_lt, hidV⟩ := h_b3_in_vact id hb3
        obtain ⟨_, _, hv_props, _⟩ :=
          h_vact_full (jScale id) (Xi_of id) (p_of id) hℓ1 hℓL hXi hp_lt
        obtain ⟨_, _, _, _, _, _, _, _, _, _, _, _, _, hs_sp2, _, hp_lt_cx, hcx_lt_cy, hcy_lt, _⟩ :=
          hv_props id hidV
        obtain ⟨_, _, _, _, _, hsR_sp1, _, _, _, _, _, _, _, _, _, _⟩ :=
          h_nonfirst_prev id hb3 hnot_fm hnotm
        obtain ⟨hid, hidR, _, _, hstR1_le_t, ht_lt_st, _, _, ht_len, hsq_bo,
          hsq_lo, hsq_hi, hy_t, hy_t1, hlcrs_lt, hlcrs_ge⟩ := htCross_props id hidE
        have hsv := hkvalid.step_valid (tCross id) ht_len
        have hex_jid : ∃ (jid : ℕ) (hjid : jid < (jumps kops).length),
            ((jumps kops)[jid]).step = tCross id ∧ ((jumps kops)[jid]).x = ((jumps kops)[id]).y := by
          rcases hop : kops[tCross id] with w | s_tilde | d0
          · rw [hop] at hsv
            have hw_lt : w < ((jumps kops)[id]).y := h_forall_inorder hsv.2.2 _ hy_t
            have heq := (hfold.fold_step_push (tCross id) ht_len w hop).2.2 ((jumps kops)[id]).y (by omega)
            omega
          · by_contra hno
            have h_unch := (hfold.fold_step_pop (tCross id) ht_len s_tilde hop).2
              ((jumps kops)[id]).y hy_t1
              (fun jid hjid hst hy_eq => hno ⟨jid, hjid, hst, hy_eq.symm⟩)
            omega
          · exfalso
            dsimp (config := { failIfUnchanged := false }) only [isRslrAt] at hnot_rslr
            rw [List.getElem?_eq_getElem ht_len, hop] at hnot_rslr
            cases hnot_rslr
        obtain ⟨jw, hjw_lt, hjw_st, hjw_x⟩ := hex_jid
        have hany_j : (List.range (jumps kops).length).any (predJCross id) = true := by
          rw [List.any_eq_true]
          refine ⟨jw, List.mem_range.mpr hjw_lt, ?_⟩
          simp [predJCross, List.getElem?_eq_getElem hjw_lt, List.getElem?_eq_getElem hid,
            hjw_st, hjw_x]
        obtain ⟨hjid_mem, hjid_pred⟩ := h_find_of_any _ _ hany_j
        have hjid_lt : jidCross id < (jumps kops).length := List.mem_range.mp hjid_mem
        dsimp (config := { failIfUnchanged := false }) only [predJCross] at hjid_pred
        rw [List.getElem?_eq_getElem hjid_lt, List.getElem?_eq_getElem hid,
          decide_eq_true_eq] at hjid_pred
        obtain ⟨hej_st, hej_x⟩ := hjid_pred
        have hsR_lt_ejs := h_s_lt_of_step_lt (upperPrevWin kops id) hidR (jidCross id) hjid_lt (by omega)
        have hejs_lt_es := h_s_lt_of_step_lt (jidCross id) hjid_lt id hid (by omega)
        have hs_sp2' : ((jumps kops)[id]).s < ((subs_of id).getD (p_of id) (0, 0)).2 := hs_sp2
        have hejs_sp1 : ((subs_of id).getD (p_of id) (0, 0)).1 ≤ ((jumps kops)[jidCross id]).s := by omega
        have hejs_sp2 : ((jumps kops)[jidCross id]).s < ((subs_of id).getD (p_of id) (0, 0)).2 := by omega
        have hrec := h_coord_rec (jScale id) hℓ1 hℓL (Xi_of id) hXi
          (p_of id) (cy_of id) (lt_trans hp_lt_cx hcx_lt_cy) hcy_lt
          ((jumps kops)[jidCross id]).s ((jumps kops)[jidCross id]).x
          hejs_sp1 hejs_sp2 (by rw [hej_x]; exact hsq_lo) (by rw [hej_x]; exact hsq_hi)
        have hsep_ejs_ejx : sepScale S P L ((jumps kops)[jidCross id]).s
            ((jumps kops)[jidCross id]).x = jScale id := hrec.2.2.1
        obtain ⟨hjl_ej1, _, hjl_ej3⟩ := hfold.jump_lcrs (jidCross id) hjid_lt
        rw [hej_st, hej_x] at hjl_ej1 hjl_ej3
        have hejy_lt_sq2 : ((jumps kops)[jidCross id]).y < ((subs_of id).getD (cy_of id) (0, 0)).2 := by
          omega
        have hsq2_le_ejz : ((subs_of id).getD (cy_of id) (0, 0)).2 ≤ ((jumps kops)[jidCross id]).z := by
          omega
        have hja_ej := hjump.jump_anatomies (jidCross id) hjid_lt
        have hejxP : ((jumps kops)[jidCross id]).x < P := by omega
        have hejyP : ((jumps kops)[jidCross id]).y < P := by omega
        have hejsP : ((jumps kops)[jidCross id]).s < P := by omega
        have hbo_ejx : blockOf S P (jScale id) ((jumps kops)[jidCross id]).x =
            (subs_of id).getD (cy_of id) (0, 0) := by
          rw [hej_x, ← hsq_bo]
        have hbidx_ejxy : blockIdx S P (jScale id) ((jumps kops)[jidCross id]).x =
            blockIdx S P (jScale id) ((jumps kops)[jidCross id]).y := by
          refine (hpart.blocks_eq_iff (jScale id) hℓL _ hejxP _ hejyP).mpr ?_
          rw [hbo_ejx]
          exact ⟨by omega, hejy_lt_sq2⟩
        have hℓ_lt_ej : jScale id < sepScale S P L ((jumps kops)[jidCross id]).x
            ((jumps kops)[jidCross id]).y :=
          (hpart.sep_gt_iff (jScale id) hℓL _ hejxP _ hejyP).mpr hbidx_ejxy
        set ℓ_ej := sepScale S P L ((jumps kops)[jidCross id]).x ((jumps kops)[jidCross id]).y
        have hℓ_ej_range := hpart.sep_range _ hejxP _ hejyP (by omega)
        have hjid_B01 : jidCross id ∈ B01 := by
          by_cases htop : ℓ_ej = L + 1
          · refine Finset.mem_union_left _ ?_
            simp only [B_fin_pre, isBFinPre, Finset.mem_filter, Finset.mem_range,
              List.getElem?_eq_getElem hjid_lt, decide_eq_true_eq]
            refine ⟨hjid_lt, htop, ?_⟩
            by_contra hge_bo
            have hbx2 := (hpart.blocks_partition L le_rfl _ hejxP).2.2.1
            have hbidx := (hpart.blocks_eq_iff L le_rfl _ hejxP _ hejsP).mpr ⟨by omega, by omega⟩
            have hgt := (hpart.sep_gt_iff L le_rfl _ hejsP _ hejxP).mpr hbidx.symm
            omega
          · have hℓ_ej_L : ℓ_ej ≤ L := by omega
            have hbo_ejy : blockOf S P (jScale id) ((jumps kops)[jidCross id]).y =
                (subs_of id).getD (cy_of id) (0, 0) := by
              rw [← hbo_ejx]
              simp only [blockOf, hbidx_ejxy]
            have hnest := (h_nested (jScale id) ℓ_ej (le_of_lt hℓ_lt_ej) hℓ_ej_L _ hejyP).2
            rw [hbo_ejy] at hnest
            have h_exit_ej : (blockOf S P (sepScale S P L ((jumps kops)[jidCross id]).x
                ((jumps kops)[jidCross id]).y) ((jumps kops)[jidCross id]).y).2 ≤
                ((jumps kops)[jidCross id]).z :=
              le_trans hnest hsq2_le_ejz
            have h1_ej : 1 ≤ sepScale S P L ((jumps kops)[jidCross id]).x
                ((jumps kops)[jidCross id]).y := le_trans hℓ1 (le_of_lt hℓ_lt_ej)
            have hsx_lt_ej : sepScale S P L ((jumps kops)[jidCross id]).s
                ((jumps kops)[jidCross id]).x <
                sepScale S P L ((jumps kops)[jidCross id]).x
                  ((jumps kops)[jidCross id]).y := by
              rw [hsep_ejs_ejx]; exact hℓ_lt_ej
            refine Finset.mem_union_right _ ?_
            simp only [B_1_exit, isB1Exit, Finset.mem_filter, Finset.mem_range,
              List.getElem?_eq_getElem hjid_lt, decide_eq_true_eq]
            exact ⟨hjid_lt, h1_ej, hℓ_ej_L, hsx_lt_ej, h_exit_ej⟩
        refine ⟨hjid_B01, ?_, ?_, ?_, ?_⟩
        · simp [List.getElem?_eq_getElem hjid_lt]; exact hejs_sp1
        · simp [List.getElem?_eq_getElem hjid_lt]; exact hejs_sp2
        · simp [List.getElem?_eq_getElem hjid_lt, hej_x]; exact hsq_lo
        · simp [List.getElem?_eq_getElem hjid_lt, hej_x]; exact hsq_hi

      omega

    omega

  have h_sum_vact := h_partition (B_3_act S P L kops) (Finset.Subset.refl _)
  have h_sum_esc := h_partition A_esc (Finset.filter_subset _ _)
  have h_inter_self : ∀ ℓ Xi p,
      VActSet S P L kops ℓ Xi p ∩ B_3_act S P L kops = VActSet S P L kops ℓ Xi p :=
    fun _ _ _ => Finset.inter_eq_left.mpr (Finset.filter_subset _ _)
  simp only [h_inter_self] at h_sum_vact

  have h_sum_le :
      (Finset.Icc 1 L).sum (fun ℓ =>
        (Finset.range (scaleBlocks S P (ℓ - 1)).length).sum (fun Xi =>
          let X := (scaleBlocks S P (ℓ - 1)).getD Xi (0, 0)
          let KX := (splitBlock (S ℓ) X.1 X.2).length
          (Finset.range (KX - 1)).sum (fun p =>
            (VActSet S P L kops ℓ Xi p).card))) ≤
      2 * totalMMovCount S P L kops +
      (Finset.Icc 1 L).sum (fun ℓ =>
        (Finset.range (scaleBlocks S P (ℓ - 1)).length).sum (fun Xi =>
          let X := (scaleBlocks S P (ℓ - 1)).getD Xi (0, 0)
          let KX := (splitBlock (S ℓ) X.1 X.2).length
          (Finset.range (KX - 1)).sum (fun p =>
            (VActSet S P L kops ℓ Xi p ∩ A_esc).card))) := by
    calc
      (Finset.Icc 1 L).sum (fun ℓ =>
        (Finset.range (scaleBlocks S P (ℓ - 1)).length).sum (fun Xi =>
          let X := (scaleBlocks S P (ℓ - 1)).getD Xi (0, 0)
          let KX := (splitBlock (S ℓ) X.1 X.2).length
          (Finset.range (KX - 1)).sum (fun p =>
            (VActSet S P L kops ℓ Xi p).card)))
      _ ≤ (Finset.Icc 1 L).sum (fun ℓ =>
            (Finset.range (scaleBlocks S P (ℓ - 1)).length).sum (fun Xi =>
              let X := (scaleBlocks S P (ℓ - 1)).getD Xi (0, 0)
              let KX := (splitBlock (S ℓ) X.1 X.2).length
              (Finset.range (KX - 1)).sum (fun p =>
                2 * (MMovSet S P L kops ℓ Xi p).card +
                  (VActSet S P L kops ℓ Xi p ∩ A_esc).card))) := by
          refine Finset.sum_le_sum fun ℓ hℓ => ?_
          rw [Finset.mem_Icc] at hℓ
          refine Finset.sum_le_sum fun Xi hXi => ?_
          rw [Finset.mem_range] at hXi
          refine Finset.sum_le_sum fun p hp => ?_
          rw [Finset.mem_range] at hp
          exact h_epoch_bound ℓ Xi p hℓ.1 hℓ.2 hXi hp
      _ = 2 * totalMMovCount S P L kops +
          (Finset.Icc 1 L).sum (fun ℓ =>
            (Finset.range (scaleBlocks S P (ℓ - 1)).length).sum (fun Xi =>
              let X := (scaleBlocks S P (ℓ - 1)).getD Xi (0, 0)
              let KX := (splitBlock (S ℓ) X.1 X.2).length
              (Finset.range (KX - 1)).sum (fun p =>
                (VActSet S P L kops ℓ Xi p ∩ A_esc).card))) := by
          unfold totalMMovCount
          simp only [Finset.sum_add_distrib, Finset.mul_sum]

  rw [← h_sum_vact, ← h_sum_esc] at h_sum_le
  omega

private def puqIsClassB4Omega (S : ℕ → ℕ) (P L : ℕ) (kops : List KeyedCoreOp)
    (ℓ Xi p c : ℕ) : Bool :=
  let X := (scaleBlocks S P (ℓ - 1)).getD Xi (0, 0)
  let subs := splitBlock (S ℓ) X.1 X.2
  let sp := subs.getD p (0, 0)
  let sc := subs.getD c (0, 0)
  let buckets := B_fin_pre S P L kops ∪ B_1_exit S P L kops ∪ B_3_intra S P L kops
  (List.range (jumps kops).length).any (fun jid =>
    decide (jid ∈ buckets) &&
      match (jumps kops)[jid]? with
      | some ej =>
          decide (sp.1 ≤ ej.s ∧ ej.s < sp.2 ∧
            ((sc.1 ≤ ej.x ∧ ej.x < sc.2) ∨ (sc.1 ≤ ej.y ∧ ej.y < sc.2)))
      | none => false)

private def puqIsChargedSubblockOmega (S : ℕ → ℕ) (P L : ℕ) (kops : List KeyedCoreOp)
    (ℓ Xi p c : ℕ) : Bool :=
  puqIsClassA S P kops ℓ Xi p c ||
    puqIsClassB4Omega S P L kops ℓ Xi p c ||
    puqIsClassC1 S P kops ℓ Xi p c ||
    puqIsClassC2 S P kops ℓ Xi p c

private theorem phase_quotient_pkg_and_mover_card_omega (P L : ℕ) (S : ℕ → ℕ) (kops : List KeyedCoreOp)
    (hP : 1 ≤ P) (hL : 1 ≤ L) (hS0 : S 0 = P) (hSL_pos : 1 ≤ S L)
    (hS_step : ∀ ℓ : ℕ, ℓ < L → 2 * S (ℓ + 1) ≤ S ℓ)
    (hkvalid : ValidKeyedCoreSeq P kops) (hjump : PrimalJumpLaws P kops)
    (hfold : ValidFoldedCoreLaws P kops) (hpart : ScalePartitionLawsOmega S P L)
    (hplug : PuqPlugUnbornLaws P kops) (hbq : PuqBlockQuotientLaws) :
    ∀ ℓ, 1 ≤ ℓ → ℓ ≤ L → ∀ Xi < (scaleBlocks S P (ℓ - 1)).length,
      let X := (scaleBlocks S P (ℓ - 1)).getD Xi (0, 0)
      let NX := (splitBlock (S ℓ) X.1 X.2).length - 1
      ValidBlockQuotientPkg NX (puqConcretePkg S P L kops ℓ Xi) ∧
        ∀ p < NX,
          ((puqConcretePkg S P L kops ℓ Xi).F_idx p).length =
            (MMovSet S P L kops ℓ Xi p).card :=
by
  have _ := hP; have _ := hL; have _ := hSL_pos; have _ := hS_step
  rcases hplug with ⟨hplug_bst, hplug_pop_mono, hplug_lcrs_alive, hplug_lcrs_mono,
    hplug_rslr0, hplug_rslr_succ, hplug_push, hplug_pop, _hplug_pop_jumps, _hplug_rspine⟩
  rcases hbq with ⟨hbq_bst, hbq_inorder, _hbq_rest_in, hbq_rest_out, hbq_ls_iff,
    hbq_rest_ls, hbq_splice, hbq_rot_dich, _hbq_rot_evict, hbq_tamari, hbq_ls_pw,
    hbq_smax_ls, hbq_lcrs_ls, hbq_smax_upper, hbq_smax_lower⟩

  have h_getD_eq : ∀ {α : Type} (l : List α) (d : α) (i : ℕ) (hi : i < l.length),
      l.getD i d = l[i] := by
    intro α l d i hi
    simp [List.getD_eq_getElem?_getD, hi]

  have h_popStep_le : ∀ u v, u ≤ v → v < P → popStep kops u ≤ popStep kops v := by
    intro u v huv hv
    rcases Nat.eq_or_lt_of_le huv with rfl | hlt
    · exact le_rfl
    · exact le_of_lt (hkvalid.popStep_mono u v hlt hv)

  have h_lcrs_mono_range :
      ∀ t1 t2, t1 ≤ t2 → t2 ≤ kops.length →
        ∀ v, popIdx kops t2 ≤ v → v < P →
          lcrsParent P (puqPreEmbeddedState P kops t1) v ≤
            lcrsParent P (puqPreEmbeddedState P kops t2) v := by
    intro t1 t2 ht12 ht2 v hv_lo hv_hi
    have h_ind : ∀ d, t1 + d ≤ kops.length → popIdx kops (t1 + d) ≤ v →
        lcrsParent P (puqPreEmbeddedState P kops t1) v ≤
          lcrsParent P (puqPreEmbeddedState P kops (t1 + d)) v := by
      intro d
      induction d with
      | zero =>
        intro _ _
        simp
      | succ d ih =>
        intro ht_len hv_d
        rw [← Nat.add_assoc] at ht_len hv_d ⊢
        have h_prev := ih (by omega) (le_trans (hplug_pop_mono (t1 + d) (t1 + d + 1) (by omega)) hv_d)
        have h_step := hplug_lcrs_mono (t1 + d) (by omega) v hv_d hv_hi
        exact le_trans h_prev h_step
    obtain ⟨d, rfl⟩ := Nat.exists_eq_add_of_le ht12
    exact h_ind d ht2 hv_lo

  have h_sub_mono :
      ∀ (subs : List (ℕ × ℕ)), PuqIsSubblockPart subs →
        (∀ c1 c2, c1 ≤ c2 → c2 < subs.length →
          (subs.getD c1 (0, 0)).1 ≤ (subs.getD c2 (0, 0)).1 ∧
          (subs.getD c1 (0, 0)).2 ≤ (subs.getD c2 (0, 0)).2) ∧
        (∀ c1 c2, c1 < c2 → c2 < subs.length →
          (subs.getD c1 (0, 0)).2 ≤ (subs.getD c2 (0, 0)).1) := by
    intro subs ⟨_, h_lt, h_adj⟩
    have h_le : ∀ c1 d, c1 + d < subs.length →
        (subs.getD c1 (0, 0)).1 ≤ (subs.getD (c1 + d) (0, 0)).1 ∧
        (subs.getD c1 (0, 0)).2 ≤ (subs.getD (c1 + d) (0, 0)).2 := by
      intro c1 d
      induction d with
      | zero =>
        intro _
        simp
      | succ d ih =>
        intro hcd
        rw [← Nat.add_assoc] at hcd ⊢
        obtain ⟨ih1, ih2⟩ := ih (by omega)
        have hadj := h_adj (c1 + d) (by omega)
        have hlt1 := h_lt (c1 + d) (by omega)
        have hlt2 := h_lt (c1 + d + 1) hcd
        omega
    refine ⟨?_, ?_⟩
    · intro c1 c2 hc12 hc2
      obtain ⟨d, rfl⟩ := Nat.exists_eq_add_of_le hc12
      exact h_le c1 d hc2
    · intro c1 c2 hc12 hc2
      have hadj := h_adj c1 (by omega)
      obtain ⟨d, hd⟩ := Nat.exists_eq_add_of_le (Nat.succ_le_of_lt hc12)
      have h1 := (h_le (c1 + 1) d (by omega)).1
      rw [← hd] at h1
      omega

  have h_rot_quot :
      ∀ (subs : List (ℕ × ℕ)) (c_lo : ℕ) (T : _root_.BinaryTree ℕ) (u : ℕ),
        PuqIsSubblockPart subs →
        c_lo < subs.length →
        _root_.BinaryTree.IsBST T →
        _root_.BinaryTree.IsBST (puqBlockQuotient subs c_lo subs.length T) →
        inorderNat (puqBlockQuotient subs c_lo subs.length T) = List.Ico c_lo subs.length →
        let Q := puqBlockQuotient subs c_lo subs.length T
        let Q' := puqBlockQuotient subs c_lo subs.length (rotateRightOnLeftSpine u T)
        _root_.BinaryTree.IsBST Q' ∧
          inorderNat Q' = List.Ico c_lo subs.length ∧
          (∀ c ∈ leftSpineBottomUpNat Q', c ∈ leftSpineBottomUpNat Q) ∧
          (∀ c, c_lo ≤ c → c < subs.length → subtreeMaxNat Q c ≤ subtreeMaxNat Q' c) := by
    intro subs c_lo T u hpart_sub hc_lo hbstT hbstQ hinQ
    have hdich := (hbq_rot_dich subs hpart_sub c_lo subs.length hc_lo le_rfl T u hbstT).2
    rcases hdich with h_eq | h_rot
    · dsimp (config := { failIfUnchanged := false }) only
      rw [h_eq]
      exact ⟨hbstQ, hinQ, fun c hc => hc, fun c _ _ => le_rfl⟩
    · dsimp (config := { failIfUnchanged := false }) only
      rw [h_rot]
      exact hbq_tamari _ c_lo subs.length _ hbstQ hinQ

  have h_traj_mono :
      ∀ (subs : List (ℕ × ℕ)) (c_lo t1 t2 : ℕ),
        PuqIsSubblockPart subs →
        (subs.getD (subs.length - 1) (0, 0)).2 ≤ P →
        c_lo < subs.length →
        t1 ≤ t2 →
        t2 ≤ popStep kops (subs.getD c_lo (0, 0)).1 →
        let KX := subs.length
        let G1 := puqBlockQuotient subs c_lo KX (puqPreEmbeddedState P kops t1)
        let G2 := puqBlockQuotient subs c_lo KX (puqPreEmbeddedState P kops t2)
        (_root_.BinaryTree.IsBST G1 ∧ inorderNat G1 = List.Ico c_lo KX) ∧
        (_root_.BinaryTree.IsBST G2 ∧ inorderNat G2 = List.Ico c_lo KX) ∧
        (∀ c ∈ leftSpineBottomUpNat G2, c ∈ leftSpineBottomUpNat G1) ∧
        (∀ c, c_lo ≤ c → c < KX → subtreeMaxNat G1 c ≤ subtreeMaxNat G2 c) := by
    intro subs c_lo t1 t2 hpart_sub h_hiP hc_lo ht12 ht2_pop
    dsimp (config := { failIfUnchanged := false }) only
    set KX := subs.length
    set lo_b := (subs.getD c_lo (0, 0)).1
    have hKX2 : 2 ≤ KX := hpart_sub.1
    have h_lob_lt_P : lo_b < P := by
      have h1 := hpart_sub.2.1 c_lo hc_lo
      have h2 := ((h_sub_mono subs hpart_sub).1 c_lo (KX - 1) (by omega) (by omega)).2
      omega
    have h_pop_lob_lt : popStep kops lo_b < kops.length :=
      (hkvalid.birth_lt_pop lo_b h_lob_lt_P).2
    have h_pt : ∀ t ≤ popStep kops lo_b,
        _root_.BinaryTree.IsBST (puqBlockQuotient subs c_lo KX (puqPreEmbeddedState P kops t)) ∧
        inorderNat (puqBlockQuotient subs c_lo KX (puqPreEmbeddedState P kops t)) =
          List.Ico c_lo KX := by
      intro t ht
      obtain ⟨_, hbstT, hinT⟩ := hplug_bst t (by omega)
      have hpop_t : popIdx kops t ≤ lo_b := by
        have h1 := hplug_pop_mono t (popStep kops lo_b) ht
        rwa [hkvalid.popIdx_at_popStep lo_b h_lob_lt_P] at h1
      exact ⟨hbq_bst subs hpart_sub c_lo KX (le_of_lt hc_lo) le_rfl _ hbstT,
        hbq_inorder subs hpart_sub c_lo KX hc_lo le_rfl _ (popIdx kops t) P
          hbstT hinT hpop_t h_hiP⟩
    have h_step : ∀ t < popStep kops lo_b,
        let G_t := puqBlockQuotient subs c_lo KX (puqPreEmbeddedState P kops t)
        let G_t1 := puqBlockQuotient subs c_lo KX (puqPreEmbeddedState P kops (t + 1))
        (∀ c ∈ leftSpineBottomUpNat G_t1, c ∈ leftSpineBottomUpNat G_t) ∧
        (∀ c, c_lo ≤ c → c < KX → subtreeMaxNat G_t c ≤ subtreeMaxNat G_t1 c) := by
      intro t ht_pop
      dsimp (config := { failIfUnchanged := false }) only
      have ht : t < kops.length := by omega
      obtain ⟨_, hbstT, hinT⟩ := hplug_bst t (by omega)
      obtain ⟨hbstGt, hinGt⟩ := h_pt t (le_of_lt ht_pop)
      rcases hop : kops[t] with w | s | d
      · obtain ⟨N, hN⟩ := hplug_push t ht w hop
        have h_iter : ∀ k : ℕ,
            let U_k := (rotateRightOnLeftSpine w)^[k] (puqPreEmbeddedState P kops t)
            let Q_k := puqBlockQuotient subs c_lo KX U_k
            _root_.BinaryTree.IsBST U_k ∧
            inorderNat U_k = List.Ico (popIdx kops t) P ∧
            _root_.BinaryTree.IsBST Q_k ∧
            inorderNat Q_k = List.Ico c_lo KX ∧
            (∀ c ∈ leftSpineBottomUpNat Q_k,
              c ∈ leftSpineBottomUpNat
                (puqBlockQuotient subs c_lo KX (puqPreEmbeddedState P kops t))) ∧
            (∀ c, c_lo ≤ c → c < KX →
              subtreeMaxNat (puqBlockQuotient subs c_lo KX (puqPreEmbeddedState P kops t)) c ≤
                subtreeMaxNat Q_k c) := by
          intro k
          induction k with
          | zero =>
            exact ⟨hbstT, hinT, hbstGt, hinGt, fun c hc => hc, fun c _ _ => le_rfl⟩
          | succ k ih =>
            obtain ⟨hbstU, hinU, hbstQ, hinQ, hlsQ, hsmaxQ⟩ := ih
            dsimp (config := { failIfUnchanged := false }) only
            rw [Function.iterate_succ_apply']
            obtain ⟨hbstU', hinU', _, _⟩ := hbq_tamari _ (popIdx kops t) P w hbstU hinU
            obtain ⟨hbstQ', hinQ', hlsQ', hsmaxQ'⟩ :=
              h_rot_quot subs c_lo _ w hpart_sub hc_lo hbstU hbstQ hinQ
            exact ⟨hbstU', hinU', hbstQ', hinQ',
              fun c hc => hlsQ c (hlsQ' c hc),
              fun c hc1 hc2 => le_trans (hsmaxQ c hc1 hc2) (hsmaxQ' c hc1 hc2)⟩
        have hN_res := h_iter N
        dsimp (config := { failIfUnchanged := false }) only at hN_res
        rw [hN]
        exact ⟨hN_res.2.2.2.2.1, hN_res.2.2.2.2.2⟩
      · have hsv := hkvalid.step_valid t ht
        rw [hop] at hsv
        rcases hsv with ⟨hsP, hpop_s, hs_idx, _⟩
        have hs_lt_lob : s < lo_b := by
          by_contra hge
          have hle := h_popStep_le lo_b s (by omega) hsP
          omega
        have hhead : (inorderNat (puqPreEmbeddedState P kops t)).head? = some s := by
          rw [hinT, ← hs_idx, List.Ico.eq_cons hsP]
          rfl
        have hsp_eq :
            puqBlockQuotient subs c_lo KX (spliceMinNat (puqPreEmbeddedState P kops t)) =
              puqBlockQuotient subs c_lo KX (puqPreEmbeddedState P kops t) :=
          hbq_splice subs hpart_sub c_lo KX hc_lo le_rfl _ s hbstT hhead hs_lt_lob
        obtain ⟨_, _, _, hT1_eq, hjs_bst⟩ := hplug_pop t ht s hop
        set js := popJumpsAt 0 t s (leftSpineBottomUpNat (keyedState kops t))
        have h_fold : ∀ j ≤ js.length,
            let M_j := (js.take j).foldl (fun T e => rotateRightOnLeftSpine e.x T)
              (spliceMinNat (puqPreEmbeddedState P kops t))
            let Q_j := puqBlockQuotient subs c_lo KX M_j
            _root_.BinaryTree.IsBST Q_j ∧
            inorderNat Q_j = List.Ico c_lo KX ∧
            (∀ c ∈ leftSpineBottomUpNat Q_j,
              c ∈ leftSpineBottomUpNat
                (puqBlockQuotient subs c_lo KX (puqPreEmbeddedState P kops t))) ∧
            (∀ c, c_lo ≤ c → c < KX →
              subtreeMaxNat (puqBlockQuotient subs c_lo KX (puqPreEmbeddedState P kops t)) c ≤
                subtreeMaxNat Q_j c) := by
          intro j
          induction j with
          | zero =>
            intro _
            dsimp (config := { failIfUnchanged := false }) only
            simp only [List.take_zero, List.foldl_nil]
            rw [hsp_eq]
            exact ⟨hbstGt, hinGt, fun c hc => hc, fun c _ _ => le_rfl⟩
          | succ j ih =>
            intro hj_le
            have hj_lt : j < js.length := by omega
            obtain ⟨hbstQ, hinQ, hlsQ, hsmaxQ⟩ := ih (le_of_lt hj_lt)
            have hbstM : _root_.BinaryTree.IsBST
                ((js.take j).foldl (fun T e => rotateRightOnLeftSpine e.x T)
                  (spliceMinNat (puqPreEmbeddedState P kops t))) :=
              (hjs_bst j hj_lt).1
            dsimp (config := { failIfUnchanged := false }) only
            rw [List.take_succ_eq_append_getElem hj_lt, List.foldl_append]
            dsimp (config := { failIfUnchanged := false }) only [List.foldl_cons, List.foldl_nil]
            obtain ⟨hbstQ', hinQ', hlsQ', hsmaxQ'⟩ :=
              h_rot_quot subs c_lo _ (js[j]'hj_lt).x hpart_sub hc_lo hbstM hbstQ hinQ
            exact ⟨hbstQ', hinQ',
              fun c hc => hlsQ c (hlsQ' c hc),
              fun c hc1 hc2 => le_trans (hsmaxQ c hc1 hc2) (hsmaxQ' c hc1 hc2)⟩
        have h_end := h_fold js.length le_rfl
        dsimp (config := { failIfUnchanged := false }) only at h_end
        rw [List.take_length] at h_end
        rw [hT1_eq]
        exact ⟨h_end.2.2.1, h_end.2.2.2⟩
      · rcases d with _ | d
        · have hT1 := hplug_rslr0 t ht hop
          rw [hT1]
          exact ⟨fun c hc => hc, fun c _ _ => le_rfl⟩
        · obtain ⟨_, hT1, _⟩ := hplug_rslr_succ t ht d hop
          rw [hT1]
          have hrot := h_rot_quot subs c_lo (puqPreEmbeddedState P kops t)
            ((rightSpineTopDownNat (keyedState kops t)).getD d 0)
            hpart_sub hc_lo hbstT hbstGt hinGt
          exact ⟨hrot.2.2.1, hrot.2.2.2⟩
    have h_multi : ∀ d, t1 + d ≤ popStep kops lo_b →
        let G1 := puqBlockQuotient subs c_lo KX (puqPreEmbeddedState P kops t1)
        let Gd := puqBlockQuotient subs c_lo KX (puqPreEmbeddedState P kops (t1 + d))
        (∀ c ∈ leftSpineBottomUpNat Gd, c ∈ leftSpineBottomUpNat G1) ∧
        (∀ c, c_lo ≤ c → c < KX → subtreeMaxNat G1 c ≤ subtreeMaxNat Gd c) := by
      intro d
      induction d with
      | zero =>
        intro _
        exact ⟨fun c hc => hc, fun c _ _ => le_rfl⟩
      | succ d ih =>
        intro hd_pop
        obtain ⟨hls_d, hsmax_d⟩ := ih (by omega)
        obtain ⟨hls_s, hsmax_s⟩ := h_step (t1 + d) (by omega)
        exact ⟨fun c hc => hls_d c (hls_s c hc),
          fun c hc1 hc2 => le_trans (hsmax_d c hc1 hc2) (hsmax_s c hc1 hc2)⟩
    obtain ⟨d, rfl⟩ := Nat.exists_eq_add_of_le ht12
    obtain ⟨hls_12, hsmax_12⟩ := h_multi d ht2_pop
    exact ⟨h_pt t1 (by omega), h_pt (t1 + d) ht2_pop, hls_12, hsmax_12⟩

  intro ℓ hℓ1 hℓL Xi hXi
  dsimp (config := { failIfUnchanged := false }) only
  have hcb := hpart.child_blocks ℓ hℓ1 hℓL Xi hXi
  dsimp (config := { failIfUnchanged := false }) only at hcb
  set X := (scaleBlocks S P (ℓ - 1)).getD Xi (0, 0) with hX_def
  set subs := splitBlock (S ℓ) X.1 X.2 with hsubs_def
  obtain ⟨hKX2, _hsub0, hsub_last, hsub_bounds, hsub_adj, h_bidx_prev, h_sub_find, h_sub_eq_iff⟩ :=
    hcb
  have hX_mem : X ∈ scaleBlocks S P (ℓ - 1) := by
    have h_eq := h_getD_eq (scaleBlocks S P (ℓ - 1)) (0, 0) Xi hXi
    rw [← hX_def] at h_eq
    rw [h_eq]
    exact List.getElem_mem hXi
  have hX_P : X.2 ≤ P := (hpart.blocks_bounds (ℓ - 1) (by omega) X hX_mem).2.1
  have hpart_sub : PuqIsSubblockPart subs :=
    ⟨hKX2, fun c hc => (hsub_bounds c hc).2.1, hsub_adj⟩
  obtain ⟨h_smono_le, h_smono_lt⟩ := h_sub_mono subs hpart_sub
  set KX := subs.length with hKX_def
  set NX := KX - 1 with hNX_def
  set pkg := puqConcretePkg S P L kops ℓ Xi
  have h_hiP : (subs.getD (KX - 1) (0, 0)).2 ≤ P := by
    rw [← hNX_def, hsub_last]
    exact hX_P
  have hNX_succ : NX + 1 = KX := by omega

  have h_sub_order : ∀ c1 < KX, ∀ c2 < KX, ∀ u1 u2,
      (subs.getD c1 (0, 0)).1 ≤ u1 → u1 < (subs.getD c1 (0, 0)).2 →
      (subs.getD c2 (0, 0)).1 ≤ u2 → u2 < (subs.getD c2 (0, 0)).2 →
      u1 ≤ u2 → c1 ≤ c2 := by
    intro c1 hc1 c2 hc2 u1 u2 hu1a hu1b hu2a hu2b hu12
    by_contra hgt
    have hc21 : c2 < c1 := by omega
    have hadj := h_smono_lt c2 c1 hc21 hc1
    omega

  have h_phase_win : ∀ p < NX,
      popStep kops (subs.getD p (0, 0)).1 <
        tEmpty kops (subs.getD p (0, 0)).1 (subs.getD p (0, 0)).2 ∧
      tEmpty kops (subs.getD p (0, 0)).1 (subs.getD p (0, 0)).2 ≤
        popStep kops (subs.getD (p + 1) (0, 0)).1 ∧
      popStep kops (subs.getD (p + 1) (0, 0)).1 < kops.length ∧
      popIdx kops (tEmpty kops (subs.getD p (0, 0)).1 (subs.getD p (0, 0)).2) ≤
        (subs.getD (p + 1) (0, 0)).1 := by
    intro p hp
    have hp_KX : p < KX := by omega
    have hp1_KX : p + 1 < KX := by omega
    have hsp_b := hsub_bounds p hp_KX
    have hsp1_b := hsub_bounds (p + 1) hp1_KX
    have hsp_eq := hsub_adj p hp1_KX
    set sp := subs.getD p (0, 0) with hsp_def
    set sp1 := subs.getD (p + 1) (0, 0) with hsp1_def
    have hsp1_P : sp1.1 < P := by omega
    have hsp_lt : sp.1 < sp.2 := hsp_b.2.1
    have hsp_m1_P : sp.2 - 1 < P := by omega
    set ts := popStep kops sp.1 with hts_def
    set t_hi := popStep kops (sp.2 - 1) + 1 with hthi_def
    have h_ts_le : ts ≤ popStep kops (sp.2 - 1) :=
      h_popStep_le sp.1 (sp.2 - 1) (by omega) hsp_m1_P
    have h_thi_le : t_hi ≤ popStep kops sp1.1 := by
      have := hkvalid.popStep_mono (sp.2 - 1) sp1.1 (by omega) hsp1_P
      omega
    have h_pop_sp1_lt : popStep kops sp1.1 < kops.length :=
      (hkvalid.birth_lt_pop sp1.1 hsp1_P).2
    set pred : ℕ → Bool := fun t =>
      (inorderNat (keyedState kops t)).all (fun v => decide (v < sp.1 ∨ sp.2 ≤ v))
    have hpred_ts : pred ts ≠ true := by
      intro hp_true
      have hsp0_P : sp.1 < P := by omega
      have hb_lt := (hkvalid.birth_lt_pop sp.1 hsp0_P).1
      have hmem : sp.1 ∈ inorderNat (keyedState kops ts) :=
        (hkvalid.mem_inorder_iff ts (by omega) sp.1).mpr ⟨hsp0_P, hb_lt, le_rfl⟩
      have hv := (List.all_eq_true.mp hp_true) sp.1 hmem
      simp only [decide_eq_true_eq] at hv
      omega
    have hte_bounds : ts < tEmpty kops sp.1 sp.2 ∧ tEmpty kops sp.1 sp.2 ≤ t_hi := by
      unfold tEmpty
      dsimp (config := { failIfUnchanged := false }) only
      change ts < (match (List.Ico ts (t_hi + 1)).find? pred with | some t => t | none => t_hi) ∧
        (match (List.Ico ts (t_hi + 1)).find? pred with | some t => t | none => t_hi) ≤ t_hi
      rcases hfind : (List.Ico ts (t_hi + 1)).find? pred with _ | t
      · dsimp (config := { failIfUnchanged := false }) only
        exact ⟨Nat.lt_succ_of_le h_ts_le, le_rfl⟩
      · dsimp (config := { failIfUnchanged := false }) only
        have hmem := List.Ico.mem.mp (List.mem_of_find?_eq_some hfind)
        have hpt := List.find?_some hfind
        have hne : t ≠ ts := by
          intro rfl
          exact hpred_ts hpt
        omega
    have hpop_te : popIdx kops (tEmpty kops sp.1 sp.2) ≤ sp1.1 := by
      have h1 := hplug_pop_mono (tEmpty kops sp.1 sp.2) (popStep kops sp1.1)
        (le_trans hte_bounds.2 h_thi_le)
      rwa [hkvalid.popIdx_at_popStep sp1.1 hsp1_P] at h1
    exact ⟨hte_bounds.1, le_trans hte_bounds.2 h_thi_le, h_pop_sp1_lt, hpop_te⟩

  have h_pkg_phase : ∀ p < NX,
      (_root_.BinaryTree.IsBST (pkg.G_init p) ∧ inorderNat (pkg.G_init p) = List.Ico (p + 1) KX) ∧
      (_root_.BinaryTree.IsBST (pkg.G_end p) ∧ inorderNat (pkg.G_end p) = List.Ico (p + 1) KX) ∧
      (∀ c, p + 1 ≤ c → c < KX →
        subtreeMaxNat (pkg.G_init p) c ≤ subtreeMaxNat (pkg.G_end p) c) := by
    intro p hp
    obtain ⟨hts_lt, hte_le, _, _⟩ := h_phase_win p hp
    have h_tr := h_traj_mono subs (p + 1)
      (popStep kops (subs.getD p (0, 0)).1)
      (tEmpty kops (subs.getD p (0, 0)).1 (subs.getD p (0, 0)).2)
      hpart_sub h_hiP (by omega) (le_of_lt hts_lt) hte_le
    exact ⟨h_tr.1, h_tr.2.1, h_tr.2.2.2⟩

  have h_vact_wit : ∀ p < NX, ∀ ca ∈ MMovSet S P L kops ℓ Xi p,
      ∃ (t_e x z c_y : ℕ),
        popStep kops (subs.getD p (0, 0)).1 ≤ t_e ∧
        t_e < tEmpty kops (subs.getD p (0, 0)).1 (subs.getD p (0, 0)).2 ∧
        p + 1 ≤ ca ∧ ca < c_y ∧ c_y < KX ∧
        ca ∈ leftSpineBottomUpNat (pkg.G_init p) ∧
        c_y ∈ leftSpineBottomUpNat (pkg.G_init p) ∧
        (subs.getD ca (0, 0)).1 ≤ x ∧ x < (subs.getD ca (0, 0)).2 ∧ x < P ∧
        (subs.getD c_y (0, 0)).2 ≤ z ∧ z < P ∧
        lcrsParent P (puqPreEmbeddedState P kops (t_e + 1)) x = z ∧
        z ∈ leftSpineBottomUpNat (puqPreEmbeddedState P kops t_e) := by
    intro p hp ca hca
    have hp_KX : p < KX := by omega
    have hsp_bounds := hsub_bounds p hp_KX
    set sp := subs.getD p (0, 0) with hsp_def
    unfold MMovSet at hca
    dsimp (config := { failIfUnchanged := false }) only at hca
    obtain ⟨id, hid_vact, hca_eq⟩ := Finset.mem_image.mp hca
    unfold VActSet at hid_vact
    obtain ⟨hid_b3, hvact⟩ := Finset.mem_filter.mp hid_vact
    unfold B_3_act at hid_b3
    obtain ⟨hid_rng, hb3⟩ := Finset.mem_filter.mp hid_b3
    have hid : id < (jumps kops).length := Finset.mem_range.mp hid_rng
    have hja := hjump.jump_anatomies id hid
    dsimp (config := { failIfUnchanged := false }) only at hja
    set e := (jumps kops)[id]'hid with he_def
    obtain ⟨_, he_step, he_op_opt, _, hs_lt_x, hx_lt_y, hy_lt_z, hz_lt_P,
      ⟨_, _, hls_x, hls_y, hls_z⟩, _⟩ := hja
    have h_jopt : (jumps kops)[id]? = some e := by
      rw [List.getElem?_eq_getElem hid, ← he_def]
    rw [h_jopt] at hca_eq
    change subs.findIdx (fun b => decide (b.1 ≤ e.x ∧ e.x < b.2)) = ca at hca_eq
    unfold isVAct at hvact
    rw [h_jopt] at hvact
    simp only [decide_eq_true_eq] at hvact
    have hvact_sep : sepScale S P L e.x e.y = ℓ := hvact.1
    have hvact_xi : blockIdx S P (ℓ - 1) e.x = Xi := hvact.2.1
    have hvact_s1 : sp.1 ≤ e.s := hvact.2.2.1
    have hvact_s2 : e.s < sp.2 := hvact.2.2.2
    unfold isB3Act at hb3
    rw [h_jopt] at hb3
    simp only [hvact_sep, decide_eq_true_eq] at hb3
    have hb3_sep : sepScale S P L e.s e.x = ℓ := hb3.2.2.1
    have hb3_z : (blockOf S P ℓ e.y).2 ≤ e.z := hb3.2.2.2.1
    have hb3_te : e.step < tEmpty kops (blockOf S P ℓ e.s).1 (blockOf S P ℓ e.s).2 :=
      hb3.2.2.2.2
    have he_op : kops[e.step]'he_step = .pop e.s := by
      rw [List.getElem?_eq_getElem he_step] at he_op_opt
      exact Option.some.inj he_op_opt
    have hsv_e := hkvalid.step_valid e.step he_step
    rw [he_op] at hsv_e
    have hpop_es : popStep kops e.s = e.step := hsv_e.2.1
    have hsP : e.s < P := lt_trans hs_lt_x (lt_trans hx_lt_y (lt_trans hy_lt_z hz_lt_P))
    have hxP : e.x < P := lt_trans hx_lt_y (lt_trans hy_lt_z hz_lt_P)
    have hyP : e.y < P := lt_trans hy_lt_z hz_lt_P
    have h_ts_e : popStep kops sp.1 ≤ e.step := by
      rw [← hpop_es]
      exact h_popStep_le sp.1 e.s hvact_s1 hsP
    have hs_in_X : X.1 ≤ e.s ∧ e.s < X.2 :=
      ⟨le_trans hsp_bounds.1 hvact_s1, lt_of_lt_of_le hvact_s2 hsp_bounds.2.2.1⟩
    obtain ⟨hcp_KX, hcp_blk⟩ := h_sub_find e.s hs_in_X.1 hs_in_X.2
    set cp := subs.findIdx (fun b => decide (b.1 ≤ e.s ∧ e.s < b.2)) with hcp_def
    obtain ⟨_, hbs_lo, hbs_hi, _⟩ := hpart.blocks_partition ℓ hℓL e.s hsP
    rw [← hcp_blk] at hbs_lo hbs_hi
    have hcp_eq_p : cp = p := by
      have h1 := h_sub_order cp hcp_KX p hp_KX e.s e.s hbs_lo hbs_hi hvact_s1 hvact_s2 le_rfl
      have h2 := h_sub_order p hp_KX cp hcp_KX e.s e.s hvact_s1 hvact_s2 hbs_lo hbs_hi le_rfl
      omega
    have hblk_es : blockOf S P ℓ e.s = sp := by
      rw [← hcp_blk, hcp_eq_p, ← hsp_def]
    have h_e_te : e.step < tEmpty kops sp.1 sp.2 := by
      rwa [hblk_es] at hb3_te
    have hx_in_X : X.1 ≤ e.x ∧ e.x < X.2 := (h_bidx_prev e.x hxP).mp hvact_xi
    have hbidx_xy : blockIdx S P (ℓ - 1) e.x = blockIdx S P (ℓ - 1) e.y :=
      (hpart.sep_gt_iff (ℓ - 1) (by omega) e.x hxP e.y hyP).mp (by omega)
    have hy_in_X : X.1 ≤ e.y ∧ e.y < X.2 :=
      (h_bidx_prev e.y hyP).mp (hbidx_xy.symm.trans hvact_xi)
    obtain ⟨hca_KX, hca_blk⟩ := h_sub_find e.x hx_in_X.1 hx_in_X.2
    rw [hca_eq] at hca_KX hca_blk
    obtain ⟨_, hbx_lo, hbx_hi, _⟩ := hpart.blocks_partition ℓ hℓL e.x hxP
    rw [← hca_blk] at hbx_lo hbx_hi
    obtain ⟨hcy_KX, hcy_blk⟩ := h_sub_find e.y hy_in_X.1 hy_in_X.2
    set c_y := subs.findIdx (fun b => decide (b.1 ≤ e.y ∧ e.y < b.2)) with hcy_def
    obtain ⟨_, hby_lo, hby_hi, _⟩ := hpart.blocks_partition ℓ hℓL e.y hyP
    rw [← hcy_blk] at hby_lo hby_hi hb3_z
    have hp_le_ca : p ≤ ca :=
      h_sub_order p hp_KX ca hca_KX e.s e.x hvact_s1 hvact_s2 hbx_lo hbx_hi (le_of_lt hs_lt_x)
    have hp_ne_ca : p ≠ ca := by
      intro hp_eq
      have h_fidx :
          subs.findIdx (fun b => decide (b.1 ≤ e.s ∧ e.s < b.2)) =
            subs.findIdx (fun b => decide (b.1 ≤ e.x ∧ e.x < b.2)) :=
        hcp_def.symm.trans (hcp_eq_p.trans (hp_eq.trans hca_eq.symm))
      have h_bidx := (h_sub_eq_iff e.s hs_in_X.1 hs_in_X.2 e.x hx_in_X.1 hx_in_X.2).mp h_fidx
      have h_sep := (hpart.sep_gt_iff ℓ hℓL e.s hsP e.x hxP).mpr h_bidx
      omega
    have hca_le_cy : ca ≤ c_y :=
      h_sub_order ca hca_KX c_y hcy_KX e.x e.y hbx_lo hbx_hi hby_lo hby_hi (le_of_lt hx_lt_y)
    have hca_ne_cy : ca ≠ c_y := by
      intro hca_cy_eq
      have h_fidx :
          subs.findIdx (fun b => decide (b.1 ≤ e.x ∧ e.x < b.2)) =
            subs.findIdx (fun b => decide (b.1 ≤ e.y ∧ e.y < b.2)) := by
        rw [hca_eq, ← hcy_def, hca_cy_eq]
      have h_bidx := (h_sub_eq_iff e.x hx_in_X.1 hx_in_X.2 e.y hy_in_X.1 hy_in_X.2).mp h_fidx
      have h_sep := (hpart.sep_gt_iff ℓ hℓL e.x hxP e.y hyP).mpr h_bidx
      omega
    have hp1_ca : p + 1 ≤ ca := by omega
    have hca_lt_cy : ca < c_y := by omega
    have hbst_Te : _root_.BinaryTree.IsBST (puqPreEmbeddedState P kops e.step) :=
      (hplug_bst e.step (le_of_lt he_step)).2.1
    have hls_Te_eq :
        leftSpineBottomUpNat (puqPreEmbeddedState P kops e.step) =
          leftSpineBottomUpNat (keyedState kops e.step) ++
            (rightSpineTopDownNat (keyedState kops e.step)).tail := by
      rw [(hplug_pop e.step he_step e.s he_op).2.1, hfold.fold_leftSpine e.step (le_of_lt he_step)]
    have hx_lsTe : e.x ∈ leftSpineBottomUpNat (puqPreEmbeddedState P kops e.step) := by
      rw [hls_Te_eq]
      exact List.mem_append_left _ (List.mem_of_getElem? hls_x)
    have hy_lsTe : e.y ∈ leftSpineBottomUpNat (puqPreEmbeddedState P kops e.step) := by
      rw [hls_Te_eq]
      exact List.mem_append_left _ (List.mem_of_getElem? hls_y)
    have hz_lsTe : e.z ∈ leftSpineBottomUpNat (puqPreEmbeddedState P kops e.step) := by
      rw [hls_Te_eq]
      exact List.mem_append_left _ (List.mem_of_getElem? hls_z)
    have h_lob_x : (subs.getD (p + 1) (0, 0)).1 ≤ e.x :=
      le_trans (h_smono_le (p + 1) ca hp1_ca hca_KX).1 hbx_lo
    have h_y_hib : e.y < (subs.getD (KX - 1) (0, 0)).2 :=
      lt_of_lt_of_le hby_hi (h_smono_le c_y (KX - 1) (by omega) (by omega)).2
    have hx_res :
        e.x ∈ leftSpineBottomUpNat
          (restrictRangeNat (subs.getD (p + 1) (0, 0)).1 (subs.getD (KX - 1) (0, 0)).2
            (puqPreEmbeddedState P kops e.step)) :=
      (hbq_rest_ls (subs.getD (p + 1) (0, 0)).1 (subs.getD (KX - 1) (0, 0)).2
        _ hbst_Te e.x hx_lsTe h_lob_x e.x le_rfl (lt_trans hx_lt_y h_y_hib)).mpr hx_lsTe
    have hy_res :
        e.y ∈ leftSpineBottomUpNat
          (restrictRangeNat (subs.getD (p + 1) (0, 0)).1 (subs.getD (KX - 1) (0, 0)).2
            (puqPreEmbeddedState P kops e.step)) :=
      (hbq_rest_ls (subs.getD (p + 1) (0, 0)).1 (subs.getD (KX - 1) (0, 0)).2
        _ hbst_Te e.x hx_lsTe h_lob_x e.y (le_of_lt hx_lt_y) h_y_hib).mpr hy_lsTe
    have hca_Ge :
        ca ∈ leftSpineBottomUpNat
          (puqBlockQuotient subs (p + 1) KX (puqPreEmbeddedState P kops e.step)) :=
      (hbq_ls_iff subs hpart_sub (p + 1) KX (by omega) le_rfl _ hbst_Te ca).mpr
        ⟨hp1_ca, hca_KX, e.x, hx_res, hbx_lo, hbx_hi⟩
    have hcy_Ge :
        c_y ∈ leftSpineBottomUpNat
          (puqBlockQuotient subs (p + 1) KX (puqPreEmbeddedState P kops e.step)) :=
      (hbq_ls_iff subs hpart_sub (p + 1) KX (by omega) le_rfl _ hbst_Te c_y).mpr
        ⟨by omega, hcy_KX, e.y, hy_res, hby_lo, hby_hi⟩
    obtain ⟨_, hte_le_pop1, _, _⟩ := h_phase_win p hp
    have h_ls_sub :=
      (h_traj_mono subs (p + 1) (popStep kops sp.1) e.step
        hpart_sub h_hiP (by omega) h_ts_e (le_trans (le_of_lt h_e_te) hte_le_pop1)).2.2.1
    have hx_in_He : e.x ∈ inorderNat (keyedState kops e.step) :=
      (hbq_ls_pw _ (hkvalid.isBST_state e.step (le_of_lt he_step))).2 e.x
        (List.mem_of_getElem? hls_x)
    have hx_birth : birthStep kops e.x < e.step :=
      ((hkvalid.mem_inorder_iff e.step (le_of_lt he_step) e.x).mp hx_in_He).2.1
    have hx_pop : e.step < popStep kops e.x := by
      rw [← hpop_es]
      exact hkvalid.popStep_mono e.s e.x hs_lt_x hxP
    have hx_in_He1 : e.x ∈ inorderNat (keyedState kops (e.step + 1)) :=
      (hkvalid.mem_inorder_iff (e.step + 1) he_step e.x).mpr
        ⟨hxP, Nat.lt_succ_of_lt hx_birth, hx_pop⟩
    have hlcrs_e1 : lcrsParent P (puqPreEmbeddedState P kops (e.step + 1)) e.x = e.z := by
      rw [hplug_lcrs_alive (e.step + 1) he_step e.x hx_in_He1]
      exact (hfold.jump_lcrs id hid).2.2
    exact ⟨e.step, e.x, e.z, c_y, h_ts_e, h_e_te, hp1_ca, hca_lt_cy, hcy_KX,
      h_ls_sub ca hca_Ge, h_ls_sub c_y hcy_Ge,
      hbx_lo, hbx_hi, hxP, hb3_z, hz_lt_P, hlcrs_e1, hz_lsTe⟩

  have h_f_lt_last : ∀ p < NX, ∀ ia ∈ pkg.F_idx p,
      ia + 1 < (leftSpineBottomUpNat (pkg.G_init p)).length := by
    intro p hp ia hia
    change ia ∈ (List.range (leftSpineBottomUpNat (pkg.G_init p)).length).filter
      (fun ia => decide ((leftSpineBottomUpNat (pkg.G_init p)).getD ia 0 ∈
        MMovSet S P L kops ℓ Xi p)) at hia
    set pi0 := leftSpineBottomUpNat (pkg.G_init p) with hpi0_def
    have h_pi0_pw : List.Pairwise (· < ·) pi0 :=
      (hbq_ls_pw (pkg.G_init p) (h_pkg_phase p hp).1.1).1
    obtain ⟨hia_rng, hia_mov⟩ := List.mem_filter.mp hia
    have hia_len : ia < pi0.length := List.mem_range.mp hia_rng
    simp only [decide_eq_true_eq] at hia_mov
    obtain ⟨_, _, _, c_y, _, _, _, hca_lt_cy, _, _, hcy_pi0_raw, _⟩ :=
      h_vact_wit p hp (pi0.getD ia 0) hia_mov
    have hcy_pi0 : c_y ∈ pi0 := hcy_pi0_raw
    obtain ⟨iy, hiy_len, hcy_eq⟩ := List.mem_iff_getElem.mp hcy_pi0
    rw [h_getD_eq pi0 0 ia hia_len, ← hcy_eq] at hca_lt_cy
    have hia_lt_iy : ia < iy := by
      by_contra hge
      rcases Nat.eq_or_lt_of_le (Nat.le_of_not_lt hge) with rfl | hlt
      · omega
      · have := (List.pairwise_iff_getElem.mp h_pi0_pw) iy ia hiy_len hia_len hlt
        omega
    omega

  have h_mov_card : ∀ p < NX,
      (pkg.F_idx p).length = (MMovSet S P L kops ℓ Xi p).card := by
    intro p hp
    set pi0 := leftSpineBottomUpNat (pkg.G_init p)
    have h_pi0_pw : List.Pairwise (· < ·) pi0 :=
      (hbq_ls_pw (pkg.G_init p) (h_pkg_phase p hp).1.1).1
    set q : ℕ → Bool := fun c => decide (c ∈ MMovSet S P L kops ℓ Xi p)
    set f : ℕ → ℕ := fun ia => pi0.getD ia 0
    have h_map_range : (List.range pi0.length).map f = pi0 := by
      apply List.ext_getElem
      · simp
      · intro i h1 h2
        simp [f, List.getD_eq_getElem?_getD, h2]
    have h_filt_eq : pi0.filter q = (pkg.F_idx p).map f := by
      calc pi0.filter q
          = ((List.range pi0.length).map f).filter q := by rw [h_map_range]
        _ = ((List.range pi0.length).filter (q ∘ f)).map f := List.filter_map
        _ = (pkg.F_idx p).map f := rfl
    have h_pi0_nodup : pi0.Nodup :=
      List.nodup_iff_pairwise_ne.mpr (h_pi0_pw.imp (fun h => Nat.ne_of_lt h))
    have h_filt_nodup : (pi0.filter q).Nodup := List.Nodup.filter q h_pi0_nodup
    have h_card_len : (pi0.filter q).toFinset.card = (pi0.filter q).length :=
      List.toFinset_card_of_nodup h_filt_nodup
    have h_finset_eq : (pi0.filter q).toFinset = MMovSet S P L kops ℓ Xi p := by
      ext c
      simp only [List.mem_toFinset, List.mem_filter, q, decide_eq_true_eq]
      constructor
      · exact fun h => h.2
      · intro hc
        obtain ⟨_, _, _, _, _, _, _, _, _, hca_pi0, _⟩ := h_vact_wit p hp c hc
        exact ⟨hca_pi0, hc⟩
    rw [← h_finset_eq, h_card_len, h_filt_eq, List.length_map]

  have h_run_dom : ∀ p < NX, ∀ ia ∈ pkg.F_idx p,
      subtreeMaxNat (pkg.G_init p) ((leftSpineBottomUpNat (pkg.G_init p)).getD (ia + 1) 0) ≤
        subtreeMaxNat (pkg.G_end p) ((leftSpineBottomUpNat (pkg.G_init p)).getD ia 0) := by
    intro p hp ia hia
    have hia1_len : ia + 1 < (leftSpineBottomUpNat (pkg.G_init p)).length :=
      h_f_lt_last p hp ia hia
    obtain ⟨hts_lt_te, hte_le_pop1, hpop1_lt_len, hpop_te⟩ := h_phase_win p hp
    change ia ∈ (List.range (leftSpineBottomUpNat (pkg.G_init p)).length).filter
      (fun ia => decide ((leftSpineBottomUpNat (pkg.G_init p)).getD ia 0 ∈
        MMovSet S P L kops ℓ Xi p)) at hia
    set sp := subs.getD p (0, 0) with hsp_def
    set ts := popStep kops sp.1 with hts_def
    set te := tEmpty kops sp.1 sp.2 with hte_def
    set pi0 := leftSpineBottomUpNat (pkg.G_init p) with hpi0_def
    set ca := pi0.getD ia 0 with hca_def
    set c_next := pi0.getD (ia + 1) 0 with hcnext_def
    have hia_len : ia < pi0.length := by omega
    have hca_mov : ca ∈ MMovSet S P L kops ℓ Xi p := by
      have hm := (List.mem_filter.mp hia).2
      simpa only [decide_eq_true_eq] using hm
    obtain ⟨t_e, x, z, c_y, h_ts_e_raw, h_e_te_raw, hp1_ca, hca_cy, hcy_KX, _, hcy_pi0_raw,
      hca_x1, hca_x2, hx_P, hcy_z, _hz_P, hlcrs_e1, hz_ls_Te⟩ := h_vact_wit p hp ca hca_mov
    have h_ts_e : ts ≤ t_e := h_ts_e_raw
    have h_e_te : t_e < te := h_e_te_raw
    have hcy_pi0 : c_y ∈ pi0 := hcy_pi0_raw
    have hte_len : te ≤ kops.length := by omega
    obtain ⟨h_pi0_pw_raw, h_pi0_in⟩ := hbq_ls_pw (pkg.G_init p) (h_pkg_phase p hp).1.1
    have h_pi0_pw : List.Pairwise (· < ·) pi0 := h_pi0_pw_raw
    have hcnext_eq : c_next = pi0[ia + 1] := h_getD_eq pi0 0 (ia + 1) hia1_len
    have hcnext_pi0 : c_next ∈ pi0 := by
      rw [hcnext_eq]
      exact List.getElem_mem hia1_len
    have hcnext_in : c_next ∈ List.Ico (p + 1) KX := by
      rw [← (h_pkg_phase p hp).1.2]
      exact h_pi0_in c_next hcnext_pi0
    obtain ⟨hp1_cnext, hcnext_KX⟩ := List.Ico.mem.mp hcnext_in
    obtain ⟨iy, hiy_len, hcy_eq⟩ := List.mem_iff_getElem.mp hcy_pi0
    have hca_eq_elem : ca = pi0[ia] := h_getD_eq pi0 0 ia hia_len
    have hia_lt_iy : ia < iy := by
      by_contra hge
      rcases Nat.eq_or_lt_of_le (Nat.le_of_not_lt hge) with rfl | hlt
      · rw [hca_eq_elem, ← hcy_eq] at hca_cy
        omega
      · have := (List.pairwise_iff_getElem.mp h_pi0_pw) iy ia hiy_len hia_len hlt
        rw [← hca_eq_elem, hcy_eq] at this
        omega
    have hcnext_le_cy : c_next ≤ c_y := by
      have hia1_le_iy : ia + 1 ≤ iy := by omega
      rcases Nat.eq_or_lt_of_le hia1_le_iy with heq | hlt
      · have hcy_getD : c_y = pi0.getD iy 0 := by
          rw [h_getD_eq pi0 0 iy hiy_len, hcy_eq]
        rw [hcnext_def, hcy_getD, heq]
      · have := (List.pairwise_iff_getElem.mp h_pi0_pw) (ia + 1) iy hia1_len hiy_len hlt
        rw [← hcnext_eq, hcy_eq] at this
        omega
    have hpop_te_le_x : popIdx kops te ≤ x :=
      le_trans hpop_te (le_trans (h_smono_le (p + 1) ca hp1_ca (lt_trans hca_cy hcy_KX)).1 hca_x1)
    have hz_le_lcrs_te : z ≤ lcrsParent P (puqPreEmbeddedState P kops te) x := by
      rw [← hlcrs_e1]
      exact h_lcrs_mono_range (t_e + 1) te (by omega) hte_len x hpop_te_le_x hx_P
    by_cases hz_top : (subs.getD (KX - 1) (0, 0)).2 ≤ z
    · obtain ⟨_, hbst_te, hin_te⟩ := hplug_bst te hte_len
      have h_low := hbq_smax_lower subs hpart_sub (p + 1) KX (by omega) le_rfl
        _ (popIdx kops te) P P ca KX hbst_te hin_te hpop_te h_hiP h_hiP hp1_ca (by omega) le_rfl
        ⟨x, hca_x1, hca_x2, le_trans hz_top hz_le_lcrs_te⟩
      have h_up := ((hbq_smax_ls (pkg.G_init p) (p + 1) KX
        (h_pkg_phase p hp).1.1 (h_pkg_phase p hp).1.2).1 c_next hp1_cnext hcnext_KX).2
      change KX ≤ subtreeMaxNat (pkg.G_end p) ca + 1 at h_low
      omega
    · have hz_lt_hi : z < (subs.getD (KX - 1) (0, 0)).2 := by omega
      have h_loc_z : ∀ K, c_y < K → K ≤ KX → z < (subs.getD (K - 1) (0, 0)).2 →
          ∃ c_z, c_y < c_z ∧ c_z < K ∧
            (subs.getD c_z (0, 0)).1 ≤ z ∧ z < (subs.getD c_z (0, 0)).2 := by
        intro K
        induction K with
        | zero =>
          intro h
          omega
        | succ K ih =>
          intro hcyK hKKX hzK
          simp only [Nat.add_sub_cancel] at hzK
          have hcy_lt_K : c_y < K := by
            by_contra hle
            have heq : c_y = K := by omega
            rw [← heq] at hzK
            omega
          by_cases hz_lo : (subs.getD K (0, 0)).1 ≤ z
          · exact ⟨K, hcy_lt_K, Nat.lt_succ_self K, hz_lo, hzK⟩
          · have hKm1_adj : (subs.getD (K - 1) (0, 0)).2 = (subs.getD K (0, 0)).1 := by
              have h1 : (K - 1) + 1 = K := by omega
              have hadj := hsub_adj (K - 1) (by omega)
              rwa [h1] at hadj
            obtain ⟨c_z, h1, h2, h3, h4⟩ := ih hcy_lt_K (by omega) (by omega)
            exact ⟨c_z, h1, by omega, h3, h4⟩
      obtain ⟨c_z, hcy_lt_cz, hcz_lt_KX, hcz_z1, hcz_z2⟩ :=
        h_loc_z KX hcy_KX le_rfl hz_lt_hi
      obtain ⟨_, hbst_te, hin_te⟩ := hplug_bst te hte_len
      have hcz_m1_adj : (subs.getD (c_z - 1) (0, 0)).2 = (subs.getD c_z (0, 0)).1 := by
        have h1 : (c_z - 1) + 1 = c_z := by omega
        have hadj := hsub_adj (c_z - 1) (by omega)
        rwa [h1] at hadj
      have h_low := hbq_smax_lower subs hpart_sub (p + 1) KX (by omega) le_rfl
        _ (popIdx kops te) P P ca c_z hbst_te hin_te hpop_te h_hiP h_hiP
        hp1_ca (by omega) (by omega)
        ⟨x, hca_x1, hca_x2, le_trans (hcz_m1_adj.trans_le hcz_z1) hz_le_lcrs_te⟩
      have h_up : subtreeMaxNat (pkg.G_init p) c_next < c_z := by
        rcases Nat.eq_or_lt_of_le hcnext_le_cy with h_eq_cy | h_lt_cy
        · rw [h_eq_cy]
          obtain ⟨_, hbst_ts, hin_ts⟩ := hplug_bst ts (by omega)
          obtain ⟨_, hbst_e, hin_e⟩ := hplug_bst t_e (by omega)
          have hpop_ts : popIdx kops ts ≤ (subs.getD (p + 1) (0, 0)).1 :=
            le_trans (hplug_pop_mono ts te (le_of_lt hts_lt_te)) hpop_te
          refine hbq_smax_upper subs hpart_sub (p + 1) KX (by omega) le_rfl
            _ (popIdx kops ts) P P c_y c_z hbst_ts hin_ts hpop_ts h_hiP h_hiP
            (by omega) hcy_lt_cz hcz_lt_KX ?_
          intro r hr1 hr2
          have hr_P : r < P :=
            lt_of_lt_of_le hr2 (le_trans (hsub_bounds c_y hcy_KX).2.2.1 hX_P)
          have hpop_e_le_r : popIdx kops t_e ≤ r :=
            le_trans (hplug_pop_mono t_e te (le_of_lt h_e_te))
              (le_trans hpop_te (le_trans (h_smono_le (p + 1) c_y (by omega) hcy_KX).1 hr1))
          have h_mono_r := h_lcrs_mono_range ts t_e h_ts_e (by omega) r hpop_e_le_r hr_P
          have hr_in_Te : r ∈ inorderNat (puqPreEmbeddedState P kops t_e) := by
            rw [hin_e]
            exact List.Ico.mem.mpr ⟨hpop_e_le_r, hr_P⟩
          have h_le_z := hbq_lcrs_ls _ P r z hbst_e hr_in_Te hz_ls_Te (lt_of_lt_of_le hr2 hcy_z)
          exact lt_of_le_of_lt (le_trans h_mono_r h_le_z) hcz_z2
        · have h_lt := (hbq_smax_ls (pkg.G_init p) (p + 1) KX
            (h_pkg_phase p hp).1.1 (h_pkg_phase p hp).1.2).2 c_next hcnext_pi0 c_y hcy_pi0 h_lt_cy
          omega
      change c_z ≤ subtreeMaxNat (pkg.G_end p) ca + 1 at h_low
      omega

  refine ⟨?_, h_mov_card⟩
  refine
    { bst_init := fun p hp => (h_pkg_phase p hp).1.1
      bst_end := fun p hp => (h_pkg_phase p hp).2.1.1
      inorder_init := by
        intro p hp
        rw [hNX_succ]
        exact (h_pkg_phase p hp).1.2
      inorder_end := by
        intro p hp
        rw [hNX_succ]
        exact (h_pkg_phase p hp).2.1.2
      reach_mono := by
        intro p hp c hc1 hc2
        exact (h_pkg_phase p hp).2.2 c hc1 (by omega)
      f_strictMono := by
        intro p _
        exact List.Pairwise.filter _ List.pairwise_lt_range
      f_lt_last := h_f_lt_last
      run_dom := h_run_dom
      u_gap_len := by
        intro p _
        change ((List.range ((pkg.F_idx p).length - 1)).map _).length = _
        simp
      gap_bound := by
        intro p _ r hr
        have hr_len : r < (pkg.F_idx p).length - 1 := by omega
        have h_ugap_eq : (pkg.u_gap p).getD r 0 =
            (pkg.F_idx p).getD (r + 1) 0 - (pkg.F_idx p).getD r 0 - 4 := by
          change ((List.range ((pkg.F_idx p).length - 1)).map
            (fun r => (pkg.F_idx p).getD (r + 1) 0 - (pkg.F_idx p).getD r 0 - 4)).getD r 0 = _
          rw [h_getD_eq _ 0 r (by simp [hr_len])]
          simp
        rw [h_ugap_eq]
        omega
      phase_dom := by
        intro p hp1 c hc1 hc2
        have hp : p < NX := by omega
        obtain ⟨_, hte_le_pop1, hpop1_lt, _⟩ := h_phase_win p hp
        obtain ⟨hts1_lt, hte1_le, _, _⟩ := h_phase_win (p + 1) hp1
        have hte_len : tEmpty kops (subs.getD p (0, 0)).1 (subs.getD p (0, 0)).2 ≤ kops.length :=
          le_of_lt (lt_of_le_of_lt hte_le_pop1 hpop1_lt)
        have hbst_te : _root_.BinaryTree.IsBST
            (puqPreEmbeddedState P kops
              (tEmpty kops (subs.getD p (0, 0)).1 (subs.getD p (0, 0)).2)) :=
          (hplug_bst _ hte_len).2.1
        rw [hNX_succ]
        have h_rest : restrictRangeNat (p + 2) KX (pkg.G_end p) =
            puqBlockQuotient subs (p + 2) KX
              (puqPreEmbeddedState P kops
                (tEmpty kops (subs.getD p (0, 0)).1 (subs.getD p (0, 0)).2)) :=
          hbq_rest_out subs hpart_sub (p + 1) (p + 2) KX (by omega) (by omega) le_rfl _ hbst_te
        rw [h_rest]
        have h_tr := h_traj_mono subs (p + 2)
          (tEmpty kops (subs.getD p (0, 0)).1 (subs.getD p (0, 0)).2)
          (popStep kops (subs.getD (p + 1) (0, 0)).1)
          hpart_sub h_hiP (by omega) hte_le_pop1 (le_trans (le_of_lt hts1_lt) hte1_le)
        exact h_tr.2.2.2 c hc1 (by omega) }

private theorem single_phase_gap_charged_bound_omega (P L : ℕ) (S : ℕ → ℕ) (kops : List KeyedCoreOp)
    (hP : 1 ≤ P) (hL : 1 ≤ L) (hS0 : S 0 = P) (hSL_pos : 1 ≤ S L)
    (hS_step : ∀ ℓ : ℕ, ℓ < L → 2 * S (ℓ + 1) ≤ S ℓ)
    (hkvalid : ValidKeyedCoreSeq P kops) (hjump : PrimalJumpLaws P kops)
    (hfold : ValidFoldedCoreLaws P kops) (hpart : ScalePartitionLawsOmega S P L)
    (hplug : PuqPlugUnbornLaws P kops) (hbq : PuqBlockQuotientLaws) :
    ∀ ℓ, 1 ≤ ℓ → ℓ ≤ L → ∀ Xi < (scaleBlocks S P (ℓ - 1)).length,
      let X := (scaleBlocks S P (ℓ - 1)).getD Xi (0, 0)
      let subs := splitBlock (S ℓ) X.1 X.2
      ∀ p < subs.length - 1,
        ((puqConcretePkg S P L kops ℓ Xi).u_gap p).sum ≤
          ((Finset.Ico (p + 1) subs.length).filter
            (fun c => puqIsChargedSubblockOmega S P L kops ℓ Xi p c = true)).card :=
by
  have _ := hP; have _ := hL; have _ := hS0; have _ := hSL_pos; have _ := hS_step
  classical
  have h_nested := blockOf_nested_omega S P L hpart
  rcases hplug with ⟨hplug_bst, hplug_pop_mono, _hplug3, _hplug4,
    hplug_rslr0, hplug_rslr_succ, hplug_push, hplug_pop, hplug_jumps, hplug_rs⟩
  clear _hplug3 _hplug4
  rcases hbq with ⟨hbq_bst, hbq_inord, _hbq3, _hbq4, hbq_ls_iff,
    hbq_rest_ls, hbq_splice, hbq_rot, hbq_evict, hbq_rot_bst, hbq_ls_pw, _hbq_tail⟩
  clear _hbq3 _hbq4 _hbq_tail

  have h_step_trans : ∀ (Q : ℕ → Prop) (a b : ℕ),
      a < b → Q a → ¬ Q b → ∃ t, a ≤ t ∧ t < b ∧ Q t ∧ ¬ Q (t + 1) := by
    intro Q a b
    induction b with
    | zero => intro h; omega
    | succ b ih =>
      intro hab hQa hQbs
      by_cases hQb : Q b
      · exact ⟨b, by omega, by omega, hQb, hQbs⟩
      · rcases eq_or_lt_of_le (Nat.le_of_lt_succ hab) with rfl | hlt
        · exact absurd hQa hQb
        · obtain ⟨t, hat, htb, hQt, hQt1⟩ := ih hlt hQa hQb
          exact ⟨t, hat, by omega, hQt, hQt1⟩

  have h_step_trans_rev : ∀ (Q : ℕ → Prop) (a b : ℕ),
      a < b → ¬ Q a → Q b → ∃ t, a ≤ t ∧ t < b ∧ ¬ Q t ∧ Q (t + 1) := by
    intro Q a b hab hnQa hQb
    obtain ⟨t, hat, htb, hnQt, hnnQt1⟩ :=
      h_step_trans (fun n => ¬ Q n) a b hab hnQa (fun h => h hQb)
    exact ⟨t, hat, htb, hnQt, Classical.not_not.mp hnnQt1⟩

  have h_eraseIdx_mem : ∀ (xs : List ℕ) (d r : ℕ), r ∈ xs.eraseIdx d → r ∈ xs := by
    intro xs
    induction xs with
    | nil => intro d r h; simp at h
    | cons x xs ih =>
      intro d r h
      rcases d with _ | d
      · exact List.mem_cons_of_mem x h
      · simp only [List.eraseIdx_cons_succ, List.mem_cons] at h ⊢
        rcases h with rfl | hr
        · exact Or.inl rfl
        · exact Or.inr (ih d r hr)

  have h_eraseIdx_getD : ∀ (xs : List ℕ) (d r : ℕ),
      d < xs.length → r ∈ xs → r ∉ xs.eraseIdx d → xs.getD d 0 = r := by
    intro xs
    induction xs with
    | nil => intro d r hd; simp at hd
    | cons x xs ih =>
      intro d r hd hr hnr
      rcases d with _ | d
      · simp only [List.eraseIdx_zero] at hnr
        rcases List.mem_cons.mp hr with rfl | hmem
        · rfl
        · exact absurd hmem hnr
      · simp only [List.length_cons] at hd
        simp only [List.eraseIdx_cons_succ, List.mem_cons, not_or] at hnr
        rcases List.mem_cons.mp hr with rfl | hmem
        · exact absurd rfl hnr.1
        · exact ih d r (by omega) hmem hnr.2

  have h_rs_sub_inord : ∀ (B : _root_.BinaryTree ℕ) (v : ℕ),
      v ∈ rightSpineTopDownNat B → v ∈ inorderNat B := by
    intro B
    induction B with
    | nil => intro v hv; simp [rightSpineTopDownNat] at hv
    | node k l r _ ihr =>
      intro v hv
      simp only [rightSpineTopDownNat, List.mem_cons] at hv
      simp only [inorderNat, List.mem_append, List.mem_singleton]
      rcases hv with rfl | hvr
      · exact Or.inl (Or.inr rfl)
      · exact Or.inr (ihr v hvr)

  have h_forall_inord : ∀ (q : ℕ → Prop) (B : _root_.BinaryTree ℕ),
      _root_.SplayDeque.Direct.ForallTree q B → ∀ v ∈ inorderNat B, q v := by
    intro q B hB
    induction hB with
    | left => intro v hv; simp [inorderNat] at hv
    | node l k r _ hqk _ ihl ihr =>
      intro v hv
      simp only [inorderNat, List.mem_append, List.mem_singleton] at hv
      rcases hv with (hvl | rfl) | hvr
      · exact ihl v hvl
      · exact hqk
      · exact ihr v hvr

  have h_s1 : ∀ (lo hi : ℕ) (pi0 f : List ℕ) (charged : ℕ → Bool),
      List.Pairwise (· < ·) pi0 →
      (∀ c ∈ pi0, lo ≤ c ∧ c < hi) →
      List.Pairwise (· < ·) f →
      (∀ i ∈ f, i < pi0.length) →
      (∀ r, r + 1 < f.length → ∃ e1 e2 e3 : ℕ, ∀ ic,
        f.getD r 0 < ic → ic < f.getD (r + 1) 0 →
          charged (pi0.getD ic 0) = true ∨
            pi0.getD ic 0 = e1 ∨ pi0.getD ic 0 = e2 ∨ pi0.getD ic 0 = e3) →
      ((List.range (f.length - 1)).map (fun r => f.getD (r + 1) 0 - f.getD r 0 - 4)).sum ≤
        ((Finset.Ico lo hi).filter (fun c => charged c = true)).card := by
    intro lo hi pi0 f charged hpi0_pw hpi0_bds hf_pw hf_lt hgap
    have h_list_sum : ∀ (R : ℕ) (g : ℕ → ℕ),
        ((List.range R).map g).sum = (Finset.range R).sum g := by
      intro R g
      induction R with
      | zero => simp
      | succ R ih =>
        rw [List.range_succ, List.map_append, List.sum_append, ih, Finset.sum_range_succ]
        simp
    rw [h_list_sum]
    let R := f.length - 1
    let V : ℕ → Finset ℕ := fun r =>
      (Finset.Ioo (f.getD r 0) (f.getD (r + 1) 0)).image (fun ic => pi0.getD ic 0)
    let C : ℕ → Finset ℕ := fun r => (V r).filter (fun c => charged c = true)
    have hf_getD : ∀ k (hk : k < f.length), f.getD k 0 = f[k] := by
      intro k hk; rw [List.getD_eq_getElem?_getD, List.getElem?_eq_getElem hk]; rfl
    have hpi0_getD : ∀ i (hi : i < pi0.length), pi0.getD i 0 = pi0[i] := by
      intro i hi; rw [List.getD_eq_getElem?_getD, List.getElem?_eq_getElem hi]; rfl
    have hf_mono : ∀ k1 k2 (hk1 : k1 < f.length) (hk2 : k2 < f.length),
        k1 ≤ k2 → f[k1] ≤ f[k2] := by
      intro k1 k2 hk1 hk2 hle
      rcases eq_or_lt_of_le hle with rfl | hlt
      · exact le_rfl
      · exact le_of_lt (List.pairwise_iff_getElem.mp hf_pw k1 k2 hk1 hk2 hlt)
    have hpi0_inj : ∀ i1 i2 (hi1 : i1 < pi0.length) (hi2 : i2 < pi0.length),
        pi0[i1] = pi0[i2] → i1 = i2 := by
      intro i1 i2 hi1 hi2 heq
      rcases lt_trichotomy i1 i2 with hlt | rfl | hgt
      · have := List.pairwise_iff_getElem.mp hpi0_pw i1 i2 hi1 hi2 hlt; omega
      · rfl
      · have := List.pairwise_iff_getElem.mp hpi0_pw i2 i1 hi2 hi1 hgt; omega
    have h_each : ∀ r ∈ Finset.range R,
        f.getD (r + 1) 0 - f.getD r 0 - 4 ≤ (C r).card := by
      intro r hr
      rw [Finset.mem_range] at hr
      have hr1 : r + 1 < f.length := by omega
      have hib_lt : f.getD (r + 1) 0 < pi0.length := by
        rw [hf_getD (r + 1) hr1]; exact hf_lt f[r + 1] (List.getElem_mem hr1)
      have hV_card : (V r).card = f.getD (r + 1) 0 - f.getD r 0 - 1 := by
        have hinj : Set.InjOn (fun ic => pi0.getD ic 0) ↑(Finset.Ioo (f.getD r 0) (f.getD (r + 1) 0)) := by
          intro i1 hi1 i2 hi2 heq
          simp only [Finset.mem_coe, Finset.mem_Ioo] at hi1 hi2
          dsimp (config := { failIfUnchanged := false }) only at heq
          have hi1_lt : i1 < pi0.length := by omega
          have hi2_lt : i2 < pi0.length := by omega
          rw [hpi0_getD i1 hi1_lt, hpi0_getD i2 hi2_lt] at heq
          exact hpi0_inj i1 i2 hi1_lt hi2_lt heq
        rw [Finset.card_image_of_injOn hinj, Nat.card_Ioo]
      obtain ⟨e1, e2, e3, hgap_r⟩ := hgap r hr1
      let E : Finset ℕ := insert e1 (insert e2 {e3})
      have hE_card : E.card ≤ 3 := by
        dsimp (config := { failIfUnchanged := false }) only [E]
        have h1 := Finset.card_insert_le e1 (insert e2 ({e3} : Finset ℕ))
        have h2 := Finset.card_insert_le e2 ({e3} : Finset ℕ)
        have h3 : ({e3} : Finset ℕ).card = 1 := Finset.card_singleton e3
        omega
      have hV_sub : V r ⊆ C r ∪ E := by
        intro c hc
        obtain ⟨ic, hic, rfl⟩ := Finset.mem_image.mp hc
        rw [Finset.mem_Ioo] at hic
        rcases hgap_r ic hic.1 hic.2 with hch | he1 | he2 | he3
        · exact Finset.mem_union_left _ (Finset.mem_filter.mpr ⟨hc, hch⟩)
        · rw [he1]; exact Finset.mem_union_right _ (by simp [E])
        · rw [he2]; exact Finset.mem_union_right _ (by simp [E])
        · rw [he3]; exact Finset.mem_union_right _ (by simp [E])
      have hcard_le : (V r).card ≤ (C r).card + E.card :=
        le_trans (Finset.card_le_card hV_sub) (Finset.card_union_le (C r) E)
      omega
    have h_disj : (↑(Finset.range R) : Set ℕ).PairwiseDisjoint C := by
      intro r1 hr1 r2 hr2 hne
      simp only [Finset.mem_coe, Finset.mem_range] at hr1 hr2
      change Disjoint (C r1) (C r2)
      rw [Finset.disjoint_left]
      intro c hc1 hc2
      obtain ⟨i1, hi1, heq1⟩ := Finset.mem_image.mp (Finset.mem_filter.mp hc1).1
      obtain ⟨i2, hi2, heq2⟩ := Finset.mem_image.mp (Finset.mem_filter.mp hc2).1
      rw [Finset.mem_Ioo] at hi1 hi2
      have hr1_1 : r1 + 1 < f.length := by omega
      have hr2_1 : r2 + 1 < f.length := by omega
      have hib1_lt : f.getD (r1 + 1) 0 < pi0.length := by
        rw [hf_getD (r1 + 1) hr1_1]; exact hf_lt f[r1 + 1] (List.getElem_mem hr1_1)
      have hib2_lt : f.getD (r2 + 1) 0 < pi0.length := by
        rw [hf_getD (r2 + 1) hr2_1]; exact hf_lt f[r2 + 1] (List.getElem_mem hr2_1)
      have hi1_lt : i1 < pi0.length := by omega
      have hi2_lt : i2 < pi0.length := by omega
      rw [hpi0_getD i1 hi1_lt] at heq1
      rw [hpi0_getD i2 hi2_lt] at heq2
      have hi_eq : i1 = i2 := hpi0_inj i1 i2 hi1_lt hi2_lt (heq1.trans heq2.symm)
      rcases lt_or_gt_of_ne hne with hlt | hgt
      · have hle : f[r1 + 1] ≤ f[r2] := hf_mono (r1 + 1) r2 hr1_1 (by omega) (by omega)
        rw [hf_getD (r1 + 1) hr1_1] at hi1; rw [hf_getD r2 (by omega)] at hi2; omega
      · have hle : f[r2 + 1] ≤ f[r1] := hf_mono (r2 + 1) r1 hr2_1 (by omega) (by omega)
        rw [hf_getD (r2 + 1) hr2_1] at hi2; rw [hf_getD r1 (by omega)] at hi1; omega
    have h_sub : (Finset.range R).biUnion C ⊆ (Finset.Ico lo hi).filter (fun c => charged c = true) := by
      intro c hc
      obtain ⟨r, hr, hcr⟩ := Finset.mem_biUnion.mp hc
      rw [Finset.mem_range] at hr
      obtain ⟨hcv, hch⟩ := Finset.mem_filter.mp hcr
      obtain ⟨ic, hic, rfl⟩ := Finset.mem_image.mp hcv
      rw [Finset.mem_Ioo] at hic
      have hr1 : r + 1 < f.length := by omega
      have hib_lt : f.getD (r + 1) 0 < pi0.length := by
        rw [hf_getD (r + 1) hr1]; exact hf_lt f[r + 1] (List.getElem_mem hr1)
      have hic_lt : ic < pi0.length := by omega
      have hc_mem : pi0.getD ic 0 ∈ pi0 := by
        rw [hpi0_getD ic hic_lt]; exact List.getElem_mem hic_lt
      exact Finset.mem_filter.mpr ⟨Finset.mem_Ico.mpr (hpi0_bds _ hc_mem), hch⟩
    calc
      (Finset.range R).sum (fun r => f.getD (r + 1) 0 - f.getD r 0 - 4) ≤
          (Finset.range R).sum (fun r => (C r).card) := Finset.sum_le_sum h_each
      _ = ((Finset.range R).biUnion C).card := (Finset.card_biUnion h_disj).symm
      _ ≤ ((Finset.Ico lo hi).filter (fun c => charged c = true)).card := Finset.card_le_card h_sub


  have h_ls_pw : ∀ t ≤ kops.length, List.Pairwise (· < ·) (leftSpineBottomUpNat (keyedState kops t)) := by
    intro t ht
    have hpw := (hbq_ls_pw _ (hfold.fold_bst_inorder t ht).1).1
    rw [hfold.fold_leftSpine t ht] at hpw
    exact (List.pairwise_append.mp hpw).1

  have h_ls_last : ∀ t ≤ kops.length, keyedState kops t ≠ .nil →
      leftSpineBottomUpNat (keyedState kops t) ≠ [] ∧
      (leftSpineBottomUpNat (keyedState kops t))[(leftSpineBottomUpNat (keyedState kops t)).length - 1]? =
        some (foldBST P (keyedState kops t)).2 := by
    intro t ht hne
    rcases hfold.fold_cursor t ht with ⟨hemp, _⟩ | ⟨_, _, hlast⟩
    · exact absurd hemp hne
    · have hls_ne : leftSpineBottomUpNat (keyedState kops t) ≠ [] := by
        intro hnil; simp [hnil] at hlast
      refine ⟨hls_ne, ?_⟩
      rw [List.getLast?_eq_some_getLast hls_ne, List.getLast_eq_getElem hls_ne] at hlast
      injection hlast with hb0
      have hlen_lt : (leftSpineBottomUpNat (keyedState kops t)).length - 1 <
          (leftSpineBottomUpNat (keyedState kops t)).length := by
        have := List.length_pos_iff_ne_nil.mpr hls_ne; omega
      rw [List.getElem?_eq_getElem hlen_lt, hb0]

  have h_rs_ge_b0 : ∀ t ≤ kops.length, keyedState kops t ≠ .nil →
      (∀ v ∈ rightSpineTopDownNat (keyedState kops t), (foldBST P (keyedState kops t)).2 ≤ v) ∧
      (∀ v ∈ (rightSpineTopDownNat (keyedState kops t)).tail, (foldBST P (keyedState kops t)).2 < v) := by
    intro t ht hne
    have hbst := hkvalid.isBST_state t ht
    rcases hH : keyedState kops t with _ | ⟨b0, l0, r0⟩
    · exact absurd hH hne
    · rw [hH] at hbst
      cases hbst using isBSTCases with
      | node _ _ _ _ hr_gt _ _ =>
        have htail : ∀ v ∈ rightSpineTopDownNat r0, b0 < v :=
          fun v hv => h_forall_inord (fun k => b0 < k) r0 hr_gt v (h_rs_sub_inord r0 v hv)
        refine ⟨?_, ?_⟩
        · intro v hv
          simp only [foldBST, rightSpineTopDownNat, List.mem_cons] at hv ⊢
          rcases hv with rfl | hv'
          · exact le_rfl
          · exact le_of_lt (htail v hv')
        · intro v hv
          simp only [foldBST, rightSpineTopDownNat, List.tail_cons] at hv ⊢
          exact htail v hv

  have h_root_dichotomy : ∀ t ≤ kops.length, keyedState kops t ≠ .nil →
      ∀ r_c ∈ leftSpineBottomUpNat (foldBST P (keyedState kops t)).1,
        (r_c < (foldBST P (keyedState kops t)).2 → r_c ∈ leftSpineBottomUpNat (keyedState kops t)) ∧
        ((foldBST P (keyedState kops t)).2 ≤ r_c → r_c ∈ rightSpineTopDownNat (keyedState kops t)) := by
    intro t ht hne r_c hrc
    rw [hfold.fold_leftSpine t ht, List.mem_append] at hrc
    obtain ⟨hrs_ge, hrs_gt⟩ := h_rs_ge_b0 t ht hne
    obtain ⟨hls_ne, hls_last⟩ := h_ls_last t ht hne
    have hpw := h_ls_pw t ht
    refine ⟨?_, ?_⟩
    · intro hlt
      rcases hrc with hls | hrs
      · exact hls
      · have := hrs_gt r_c hrs; omega
    · intro hge
      rcases hrc with hls | hrs
      · obtain ⟨idx, hidx, rfl⟩ := List.mem_iff_getElem.mp hls
        have hlast_idx : (leftSpineBottomUpNat (keyedState kops t)).length - 1 <
            (leftSpineBottomUpNat (keyedState kops t)).length := by omega
        rw [List.getElem?_eq_getElem hlast_idx] at hls_last
        injection hls_last with hb0_eq
        have hle_b0 : (leftSpineBottomUpNat (keyedState kops t))[idx] ≤
            (foldBST P (keyedState kops t)).2 := by
          rcases eq_or_lt_of_le (Nat.le_sub_one_of_lt hidx) with heq | hlt_i
          · simp [heq, hb0_eq]
          · have := List.pairwise_iff_getElem.mp hpw idx _ hidx hlast_idx hlt_i
            omega
        have heq_b0 : (leftSpineBottomUpNat (keyedState kops t))[idx] =
            (foldBST P (keyedState kops t)).2 := by omega
        rcases hfold.fold_cursor t ht with ⟨hemp, _⟩ | ⟨_, hrs_head, _⟩
        · exact absurd hemp hne
        · rcases hrs_list : rightSpineTopDownNat (keyedState kops t) with _ | ⟨hd, tl⟩
          · simp [hrs_list] at hrs_head
          · simp only [hrs_list, List.head?_cons, Option.some.injEq] at hrs_head
            simp [heq_b0, ← hrs_head]
      · rcases hrs_list : rightSpineTopDownNat (keyedState kops t) with _ | ⟨hd, tl⟩
        · simp [hrs_list] at hrs
        · simp only [hrs_list, List.tail_cons] at hrs
          exact List.mem_cons_of_mem hd hrs


  intro ℓ hℓ1 hℓL Xi hXi X subs p hp
  have hX_mem : X ∈ scaleBlocks S P (ℓ - 1) := by
    dsimp (config := { failIfUnchanged := false }) only [X]
    rw [List.getD_eq_getElem?_getD, List.getElem?_eq_getElem hXi]
    exact List.getElem_mem hXi
  have hX_bds := hpart.blocks_bounds (ℓ - 1) (by omega) X hX_mem
  have hX2_le_P : X.2 ≤ P := hX_bds.2.1
  obtain ⟨hKX, hsub0, hsub_last, hsub_bds, hsub_adj, hXi_iff, hfind_lt, hfind_eq_iff⟩ :=
    hpart.child_blocks ℓ hℓ1 hℓL Xi hXi
  change 2 ≤ subs.length at hKX
  change (subs.getD 0 (0, 0)).1 = X.1 at hsub0
  change (subs.getD (subs.length - 1) (0, 0)).2 = X.2 at hsub_last
  change ∀ c < subs.length,
    X.1 ≤ (subs.getD c (0, 0)).1 ∧ (subs.getD c (0, 0)).1 < (subs.getD c (0, 0)).2 ∧
    (subs.getD c (0, 0)).2 ≤ X.2 ∧ S ℓ ≤ (subs.getD c (0, 0)).2 - (subs.getD c (0, 0)).1 ∧
    (subs.getD c (0, 0)).2 - (subs.getD c (0, 0)).1 < 2 * S ℓ at hsub_bds
  change ∀ c, c + 1 < subs.length → (subs.getD c (0, 0)).2 = (subs.getD (c + 1) (0, 0)).1 at hsub_adj
  change ∀ u < P, blockIdx S P (ℓ - 1) u = Xi ↔ X.1 ≤ u ∧ u < X.2 at hXi_iff

  have hsub_part : PuqIsSubblockPart subs :=
    ⟨hKX, fun c hc => (hsub_bds c hc).2.1, hsub_adj⟩

  have hsub_mono : ∀ c1 c2, c1 < c2 → c2 < subs.length →
      (subs.getD c1 (0, 0)).2 ≤ (subs.getD c2 (0, 0)).1 := by
    intro c1 c2
    induction c2 with
    | zero => intro h; omega
    | succ c2 ih =>
      intro h12 hc2s
      rcases eq_or_lt_of_le (Nat.le_of_lt_succ h12) with rfl | hlt
      · exact le_of_eq (hsub_adj c1 hc2s)
      · have h1 := ih hlt (by omega)
        have h2 := (hsub_bds c2 (by omega)).2.1
        have h3 := hsub_adj c2 hc2s
        omega

  let idxSub : ℕ → ℕ := fun u => subs.findIdx (fun b => decide (b.1 ≤ u ∧ u < b.2))

  have h_idxSub_in_X : ∀ u, X.1 ≤ u → u < X.2 →
      idxSub u < subs.length ∧
      subs.getD (idxSub u) (0, 0) = blockOf S P ℓ u ∧
      (subs.getD (idxSub u) (0, 0)).1 ≤ u ∧ u < (subs.getD (idxSub u) (0, 0)).2 := by
    intro u hu1 hu2
    obtain ⟨hc_lt, hc_eq⟩ := hfind_lt u hu1 hu2
    change idxSub u < subs.length at hc_lt
    change subs.getD (idxSub u) (0, 0) = blockOf S P ℓ u at hc_eq
    have huP : u < P := by omega
    obtain ⟨_, hbo1, hbo2, _⟩ := hpart.blocks_partition ℓ hℓL u huP
    exact ⟨hc_lt, hc_eq, by rw [hc_eq]; exact hbo1, by rw [hc_eq]; exact hbo2⟩

  have h_idxSub_of_mem : ∀ c < subs.length, ∀ u,
      (subs.getD c (0, 0)).1 ≤ u → u < (subs.getD c (0, 0)).2 →
      idxSub u = c ∧ blockOf S P ℓ u = subs.getD c (0, 0) := by
    intro c hc u hu1 hu2
    have hcb := hsub_bds c hc
    have huX1 : X.1 ≤ u := by omega
    have huX2 : u < X.2 := by omega
    obtain ⟨hc'_lt, hc'_eq, hc'1, hc'2⟩ := h_idxSub_in_X u huX1 huX2
    have hce : idxSub u = c := by
      rcases lt_trichotomy (idxSub u) c with hlt | heq | hgt
      · have := hsub_mono (idxSub u) c hlt hc; omega
      · exact heq
      · have := hsub_mono c (idxSub u) hgt hc'_lt; omega
    exact ⟨hce, by rw [← hc'_eq, hce]⟩

  have h_sep_in_X : ∀ u1 u2, X.1 ≤ u1 → u1 < X.2 → X.1 ≤ u2 → u2 < X.2 →
      ℓ ≤ sepScale S P L u1 u2 ∧
      (sepScale S P L u1 u2 = ℓ ↔ idxSub u1 ≠ idxSub u2) := by
    intro u1 u2 hu1a hu1b hu2a hu2b
    have hu1P : u1 < P := by omega
    have hu2P : u2 < P := by omega
    have hb1 : blockIdx S P (ℓ - 1) u1 = Xi := (hXi_iff u1 hu1P).mpr ⟨hu1a, hu1b⟩
    have hb2 : blockIdx S P (ℓ - 1) u2 = Xi := (hXi_iff u2 hu2P).mpr ⟨hu2a, hu2b⟩
    have hgt_prev : ℓ - 1 < sepScale S P L u1 u2 :=
      (hpart.sep_gt_iff (ℓ - 1) (by omega) u1 hu1P u2 hu2P).mpr (hb1.trans hb2.symm)
    have hge : ℓ ≤ sepScale S P L u1 u2 := by omega
    have hgt_curr : ℓ < sepScale S P L u1 u2 ↔ idxSub u1 = idxSub u2 := by
      rw [hpart.sep_gt_iff ℓ hℓL u1 hu1P u2 hu2P]
      exact (hfind_eq_iff u1 hu1a hu1b u2 hu2a hu2b).symm
    refine ⟨hge, ⟨?_, ?_⟩⟩
    · intro heq hsame
      have := hgt_curr.mpr hsame; omega
    · intro hdiff
      have hnot : ¬ (ℓ < sepScale S P L u1 u2) := fun h => hdiff (hgt_curr.mp h)
      omega


  have hp_lt : p < subs.length := by omega
  have hp1_lt : p + 1 < subs.length := by omega
  let sp := subs.getD p (0, 0)
  let lo_b := (subs.getD (p + 1) (0, 0)).1
  let hi_b := (subs.getD (subs.length - 1) (0, 0)).2
  have hsp1_def : sp.1 = (subs.getD p (0, 0)).1 := rfl
  have hsp2_def : sp.2 = (subs.getD p (0, 0)).2 := rfl
  have hlob_def : lo_b = (subs.getD (p + 1) (0, 0)).1 := rfl
  have hhib_def : hi_b = (subs.getD (subs.length - 1) (0, 0)).2 := rfl
  have hsp_bds : X.1 ≤ sp.1 ∧ sp.1 < sp.2 ∧ sp.2 ≤ X.2 ∧ S ℓ ≤ sp.2 - sp.1 ∧ sp.2 - sp.1 < 2 * S ℓ :=
    hsub_bds p hp_lt
  have hlo_b_eq : lo_b = sp.2 := (hsub_adj p hp1_lt).symm
  have hhi_b_eq : hi_b = X.2 := hsub_last
  have hsp1_lt_sp2 : sp.1 < sp.2 := hsp_bds.2.1
  have hsp2_le_P : sp.2 ≤ P := by omega
  let ts := popStep kops sp.1
  let te := tEmpty kops sp.1 sp.2
  have hts_def : ts = popStep kops sp.1 := rfl
  have hte_eq_tEmpty : te = tEmpty kops sp.1 sp.2 := rfl


  have h_window : te ≤ kops.length ∧
      ∀ t, ts ≤ t → t < te →
        ∃ v0 ∈ inorderNat (keyedState kops t), sp.1 ≤ v0 ∧ v0 < sp.2 := by
    let tmax := popStep kops (sp.2 - 1) + 1
    have htmax_def : tmax = popStep kops (sp.2 - 1) + 1 := rfl
    have hsp1_P : sp.1 < P := by omega
    have hsp2m_P : sp.2 - 1 < P := by omega
    have htmax_le : tmax ≤ kops.length := by
      have := (hkvalid.birth_lt_pop (sp.2 - 1) hsp2m_P).2; omega
    let pred : ℕ → Bool := fun t =>
      (inorderNat (keyedState kops t)).all (fun v => decide (v < sp.1 ∨ sp.2 ≤ v))
    have hte_def : te = match (List.Ico ts (tmax + 1)).find? pred with
        | some t => t | none => tmax := rfl
    have h_false_to_v0 : ∀ t, ¬ (pred t = true) →
        ∃ v0 ∈ inorderNat (keyedState kops t), sp.1 ≤ v0 ∧ v0 < sp.2 := by
      intro t hnp
      by_contra hno
      apply hnp
      rw [List.all_eq_true]
      intro v hv
      rw [decide_eq_true_iff]
      by_contra hnv
      exact hno ⟨v, hv, by omega, by omega⟩
    rcases hfind : (List.Ico ts (tmax + 1)).find? pred with _ | t0
    · rw [hfind] at hte_def; dsimp (config := { failIfUnchanged := false }) only at hte_def
      refine ⟨by rw [hte_def]; exact htmax_le, ?_⟩
      intro t hts_t ht_te
      rw [hte_def] at ht_te
      have ht_mem : t ∈ List.Ico ts (tmax + 1) := List.Ico.mem.mpr ⟨hts_t, Nat.lt_succ_of_lt ht_te⟩
      exact h_false_to_v0 t (List.find?_eq_none.mp hfind t ht_mem)
    · rw [hfind] at hte_def; dsimp (config := { failIfUnchanged := false }) only at hte_def
      have ht0_mem := List.mem_of_find?_eq_some hfind
      rw [List.Ico.mem] at ht0_mem
      refine ⟨by omega, ?_⟩
      intro t hts_t ht_te
      have ht_mem : t ∈ List.Ico ts (tmax + 1) := List.Ico.mem.mpr ⟨hts_t, by omega⟩
      obtain ⟨_, as, bs, h_eq, has_false⟩ := List.find?_eq_some_iff_append.mp hfind
      have hpw := List.Ico.pairwise_lt ts (tmax + 1)
      rw [h_eq] at ht_mem hpw
      have hbs_gt : ∀ b ∈ bs, t0 < b :=
        (List.pairwise_cons.mp (List.pairwise_append.mp hpw).2.1).1
      rcases List.mem_append.mp ht_mem with h_in_as | h_in_tail
      · have h_neg := has_false t h_in_as
        exact h_false_to_v0 t (by simpa using h_neg)
      · rcases List.mem_cons.mp h_in_tail with rfl | h_in_bs
        · omega
        · have := hbs_gt t h_in_bs; omega

  have hte_le_len : te ≤ kops.length := h_window.1
  have h_alive := h_window.2

  have h_inord_head : ∀ t, ts ≤ t → t < te →
      inorderNat (keyedState kops t) ≠ [] ∧
      sp.1 ≤ (inorderNat (keyedState kops t)).headD 0 ∧
      (inorderNat (keyedState kops t)).headD 0 < sp.2 := by
    intro t hts_t ht_te
    have ht_le : t ≤ kops.length := by omega
    obtain ⟨v0, hv0_mem, hv0_1, hv0_2⟩ := h_alive t hts_t ht_te
    rcases hinord : inorderNat (keyedState kops t) with _ | ⟨m0, rest⟩
    · simp [hinord] at hv0_mem
    · refine ⟨by simp, ?_, ?_⟩
      · simp only [List.headD_cons]
        have hm0_mem : m0 ∈ inorderNat (keyedState kops t) := by simp [hinord]
        have hm0_ge := (hkvalid.popIdx_bound t ht_le m0 hm0_mem).1
        have hpop_ts : popIdx kops ts = sp.1 := hkvalid.popIdx_at_popStep sp.1 (by omega)
        have hpop_mono := hplug_pop_mono ts t hts_t
        omega
      · simp only [List.headD_cons]
        have hpw := hkvalid.inorder_strictMono t ht_le
        rw [hinord] at hpw hv0_mem
        rcases List.mem_cons.mp hv0_mem with rfl | hv0_rest
        · exact hv0_2
        · have := (List.pairwise_cons.mp hpw).1 v0 hv0_rest; omega


  have h_s4 : ∀ c, p + 1 ≤ c → c < subs.length →
      ∀ t1 t2, ts ≤ t1 → t1 < te → ts ≤ t2 → t2 < te →
      ∀ r_c, (subs.getD c (0, 0)).1 ≤ r_c → r_c < (subs.getD c (0, 0)).2 →
      r_c ∈ rightSpineTopDownNat (keyedState kops t1) →
      r_c ∉ rightSpineTopDownNat (keyedState kops t2) →
      puqIsClassC1 S P kops ℓ Xi p c = true ∨ puqIsClassC2 S P kops ℓ Xi p c = true := by
    intro c hpc hc_lt t1 t2 ht1_s ht1_e ht2_s ht2_e r_c hrc1 hrc2 hrc_in1 hrc_out2
    have hsp2_le_rc : sp.2 ≤ r_c :=
      le_trans (by rw [hsp2_def]; exact hsub_mono p c (by omega) hc_lt) hrc1
    rcases lt_trichotomy t1 t2 with h12 | rfl | h21
    · obtain ⟨trem, htrem1, htrem2, hin_rem, hout_rem1⟩ :=
        h_step_trans (fun t => r_c ∈ rightSpineTopDownNat (keyedState kops t))
          t1 t2 h12 hrc_in1 hrc_out2
      have htrem_len : trem < kops.length := by omega
      have hrs_step := hplug_rs trem htrem_len
      have hsv := hkvalid.step_valid trem htrem_len
      obtain ⟨v0, hv0_mem, hv0_1, hv0_2⟩ := h_alive trem (by omega) (by omega)
      rcases hop : kops[trem] with w | s | d
      · rw [hop] at hrs_step
        exact absurd (List.mem_cons_of_mem w hin_rem) (by simpa [hrs_step] using hout_rem1)
      · rw [hop] at hrs_step hsv
        obtain ⟨_, _, hs_pop, hne_rem, hls_head⟩ := hsv
        have hs_le_v0 := (hkvalid.popIdx_bound trem (by omega) v0 hv0_mem).1
        rcases hrs_step with ⟨hls_len1, hrs_tail⟩ | ⟨_, hrs_eq⟩ | ⟨_, hrs_cons⟩
        · rw [hrs_tail] at hout_rem1
          rcases hrs_eq0 : rightSpineTopDownNat (keyedState kops trem) with _ | ⟨r0, rtl⟩
          · simp [hrs_eq0] at hin_rem
          · simp only [hrs_eq0, List.tail_cons] at hout_rem1
            rcases List.mem_cons.mp (by simpa [hrs_eq0] using hin_rem) with rfl | hmem_tl
            · rcases hfold.fold_cursor trem (by omega) with ⟨hemp, _⟩ | ⟨_, hrs_hd, hls_lst⟩
              · exact absurd hemp hne_rem
              · simp only [hrs_eq0, List.head?_cons, Option.some.injEq] at hrs_hd
                rcases hls_eq0 : leftSpineBottomUpNat (keyedState kops trem) with _ | ⟨l0, _ | _⟩
                · simp [hls_eq0] at hls_len1
                · simp only [hls_eq0, List.head?_cons, Option.some.injEq] at hls_head
                  simp only [hls_eq0, List.getLast?_singleton, Option.some.injEq] at hls_lst
                  omega
                · simp [hls_eq0] at hls_len1
            · exact absurd hmem_tl hout_rem1
        · rw [hrs_eq] at hout_rem1; exact absurd hin_rem hout_rem1
        · rw [hrs_cons] at hout_rem1
          exact absurd (List.mem_cons_of_mem _ hin_rem) hout_rem1
      · rw [hop] at hrs_step
        obtain ⟨hd_len, hrs_erase⟩ := hrs_step
        rw [hrs_erase] at hout_rem1
        have hd_lt : d < (rightSpineTopDownNat (keyedState kops trem)).length := by omega
        have hgetD_eq := h_eraseIdx_getD _ d r_c hd_lt hin_rem hout_rem1
        obtain ⟨hinord_ne, hm0_1, hm0_2⟩ := h_inord_head trem (by omega) (by omega)
        have htrem_mem : trem ∈ List.Ico ts te := List.Ico.mem.mpr ⟨by omega, by omega⟩
        have hv1 : (subs.getD c (0, 0)).1 ≤ (rightSpineTopDownNat (keyedState kops trem)).getD d 0 := by
          rw [hgetD_eq]; exact hrc1
        have hv2 : (rightSpineTopDownNat (keyedState kops trem)).getD d 0 < (subs.getD c (0, 0)).2 := by
          rw [hgetD_eq]; exact hrc2
        refine Or.inl ?_
        unfold puqIsClassC1
        rw [List.any_eq_true]
        refine ⟨trem, htrem_mem, ?_⟩
        have hop? : kops[trem]? = some (.rslr d) := by rw [List.getElem?_eq_getElem htrem_len, hop]
        rw [hop?]
        simp only [decide_eq_true_iff]
        exact ⟨hd_lt, hinord_ne, hm0_1, hm0_2, hv1, hv2⟩
    · exact absurd hrc_in1 hrc_out2
    · obtain ⟨tadd, htadd1, htadd2, hout_add, hin_add1⟩ :=
        h_step_trans_rev (fun t => r_c ∈ rightSpineTopDownNat (keyedState kops t))
          t2 t1 h21 hrc_out2 hrc_in1
      have htadd_len : tadd < kops.length := by omega
      have hrs_step := hplug_rs tadd htadd_len
      have hsv := hkvalid.step_valid tadd htadd_len
      obtain ⟨v0, hv0_mem, hv0_1, hv0_2⟩ := h_alive tadd (by omega) (by omega)
      rcases hop : kops[tadd] with w | spop | d
      · rw [hop] at hrs_step hsv
        rw [hrs_step] at hin_add1
        rcases List.mem_cons.mp hin_add1 with rfl | hmem_rs
        · have hw_lt_v0 := h_forall_inord (fun k => r_c < k) _ hsv.2.2 v0 hv0_mem
          omega
        · exact absurd hmem_rs hout_add
      · rw [hop] at hrs_step hsv
        obtain ⟨_, hspop_step, hspop_idx, _, _⟩ := hsv
        rcases hrs_step with ⟨_, hrs_tail⟩ | ⟨_, hrs_eq⟩ | ⟨hls_odd, hrs_cons⟩
        · rw [hrs_tail] at hin_add1
          rcases hrs_eq0 : rightSpineTopDownNat (keyedState kops tadd) with _ | ⟨r0, rtl⟩
          · simp [hrs_eq0] at hin_add1
          · simp only [hrs_eq0, List.tail_cons] at hin_add1
            exact absurd (List.mem_cons_of_mem r0 hin_add1) (by simpa [hrs_eq0] using hout_add)
        · rw [hrs_eq] at hin_add1; exact absurd hin_add1 hout_add
        · rw [hrs_cons] at hin_add1
          rcases List.mem_cons.mp hin_add1 with hv_eq | hmem_rs
          · have hspop_ge : sp.1 ≤ spop := by
              have hpop_ts : popIdx kops ts = sp.1 := hkvalid.popIdx_at_popStep sp.1 (by omega)
              have := hplug_pop_mono ts tadd (by omega)
              omega
            have hspop_lt : spop < sp.2 := by
              have := (hkvalid.popIdx_bound tadd (by omega) v0 hv0_mem).1
              omega
            have hspop_mem : spop ∈ List.Ico sp.1 sp.2 := List.Ico.mem.mpr ⟨hspop_ge, hspop_lt⟩
            have hv1 : (subs.getD c (0, 0)).1 ≤
                (leftSpineBottomUpNat (keyedState kops tadd)).getD
                  (2 * (((leftSpineBottomUpNat (keyedState kops tadd)).length - 2) / 2) + 1) 0 := by
              rw [← hv_eq]; exact hrc1
            have hv2 : (leftSpineBottomUpNat (keyedState kops tadd)).getD
                  (2 * (((leftSpineBottomUpNat (keyedState kops tadd)).length - 2) / 2) + 1) 0 <
                (subs.getD c (0, 0)).2 := by
              rw [← hv_eq]; exact hrc2
            refine Or.inr ?_
            unfold puqIsClassC2
            rw [List.any_eq_true]
            refine ⟨spop, hspop_mem, ?_⟩
            dsimp (config := { failIfUnchanged := false }) only
            rw [hspop_step]
            simp only [decide_eq_true_iff]
            exact ⟨hls_odd, hv1, hv2⟩
          · exact absurd hmem_rs hout_add
      · rw [hop] at hrs_step
        rw [hrs_step.2] at hin_add1
        exact absurd (h_eraseIdx_mem _ d r_c hin_add1) hout_add


  let T : ℕ → _root_.BinaryTree ℕ := fun t => puqPreEmbeddedState P kops t
  let G : ℕ → _root_.BinaryTree ℕ := fun t => puqBlockQuotient subs (p + 1) subs.length (T t)
  let pi0 := leftSpineBottomUpNat ((puqConcretePkg S P L kops ℓ Xi).G_init p)
  have hpi0_eq : pi0 = leftSpineBottomUpNat (G ts) := rfl

  have hG_valid : ∀ t, ts ≤ t → t < te →
      _root_.BinaryTree.IsBST (G t) ∧ inorderNat (G t) = List.Ico (p + 1) subs.length := by
    intro t hts_t ht_te
    have ht_le : t ≤ kops.length := by omega
    obtain ⟨_, hT_bst, hT_inord⟩ := hplug_bst t ht_le
    obtain ⟨v0, hv0_mem, _, hv0_2⟩ := h_alive t hts_t ht_te
    have hpop_le : popIdx kops t ≤ lo_b := by
      have := (hkvalid.popIdx_bound t ht_le v0 hv0_mem).1; omega
    exact ⟨hbq_bst subs hsub_part (p + 1) subs.length (by omega) le_rfl (T t) hT_bst,
      hbq_inord subs hsub_part (p + 1) subs.length hp1_lt le_rfl (T t) (popIdx kops t) P
        hT_bst hT_inord hpop_le (by omega)⟩

  have hG_step_sub : ∀ t, ts ≤ t → t < te →
      ∀ c ∈ leftSpineBottomUpNat (G (t + 1)), c ∈ leftSpineBottomUpNat (G t) := by
    intro t hts_t ht_te
    have ht_lt : t < kops.length := by omega
    obtain ⟨v0, hv0_mem, _, hv0_2⟩ := h_alive t hts_t ht_te
    obtain ⟨_, hT_bst, hT_inord⟩ := hplug_bst t (by omega)
    obtain ⟨hGt_bst, hGt_inord⟩ := hG_valid t hts_t ht_te
    have hsv := hkvalid.step_valid t ht_lt
    rcases hop : kops[t] with w | s | d
    · rw [hop] at hsv
      have hw_lt : w < lo_b := by
        have := h_forall_inord (fun k => w < k) _ hsv.2.2 v0 hv0_mem; omega
      obtain ⟨N, hN_eq⟩ := hplug_push t ht_lt w hop
      have h_iter : ∀ n : ℕ,
          _root_.BinaryTree.IsBST ((rotateRightOnLeftSpine w)^[n] (T t)) ∧
          inorderNat ((rotateRightOnLeftSpine w)^[n] (T t)) = List.Ico (popIdx kops t) P ∧
          puqBlockQuotient subs (p + 1) subs.length ((rotateRightOnLeftSpine w)^[n] (T t)) = G t := by
        intro n
        induction n with
        | zero => exact ⟨hT_bst, hT_inord, rfl⟩
        | succ n ih =>
          rw [Function.iterate_succ_apply']
          obtain ⟨hb_n, hi_n, hq_n⟩ := ih
          obtain ⟨hb_n1, hi_n1, _, _⟩ := hbq_rot_bst _ _ _ w hb_n hi_n
          have hq_eq := (hbq_rot subs hsub_part (p + 1) subs.length hp1_lt le_rfl _ w hb_n).1 (Or.inl hw_lt)
          exact ⟨hb_n1, hi_n1, hq_eq.trans hq_n⟩
      have hG_eq : G (t + 1) = G t := by
        change puqBlockQuotient subs (p + 1) subs.length (puqPreEmbeddedState P kops (t + 1)) = G t
        rw [hN_eq]; exact (h_iter N).2.2
      rw [hG_eq]; exact fun _ h => h
    · rw [hop] at hsv
      obtain ⟨hs_P, _, hs_idx, _, _⟩ := hsv
      have hs_lt_lob : s < lo_b := by
        have := (hkvalid.popIdx_bound t (by omega) v0 hv0_mem).1; omega
      have hhead_s : (inorderNat (T t)).head? = some s := by
        rw [hT_inord, ← hs_idx]
        have hs_mem : s ∈ List.Ico s P := List.Ico.mem.mpr ⟨le_rfl, hs_P⟩
        have hpw_ico := List.Ico.pairwise_lt s P
        rcases hico : List.Ico s P with _ | ⟨a, rest⟩
        · simp [hico] at hs_mem
        · rw [hico] at hs_mem hpw_ico
          rcases List.mem_cons.mp hs_mem with rfl | hs_rest
          · rfl
          · have ha_ge : s ≤ a := (List.Ico.mem.mp (by simp [hico] : a ∈ List.Ico s P)).1
            have ha_lt := (List.pairwise_cons.mp hpw_ico).1 s hs_rest
            omega
      have hQ0_eq : puqBlockQuotient subs (p + 1) subs.length (spliceMinNat (T t)) = G t :=
        hbq_splice subs hsub_part (p + 1) subs.length hp1_lt le_rfl (T t) s hT_bst hhead_s hs_lt_lob
      obtain ⟨_, _, hsp_bst, hT1_eq, hTj_props⟩ := hplug_pop t ht_lt s hop
      let js := popJumpsAt 0 t s (leftSpineBottomUpNat (keyedState kops t))
      let Tj : ℕ → _root_.BinaryTree ℕ := fun j =>
        (js.take j).foldl (fun B e => rotateRightOnLeftSpine e.x B) (spliceMinNat (T t))
      let Qj : ℕ → _root_.BinaryTree ℕ := fun j => puqBlockQuotient subs (p + 1) subs.length (Tj j)
      have hQj_inv : ∀ j ≤ js.length,
          _root_.BinaryTree.IsBST (Qj j) ∧
          inorderNat (Qj j) = List.Ico (p + 1) subs.length ∧
          (∀ c ∈ leftSpineBottomUpNat (Qj j), c ∈ leftSpineBottomUpNat (G t)) := by
        intro j
        induction j with
        | zero =>
          intro _
          have h0 : Qj 0 = G t := by simp only [Qj, Tj, List.take_zero, List.foldl_nil]; exact hQ0_eq
          rw [h0]; exact ⟨hGt_bst, hGt_inord, fun _ h => h⟩
        | succ j ih =>
          intro hj_le
          have hj_lt : j < js.length := by omega
          obtain ⟨hq_bst, hq_inord, hq_sub⟩ := ih (by omega)
          have hTj_bst : _root_.BinaryTree.IsBST (Tj j) := (hTj_props j hj_lt).1
          have hTj_succ : Tj (j + 1) = rotateRightOnLeftSpine (js[j]'hj_lt).x (Tj j) := by
            simp only [Tj, List.take_succ_eq_append_getElem hj_lt, List.foldl_append, List.foldl_cons, List.foldl_nil]
          have hQj_succ : Qj (j + 1) = puqBlockQuotient subs (p + 1) subs.length
              (rotateRightOnLeftSpine (js[j]'hj_lt).x (Tj j)) := by simp only [Qj, hTj_succ]
          rcases (hbq_rot subs hsub_part (p + 1) subs.length hp1_lt le_rfl (Tj j) (js[j]'hj_lt).x hTj_bst).2 with hsame | hrot
          · rw [hQj_succ, hsame]; exact ⟨hq_bst, hq_inord, hq_sub⟩
          · rw [hQj_succ, hrot]
            obtain ⟨hr_bst, hr_inord, hr_ls, _⟩ := hbq_rot_bst (Qj j) (p + 1) subs.length _ hq_bst hq_inord
            exact ⟨hr_bst, hr_inord, fun c hc => hq_sub c (hr_ls c hc)⟩
      have hG1_eq : G (t + 1) = Qj js.length := by
        change puqBlockQuotient subs (p + 1) subs.length (puqPreEmbeddedState P kops (t + 1)) = _
        rw [hT1_eq]; simp only [Qj, Tj, List.take_length]; rfl
      rw [hG1_eq]
      exact (hQj_inv js.length le_rfl).2.2
    · rcases d with _ | d
      · have hT1_eq := hplug_rslr0 t ht_lt hop
        have hG1_eq : G (t + 1) = G t := by
          change puqBlockQuotient subs (p + 1) subs.length (puqPreEmbeddedState P kops (t + 1)) = G t
          rw [hT1_eq]
        rw [hG1_eq]; exact fun _ h => h
      · obtain ⟨_, hT1_eq, _⟩ := hplug_rslr_succ t ht_lt d hop
        have hG1_eq : G (t + 1) = puqBlockQuotient subs (p + 1) subs.length
            (rotateRightOnLeftSpine ((rightSpineTopDownNat (keyedState kops t)).getD d 0) (T t)) := by
          change puqBlockQuotient subs (p + 1) subs.length (puqPreEmbeddedState P kops (t + 1)) = _
          rw [hT1_eq]
        rcases (hbq_rot subs hsub_part (p + 1) subs.length hp1_lt le_rfl (T t) _ hT_bst).2 with hsame | hrot
        · rw [hG1_eq, hsame]; exact fun _ h => h
        · rw [hG1_eq, hrot]
          exact (hbq_rot_bst (G t) (p + 1) subs.length _ hGt_bst hGt_inord).2.2.1

  have hG_ls_le_pi0 : ∀ t, ts ≤ t → t < te →
      ∀ c ∈ leftSpineBottomUpNat (G t), c ∈ pi0 := by
    intro t
    induction t with
    | zero =>
      intro hts_0 _ c hc
      have hts_eq : ts = 0 := by omega
      rw [hpi0_eq, hts_eq]; exact hc
    | succ t ih =>
      intro hts_t1 ht1_te c hc
      rcases eq_or_lt_of_le hts_t1 with h_eq | h_lt
      · rw [hpi0_eq, h_eq]; exact hc
      · exact ih (by omega) (by omega) c (hG_step_sub t (by omega) (by omega) c hc)


  have h_vact_anat : ∀ id ∈ VActSet S P L kops ℓ Xi p,
      ∃ (hid : id < (jumps kops).length),
        let e := (jumps kops)[id]'hid
        let cx := idxSub e.x
        let cy := idxSub e.y
        ts ≤ e.step ∧ e.step < te ∧
        X.1 ≤ e.x ∧ lo_b ≤ e.x ∧ e.x < e.y ∧ e.y < X.2 ∧
        p + 1 ≤ cx ∧ cx < cy ∧ cy < subs.length ∧
        (subs.getD cx (0, 0)).1 ≤ e.x ∧ e.x < (subs.getD cx (0, 0)).2 ∧
        (subs.getD cx (0, 0)).2 < e.z ∧
        cx ∈ pi0 := by
    intro id hid_mem
    obtain ⟨hb3_mem, hvact_true⟩ := Finset.mem_filter.mp hid_mem
    obtain ⟨hid_range, hb3_true⟩ := Finset.mem_filter.mp hb3_mem
    have hid : id < (jumps kops).length := Finset.mem_range.mp hid_range
    refine ⟨hid, ?_⟩
    let e := (jumps kops)[id]'hid
    have he? : (jumps kops)[id]? = some e := List.getElem?_eq_getElem hid
    obtain ⟨_, he_step_len, he_op?, _, hes_lt_x, hex_lt_y, hey_lt_z, hez_lt_P, ⟨_, _, hex_ls?, _, _⟩, _⟩ :=
      hjump.jump_anatomies id hid
    change e.step < kops.length at he_step_len
    change kops[e.step]? = some (.pop e.s) at he_op?
    change e.s < e.x at hes_lt_x
    change e.x < e.y at hex_lt_y
    change e.y < e.z at hey_lt_z
    change e.z < P at hez_lt_P
    change (leftSpineBottomUpNat (keyedState kops e.step))[2 * e.j + 1]? = some e.x at hex_ls?
    have he_op : kops[e.step] = .pop e.s := by
      rw [List.getElem?_eq_getElem he_step_len] at he_op?; injection he_op?
    have hsv_e := hkvalid.step_valid e.step he_step_len
    rw [he_op] at hsv_e
    have hes_popStep : popStep kops e.s = e.step := hsv_e.2.1
    unfold isVAct at hvact_true
    dsimp (config := { failIfUnchanged := false }) only at hvact_true
    rw [he?] at hvact_true
    simp only [decide_eq_true_iff] at hvact_true
    obtain ⟨hsep_xy, hbidx_x, hes1, hes2⟩ := hvact_true
    change sp.1 ≤ e.s at hes1
    change e.s < sp.2 at hes2
    unfold isB3Act at hb3_true
    rw [he?] at hb3_true
    simp only [hsep_xy, decide_eq_true_iff] at hb3_true
    obtain ⟨_, _, hsep_sx, hez_ge_by, hestep_lt_bs⟩ := hb3_true
    have hbs_eq : blockOf S P ℓ e.s = sp := (h_idxSub_of_mem p hp_lt e.s hes1 hes2).2
    rw [hbs_eq] at hestep_lt_bs
    change e.step < te at hestep_lt_bs
    have hts_le_estep : ts ≤ e.step := by
      rcases eq_or_lt_of_le hes1 with h_eq | h_lt
      · dsimp (config := { failIfUnchanged := false }) only [ts]; rw [h_eq, hes_popStep]
      · have := hkvalid.popStep_mono sp.1 e.s h_lt (by omega); omega
    have hx_in_X : X.1 ≤ e.x ∧ e.x < X.2 := (hXi_iff e.x (by omega)).mp hbidx_x
    have hbidx_xy : blockIdx S P (ℓ - 1) e.x = blockIdx S P (ℓ - 1) e.y :=
      (hpart.sep_gt_iff (ℓ - 1) (by omega) e.x (by omega) e.y (by omega)).mp (by omega)
    have hy_in_X : X.1 ≤ e.y ∧ e.y < X.2 :=
      (hXi_iff e.y (by omega)).mp (hbidx_xy.symm.trans hbidx_x)
    obtain ⟨hcx_lt, _, hcx1, hcx2⟩ := h_idxSub_in_X e.x hx_in_X.1 hx_in_X.2
    obtain ⟨hcy_lt, hcy_bo, hcy1, hcy2⟩ := h_idxSub_in_X e.y hy_in_X.1 hy_in_X.2
    have h_p_ne_cx : idxSub e.s ≠ idxSub e.x :=
      (h_sep_in_X e.s e.x (by omega) (by omega) hx_in_X.1 hx_in_X.2).2.mp hsep_sx
    have h_es_idx : idxSub e.s = p := (h_idxSub_of_mem p hp_lt e.s hes1 hes2).1
    have hp1_le_cx : p + 1 ≤ idxSub e.x := by
      by_contra hlt
      have hle : idxSub e.x ≤ p := by omega
      rcases eq_or_lt_of_le hle with heq | hlt'
      · exact h_p_ne_cx (h_es_idx.trans heq.symm)
      · have := hsub_mono (idxSub e.x) p hlt' hp_lt; omega
    have hlob_le_ex : lo_b ≤ e.x :=
      le_trans (by rw [hlo_b_eq, hsp2_def]; exact hsub_mono p (idxSub e.x) (by omega) hcx_lt) hcx1
    have hcx_ne_cy : idxSub e.x ≠ idxSub e.y :=
      (h_sep_in_X e.x e.y hx_in_X.1 hx_in_X.2 hy_in_X.1 hy_in_X.2).2.mp hsep_xy
    have hcx_lt_cy : idxSub e.x < idxSub e.y := by
      rcases lt_trichotomy (idxSub e.x) (idxSub e.y) with hlt | heq | hgt
      · exact hlt
      · exact absurd heq hcx_ne_cy
      · have := hsub_mono (idxSub e.y) (idxSub e.x) hgt hcx_lt; omega
    have hcx2_lt_ez : (subs.getD (idxSub e.x) (0, 0)).2 < e.z := by
      have h1 := hsub_mono (idxSub e.x) (idxSub e.y) hcx_lt_cy hcy_lt
      rw [← hcy_bo] at hez_ge_by
      omega

    have hex_mem_ls : e.x ∈ leftSpineBottomUpNat (keyedState kops e.step) := by
      rcases lt_or_ge (2 * e.j + 1) (leftSpineBottomUpNat (keyedState kops e.step)).length with hlen_lt | hge
      · rw [List.getElem?_eq_getElem hlen_lt] at hex_ls?
        injection hex_ls? with h_eq
        rw [← h_eq]; exact List.getElem_mem hlen_lt
      · rw [List.getElem?_eq_none hge] at hex_ls?; cases hex_ls?
    have hex_mem_T : e.x ∈ leftSpineBottomUpNat (T e.step) := by
      rw [(hplug_pop e.step he_step_len e.s he_op).2.1, hfold.fold_leftSpine e.step (by omega)]
      exact List.mem_append_left _ hex_mem_ls
    have hTe_bst : _root_.BinaryTree.IsBST (T e.step) := (hplug_bst e.step (by omega)).2.1
    have hex_mem_T' : e.x ∈ leftSpineBottomUpNat (restrictRangeNat lo_b hi_b (T e.step)) :=
      (hbq_rest_ls lo_b hi_b (T e.step) hTe_bst e.x hex_mem_T hlob_le_ex e.x le_rfl
        (by rw [hhi_b_eq]; exact hx_in_X.2)).mpr hex_mem_T
    have hcx_mem_Ge : idxSub e.x ∈ leftSpineBottomUpNat (G e.step) :=
      (hbq_ls_iff subs hsub_part (p + 1) subs.length hp1_lt le_rfl (T e.step) hTe_bst (idxSub e.x)).mpr
        ⟨hp1_le_cx, hcx_lt, e.x, hex_mem_T', hcx1, hcx2⟩
    have hcx_pi0 : idxSub e.x ∈ pi0 := hG_ls_le_pi0 e.step hts_le_estep hestep_lt_bs (idxSub e.x) hcx_mem_Ge
    exact ⟨hts_le_estep, hestep_lt_bs, hx_in_X.1, hlob_le_ex, hex_lt_y, hy_in_X.2,
      hp1_le_cx, hcx_lt_cy, hcy_lt, hcx1, hcx2, hcx2_lt_ez, hcx_pi0⟩

  have h_pi0_props : List.Pairwise (· < ·) pi0 ∧
      (∀ c ∈ pi0, p + 1 ≤ c ∧ c < subs.length) ∧
      (∀ c' ∈ MMovSet S P L kops ℓ Xi p, c' ∈ pi0) := by
    have hts_lt_te : ts < te := by
      by_contra hge
      have hsp1_mem : sp.1 ∈ inorderNat (keyedState kops ts) := by
        have hb := hkvalid.birth_lt_pop sp.1 (by omega)
        exact (hkvalid.mem_inorder_iff ts (by omega) sp.1).mpr ⟨by omega, hb.1, le_rfl⟩
      let tmax := popStep kops (sp.2 - 1) + 1
      have htmax_def : tmax = popStep kops (sp.2 - 1) + 1 := rfl
      let pred : ℕ → Bool := fun t =>
        (inorderNat (keyedState kops t)).all (fun v => decide (v < sp.1 ∨ sp.2 ≤ v))
      have hsp2m_P : sp.2 - 1 < P := by omega
      have hts_lt_tmax : ts < tmax := by
        rcases eq_or_lt_of_le (show sp.1 ≤ sp.2 - 1 by omega) with heq | hlt
        · dsimp (config := { failIfUnchanged := false }) only [ts, tmax]; rw [heq]; omega
        · have := hkvalid.popStep_mono sp.1 (sp.2 - 1) hlt hsp2m_P; omega
      have hte_def : te = match (List.Ico ts (tmax + 1)).find? pred with
          | some t => t | none => tmax := rfl
      rcases hfind : (List.Ico ts (tmax + 1)).find? pred with _ | t0
      · rw [hfind] at hte_def; dsimp (config := { failIfUnchanged := false }) only at hte_def
        rw [hte_def] at hge; exact hge hts_lt_tmax
      · rw [hfind] at hte_def; dsimp (config := { failIfUnchanged := false }) only at hte_def
        have ht0_ge : ts ≤ t0 := (List.Ico.mem.mp (List.mem_of_find?_eq_some hfind)).1
        have ht0_eq : t0 = ts := by omega
        have hp_true := List.find?_some hfind
        rw [ht0_eq, List.all_eq_true] at hp_true
        have hv := hp_true sp.1 hsp1_mem
        rw [decide_eq_true_iff] at hv; omega
    obtain ⟨hGts_bst, hGts_inord⟩ := hG_valid ts le_rfl hts_lt_te
    obtain ⟨hpw_pi0, hmem_pi0⟩ := hbq_ls_pw (G ts) hGts_bst
    rw [← hpi0_eq] at hpw_pi0 hmem_pi0
    refine ⟨hpw_pi0, ?_, ?_⟩
    · intro c hc
      have hci := hmem_pi0 c hc
      rw [hGts_inord, List.Ico.mem] at hci
      exact hci
    · intro c' hc'
      obtain ⟨id, hid_vact, rfl⟩ := Finset.mem_image.mp hc'
      obtain ⟨hid, _, _, _, _, _, _, _, _, _, _, _, _, hcx_pi0⟩ := h_vact_anat id hid_vact
      rw [List.getElem?_eq_getElem hid]
      exact hcx_pi0


  have h_vact_rs_excl : ∀ id ∈ VActSet S P L kops ℓ Xi p,
      ∀ (hid : id < (jumps kops).length),
      let e := (jumps kops)[id]'hid
      ∀ c < idxSub e.x, c < subs.length →
      ∀ r_c, (subs.getD c (0, 0)).1 ≤ r_c → r_c < (subs.getD c (0, 0)).2 →
      r_c ∉ rightSpineTopDownNat (keyedState kops e.step) := by
    intro id hid_vact hid e c hc_lt_cx hc_lt r_c hrc1 hrc2 hrc_rs
    obtain ⟨hid', _, _, _, _, hex_lt_y, _, _, hcx_lt_cy, hcy_lt, hcx1, _, _, _⟩ := h_vact_anat id hid_vact
    change e.x < e.y at hex_lt_y
    change idxSub e.x < idxSub e.y at hcx_lt_cy
    change idxSub e.y < subs.length at hcy_lt
    change (subs.getD (idxSub e.x) (0, 0)).1 ≤ e.x at hcx1
    obtain ⟨_, he_step_len, he_op?, _, _, _, _, _, ⟨_, _, _, hey_ls?, _⟩, _⟩ :=
      hjump.jump_anatomies id hid
    change e.step < kops.length at he_step_len
    change kops[e.step]? = some (.pop e.s) at he_op?
    change (leftSpineBottomUpNat (keyedState kops e.step))[2 * e.j + 2]? = some e.y at hey_ls?
    have he_op : kops[e.step] = .pop e.s := by
      rw [List.getElem?_eq_getElem he_step_len] at he_op?; injection he_op?
    have hsv_e := hkvalid.step_valid e.step he_step_len
    rw [he_op] at hsv_e
    have hne_e : keyedState kops e.step ≠ .nil := hsv_e.2.2.2.1
    have hey_le_b0 : e.y ≤ (foldBST P (keyedState kops e.step)).2 := by
      rcases lt_or_ge (2 * e.j + 2) (leftSpineBottomUpNat (keyedState kops e.step)).length with hlen_lt | hge
      · rw [List.getElem?_eq_getElem hlen_lt] at hey_ls?
        injection hey_ls? with h_eq
        obtain ⟨hls_ne, hls_last⟩ := h_ls_last e.step (by omega) hne_e
        have hlast_idx : (leftSpineBottomUpNat (keyedState kops e.step)).length - 1 <
            (leftSpineBottomUpNat (keyedState kops e.step)).length := by
          have := List.length_pos_iff_ne_nil.mpr hls_ne; omega
        rw [List.getElem?_eq_getElem hlast_idx] at hls_last
        injection hls_last with hb0_eq
        have hpw_e := h_ls_pw e.step (by omega)
        rcases eq_or_lt_of_le (Nat.le_sub_one_of_lt hlen_lt) with heq_i | hlt_i
        · simp only [← h_eq, heq_i, hb0_eq, le_rfl]
        · have := List.pairwise_iff_getElem.mp hpw_e (2 * e.j + 2) _ hlen_lt hlast_idx hlt_i
          omega
      · rw [List.getElem?_eq_none hge] at hey_ls?; cases hey_ls?
    have hb0_le_rc : (foldBST P (keyedState kops e.step)).2 ≤ r_c :=
      (h_rs_ge_b0 e.step (by omega) hne_e).1 r_c hrc_rs
    have hsc2_le_cx1 := hsub_mono c (idxSub e.x) hc_lt_cx (by omega)
    omega


  let V_of : ℕ → Finset ℕ := fun cm =>
    (VActSet S P L kops ℓ Xi p).filter (fun id =>
      (match (jumps kops)[id]? with
       | none => false
       | some e => decide (idxSub e.x = cm)) = true)

  have h_Vm_ne : ∀ cm ∈ MMovSet S P L kops ℓ Xi p, (V_of cm).Nonempty := by
    intro cm hcm
    obtain ⟨id, hid_vact, rfl⟩ := Finset.mem_image.mp hcm
    obtain ⟨hid, _⟩ := h_vact_anat id hid_vact
    refine ⟨id, Finset.mem_filter.mpr ⟨hid_vact, ?_⟩⟩
    dsimp (config := { failIfUnchanged := false }) only
    rw [List.getElem?_eq_getElem hid]; dsimp (config := { failIfUnchanged := false }) only
    rw [decide_eq_true_iff]

  have h_s2_evict : ∀ (ca : ℕ) (hca_mov : ca ∈ MMovSet S P L kops ℓ Xi p),
      let ida := (V_of ca).min' (h_Vm_ne ca hca_mov)
      ∀ c ∈ pi0, ca < c →
      (∀ c', ca < c' → c' ≤ c → c' ∉ MMovSet S P L kops ℓ Xi p) →
      puqIsClassA S P kops ℓ Xi p c = true ∨
      puqIsClassB4Omega S P L kops ℓ Xi p c = true ∨
      ∃ (hida : ida < (jumps kops).length),
        ∃ r_c ∈ leftSpineBottomUpNat (foldBST P (keyedState kops ((jumps kops)[ida]'hida).step)).1,
          (subs.getD c (0, 0)).1 ≤ r_c ∧ r_c < (subs.getD c (0, 0)).2 := by
    intro ca hca_mov ida
    clear h_s1 h_ls_pw h_ls_last h_rs_ge_b0 h_root_dichotomy h_s4 h_vact_rs_excl
      hG_valid hG_step_sub hG_ls_le_pi0 h_inord_head h_window
      h_step_trans_rev h_eraseIdx_mem h_eraseIdx_getD h_rs_sub_inord
      hfind_lt hfind_eq_iff hX_mem
    have hida_mem : ida ∈ V_of ca := Finset.min'_mem (V_of ca) (h_Vm_ne ca hca_mov)
    have hida_vact : ida ∈ VActSet S P L kops ℓ Xi p := (Finset.mem_filter.mp hida_mem).1
    have hida_filt := (Finset.mem_filter.mp hida_mem).2
    obtain ⟨hida, hts_ea, hea_te, hx1_eax, hlob_eax, heax_lt_y, heay_lt_X2, hp1_ca, _, _, hcax1, hcax2, _, _⟩ :=
      h_vact_anat ida hida_vact
    let ea := (jumps kops)[ida]'hida
    change ts ≤ ea.step at hts_ea
    change ea.step < te at hea_te
    change X.1 ≤ ea.x at hx1_eax
    change lo_b ≤ ea.x at hlob_eax
    change ea.x < ea.y at heax_lt_y
    change ea.y < X.2 at heay_lt_X2
    have hca_eq : idxSub ea.x = ca := by
      rw [List.getElem?_eq_getElem hida] at hida_filt
      dsimp (config := { failIfUnchanged := false }) only at hida_filt
      exact of_decide_eq_true hida_filt
    change p + 1 ≤ idxSub ea.x at hp1_ca
    change (subs.getD (idxSub ea.x) (0, 0)).1 ≤ ea.x at hcax1
    change ea.x < (subs.getD (idxSub ea.x) (0, 0)).2 at hcax2
    rw [hca_eq] at hp1_ca hcax1 hcax2
    obtain ⟨_, hea_len, hea_op?, _, _, _, _, _, ⟨_, _, heax_ls?, _, _⟩, _⟩ :=
      hjump.jump_anatomies ida hida
    change ea.step < kops.length at hea_len
    change kops[ea.step]? = some (.pop ea.s) at hea_op?
    change (leftSpineBottomUpNat (keyedState kops ea.step))[2 * ea.j + 1]? = some ea.x at heax_ls?
    have hea_op : kops[ea.step] = .pop ea.s := by
      rw [List.getElem?_eq_getElem hea_len] at hea_op?; injection hea_op?
    intro c hc_pi0 hca_lt_c hgap_free
    have hc_bds := h_pi0_props.2.1 c hc_pi0
    by_cases hc_in_G : c ∈ leftSpineBottomUpNat (G ea.step)
    ·
      refine Or.inr (Or.inr ⟨hida, ?_⟩)
      have hTea_bst : _root_.BinaryTree.IsBST (T ea.step) := (hplug_bst ea.step (by omega)).2.1
      obtain ⟨_, _, r_c, hrc_T', hrc1, hrc2⟩ :=
        (hbq_ls_iff subs hsub_part (p + 1) subs.length hp1_lt le_rfl (T ea.step) hTea_bst c).mp hc_in_G
      have heax_mem_ls : ea.x ∈ leftSpineBottomUpNat (keyedState kops ea.step) := by
        rcases lt_or_ge (2 * ea.j + 1) (leftSpineBottomUpNat (keyedState kops ea.step)).length with hlen_lt | hge
        · rw [List.getElem?_eq_getElem hlen_lt] at heax_ls?
          injection heax_ls? with h_eq; rw [← h_eq]; exact List.getElem_mem hlen_lt
        · rw [List.getElem?_eq_none hge] at heax_ls?; cases heax_ls?
      have heax_mem_T : ea.x ∈ leftSpineBottomUpNat (T ea.step) := by
        rw [(hplug_pop ea.step hea_len ea.s hea_op).2.1, hfold.fold_leftSpine ea.step (by omega)]
        exact List.mem_append_left _ heax_mem_ls
      have hca2_le_sc1 := hsub_mono ca c hca_lt_c hc_bds.2
      have hsc_bds := hsub_bds c hc_bds.2
      have hrc_T : r_c ∈ leftSpineBottomUpNat (T ea.step) :=
        (hbq_rest_ls lo_b hi_b (T ea.step) hTea_bst ea.x heax_mem_T hlob_eax r_c
          (by omega) (by rw [hhi_b_eq]; omega)).mp hrc_T'
      rw [(hplug_pop ea.step hea_len ea.s hea_op).2.1] at hrc_T
      exact ⟨r_c, hrc_T, hrc1, hrc2⟩
    ·
      have hc_in_Gts : c ∈ leftSpineBottomUpNat (G ts) := by rwa [← hpi0_eq]
      have hts_lt_ea : ts < ea.step := by
        rcases eq_or_lt_of_le hts_ea with h_eq | h_lt
        · rw [h_eq] at hc_in_Gts; exact absurd hc_in_Gts hc_in_G
        · exact h_lt
      obtain ⟨tev, hts_tev, htev_ea, hc_tev, hc_not_tev1⟩ :=
        h_step_trans (fun t => c ∈ leftSpineBottomUpNat (G t)) ts ea.step hts_lt_ea hc_in_Gts hc_in_G
      have htev_len : tev < kops.length := by omega
      obtain ⟨v0, hv0_mem, _, hv0_2⟩ := h_alive tev hts_tev (by omega)
      obtain ⟨_, hTtev_bst, hTtev_inord⟩ := hplug_bst tev (by omega)
      have hsv_ev := hkvalid.step_valid tev htev_len
      rcases hop_ev : kops[tev] with w | s | d
      ·
        rw [hop_ev] at hsv_ev
        have hw_lt : w < lo_b := by
          have := h_forall_inord (fun k => w < k) _ hsv_ev.2.2 v0 hv0_mem; omega
        obtain ⟨N, hN_eq⟩ := hplug_push tev htev_len w hop_ev
        have h_iter : ∀ n : ℕ,
            _root_.BinaryTree.IsBST ((rotateRightOnLeftSpine w)^[n] (T tev)) ∧
            inorderNat ((rotateRightOnLeftSpine w)^[n] (T tev)) = List.Ico (popIdx kops tev) P ∧
            puqBlockQuotient subs (p + 1) subs.length ((rotateRightOnLeftSpine w)^[n] (T tev)) = G tev := by
          intro n
          induction n with
          | zero => exact ⟨hTtev_bst, hTtev_inord, rfl⟩
          | succ n ih =>
            rw [Function.iterate_succ_apply']
            obtain ⟨hb_n, hi_n, hq_n⟩ := ih
            obtain ⟨hb_n1, hi_n1, _, _⟩ := hbq_rot_bst _ _ _ w hb_n hi_n
            have hq_eq := (hbq_rot subs hsub_part (p + 1) subs.length hp1_lt le_rfl _ w hb_n).1 (Or.inl hw_lt)
            exact ⟨hb_n1, hi_n1, hq_eq.trans hq_n⟩
        have hG_eq : G (tev + 1) = G tev := by
          change puqBlockQuotient subs (p + 1) subs.length (puqPreEmbeddedState P kops (tev + 1)) = G tev
          rw [hN_eq]; exact (h_iter N).2.2
        rw [hG_eq] at hc_not_tev1
        exact absurd hc_tev hc_not_tev1
      ·
        rw [hop_ev] at hsv_ev
        obtain ⟨hs_P, _, hs_idx, _, _⟩ := hsv_ev
        have hs_ge_sp1 : sp.1 ≤ s := by
          have hpop_ts : popIdx kops ts = sp.1 := hkvalid.popIdx_at_popStep sp.1 (by omega)
          have := hplug_pop_mono ts tev hts_tev; omega
        have hs_lt_lob : s < lo_b := by
          have := (hkvalid.popIdx_bound tev (by omega) v0 hv0_mem).1; omega
        have hhead_s : (inorderNat (T tev)).head? = some s := by
          rw [hTtev_inord, ← hs_idx]
          have hs_mem : s ∈ List.Ico s P := List.Ico.mem.mpr ⟨le_rfl, hs_P⟩
          have hpw_ico := List.Ico.pairwise_lt s P
          rcases hico : List.Ico s P with _ | ⟨a, rest⟩
          · rw [hico] at hs_mem; cases hs_mem
          · have ha_mem_ico : a ∈ List.Ico s P := by rw [hico]; exact List.mem_cons_self
            rw [hico] at hs_mem hpw_ico
            rcases List.mem_cons.mp hs_mem with rfl | hs_rest
            · rfl
            · have ha_ge : s ≤ a := (List.Ico.mem.mp ha_mem_ico).1
              have ha_lt := (List.pairwise_cons.mp hpw_ico).1 s hs_rest
              omega
        have hQ0_eq : puqBlockQuotient subs (p + 1) subs.length (spliceMinNat (T tev)) = G tev :=
          hbq_splice subs hsub_part (p + 1) subs.length hp1_lt le_rfl (T tev) s hTtev_bst hhead_s hs_lt_lob
        obtain ⟨_, _, _, hT1_eq, hTj_props⟩ := hplug_pop tev htev_len s hop_ev
        let ls_ev := leftSpineBottomUpNat (keyedState kops tev)
        let js := popJumpsAt 0 tev s ls_ev
        let Tj : ℕ → _root_.BinaryTree ℕ := fun j =>
          (js.take j).foldl (fun B e => rotateRightOnLeftSpine e.x B) (spliceMinNat (T tev))
        let Qj : ℕ → _root_.BinaryTree ℕ := fun j => puqBlockQuotient subs (p + 1) subs.length (Tj j)
        have hc_Q0 : c ∈ leftSpineBottomUpNat (Qj 0) := by
          simp only [Qj, Tj, List.take_zero, List.foldl_nil, hQ0_eq]; exact hc_tev
        have hc_not_Qlen : c ∉ leftSpineBottomUpNat (Qj js.length) := by
          have hG1_eq : G (tev + 1) = Qj js.length := by
            change puqBlockQuotient subs (p + 1) subs.length (puqPreEmbeddedState P kops (tev + 1)) = _
            rw [hT1_eq]; simp only [Qj, Tj, List.take_length]; rfl
          rwa [← hG1_eq]
        have hjs_pos : 0 < js.length := by
          by_contra h0; have heq0 : js.length = 0 := by omega
          rw [heq0] at hc_not_Qlen; exact hc_not_Qlen hc_Q0
        obtain ⟨j, _, hj_lt, hc_Qj, hc_not_Qj1⟩ :=
          h_step_trans (fun k => c ∈ leftSpineBottomUpNat (Qj k)) 0 js.length hjs_pos hc_Q0 hc_not_Qlen
        obtain ⟨hTj_bst, hTj_ls⟩ := hTj_props j hj_lt
        have hQj1_eq : Qj (j + 1) = puqBlockQuotient subs (p + 1) subs.length
            (rotateRightOnLeftSpine (js[j]'hj_lt).x (Tj j)) := by
          simp only [Qj, Tj, List.take_succ_eq_append_getElem hj_lt, List.foldl_append, List.foldl_cons, List.foldl_nil]
        rw [hQj1_eq] at hc_not_Qj1
        obtain ⟨hlob_ux, hux_vy, hvy_hib, hcu_lt_c, hcv_eq_c⟩ :=
          hbq_evict subs hsub_part (p + 1) subs.length hp1_lt le_rfl (Tj j)
            (js[j]'hj_lt).x (js[j]'hj_lt).y c hTj_bst hTj_ls hc_Qj hc_not_Qj1
        rw [hsub_last] at hvy_hib
        have hjs_len : js.length = (ls_ev.length - 2) / 2 := by
          simp only [js, popJumpsAt, List.length_map, List.length_range]
        have hj_lt_m : j < (ls_ev.length - 2) / 2 := by omega
        obtain ⟨baseId, _, hbase_j⟩ := hplug_jumps tev htev_len s hop_ev
        obtain ⟨hjid, hej_step, hej_s, _, _, hej_x, hej_y, _⟩ := hbase_j j hj_lt_m
        let jid := baseId + j
        let ej := (jumps kops)[jid]'hjid
        change ej.step = tev at hej_step
        change ej.s = s at hej_s
        change ej.x = ls_ev.getD (2 * j + 1) 0 at hej_x
        change ej.y = ls_ev.getD (2 * j + 2) 0 at hej_y
        have hjsx : (js[j]'hj_lt).x = ej.x := by
          simp only [js, popJumpsAt, List.getElem_map, List.getElem_range]
          exact hej_x.symm
        have hjsy : (js[j]'hj_lt).y = ej.y := by
          simp only [js, popJumpsAt, List.getElem_map, List.getElem_range]
          exact hej_y.symm
        rw [hjsx] at hlob_ux hux_vy hcu_lt_c
        rw [hjsy] at hux_vy hvy_hib hcv_eq_c
        change idxSub ej.x < c at hcu_lt_c
        change idxSub ej.y = c at hcv_eq_c
        have hej_x_X1 : X.1 ≤ ej.x := by omega
        obtain ⟨hcx_lt, _, hcx1, hcx2⟩ := h_idxSub_in_X ej.x hej_x_X1 (by omega)
        obtain ⟨_, hcy_bo, hcy1, hcy2⟩ := h_idxSub_in_X ej.y (by omega) hvy_hib
        rw [hcv_eq_c] at hcy_bo hcy1 hcy2
        have hsep_xy : sepScale S P L ej.x ej.y = ℓ :=
          (h_sep_in_X ej.x ej.y hej_x_X1 (by omega) (by omega) hvy_hib).2.mpr (by omega)
        have hejs1 : sp.1 ≤ ej.s := by omega
        have hejs2 : ej.s < sp.2 := by omega
        have hidx_s : idxSub ej.s = p :=
          (h_idxSub_of_mem p hp_lt ej.s hejs1 hejs2).1
        have hp_lt_cx : p < idxSub ej.x := by
          by_contra hle
          rcases eq_or_lt_of_le (show idxSub ej.x ≤ p by omega) with heq | hlt
          · rw [heq] at hcx2; omega
          · have := hsub_mono (idxSub ej.x) p hlt hp_lt; omega
        have hsep_sx : sepScale S P L ej.s ej.x = ℓ :=
          (h_sep_in_X ej.s ej.x (by omega) (by omega) hej_x_X1 (by omega)).2.mpr (by omega)
        by_cases hez_lt : ej.z < (subs.getD c (0, 0)).2
        ·
          refine Or.inr (Or.inl ?_)
          have hez_lt_bo : ej.z < (blockOf S P ℓ ej.y).2 := by rw [← hcy_bo]; exact hez_lt
          have hjid_b3i : jid ∈ B_3_intra S P L kops := by
            refine Finset.mem_filter.mpr ⟨Finset.mem_range.mpr hjid, ?_⟩
            unfold isB3Intra
            rw [List.getElem?_eq_getElem hjid]; dsimp (config := { failIfUnchanged := false }) only
            rw [decide_eq_true_iff, show sepScale S P L ((jumps kops)[jid]'hjid).x ((jumps kops)[jid]'hjid).y = ℓ from hsep_xy]
            exact ⟨hℓ1, hℓL, hsep_sx, hez_lt_bo⟩
          unfold puqIsClassB4Omega; dsimp (config := { failIfUnchanged := false }) only
          rw [List.any_eq_true]
          refine ⟨jid, List.mem_range.mpr hjid, ?_⟩
          rw [Bool.and_eq_true, decide_eq_true_iff]
          refine ⟨Finset.mem_union_right _ hjid_b3i, ?_⟩
          rw [List.getElem?_eq_getElem hjid]; dsimp (config := { failIfUnchanged := false }) only
          rw [decide_eq_true_iff]
          exact ⟨hejs1, hejs2, Or.inr ⟨hcy1, hcy2⟩⟩
        ·
          have hez_ge : (subs.getD c (0, 0)).2 ≤ ej.z := by omega
          have hej_lt_te : ej.step < te := by omega
          have hjid_vact : jid ∈ VActSet S P L kops ℓ Xi p := by
            have hbs_eq : blockOf S P ℓ ej.s = sp :=
              (h_idxSub_of_mem p hp_lt ej.s hejs1 hejs2).2
            have hez_ge_bo : (blockOf S P ℓ ej.y).2 ≤ ej.z := by rw [← hcy_bo]; exact hez_ge
            have hej_lt_te' : ej.step < tEmpty kops (blockOf S P ℓ ej.s).1 (blockOf S P ℓ ej.s).2 := by
              rw [hbs_eq]; exact hej_lt_te
            have hjid_b3a : jid ∈ B_3_act S P L kops := by
              refine Finset.mem_filter.mpr ⟨Finset.mem_range.mpr hjid, ?_⟩
              unfold isB3Act
              rw [List.getElem?_eq_getElem hjid]; dsimp (config := { failIfUnchanged := false }) only
              rw [decide_eq_true_iff, show sepScale S P L ((jumps kops)[jid]'hjid).x ((jumps kops)[jid]'hjid).y = ℓ from hsep_xy]
              exact ⟨hℓ1, hℓL, hsep_sx, hez_ge_bo, hej_lt_te'⟩
            refine Finset.mem_filter.mpr ⟨hjid_b3a, ?_⟩
            unfold isVAct
            rw [List.getElem?_eq_getElem hjid]; dsimp (config := { failIfUnchanged := false }) only
            rw [decide_eq_true_iff]
            exact ⟨hsep_xy, (hXi_iff ej.x (by omega)).mpr ⟨hej_x_X1, by omega⟩, hejs1, hejs2⟩
          have hcx_mov : idxSub ej.x ∈ MMovSet S P L kops ℓ Xi p := by
            refine Finset.mem_image.mpr ⟨jid, hjid_vact, ?_⟩
            dsimp (config := { failIfUnchanged := false }) only
            rw [List.getElem?_eq_getElem hjid]
          rcases lt_trichotomy (idxSub ej.x) ca with hcx_lt_ca | hcx_eq_ca | hca_lt_cx
          ·
            have hsv_ea := hkvalid.step_valid ea.step hea_len
            rw [hea_op] at hsv_ea
            have hea_step_pop : popStep kops ea.s = ea.step := hsv_ea.2.1
            have heas_lt_ejx : ea.s < ej.x := by
              have h_v := (Finset.mem_filter.mp hida_vact).2
              unfold isVAct at h_v; dsimp (config := { failIfUnchanged := false }) only at h_v
              rw [List.getElem?_eq_getElem hida] at h_v
              simp only [decide_eq_true_iff] at h_v
              have heas_lt_sp2 : ea.s < sp.2 := h_v.2.2.2
              omega
            have hea_le_popx : ea.step ≤ popStep kops ej.x := by
              have := hkvalid.popStep_mono ea.s ej.x heas_lt_ejx (by omega); omega
            have heax_mem_fold : ea.x ∈ leftSpineBottomUpNat (foldBST P (keyedState kops ea.step)).1 := by
              rcases lt_or_ge (2 * ea.j + 1) (leftSpineBottomUpNat (keyedState kops ea.step)).length with hlen_lt | hge
              · rw [List.getElem?_eq_getElem hlen_lt] at heax_ls?
                injection heax_ls? with h_eq
                rw [hfold.fold_leftSpine ea.step (by omega)]
                refine List.mem_append_left _ ?_
                rw [← h_eq]; exact List.getElem_mem hlen_lt
              · rw [List.getElem?_eq_none hge] at heax_ls?; cases heax_ls?
            have hej_step_lt : ej.step + 1 ≤ ea.step := by omega
            have hslock := ((hfold.spine_lock jid hjid).2 ea.step hej_step_lt hea_le_popx).1
              ea.x heax_mem_fold
            have hejx_lt_eax : ej.x < ea.x := by
              have := hsub_mono (idxSub ej.x) ca hcx_lt_ca (by omega); omega
            have heax_lt_ejz : ea.x < ej.z := by
              have := hsub_mono ca c hca_lt_c hc_bds.2
              have := (hsub_bds c hc_bds.2).2.1
              omega
            exact absurd ⟨hejx_lt_eax, heax_lt_ejz⟩ hslock
          ·
            have hjid_Va : jid ∈ V_of ca := by
              refine Finset.mem_filter.mpr ⟨hjid_vact, ?_⟩
              rw [List.getElem?_eq_getElem hjid]
              dsimp (config := { failIfUnchanged := false }) only; rw [decide_eq_true_iff]
              exact hcx_eq_ca
            have hida_le_jid : ida ≤ jid := Finset.min'_le (V_of ca) jid hjid_Va
            rcases eq_or_lt_of_le hida_le_jid with heq_id | hlt_id
            · have hea_eq_ej : some ea = some ej := by
                rw [← List.getElem?_eq_getElem hida, ← List.getElem?_eq_getElem hjid, heq_id]
              injection hea_eq_ej with hea_eq_ej'
              have : ea.step = ej.step := congrArg JumpRecord.step hea_eq_ej'
              omega
            · rcases hjump.jump_order ida hida jid hjid hlt_id with hlt_st | ⟨heq_st, _⟩
