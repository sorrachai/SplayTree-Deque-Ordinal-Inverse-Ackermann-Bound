          have hSD : D ≤ S := by dsimp (config := { failIfUnchanged := false }) [S]; nlinarith
          have hu_MS : u.num_nodes = M * S := by
            rw [hu_n]
            change 4 * D * (4 * qJ * J) = M * S
            dsimp (config := { failIfUnchanged := false }) [M, S]
            ring
          have hk_eq : 2 * (p + 2) + 2 = 2 * (p + 3) := by omega
          rw [← hk_eq] at hv
          have h_blk : ∀ (w : _root_.BinaryTree Unit) (w_seq : List RightRotOp),
              w.num_nodes = S → ValidRightRotSeq Δ' (2 * (p + 2) + 2) w w_seq →
              countGappedCascades w_seq ≤ 4 * (D + 2) * (j0 + 1) * S := by
            intro w w_seq hw hv_w
            rw [hk_eq] at hv_w
            exact ih_j w w_seq hw hv_w
          have h_glb : ∀ (g : _root_.BinaryTree Unit) (g_seq : List RightRotOp),
              g.num_nodes = D * M → ValidRightRotSeq Δ' (2 * (p + 2)) g g_seq →
              countGappedCascades g_seq ≤ 4 * (D + 2) * J * (4 * D * qJ) := by
            intro g g_seq hg hv_g
            have hg' : g.num_nodes = 4 * D * qJ := by rw [hg]; dsimp (config := { failIfUnchanged := false }) [M]; ring
            exact ih_p J (by omega) g g_seq hg' hv_g
          have hc := h_step_comb (2 * (p + 2)) M S
            (4 * (D + 2) * (j0 + 1) * S) (4 * (D + 2) * J * (4 * D * qJ))
            (by omega) hM1 hSD h_blk h_glb u seq hu_MS hv
          change countGappedCascades seq ≤ 4 * (D + 2) * (j0 + 2) * (4 * D * (4 * qJ * J))
          have h_glb_eq : 4 * (D + 2) * J * (4 * D * qJ) = (D + 2) * (M * S) := by
            dsimp (config := { failIfUnchanged := false }) [M, S]
            ring
          have h_tot_eq : 4 * D * (4 * qJ * J) = M * S := by dsimp (config := { failIfUnchanged := false }) [M, S]; ring
