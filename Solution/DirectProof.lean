private lemma alpha_one_two_pow_two_pow (d N : ℕ) (hd : 3 ≤ d) (hN : N ≤ 2 ^ (2 ^ d)) :
    iteratedInvAckermannHierarchy 1 N ≤ d := by
  have h2d_pos : 1 ≤ 2 ^ d := Nat.one_le_two_pow
  have h0 : iteratedInvAckermannHierarchy 0 N ≤ 2 ^ d := by
    change invAckermann N ≤ 2 ^ d
    exact (invAck_galois N (2 ^ d) h2d_pos).mpr
      (le_trans hN (ack_col1_exp (2 ^ d) h2d_pos))
  have h00 : iteratedInvAckermannHierarchy 0 (iteratedInvAckermannHierarchy 0 N) ≤ d := by
    change invAckermann (iteratedInvAckermannHierarchy 0 N) ≤ d
    exact le_trans (invAck_mono h0)
      ((invAck_galois (2 ^ d) d (by omega)).mpr (ack_col1_exp d (by omega)))
  have hs1 := hierarchy_step_le 0 N
  have hs2 := hierarchy_step_le 0 (iteratedInvAckermannHierarchy 0 N)
  have hmono : iteratedInvAckermannHierarchy 1
      (iteratedInvAckermannHierarchy 0 (iteratedInvAckermannHierarchy 0 N)) ≤
      iteratedInvAckermannHierarchy 1 d :=
    (hierarchy_good 1).2.1 h00
  have hd_sub := hierarchy_le_sub_two 0 d hd
  simp only [Nat.zero_add] at hs1 hs2 hd_sub
  omega

theorem alpha_one_of_six_pow_three (r N : ℕ) (hr : 1 ≤ r) (hN : N ≤ 2 ^ (6 ^ (3 * r))) :
    SplayTree.iteratedInvAckermannHierarchy 1 N ≤ 8 * r + 2 := by
  have h63 : 6 ^ (3 * r) ≤ 2 ^ (8 * r) := by
    calc 6 ^ (3 * r) = (6 ^ 3) ^ r := by rw [pow_mul]
      _ ≤ (2 ^ 8) ^ r := Nat.pow_le_pow_left (by norm_num) r
      _ = 2 ^ (8 * r) := by rw [← pow_mul]
  have hN' : N ≤ 2 ^ (2 ^ (8 * r)) :=
    le_trans hN (Nat.pow_le_pow_right (by omega) h63)
  have h1 := alpha_one_two_pow_two_pow (8 * r) N (by omega) hN'
  omega

private lemma eight_r_pow6_step (y : ℕ) : (y + 82) ^ 6 ≤ 2 * (y + 74) ^ 6 := by
  have hring : 2 * (y + 74) ^ 6 = (y + 82) ^ 6 +
      (y ^ 6 + 396 * y ^ 5 + 63420 * y ^ 4 + 5181600 * y ^ 3 +
       221414640 * y ^ 2 + 4383688896 * y + 24406308928) := by ring
  omega

private lemma eight_r_pow6_le_pow : ∀ d : ℕ, (8 * (d + 9) + 2) ^ 6 ≤ 2 ^ (d + 42) := by
  intro d
  induction d with
  | zero => norm_num
  | succ d ih =>
    have hstep : (8 * (d + 1 + 9) + 2) ^ 6 ≤ 2 * (8 * (d + 9) + 2) ^ 6 := by
      have hs := eight_r_pow6_step (8 * d)
      have h1 : 8 * d + 82 = 8 * (d + 1 + 9) + 2 := by omega
      have h2 : 8 * d + 74 = 8 * (d + 9) + 2 := by omega
      rw [h1, h2] at hs
      exact hs
    have hpow : 2 ^ (d + 1 + 42) = 2 * 2 ^ (d + 42) := by
      have : d + 1 + 42 = (d + 42) + 1 := by omega
      rw [this, pow_succ]; ring
    omega

theorem terminal_bisection_log_bound (r N : ℕ) (hr : 1 ≤ r) (hN1 : 1 ≤ N)
    (hN : N ≤ (max (8 * r + 2) (2 ^ 36)) ^ 6) :
    Nat.log 2 N ≤ r + 216 := by
  have h_lt : N < 2 ^ (r + 217) := by
    by_cases hmax : 8 * r + 2 ≤ 2 ^ 36
    · have hm : max (8 * r + 2) (2 ^ 36) = 2 ^ 36 := max_eq_right hmax
      rw [hm] at hN
      have h216 : (2 ^ 36) ^ 6 = 2 ^ 216 := by norm_num
      have hpow : 2 ^ 216 < 2 ^ (r + 217) := Nat.pow_lt_pow_right (by omega) (by omega)
      omega
    · have hm : max (8 * r + 2) (2 ^ 36) = 8 * r + 2 := max_eq_left (by omega)
      rw [hm] at hN
      have hr9 : 9 ≤ r := by omega
      have hd := eight_r_pow6_le_pow (r - 9)
      have hsub : r - 9 + 9 = r := by omega
      rw [hsub] at hd
      have hpow : 2 ^ (r - 9 + 42) < 2 ^ (r + 217) :=
        Nat.pow_lt_pow_right (by omega) (by omega)
      omega
  by_contra hgt
  have hlog : r + 217 ≤ Nat.log 2 N := by omega
  have hpow1 : 2 ^ (r + 217) ≤ 2 ^ (Nat.log 2 N) := Nat.pow_le_pow_right (by omega) hlog
  have hpow2 : 2 ^ (Nat.log 2 N) ≤ N := Nat.pow_log_le_self 2 (by omega)
  omega


