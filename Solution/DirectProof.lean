              countGappedCascades w_seq ≤ 4 * (D + 2) * (j0 + 1) * S :=
            fun w w_seq hw hv_w => ih_j w w_seq hw hv_w
          have h_glb : ∀ (g : _root_.BinaryTree Unit) (g_seq : List RightRotOp),
              g.num_nodes = D * M → ValidRightRotSeq Δ' 2 g g_seq →
