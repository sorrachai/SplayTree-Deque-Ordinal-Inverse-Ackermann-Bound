/-- Scale partition laws for an arbitrary shrinking scale sequence `S : ℕ → ℕ`
(identical to `ScalePartitionLaws` in `Solution.lean` except omitting the flat-pass
`finest_count_bound : L * (scaleBlocks S P L).length ≤ P`, which does not hold at depth `r ≥ 2`
and is replaced by Epoch Grouping Tree leaf-weight convergence). -/
structure ScalePartitionLawsOmega (S : ℕ → ℕ) (P L : ℕ) : Prop where
  blocks_sum : ∀ ℓ ≤ L, ((scaleBlocks S P ℓ).map (fun b => b.2 - b.1)).sum = P
  blocks_bounds : ∀ ℓ ≤ L, ∀ b ∈ scaleBlocks S P ℓ,
    b.1 < b.2 ∧ b.2 ≤ P ∧ S ℓ ≤ b.2 - b.1 ∧ b.2 - b.1 < 2 * S ℓ
  blocks_partition : ∀ ℓ ≤ L, ∀ u < P,
    blockIdx S P ℓ u < (scaleBlocks S P ℓ).length ∧
      (blockOf S P ℓ u).1 ≤ u ∧ u < (blockOf S P ℓ u).2 ∧
      (scaleBlocks S P ℓ)[blockIdx S P ℓ u]? = some (blockOf S P ℓ u)
  blocks_eq_iff : ∀ ℓ ≤ L, ∀ u < P, ∀ v < P,
    (blockIdx S P ℓ u = blockIdx S P ℓ v ↔
      (blockOf S P ℓ u).1 ≤ v ∧ v < (blockOf S P ℓ u).2)
  blocks_mono : ∀ ℓ ≤ L, ∀ u v, u ≤ v → v < P → blockIdx S P ℓ u ≤ blockIdx S P ℓ v
  child_blocks : ∀ ℓ, 1 ≤ ℓ → ℓ ≤ L → ∀ Xi < (scaleBlocks S P (ℓ - 1)).length,
    let X := (scaleBlocks S P (ℓ - 1)).getD Xi (0, 0)
    let subs := splitBlock (S ℓ) X.1 X.2
    2 ≤ subs.length ∧
      (subs.getD 0 (0, 0)).1 = X.1 ∧
      (subs.getD (subs.length - 1) (0, 0)).2 = X.2 ∧
      (∀ c < subs.length,
        let sc := subs.getD c (0, 0)
        X.1 ≤ sc.1 ∧ sc.1 < sc.2 ∧ sc.2 ≤ X.2 ∧ S ℓ ≤ sc.2 - sc.1 ∧ sc.2 - sc.1 < 2 * S ℓ) ∧
      (∀ c, c + 1 < subs.length →
        (subs.getD c (0, 0)).2 = (subs.getD (c + 1) (0, 0)).1) ∧
      (∀ u < P, (blockIdx S P (ℓ - 1) u = Xi ↔ X.1 ≤ u ∧ u < X.2)) ∧
      (∀ u, X.1 ≤ u → u < X.2 →
        let c := subs.findIdx (fun b => decide (b.1 ≤ u ∧ u < b.2))
        c < subs.length ∧ subs.getD c (0, 0) = blockOf S P ℓ u) ∧
      (∀ u1, X.1 ≤ u1 → u1 < X.2 → ∀ u2, X.1 ≤ u2 → u2 < X.2 →
        (subs.findIdx (fun b => decide (b.1 ≤ u1 ∧ u1 < b.2)) =
          subs.findIdx (fun b => decide (b.1 ≤ u2 ∧ u2 < b.2)) ↔
            blockIdx S P ℓ u1 = blockIdx S P ℓ u2))
  sep_symm : ∀ u v, sepScale S P L u v = sepScale S P L v u
  sep_top : ∀ u, sepScale S P L u P = 0 ∧ sepScale S P L P u = 0
  sep_range : ∀ u < P, ∀ v < P, u ≠ v → 1 ≤ sepScale S P L u v ∧ sepScale S P L u v ≤ L + 1
  sep_self : ∀ u < P, sepScale S P L u u = L + 1
  sep_gt_iff : ∀ m ≤ L, ∀ u < P, ∀ v < P,
    (m < sepScale S P L u v ↔ blockIdx S P m u = blockIdx S P m v)
  sep_ultrametric : ∀ a b c, a ≤ b → b ≤ c → c < P →
    sepScale S P L a c = min (sepScale S P L a b) (sepScale S P L b c)

/-- Lexicographic coordinate representation of an Epoch Grouping Tree of exact leaf depth `r`
over scales `1, ..., L`. Each leaf `ℓ ∈ {1, ..., L}` carries positive child coordinates
`addr ℓ : Fin r → ℕ`, strictly increasing in lexicographic order. -/
structure ValidEpochAddress (r L : ℕ) (addr : ℕ → Fin r → ℕ) : Prop where
  pos : ∀ ℓ, 1 ≤ ℓ → ℓ ≤ L → ∀ d : Fin r, 1 ≤ addr ℓ d
  lex_strictMono : ∀ ℓ1 ℓ2, 1 ≤ ℓ1 → ℓ1 < ℓ2 → ℓ2 ≤ L →
    ∃ d : Fin r, (∀ q : Fin r, q < d → addr ℓ1 q = addr ℓ2 q) ∧ addr ℓ1 d < addr ℓ2 d

/-- Path weight `w_ℓ = ∏_{d=0}^{r-1} (4 * c_d(ℓ)^2)` of leaf `ℓ` in an Epoch Grouping Tree. -/
def epochLeafWeight (r : ℕ) (addr : ℕ → Fin r → ℕ) (ℓ : ℕ) : ℕ :=
  (Finset.univ : Finset (Fin r)).prod (fun d => 4 * (addr ℓ d) ^ 2)

/-- Height-independent exit subset of `B_1`: jumps `e = (x, y, z) ∈ B_1` whose new parent `z`
strictly exits `B_{sep(x, y)}(y)` (`(blockOf S P (sepScale S P L e.x e.y) e.y).2 ≤ e.z`).
Every such jump freezes `B_{sep(x, y)}(y)` off `LS` until `popStep e.x`, after which
`sep(s', x') ≥ sep(x, y)` prevents any later `B_1` jump from targeting that same block. -/
def isB1Exit (S : ℕ → ℕ) (P L : ℕ) (kops : List KeyedCoreOp) (id : ℕ) : Bool :=
  match (jumps kops)[id]? with
  | none => false
  | some e =>
      let ℓ := sepScale S P L e.x e.y
      decide (1 ≤ ℓ ∧ ℓ ≤ L ∧ sepScale S P L e.s e.x < ℓ ∧
        (blockOf S P ℓ e.y).2 ≤ e.z)

def B_1_exit (S : ℕ → ℕ) (P L : ℕ) (kops : List KeyedCoreOp) : Finset ℕ :=
  (Finset.range (jumps kops).length).filter (fun id => isB1Exit S P L kops id = true)

-- Arithmetic proofs use current reduction behavior.
set_option backward.whnf.reducibleClassField true

