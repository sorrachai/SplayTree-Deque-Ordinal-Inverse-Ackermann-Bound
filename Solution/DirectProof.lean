  let p := i - 2
  have hi_eq : i = p + 2 := by omega
  let M1 := 4 * D * scaleQ p 1
  have hack_le : ackermann (p + 2) 1 ≤ scaleQ p 1 := (h_scaleQ_props p).2.2.2 1
  have hD_pos : 1 ≤ D := by omega
  have hN_le_M1 : N ≤ M1 := by
    rw [hi_eq] at hN_ack
    dsimp (config := { failIfUnchanged := false }) [M1]
    nlinarith
  have hM1_bound :
      ∀ (v : _root_.BinaryTree Unit) (v_seq : List RightRotOp),
        v.num_nodes = M1 →
        ValidRightRotSeq Δ' (2 * i) v v_seq →
        countGappedCascades v_seq ≤ (4 * (Δ' + 4)) * M1 := by
    intro v v_seq hv_n hv_s
    rw [hi_eq] at hv_s
    have h1 := h_thresh_bound p 1 le_rfl v v_seq hv_n hv_s
    have hD4 : D + 2 = Δ' + 4 := by omega
    rw [hD4] at h1
    simpa [M1, Nat.mul_assoc] using h1
  have h_final :=
    h_superadd_pad (2 * i) (4 * (Δ' + 4)) N M1 hN_pos hN_le_M1 hM1_bound
