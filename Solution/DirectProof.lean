                  rw [hbs_eq, hej_step]; exact hea_te
                have hjid_b3a : jid ∈ B_3_act S P L kops := by
                  refine Finset.mem_filter.mpr ⟨Finset.mem_range.mpr hjid, ?_⟩
                  unfold isB3Act
                  rw [List.getElem?_eq_getElem hjid]; dsimp (config := { failIfUnchanged := false }) only
                  rw [decide_eq_true_iff, show sepScale S P L ((jumps kops)[jid]'hjid).x ((jumps kops)[jid]'hjid).y = ℓ from hℓ'_eq]
                  exact ⟨hℓ1, hℓL, hsep_sx, h_not_intra, hej_lt_te⟩
                have hjid_vact : jid ∈ VActSet S P L kops ℓ Xi p := by
                  refine Finset.mem_filter.mpr ⟨hjid_b3a, ?_⟩
                  unfold isVAct
                  rw [List.getElem?_eq_getElem hjid]; dsimp (config := { failIfUnchanged := false }) only
                  rw [decide_eq_true_iff]
                  exact ⟨hℓ'_eq, (hXi_iff ej.x (by omega)).mpr hejx_in_X, hejs1, hejs2⟩
                have hcx_mov : idxSub ej.x ∈ MMovSet S P L kops ℓ Xi p := by
                  refine Finset.mem_image.mpr ⟨jid, hjid_vact, ?_⟩
                  dsimp (config := { failIfUnchanged := false }) only
                  rw [List.getElem?_eq_getElem hjid]
                exact absurd hcx_mov (hgap_free (idxSub ej.x) hca_lt_cx hcx_le_c)


  let f := (puqConcretePkg S P L kops ℓ Xi).F_idx p
  have hf_def : f = (List.range pi0.length).filter (fun ia =>
      decide (pi0.getD ia 0 ∈ MMovSet S P L kops ℓ Xi p)) := rfl
  have hf_pw : List.Pairwise (· < ·) f := by
    rw [hf_def]; exact List.Pairwise.filter _ List.pairwise_lt_range
  have hf_lt : ∀ i ∈ f, i < pi0.length := by
    intro i hi; rw [hf_def, List.mem_filter, List.mem_range] at hi; exact hi.1
  have hf_mov : ∀ i ∈ f, pi0.getD i 0 ∈ MMovSet S P L kops ℓ Xi p := by
    intro i hi; rw [hf_def, List.mem_filter, decide_eq_true_iff] at hi; exact hi.2
  have hf_getD : ∀ k (hk : k < f.length), f.getD k 0 = f[k] := by
    intro k hk; rw [List.getD_eq_getElem?_getD, List.getElem?_eq_getElem hk]; rfl
  have hpi0_getD : ∀ i (hi : i < pi0.length), pi0.getD i 0 = pi0[i] := by
    intro i hi; rw [List.getD_eq_getElem?_getD, List.getElem?_eq_getElem hi]; rfl

  apply h_s1 (p + 1) subs.length pi0 f (puqIsChargedSubblockOmega S P L kops ℓ Xi p)
    h_pi0_props.1 h_pi0_props.2.1 hf_pw hf_lt
  intro r hr1
  have hr0 : r < f.length := by omega
  let ia := f.getD r 0
  let ib := f.getD (r + 1) 0
  have hia_mem : ia ∈ f := by dsimp (config := { failIfUnchanged := false }) only [ia]; rw [hf_getD r hr0]; exact List.getElem_mem hr0
  have hib_mem : ib ∈ f := by dsimp (config := { failIfUnchanged := false }) only [ib]; rw [hf_getD (r + 1) hr1]; exact List.getElem_mem hr1
  have hia_lt_pi0 : ia < pi0.length := hf_lt ia hia_mem
  have hib_lt_pi0 : ib < pi0.length := hf_lt ib hib_mem
  let ca := pi0.getD ia 0
  let cb := pi0.getD ib 0
  have hca_mov : ca ∈ MMovSet S P L kops ℓ Xi p := hf_mov ia hia_mem
  have hcb_mov : cb ∈ MMovSet S P L kops ℓ Xi p := hf_mov ib hib_mem

  let hVa_ne := h_Vm_ne ca hca_mov
  let ida := (V_of ca).min' hVa_ne
  have hida_mem := Finset.min'_mem (V_of ca) hVa_ne
  have hida_vact : ida ∈ VActSet S P L kops ℓ Xi p := (Finset.mem_filter.mp hida_mem).1
  obtain ⟨hida, hts_ea, hea_te, _⟩ := h_vact_anat ida hida_vact
  let ea := (jumps kops)[ida]'hida
  change ts ≤ ea.step at hts_ea
  change ea.step < te at hea_te
  have hca_eq : idxSub ea.x = ca := by
    have hf_a := (Finset.mem_filter.mp hida_mem).2
    rw [List.getElem?_eq_getElem hida] at hf_a
    dsimp (config := { failIfUnchanged := false }) only at hf_a
    exact of_decide_eq_true hf_a

  let hVb_ne := h_Vm_ne cb hcb_mov
  let idb := (V_of cb).min' hVb_ne
  have hidb_mem := Finset.min'_mem (V_of cb) hVb_ne
  have hidb_vact : idb ∈ VActSet S P L kops ℓ Xi p := (Finset.mem_filter.mp hidb_mem).1
  obtain ⟨hidb, hts_eb, heb_te, _⟩ := h_vact_anat idb hidb_vact
  let eb := (jumps kops)[idb]'hidb
  change ts ≤ eb.step at hts_eb
  change eb.step < te at heb_te
  have hcb_eq : idxSub eb.x = cb := by
    have hf_b := (Finset.mem_filter.mp hidb_mem).2
    rw [List.getElem?_eq_getElem hidb] at hf_b
    dsimp (config := { failIfUnchanged := false }) only at hf_b
    exact of_decide_eq_true hf_b

  obtain ⟨e1, e2, e3, hs3_claim⟩ := h_s3 ida hida_vact hida
  refine ⟨e1, e2, e3, ?_⟩
  intro ic hia_lt_ic hic_lt_ib
  have hic_lt_pi0 : ic < pi0.length := by omega
  let c := pi0.getD ic 0
  have hc_pi0 : c ∈ pi0 := by
    dsimp (config := { failIfUnchanged := false }) only [c]; rw [hpi0_getD ic hic_lt_pi0]; exact List.getElem_mem hic_lt_pi0
  have hc_bds := h_pi0_props.2.1 c hc_pi0
  have hca_lt_c : ca < c := by
    dsimp (config := { failIfUnchanged := false }) only [ca, c]
    rw [hpi0_getD ia hia_lt_pi0, hpi0_getD ic hic_lt_pi0]
    exact List.pairwise_iff_getElem.mp h_pi0_props.1 ia ic hia_lt_pi0 hic_lt_pi0 hia_lt_ic
  have hc_lt_cb : c < cb := by
    dsimp (config := { failIfUnchanged := false }) only [c, cb]
    rw [hpi0_getD ic hic_lt_pi0, hpi0_getD ib hib_lt_pi0]
    exact List.pairwise_iff_getElem.mp h_pi0_props.1 ic ib hic_lt_pi0 hib_lt_pi0 hic_lt_ib
  have hgap_free : ∀ c', ca < c' → c' ≤ c → c' ∉ MMovSet S P L kops ℓ Xi p := by
    intro c' hca_c' hc'_c hc'_mov
    have hc'_pi0 := h_pi0_props.2.2 c' hc'_mov
    obtain ⟨i', hi'_lt, hi'_eq⟩ := List.mem_iff_getElem.mp hc'_pi0
    have hia_lt_i' : ia < i' := by
      by_contra hle
      have h1 : pi0[i'] ≤ pi0[ia] := by
        rcases eq_or_lt_of_le (show i' ≤ ia by omega) with rfl | hlt
        · exact le_rfl
        · exact le_of_lt (List.pairwise_iff_getElem.mp h_pi0_props.1 i' ia hi'_lt hia_lt_pi0 hlt)
      dsimp (config := { failIfUnchanged := false }) only [ca] at hca_c'; rw [hpi0_getD ia hia_lt_pi0, ← hi'_eq] at hca_c'; omega
    have hi'_le_ic : i' ≤ ic := by
      by_contra hgt
      have h1 := List.pairwise_iff_getElem.mp h_pi0_props.1 ic i' hic_lt_pi0 hi'_lt (by omega)
      dsimp (config := { failIfUnchanged := false }) only [c] at hc'_c; rw [hpi0_getD ic hic_lt_pi0, ← hi'_eq] at hc'_c; omega
    have hi'_in_f : i' ∈ f := by
      rw [hf_def, List.mem_filter]
      refine ⟨List.mem_range.mpr hi'_lt, ?_⟩
      rw [decide_eq_true_iff, hpi0_getD i' hi'_lt, hi'_eq]
      exact hc'_mov
    obtain ⟨k, hk_lt, hk_eq⟩ := List.mem_iff_getElem.mp hi'_in_f
    by_cases hk_le_r : k ≤ r
    · have hfk : f[k] ≤ f[r] := by
        rcases eq_or_lt_of_le hk_le_r with rfl | hlt
        · exact le_rfl
        · exact le_of_lt (List.pairwise_iff_getElem.mp hf_pw k r hk_lt hr0 hlt)
      dsimp (config := { failIfUnchanged := false }) only [ia] at hia_lt_i'; rw [hf_getD r hr0, ← hk_eq] at hia_lt_i'; omega
    · have hfk : f[r + 1] ≤ f[k] := by
        rcases eq_or_lt_of_le (show r + 1 ≤ k by omega) with rfl | hlt
        · exact le_rfl
        · exact le_of_lt (List.pairwise_iff_getElem.mp hf_pw (r + 1) k hr1 hk_lt hlt)
      rw [← hk_eq] at hi'_le_ic
      rw [hf_getD (r + 1) hr1] at hic_lt_ib
      omega

  have h_to_charged : puqIsClassA S P kops ℓ Xi p c = true ∨
      puqIsClassB4Omega S P L kops ℓ Xi p c = true ∨
      puqIsClassC1 S P kops ℓ Xi p c = true ∨
      puqIsClassC2 S P kops ℓ Xi p c = true →
      puqIsChargedSubblockOmega S P L kops ℓ Xi p c = true := by
    unfold puqIsChargedSubblockOmega
    rintro (hA | hB | hC1 | hC2)
    · simp [hA]
    · simp [hB]
    · simp [hC1]
    · simp [hC2]

  rcases h_s2_evict ca hca_mov c hc_pi0 hca_lt_c hgap_free with hA | hB4 | ⟨hida', r_c, hrc_fold, hrc1, hrc2⟩
  · exact Or.inl (h_to_charged (Or.inl hA))
  · exact Or.inl (h_to_charged (Or.inr (Or.inl hB4)))
  · change r_c ∈ leftSpineBottomUpNat (foldBST P (keyedState kops ea.step)).1 at hrc_fold
    let fold_ls := leftSpineBottomUpNat (foldBST P (keyedState kops ea.step)).1
    let S_rc := fold_ls.toFinset.filter (fun u =>
      (subs.getD c (0, 0)).1 ≤ u ∧ u < (subs.getD c (0, 0)).2)
    have hSrc_ne : S_rc.Nonempty :=
      ⟨r_c, Finset.mem_filter.mpr ⟨List.mem_toFinset.mpr hrc_fold, hrc1, hrc2⟩⟩
    let r_max := S_rc.max' hSrc_ne
    have hrmax_mem := Finset.max'_mem S_rc hSrc_ne
    obtain ⟨hrmax_in_fin, hrmax1, hrmax2⟩ := Finset.mem_filter.mp hrmax_mem
    have hrmax_fold : r_max ∈ leftSpineBottomUpNat (foldBST P (keyedState kops ea.step)).1 :=
      List.mem_toFinset.mp hrmax_in_fin
    obtain ⟨_, hea_len, hea_op?, _⟩ := hjump.jump_anatomies ida hida
    change ea.step < kops.length at hea_len
    change kops[ea.step]? = some (.pop ea.s) at hea_op?
    have hea_op : kops[ea.step] = .pop ea.s := by
      rw [List.getElem?_eq_getElem hea_len] at hea_op?; injection hea_op?
    have hsv_ea := hkvalid.step_valid ea.step hea_len
    rw [hea_op] at hsv_ea
    have hne_ea : keyedState kops ea.step ≠ .nil := hsv_ea.2.2.2.1
    have hrmax_max_ls : ∀ u ∈ leftSpineBottomUpNat (keyedState kops ea.step),
        r_max < u → (subs.getD c (0, 0)).2 ≤ u := by
      intro u hu_ls hgt_u
      by_contra hlt_sc2
      have hu_fold : u ∈ fold_ls := by
        dsimp (config := { failIfUnchanged := false }) only [fold_ls]
        rw [hfold.fold_leftSpine ea.step (le_of_lt hea_len)]
        exact List.mem_append_left _ hu_ls
      have hu_Src : u ∈ S_rc :=
        Finset.mem_filter.mpr ⟨List.mem_toFinset.mpr hu_fold, by omega, by omega⟩
      have hle_max := Finset.le_max' S_rc u hu_Src
      omega
    obtain ⟨hdich_lt, hdich_ge⟩ := h_root_dichotomy ea.step (by omega) hne_ea r_max hrmax_fold
    by_cases hrc_lt_b0 : r_max < (foldBST P (keyedState kops ea.step)).2
    · have hrc_ls := hdich_lt hrc_lt_b0
      have hs3_res := hs3_claim c (by rwa [hca_eq]) hc_bds.2 (by rwa [hca_eq])
        ⟨r_max, hrc_ls, hrc_lt_b0, hrmax1, hrmax2, hrmax_max_ls⟩
      rcases hs3_res with hB4 | he1 | he2 | he3
      · exact Or.inl (h_to_charged (Or.inr (Or.inl hB4)))
      · exact Or.inr (Or.inl he1)
      · exact Or.inr (Or.inr (Or.inl he2))
      · exact Or.inr (Or.inr (Or.inr he3))
    · have hrc_rs1 := hdich_ge (by omega)
      have hrc_not_rs2 := h_vact_rs_excl idb hidb_vact hidb c (by rwa [hcb_eq]) hc_bds.2 r_max hrmax1 hrmax2
      rcases h_s4 c hc_bds.1 hc_bds.2 ea.step eb.step hts_ea hea_te hts_eb heb_te r_max hrmax1 hrmax2 hrc_rs1 hrc_not_rs2 with hC1 | hC2
      · exact Or.inl (h_to_charged (Or.inr (Or.inr (Or.inl hC1))))
      · exact Or.inl (h_to_charged (Or.inr (Or.inr (Or.inr hC2))))

set_option backward.whnf.reducibleClassField true

private theorem global_charged_subblock_sum_bound_omega (P L : ℕ) (S : ℕ → ℕ) (kops : List KeyedCoreOp)
    (hP : 1 ≤ P) (hL : 1 ≤ L)
    (hkvalid : ValidKeyedCoreSeq P kops) (hjump : PrimalJumpLaws P kops)
    (hpart : ScalePartitionLawsOmega S P L) :
    (Finset.Icc 1 L).sum (fun ℓ =>
      (Finset.range (scaleBlocks S P (ℓ - 1)).length).sum (fun Xi =>
        let X := (scaleBlocks S P (ℓ - 1)).getD Xi (0, 0)
        let subs := splitBlock (S ℓ) X.1 X.2
        (Finset.range (subs.length - 1)).sum (fun p =>
          ((Finset.Ico (p + 1) subs.length).filter
            (fun c => puqIsChargedSubblockOmega S P L kops ℓ Xi p c = true)).card))) ≤
      2 * (B_fin_pre S P L kops).card + 2 * (B_1_exit S P L kops).card +
        2 * (B_3_intra S P L kops).card + 2 * countKeyedRslr kops + P :=
by
  have _ := hP; have _ := hL; have _ := hjump
  have h_find_of_any :
      ∀ (xs : List ℕ) (pred : ℕ → Bool),
        xs.any pred = true →
        (xs.find? pred).getD 0 ∈ xs ∧ pred ((xs.find? pred).getD 0) = true := by
    intro xs pred h
    cases hf : xs.find? pred with
    | none =>
      rw [List.find?_eq_none] at hf
      rw [List.any_eq_true] at h
      obtain ⟨x, hx1, hx2⟩ := h
      exact absurd hx2 (hf x hx1)
    | some w =>
      exact ⟨List.mem_of_find?_eq_some hf, List.find?_some hf⟩

  have h_tEmpty_le :
      ∀ lo hi : ℕ, tEmpty kops lo hi ≤ popStep kops (hi - 1) + 1 := by
    intro lo hi
    unfold tEmpty
    dsimp (config := { failIfUnchanged := false }) only
    cases hfind : (List.Ico (popStep kops lo) (popStep kops (hi - 1) + 1 + 1)).find?
        (fun t => (inorderNat (keyedState kops t)).all (fun v => decide (v < lo ∨ hi ≤ v))) with
    | none =>
      dsimp (config := { failIfUnchanged := false }) only
      exact le_rfl
    | some t =>
      dsimp (config := { failIfUnchanged := false }) only
      have hmem := List.mem_of_find?_eq_some hfind
      rw [List.Ico.mem] at hmem
      omega

  have h_X_le_P :
      ∀ ℓ, 1 ≤ ℓ → ℓ ≤ L → ∀ Xi (hXi : Xi < (scaleBlocks S P (ℓ - 1)).length),
        ((scaleBlocks S P (ℓ - 1)).getD Xi (0, 0)).2 ≤ P := by
    intro ℓ hℓ1 hℓL Xi hXi
    have hget : (scaleBlocks S P (ℓ - 1)).getD Xi (0, 0) = (scaleBlocks S P (ℓ - 1))[Xi] := by
      rw [List.getD_eq_getElem?_getD, List.getElem?_eq_getElem hXi]
      rfl
    rw [hget]
    exact (hpart.blocks_bounds (ℓ - 1) (by omega) _ (List.getElem_mem hXi)).2.1

  have h_coord_window :
      ∀ ℓ, 1 ≤ ℓ → ℓ ≤ L → ∀ Xi < (scaleBlocks S P (ℓ - 1)).length,
        let X := (scaleBlocks S P (ℓ - 1)).getD Xi (0, 0)
        let subs := splitBlock (S ℓ) X.1 X.2
        (∀ idx < subs.length,
          let sidx := subs.getD idx (0, 0)
          X.1 ≤ sidx.1 ∧ sidx.1 < sidx.2 ∧ sidx.2 ≤ X.2 ∧ X.2 ≤ P) ∧
        (∀ w, X.1 ≤ w → w < X.2 →
          let cw := subs.findIdx (fun b => decide (b.1 ≤ w ∧ w < b.2))
          cw < subs.length ∧ (subs.getD cw (0, 0)).1 ≤ w ∧ w < (subs.getD cw (0, 0)).2) ∧
        (∀ i j, i < j → j < subs.length →
          ∀ u v,
            (subs.getD i (0, 0)).1 ≤ u → u < (subs.getD i (0, 0)).2 →
            (subs.getD j (0, 0)).1 ≤ v → v < (subs.getD j (0, 0)).2 →
            u < P ∧ v < P ∧
              sepScale S P L u v = ℓ ∧
              blockIdx S P (ℓ - 1) v = Xi ∧
              subs.findIdx (fun b => decide (b.1 ≤ u ∧ u < b.2)) = i ∧
              subs.findIdx (fun b => decide (b.1 ≤ v ∧ v < b.2)) = j) ∧
        (∀ p1 p2, p1 < p2 → p2 < subs.length →
          tEmpty kops (subs.getD p1 (0, 0)).1 (subs.getD p1 (0, 0)).2 ≤
            popStep kops (subs.getD p2 (0, 0)).1) := by
    intro ℓ hℓ1 hℓL Xi hXi
    have hXP : ((scaleBlocks S P (ℓ - 1)).getD Xi (0, 0)).2 ≤ P := h_X_le_P ℓ hℓ1 hℓL Xi hXi
    obtain ⟨_, _, _, h_sub, h_adj, h_memX, h_fidx, h_feq⟩ :=
      hpart.child_blocks ℓ hℓ1 hℓL Xi hXi
    dsimp (config := { failIfUnchanged := false }) only at h_sub h_adj h_memX h_fidx h_feq ⊢
    set X := (scaleBlocks S P (ℓ - 1)).getD Xi (0, 0)
    set subs := splitBlock (S ℓ) X.1 X.2
    have h_c1 : ∀ idx < subs.length,
        X.1 ≤ (subs.getD idx (0, 0)).1 ∧
        (subs.getD idx (0, 0)).1 < (subs.getD idx (0, 0)).2 ∧
        (subs.getD idx (0, 0)).2 ≤ X.2 ∧ X.2 ≤ P := by
      intro idx hidx
      obtain ⟨h1, h2, h3, _, _⟩ := h_sub idx hidx
      exact ⟨h1, h2, h3, hXP⟩
    have h_c2 : ∀ w, X.1 ≤ w → w < X.2 →
        let cw := subs.findIdx (fun b => decide (b.1 ≤ w ∧ w < b.2))
        cw < subs.length ∧ (subs.getD cw (0, 0)).1 ≤ w ∧ w < (subs.getD cw (0, 0)).2 := by
      intro w hw1 hw2
      dsimp (config := { failIfUnchanged := false }) only
      obtain ⟨hcw_lt, hcw_eq⟩ := h_fidx w hw1 hw2
      obtain ⟨_, hb1, hb2, _⟩ := hpart.blocks_partition ℓ hℓL w (by omega)
      rw [hcw_eq]
      exact ⟨hcw_lt, hb1, hb2⟩
    have h_mono : ∀ j i, i < j → j < subs.length →
        (subs.getD i (0, 0)).2 ≤ (subs.getD j (0, 0)).1 := by
      intro j
      induction j with
      | zero =>
        intro i hi _
        omega
      | succ k ih =>
        intro i hi hk
        have hk_lt : k < subs.length := by omega
        have hadj := h_adj k hk
        obtain ⟨_, hsk, _, _, _⟩ := h_sub k hk_lt
        by_cases hik : i = k
        · subst hik
          omega
        · have hi_lt_k : i < k := by omega
          have hih := ih i hi_lt_k hk_lt
          omega
    have h_fidx_unique : ∀ idx < subs.length, ∀ w,
        (subs.getD idx (0, 0)).1 ≤ w → w < (subs.getD idx (0, 0)).2 →
        subs.findIdx (fun b => decide (b.1 ≤ w ∧ w < b.2)) = idx := by
      intro idx hidx w hw1 hw2
      obtain ⟨hs1, _, hs3, _⟩ := h_c1 idx hidx
      obtain ⟨hcw_lt, hcw1, hcw2⟩ := h_c2 w (by omega) (by omega)
      set cw := subs.findIdx (fun b => decide (b.1 ≤ w ∧ w < b.2))
      by_cases hlt : cw < idx
      · have hm := h_mono idx cw hlt hidx
        omega
      · by_cases hgt : idx < cw
        · have hm := h_mono cw idx hgt hcw_lt
          omega
        · omega
    have h_c3 : ∀ i j, i < j → j < subs.length →
        ∀ u v,
          (subs.getD i (0, 0)).1 ≤ u → u < (subs.getD i (0, 0)).2 →
          (subs.getD j (0, 0)).1 ≤ v → v < (subs.getD j (0, 0)).2 →
          u < P ∧ v < P ∧
            sepScale S P L u v = ℓ ∧
            blockIdx S P (ℓ - 1) v = Xi ∧
            subs.findIdx (fun b => decide (b.1 ≤ u ∧ u < b.2)) = i ∧
            subs.findIdx (fun b => decide (b.1 ≤ v ∧ v < b.2)) = j := by
      intro i j hij hj u v hu1 hu2 hv1 hv2
      have hi : i < subs.length := by omega
      obtain ⟨hsi1, _, hsi3, _⟩ := h_c1 i hi
      obtain ⟨hsj1, _, hsj3, _⟩ := h_c1 j hj
      have huX1 : X.1 ≤ u := by omega
      have huX2 : u < X.2 := by omega
      have hvX1 : X.1 ≤ v := by omega
      have hvX2 : v < X.2 := by omega
      have huP : u < P := by omega
      have hvP : v < P := by omega
      have hfu : subs.findIdx (fun b => decide (b.1 ≤ u ∧ u < b.2)) = i :=
        h_fidx_unique i hi u hu1 hu2
      have hfv : subs.findIdx (fun b => decide (b.1 ≤ v ∧ v < b.2)) = j :=
        h_fidx_unique j hj v hv1 hv2
      have hbu : blockIdx S P (ℓ - 1) u = Xi := (h_memX u huP).mpr ⟨huX1, huX2⟩
      have hbv : blockIdx S P (ℓ - 1) v = Xi := (h_memX v hvP).mpr ⟨hvX1, hvX2⟩
      have hsep_gt : ℓ - 1 < sepScale S P L u v :=
        (hpart.sep_gt_iff (ℓ - 1) (by omega) u huP v hvP).mpr (hbu.trans hbv.symm)
      have hnot_sep_gt : ¬ ℓ < sepScale S P L u v := by
        intro hlt
        have hbeq : blockIdx S P ℓ u = blockIdx S P ℓ v :=
          (hpart.sep_gt_iff ℓ hℓL u huP v hvP).mp hlt
        have hfeq_uv :
            subs.findIdx (fun b => decide (b.1 ≤ u ∧ u < b.2)) =
              subs.findIdx (fun b => decide (b.1 ≤ v ∧ v < b.2)) :=
          (h_feq u huX1 huX2 v hvX1 hvX2).mpr hbeq
        omega
      exact ⟨huP, hvP, by omega, hbv, hfu, hfv⟩
    have h_c4 : ∀ p1 p2, p1 < p2 → p2 < subs.length →
        tEmpty kops (subs.getD p1 (0, 0)).1 (subs.getD p1 (0, 0)).2 ≤
          popStep kops (subs.getD p2 (0, 0)).1 := by
      intro p1 p2 hp12 hp2
      have hp1 : p1 < subs.length := by omega
      obtain ⟨_, hsp1_lt, _, _⟩ := h_c1 p1 hp1
      obtain ⟨_, hsp2_lt, hsp2_hi, _⟩ := h_c1 p2 hp2
      have hm := h_mono p2 p1 hp12 hp2
      have hte := h_tEmpty_le (subs.getD p1 (0, 0)).1 (subs.getD p1 (0, 0)).2
      have hpop := hkvalid.popStep_mono ((subs.getD p1 (0, 0)).2 - 1)
        (subs.getD p2 (0, 0)).1 (by omega) (by omega)
      omega
    exact ⟨h_c1, h_c2, h_c3, h_c4⟩

  let isRslrAt : List KeyedCoreOp → ℕ → Bool := fun xs t =>
    match xs[t]? with
    | some (.rslr _) => true
    | _ => false
  let rslrSteps : Finset ℕ :=
    (Finset.range kops.length).filter (fun t => isRslrAt kops t = true)

  have h_rslr_append :
      ∀ (xs : List KeyedCoreOp) (op : KeyedCoreOp),
        countKeyedRslr (xs ++ [op]) =
          countKeyedRslr xs + (match op with | .rslr _ => 1 | _ => 0) := by
    intro xs op
    induction xs with
    | nil =>
      cases op <;> simp [countKeyedRslr]
    | cons a rest ih =>
      cases a with
      | push _ => simp [countKeyedRslr, ih]
      | pop _ => simp [countKeyedRslr, ih]
      | rslr _ => simp [countKeyedRslr, ih]; omega

  have h_rslr_card_aux :
      ∀ xs : List KeyedCoreOp,
        ((Finset.range xs.length).filter (fun t => isRslrAt xs t = true)).card =
          countKeyedRslr xs := by
    intro xs
    refine List.reverseRecOn xs ?_ (fun ys op ih => ?_)
    · simp [countKeyedRslr]
    · rw [List.length_append, List.length_singleton, Finset.range_add_one, Finset.filter_insert]
      have hcongr :
          (Finset.range ys.length).filter (fun t => isRslrAt (ys ++ [op]) t = true) =
            (Finset.range ys.length).filter (fun t => isRslrAt ys t = true) := by
        refine Finset.filter_congr ?_
        intro t ht
        rw [Finset.mem_range] at ht
        simp only [isRslrAt, List.getElem?_append_left ht]
      have hlast : isRslrAt (ys ++ [op]) ys.length =
          (match op with | .rslr _ => true | _ => false) := by
        cases op <;> simp [isRslrAt]
      have hnotmem :
          ys.length ∉ (Finset.range ys.length).filter (fun t => isRslrAt ys t = true) := by
        simp [Finset.mem_filter, Finset.mem_range]
      rw [hcongr, hlast, h_rslr_append]
      cases op with
      | push w => simp [ih]
      | pop s => simp [ih]
      | rslr d => simp [Finset.card_insert_of_notMem hnotmem, ih]

  have h_rslr_card : rslrSteps.card = countKeyedRslr kops := h_rslr_card_aux kops

  let U : Finset (ℕ × ℕ × ℕ × ℕ) :=
    (Finset.Icc 1 L).biUnion (fun ℓ =>
      (Finset.range (scaleBlocks S P (ℓ - 1)).length).biUnion (fun Xi =>
        let X := (scaleBlocks S P (ℓ - 1)).getD Xi (0, 0)
        let subs := splitBlock (S ℓ) X.1 X.2
        (Finset.range (subs.length - 1)).biUnion (fun p =>
          (Finset.Ico (p + 1) subs.length).image (fun c => (ℓ, Xi, p, c)))))

  let Q_chg : Finset (ℕ × ℕ × ℕ × ℕ) :=
    (Finset.Icc 1 L).biUnion (fun ℓ =>
      (Finset.range (scaleBlocks S P (ℓ - 1)).length).biUnion (fun Xi =>
        let X := (scaleBlocks S P (ℓ - 1)).getD Xi (0, 0)
        let subs := splitBlock (S ℓ) X.1 X.2
        (Finset.range (subs.length - 1)).biUnion (fun p =>
          ((Finset.Ico (p + 1) subs.length).filter
            (fun c => puqIsChargedSubblockOmega S P L kops ℓ Xi p c = true)).image
              (fun c => (ℓ, Xi, p, c)))))

  have h_sum_eq :
      (Finset.Icc 1 L).sum (fun ℓ =>
        (Finset.range (scaleBlocks S P (ℓ - 1)).length).sum (fun Xi =>
          let X := (scaleBlocks S P (ℓ - 1)).getD Xi (0, 0)
          let subs := splitBlock (S ℓ) X.1 X.2
          (Finset.range (subs.length - 1)).sum (fun p =>
            ((Finset.Ico (p + 1) subs.length).filter
              (fun c => puqIsChargedSubblockOmega S P L kops ℓ Xi p c = true)).card))) =
        Q_chg.card := by
    symm
    dsimp (config := { failIfUnchanged := false }) only [Q_chg]
    rw [Finset.card_biUnion]
    · refine Finset.sum_congr rfl (fun ℓ _ => ?_)
      rw [Finset.card_biUnion]
      · refine Finset.sum_congr rfl (fun Xi _ => ?_)
        dsimp (config := { failIfUnchanged := false }) only
        rw [Finset.card_biUnion]
        · refine Finset.sum_congr rfl (fun p _ => ?_)
          exact Finset.card_image_of_injective _ (fun c1 c2 h => by simpa using h)
        · intro p1 _ p2 _ hne
          dsimp (config := { failIfUnchanged := false }) only [Function.onFun]
          rw [Finset.disjoint_left]
          intro q hq1 hq2
          simp only [Finset.mem_image] at hq1 hq2
          obtain ⟨c1, _, rfl⟩ := hq1
          obtain ⟨c2, _, heq⟩ := hq2
          have : p2 = p1 := congrArg (fun r => r.2.2.1) heq
          exact hne this.symm
      · intro Xi1 _ Xi2 _ hne
        dsimp (config := { failIfUnchanged := false }) only [Function.onFun]
        rw [Finset.disjoint_left]
        intro q hq1 hq2
        simp only [Finset.mem_biUnion, Finset.mem_image] at hq1 hq2
        obtain ⟨p1, _, c1, _, rfl⟩ := hq1
        obtain ⟨p2, _, c2, _, heq⟩ := hq2
        have : Xi2 = Xi1 := congrArg (fun r => r.2.1) heq
        exact hne this.symm
    · intro ℓ1 _ ℓ2 _ hne
      dsimp (config := { failIfUnchanged := false }) only [Function.onFun]
      rw [Finset.disjoint_left]
      intro q hq1 hq2
      simp only [Finset.mem_biUnion, Finset.mem_image] at hq1 hq2
      obtain ⟨Xi1, _, p1, _, c1, _, rfl⟩ := hq1
      obtain ⟨Xi2, _, p2, _, c2, _, heq⟩ := hq2
      have : ℓ2 = ℓ1 := congrArg Prod.fst heq
      exact hne this.symm

  have h_mem_U :
      ∀ q ∈ U,
        1 ≤ q.1 ∧ q.1 ≤ L ∧
        q.2.1 < (scaleBlocks S P (q.1 - 1)).length ∧
        let X := (scaleBlocks S P (q.1 - 1)).getD q.2.1 (0, 0)
        let subs := splitBlock (S q.1) X.1 X.2
        q.2.2.1 < subs.length - 1 ∧ q.2.2.1 + 1 ≤ q.2.2.2 ∧ q.2.2.2 < subs.length := by
    intro q hq
    simp only [U, Finset.mem_biUnion, Finset.mem_Icc, Finset.mem_range, Finset.mem_Ico,
      Finset.mem_image] at hq
    obtain ⟨ℓ, ⟨hℓ1, hℓL⟩, Xi, hXi, p, hp, c, ⟨hc1, hc2⟩, rfl⟩ := hq
    exact ⟨hℓ1, hℓL, hXi, hp, hc1, hc2⟩

  have h_pair_inj_card :
      ∀ (Q : Finset (ℕ × ℕ × ℕ × ℕ)) (T : Finset ℕ)
        (f : (ℕ × ℕ × ℕ × ℕ) → ℕ) (u_of v_of : ℕ → ℕ),
        Q ⊆ U →
        (∀ q ∈ Q,
          let X := (scaleBlocks S P (q.1 - 1)).getD q.2.1 (0, 0)
          let subs := splitBlock (S q.1) X.1 X.2
          let sp := subs.getD q.2.2.1 (0, 0)
          let sc := subs.getD q.2.2.2 (0, 0)
          f q ∈ T ∧
            sp.1 ≤ u_of (f q) ∧ u_of (f q) < sp.2 ∧
            sc.1 ≤ v_of (f q) ∧ v_of (f q) < sc.2) →
        Q.card ≤ T.card := by
    intro Q T f u_of v_of hQU hQ
    refine Finset.card_le_card_of_injOn f (fun q hq => (hQ q hq).1) ?_
    intro q1 hq1 q2 hq2 hfeq
    rcases q1 with ⟨ℓ1, Xi1, p1, c1⟩
    rcases q2 with ⟨ℓ2, Xi2, p2, c2⟩
    obtain ⟨hℓ1_lo, hℓ1_hi, hXi1, hp1, hc1_lo, hc1_hi⟩ := h_mem_U _ (hQU hq1)
    obtain ⟨hℓ2_lo, hℓ2_hi, hXi2, hp2, hc2_lo, hc2_hi⟩ := h_mem_U _ (hQU hq2)
    obtain ⟨_, hu1_lo, hu1_hi, hv1_lo, hv1_hi⟩ := hQ (ℓ1, Xi1, p1, c1) hq1
    obtain ⟨_, hu2_lo, hu2_hi, hv2_lo, hv2_hi⟩ := hQ (ℓ2, Xi2, p2, c2) hq2
    dsimp (config := { failIfUnchanged := false }) only at hℓ1_lo hℓ1_hi hXi1 hp1 hc1_lo hc1_hi hℓ2_lo hℓ2_hi hXi2 hp2 hc2_lo hc2_hi
    dsimp (config := { failIfUnchanged := false }) only at hu1_lo hu1_hi hv1_lo hv1_hi hu2_lo hu2_hi hv2_lo hv2_hi
    rw [← hfeq] at hu2_lo hu2_hi hv2_lo hv2_hi
    obtain ⟨_, _, hrec1, _⟩ := h_coord_window ℓ1 hℓ1_lo hℓ1_hi Xi1 hXi1
    obtain ⟨_, _, hrec2, _⟩ := h_coord_window ℓ2 hℓ2_lo hℓ2_hi Xi2 hXi2
    obtain ⟨_, _, hsep1, hbi1, hfp1, hfc1⟩ :=
      hrec1 p1 c1 (by omega) hc1_hi _ _ hu1_lo hu1_hi hv1_lo hv1_hi
    obtain ⟨_, _, hsep2, hbi2, hfp2, hfc2⟩ :=
      hrec2 p2 c2 (by omega) hc2_hi _ _ hu2_lo hu2_hi hv2_lo hv2_hi
    have hℓ_eq : ℓ1 = ℓ2 := hsep1.symm.trans hsep2
    subst hℓ_eq
    have hXi_eq : Xi1 = Xi2 := hbi1.symm.trans hbi2
    subst hXi_eq
    have hp_eq : p1 = p2 := hfp1.symm.trans hfp2
    have hc_eq : c1 = c2 := hfc1.symm.trans hfc2
    simp [hp_eq, hc_eq]

  let buckets : Finset ℕ :=
    B_fin_pre S P L kops ∪ B_1_exit S P L kops ∪ B_3_intra S P L kops

  let predB4x : (ℕ × ℕ × ℕ × ℕ) → ℕ → Bool := fun q jid =>
    let X := (scaleBlocks S P (q.1 - 1)).getD q.2.1 (0, 0)
    let subs := splitBlock (S q.1) X.1 X.2
    let sp := subs.getD q.2.2.1 (0, 0)
    let sc := subs.getD q.2.2.2 (0, 0)
    decide (jid ∈ buckets) &&
      match (jumps kops)[jid]? with
      | some ej => decide (sp.1 ≤ ej.s ∧ ej.s < sp.2 ∧ sc.1 ≤ ej.x ∧ ej.x < sc.2)
      | none => false

  let predB4y : (ℕ × ℕ × ℕ × ℕ) → ℕ → Bool := fun q jid =>
    let X := (scaleBlocks S P (q.1 - 1)).getD q.2.1 (0, 0)
    let subs := splitBlock (S q.1) X.1 X.2
    let sp := subs.getD q.2.2.1 (0, 0)
    let sc := subs.getD q.2.2.2 (0, 0)
    decide (jid ∈ buckets) &&
      match (jumps kops)[jid]? with
      | some ej => decide (sp.1 ≤ ej.s ∧ ej.s < sp.2 ∧ sc.1 ≤ ej.y ∧ ej.y < sc.2)
      | none => false

  let Q_A := U.filter (fun q => puqIsClassA S P kops q.1 q.2.1 q.2.2.1 q.2.2.2 = true)
  let Q_B4x := U.filter (fun q => (List.range (jumps kops).length).any (predB4x q) = true)
  let Q_B4y := U.filter (fun q => (List.range (jumps kops).length).any (predB4y q) = true)
  let Q_C1 := U.filter (fun q => puqIsClassC1 S P kops q.1 q.2.1 q.2.2.1 q.2.2.2 = true)
  let Q_C2 := U.filter (fun q => puqIsClassC2 S P kops q.1 q.2.1 q.2.2.1 q.2.2.2 = true)

  have h_chg_sub : Q_chg ⊆ Q_A ∪ Q_B4x ∪ Q_B4y ∪ Q_C1 ∪ Q_C2 := by
    intro q hq
    simp only [Q_chg, Finset.mem_biUnion, Finset.mem_Icc, Finset.mem_range, Finset.mem_Ico,
      Finset.mem_filter, Finset.mem_image] at hq
    obtain ⟨ℓ, hℓ, Xi, hXi, p, hp, c, ⟨hc, hchg⟩, rfl⟩ := hq
    have hqU : (ℓ, Xi, p, c) ∈ U := by
      simp only [U, Finset.mem_biUnion, Finset.mem_Icc, Finset.mem_range, Finset.mem_Ico,
        Finset.mem_image]
      exact ⟨ℓ, hℓ, Xi, hXi, p, hp, c, hc, rfl⟩
    simp only [Q_A, Q_B4x, Q_B4y, Q_C1, Q_C2, Finset.mem_union, Finset.mem_filter]
    unfold puqIsChargedSubblockOmega at hchg
    simp only [Bool.or_eq_true] at hchg
    rcases hchg with ((hA | hB4) | hC1) | hC2
    · exact Or.inl (Or.inl (Or.inl (Or.inl ⟨hqU, hA⟩)))
    · unfold puqIsClassB4Omega at hB4
      dsimp (config := { failIfUnchanged := false }) only at hB4
      rw [List.any_eq_true] at hB4
      obtain ⟨jid, hjid_mem, hjid_pred⟩ := hB4
      rw [Bool.and_eq_true, decide_eq_true_eq] at hjid_pred
      rcases hjid_pred with ⟨hjb, hmatch⟩
      cases hjeq : (jumps kops)[jid]? with
      | none => simp [hjeq] at hmatch
      | some ej =>
        simp only [hjeq, decide_eq_true_eq] at hmatch
        rcases hmatch with ⟨hs1, hs2, hx | hy⟩
        · refine Or.inl (Or.inl (Or.inl (Or.inr ⟨hqU, ?_⟩)))
          rw [List.any_eq_true]
          refine ⟨jid, hjid_mem, ?_⟩
          dsimp (config := { failIfUnchanged := false }) only [predB4x]
          rw [hjeq]
          simp only [Bool.and_eq_true, decide_eq_true_eq]
          exact ⟨hjb, hs1, hs2, hx.1, hx.2⟩
        · refine Or.inl (Or.inl (Or.inr ⟨hqU, ?_⟩))
          rw [List.any_eq_true]
          refine ⟨jid, hjid_mem, ?_⟩
          dsimp (config := { failIfUnchanged := false }) only [predB4y]
          rw [hjeq]
          simp only [Bool.and_eq_true, decide_eq_true_eq]
          exact ⟨hjb, hs1, hs2, hy.1, hy.2⟩
    · exact Or.inl (Or.inr ⟨hqU, hC1⟩)
    · exact Or.inr ⟨hqU, hC2⟩

  have h_card_cover :
      Q_chg.card ≤ Q_A.card + Q_B4x.card + Q_B4y.card + Q_C1.card + Q_C2.card := by
    have h0 := Finset.card_le_card h_chg_sub
    have h1 := Finset.card_union_le (Q_A ∪ Q_B4x ∪ Q_B4y ∪ Q_C1) Q_C2
    have h2 := Finset.card_union_le (Q_A ∪ Q_B4x ∪ Q_B4y) Q_C1
    have h3 := Finset.card_union_le (Q_A ∪ Q_B4x) Q_B4y
    have h4 := Finset.card_union_le Q_A Q_B4x
    omega

  have h_card_B4x : Q_B4x.card ≤ buckets.card := by
    refine h_pair_inj_card Q_B4x buckets
      (fun q => ((List.range (jumps kops).length).find? (predB4x q)).getD 0)
      (fun jid => match (jumps kops)[jid]? with | some ej => ej.s | none => 0)
      (fun jid => match (jumps kops)[jid]? with | some ej => ej.x | none => 0)
      (Finset.filter_subset _ _) ?_
    intro q hq
    rw [Finset.mem_filter] at hq
    obtain ⟨_, hpred⟩ := h_find_of_any _ _ hq.2
    set jid := ((List.range (jumps kops).length).find? (predB4x q)).getD 0
    dsimp (config := { failIfUnchanged := false }) only [predB4x] at hpred ⊢
    rw [Bool.and_eq_true, decide_eq_true_eq] at hpred
    rcases hpred with ⟨hjb, hmatch⟩
    cases hjeq : (jumps kops)[jid]? with
    | none => simp [hjeq] at hmatch
    | some ej =>
      simp only [hjeq, decide_eq_true_eq] at hmatch ⊢
      exact ⟨hjb, hmatch.1, hmatch.2.1, hmatch.2.2.1, hmatch.2.2.2⟩

  have h_card_B4y : Q_B4y.card ≤ buckets.card := by
    refine h_pair_inj_card Q_B4y buckets
      (fun q => ((List.range (jumps kops).length).find? (predB4y q)).getD 0)
      (fun jid => match (jumps kops)[jid]? with | some ej => ej.s | none => 0)
      (fun jid => match (jumps kops)[jid]? with | some ej => ej.y | none => 0)
      (Finset.filter_subset _ _) ?_
    intro q hq
    rw [Finset.mem_filter] at hq
    obtain ⟨_, hpred⟩ := h_find_of_any _ _ hq.2
    set jid := ((List.range (jumps kops).length).find? (predB4y q)).getD 0
    dsimp (config := { failIfUnchanged := false }) only [predB4y] at hpred ⊢
    rw [Bool.and_eq_true, decide_eq_true_eq] at hpred
    rcases hpred with ⟨hjb, hmatch⟩
    cases hjeq : (jumps kops)[jid]? with
    | none => simp [hjeq] at hmatch
    | some ej =>
      simp only [hjeq, decide_eq_true_eq] at hmatch ⊢
      exact ⟨hjb, hmatch.1, hmatch.2.1, hmatch.2.2.1, hmatch.2.2.2⟩

  let predC1 : (ℕ × ℕ × ℕ × ℕ) → ℕ → Bool := fun q trem =>
    let X := (scaleBlocks S P (q.1 - 1)).getD q.2.1 (0, 0)
    let subs := splitBlock (S q.1) X.1 X.2
    let sp := subs.getD q.2.2.1 (0, 0)
    let sc := subs.getD q.2.2.2 (0, 0)
    match kops[trem]? with
    | some (.rslr d) =>
        let H := keyedState kops trem
        let rs := rightSpineTopDownNat H
        let inord := inorderNat H
        let m0 := inord.headD 0
        let v := rs.getD d 0
        decide (d < rs.length ∧ inord ≠ [] ∧ sp.1 ≤ m0 ∧ m0 < sp.2 ∧ sc.1 ≤ v ∧ v < sc.2)
    | _ => false

  have h_card_C1 : Q_C1.card ≤ rslrSteps.card := by
    refine h_pair_inj_card Q_C1 rslrSteps
      (fun q =>
        let X := (scaleBlocks S P (q.1 - 1)).getD q.2.1 (0, 0)
        let subs := splitBlock (S q.1) X.1 X.2
        let sp := subs.getD q.2.2.1 (0, 0)
        ((List.Ico (popStep kops sp.1) (tEmpty kops sp.1 sp.2)).find? (predC1 q)).getD 0)
      (fun t => (inorderNat (keyedState kops t)).headD 0)
      (fun t =>
        match kops[t]? with
        | some (.rslr d) => (rightSpineTopDownNat (keyedState kops t)).getD d 0
        | _ => 0)
      (Finset.filter_subset _ _) ?_
    intro q hq
    rw [Finset.mem_filter] at hq
    have hany : (let X := (scaleBlocks S P (q.1 - 1)).getD q.2.1 (0, 0)
        let subs := splitBlock (S q.1) X.1 X.2
        let sp := subs.getD q.2.2.1 (0, 0)
        (List.Ico (popStep kops sp.1) (tEmpty kops sp.1 sp.2)).any (predC1 q)) = true := hq.2
    dsimp (config := { failIfUnchanged := false }) only at hany ⊢
    obtain ⟨_, hpred⟩ := h_find_of_any _ _ hany
    set trem := ((List.Ico (popStep kops ((splitBlock (S q.1)
      ((scaleBlocks S P (q.1 - 1)).getD q.2.1 (0, 0)).1
      ((scaleBlocks S P (q.1 - 1)).getD q.2.1 (0, 0)).2).getD q.2.2.1 (0, 0)).1)
      (tEmpty kops ((splitBlock (S q.1)
      ((scaleBlocks S P (q.1 - 1)).getD q.2.1 (0, 0)).1
      ((scaleBlocks S P (q.1 - 1)).getD q.2.1 (0, 0)).2).getD q.2.2.1 (0, 0)).1
      ((splitBlock (S q.1)
      ((scaleBlocks S P (q.1 - 1)).getD q.2.1 (0, 0)).1
      ((scaleBlocks S P (q.1 - 1)).getD q.2.1 (0, 0)).2).getD q.2.2.1 (0, 0)).2)).find?
      (predC1 q)).getD 0
    dsimp (config := { failIfUnchanged := false }) only [predC1] at hpred
    cases hk : kops[trem]? with
    | none => simp [hk] at hpred
    | some op =>
      cases op with
      | push w => simp [hk] at hpred
      | pop s => simp [hk] at hpred
      | rslr d =>
        simp only [hk, decide_eq_true_eq] at hpred ⊢
        have ht_lt : trem < kops.length := (List.getElem?_eq_some_iff.mp hk).1
        have hmem_rslr : trem ∈ rslrSteps := by
          dsimp (config := { failIfUnchanged := false }) only [rslrSteps, isRslrAt]
          rw [Finset.mem_filter, hk]
          exact ⟨Finset.mem_range.mpr ht_lt, rfl⟩
        exact ⟨hmem_rslr, hpred.2.2.1, hpred.2.2.2.1, hpred.2.2.2.2.1, hpred.2.2.2.2.2⟩

  let predC2 : (ℕ × ℕ × ℕ × ℕ) → ℕ → Bool := fun q spop =>
    let X := (scaleBlocks S P (q.1 - 1)).getD q.2.1 (0, 0)
    let subs := splitBlock (S q.1) X.1 X.2
    let sc := subs.getD q.2.2.2 (0, 0)
    let tadd := popStep kops spop
    let ls := leftSpineBottomUpNat (keyedState kops tadd)
    let madd := (ls.length - 2) / 2
    let v := ls.getD (2 * madd + 1) 0
    decide (ls.length = 2 * madd + 3 ∧ sc.1 ≤ v ∧ v < sc.2)

  have h_card_C2 : Q_C2.card ≤ P := by
    have hle : Q_C2.card ≤ (Finset.range P).card := by
      refine h_pair_inj_card Q_C2 (Finset.range P)
        (fun q =>
          let X := (scaleBlocks S P (q.1 - 1)).getD q.2.1 (0, 0)
          let subs := splitBlock (S q.1) X.1 X.2
          let sp := subs.getD q.2.2.1 (0, 0)
          ((List.Ico sp.1 sp.2).find? (predC2 q)).getD 0)
        (fun spop => spop)
        (fun spop =>
          let ls := leftSpineBottomUpNat (keyedState kops (popStep kops spop))
          ls.getD (2 * ((ls.length - 2) / 2) + 1) 0)
        (Finset.filter_subset _ _) ?_
      intro q hq
      rw [Finset.mem_filter] at hq
      obtain ⟨hℓ1, hℓL, hXi, hp, hc1, hc2⟩ := h_mem_U q hq.1
      obtain ⟨hcw1, _, _, _⟩ := h_coord_window q.1 hℓ1 hℓL q.2.1 hXi
      dsimp (config := { failIfUnchanged := false }) only at hp hc1 hc2 hcw1 ⊢
      have hp_lt : q.2.2.1 < (splitBlock (S q.1)
          ((scaleBlocks S P (q.1 - 1)).getD q.2.1 (0, 0)).1
          ((scaleBlocks S P (q.1 - 1)).getD q.2.1 (0, 0)).2).length := by omega
      obtain ⟨_, _, hsp_le_X, hX_le_P⟩ := hcw1 q.2.2.1 hp_lt
      have hany : (let X := (scaleBlocks S P (q.1 - 1)).getD q.2.1 (0, 0)
          let subs := splitBlock (S q.1) X.1 X.2
          let sp := subs.getD q.2.2.1 (0, 0)
          (List.Ico sp.1 sp.2).any (predC2 q)) = true := hq.2
      dsimp (config := { failIfUnchanged := false }) only at hany
      obtain ⟨hmem_ico, hpred⟩ := h_find_of_any _ _ hany
      rw [List.Ico.mem] at hmem_ico
      dsimp (config := { failIfUnchanged := false }) only [predC2] at hpred
      rw [decide_eq_true_eq] at hpred
      refine ⟨?_, hmem_ico.1, hmem_ico.2, hpred.2.1, hpred.2.2⟩
      rw [Finset.mem_range]
      omega
    simpa [Finset.card_range] using hle

  let predA : (ℕ × ℕ × ℕ × ℕ) → ℕ → Bool := fun q tev =>
    let X := (scaleBlocks S P (q.1 - 1)).getD q.2.1 (0, 0)
    let subs := splitBlock (S q.1) X.1 X.2
    let hi_p := (subs.getD (q.2.2.1 + 1) (0, 0)).1
    match kops[tev]? with
    | some (.rslr (d + 1)) =>
        let rs := rightSpineTopDownNat (keyedState kops tev)
        let u := rs.getD d 0
        let v := rs.getD (d + 1) 0
        let cu := subs.findIdx (fun b => decide (b.1 ≤ u ∧ u < b.2))
        let cv := subs.findIdx (fun b => decide (b.1 ≤ v ∧ v < b.2))
        decide (d + 1 < rs.length ∧ hi_p ≤ u ∧ u < v ∧ v < X.2 ∧ cu < q.2.2.2 ∧ cv = q.2.2.2)
    | _ => false

  let fA : (ℕ × ℕ × ℕ × ℕ) → ℕ := fun q =>
    let X := (scaleBlocks S P (q.1 - 1)).getD q.2.1 (0, 0)
    let subs := splitBlock (S q.1) X.1 X.2
    let sp := subs.getD q.2.2.1 (0, 0)
    ((List.Ico (popStep kops sp.1) (tEmpty kops sp.1 sp.2)).find? (predA q)).getD 0

  let uA_of : ℕ → ℕ := fun t =>
    match kops[t]? with
    | some (.rslr (d + 1)) => (rightSpineTopDownNat (keyedState kops t)).getD d 0
    | _ => 0

  let vA_of : ℕ → ℕ := fun t =>
    match kops[t]? with
    | some (.rslr (d + 1)) => (rightSpineTopDownNat (keyedState kops t)).getD (d + 1) 0
    | _ => 0

  have hA_prop :
      ∀ q ∈ Q_A,
        let X := (scaleBlocks S P (q.1 - 1)).getD q.2.1 (0, 0)
        let subs := splitBlock (S q.1) X.1 X.2
        let sp := subs.getD q.2.2.1 (0, 0)
        fA q ∈ rslrSteps ∧
          popStep kops sp.1 ≤ fA q ∧ fA q < tEmpty kops sp.1 sp.2 ∧
          sepScale S P L (uA_of (fA q)) (vA_of (fA q)) = q.1 ∧
          blockIdx S P (q.1 - 1) (vA_of (fA q)) = q.2.1 ∧
          subs.findIdx (fun b => decide (b.1 ≤ vA_of (fA q) ∧ vA_of (fA q) < b.2)) = q.2.2.2 := by
    intro q hq
    rw [Finset.mem_filter] at hq
    obtain ⟨hℓ1, hℓL, hXi, hp, hc1, hc2⟩ := h_mem_U q hq.1
    obtain ⟨hcw1, hcw2, hcw3, _⟩ := h_coord_window q.1 hℓ1 hℓL q.2.1 hXi
    dsimp (config := { failIfUnchanged := false }) only at hp hc1 hc2 hcw1 hcw2 hcw3 ⊢
    have hany :
        (let X := (scaleBlocks S P (q.1 - 1)).getD q.2.1 (0, 0)
         let subs := splitBlock (S q.1) X.1 X.2
         let sp := subs.getD q.2.2.1 (0, 0)
         (List.Ico (popStep kops sp.1) (tEmpty kops sp.1 sp.2)).any (predA q)) = true := hq.2
    dsimp (config := { failIfUnchanged := false }) only at hany
    obtain ⟨hmem_ico, hpred⟩ := h_find_of_any _ _ hany
    change fA q ∈ List.Ico
      (popStep kops ((splitBlock (S q.1)
        ((scaleBlocks S P (q.1 - 1)).getD q.2.1 (0, 0)).1
        ((scaleBlocks S P (q.1 - 1)).getD q.2.1 (0, 0)).2).getD q.2.2.1 (0, 0)).1)
      (tEmpty kops ((splitBlock (S q.1)
        ((scaleBlocks S P (q.1 - 1)).getD q.2.1 (0, 0)).1
        ((scaleBlocks S P (q.1 - 1)).getD q.2.1 (0, 0)).2).getD q.2.2.1 (0, 0)).1
        ((splitBlock (S q.1)
        ((scaleBlocks S P (q.1 - 1)).getD q.2.1 (0, 0)).1
        ((scaleBlocks S P (q.1 - 1)).getD q.2.1 (0, 0)).2).getD q.2.2.1 (0, 0)).2) at hmem_ico
    change predA q (fA q) = true at hpred
    rw [List.Ico.mem] at hmem_ico
    dsimp (config := { failIfUnchanged := false }) only [predA] at hpred
    cases hk : kops[fA q]? with
    | none => simp [hk] at hpred
    | some op =>
      cases op with
      | push w => simp [hk] at hpred
      | pop s => simp [hk] at hpred
      | rslr d0 =>
        cases d0 with
        | zero => simp [hk] at hpred
        | succ d =>
          simp only [hk, decide_eq_true_eq] at hpred
          obtain ⟨_, hhip_u, hu_lt_v, hv_lt_X, hcu_lt_c, hcv_eq_c⟩ := hpred
          have ht_lt : fA q < kops.length := (List.getElem?_eq_some_iff.mp hk).1
          have hmem_rslr : fA q ∈ rslrSteps := by
            dsimp (config := { failIfUnchanged := false }) only [rslrSteps, isRslrAt]
            rw [Finset.mem_filter, hk]
            exact ⟨Finset.mem_range.mpr ht_lt, rfl⟩
          have hu_eq : uA_of (fA q) = (rightSpineTopDownNat (keyedState kops (fA q))).getD d 0 := by
            simp [uA_of, hk]
          have hv_eq :
              vA_of (fA q) = (rightSpineTopDownNat (keyedState kops (fA q))).getD (d + 1) 0 := by
            simp [vA_of, hk]
          rw [hu_eq, hv_eq]
          set X := (scaleBlocks S P (q.1 - 1)).getD q.2.1 (0, 0)
          set subs := splitBlock (S q.1) X.1 X.2
          set u := (rightSpineTopDownNat (keyedState kops (fA q))).getD d 0
          set v := (rightSpineTopDownNat (keyedState kops (fA q))).getD (d + 1) 0
          have hp1_lt : q.2.2.1 + 1 < subs.length := by omega
          obtain ⟨hX_le_hip, _, _, _⟩ := hcw1 (q.2.2.1 + 1) hp1_lt
          obtain ⟨_, hu_lo, hu_hi⟩ := hcw2 u (by omega) (by omega)
          obtain ⟨_, hv_lo, hv_hi⟩ := hcw2 v (by omega) (by omega)
          rw [hcv_eq_c] at hv_lo hv_hi
          obtain ⟨_, _, hsep, hbi, _, hfv⟩ :=
            hcw3 _ q.2.2.2 hcu_lt_c hc2 u v hu_lo hu_hi hv_lo hv_hi
          exact ⟨hmem_rslr, hmem_ico.1, hmem_ico.2, hsep, hbi, hfv⟩

  have h_card_A : Q_A.card ≤ rslrSteps.card := by
    refine Finset.card_le_card_of_injOn fA (fun q hq => (hA_prop q hq).1) ?_
    intro q1 hq1 q2 hq2 hfeq
    rcases q1 with ⟨ℓ1, Xi1, p1, c1⟩
    rcases q2 with ⟨ℓ2, Xi2, p2, c2⟩
    obtain ⟨_, hts1, hte1, hsep1, hbi1, hfc1⟩ := hA_prop (ℓ1, Xi1, p1, c1) hq1
    obtain ⟨_, hts2, hte2, hsep2, hbi2, hfc2⟩ := hA_prop (ℓ2, Xi2, p2, c2) hq2
    dsimp (config := { failIfUnchanged := false }) only at hts1 hte1 hsep1 hbi1 hfc1 hts2 hte2 hsep2 hbi2 hfc2
    rw [← hfeq] at hts2 hte2 hsep2 hbi2 hfc2
    have hℓ_eq : ℓ1 = ℓ2 := hsep1.symm.trans hsep2
    subst hℓ_eq
    have hXi_eq : Xi1 = Xi2 := hbi1.symm.trans hbi2
    subst hXi_eq
    have hc_eq : c1 = c2 := hfc1.symm.trans hfc2
    subst hc_eq
    have hQA_sub : Q_A ⊆ U := Finset.filter_subset _ _
    obtain ⟨hℓ1_lo, hℓ1_hi, hXi1, hp1, _, hc1_hi⟩ := h_mem_U _ (hQA_sub hq1)
    obtain ⟨_, _, _, hp2, _, _⟩ := h_mem_U _ (hQA_sub hq2)
    obtain ⟨_, _, _, hwin⟩ := h_coord_window ℓ1 hℓ1_lo hℓ1_hi Xi1 hXi1
    dsimp (config := { failIfUnchanged := false }) only at hp1 hc1_hi hp2 hwin
    have hp1_lt : p1 < (splitBlock (S ℓ1)
        ((scaleBlocks S P (ℓ1 - 1)).getD Xi1 (0, 0)).1
        ((scaleBlocks S P (ℓ1 - 1)).getD Xi1 (0, 0)).2).length := by omega
    have hp2_lt : p2 < (splitBlock (S ℓ1)
        ((scaleBlocks S P (ℓ1 - 1)).getD Xi1 (0, 0)).1
        ((scaleBlocks S P (ℓ1 - 1)).getD Xi1 (0, 0)).2).length := by omega
    have hp_eq : p1 = p2 := by
      by_cases hlt : p1 < p2
      · have hw := hwin p1 p2 hlt hp2_lt
        omega
      · by_cases hgt : p2 < p1
        · have hw := hwin p2 p1 hgt hp1_lt
          omega
        · omega
    simp [hp_eq]

  have h_buckets_card :
      buckets.card ≤
        (B_fin_pre S P L kops).card + (B_1_exit S P L kops).card + (B_3_intra S P L kops).card := by
    have h1 := Finset.card_union_le (B_fin_pre S P L kops ∪ B_1_exit S P L kops) (B_3_intra S P L kops)
    have h2 := Finset.card_union_le (B_fin_pre S P L kops) (B_1_exit S P L kops)
    dsimp (config := { failIfUnchanged := false }) only [buckets]
    omega

  rw [h_sum_eq]
  omega

theorem plug_unborn_quotient_and_gap_breakers_omega (P L : ℕ) (S : ℕ → ℕ) (kops : List KeyedCoreOp)
    (hP : 1 ≤ P) (hL : 1 ≤ L) (hS0 : S 0 = P) (hSL_pos : 1 ≤ S L)
    (hS_step : ∀ ℓ : ℕ, ℓ < L → 2 * S (ℓ + 1) ≤ S ℓ)
    (hkvalid : ValidKeyedCoreSeq P kops) (hjump : PrimalJumpLaws P kops)
    (hfold : ValidFoldedCoreLaws P kops) (hpart : ScalePartitionLawsOmega S P L) :
    ∃ pkgs : ℕ → ℕ → BlockQuotientData,
      (∀ ℓ, 1 ≤ ℓ → ℓ ≤ L → ∀ Xi < (scaleBlocks S P (ℓ - 1)).length,
        let X := (scaleBlocks S P (ℓ - 1)).getD Xi (0, 0)
        let NX := (splitBlock (S ℓ) X.1 X.2).length - 1
        ValidBlockQuotientPkg NX (pkgs ℓ Xi) ∧
          ∀ p < NX, ((pkgs ℓ Xi).F_idx p).length = (MMovSet S P L kops ℓ Xi p).card) ∧
      totalGapWeight S P L pkgs ≤
        2 * (B_fin_pre S P L kops).card + 2 * (B_1_exit S P L kops).card +
          3 * (B_3_intra S P L kops).card + 2 * countKeyedRslr kops + P :=
by
  have hplug : PuqPlugUnbornLaws P kops :=
    plug_unborn_trajectory_laws P kops hP hkvalid hjump hfold
  have hbq : PuqBlockQuotientLaws :=
    block_quotient_and_tamari_step_laws
  refine ⟨fun ℓ Xi => puqConcretePkg S P L kops ℓ Xi, ?_, ?_⟩
  · exact phase_quotient_pkg_and_mover_card_omega P L S kops
      hP hL hS0 hSL_pos hS_step hkvalid hjump hfold hpart hplug hbq
  · have h_sum_le :
        totalGapWeight S P L (fun ℓ Xi => puqConcretePkg S P L kops ℓ Xi) ≤
          (Finset.Icc 1 L).sum (fun ℓ =>
            (Finset.range (scaleBlocks S P (ℓ - 1)).length).sum (fun Xi =>
              let X := (scaleBlocks S P (ℓ - 1)).getD Xi (0, 0)
              let subs := splitBlock (S ℓ) X.1 X.2
              (Finset.range (subs.length - 1)).sum (fun p =>
                ((Finset.Ico (p + 1) subs.length).filter
                  (fun c => puqIsChargedSubblockOmega S P L kops ℓ Xi p c = true)).card))) := by
      unfold totalGapWeight
      refine Finset.sum_le_sum (fun ℓ hℓ => ?_)
      rw [Finset.mem_Icc] at hℓ
      refine Finset.sum_le_sum (fun Xi hXi => ?_)
      rw [Finset.mem_range] at hXi
      refine Finset.sum_le_sum (fun p hp => ?_)
      rw [Finset.mem_range] at hp
      exact single_phase_gap_charged_bound_omega P L S kops
        hP hL hS0 hSL_pos hS_step hkvalid hjump hfold hpart hplug hbq
        ℓ hℓ.1 hℓ.2 Xi hXi p hp
    have h_global :=
      global_charged_subblock_sum_bound_omega P L S kops hP hL hkvalid hjump hpart
    have h_relax :
        2 * (B_fin_pre S P L kops).card + 2 * (B_1_exit S P L kops).card +
          2 * (B_3_intra S P L kops).card + 2 * countKeyedRslr kops + P ≤
        2 * (B_fin_pre S P L kops).card + 2 * (B_1_exit S P L kops).card +
          3 * (B_3_intra S P L kops).card + 2 * countKeyedRslr kops + P :=
      Nat.add_le_add_right
        (Nat.add_le_add_right
          (Nat.add_le_add_left
            (Nat.mul_le_mul_right (B_3_intra S P L kops).card (by decide : 2 ≤ 3)) _) _) _
    exact Nat.le_trans h_sum_le (Nat.le_trans h_global h_relax)

theorem tamari_odd_cascade_and_multiscale_sum_omega
    (h_cascade : GappedCascadeBoundProp)
    (h_row1 : ∀ M : ℕ, 2 ≤ SplayTree.invAckermann M + 1 ∧
      M ≤ SplayTree.ackermann (SplayTree.invAckermann M + 1) 1)
    (P L : ℕ) (S w : ℕ → ℕ) (hP : 1 ≤ P) (hL : 1 ≤ L)
    (hw_pos : ∀ ℓ, 1 ≤ ℓ → ℓ ≤ L → 1 ≤ w ℓ)
    (hw_sum : (Finset.Icc 1 L).sum (fun ℓ => (1 : ℚ) / (w ℓ : ℚ)) ≤ 1)
    (hS_def : ∀ ℓ, 1 ≤ ℓ → ℓ ≤ L →
      S ℓ = 13000 * w ℓ * (SplayTree.invAckermann (2 * S (ℓ - 1)) + 1) ^ 2)
    (hpart : ScalePartitionLawsOmega S P L)
    (pkgs : ℕ → ℕ → BlockQuotientData)
    (hpkgs : ∀ ℓ, 1 ≤ ℓ → ℓ ≤ L → ∀ Xi < (scaleBlocks S P (ℓ - 1)).length,
      let X := (scaleBlocks S P (ℓ - 1)).getD Xi (0, 0)
      ValidBlockQuotientPkg ((splitBlock (S ℓ) X.1 X.2).length - 1) (pkgs ℓ Xi)) :
    25 * totalPkgMovers S P L pkgs ≤ 25 * P + totalGapWeight S P L pkgs :=
by
  have _ := hL
  have h_seq_append : ∀ (Δ' k : ℕ) (t : _root_.BinaryTree Unit) (s1 s2 : List RightRotOp),
      ValidRightRotSeq Δ' k t s1 →
      ValidRightRotSeq Δ' k (execRightRotSeq t s1) s2 →
      ValidRightRotSeq Δ' k t (s1 ++ s2) ∧
        execRightRotSeq t (s1 ++ s2) = execRightRotSeq (execRightRotSeq t s1) s2 ∧
        countGappedCascades (s1 ++ s2) = countGappedCascades s1 + countGappedCascades s2 := by
    intro Δ' k t s1 s2
    induction s1 generalizing t with
    | nil =>
      intro _ hs2
      exact ⟨hs2, rfl, by simp [countGappedCascades]⟩
    | cons op rest ih =>
      intro ⟨hop, hrest⟩ hs2
      obtain ⟨hv, he, hc⟩ := ih (execRightRotOp t op) hrest hs2
      refine ⟨⟨hop, hv⟩, he, ?_⟩
      rcases op with pos | ⟨pos, gaps⟩ <;> simp [countGappedCascades, hc, Nat.add_assoc]

  have h_shift_L : ∀ (Δ' k : ℕ) (l r : _root_.BinaryTree Unit) (s : List RightRotOp),
      ValidRightRotSeq Δ' k l s →
      ValidRightRotSeq Δ' k (.node () l r) (s.map (tocShiftDir .L)) ∧
        execRightRotSeq (.node () l r) (s.map (tocShiftDir .L)) =
          .node () (execRightRotSeq l s) r ∧
        countGappedCascades (s.map (tocShiftDir .L)) = countGappedCascades s := by
    intro Δ' k l r s
    induction s generalizing l with
    | nil =>
      intro _
      exact ⟨trivial, rfl, rfl⟩
    | cons op rest ih =>
      intro ⟨hop, hrest⟩
      have hop' : validRightRotOp Δ' k (.node () l r) (tocShiftDir .L op) := by
        rcases op with pos | ⟨pos, gaps⟩ <;> exact hop
      have hexec' : execRightRotOp (.node () l r) (tocShiftDir .L op) =
          .node () (execRightRotOp l op) r := by
        rcases op with pos | ⟨pos, gaps⟩ <;> rfl
      obtain ⟨hv, he, hc⟩ := ih (execRightRotOp l op) hrest
      refine ⟨⟨hop', ?_⟩, ?_, ?_⟩
      · simpa only [hexec'] using hv
      · simp only [List.map_cons, execRightRotSeq, hexec', he]
      · rcases op with pos | ⟨pos, gaps⟩ <;> simp [tocShiftDir, countGappedCascades, hc]

  have h_shift_R : ∀ (Δ' k : ℕ) (l r : _root_.BinaryTree Unit) (s : List RightRotOp),
      ValidRightRotSeq Δ' k r s →
      ValidRightRotSeq Δ' k (.node () l r) (s.map (tocShiftDir .R)) ∧
        execRightRotSeq (.node () l r) (s.map (tocShiftDir .R)) =
          .node () l (execRightRotSeq r s) ∧
        countGappedCascades (s.map (tocShiftDir .R)) = countGappedCascades s := by
    intro Δ' k l r s
    induction s generalizing r with
    | nil =>
      intro _
      exact ⟨trivial, rfl, rfl⟩
    | cons op rest ih =>
      intro ⟨hop, hrest⟩
      have hop' : validRightRotOp Δ' k (.node () l r) (tocShiftDir .R op) := by
        rcases op with pos | ⟨pos, gaps⟩ <;> exact hop
      have hexec' : execRightRotOp (.node () l r) (tocShiftDir .R op) =
          .node () l (execRightRotOp r op) := by
        rcases op with pos | ⟨pos, gaps⟩ <;> rfl
      obtain ⟨hv, he, hc⟩ := ih (execRightRotOp r op) hrest
      refine ⟨⟨hop', ?_⟩, ?_, ?_⟩
      · simpa only [hexec'] using hv
      · simp only [List.map_cons, execRightRotSeq, hexec', he]
      · rcases op with pos | ⟨pos, gaps⟩ <;> simp [tocShiftDir, countGappedCascades, hc]

  have h_forall_inorder : ∀ (P : ℕ → Prop) (T : _root_.BinaryTree ℕ),
      _root_.SplayDeque.Direct.ForallTree P T ↔ ∀ x ∈ inorderNat T, P x := by
    intro P T
    induction T with
    | nil =>
      simp only [inorderNat, List.not_mem_nil, false_implies, implies_true, iff_true]
      exact _root_.SplayDeque.Direct.ForallTree.left
    | node k l r ihl ihr =>
      constructor
      · intro hft x hx
        cases hft with
        | node _ _ _ hl hk hr =>
          simp [inorderNat] at hx
          rcases hx with hx | rfl | hx
          · exact (ihl.mp hl) x hx
          · exact hk
          · exact (ihr.mp hr) x hx
      · intro hall
        refine _root_.SplayDeque.Direct.ForallTree.node l k r (ihl.mpr ?_) (hall k ?_) (ihr.mpr ?_)
        · intro x hx
          exact hall x (by simp [inorderNat, hx])
        · simp [inorderNat]
        · intro x hx
          exact hall x (by simp [inorderNat, hx])

  have h_rightmost_spec : ∀ (r : _root_.BinaryTree ℕ) (cur : ℕ),
      _root_.SplayDeque.Direct.ForallTree (fun x => cur < x) r →
      _root_.BinaryTree.IsBST r →
      rightmostKeyNat cur r ∈ cur :: inorderNat r ∧
        ∀ z ∈ cur :: inorderNat r, z ≤ rightmostKeyNat cur r := by
    intro r
    induction r with
    | nil =>
      intro cur _ _
      simp [rightmostKeyNat, inorderNat]
    | node rk rl rr _ ihrr =>
      intro cur hgt hbst
      cases hgt with
      | node _ _ _ _ hcur_rk _ =>
        cases hbst using isBSTCases with
        | node _ _ _ hrl_lt hrr_gt _ hrr_bst =>
          obtain ⟨hmem, hle⟩ := ihrr rk hrr_gt hrr_bst
          have hrk_le : rk ≤ rightmostKeyNat rk rr := hle rk (by simp)
          simp only [rightmostKeyNat]
          refine ⟨?_, ?_⟩
          · simp only [List.mem_cons] at hmem
            rcases hmem with hmem | hmem
            · exact List.mem_cons_of_mem cur (by simp [inorderNat, hmem])
            · exact List.mem_cons_of_mem cur (by simp [inorderNat, hmem])
          · intro z hz
            simp [inorderNat] at hz
            rcases hz with rfl | hz | rfl | hz
            · omega
            · have := (h_forall_inorder _ rl).mp hrl_lt z hz
              omega
            · exact hrk_le
            · exact hle z (List.mem_cons_of_mem rk hz)

  have h_smax_spec : ∀ (T : _root_.BinaryTree ℕ) (v : ℕ),
      _root_.BinaryTree.IsBST T → v ∈ inorderNat T →
      v ≤ subtreeMaxNat T v ∧ subtreeMaxNat T v ∈ inorderNat T := by
    intro T
    induction T with
    | nil =>
      intro v _ hv
      simp [inorderNat] at hv
    | node k l r ihl ihr =>
      intro v hbst hv
      cases hbst using isBSTCases with
      | node _ _ _ hl_lt hr_gt hl_bst hr_bst =>
        simp only [inorderNat, List.mem_append, List.mem_singleton] at hv
        by_cases hvk : v < k
        · have hv_l : v ∈ inorderNat l := by
            rcases hv with (hv | rfl) | hv
            · exact hv
            · omega
            · have := (h_forall_inorder _ r).mp hr_gt v hv
              omega
          obtain ⟨h1, h2⟩ := ihl v hl_bst hv_l
          simp only [subtreeMaxNat, hvk, ↓reduceIte]
          exact ⟨h1, by simp [inorderNat, h2]⟩
        · by_cases hkv : k < v
          · have hv_r : v ∈ inorderNat r := by
              rcases hv with (hv | rfl) | hv
              · have := (h_forall_inorder _ l).mp hl_lt v hv
                omega
              · omega
              · exact hv
            obtain ⟨h1, h2⟩ := ihr v hr_bst hv_r
            simp only [subtreeMaxNat, hvk, hkv, ↓reduceIte]
            exact ⟨h1, by simp [inorderNat, h2]⟩
          · have h_eq : v = k := by omega
            subst h_eq
            obtain ⟨hmem, hle⟩ := h_rightmost_spec r v hr_gt hr_bst
            simp only [subtreeMaxNat, lt_irrefl, ↓reduceIte]
            refine ⟨hle v (by simp), ?_⟩
            simp only [List.mem_cons] at hmem
            rcases hmem with hmem | hmem
            · simp [inorderNat, hmem]
            · simp [inorderNat, hmem]

  have h_rot_props : ∀ (a b c : _root_.BinaryTree ℕ) (x y : ℕ),
      _root_.BinaryTree.IsBST (.node y (.node x a b) c) →
      _root_.BinaryTree.IsBST (.node x a (.node y b c)) ∧
        inorderNat (.node x a (.node y b c)) = inorderNat (.node y (.node x a b) c) ∧
        ∀ v : ℕ, subtreeMaxNat (.node x a (.node y b c)) v =
          if v = x then rightmostKeyNat y c else subtreeMaxNat (.node y (.node x a b) c) v := by
    intro a b c x y hbst
    cases hbst using isBSTCases with
    | node _ _ _ hab_lt hc_gt hab_bst hc_bst =>
      cases hab_lt with
      | node _ _ _ _ hxy hb_lt_y =>
        cases hab_bst using isBSTCases with
        | node _ _ _ ha_lt_x hb_gt_x ha_bst hb_bst =>
          have hc_gt_x : _root_.SplayDeque.Direct.ForallTree (fun k => x < k) c := by
            rw [h_forall_inorder] at hc_gt ⊢
            intro z hz
            have := hc_gt z hz
            omega
          have hbst' : _root_.BinaryTree.IsBST (.node x a (.node y b c)) :=
            _root_.BinaryTree.IsBST.node x a (.node y b c) ha_lt_x
              (_root_.SplayDeque.Direct.ForallTree.node b y c hb_gt_x hxy hc_gt_x)
              ha_bst
              (_root_.BinaryTree.IsBST.node y b c hb_lt_y hc_gt hb_bst hc_bst)
          refine ⟨hbst', by simp [inorderNat, List.append_assoc], ?_⟩
          intro v
          by_cases hvx : v < x
          · have hvy : v < y := by omega
            have hvne : v ≠ x := by omega
            simp [subtreeMaxNat, hvx, hvy, hvne]
          · by_cases hxv : x < v
            · have hvne : v ≠ x := by omega
              by_cases hvy : v < y
              · simp [subtreeMaxNat, hvx, hxv, hvy, hvne]
              · by_cases hyv : y < v
                · simp [subtreeMaxNat, hvx, hxv, hvy, hyv, hvne]
                · have hveqy : v = y := by omega
                  subst hveqy
                  simp [subtreeMaxNat, hvx, hxv, hvne]
            · have hveqx : v = x := by omega
              subst hveqx
              simp [subtreeMaxNat, rightmostKeyNat]

  have h_liftToRoot : ∀ (Δ' k : ℕ) (S : _root_.BinaryTree ℕ) (target : ℕ),
      _root_.BinaryTree.IsBST S →
      target ∈ inorderNat S →
      (∀ z ∈ inorderNat S, z < target → subtreeMaxNat S z < target) →
      ∃ (A B : _root_.BinaryTree ℕ) (ops : List RightRotOp),
        _root_.BinaryTree.IsBST (.node target A B) ∧
        inorderNat (.node target A B) = inorderNat S ∧
        (∀ v, v ≠ target → subtreeMaxNat (.node target A B) v = subtreeMaxNat S v) ∧
        ValidRightRotSeq Δ' k (eraseNatKeys S) ops ∧
        execRightRotSeq (eraseNatKeys S) ops = eraseNatKeys (.node target A B) ∧
        countGappedCascades ops = 0 := by
    intro Δ' k S
    induction S with
    | nil =>
      intro target _ hmem _
      simp [inorderNat] at hmem
    | node r1 l R1 ihl _ =>
      intro target hbst hmem hdom
      cases hbst using isBSTCases with
      | node _ _ _ hl_lt hr_gt hl_bst hr_bst =>
        by_cases htr : target < r1
        · have hmem_l : target ∈ inorderNat l := by
            simp only [inorderNat, List.mem_append, List.mem_singleton] at hmem
            rcases hmem with (hmem | rfl) | hmem
            · exact hmem
            · omega
            · have := (h_forall_inorder _ R1).mp hr_gt target hmem
              omega
          have hdom_l : ∀ z ∈ inorderNat l, z < target → subtreeMaxNat l z < target := by
            intro z hz hzt
            have hzr1 : z < r1 := by omega
            have hzS : z ∈ inorderNat (.node r1 l R1) := by simp [inorderNat, hz]
            have h1 := hdom z hzS hzt
            simpa [subtreeMaxNat, hzr1] using h1
          obtain ⟨A0, B0, l_ops, hbst0, hin0, hmax0, hval0, hexec0, hcnt0⟩ :=
            ihl target hl_bst hmem_l hdom_l
          have hmid_lt : _root_.SplayDeque.Direct.ForallTree (fun x => x < r1) (.node target A0 B0) := by
            rw [h_forall_inorder, hin0, ← h_forall_inorder]
            exact hl_lt
          have hmid_bst : _root_.BinaryTree.IsBST (.node r1 (.node target A0 B0) R1) :=
            _root_.BinaryTree.IsBST.node r1 (.node target A0 B0) R1 hmid_lt hr_gt hbst0 hr_bst
          obtain ⟨hbst_rot, hin_rot, hmax_rot⟩ := h_rot_props A0 B0 R1 target r1 hmid_bst
          obtain ⟨hvalL, hexecL, hcntL⟩ :=
            h_shift_L Δ' k (eraseNatKeys l) (eraseNatKeys R1) l_ops hval0
          set t_mid := execRightRotSeq (eraseNatKeys (.node r1 l R1))
            (l_ops.map (tocShiftDir .L))
          have ht_mid_eq : t_mid =
              .node () (.node () (eraseNatKeys A0) (eraseNatKeys B0)) (eraseNatKeys R1) := by
            simpa [t_mid, eraseNatKeys, hexec0] using hexecL
          have hsingle_val : ValidRightRotSeq Δ' k t_mid [.single []] := by
            rw [ht_mid_eq]
            refine ⟨?_, trivial⟩
            simp only [validRightRotOp, subtreeAtPos, leftSpineLen]
            omega
          obtain ⟨hval_tot, hexec_tot, hcnt_tot⟩ :=
            h_seq_append Δ' k (eraseNatKeys (.node r1 l R1))
              (l_ops.map (tocShiftDir .L)) [.single []] hvalL hsingle_val
          refine ⟨A0, .node r1 B0 R1, l_ops.map (tocShiftDir .L) ++ [.single []],
            hbst_rot, ?_, ?_, hval_tot, ?_, ?_⟩
          · rw [hin_rot]
            change inorderNat (.node target A0 B0) ++ [r1] ++ inorderNat R1 =
              inorderNat l ++ [r1] ++ inorderNat R1
            rw [hin0]
          · intro v hvne
            rw [hmax_rot v, if_neg hvne]
            by_cases hvr1 : v < r1
            · change (if v < r1 then subtreeMaxNat (.node target A0 B0) v else _) =
                (if v < r1 then subtreeMaxNat l v else _)
              simp only [hvr1, ↓reduceIte]
              exact hmax0 v hvne
            · simp [subtreeMaxNat, hvr1]
          · rw [hexec_tot]
            change execRightRotSeq t_mid [.single []] = _
            rw [ht_mid_eq]
            rfl
          · simp [hcnt_tot, hcntL, hcnt0, countGappedCascades]
        · by_cases hrt : r1 < target
          · exfalso
            have hmem_R1 : target ∈ inorderNat R1 := by
              simp only [inorderNat, List.mem_append, List.mem_singleton] at hmem
              rcases hmem with (hmem | rfl) | hmem
              · have := (h_forall_inorder _ l).mp hl_lt target hmem
                omega
              · omega
              · exact hmem
            obtain ⟨_, hle⟩ := h_rightmost_spec R1 r1 hr_gt hr_bst
            have h1 : target ≤ rightmostKeyNat r1 R1 := hle target (List.mem_cons_of_mem r1 hmem_R1)
            have hr1_mem : r1 ∈ inorderNat (.node r1 l R1) := by simp [inorderNat]
            have h2 := hdom r1 hr1_mem hrt
            simp only [subtreeMaxNat, lt_irrefl, ↓reduceIte] at h2
            omega
          · have h_eq : target = r1 := by omega
            subst h_eq
            refine ⟨l, R1, [],
              _root_.BinaryTree.IsBST.node target l R1 hl_lt hr_gt hl_bst hr_bst,
              rfl, (fun _ _ => rfl), trivial, rfl, rfl⟩

  have h_split_unique : ∀ (r : ℕ) (xs1 ys1 xs2 ys2 : List ℕ),
      r ∉ xs1 → r ∉ xs2 →
      xs1 ++ [r] ++ ys1 = xs2 ++ [r] ++ ys2 →
      xs1 = xs2 ∧ ys1 = ys2 := by
    intro r xs1 ys1
    induction xs1 with
    | nil =>
      intro xs2 ys2 _ hnot2 heq
      rcases xs2 with _ | ⟨b, xs2'⟩
      · simp at heq
        exact ⟨rfl, heq⟩
      · simp only [List.nil_append, List.cons_append, List.cons.injEq] at heq
        exfalso
        exact hnot2 (by simp [heq.1])
    | cons a xs1' ih =>
      intro xs2 ys2 hnot1 hnot2 heq
      rcases xs2 with _ | ⟨b, xs2'⟩
      · simp only [List.cons_append, List.nil_append, List.cons.injEq] at heq
        exfalso
        exact hnot1 (by simp [heq.1])
      · simp only [List.cons_append, List.cons.injEq] at heq
        obtain ⟨rfl, hrest⟩ := heq
        obtain ⟨h1, h2⟩ := ih xs2' ys2 (fun h => hnot1 (List.mem_cons_of_mem a h))
          (fun h => hnot2 (List.mem_cons_of_mem a h)) hrest
        exact ⟨congrArg (List.cons a) h1, h2⟩

  have h_tamari : ∀ (Δ' k : ℕ) (T1 T2 : _root_.BinaryTree ℕ),
      _root_.BinaryTree.IsBST T1 → _root_.BinaryTree.IsBST T2 →
      inorderNat T1 = inorderNat T2 →
      (∀ c ∈ inorderNat T1, subtreeMaxNat T1 c ≤ subtreeMaxNat T2 c) →
      ∃ seq : List RightRotOp,
        ValidRightRotSeq Δ' k (eraseNatKeys T1) seq ∧
        execRightRotSeq (eraseNatKeys T1) seq = eraseNatKeys T2 ∧
        countGappedCascades seq = 0 := by
    intro Δ' k T1 T2 hbst1 hbst2 hin hdom
    induction T2 generalizing T1 with
    | nil =>
      rcases T1 with _ | ⟨k1, l1, r1⟩
      · exact ⟨[], trivial, rfl, rfl⟩
      · exfalso
        have hk1 : k1 ∈ inorderNat (.node k1 l1 r1) := by simp [inorderNat]
        rw [hin] at hk1
        simp [inorderNat] at hk1
    | node r2 L2 R2 ihL ihR =>
      cases hbst2 using isBSTCases with
      | node _ _ _ hL2_lt hR2_gt hL2_bst hR2_bst =>
        have hr2_mem : r2 ∈ inorderNat T1 := by
          rw [hin]
          simp [inorderNat]
        have hr2_dom : ∀ z ∈ inorderNat T1, z < r2 → subtreeMaxNat T1 z < r2 := by
          intro z hz1 hzr2
          have hz2 : z ∈ inorderNat (.node r2 L2 R2) := hin ▸ hz1
          have hz_L2 : z ∈ inorderNat L2 := by
            simp only [inorderNat, List.mem_append, List.mem_singleton] at hz2
            rcases hz2 with (hz2 | rfl) | hz2
            · exact hz2
            · omega
            · have := (h_forall_inorder _ R2).mp hR2_gt z hz2
              omega
          obtain ⟨_, hmem_max⟩ := h_smax_spec L2 z hL2_bst hz_L2
          have hlt_max : subtreeMaxNat L2 z < r2 :=
            (h_forall_inorder _ L2).mp hL2_lt _ hmem_max
          have hle_dom := hdom z hz1
          simp only [subtreeMaxNat, hzr2, ↓reduceIte] at hle_dom
          omega
        obtain ⟨A, B, up_ops, hbstAB, hinAB, hmaxAB, hval_up, hexec_up, hcnt_up⟩ :=
          h_liftToRoot Δ' k T1 r2 hbst1 hr2_mem hr2_dom
        cases hbstAB using isBSTCases with
        | node _ _ _ hA_lt hB_gt hA_bst hB_bst =>
          have hr2_not_A : r2 ∉ inorderNat A := by
            intro h
            have := (h_forall_inorder _ A).mp hA_lt r2 h
            omega
          have hr2_not_L2 : r2 ∉ inorderNat L2 := by
            intro h
            have := (h_forall_inorder _ L2).mp hL2_lt r2 h
            omega
          have hin_eq : inorderNat A ++ [r2] ++ inorderNat B =
              inorderNat L2 ++ [r2] ++ inorderNat R2 := by
            simpa only [inorderNat] using hinAB.trans hin
          obtain ⟨hinA, hinB⟩ :=
            h_split_unique r2 (inorderNat A) (inorderNat B) (inorderNat L2) (inorderNat R2)
              hr2_not_A hr2_not_L2 hin_eq
          have hdomA : ∀ c ∈ inorderNat A, subtreeMaxNat A c ≤ subtreeMaxNat L2 c := by
            intro c hc
            have hcr2 : c < r2 := (h_forall_inorder _ A).mp hA_lt c hc
            have hcne : c ≠ r2 := by omega
            have hc1 : c ∈ inorderNat T1 := by
              rw [← hinAB]
              simp [inorderNat, hc]
            have h1 := hmaxAB c hcne
            have h2 := hdom c hc1
            simp only [subtreeMaxNat, hcr2, ↓reduceIte] at h1 h2
            omega
          have hdomB : ∀ c ∈ inorderNat B, subtreeMaxNat B c ≤ subtreeMaxNat R2 c := by
            intro c hc
            have hr2c : r2 < c := (h_forall_inorder _ B).mp hB_gt c hc
            have hncr2 : ¬(c < r2) := by omega
            have hcne : c ≠ r2 := by omega
            have hc1 : c ∈ inorderNat T1 := by
              rw [← hinAB]
              simp [inorderNat, hc]
            have h1 := hmaxAB c hcne
            have h2 := hdom c hc1
            simp only [subtreeMaxNat, hncr2, hr2c, ↓reduceIte] at h1 h2
            omega
          obtain ⟨seqL, hvalL, hexecL, hcntL⟩ := ihL A hA_bst hL2_bst hinA hdomA
          obtain ⟨seqR, hvalR, hexecR, hcntR⟩ := ihR B hB_bst hR2_bst hinB hdomB
          obtain ⟨hvL, heL, hcL⟩ :=
            h_shift_L Δ' k (eraseNatKeys A) (eraseNatKeys B) seqL hvalL
          obtain ⟨hvR, heR, hcR⟩ :=
            h_shift_R Δ' k (eraseNatKeys L2) (eraseNatKeys B) seqR hvalR
          have hv12_mid : ValidRightRotSeq Δ' k
              (execRightRotSeq (eraseNatKeys T1) up_ops) (seqL.map (tocShiftDir .L)) := by
            simpa only [hexec_up, eraseNatKeys] using hvL
          obtain ⟨hv12, he12, hc12⟩ := h_seq_append Δ' k (eraseNatKeys T1)
            up_ops (seqL.map (tocShiftDir .L)) hval_up hv12_mid
          have he12_val : execRightRotSeq (eraseNatKeys T1)
              (up_ops ++ seqL.map (tocShiftDir .L)) =
              .node () (eraseNatKeys L2) (eraseNatKeys B) := by
            rw [he12, hexec_up]
            simpa only [eraseNatKeys, hexecL] using heL
          have hv123_mid : ValidRightRotSeq Δ' k
              (execRightRotSeq (eraseNatKeys T1) (up_ops ++ seqL.map (tocShiftDir .L)))
              (seqR.map (tocShiftDir .R)) := by
            simpa only [he12_val] using hvR
          obtain ⟨hv123, he123, hc123⟩ := h_seq_append Δ' k (eraseNatKeys T1)
            (up_ops ++ seqL.map (tocShiftDir .L)) (seqR.map (tocShiftDir .R))
            hv12 hv123_mid
          refine ⟨(up_ops ++ seqL.map (tocShiftDir .L)) ++ seqR.map (tocShiftDir .R),
            hv123, ?_, ?_⟩
          · rw [he123, he12_val, heR, hexecR]
            rfl
          · omega

  have h_restrict_id : ∀ (lo hi : ℕ) (r : _root_.BinaryTree ℕ),
      _root_.SplayDeque.Direct.ForallTree (fun x => lo ≤ x ∧ x < hi) r →
      restrictRangeNat lo hi r = r := by
    intro lo hi r
    induction r with
    | nil =>
      intro _
      rfl
    | node rk rl rr ihl ihr =>
      intro hft
      cases hft with
      | node _ _ _ hl hmid hr =>
        have h1 : ¬(rk < lo) := by omega
        have h2 : ¬(hi ≤ rk) := by omega
        simp [restrictRangeNat, h1, h2, ihl hl, ihr hr]

  have h_smax_restrict : ∀ (lo hi c : ℕ) (S : _root_.BinaryTree ℕ),
      _root_.BinaryTree.IsBST S →
      _root_.SplayDeque.Direct.ForallTree (fun x => x < hi) S →
      lo ≤ c →
      subtreeMaxNat (restrictRangeNat lo hi S) c = subtreeMaxNat S c := by
    intro lo hi c S hbst hhi hloc
    induction S with
    | nil => rfl
    | node k l r ihl ihr =>
      cases hbst using isBSTCases with
      | node _ _ _ hl_lt hr_gt hl_bst hr_bst =>
        cases hhi with
        | node _ _ _ hl_hi hk_hi hr_hi =>
          by_cases hklo : k < lo
          · have hkc : k < c := by omega
            have hnck : ¬(c < k) := by omega
            simp [restrictRangeNat, hklo, subtreeMaxNat, hnck, hkc, ihr hr_bst hr_hi]
          · have hnhi : ¬(hi ≤ k) := by omega
            simp only [restrictRangeNat, hklo, hnhi, ↓reduceIte]
            by_cases hck : c < k
            · simp [subtreeMaxNat, hck, ihl hl_bst hl_hi]
            · by_cases hkc : k < c
              · simp [subtreeMaxNat, hck, hkc, ihr hr_bst hr_hi]
              · have h_eq : c = k := by omega
                subst h_eq
                have hr_both : _root_.SplayDeque.Direct.ForallTree (fun x => lo ≤ x ∧ x < hi) r := by
                  rw [h_forall_inorder]
                  intro x hx
                  have h1 := (h_forall_inorder _ r).mp hr_gt x hx
                  have h2 := (h_forall_inorder _ r).mp hr_hi x hx
                  omega
                simp [subtreeMaxNat, h_restrict_id lo hi r hr_both]

  have h_phase_step : ∀ (Δ' k p N_X : ℕ) (T_end T_next : _root_.BinaryTree ℕ),
      p + 1 < N_X → _root_.BinaryTree.IsBST T_end → _root_.BinaryTree.IsBST T_next →
      inorderNat T_end = List.Ico (p + 1) (N_X + 1) →
      inorderNat T_next = List.Ico (p + 2) (N_X + 1) →
      (∀ c, p + 2 ≤ c → c ≤ N_X →
        subtreeMaxNat (restrictRangeNat (p + 2) (N_X + 1) T_end) c ≤ subtreeMaxNat T_next c) →
      ∃ seq : List RightRotOp,
        ValidRightRotSeq Δ' k (eraseNatKeys T_end) seq ∧
        execRightRotSeq (eraseNatKeys T_end) seq = .node () .nil (eraseNatKeys T_next) ∧
        countGappedCascades seq = 0 := by
    intro Δ' k p N_X T_end T_next hp hbst_end hbst_next hin_end hin_next hdom
    have hp_mem : p + 1 ∈ inorderNat T_end := by
      rw [hin_end, List.Ico.mem]
      omega
    have hp_dom : ∀ z ∈ inorderNat T_end, z < p + 1 → subtreeMaxNat T_end z < p + 1 := by
      intro z hz hlt
      rw [hin_end, List.Ico.mem] at hz
      omega
    obtain ⟨A, B, up_ops, hbstAB, hinAB, hmaxAB, hval_up, hexec_up, hcnt_up⟩ :=
      h_liftToRoot Δ' k T_end (p + 1) hbst_end hp_mem hp_dom
    cases hbstAB using isBSTCases with
    | node _ _ _ hA_lt _ _ hB_bst =>
      have hA_empty : A = .nil := by
        rcases A with _ | ⟨ak, al, ar⟩
        · rfl
        · exfalso
          have hak_A : ak ∈ inorderNat (.node ak al ar) := by simp [inorderNat]
          have hak_lt : ak < p + 1 := (h_forall_inorder _ _).mp hA_lt ak hak_A
          have hak_AB : ak ∈ inorderNat (.node (p + 1) (.node ak al ar) B) := by
            simp [inorderNat]
          rw [hinAB, hin_end, List.Ico.mem] at hak_AB
          omega
      subst hA_empty
      have hinB : inorderNat B = inorderNat T_next := by
        have hcons : List.Ico (p + 1) (N_X + 1) = (p + 1) :: List.Ico (p + 2) (N_X + 1) :=
          List.Ico.eq_cons (by omega)
        have h1 : (p + 1) :: inorderNat B = (p + 1) :: List.Ico (p + 2) (N_X + 1) := by
          simpa [inorderNat, hcons] using hinAB.trans hin_end
        have h2 : inorderNat B = List.Ico (p + 2) (N_X + 1) := (List.cons.injEq _ _ _ _).mp h1 |>.2
        exact h2.trans hin_next.symm
      have hhi_end : _root_.SplayDeque.Direct.ForallTree (fun x => x < N_X + 1) T_end := by
        rw [h_forall_inorder, hin_end]
        intro x hx
        rw [List.Ico.mem] at hx
        exact hx.2
      have hdomB : ∀ c ∈ inorderNat B, subtreeMaxNat B c ≤ subtreeMaxNat T_next c := by
        intro c hc
        have hc_ico : c ∈ List.Ico (p + 2) (N_X + 1) := by rwa [hinB, hin_next] at hc
        rw [List.Ico.mem] at hc_ico
        have hcne : c ≠ p + 1 := by omega
        have hncp : ¬(c < p + 1) := by omega
        have hpc : p + 1 < c := by omega
        have h1 := hmaxAB c hcne
        simp only [subtreeMaxNat, hncp, hpc, ↓reduceIte] at h1
        have h2 := h_smax_restrict (p + 2) (N_X + 1) c T_end hbst_end hhi_end hc_ico.1
        have h3 := hdom c hc_ico.1 (by omega)
        omega
      obtain ⟨rem_ops, hval_rem, hexec_rem, hcnt_rem⟩ :=
        h_tamari Δ' k B T_next hB_bst hbst_next hinB hdomB
      obtain ⟨hvR, heR, hcR⟩ := h_shift_R Δ' k .nil (eraseNatKeys B) rem_ops hval_rem
      have hv_mid : ValidRightRotSeq Δ' k
          (execRightRotSeq (eraseNatKeys T_end) up_ops) (rem_ops.map (tocShiftDir .R)) := by
        simpa only [hexec_up, eraseNatKeys] using hvR
      obtain ⟨hv_tot, he_tot, hc_tot⟩ :=
        h_seq_append Δ' k (eraseNatKeys T_end) up_ops (rem_ops.map (tocShiftDir .R))
          hval_up hv_mid
      refine ⟨up_ops ++ rem_ops.map (tocShiftDir .R), hv_tot, ?_, by omega⟩
      rw [he_tot, hexec_up]
      simpa only [eraseNatKeys, hexec_rem] using heR

  have h_erase_nodes : ∀ T : _root_.BinaryTree ℕ,
      (eraseNatKeys T).num_nodes = (inorderNat T).length := by
    intro T
    induction T with
    | nil => rfl
    | node k l r ihl ihr =>
      simp only [eraseNatKeys, _root_.BinaryTree.num_nodes, inorderNat, List.length_append,
        List.length_singleton, ihl, ihr]
      omega

  have h_phase_chain : ∀ (h_cascade : GappedCascadeBoundProp) (i Δ' N_X : ℕ)
       (G_init : ℕ → _root_.BinaryTree ℕ) (c : ℕ → ℕ),
      2 ≤ i → 1 ≤ N_X → N_X ≤ ackermann i 1 →
      inorderNat (G_init 0) = List.Ico 1 (N_X + 1) →
      (∀ p, p + 1 < N_X →
        ∃ seq_p : List RightRotOp,
          ValidRightRotSeq Δ' (2 * i) (eraseNatKeys (G_init p)) seq_p ∧
          execRightRotSeq (eraseNatKeys (G_init p)) seq_p =
            .node () .nil (eraseNatKeys (G_init (p + 1))) ∧
          countGappedCascades seq_p = c p) →
      (∃ seq_last : List RightRotOp,
        ValidRightRotSeq Δ' (2 * i) (eraseNatKeys (G_init (N_X - 1))) seq_last ∧
        countGappedCascades seq_last = c (N_X - 1)) →
      (Finset.range N_X).sum c ≤ 8 * (Δ' + 4) * N_X := by
    intro h_cascade i Δ' N_X G_init c hi hNX hNX_ack hin0 hstep hlast
    have h_suf : ∀ d : ℕ, d < N_X →
        ∃ seq_suf : List RightRotOp,
          ValidRightRotSeq Δ' (2 * i) (eraseNatKeys (G_init (N_X - 1 - d))) seq_suf ∧
          countGappedCascades seq_suf = (Finset.Ico (N_X - 1 - d) N_X).sum c := by
      intro d
      induction d with
      | zero =>
        intro _
        obtain ⟨seq_last, hval_last, hcnt_last⟩ := hlast
        refine ⟨seq_last, by simpa using hval_last, ?_⟩
        have h_ico : (Finset.Ico (N_X - 1) N_X).sum c = c (N_X - 1) := by
          rw [Finset.sum_eq_sum_Ico_succ_bot (by omega) c]
          have h_emp : Finset.Ico (N_X - 1 + 1) N_X = ∅ := by
            have : N_X - 1 + 1 = N_X := by omega
            rw [this, Finset.Ico_self]
          simp [h_emp]
        simpa [h_ico] using hcnt_last
      | succ d ih =>
        intro hd1
        set p := N_X - 1 - (d + 1)
        have hp1_eq : N_X - 1 - d = p + 1 := by omega
        have hp1_lt : p + 1 < N_X := by omega
        obtain ⟨seq_p, hval_p, hexec_p, hcnt_p⟩ := hstep p hp1_lt
        obtain ⟨seq_rest, hval_rest, hcnt_rest⟩ := ih (by omega)
        rw [hp1_eq] at hval_rest hcnt_rest
        obtain ⟨hvR, _, hcR⟩ :=
          h_shift_R Δ' (2 * i) .nil (eraseNatKeys (G_init (p + 1))) seq_rest hval_rest
        have hv_mid : ValidRightRotSeq Δ' (2 * i)
            (execRightRotSeq (eraseNatKeys (G_init p)) seq_p)
            (seq_rest.map (tocShiftDir .R)) := by
          simpa only [hexec_p] using hvR
        obtain ⟨hv_tot, _, hc_tot⟩ := h_seq_append Δ' (2 * i)
          (eraseNatKeys (G_init p)) seq_p (seq_rest.map (tocShiftDir .R)) hval_p hv_mid
        refine ⟨seq_p ++ seq_rest.map (tocShiftDir .R), hv_tot, ?_⟩
        rw [hc_tot, hcnt_p, hcR, hcnt_rest, ← Finset.sum_eq_sum_Ico_succ_bot (by omega) c]
    obtain ⟨seq_X, hval_X, hcnt_X⟩ := h_suf (N_X - 1) (by omega)
    have h0_eq : N_X - 1 - (N_X - 1) = 0 := by omega
    rw [h0_eq] at hval_X hcnt_X
    rw [← Finset.range_eq_Ico] at hcnt_X
    have hnodes0 : (eraseNatKeys (G_init 0)).num_nodes = N_X := by
      rw [h_erase_nodes, hin0, List.Ico.length]
      omega
    have hbound := h_cascade i Δ' N_X (eraseNatKeys (G_init 0)) seq_X hi hNX hNX_ack hnodes0 hval_X
    omega

  have h_mod2 : ∀ (i Δ : ℕ), 2 ≤ i → 100 * i + 2 ≤ Δ →
      ∀ (T_init T_end : _root_.BinaryTree ℕ),
        _root_.BinaryTree.IsBST T_init →
        inorderNat T_init = inorderNat T_end →
        (∀ c ∈ inorderNat T_init, subtreeMaxNat T_init c ≤ subtreeMaxNat T_end c) →
        ∀ (F U : List ℕ),
          List.Pairwise (· < ·) F →
          (∀ ia ∈ F, ia + 1 < (leftSpineBottomUpNat T_init).length) →
          (∀ ia ∈ F,
            subtreeMaxNat T_init ((leftSpineBottomUpNat T_init).getD (ia + 1) 0) ≤
              subtreeMaxNat T_end ((leftSpineBottomUpNat T_init).getD ia 0)) →
          U.length = F.length - 1 →
          (∀ r, r + 1 < F.length →
            F.getD (r + 1) 0 - F.getD r 0 - 1 ≤ 3 + U.getD r 0) →
          ∃ (G_odd : _root_.BinaryTree ℕ) (seq_odd : List RightRotOp),
            _root_.BinaryTree.IsBST G_odd ∧
            inorderNat G_odd = inorderNat T_end ∧
            (∀ c ∈ inorderNat G_odd, subtreeMaxNat G_odd c ≤ subtreeMaxNat T_end c) ∧
            ValidRightRotSeq (2 * Δ) (2 * i) (eraseNatKeys T_init) seq_odd ∧
            execRightRotSeq (eraseNatKeys T_init) seq_odd = eraseNatKeys G_odd ∧
            25 * F.length ≤ 100 * i * countGappedCascades seq_odd + 100 * i + U.sum := by
    intro i Δ hi hΔ T_init T_end hbst_init hin_eq hreach_mono F U hF_mono hF_lt hrun_dom hU_len hgap_b
    have h_seq_split : ∀ (Δ' k : ℕ) (t : _root_.BinaryTree Unit) (s1 s2 : List RightRotOp),
        ValidRightRotSeq Δ' k t (s1 ++ s2) →
        ValidRightRotSeq Δ' k t s1 ∧
          ValidRightRotSeq Δ' k (execRightRotSeq t s1) s2 ∧
          execRightRotSeq t (s1 ++ s2) = execRightRotSeq (execRightRotSeq t s1) s2 := by
      intro Δ' k t s1 s2
      induction s1 generalizing t with
      | nil =>
        intro h
        exact ⟨trivial, h, rfl⟩
      | cons op rest ih =>
        intro ⟨hop, hrest⟩
        obtain ⟨hv1, hv2, he⟩ := ih (execRightRotOp t op) hrest
        exact ⟨⟨hop, hv1⟩, hv2, he⟩

    have h_spine_aux : ∀ (t : _root_.BinaryTree ℕ) (acc : List ℕ),
        leftSpineBottomUpAux t acc = leftSpineBottomUpNat t ++ acc := by
      intro t
      induction t with
      | nil => intro acc; rfl
      | node k l r ihl =>
        intro acc
        simp only [leftSpineBottomUpNat, leftSpineBottomUpAux]
        rw [ihl (k :: acc), ihl [k]]
        simp

    have h_getD_append_left : ∀ (xs ys : List ℕ) (r : ℕ),
        r < xs.length → (xs ++ ys).getD r 0 = xs.getD r 0 := by
      intro xs ys r hr
      induction xs generalizing r with
      | nil => simp at hr
      | cons x xs' ih =>
        rcases r with _ | r'
        · simp [List.getD]
        · simp only [List.length_cons] at hr
          simp only [List.cons_append, List.getD, List.getElem?_cons_succ]
          exact ih r' (by omega)

    have h_getD_append_right : ∀ (xs ys : List ℕ) (r : ℕ),
        (xs ++ ys).getD (xs.length + r) 0 = ys.getD r 0 := by
      intro xs ys r
      induction xs with
      | nil => simp
      | cons x xs' ih =>
        have heq : (x :: xs').length + r = (xs'.length + r) + 1 := by simp; omega
        rw [heq]
        simp only [List.cons_append, List.getD, List.getElem?_cons_succ]
        exact ih

    have h_agree_refl : ∀ (T : _root_.BinaryTree ℕ),
        tocAgreeAboveLeftDepth (leftSpineBottomUpNat T).length T T := by
      intro T
      induction T with
      | nil => trivial
      | node k l r ihl =>
        have hsp : leftSpineBottomUpNat (.node k l r) = leftSpineBottomUpNat l ++ [k] :=
          h_spine_aux l [k]
        rw [hsp, List.length_append, List.length_singleton]
        exact ⟨rfl, rfl, ihl⟩

    have h_agree_mono : ∀ (m1 m2 : ℕ) (T G : _root_.BinaryTree ℕ),
        m1 ≤ m2 → tocAgreeAboveLeftDepth m2 T G → tocAgreeAboveLeftDepth m1 T G := by
      intro m1
      induction m1 with
      | zero => intro _ _ _ _ _; trivial
      | succ m1' ih =>
        intro m2 T G hle hagree
        rcases m2 with _ | m2'
        · omega
        · rcases T with _ | ⟨k1, l1, r1⟩
          · exact False.elim hagree
          · rcases G with _ | ⟨k2, l2, r2⟩
            · exact False.elim hagree
            · obtain ⟨hk, hr, hsub⟩ := hagree
              exact ⟨hk, hr, ih m2' l1 l2 (by omega) hsub⟩

    have h_rot_at_depth : ∀ (Δ' k d idx : ℕ) (T_init G : _root_.BinaryTree ℕ),
        _root_.BinaryTree.IsBST T_init →
        _root_.BinaryTree.IsBST G →
        idx + 2 + d = (leftSpineBottomUpNat T_init).length →
        tocAgreeAboveLeftDepth (d + 2) T_init G →
        let G' := applyAtLeftDepthGen _root_.BinaryTree.rotateRight G d
        let x := (leftSpineBottomUpNat T_init).getD idx 0
        let y := (leftSpineBottomUpNat T_init).getD (idx + 1) 0
        _root_.BinaryTree.IsBST G' ∧
          inorderNat G' = inorderNat G ∧
          tocAgreeAboveLeftDepth d T_init G' ∧
          validRightRotOp Δ' k (eraseNatKeys G) (.single (List.replicate d Dir.L)) ∧
          execRightRotOp (eraseNatKeys G) (.single (List.replicate d Dir.L)) = eraseNatKeys G' ∧
          x ∈ inorderNat T_init ∧
          y ∈ inorderNat T_init ∧
          ∀ v : ℕ, subtreeMaxNat G' v =
            if v = x then subtreeMaxNat T_init y else subtreeMaxNat G v := by
      intro Δ' k d
      induction d with
      | zero =>
        intro idx T_init G hbst_init hbst_G hidx hagree
        rcases T_init with _ | ⟨y, l1, c0⟩
        · exact False.elim hagree
        · rcases G with _ | ⟨y2, l2, c2⟩
          · exact False.elim hagree
          · obtain ⟨rfl, rfl, hagree1⟩ := hagree
            rcases l1 with _ | ⟨x, a0, b0⟩
            · exact False.elim hagree1
            · rcases l2 with _ | ⟨x2, a, b2⟩
              · exact False.elim hagree1
              · obtain ⟨rfl, rfl, _⟩ := hagree1
                have hsp : leftSpineBottomUpNat (.node y (.node x a0 b0) c0) =
                    leftSpineBottomUpNat a0 ++ [x, y] := by
                  have h1 : leftSpineBottomUpNat (.node y (.node x a0 b0) c0) =
                      leftSpineBottomUpNat (.node x a0 b0) ++ [y] := h_spine_aux _ [y]
                  have h2 : leftSpineBottomUpNat (.node x a0 b0) =
                      leftSpineBottomUpNat a0 ++ [x] := h_spine_aux a0 [x]
                  rw [h1, h2, List.append_assoc]
                  rfl
                have hlen : (leftSpineBottomUpNat (.node y (.node x a0 b0) c0)).length =
                    (leftSpineBottomUpNat a0).length + 2 := by
                  rw [hsp, List.length_append]
                  rfl
                have hidx_eq : idx = (leftSpineBottomUpNat a0).length := by omega
                have hx_eq : (leftSpineBottomUpNat (.node y (.node x a0 b0) c0)).getD idx 0 = x := by
                  rw [hsp, hidx_eq]
                  exact h_getD_append_right (leftSpineBottomUpNat a0) [x, y] 0
                have hy_eq :
                    (leftSpineBottomUpNat (.node y (.node x a0 b0) c0)).getD (idx + 1) 0 = y := by
                  rw [hsp, hidx_eq]
                  exact h_getD_append_right (leftSpineBottomUpNat a0) [x, y] 1
                obtain ⟨hbst', hin', hmax'⟩ := h_rot_props a b0 c0 x y hbst_G
                have hy_max : subtreeMaxNat (.node y (.node x a0 b0) c0) y =
                    rightmostKeyNat y c0 := by
                  simp [subtreeMaxNat]
                dsimp (config := { failIfUnchanged := false }) only [applyAtLeftDepthGen, _root_.BinaryTree.rotateRight]
                refine ⟨hbst', hin', trivial, ?_, rfl, ?_, ?_, ?_⟩
                · simp only [List.replicate, validRightRotOp, subtreeAtPos, eraseNatKeys,
                    leftSpineLen]
                  omega
                · rw [hx_eq]
                  simp [inorderNat]
                · rw [hy_eq]
                  simp [inorderNat]
                · intro v
                  rw [hx_eq, hy_eq, hy_max]
                  exact hmax' v
      | succ d' ih =>
        intro idx T_init G hbst_init hbst_G hidx hagree
        rcases T_init with _ | ⟨k1, l1, r1⟩
        · exact False.elim hagree
        · rcases G with _ | ⟨k2, l2, r2⟩
          · exact False.elim hagree
          · obtain ⟨rfl, rfl, hagree'⟩ := hagree
            cases hbst_init using isBSTCases with
            | node _ _ _ hl1_lt hr1_gt hl1_bst hr1_bst =>
              cases hbst_G using isBSTCases with
              | node _ _ _ hl2_lt hr2_gt hl2_bst hr2_bst =>
                have hsp1 : leftSpineBottomUpNat (.node k1 l1 r1) =
                    leftSpineBottomUpNat l1 ++ [k1] := h_spine_aux l1 [k1]
                have hlen1 : (leftSpineBottomUpNat (.node k1 l1 r1)).length =
                    (leftSpineBottomUpNat l1).length + 1 := by
                  rw [hsp1, List.length_append, List.length_singleton]
                have hidx' : idx + 2 + d' = (leftSpineBottomUpNat l1).length := by omega
                have hx_get : (leftSpineBottomUpNat (.node k1 l1 r1)).getD idx 0 =
                    (leftSpineBottomUpNat l1).getD idx 0 := by
                  rw [hsp1]
                  exact h_getD_append_left _ _ idx (by omega)
                have hy_get : (leftSpineBottomUpNat (.node k1 l1 r1)).getD (idx + 1) 0 =
                    (leftSpineBottomUpNat l1).getD (idx + 1) 0 := by
                  rw [hsp1]
                  exact h_getD_append_left _ _ (idx + 1) (by omega)
                obtain ⟨hbst_l2', hin_l2', hagree_l2', hval_l2', hexec_l2', hx_mem, hy_mem,
                  hmax_l2'⟩ := ih idx l1 l2 hl1_bst hl2_bst hidx' hagree'
                let l2' := applyAtLeftDepthGen _root_.BinaryTree.rotateRight l2 d'
                have hl2'_lt : _root_.SplayDeque.Direct.ForallTree (fun z => z < k1) l2' := by
                  rw [h_forall_inorder, hin_l2', ← h_forall_inorder]
                  exact hl2_lt
                have hbst_G' : _root_.BinaryTree.IsBST (.node k1 l2' r1) :=
                  _root_.BinaryTree.IsBST.node k1 l2' r1 hl2'_lt hr2_gt hbst_l2' hr2_bst
                have hx_lt_k1 : (leftSpineBottomUpNat l1).getD idx 0 < k1 :=
                  (h_forall_inorder _ l1).mp hl1_lt _ hx_mem
                have hy_lt_k1 : (leftSpineBottomUpNat l1).getD (idx + 1) 0 < k1 :=
                  (h_forall_inorder _ l1).mp hl1_lt _ hy_mem
                dsimp (config := { failIfUnchanged := false }) only [applyAtLeftDepthGen]
                refine ⟨hbst_G', ?_, ⟨rfl, rfl, hagree_l2'⟩, ?_, ?_, ?_, ?_, ?_⟩
                · simp only [inorderNat]
                  rw [hin_l2']
                · simpa [List.replicate, validRightRotOp, subtreeAtPos, eraseNatKeys] using hval_l2'
                · simp only [List.replicate, execRightRotOp, eraseNatKeys, applyAtPos]
                  exact congrArg (fun s => _root_.BinaryTree.node () s (eraseNatKeys r1)) hexec_l2'
                · rw [hx_get]
                  simp only [inorderNat, List.mem_append]
                  exact Or.inl (Or.inl hx_mem)
                · rw [hy_get]
                  simp only [inorderNat, List.mem_append]
                  exact Or.inl (Or.inl hy_mem)
                · intro v
                  rw [hx_get, hy_get]
                  by_cases hvk1 : v < k1
                  · simp only [subtreeMaxNat, hvk1, hy_lt_k1, ↓reduceIte]
                    exact hmax_l2' v
                  · have hvne : v ≠ (leftSpineBottomUpNat l1).getD idx 0 := by omega
                    simp only [subtreeMaxNat, hvk1, ↓reduceIte]
                    rw [if_neg hvne]

    have h_run_singles : ∀ (Δ' k : ℕ) (O : List ℕ) (G : _root_.BinaryTree ℕ) (m : ℕ),
        O ≠ [] →
        List.IsChain (fun u w => u + 2 ≤ w) O →
        (∀ idx ∈ O, idx ∈ F) →
        _root_.BinaryTree.IsBST G →
        inorderNat G = inorderNat T_init →
        (∀ c ∈ inorderNat G, subtreeMaxNat G c ≤ subtreeMaxNat T_end c) →
        tocAgreeAboveLeftDepth m T_init G →
        (leftSpineBottomUpNat T_init).length - O.headD 0 ≤ m →
        ∃ G_mid : _root_.BinaryTree ℕ,
          _root_.BinaryTree.IsBST G_mid ∧
          inorderNat G_mid = inorderNat T_init ∧
          (∀ c ∈ inorderNat G_mid, subtreeMaxNat G_mid c ≤ subtreeMaxNat T_end c) ∧
          tocAgreeAboveLeftDepth
            ((leftSpineBottomUpNat T_init).length - (O.getLastD 0 + 2)) T_init G_mid ∧
          ValidRightRotSeq Δ' k (eraseNatKeys G)
            (tocSingleSeq (leftSpineBottomUpNat T_init).length O) ∧
          execRightRotSeq (eraseNatKeys G)
            (tocSingleSeq (leftSpineBottomUpNat T_init).length O) = eraseNatKeys G_mid := by
      intro Δ' k O
      induction O with
      | nil =>
        intro _ _ hne
        exact False.elim (hne rfl)
      | cons idx rest_O ih =>
        intro G m _ hchain hmem_F hbst_G hin_G hdom_G hagree_m hm_bound
        let h_0 := (leftSpineBottomUpNat T_init).length
        have hidx_F : idx ∈ F := hmem_F idx (by simp)
        have hidx_lt : idx + 1 < h_0 := hF_lt idx hidx_F
        let d := h_0 - (idx + 2)
        have hd2_le_m : d + 2 ≤ m := by
          simp only [List.headD] at hm_bound
          omega
        have hagree_d2 : tocAgreeAboveLeftDepth (d + 2) T_init G :=
          h_agree_mono (d + 2) m T_init G hd2_le_m hagree_m
        have hidx_d : idx + 2 + d = h_0 := by omega
        obtain ⟨hbst_G', hin_G', hagree_d, hval_op, hexec_op, _, _, hmax_G'⟩ :=
          h_rot_at_depth Δ' k d idx T_init G hbst_init hbst_G hidx_d hagree_d2
        let G' := applyAtLeftDepthGen _root_.BinaryTree.rotateRight G d
        have hin_G'_init : inorderNat G' = inorderNat T_init := hin_G'.trans hin_G
        have hdom_G' : ∀ c ∈ inorderNat G', subtreeMaxNat G' c ≤ subtreeMaxNat T_end c := by
          intro c hc
          rw [hmax_G' c]
          by_cases hcx : c = (leftSpineBottomUpNat T_init).getD idx 0
          · rw [if_pos hcx, hcx]
            exact hrun_dom idx hidx_F
          · rw [if_neg hcx]
            exact hdom_G c (hin_G' ▸ hc)
        rcases rest_O with _ | ⟨idx2, rest'⟩
        · refine ⟨G', hbst_G', hin_G'_init, hdom_G', ?_, ?_, ?_⟩
          · exact hagree_d
          · exact ⟨hval_op, trivial⟩
          · simpa only [tocSingleSeq, List.map_cons, List.map_nil, execRightRotSeq] using hexec_op
        · cases hchain with
          | cons_cons h12 hchain_rest =>
            have hm'_bound : h_0 - (idx2 :: rest').headD 0 ≤ d := by
              simp only [List.headD]
              omega
            have hmem_rest : ∀ z ∈ idx2 :: rest', z ∈ F :=
              fun z hz => hmem_F z (List.mem_cons_of_mem idx hz)
            obtain ⟨G_mid, hbst_mid, hin_mid, hdom_mid, hagree_mid, hval_rest, hexec_rest⟩ :=
              ih G' d (by simp) hchain_rest hmem_rest hbst_G' hin_G'_init hdom_G' hagree_d hm'_bound
            have hlast_eq : (idx :: idx2 :: rest').getLastD 0 = (idx2 :: rest').getLastD 0 := rfl
            refine ⟨G_mid, hbst_mid, hin_mid, hdom_mid, ?_, ?_, ?_⟩
            · rwa [hlast_eq]
            · change validRightRotOp Δ' k (eraseNatKeys G) (.single (List.replicate d Dir.L)) ∧
                ValidRightRotSeq Δ' k
                  (execRightRotOp (eraseNatKeys G) (.single (List.replicate d Dir.L)))
                  (tocSingleSeq h_0 (idx2 :: rest'))
              refine ⟨hval_op, ?_⟩
              rwa [hexec_op]
            · change execRightRotSeq
                (execRightRotOp (eraseNatKeys G) (.single (List.replicate d Dir.L)))
                (tocSingleSeq h_0 (idx2 :: rest')) = eraseNatKeys G_mid
              rwa [hexec_op]

    have h_sub_pos_rep : ∀ (t : _root_.BinaryTree Unit) (d : ℕ),
        subtreeAtPos t (List.replicate d Dir.L) = subtreeAtLeftDepth t d := by
      intro t d
      induction d generalizing t with
      | zero => cases t <;> rfl
      | succ d' ih =>
        rcases t with _ | ⟨u, l, r⟩
        · rfl
        · exact ih l

    have h_app_pos_rep : ∀ (f : _root_.BinaryTree Unit → _root_.BinaryTree Unit) (t : _root_.BinaryTree Unit) (d : ℕ),
        applyAtPos f t (List.replicate d Dir.L) = applyAtLeftDepth f t d := by
      intro f t d
      induction d generalizing t with
      | zero => cases t <;> rfl
      | succ d' ih =>
        rcases t with _ | ⟨u, l, r⟩
        · rfl
        · exact congrArg (fun s => _root_.BinaryTree.node u s r) (ih l)

    have h_spine_sub : ∀ (t : _root_.BinaryTree Unit) (d : ℕ),
        leftSpineLen (subtreeAtLeftDepth t d) = leftSpineLen t - d := by
      intro t d
      induction d generalizing t with
      | zero => cases t <;> simp [subtreeAtLeftDepth]
      | succ d' ih =>
        rcases t with _ | ⟨u, l, r⟩
        · simp [subtreeAtLeftDepth, leftSpineLen]
        · simp only [subtreeAtLeftDepth, leftSpineLen, ih l]
          omega

    have h_app_id : ∀ (t : _root_.BinaryTree Unit) (d : ℕ),
        applyAtLeftDepth (fun s => s) t d = t := by
      intro t d
      induction d generalizing t with
      | zero => cases t <;> rfl
      | succ d' ih =>
        rcases t with _ | ⟨u, l, r⟩
        · rfl
        · exact congrArg (fun s => _root_.BinaryTree.node u s r) (ih l)

    have h_app_zero : ∀ (f : _root_.BinaryTree Unit → _root_.BinaryTree Unit) (t : _root_.BinaryTree Unit),
        applyAtLeftDepth f t 0 = f t := by
      intro f t
      cases t <;> rfl

    have h_app_comp : ∀ (f1 f2 : _root_.BinaryTree Unit → _root_.BinaryTree Unit) (t : _root_.BinaryTree Unit) (d : ℕ),
        applyAtLeftDepth f2 (applyAtLeftDepth f1 t d) d =
          applyAtLeftDepth (fun s => f2 (f1 s)) t d := by
      intro f1 f2 t d
      induction d generalizing t with
      | zero => simp only [h_app_zero]
      | succ d' ih =>
        rcases t with _ | ⟨u, l, r⟩
        · rfl
        · exact congrArg (fun s => _root_.BinaryTree.node u s r) (ih l)

    have h_exec_shiftLeft_op : ∀ (t : _root_.BinaryTree Unit) (d : ℕ) (op : RightRotOp),
        execRightRotOp t (tocShiftLeft d op) =
          applyAtLeftDepth (fun s => execRightRotOp s op) t d := by
      intro t d op
      induction d generalizing t with
      | zero =>
        rcases op with pos | ⟨pos, gaps⟩ <;> cases t <;> rfl
      | succ d' ih =>
        rcases t with _ | ⟨u, l, r⟩
        · rcases op with pos | ⟨pos, gaps⟩ <;> rfl
        · have hstep : execRightRotOp (.node u l r) (tocShiftLeft (d' + 1) op) =
              .node u (execRightRotOp l (tocShiftLeft d' op)) r := by
            rcases op with pos | ⟨pos, gaps⟩ <;> rfl
          rw [hstep, ih l]
          rfl

    have h_exec_shiftLeft_seq : ∀ (t : _root_.BinaryTree Unit) (d : ℕ) (ops : List RightRotOp),
        execRightRotSeq t (ops.map (tocShiftLeft d)) =
          applyAtLeftDepth (fun s => execRightRotSeq s ops) t d := by
      intro t d ops
      induction ops generalizing t with
      | nil =>
        simpa [execRightRotSeq] using (h_app_id t d).symm
      | cons op rest ih =>
        simp only [List.map_cons, execRightRotSeq, h_exec_shiftLeft_op]
        rw [ih, h_app_comp]

    have h_span_ge2 : ∀ gaps : List ℕ, 2 ≤ tocCascadeSpan gaps := by
      intro gaps
      rcases gaps with _ | ⟨g, rest⟩
      · simp [tocCascadeSpan]
      · have := tocCascadeSpan rest
        simp only [tocCascadeSpan]
        omega

    have h_cascade_valid : ∀ (Δ' : ℕ) (gaps : List ℕ) (s : _root_.BinaryTree Unit),
        (∀ g ∈ gaps, g ≤ Δ') →
        tocCascadeSpan gaps ≤ leftSpineLen s →
        validGappedCascadeAtRoot Δ' s gaps := by
      intro Δ' gaps
      induction gaps with
      | nil =>
        intro s _ hspan
        exact hspan
      | cons g rest ih =>
        intro s hg_le hspan
        have hge2 := h_span_ge2 rest
        simp only [tocCascadeSpan] at hspan
        rcases s with _ | ⟨u2, l, c⟩
        · simp [leftSpineLen] at hspan
        · rcases l with _ | ⟨u1, a, b⟩
          · simp [leftSpineLen] at hspan; omega
          · simp only [leftSpineLen] at hspan
            refine ⟨hg_le g (by simp), ih (subtreeAtLeftDepth a g) ?_ ?_⟩
            · intro g' hg'
              exact hg_le g' (List.mem_cons_of_mem g hg')
            · rw [h_spine_sub]
              omega

    have h_cascade_eq : ∀ (Δ' : ℕ) (gaps : List ℕ) (s : _root_.BinaryTree Unit),
        validGappedCascadeAtRoot Δ' s gaps →
        execGappedCascadeAtRoot s gaps = execRightRotSeq s (tocCascadeAsSingles gaps) := by
      intro Δ' gaps
      induction gaps with
      | nil =>
        intro s _
        cases s <;> rfl
      | cons g rest ih =>
        intro s hval
        rcases s with _ | ⟨u2, l, c⟩
        · exact False.elim hval
        · rcases l with _ | ⟨u1, a, b⟩
          · exact False.elim hval
          · obtain ⟨_, hval_rest⟩ := hval
            have h_app_eq : ∀ (g0 : ℕ) (a0 : _root_.BinaryTree Unit),
                validGappedCascadeAtRoot Δ' (subtreeAtLeftDepth a0 g0) rest →
                applyAtLeftDepth (fun sub => execGappedCascadeAtRoot sub rest) a0 g0 =
                  applyAtLeftDepth (fun sub => execRightRotSeq sub (tocCascadeAsSingles rest))
                    a0 g0 := by
              intro g0
              induction g0 with
              | zero =>
                intro a0 hv0
                cases a0 <;> exact ih _ hv0
              | succ g' ihg =>
                intro a0 hv0
                rcases a0 with _ | ⟨au, al, ar⟩
                · rfl
                · exact congrArg (fun sub => _root_.BinaryTree.node au sub ar) (ihg al hv0)
            simp only [execGappedCascadeAtRoot, tocCascadeAsSingles]
            have h_seq_split_exec : ∀ (t0 : _root_.BinaryTree Unit) (xs ys : List RightRotOp),
                execRightRotSeq t0 (xs ++ ys) = execRightRotSeq (execRightRotSeq t0 xs) ys := by
              intro t0 xs ys
              induction xs generalizing t0 with
              | nil => rfl
              | cons x xs' ihx => exact ihx (execRightRotOp t0 x)
            rw [h_seq_split_exec, h_exec_shiftLeft_seq]
            change .node u1 (applyAtLeftDepth (fun s => execGappedCascadeAtRoot s rest) a g)
                (.node u2 b c) =
              execRightRotSeq
                (.node u2 (.node u1 (applyAtLeftDepth
                  (fun s => execRightRotSeq s (tocCascadeAsSingles rest)) a g) b) c)
                [.single []]
            rw [h_app_eq g a hval_rest]
            rfl

    have h_shiftLeft_comp : ∀ (d1 d2 : ℕ) (op : RightRotOp),
        tocShiftLeft d1 (tocShiftLeft d2 op) = tocShiftLeft (d1 + d2) op := by
      intro d1 d2 op
      rcases op with pos | ⟨pos, gaps⟩ <;>
        simp only [tocShiftLeft, ← List.replicate_append_replicate, List.append_assoc]

    have h_lastD_snoc : ∀ (ws : List ℕ) (z : ℕ), (ws ++ [z]).getLastD 0 = z := by
      intro ws z
      induction ws with
      | nil => rfl
      | cons w ws' ih =>
        rcases ws' with _ | ⟨w2, ws''⟩
        · rfl
        · exact ih

    have h_chain_append_split : ∀ {R : ℕ → ℕ → Prop} (xs ys : List ℕ),
        List.IsChain R (xs ++ ys) → List.IsChain R xs ∧ List.IsChain R ys := by
      intro R xs ys
      induction xs with
      | nil => intro h; exact ⟨.nil, h⟩
      | cons x1 xs1 ih =>
        rcases xs1 with _ | ⟨x2, xs2⟩
        · rcases ys with _ | ⟨y1, ys1⟩
          · intro _; exact ⟨.singleton x1, .nil⟩
          · intro h
            cases h with
            | cons_cons _ hy => exact ⟨.singleton x1, hy⟩
        · intro h
          cases h with
          | cons_cons hx12 hrest =>
            obtain ⟨h1, h2⟩ := ih hrest
            exact ⟨.cons_cons hx12 h1, h2⟩

    have h_chain_append_join : ∀ {R : ℕ → ℕ → Prop} (xs ys : List ℕ),
        xs ≠ [] → ys ≠ [] →
        List.IsChain R xs → List.IsChain R ys →
        R (xs.getLastD 0) (ys.headD 0) →
        List.IsChain R (xs ++ ys) := by
      intro R xs ys
      induction xs with
      | nil => intro hne; exact False.elim (hne rfl)
      | cons x1 xs1 ih =>
        rcases xs1 with _ | ⟨x2, xs2⟩
        · intro _ hys_ne _ hys hrel
          rcases ys with _ | ⟨y1, ys1⟩
          · exact False.elim (hys_ne rfl)
          · exact .cons_cons hrel hys
        · intro _ hys_ne hxs hys hrel
          cases hxs with
          | cons_cons hx12 hrest =>
            exact .cons_cons hx12 (ih (by simp) hys_ne hrest hys hrel)

    have h_chain_rev : ∀ {R : ℕ → ℕ → Prop} (xs : List ℕ),
        List.IsChain R xs → List.IsChain (fun y x => R x y) xs.reverse := by
      intro R xs
      induction xs with
      | nil => intro _; exact .nil
      | cons x1 xs1 ih =>
        rcases xs1 with _ | ⟨x2, xs2⟩
        · intro _; exact .singleton x1
        · intro h
          cases h with
          | cons_cons hx12 hrest =>
            have hrev_rest := ih hrest
            have hne1 : (x2 :: xs2).reverse ≠ [] := by simp
            have hlast : ((x2 :: xs2).reverse).getLastD 0 = x2 := by
              simpa only [List.reverse_cons] using h_lastD_snoc xs2.reverse x2
            simpa only [List.reverse_cons] using
              h_chain_append_join ((x2 :: xs2).reverse) [x1] hne1 (by simp)
                hrev_rest (.singleton x1) (by simpa [hlast, List.headD] using hx12)

    have h_rev_props : ∀ (Δ' h_0 : ℕ) (rev_tail : List ℕ) (y : ℕ),
        y + 2 ≤ h_0 →
        List.IsChain (fun v u => u + 2 ≤ v ∧ v - u - 2 ≤ Δ') (y :: rev_tail) →
        (tocRevGaps (y :: rev_tail)).length + 1 = (y :: rev_tail).length ∧
          (∀ g ∈ tocRevGaps (y :: rev_tail), g ≤ Δ') ∧
          (y :: rev_tail).getLastD 0 ≤ y ∧
          tocCascadeSpan (tocRevGaps (y :: rev_tail)) =
            y + 2 - (y :: rev_tail).getLastD 0 ∧
          (tocCascadeAsSingles (tocRevGaps (y :: rev_tail))).map
            (tocShiftLeft (h_0 - (y + 2))) =
            tocSingleSeq h_0 (y :: rev_tail).reverse := by
      intro Δ' h_0 rev_tail
      induction rev_tail with
      | nil =>
        intro y _ _
        refine ⟨rfl, ?_, le_rfl, ?_, ?_⟩
        · intro g hg; simp [tocRevGaps] at hg
        · change 2 = y + 2 - y
          omega
        · simp [tocRevGaps, tocCascadeAsSingles, tocShiftLeft, tocSingleSeq]
      | cons x rest' ih =>
        intro y hy_h0 hchain
        cases hchain with
        | cons_cons hyx hchain_rest =>
          obtain ⟨hxy2, hgap_le⟩ := hyx
          have hx_h0 : x + 2 ≤ h_0 := by omega
          obtain ⟨hlen, hg_all, hlast_le, hspan, hsingles⟩ := ih x hx_h0 hchain_rest
          have hlast_eq : (y :: x :: rest').getLastD 0 = (x :: rest').getLastD 0 := rfl
          refine ⟨?_, ?_, ?_, ?_, ?_⟩
          · simp only [tocRevGaps, List.length_cons] at hlen ⊢
            omega
          · intro g hg
            simp only [tocRevGaps, List.mem_cons] at hg
            rcases hg with rfl | hg
            · exact hgap_le
            · exact hg_all g hg
          · rw [hlast_eq]
            omega
          · simp only [tocRevGaps, tocCascadeSpan, hspan, hlast_eq]
            omega
          · simp only [tocRevGaps, tocCascadeAsSingles, List.map_append, List.map_map]
            have hcomp_eq : (tocShiftLeft (h_0 - (y + 2)) ∘ tocShiftLeft (y - x - 2 + 2)) =
                tocShiftLeft (h_0 - (x + 2)) := by
              funext op
              simp only [Function.comp_apply, h_shiftLeft_comp]
              congr 1
              omega
            rw [hcomp_eq, hsingles]
            simp [tocSingleSeq, tocShiftLeft]

    have h_singleSeq_cascades_zero : ∀ (h_0 : ℕ) (xs : List ℕ),
        countGappedCascades (tocSingleSeq h_0 xs) = 0 := by
      intro h_0 xs
      induction xs with
      | nil => rfl
      | cons _ _ ih => exact ih

    have h_app_cascade_eq : ∀ (Δ' : ℕ) (gaps : List ℕ) (d0 : ℕ) (t0 : _root_.BinaryTree Unit),
        validGappedCascadeAtRoot Δ' (subtreeAtLeftDepth t0 d0) gaps →
        applyAtLeftDepth (fun s => execGappedCascadeAtRoot s gaps) t0 d0 =
          applyAtLeftDepth (fun s => execRightRotSeq s (tocCascadeAsSingles gaps)) t0 d0 := by
      intro Δ' gaps d0
      induction d0 with
      | zero =>
        intro t0 hv0
        cases t0 <;> exact h_cascade_eq Δ' gaps _ hv0
      | succ d' ihd =>
        intro t0 hv0
        rcases t0 with _ | ⟨tu, tl, tr⟩
        · rfl
        · exact congrArg (fun sub => _root_.BinaryTree.node tu sub tr) (ihd tl hv0)

    have h_compress_piece : ∀ (Δ' k h_0 n : ℕ),
        1 ≤ k →
        ∀ (O : List ℕ) (t : _root_.BinaryTree Unit),
          O.length ≤ n →
          List.IsChain (fun u w => u + 2 ≤ w ∧ w - u - 2 ≤ Δ') O →
          (∀ idx ∈ O, idx + 2 ≤ h_0) →
          ValidRightRotSeq Δ' k t (tocSingleSeq h_0 O) →
          ∃ seq_O : List RightRotOp,
            ValidRightRotSeq Δ' k t seq_O ∧
            execRightRotSeq t seq_O = execRightRotSeq t (tocSingleSeq h_0 O) ∧
            countGappedCascades seq_O = O.length / k := by
      intro Δ' k h_0 n hk1
      induction n with
      | zero =>
        intro O t hlen _ _ _
        have hO : O = [] := List.eq_nil_of_length_eq_zero (by omega)
        subst hO
        exact ⟨[], trivial, rfl, by simp [countGappedCascades]⟩
      | succ n' ih =>
        intro O t hlen hchain h_h0 hval_all
        by_cases hk_le : k ≤ O.length
        · set chunk := O.take k
          set rest_O := O.drop k
          have hO_eq : chunk ++ rest_O = O := List.take_append_drop k O
          have hchunk_len : chunk.length = k := List.length_take_of_le hk_le
          have hrest_len : rest_O.length ≤ n' := by
            have : rest_O.length = O.length - k := List.length_drop
            omega
          obtain ⟨hchain_chunk, hchain_rest⟩ :=
            h_chain_append_split chunk rest_O (hO_eq ▸ hchain)
          have hseq_split_eq : tocSingleSeq h_0 O =
              tocSingleSeq h_0 chunk ++ tocSingleSeq h_0 rest_O := by
            simp [← hO_eq, tocSingleSeq]
          rw [hseq_split_eq] at hval_all
          obtain ⟨hval_chunk, hval_rest, hexec_split⟩ :=
            h_seq_split Δ' k t (tocSingleSeq h_0 chunk) (tocSingleSeq h_0 rest_O) hval_all
          rcases hchunk_cases : chunk with _ | ⟨idx0, chunk_tail⟩
          · rw [hchunk_cases] at hchunk_len
            simp at hchunk_len
            omega
          · set rev := (idx0 :: chunk_tail).reverse
            have hrev_len : rev.length = k := by
              rw [hchunk_cases] at hchunk_len
              simpa only [rev, List.length_reverse] using hchunk_len
            rcases hrev_cases : rev with _ | ⟨y, rev_tail⟩
            · rw [hrev_cases] at hrev_len
              simp at hrev_len
              omega
            · have hchain_rev_y : List.IsChain
                  (fun v u => u + 2 ≤ v ∧ v - u - 2 ≤ Δ') (y :: rev_tail) := by
                rw [← hrev_cases]
                exact h_chain_rev (idx0 :: chunk_tail) (hchunk_cases ▸ hchain_chunk)
              have hy_in_O : y ∈ O := by
                have hy_rev : y ∈ rev := by rw [hrev_cases]; simp
                have hy_chunk : y ∈ chunk := by
                  rw [hchunk_cases]
                  exact List.mem_reverse.mp hy_rev
                rw [← hO_eq]
                exact List.mem_append_left rest_O hy_chunk
              have hidx0_in_O : idx0 ∈ O := by
                have hidx0_chunk : idx0 ∈ chunk := by rw [hchunk_cases]; simp
                rw [← hO_eq]
                exact List.mem_append_left rest_O hidx0_chunk
              have hy_h0 : y + 2 ≤ h_0 := h_h0 y hy_in_O
              have hidx0_h0 : idx0 + 2 ≤ h_0 := h_h0 idx0 hidx0_in_O
              obtain ⟨hgaps_len, hgaps_le, hlast_le_y, hspan_eq, hsingles_eq⟩ :=
                h_rev_props Δ' h_0 rev_tail y hy_h0 hchain_rev_y
              have hlast_eq_idx0 : (y :: rev_tail).getLastD 0 = idx0 := by
                rw [← hrev_cases]
                simpa only [rev, List.reverse_cons] using h_lastD_snoc chunk_tail.reverse idx0
              have hrev_rev : (y :: rev_tail).reverse = idx0 :: chunk_tail := by
                rw [← hrev_cases]
                exact List.reverse_reverse (idx0 :: chunk_tail)
              have hfirst_val : 2 ≤ leftSpineLen
                  (subtreeAtPos t (List.replicate (h_0 - (idx0 + 2)) Dir.L)) := by
                rw [hchunk_cases] at hval_chunk
                exact hval_chunk.1
              rw [h_sub_pos_rep, h_spine_sub] at hfirst_val
              set casc_op := RightRotOp.cascade
                (List.replicate (h_0 - (y + 2)) Dir.L) (tocRevGaps (y :: rev_tail))
              have hcasc_root_val : validGappedCascadeAtRoot Δ'
                  (subtreeAtPos t (List.replicate (h_0 - (y + 2)) Dir.L))
                  (tocRevGaps (y :: rev_tail)) := by
                apply h_cascade_valid Δ' _ _ hgaps_le
                rw [h_sub_pos_rep, h_spine_sub, hspan_eq, hlast_eq_idx0]
                omega
              have hcasc_val : validRightRotOp Δ' k t casc_op := by
                refine ⟨?_, hcasc_root_val⟩
                rw [hgaps_len, ← hrev_cases, hrev_len]
              have hcasc_exec : execRightRotOp t casc_op =
                  execRightRotSeq t (tocSingleSeq h_0 chunk) := by
                have h1 : execRightRotOp t casc_op =
                    applyAtLeftDepth
                      (fun s => execGappedCascadeAtRoot s (tocRevGaps (y :: rev_tail)))
                      t (h_0 - (y + 2)) := by
                  simp [casc_op, execRightRotOp, h_app_pos_rep]
                have hcasc_sub : validGappedCascadeAtRoot Δ'
                    (subtreeAtLeftDepth t (h_0 - (y + 2))) (tocRevGaps (y :: rev_tail)) := by
                  rwa [h_sub_pos_rep] at hcasc_root_val
                have h2 := h_app_cascade_eq Δ' (tocRevGaps (y :: rev_tail)) (h_0 - (y + 2)) t
                  hcasc_sub
                rw [h1, h2, ← h_exec_shiftLeft_seq, hsingles_eq, hrev_rev, ← hchunk_cases]
              have hrest_h0 : ∀ idx ∈ rest_O, idx + 2 ≤ h_0 := by
                intro idx hidx
                apply h_h0 idx
                rw [← hO_eq]
                exact List.mem_append_right chunk hidx
              rw [← hcasc_exec] at hval_rest
              obtain ⟨seq_rest, hval_seq_rest, hexec_seq_rest, hcnt_seq_rest⟩ :=
                ih rest_O (execRightRotOp t casc_op) hrest_len hchain_rest hrest_h0 hval_rest
              refine ⟨casc_op :: seq_rest, ⟨hcasc_val, hval_seq_rest⟩, ?_, ?_⟩
              · simp only [execRightRotSeq]
                rw [hexec_seq_rest, hcasc_exec, ← hexec_split, ← hseq_split_eq]
              · have hdiv : O.length / k = (O.length - k) / k + 1 := by
                  rw [Nat.div_eq_sub_div (by omega) hk_le]
                have hdrop_len : rest_O.length = O.length - k := List.length_drop
                simp only [casc_op, countGappedCascades, hcnt_seq_rest, hdrop_len, hdiv]
                omega
        · refine ⟨tocSingleSeq h_0 O, hval_all, rfl, ?_⟩
          rw [h_singleSeq_cascades_zero, Nat.div_eq_of_lt (by omega)]

    have h_split : ∀ (rest_F : List ℕ) (a : ℕ) (U0 : List ℕ),
        List.Pairwise (· < ·) (a :: rest_F) →
        U0.length = rest_F.length →
        (∀ r, r + 1 < (a :: rest_F).length →
          (a :: rest_F).getD (r + 1) 0 - (a :: rest_F).getD r 0 - 1 ≤ 3 + U0.getD r 0) →
        ∃ (p0 : List ℕ) (ps : List (List ℕ)),
          tocSplitByGap Δ (a :: rest_F) = (a :: p0) :: ps ∧
          (∀ P ∈ (a :: p0) :: ps, P ≠ []) ∧
          (∀ P ∈ (a :: p0) :: ps, ∀ x ∈ P, x ∈ a :: rest_F) ∧
          (∀ P ∈ (a :: p0) :: ps, List.IsChain (fun x y => x < y ∧ y - x - 1 ≤ Δ) P) ∧
          List.IsChain (fun p1 p2 => p1.getLastD 0 + Δ + 2 ≤ p2.headD 0) ((a :: p0) :: ps) ∧
          (((a :: p0) :: ps).map List.length).sum = (a :: rest_F).length ∧
          ps.length * (Δ - 2) ≤ U0.sum := by
      intro rest_F
      induction rest_F with
      | nil =>
        intro a U0 _ _ _
        refine ⟨[], [], rfl, ?_, ?_, ?_, .singleton [a], by simp, by simp⟩
        · intro P hP; simp at hP; subst hP; simp
        · intro P hP x hx; simp at hP; subst hP; exact hx
        · intro P hP; simp at hP; subst hP; exact .singleton a
      | cons b rest' ih =>
        intro a U0 hmono hU0_len hgap0
        rcases U0 with _ | ⟨u0, U'⟩
        · simp at hU0_len
        · obtain ⟨ha_lt, hmono'⟩ := List.pairwise_cons.mp hmono
          have hab : a < b := ha_lt b (by simp)
          have hU'_len : U'.length = rest'.length := by simp at hU0_len; omega
          have hg0 : b - a - 1 ≤ 3 + u0 := by
            have h0 := hgap0 0 (by simp)
            simpa [List.getD] using h0
          have hgap' : ∀ r, r + 1 < (b :: rest').length →
              (b :: rest').getD (r + 1) 0 - (b :: rest').getD r 0 - 1 ≤ 3 + U'.getD r 0 := by
            intro r hr
            have hr1 := hgap0 (r + 1) (by simp at hr ⊢; omega)
            simpa [List.getD] using hr1
          obtain ⟨p0', ps', heq', hne', hsub', hintra', hinter', hsum', hcuts'⟩ :=
            ih b U' hmono' hU'_len hgap'
          have hsplit_eq : tocSplitByGap Δ (a :: b :: rest') =
              if b - a - 1 ≤ Δ then (a :: b :: p0') :: ps'
              else [a] :: (b :: p0') :: ps' := by
            simp only [tocSplitByGap, heq']
          by_cases hle : b - a - 1 ≤ Δ
          · refine ⟨b :: p0', ps', by simp [hsplit_eq, hle], ?_, ?_, ?_, ?_, ?_, ?_⟩
            · intro P hP
              cases hP with
              | head => simp
              | tail _ hP => exact hne' P (List.mem_cons_of_mem _ hP)
            · intro P hP x hx
              cases hP with
              | head =>
                cases hx with
                | head => simp
                | tail _ hx => exact List.mem_cons_of_mem a (hsub' (b :: p0') (by simp) x hx)
              | tail _ hP => exact List.mem_cons_of_mem a (hsub' P (List.mem_cons_of_mem _ hP) x hx)
            · intro P hP
              cases hP with
              | head => exact .cons_cons ⟨hab, hle⟩ (hintra' (b :: p0') (by simp))
              | tail _ hP => exact hintra' P (List.mem_cons_of_mem _ hP)
            · rcases ps' with _ | ⟨p2, ps''⟩
              · exact .singleton _
              · cases hinter' with
                | cons_cons hrel hrest_c =>
                  exact .cons_cons hrel hrest_c
            · simp only [List.map_cons, List.sum_cons, List.length_cons] at hsum' ⊢
              omega
            · simp only [List.sum_cons]
              omega
          · refine ⟨[], (b :: p0') :: ps', by simp [hsplit_eq, hle], ?_, ?_, ?_, ?_, ?_, ?_⟩
            · intro P hP
              cases hP with
              | head => simp
              | tail _ hP => exact hne' P hP
            · intro P hP x hx
              cases hP with
              | head => simp at hx; subst hx; simp
              | tail _ hP => exact List.mem_cons_of_mem a (hsub' P hP x hx)
            · intro P hP
              cases hP with
              | head => exact .singleton a
              | tail _ hP => exact hintra' P hP
            · refine .cons_cons ?_ hinter'
              change a + Δ + 2 ≤ b
              omega
            · simp only [List.map_cons, List.sum_cons, List.length_cons, List.length_nil] at hsum' ⊢
              omega
            · simp only [List.length_cons, List.sum_cons]
              have hu0_ge : Δ - 2 ≤ u0 := by omega
              calc
                (ps'.length + 1) * (Δ - 2) = ps'.length * (Δ - 2) + (Δ - 2) := by ring
                _ ≤ U'.sum + u0 := Nat.add_le_add hcuts' hu0_ge
                _ = u0 + U'.sum := by omega

    have h_takeEven : ∀ (n : ℕ) (L : List ℕ),
        L.length ≤ n →
        List.IsChain (fun x y => x < y ∧ y - x - 1 ≤ Δ) L →
        (∀ z ∈ tocTakeEven L, z ∈ L) ∧
          L.length ≤ 2 * (tocTakeEven L).length ∧
          List.IsChain (fun u w => u + 2 ≤ w ∧ w - u - 2 ≤ 2 * Δ) (tocTakeEven L) ∧
          (L ≠ [] → tocTakeEven L ≠ [] ∧
            (tocTakeEven L).headD 0 = L.headD 0 ∧
            (tocTakeEven L).getLastD 0 ≤ L.getLastD 0) := by
      intro n
      induction n with
      | zero =>
        intro L hlen _
        have hL : L = [] := List.eq_nil_of_length_eq_zero (by omega)
        subst hL
        exact ⟨by simp [tocTakeEven], by simp [tocTakeEven], .nil, fun h => False.elim (h rfl)⟩
      | succ n' ih =>
        intro L hlen hchain
        rcases L with _ | ⟨a, L1⟩
        · exact ⟨by simp [tocTakeEven], by simp [tocTakeEven], .nil, fun h => False.elim (h rfl)⟩
        · rcases L1 with _ | ⟨b, rest⟩
          · refine ⟨by simp [tocTakeEven], by simp [tocTakeEven], .singleton a, ?_⟩
            intro _
            exact ⟨by simp [tocTakeEven], rfl, le_rfl⟩
          · cases hchain with
            | cons_cons hab hchain_b =>
              rcases rest with _ | ⟨c, rest'⟩
              · refine ⟨?_, by simp [tocTakeEven], .singleton a, ?_⟩
                · intro z hz
                  simp [tocTakeEven] at hz
                  subst hz
                  simp
                · intro _
                  refine ⟨by simp [tocTakeEven], rfl, ?_⟩
                  change a ≤ b
                  omega
              · cases hchain_b with
                | cons_cons hbc hchain_c =>
                  have hlen_c : (c :: rest').length ≤ n' := by
                    simp only [List.length_cons] at hlen ⊢
                    omega
                  obtain ⟨hsub_c, hlen2_c, hchain_even_c, hne_c⟩ := ih (c :: rest') hlen_c hchain_c
                  obtain ⟨hne_ec, hhead_ec, hlast_ec⟩ := hne_c (by simp)
                  rcases h_ec_eq : tocTakeEven (c :: rest') with _ | ⟨ec0, ec_tail⟩
                  · exact False.elim (hne_ec h_ec_eq)
                  · have hec0_eq : ec0 = c := by
                      rw [h_ec_eq] at hhead_ec
                      simpa [List.headD] using hhead_ec
                    subst ec0
                    have hte_eq : tocTakeEven (a :: b :: c :: rest') = a :: c :: ec_tail := by
                      simp only [tocTakeEven, h_ec_eq]
                    rw [hte_eq]
                    refine ⟨?_, ?_, ?_, ?_⟩
                    · intro z hz
                      cases hz with
                      | head => simp
                      | tail _ hz =>
                        have hz_c : z ∈ c :: rest' := hsub_c z (by rw [h_ec_eq]; exact hz)
                        simp [hz_c]
                    · simp only [List.length_cons] at hlen2_c ⊢
                      rw [h_ec_eq, List.length_cons] at hlen2_c
                      omega
                    · rw [h_ec_eq] at hchain_even_c
                      refine .cons_cons ⟨by omega, by omega⟩ hchain_even_c
                    · intro _
                      refine ⟨by simp, rfl, ?_⟩
                      rw [h_ec_eq] at hlast_ec
                      exact hlast_ec

    have h_weaken_chain : ∀ (xs : List ℕ),
        List.IsChain (fun u w => u + 2 ≤ w ∧ w - u - 2 ≤ 2 * Δ) xs →
        List.IsChain (fun u w => u + 2 ≤ w) xs := by
      intro xs
      induction xs with
      | nil => intro _; exact .nil
      | cons x1 xs1 ih =>
        rcases xs1 with _ | ⟨x2, xs2⟩
        · intro _; exact .singleton x1
        · intro hc
          cases hc with
          | cons_cons h12 hrest =>
            exact .cons_cons h12.1 (ih hrest)

    rcases F with _ | ⟨a, rest_F⟩
    · refine ⟨T_init, [], hbst_init, hin_eq, hreach_mono, trivial, rfl, ?_⟩
      simp [countGappedCascades]
    · have hU_len' : U.length = rest_F.length := by simp at hU_len; omega
      obtain ⟨p0, ps, hPs_eq, hPs_ne, hPs_sub, hPs_intra, hPs_inter, hPs_sum, hPs_cuts⟩ :=
        h_split rest_F a U hF_mono hU_len' hgap_b
      set Ps := (a :: p0) :: ps
      set Os := Ps.map tocTakeEven
      have hOs_props : (∀ O ∈ Os, O ≠ [] ∧
          (∀ z ∈ O, z ∈ a :: rest_F) ∧
          List.IsChain (fun u w => u + 2 ≤ w ∧ w - u - 2 ≤ 2 * Δ) O) ∧
          List.IsChain (fun o1 o2 => o1.getLastD 0 + 2 ≤ o2.headD 0) Os := by
        refine ⟨?_, ?_⟩
        · intro O hO
          rw [List.mem_map] at hO
          obtain ⟨P, hP_mem, rfl⟩ := hO
          obtain ⟨hsub_P, _, hchain_P, hne_P⟩ := h_takeEven P.length P le_rfl (hPs_intra P hP_mem)
          obtain ⟨hne_O, _, _⟩ := hne_P (hPs_ne P hP_mem)
          exact ⟨hne_O, fun z hz => hPs_sub P hP_mem z (hsub_P z hz), hchain_P⟩
        · have h_inter_map : ∀ (L : List (List ℕ)),
              (∀ P ∈ L, P ≠ []) →
              (∀ P ∈ L, List.IsChain (fun x y => x < y ∧ y - x - 1 ≤ Δ) P) →
              List.IsChain (fun p1 p2 => p1.getLastD 0 + Δ + 2 ≤ p2.headD 0) L →
              List.IsChain (fun o1 o2 => o1.getLastD 0 + 2 ≤ o2.headD 0) (L.map tocTakeEven) := by
            intro L
            induction L with
            | nil => intros; exact .nil
            | cons P1 L' ih =>
              rcases L' with _ | ⟨P2, L''⟩
              · intros; exact .singleton _
              · intro hne_L hintra_L hinter_L
                cases hinter_L with
                | cons_cons h12 hrest_inter =>
                  obtain ⟨_, _, _, hne1⟩ := h_takeEven P1.length P1 le_rfl (hintra_L P1 (by simp))
                  obtain ⟨_, _, _, hne2⟩ := h_takeEven P2.length P2 le_rfl (hintra_L P2 (by simp))
                  obtain ⟨_, _, hlast1⟩ := hne1 (hne_L P1 (by simp))
                  obtain ⟨_, hhead2, _⟩ := hne2 (hne_L P2 (by simp))
                  refine .cons_cons (by omega) (ih ?_ ?_ hrest_inter)
                  · intro P hP; exact hne_L P (List.mem_cons_of_mem P1 hP)
                  · intro P hP; exact hintra_L P (List.mem_cons_of_mem P1 hP)
          exact h_inter_map Ps hPs_ne hPs_intra hPs_inter

      have h_run_pieces : ∀ (L : List (List ℕ)) (G : _root_.BinaryTree ℕ) (m : ℕ),
          (∀ O ∈ L, O ≠ [] ∧
            (∀ z ∈ O, z ∈ a :: rest_F) ∧
            List.IsChain (fun u w => u + 2 ≤ w ∧ w - u - 2 ≤ 2 * Δ) O) →
          List.IsChain (fun o1 o2 => o1.getLastD 0 + 2 ≤ o2.headD 0) L →
          _root_.BinaryTree.IsBST G →
          inorderNat G = inorderNat T_init →
          (∀ c ∈ inorderNat G, subtreeMaxNat G c ≤ subtreeMaxNat T_end c) →
          tocAgreeAboveLeftDepth m T_init G →
          (∀ O rest_L, L = O :: rest_L →
            (leftSpineBottomUpNat T_init).length - O.headD 0 ≤ m) →
          ∃ (G_out : _root_.BinaryTree ℕ) (seq_out : List RightRotOp),
            _root_.BinaryTree.IsBST G_out ∧
            inorderNat G_out = inorderNat T_init ∧
            (∀ c ∈ inorderNat G_out, subtreeMaxNat G_out c ≤ subtreeMaxNat T_end c) ∧
            ValidRightRotSeq (2 * Δ) (2 * i) (eraseNatKeys G) seq_out ∧
            execRightRotSeq (eraseNatKeys G) seq_out = eraseNatKeys G_out ∧
            countGappedCascades seq_out = (L.map (fun O => O.length / (2 * i))).sum := by
        intro L
        induction L with
        | nil =>
          intro G _ _ _ hbst_G hin_G hdom_G _ _
          exact ⟨G, [], hbst_G, hin_G, hdom_G, trivial, rfl, rfl⟩
        | cons O rest_L ih =>
          intro G m hO_all hinter_L hbst_G hin_G hdom_G hagree_m hm_head
          obtain ⟨hO_ne, hO_mem, hO_chain⟩ := hO_all O (by simp)
          have hO_chain2 : List.IsChain (fun u w => u + 2 ≤ w) O := h_weaken_chain O hO_chain
          obtain ⟨G_mid, hbst_mid, hin_mid, hdom_mid, hagree_mid, hval_sing, hexec_sing⟩ :=
            h_run_singles (2 * Δ) (2 * i) O G m hO_ne hO_chain2 hO_mem
              hbst_G hin_G hdom_G hagree_m (hm_head O rest_L rfl)
          have hO_h0 : ∀ idx ∈ O, idx + 2 ≤ (leftSpineBottomUpNat T_init).length := by
            intro idx hidx
            have := hF_lt idx (hO_mem idx hidx)
            omega
          obtain ⟨seq_O, hval_seqO, hexec_seqO, hcnt_seqO⟩ :=
            h_compress_piece (2 * Δ) (2 * i) (leftSpineBottomUpNat T_init).length O.length
              (by omega) O (eraseNatKeys G) le_rfl hO_chain hO_h0 hval_sing
          have hexec_seqO_mid : execRightRotSeq (eraseNatKeys G) seq_O = eraseNatKeys G_mid :=
            hexec_seqO.trans hexec_sing
          have hrest_all : ∀ O' ∈ rest_L, O' ≠ [] ∧
              (∀ z ∈ O', z ∈ a :: rest_F) ∧
              List.IsChain (fun u w => u + 2 ≤ w ∧ w - u - 2 ≤ 2 * Δ) O' :=
            fun O' hO' => hO_all O' (List.mem_cons_of_mem O hO')
          have hinter_rest : List.IsChain (fun o1 o2 => o1.getLastD 0 + 2 ≤ o2.headD 0) rest_L := by
            rcases rest_L with _ | ⟨O2, rest_L'⟩
            · exact .nil
            · cases hinter_L with
              | cons_cons _ hr => exact hr
          have hm_next : ∀ O2 rest_L', rest_L = O2 :: rest_L' →
              (leftSpineBottomUpNat T_init).length - O2.headD 0 ≤
                (leftSpineBottomUpNat T_init).length - (O.getLastD 0 + 2) := by
            intro O2 rest_L' heq_rest
            rw [heq_rest] at hinter_L
            cases hinter_L with
            | cons_cons h12 _ => omega
          obtain ⟨G_out, seq_rest, hbst_out, hin_out, hdom_out, hval_rest, hexec_rest, hcnt_rest⟩ :=
            ih G_mid ((leftSpineBottomUpNat T_init).length - (O.getLastD 0 + 2))
              hrest_all hinter_rest hbst_mid hin_mid hdom_mid hagree_mid hm_next
          have hval_rest' : ValidRightRotSeq (2 * Δ) (2 * i)
              (execRightRotSeq (eraseNatKeys G) seq_O) seq_rest := by
            simpa only [hexec_seqO_mid] using hval_rest
          obtain ⟨hval_tot, hexec_tot, hcnt_tot⟩ :=
            h_seq_append (2 * Δ) (2 * i) (eraseNatKeys G) seq_O seq_rest hval_seqO hval_rest'
          refine ⟨G_out, seq_O ++ seq_rest, hbst_out, hin_out, hdom_out, hval_tot, ?_, ?_⟩
          · rw [hexec_tot, hexec_seqO_mid, hexec_rest]
          · simp [hcnt_tot, hcnt_seqO, hcnt_rest]

      obtain ⟨G_odd, seq_odd, hbst_odd, hin_odd, hdom_odd, hval_odd, hexec_odd, hcnt_odd⟩ :=
        h_run_pieces Os T_init (leftSpineBottomUpNat T_init).length
          hOs_props.1 hOs_props.2 hbst_init rfl hreach_mono (h_agree_refl T_init)
          (fun _ _ _ => Nat.sub_le _ _)

      have h_len_even_sum : ∀ L : List (List ℕ),
          (∀ P ∈ L, List.IsChain (fun x y => x < y ∧ y - x - 1 ≤ Δ) P) →
          (L.map List.length).sum ≤ 2 * ((L.map tocTakeEven).map List.length).sum := by
        intro L
        induction L with
        | nil => intros; simp
        | cons P L' ih =>
          intro hintra_L
          obtain ⟨_, hlen2_P, _, _⟩ := h_takeEven P.length P le_rfl (hintra_L P (by simp))
          have hrest := ih (fun P' hP' => hintra_L P' (List.mem_cons_of_mem P hP'))
          simp only [List.map_cons, List.sum_cons]
          omega

      have h_div_sum : ∀ L : List (List ℕ),
          (L.map List.length).sum ≤
            2 * i * (L.map (fun O => O.length / (2 * i))).sum + 2 * i * L.length := by
        intro L
        induction L with
        | nil => simp
        | cons O L' ih =>
          have hmod : O.length % (2 * i) < 2 * i := Nat.mod_lt O.length (by omega)
          have hdiv_mod : 2 * i * (O.length / (2 * i)) + O.length % (2 * i) = O.length :=
            Nat.div_add_mod O.length (2 * i)
          have hO_bound : O.length ≤ 2 * i * (O.length / (2 * i)) + 2 * i := by omega
          simp only [List.map_cons, List.sum_cons, List.length_cons]
          calc
            O.length + (L'.map List.length).sum
              ≤ (2 * i * (O.length / (2 * i)) + 2 * i) +
                  (2 * i * (L'.map (fun O => O.length / (2 * i))).sum + 2 * i * L'.length) :=
                Nat.add_le_add hO_bound ih
            _ = 2 * i * (O.length / (2 * i) + (L'.map (fun O => O.length / (2 * i))).sum) +
                  2 * i * (L'.length + 1) := by ring

      have h1 := h_len_even_sum Ps hPs_intra
      have h2 := h_div_sum Os
      have hOs_len : Os.length = ps.length + 1 := by simp [Os, Ps]
      have hcuts_i : ps.length * (100 * i) ≤ U.sum := by
        refine le_trans (Nat.mul_le_mul_left ps.length ?_) hPs_cuts
        omega
      have hF_bound : 25 * (a :: rest_F).length ≤
          100 * i * countGappedCascades seq_odd + 100 * i + U.sum := by
        rw [← hPs_sum, hcnt_odd]
        rw [hOs_len] at h2
        set C := (Os.map (fun O => O.length / (2 * i))).sum
        have h_mul50 : 50 * (Os.map List.length).sum ≤
            100 * i * C + 100 * i + ps.length * (100 * i) := by
          calc
            50 * (Os.map List.length).sum
              ≤ 50 * (2 * i * C + 2 * i * (ps.length + 1)) := Nat.mul_le_mul_left 50 h2
            _ = 100 * i * C + 100 * i + ps.length * (100 * i) := by ring
        have h_mul25 : 25 * (Ps.map List.length).sum ≤ 50 * (Os.map List.length).sum := by
          change 25 * (Ps.map List.length).sum ≤ 50 * ((Ps.map tocTakeEven).map List.length).sum
          omega
        omega

      exact ⟨G_odd, seq_odd, hbst_odd, hin_odd.trans hin_eq, hdom_odd, hval_odd, hexec_odd,
        hF_bound⟩


  have h_block : ∀ ℓ, 1 ≤ ℓ → ℓ ≤ L → ∀ Xi < (scaleBlocks S P (ℓ - 1)).length,
      let X := (scaleBlocks S P (ℓ - 1)).getD Xi (0, 0)
      let N_X := (splitBlock (S ℓ) X.1 X.2).length - 1
      let i_ℓ := invAckermann (2 * S (ℓ - 1)) + 1
      let Δ_ℓ := 200 * i_ℓ
      1 ≤ N_X → 2 ≤ i_ℓ → 100 * i_ℓ + 2 ≤ Δ_ℓ → N_X ≤ ackermann i_ℓ 1 →
      25 * (Finset.range N_X).sum (fun p => ((pkgs ℓ Xi).F_idx p).length) ≤
        100 * i_ℓ * (8 * (2 * Δ_ℓ + 4) + 1) * N_X +
          (Finset.range N_X).sum (fun p => ((pkgs ℓ Xi).u_gap p).sum) := by
    intro ℓ hℓ1 hℓL Xi hXi X N_X i_ℓ Δ_ℓ hNX1 hi2 hΔ_ge hNX_ack
    let pkg := pkgs ℓ Xi
    have hpkg : ValidBlockQuotientPkg N_X pkg := hpkgs ℓ hℓ1 hℓL Xi hXi
    have h_within_phase : ∀ p < N_X, ∃ seq_p : List RightRotOp,
        ValidRightRotSeq (2 * Δ_ℓ) (2 * i_ℓ) (eraseNatKeys (pkg.G_init p)) seq_p ∧
        execRightRotSeq (eraseNatKeys (pkg.G_init p)) seq_p = eraseNatKeys (pkg.G_end p) ∧
        25 * (pkg.F_idx p).length ≤
          100 * i_ℓ * countGappedCascades seq_p + 100 * i_ℓ + (pkg.u_gap p).sum := by
      intro p hp
      have hin_p : inorderNat (pkg.G_init p) = inorderNat (pkg.G_end p) :=
        (hpkg.inorder_init p hp).trans (hpkg.inorder_end p hp).symm
      have hreach_p : ∀ c ∈ inorderNat (pkg.G_init p),
          subtreeMaxNat (pkg.G_init p) c ≤ subtreeMaxNat (pkg.G_end p) c := by
        intro c hc
        rw [hpkg.inorder_init p hp, List.Ico.mem] at hc
        exact hpkg.reach_mono p hp c hc.1 (by omega)
      obtain ⟨G_odd, seq_odd, hbst_odd, hin_odd, hdom_odd, hval_odd, hexec_odd, hF_bound⟩ :=
        h_mod2 i_ℓ Δ_ℓ hi2 hΔ_ge (pkg.G_init p) (pkg.G_end p) (hpkg.bst_init p hp) hin_p hreach_p
          (pkg.F_idx p) (pkg.u_gap p) (hpkg.f_strictMono p hp) (hpkg.f_lt_last p hp)
          (hpkg.run_dom p hp) (hpkg.u_gap_len p hp) (hpkg.gap_bound p hp)
      obtain ⟨seq_tam, hval_tam, hexec_tam, hcnt_tam⟩ :=
        h_tamari (2 * Δ_ℓ) (2 * i_ℓ) G_odd (pkg.G_end p) hbst_odd (hpkg.bst_end p hp)
          hin_odd hdom_odd
      have hval_tam' : ValidRightRotSeq (2 * Δ_ℓ) (2 * i_ℓ)
          (execRightRotSeq (eraseNatKeys (pkg.G_init p)) seq_odd) seq_tam := by
        simpa only [hexec_odd] using hval_tam
      obtain ⟨hval_p, hexec_p, hcnt_p⟩ :=
        h_seq_append (2 * Δ_ℓ) (2 * i_ℓ) (eraseNatKeys (pkg.G_init p)) seq_odd seq_tam
          hval_odd hval_tam'
      refine ⟨seq_odd ++ seq_tam, hval_p, ?_, ?_⟩
      · rw [hexec_p, hexec_odd, hexec_tam]
      · rw [hcnt_p, hcnt_tam, Nat.add_zero]
        exact hF_bound
    let seq_within : ℕ → List RightRotOp :=
      fun p => if hp : p < N_X then Classical.choose (h_within_phase p hp) else []
    let c_fn : ℕ → ℕ := fun p => countGappedCascades (seq_within p)
    have hseq_within_spec : ∀ p < N_X,
        ValidRightRotSeq (2 * Δ_ℓ) (2 * i_ℓ) (eraseNatKeys (pkg.G_init p)) (seq_within p) ∧
        execRightRotSeq (eraseNatKeys (pkg.G_init p)) (seq_within p) = eraseNatKeys (pkg.G_end p) ∧
        25 * (pkg.F_idx p).length ≤ 100 * i_ℓ * c_fn p + 100 * i_ℓ + (pkg.u_gap p).sum := by
      intro p hp
      dsimp (config := { failIfUnchanged := false }) only [seq_within, c_fn]
      rw [dif_pos hp]
      exact Classical.choose_spec (h_within_phase p hp)
    have hstep : ∀ p, p + 1 < N_X →
        ∃ seq_p : List RightRotOp,
          ValidRightRotSeq (2 * Δ_ℓ) (2 * i_ℓ) (eraseNatKeys (pkg.G_init p)) seq_p ∧
          execRightRotSeq (eraseNatKeys (pkg.G_init p)) seq_p =
            .node () .nil (eraseNatKeys (pkg.G_init (p + 1))) ∧
          countGappedCascades seq_p = c_fn p := by
      intro p hp1
      have hp : p < N_X := by omega
      obtain ⟨hval_w, hexec_w, _⟩ := hseq_within_spec p hp
      obtain ⟨seq_tr, hval_tr, hexec_tr, hcnt_tr⟩ :=
        h_phase_step (2 * Δ_ℓ) (2 * i_ℓ) p N_X (pkg.G_end p) (pkg.G_init (p + 1))
          hp1 (hpkg.bst_end p hp) (hpkg.bst_init (p + 1) hp1)
          (hpkg.inorder_end p hp) (hpkg.inorder_init (p + 1) hp1) (hpkg.phase_dom p hp1)
      have hval_tr' : ValidRightRotSeq (2 * Δ_ℓ) (2 * i_ℓ)
          (execRightRotSeq (eraseNatKeys (pkg.G_init p)) (seq_within p)) seq_tr := by
        simpa only [hexec_w] using hval_tr
      obtain ⟨hv_tot, he_tot, hc_tot⟩ :=
        h_seq_append (2 * Δ_ℓ) (2 * i_ℓ) (eraseNatKeys (pkg.G_init p)) (seq_within p) seq_tr
          hval_w hval_tr'
      refine ⟨seq_within p ++ seq_tr, hv_tot, ?_, ?_⟩
      · rw [he_tot, hexec_w, hexec_tr]
      · dsimp (config := { failIfUnchanged := false }) only [c_fn]
        omega
    have hlast : ∃ seq_last : List RightRotOp,
        ValidRightRotSeq (2 * Δ_ℓ) (2 * i_ℓ) (eraseNatKeys (pkg.G_init (N_X - 1))) seq_last ∧
        countGappedCascades seq_last = c_fn (N_X - 1) := by
      have hlast_lt : N_X - 1 < N_X := by omega
      obtain ⟨hval_last, _, _⟩ := hseq_within_spec (N_X - 1) hlast_lt
      exact ⟨seq_within (N_X - 1), hval_last, rfl⟩
    have hc_sum : (Finset.range N_X).sum c_fn ≤ 8 * (2 * Δ_ℓ + 4) * N_X :=
      h_phase_chain h_cascade i_ℓ (2 * Δ_ℓ) N_X pkg.G_init c_fn hi2 hNX1 hNX_ack
        (hpkg.inorder_init 0 (by omega)) hstep hlast
    have h_p_each : ∀ p ∈ Finset.range N_X,
        25 * (pkg.F_idx p).length ≤ (100 * i_ℓ * c_fn p + 100 * i_ℓ) + (pkg.u_gap p).sum := by
      intro p hp
      rw [Finset.mem_range] at hp
      have := (hseq_within_spec p hp).2.2
      omega
    have h_p_sum := Finset.sum_le_sum h_p_each
    rw [← Finset.mul_sum, Finset.sum_add_distrib, Finset.sum_add_distrib, ← Finset.mul_sum,
      Finset.sum_const, Finset.card_range, smul_eq_mul] at h_p_sum
    have h_coef_mul : 100 * i_ℓ * (Finset.range N_X).sum c_fn + N_X * (100 * i_ℓ) ≤
        100 * i_ℓ * (8 * (2 * Δ_ℓ + 4) + 1) * N_X := by
      calc
        100 * i_ℓ * (Finset.range N_X).sum c_fn + N_X * (100 * i_ℓ)
          ≤ 100 * i_ℓ * (8 * (2 * Δ_ℓ + 4) * N_X) + N_X * (100 * i_ℓ) :=
            Nat.add_le_add_right (Nat.mul_le_mul_left (100 * i_ℓ) hc_sum) _
        _ = 100 * i_ℓ * (8 * (2 * Δ_ℓ + 4) + 1) * N_X := by ring
    exact le_trans h_p_sum (Nat.add_le_add_right h_coef_mul _)

  have h_split_len : ∀ (S_next lo hi : ℕ),
      ((splitBlock S_next lo hi).length - 1) * S_next ≤ hi - lo ∧
        (splitBlock S_next lo hi).length - 1 ≤ hi - lo := by
    intro S_next lo hi
    unfold splitBlock
    dsimp (config := { failIfUnchanged := false }) only
    by_cases hK : (hi - lo) / S_next ≤ 1
    · simp [hK]
    · simp only [hK, ↓reduceIte, List.length_append, List.length_map, List.length_range,
        List.length_singleton]
      set K := (hi - lo) / S_next
      have hK2 : 2 ≤ K := by omega
      have hlen : K - 1 + 1 - 1 = K - 1 := by omega
      rw [hlen]
      have h1 : (K - 1) * S_next ≤ K * S_next := Nat.mul_le_mul_right S_next (by omega)
      have h2 : K * S_next ≤ hi - lo := Nat.div_mul_le_self (hi - lo) S_next
      have h3 : K ≤ hi - lo := Nat.div_le_self (hi - lo) S_next
      omega

  have h_getD_sum : ∀ (xs : List (ℕ × ℕ)),
      (Finset.range xs.length).sum (fun i => (xs.getD i (0, 0)).2 - (xs.getD i (0, 0)).1) =
        (xs.map (fun b => b.2 - b.1)).sum := by
    intro xs
    induction xs with
    | nil => simp
    | cons x xs ih =>
      rw [List.length_cons, Finset.sum_range_succ']
      simp only [List.getD, List.getElem?_cons_zero, List.getElem?_cons_succ,
        Option.getD_some, List.map_cons, List.sum_cons] at ih ⊢
      omega

  let M_scale : ℕ → ℕ := fun ℓ =>
    (Finset.range (scaleBlocks S P (ℓ - 1)).length).sum (fun Xi =>
      let X := (scaleBlocks S P (ℓ - 1)).getD Xi (0, 0)
      let NX := (splitBlock (S ℓ) X.1 X.2).length - 1
      (Finset.range NX).sum (fun p => ((pkgs ℓ Xi).F_idx p).length))

  let G_scale : ℕ → ℕ := fun ℓ =>
    (Finset.range (scaleBlocks S P (ℓ - 1)).length).sum (fun Xi =>
      let X := (scaleBlocks S P (ℓ - 1)).getD Xi (0, 0)
      let NX := (splitBlock (S ℓ) X.1 X.2).length - 1
      (Finset.range NX).sum (fun p => ((pkgs ℓ Xi).u_gap p).sum))

  have h_scale_nat : ∀ ℓ, 1 ≤ ℓ → ℓ ≤ L →
      ∃ B_ℓ : ℕ, 25 * M_scale ℓ ≤ B_ℓ + G_scale ℓ ∧ w ℓ * B_ℓ ≤ 25 * P := by
    intro ℓ hℓ1 hℓL
    let i_ℓ := invAckermann (2 * S (ℓ - 1)) + 1
    let Δ_ℓ := 200 * i_ℓ
    let coef_ℓ := 100 * i_ℓ * (8 * (2 * Δ_ℓ + 4) + 1)
    let xs := scaleBlocks S P (ℓ - 1)
    let NX_fn : ℕ → ℕ := fun Xi =>
      (splitBlock (S ℓ) (xs.getD Xi (0, 0)).1 (xs.getD Xi (0, 0)).2).length - 1
    have hi2 : 2 ≤ i_ℓ := (h_row1 (2 * S (ℓ - 1))).1
    have hack : 2 * S (ℓ - 1) ≤ ackermann i_ℓ 1 := (h_row1 (2 * S (ℓ - 1))).2
    refine ⟨(Finset.range xs.length).sum (fun Xi => coef_ℓ * NX_fn Xi), ?_, ?_⟩
    · have h_each : ∀ Xi ∈ Finset.range xs.length,
          25 * (Finset.range (NX_fn Xi)).sum (fun p => ((pkgs ℓ Xi).F_idx p).length) ≤
            coef_ℓ * NX_fn Xi +
              (Finset.range (NX_fn Xi)).sum (fun p => ((pkgs ℓ Xi).u_gap p).sum) := by
        intro Xi hXi_mem
        rw [Finset.mem_range] at hXi_mem
        have h2len := (hpart.child_blocks ℓ hℓ1 hℓL Xi hXi_mem).1
        have hNX1 : 1 ≤ NX_fn Xi := by
          dsimp (config := { failIfUnchanged := false }) only [NX_fn, xs] at h2len ⊢
          omega
        have hΔ_ge : 100 * i_ℓ + 2 ≤ Δ_ℓ := by omega
        have hX_mem : xs.getD Xi (0, 0) ∈ xs := by
          rw [List.getD_eq_getElem xs (0, 0) hXi_mem]
          exact List.getElem_mem hXi_mem
        have hX_bds := hpart.blocks_bounds (ℓ - 1) (by omega) _ hX_mem
        have hNX_le_diff := (h_split_len (S ℓ) (xs.getD Xi (0, 0)).1
          (xs.getD Xi (0, 0)).2).2
        have hNX_ack : NX_fn Xi ≤ ackermann i_ℓ 1 :=
          le_trans hNX_le_diff (le_trans (Nat.le_of_lt hX_bds.2.2.2) hack)
        exact h_block ℓ hℓ1 hℓL Xi hXi_mem hNX1 hi2 hΔ_ge hNX_ack
      have hsum := Finset.sum_le_sum h_each
      rw [← Finset.mul_sum, Finset.sum_add_distrib] at hsum
      exact hsum
    · have hS_eq : S ℓ = 13000 * w ℓ * i_ℓ ^ 2 := hS_def ℓ hℓ1 hℓL
      have hi_pow : i_ℓ ≤ i_ℓ ^ 2 := by nlinarith
      have hwi_mul : w ℓ * i_ℓ ≤ w ℓ * i_ℓ ^ 2 := Nat.mul_le_mul_left (w ℓ) hi_pow
      have h_coef_bound : w ℓ * coef_ℓ ≤ 25 * S ℓ := by
        rw [hS_eq]
        have hexp : w ℓ * coef_ℓ = 320000 * (w ℓ * i_ℓ ^ 2) + 3300 * (w ℓ * i_ℓ) := by
          dsimp (config := { failIfUnchanged := false }) only [coef_ℓ, Δ_ℓ]
          ring
        have hrhs : 25 * (13000 * w ℓ * i_ℓ ^ 2) = 325000 * (w ℓ * i_ℓ ^ 2) := by ring
        rw [hexp, hrhs]
        linarith
      have h_blk : ∀ Xi ∈ Finset.range xs.length,
          w ℓ * (coef_ℓ * NX_fn Xi) ≤
            25 * ((xs.getD Xi (0, 0)).2 - (xs.getD Xi (0, 0)).1) := by
        intro Xi _
        have h2 := (h_split_len (S ℓ) (xs.getD Xi (0, 0)).1
          (xs.getD Xi (0, 0)).2).1
        calc
          w ℓ * (coef_ℓ * NX_fn Xi)
            = (w ℓ * coef_ℓ) * NX_fn Xi := by ring
          _ ≤ (25 * S ℓ) * NX_fn Xi := Nat.mul_le_mul_right _ h_coef_bound
          _ = 25 * (NX_fn Xi * S ℓ) := by ring
          _ ≤ 25 * ((xs.getD Xi (0, 0)).2 - (xs.getD Xi (0, 0)).1) :=
              Nat.mul_le_mul_left 25 h2
      rw [Finset.mul_sum]
      refine le_trans (Finset.sum_le_sum h_blk) ?_
      rw [← Finset.mul_sum, h_getD_sum xs, hpart.blocks_sum (ℓ - 1) (by omega)]

  have h_each_q : ∀ ℓ ∈ Finset.Icc 1 L,
      (25 : ℚ) * (M_scale ℓ : ℚ) ≤
        (25 * (P : ℚ)) * ((1 : ℚ) / (w ℓ : ℚ)) + (G_scale ℓ : ℚ) := by
    intro ℓ hℓ
    rw [Finset.mem_Icc] at hℓ
    obtain ⟨B_ℓ, hMB, hBP⟩ := h_scale_nat ℓ hℓ.1 hℓ.2
    have hMB_q : ((25 * M_scale ℓ : ℕ) : ℚ) ≤ ((B_ℓ + G_scale ℓ : ℕ) : ℚ) := by
      exact_mod_cast hMB
    push_cast at hMB_q
    have hBP_q : ((w ℓ * B_ℓ : ℕ) : ℚ) ≤ ((25 * P : ℕ) : ℚ) := by
      exact_mod_cast hBP
    push_cast at hBP_q
    have hw_pos_q : (0 : ℚ) < (w ℓ : ℚ) := by
      have : (1 : ℚ) ≤ (w ℓ : ℚ) := by exact_mod_cast hw_pos ℓ hℓ.1 hℓ.2
      linarith
    have hB_div : (B_ℓ : ℚ) ≤ (25 * (P : ℚ)) / (w ℓ : ℚ) := by
      rw [le_div_iff₀ hw_pos_q]
      linarith
    have h_eq : (25 * (P : ℚ)) / (w ℓ : ℚ) = (25 * (P : ℚ)) * ((1 : ℚ) / (w ℓ : ℚ)) := by
      ring
    linarith

  have h_sum_q := Finset.sum_le_sum h_each_q
  rw [← Finset.mul_sum, Finset.sum_add_distrib, ← Finset.mul_sum] at h_sum_q
  have h_P_mul : (25 * (P : ℚ)) *
      (Finset.Icc 1 L).sum (fun ℓ : ℕ => (1 : ℚ) / (w ℓ : ℚ)) ≤
      (25 * (P : ℚ)) * 1 :=
    mul_le_mul_of_nonneg_left hw_sum (by positivity)
  have h_mov_eq : totalPkgMovers S P L pkgs = (Finset.Icc 1 L).sum M_scale := rfl
  have h_gap_eq : totalGapWeight S P L pkgs = (Finset.Icc 1 L).sum G_scale := rfl
  have h_tot_q : ((25 * totalPkgMovers S P L pkgs : ℕ) : ℚ) ≤
      ((25 * P + totalGapWeight S P L pkgs : ℕ) : ℚ) := by
    rw [h_mov_eq, h_gap_eq]
    simp only [Nat.cast_add, Nat.cast_mul, Nat.cast_sum, Nat.cast_ofNat]
    linarith
  exact_mod_cast h_tot_q

