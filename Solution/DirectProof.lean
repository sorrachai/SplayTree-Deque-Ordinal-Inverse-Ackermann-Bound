            have h1 := hp_ack 2
            omega
          · let J := scaleQ (p + 1) (j0 + 1)
            change ackermann (p + 2) (ackermann (p + 3) (j0 + 1)) ≤ 4 * scaleQ p J * J
            have h1 : ackermann (p + 2) (ackermann (p + 3) (j0 + 1)) ≤
                scaleQ p (ackermann (p + 3) (j0 + 1)) := hp_ack _
            have h2 : scaleQ p (ackermann (p + 3) (j0 + 1)) ≤ scaleQ p J := hp_mono ih
            have hJ_pos : 1 ≤ J := h_pos (j0 + 1)
            nlinarith
      exact ⟨h_pos, fun j hj => by rcases j with _ | j0; omega; exact h_ge12 j0, h_mono, h_ack⟩




  have h_12D_base :
      ∀ (k : ℕ) (w : _root_.BinaryTree Unit) (w_seq : List RightRotOp),
        4 ≤ k →
        w.num_nodes = 12 * D →
