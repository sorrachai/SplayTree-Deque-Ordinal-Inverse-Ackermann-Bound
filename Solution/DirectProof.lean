          have h_eq1 : M * S = 48 * D * q2 := by dsimp (config := { failIfUnchanged := false }) [M, S]; ring
          rw [h_eq1] at hc
          nlinarith
        | succ j0 ih_j =>
          intro u seq hu_n hv
          let J := scaleQ (p + 1) (j0 + 1)
          have hJ12 : 12 ≤ J := (h_scaleQ_props (p + 1)).2.1 (j0 + 1) (by omega)
          let qJ := scaleQ p J
