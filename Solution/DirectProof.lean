theorem primal_keyed_labeling_and_cost_bridge (P : ℕ) (ops : List CoreOp) (hP : 1 ≤ P) (hvalid : ValidCoreSeq P ops) :
    ∃ kops : List KeyedCoreOp,
      kops.map eraseKeyedOp = ops ∧
      ValidKeyedCoreSeq P kops ∧
      PrimalJumpLaws P kops ∧
      countKeyedRslr kops ≤ 2 * P ∧
      coreCascadeCost ops ≤ P + (jumps kops).length :=
by
  have _ := hP
  have h_erase_empty : ∀ T : _root_.BinaryTree ℕ, eraseNatKeys T = .nil ↔ T = .nil := by
    intro T; cases T <;> simp [eraseNatKeys]

  have h_map_empty : ∀ (f : ℕ → ℕ) (T : _root_.BinaryTree ℕ), twMapTree f T = .nil ↔ T = .nil := by
    intro f T; cases T <;> simp [twMapTree]

  have h_ls_aux : ∀ (T : _root_.BinaryTree ℕ) (acc : List ℕ),
      leftSpineBottomUpAux T acc = leftSpineBottomUpAux T [] ++ acc := by
    intro T
    induction T with
    | nil => intro acc; simp [leftSpineBottomUpAux]
    | node k l r ihl _ =>
      intro acc
      simp only [leftSpineBottomUpAux]
      rw [ihl (k :: acc), ihl [k], List.append_assoc]
      rfl

  have h_ls_node : ∀ (l : _root_.BinaryTree ℕ) (k : ℕ) (r : _root_.BinaryTree ℕ),
      leftSpineBottomUpNat (.node k l r) = leftSpineBottomUpNat l ++ [k] := by
    intro l k r
    unfold leftSpineBottomUpNat
    simp only [leftSpineBottomUpAux]
    exact h_ls_aux l [k]

  have h_ls_len : ∀ T : _root_.BinaryTree ℕ,
      (leftSpineBottomUpNat T).length = leftSpineLen (eraseNatKeys T) := by
    intro T
    induction T with
    | nil => rfl
    | node k l r ihl _ =>
      rw [h_ls_node, List.length_append, List.length_singleton, ihl]
      simp only [eraseNatKeys, leftSpineLen]
      omega

  have h_ls_map : ∀ (f : ℕ → ℕ) (T : _root_.BinaryTree ℕ),
      leftSpineBottomUpNat (twMapTree f T) = (leftSpineBottomUpNat T).map f := by
    intro f T
    induction T with
    | nil => rfl
    | node k l r ihl _ =>
      simp only [twMapTree, h_ls_node, List.map_append, List.map_singleton, ihl]

  have h_rs_len : ∀ T : _root_.BinaryTree ℕ,
      (rightSpineTopDownNat T).length = rightSpineLen (eraseNatKeys T) := by
    intro T
    induction T with
    | nil => rfl
    | node k l r _ ihr =>
      simp only [rightSpineTopDownNat, List.length_cons, eraseNatKeys, rightSpineLen, ihr]
      omega

  have h_rs_map : ∀ (f : ℕ → ℕ) (T : _root_.BinaryTree ℕ),
      rightSpineTopDownNat (twMapTree f T) = (rightSpineTopDownNat T).map f := by
    intro f T
    induction T with
    | nil => rfl
    | node k l r _ ihr =>
      simp only [twMapTree, rightSpineTopDownNat, List.map_cons, ihr]

  have h_rotL_props : ∀ (d : ℕ) (T : _root_.BinaryTree ℕ),
      eraseNatKeys (rotateLeftAtRightDepthNat T d) = rotateLeftAtRightDepth (eraseNatKeys T) d ∧
      inorderNat (rotateLeftAtRightDepthNat T d) = inorderNat T ∧
      (∀ f : ℕ → ℕ, rotateLeftAtRightDepthNat (twMapTree f T) d =
        twMapTree f (rotateLeftAtRightDepthNat T d)) := by
    intro d
    induction d with
    | zero =>
      intro T
      rcases T with _ | ⟨x, a, _ | ⟨y, b, c⟩⟩
      · simp [rotateLeftAtRightDepthNat, rotateLeftAtRightDepth, _root_.BinaryTree.rotateLeft,
          eraseNatKeys, inorderNat, twMapTree]
      · simp [rotateLeftAtRightDepthNat, rotateLeftAtRightDepth, _root_.BinaryTree.rotateLeft,
          eraseNatKeys, inorderNat, twMapTree]
      · simp [rotateLeftAtRightDepthNat, rotateLeftAtRightDepth, _root_.BinaryTree.rotateLeft,
          eraseNatKeys, inorderNat, twMapTree, List.append_assoc]
    | succ d ih =>
      intro T
      rcases T with _ | ⟨k, l, r⟩
      · simp [rotateLeftAtRightDepthNat, rotateLeftAtRightDepth, eraseNatKeys, inorderNat, twMapTree]
      · obtain ⟨he, hi, hm⟩ := ih r
        refine ⟨?_, ?_, ?_⟩
        · simp [rotateLeftAtRightDepthNat, rotateLeftAtRightDepth, eraseNatKeys, he]
        · simp [rotateLeftAtRightDepthNat, inorderNat, hi]
        · intro f; simp [rotateLeftAtRightDepthNat, twMapTree, hm f]

  have h_descend_props : ∀ (T : _root_.BinaryTree ℕ) (acc : List (ℕ × _root_.BinaryTree ℕ)),
      T ≠ .nil →
      descendLeft (eraseNatKeys T) (acc.map (fun p => eraseNatKeys p.2)) =
        (eraseNatKeys (descendLeftNat T acc).1,
          (descendLeftNat T acc).2.map (fun p => eraseNatKeys p.2)) ∧
      (∀ f : ℕ → ℕ,
        descendLeftNat (twMapTree f T) (acc.map (fun p => (f p.1, twMapTree f p.2))) =
          (twMapTree f (descendLeftNat T acc).1,
            (descendLeftNat T acc).2.map (fun p => (f p.1, twMapTree f p.2)))) ∧
      ((leftSpineBottomUpNat T).head? = some ((leftSpineBottomUpNat T).headD 0) ∧
        (leftSpineBottomUpNat T).headD 0 ::
          (inorderNat (descendLeftNat T acc).1 ++ pklPathInorder (descendLeftNat T acc).2) =
          inorderNat T ++ pklPathInorder acc) := by
    intro T
    induction T with
    | nil => intro _ h; exact absurd rfl h
    | node k l r ihl _ =>
      intro acc _
      rcases l with _ | ⟨lk, ll, lr⟩
      · refine ⟨by simp [eraseNatKeys, descendLeft, descendLeftNat],
          fun f => by simp [twMapTree, descendLeftNat], ?_, ?_⟩
        · simp [leftSpineBottomUpNat, leftSpineBottomUpAux]
        · simp [leftSpineBottomUpNat, leftSpineBottomUpAux, descendLeftNat, inorderNat]
      · obtain ⟨he, hm, hhd, hin⟩ := ihl ((k, r) :: acc) (by simp)
        refine ⟨?_, ?_, ?_, ?_⟩
        · simpa [eraseNatKeys, descendLeft, descendLeftNat] using he
        · intro f; simpa [twMapTree, descendLeftNat] using hm f
        · rw [h_ls_node]
          rcases hls : leftSpineBottomUpNat (.node lk ll lr) with _ | ⟨s0, tl⟩
          · rw [hls] at hhd; simp at hhd
          · simp
        · have hhd_eq : (leftSpineBottomUpNat (.node k (.node lk ll lr) r)).headD 0 =
              (leftSpineBottomUpNat (.node lk ll lr)).headD 0 := by
            rw [h_ls_node]
            rcases hls : leftSpineBottomUpNat (.node lk ll lr) with _ | ⟨s0, tl⟩
            · rw [hls] at hhd; simp at hhd
            · rfl
          rw [hhd_eq]
          simp only [descendLeftNat]
          rw [hin]
          simp [inorderNat, pklPathInorder, List.append_assoc]

  have h_splay_props : ∀ (n : ℕ) (c : _root_.BinaryTree ℕ) (path : List (ℕ × _root_.BinaryTree ℕ)),
      path.length ≤ n →
      eraseNatKeys (splayLeftSpineNat c path) =
        splayLeftSpine (eraseNatKeys c) (path.map (fun p => eraseNatKeys p.2)) ∧
      (∀ f : ℕ → ℕ, splayLeftSpineNat (twMapTree f c) (path.map (fun p => (f p.1, twMapTree f p.2))) =
        twMapTree f (splayLeftSpineNat c path)) ∧
      inorderNat (splayLeftSpineNat c path) = inorderNat c ++ pklPathInorder path := by
    intro n
    induction n with
    | zero =>
      intro c path hlen
      rcases path with _ | ⟨p1, rest⟩
      · simp [splayLeftSpineNat, splayLeftSpine, pklPathInorder]
      · simp at hlen
    | succ n ih =>
      intro c path hlen
      rcases path with _ | ⟨⟨k1, r1⟩, _ | ⟨⟨k2, r2⟩, rest⟩⟩
      · simp [splayLeftSpineNat, splayLeftSpine, pklPathInorder]
      · simp [splayLeftSpineNat, splayLeftSpine, eraseNatKeys, twMapTree, inorderNat,
          pklPathInorder, List.append_assoc]
      · have hrest : rest.length ≤ n := by simp at hlen; omega
        obtain ⟨he, hm, hin⟩ := ih (.node k1 c (.node k2 r1 r2)) rest hrest
        refine ⟨?_, ?_, ?_⟩
        · simpa [splayLeftSpineNat, splayLeftSpine, eraseNatKeys] using he
        · intro f; simpa [splayLeftSpineNat, twMapTree] using hm f
        · simp only [splayLeftSpineNat]
          rw [hin]
          simp [inorderNat, pklPathInorder, List.append_assoc]

  have h_pop_props : ∀ (T : _root_.BinaryTree ℕ),
      T ≠ .nil →
      eraseNatKeys (popNat T) = popUnlabeled (eraseNatKeys T) ∧
      (∀ f : ℕ → ℕ, popNat (twMapTree f T) = twMapTree f (popNat T)) ∧
      (leftSpineBottomUpNat T).head? = some ((leftSpineBottomUpNat T).headD 0) ∧
      inorderNat T = (leftSpineBottomUpNat T).headD 0 :: inorderNat (popNat T) := by
    intro T hT
    obtain ⟨hde, hdm, hhd, hdin⟩ := h_descend_props T [] hT
    obtain ⟨hse, hsm, hsin⟩ := h_splay_props (descendLeftNat T []).2.length
      (descendLeftNat T []).1 (descendLeftNat T []).2 le_rfl
    refine ⟨?_, ?_, hhd, ?_⟩
    · unfold popNat popUnlabeled
      dsimp (config := { failIfUnchanged := false }) only
      rw [hse]
      have h1 : descendLeft (eraseNatKeys T) [] =
          (eraseNatKeys (descendLeftNat T []).1,
            (descendLeftNat T []).2.map (fun p => eraseNatKeys p.2)) := hde
      rw [h1]
    · intro f
      unfold popNat
      have h1 : descendLeftNat (twMapTree f T) [] =
          (twMapTree f (descendLeftNat T []).1,
            (descendLeftNat T []).2.map (fun p => (f p.1, twMapTree f p.2))) := hdm f
      rw [h1]
      exact hsm f
    · unfold popNat
      dsimp (config := { failIfUnchanged := false }) only
      rw [hsin]
      simp only [pklPathInorder, List.append_nil] at hdin
      exact hdin.symm

  have h_erase_pop_all : ∀ T : _root_.BinaryTree ℕ,
      eraseNatKeys (popNat T) = popUnlabeled (eraseNatKeys T) := by
    intro T
    rcases T with _ | ⟨k, l, r⟩
    · simp [popNat, popUnlabeled, descendLeftNat, descendLeft, splayLeftSpineNat,
        splayLeftSpine, eraseNatKeys]
    · exact (h_pop_props (.node k l r) (by simp)).1

  have h_erase_exec : ∀ (H : _root_.BinaryTree ℕ) (op : KeyedCoreOp),
      eraseNatKeys (execKeyedOp H op) = execCoreOp (eraseNatKeys H) (eraseKeyedOp op) := by
    intro H op
    rcases op with w | s | d
    · rfl
    · exact h_erase_pop_all H
    · exact (h_rotL_props d H).1

  have h_pass1 : ∀ (rest : List CoreOp) (T : _root_.BinaryTree ℕ) (b : ℕ),
      ValidCoreSeqAux (eraseNatKeys T) rest →
      let bops := pklBuildBirthOps T b rest
      let K := countCorePush rest
      bops.map eraseKeyedOp = rest ∧
      pklValidTrace T bops ∧
      pushKeys bops = List.range' b K ∧
      (inorderNat T ++ List.range' b K).Perm (popKeys bops) := by
    intro rest
    induction rest with
    | nil =>
      intro T b hval
      simp only [ValidCoreSeqAux, h_erase_empty] at hval
      subst hval
      simp [pklBuildBirthOps, pklValidTrace, countCorePush, pushKeys, popKeys, inorderNat]
    | cons op rest' ih =>
      intro T b hval
      rcases op with _ | _ | d
      · simp only [ValidCoreSeqAux] at hval
        have hval' : ValidCoreSeqAux (eraseNatKeys (.node b .nil T)) rest' := hval
        obtain ⟨hmap', htr', hpush', hperm'⟩ := ih (.node b .nil T) (b + 1) hval'
        refine ⟨?_, htr', ?_, ?_⟩
        · simp [pklBuildBirthOps, eraseKeyedOp, hmap']
        · simp only [pklBuildBirthOps, pushKeys, countCorePush]
          rw [hpush', Nat.add_comm 1 (countCorePush rest')]
          rfl
        · simp only [pklBuildBirthOps, popKeys, countCorePush]
          rw [Nat.add_comm 1 (countCorePush rest')]
          have hr : List.range' b (countCorePush rest' + 1) =
              b :: List.range' (b + 1) (countCorePush rest') := rfl
          rw [hr]
          have hin : inorderNat (.node b .nil T) = b :: inorderNat T := by simp [inorderNat]
          rw [hin, List.cons_append] at hperm'
          exact List.perm_middle.trans hperm'
      · obtain ⟨hne_e, hval_rest⟩ := hval
        have hT_ne : T ≠ .nil := by
          intro h0; subst h0; exact hne_e rfl
        obtain ⟨he_pop, _, hhd, hin_pop⟩ := h_pop_props T hT_ne
        rw [← he_pop] at hval_rest
        obtain ⟨hmap', htr', hpush', hperm'⟩ := ih (popNat T) b hval_rest
        refine ⟨?_, ⟨hT_ne, hhd, htr'⟩, ?_, ?_⟩
        · simp [pklBuildBirthOps, eraseKeyedOp, hmap']
        · simp [pklBuildBirthOps, pushKeys, countCorePush, hpush']
        · simp only [pklBuildBirthOps, popKeys, countCorePush]
          rw [hin_pop, List.cons_append]
          exact hperm'.cons _
      · obtain ⟨hd_le, hval_rest⟩ := hval
        obtain ⟨he_rot, hin_rot, _⟩ := h_rotL_props d T
        rw [← he_rot] at hval_rest
        obtain ⟨hmap', htr', hpush', hperm'⟩ := ih (rotateLeftAtRightDepthNat T d) b hval_rest
        have hd_le' : d + 2 ≤ (rightSpineTopDownNat T).length := by
          rw [h_rs_len]; exact hd_le
        refine ⟨?_, ⟨hd_le', htr'⟩, ?_, ?_⟩
        · simp [pklBuildBirthOps, eraseKeyedOp, hmap']
        · simp [pklBuildBirthOps, pushKeys, countCorePush, hpush']
        · simp only [pklBuildBirthOps, popKeys, countCorePush]
          rw [← hin_rot]
          exact hperm'

  have h_nodup_idxOf : ∀ (L : List ℕ),
      L.Nodup → L.map (fun x => L.idxOf x) = List.range L.length := by
    intro L
    induction L with
    | nil => intro _; rfl
    | cons a L' ih =>
      intro hnd
      obtain ⟨ha_notin, hnd'⟩ := List.nodup_cons.mp hnd
      simp only [List.map_cons, List.length_cons, List.idxOf_cons_self]
      rw [List.range_succ_eq_map, ← ih hnd', List.map_map]
      congr 1
      refine List.map_congr_left ?_
      intro x hx
      have hne : a ≠ x := fun h => ha_notin (h ▸ hx)
      exact List.idxOf_cons_ne L' hne

  have h_trace_map : ∀ (f : ℕ → ℕ) (xs : List KeyedCoreOp) (H : _root_.BinaryTree ℕ),
      pklValidTrace H xs → pklValidTrace (twMapTree f H) (xs.map (pklMapKeyedOp f)) := by
    intro f xs
    induction xs with
    | nil =>
      intro H htr
      simp only [pklValidTrace] at htr
      subst htr; rfl
    | cons op rest ih =>
      intro H htr
      rcases op with w | s | d
      · exact ih (.node w .nil H) htr
      · obtain ⟨hne, hhd, htr'⟩ := htr
        have hne_f : twMapTree f H ≠ .nil := by
          rw [ne_eq, h_map_empty]; exact hne
        have hhd_f : (leftSpineBottomUpNat (twMapTree f H)).head? = some (f s) := by
          rw [h_ls_map, List.head?_map, hhd]; rfl
        have hpop_f := (h_pop_props H hne).2.1 f
        simp only [List.map_cons, pklMapKeyedOp, pklValidTrace]
        rw [hpop_f]
        exact ⟨hne_f, hhd_f, ih (popNat H) htr'⟩
      · obtain ⟨hd_le, htr'⟩ := htr
        have hd_le_f : d + 2 ≤ (rightSpineTopDownNat (twMapTree f H)).length := by
          rw [h_rs_map, List.length_map]; exact hd_le
        have hrot_f := (h_rotL_props d H).2.2 f
        simp only [List.map_cons, pklMapKeyedOp, pklValidTrace]
        rw [hrot_f]
        exact ⟨hd_le_f, ih (rotateLeftAtRightDepthNat H d) htr'⟩

  have h_pushKeys_map : ∀ (f : ℕ → ℕ) (xs : List KeyedCoreOp),
      pushKeys (xs.map (pklMapKeyedOp f)) = (pushKeys xs).map f := by
    intro f xs
    induction xs with
    | nil => rfl
    | cons op rest ih => rcases op <;> simp [pklMapKeyedOp, pushKeys, ih]

  have h_popKeys_map : ∀ (f : ℕ → ℕ) (xs : List KeyedCoreOp),
      popKeys (xs.map (pklMapKeyedOp f)) = (popKeys xs).map f := by
    intro f xs
    induction xs with
    | nil => rfl
    | cons op rest ih => rcases op <;> simp [pklMapKeyedOp, popKeys, ih]

  have h_erase_map : ∀ (f : ℕ → ℕ) (xs : List KeyedCoreOp),
      (xs.map (pklMapKeyedOp f)).map eraseKeyedOp = xs.map eraseKeyedOp := by
    intro f xs
    induction xs with
    | nil => rfl
    | cons op rest ih => rcases op <;> simp [pklMapKeyedOp, eraseKeyedOp, ih]

  have h_rslr_rot : ∀ (d : ℕ) (t : _root_.BinaryTree Unit),
      d + 2 ≤ rightSpineLen t →
      rightSpineLen (rotateLeftAtRightDepth t d) + 1 = rightSpineLen t := by
    intro d
    induction d with
    | zero =>
      intro t h
      rcases t with _ | ⟨_, a, _ | ⟨_, b, c⟩⟩
      · simp [rightSpineLen] at h
      · simp [rightSpineLen] at h
      · simp [rotateLeftAtRightDepth, _root_.BinaryTree.rotateLeft, rightSpineLen]
        omega
    | succ d ih =>
      intro t h
      rcases t with _ | ⟨_, l, r⟩
      · simp [rightSpineLen] at h
      · simp only [rightSpineLen] at h
        have hr := ih r (by omega)
        simp only [rotateLeftAtRightDepth, rightSpineLen]
        omega

  have h_descend_u_app : ∀ (u : _root_.BinaryTree Unit) (a1 a2 : List (_root_.BinaryTree Unit)),
      u ≠ .nil →
      descendLeft u (a1 ++ a2) = ((descendLeft u a1).1, (descendLeft u a1).2 ++ a2) := by
    intro u
    induction u with
    | nil => intro _ _ h; exact absurd rfl h
    | node _ l r ihl _ =>
      intro a1 a2 _
      rcases l with _ | ⟨_, ll, lr⟩
      · simp [descendLeft]
      · simp only [descendLeft]
        rw [← List.cons_append]
        exact ihl (r :: a1) a2 (by simp)

  have h_splay_u_rs : ∀ (n : ℕ) (c : _root_.BinaryTree Unit) (p : List (_root_.BinaryTree Unit)) (r0 : _root_.BinaryTree Unit),
      p.length ≤ n →
      rightSpineLen (splayLeftSpine c (p ++ [r0])) ≤ 2 + rightSpineLen r0 := by
    intro n
    induction n with
    | zero =>
      intro c p r0 hlen
      rcases p with _ | ⟨r1, rest⟩
      · simp [splayLeftSpine, rightSpineLen]
      · simp at hlen
    | succ n ih =>
      intro c p r0 hlen
      rcases p with _ | ⟨r1, _ | ⟨r2, rest⟩⟩
      · simp [splayLeftSpine, rightSpineLen]
      · simp [splayLeftSpine, rightSpineLen]; omega
      · have hrest : rest.length ≤ n := by simp at hlen; omega
        simpa [List.cons_append, splayLeftSpine] using ih (.node () c (.node () r1 r2)) rest r0 hrest

  have h_pop_u_rs : ∀ t : _root_.BinaryTree Unit,
      t ≠ .nil → rightSpineLen (popUnlabeled t) ≤ rightSpineLen t + 1 := by
    intro t ht
    rcases t with _ | ⟨_, l, r0⟩
    · exact absurd rfl ht
    · rcases l with _ | ⟨_, ll, lr⟩
      · simp [popUnlabeled, descendLeft, splayLeftSpine, rightSpineLen]; omega
      · have happ := h_descend_u_app (.node () ll lr) [] [r0] (by simp)
        simp only [List.nil_append] at happ
        have hpop : popUnlabeled (.node () (.node () ll lr) r0) =
            splayLeftSpine (descendLeft (.node () ll lr) []).1
              ((descendLeft (.node () ll lr) []).2 ++ [r0]) := by
          simp [popUnlabeled, descendLeft, happ]
        rw [hpop]
        have hsp := h_splay_u_rs (descendLeft (.node () ll lr) []).2.length
          (descendLeft (.node () ll lr) []).1 (descendLeft (.node () ll lr) []).2 r0 le_rfl
        simp only [rightSpineLen]
        omega

  have h_rslr_telescoping : ∀ (rest : List CoreOp) (t : _root_.BinaryTree Unit),
      ValidCoreSeqAux t rest →
      pklCountCoreRslr rest ≤ rightSpineLen t + countCorePush rest + countCorePop rest := by
    intro rest
    induction rest with
    | nil =>
      intro t hval; subst hval; simp [pklCountCoreRslr, rightSpineLen, countCorePush, countCorePop]
    | cons op rest' ih =>
      intro t hval
      rcases op with _ | _ | d
      · have h1 := ih (.node () .nil t) hval
        simp only [pklCountCoreRslr, countCorePush, countCorePop, rightSpineLen] at h1 ⊢
        omega
      · obtain ⟨hne, hval'⟩ := hval
        have h1 := ih (popUnlabeled t) hval'
        have h2 := h_pop_u_rs t hne
        simp only [pklCountCoreRslr, countCorePush, countCorePop] at h1 ⊢
        omega
      · obtain ⟨hd, hval'⟩ := hval
        have h1 := ih (rotateLeftAtRightDepth t d) hval'
        have h2 := h_rslr_rot d t hd
        simp only [pklCountCoreRslr, countCorePush, countCorePop] at h1 ⊢
        omega

  have h_count_rslr_erase : ∀ xs : List KeyedCoreOp,
      countKeyedRslr xs = pklCountCoreRslr (xs.map eraseKeyedOp) := by
    intro xs
    induction xs with
    | nil => rfl
    | cons op rest ih => rcases op <;> simp [countKeyedRslr, eraseKeyedOp, pklCountCoreRslr, ih]

  have h_cost_jumps : ∀ (rest : List KeyedCoreOp) (nextId step : ℕ) (H : _root_.BinaryTree ℕ),
      coreCascadeCostAux (eraseNatKeys H) (rest.map eraseKeyedOp) ≤
        countCorePop (rest.map eraseKeyedOp) + (jumpsAux nextId step H rest).length := by
    intro rest
    induction rest with
    | nil => intro _ _ _; simp [coreCascadeCostAux, countCorePop, jumpsAux]
    | cons op rest' ih =>
      intro nextId step H
      rcases op with w | s | d
      · have h1 := ih nextId (step + 1) (execKeyedOp H (.push w))
        rw [h_erase_exec] at h1
        simpa [eraseKeyedOp, coreCascadeCostAux, coreCascadeStepCost, countCorePop, jumpsAux] using h1
      · have h1 := ih (nextId + (popJumpsAt nextId step s (leftSpineBottomUpNat H)).length)
          (step + 1) (execKeyedOp H (.pop s))
        rw [h_erase_exec] at h1
        simp only [eraseKeyedOp, popJumpsAt, List.length_map, List.length_range] at h1
        have hls := h_ls_len H
        simp only [List.map_cons, eraseKeyedOp, coreCascadeCostAux, coreCascadeStepCost,
          countCorePop, jumpsAux, List.length_append, popJumpsAt, List.length_map, List.length_range]
        omega
      · have h1 := ih nextId (step + 1) (execKeyedOp H (.rslr d))
        rw [h_erase_exec] at h1
        simpa [eraseKeyedOp, coreCascadeCostAux, coreCascadeStepCost, countCorePop, jumpsAux] using h1

  have h_rot_in : ∀ (d : ℕ) (T : _root_.BinaryTree ℕ),
      inorderNat (rotateLeftAtRightDepthNat T d) = inorderNat T :=
    fun d T => (h_rotL_props d T).2.1

  have h_pop_in : ∀ (T : _root_.BinaryTree ℕ), T ≠ .nil →
      inorderNat T = (leftSpineBottomUpNat T).headD 0 :: inorderNat (popNat T) :=
    fun T hT => (h_pop_props T hT).2.2.2

  have h_cd : ∀ (kops : List KeyedCoreOp),
      pklValidTrace .nil kops →
      (pushKeys kops).Perm (List.range P) →
      popKeys kops = List.range P →
      ValidKeyedCoreSeq P kops ∧ PrimalJumpLaws P kops := by
    intro kops hk_tr hk_push hk_pop
    have h_tr_end : ∀ (xs : List KeyedCoreOp) (H : _root_.BinaryTree ℕ),
        pklValidTrace H xs → execKeyedList H xs = .nil := by
      intro xs
      induction xs with
      | nil => intro H h; exact h
      | cons op rest ih =>
        intro H h
        rcases op with w | s | d
        · exact ih (.node w .nil H) h
        · exact ih (popNat H) h.2.2
        · exact ih (rotateLeftAtRightDepthNat H d) h.2

    have h_end_empty : keyedState kops kops.length = .nil := by
      unfold keyedState
      rw [List.take_length]
      exact h_tr_end kops .nil hk_tr

    have h_tr_step : ∀ (xs : List KeyedCoreOp) (H : _root_.BinaryTree ℕ),
        pklValidTrace H xs →
        ∀ (t : ℕ) (ht : t < xs.length),
          let Ht := execKeyedList H (xs.take t)
          let Ht1 := execKeyedList H (xs.take (t + 1))
          match xs[t] with
          | .push w => inorderNat Ht1 = w :: inorderNat Ht
          | .pop s =>
              Ht ≠ .nil ∧ (leftSpineBottomUpNat Ht).head? = some s ∧
                inorderNat Ht = s :: inorderNat Ht1
          | .rslr d =>
              d + 2 ≤ (rightSpineTopDownNat Ht).length ∧ inorderNat Ht1 = inorderNat Ht := by
      intro xs
      induction xs with
      | nil => intro _ _ _ ht; simp at ht
      | cons op rest ih =>
        intro H htr t ht
        rcases t with _ | t'
        · rcases op with w | s | d
          · simp [execKeyedList, execKeyedOp, inorderNat]
          · obtain ⟨hne, hhd, _⟩ := htr
            have hs_eq : (leftSpineBottomUpNat H).headD 0 = s := by
              rcases hls : leftSpineBottomUpNat H with _ | ⟨a, tl⟩
              · rw [hls] at hhd; simp at hhd
              · rw [hls] at hhd; simp at hhd; exact hhd
            refine ⟨hne, hhd, ?_⟩
            have hp := h_pop_in H hne
            rw [hs_eq] at hp
            exact hp
          · obtain ⟨hd_le, _⟩ := htr
            exact ⟨hd_le, h_rot_in d H⟩
        · have ht' : t' < rest.length := by simp at ht; omega
          rcases op with w | s | d
          · exact ih (.node w .nil H) htr t' ht'
          · exact ih (popNat H) htr.2.2 t' ht'
          · exact ih (rotateLeftAtRightDepthNat H d) htr.2 t' ht'

    have h_step_trace : ∀ (t : ℕ) (ht : t < kops.length),
        match kops[t] with
        | .push w =>
            inorderNat (keyedState kops (t + 1)) = w :: inorderNat (keyedState kops t)
        | .pop s =>
            keyedState kops t ≠ .nil ∧
              (leftSpineBottomUpNat (keyedState kops t)).head? = some s ∧
              inorderNat (keyedState kops t) = s :: inorderNat (keyedState kops (t + 1))
        | .rslr d =>
            d + 2 ≤ (rightSpineTopDownNat (keyedState kops t)).length ∧
              inorderNat (keyedState kops (t + 1)) = inorderNat (keyedState kops t) :=
      h_tr_step kops .nil hk_tr

    have h_mem_pushKeys : ∀ (xs : List KeyedCoreOp) (w : ℕ), w ∈ pushKeys xs ↔ .push w ∈ xs := by
      intro xs w
      induction xs with
      | nil => simp [pushKeys]
      | cons op rest ih => rcases op <;> simp [pushKeys, ih]

    have h_mem_popKeys : ∀ (xs : List KeyedCoreOp) (s : ℕ), s ∈ popKeys xs ↔ .pop s ∈ xs := by
      intro xs s
      induction xs with
      | nil => simp [popKeys]
      | cons op rest ih => rcases op <;> simp [popKeys, ih]

    have h_push_inj : ∀ (xs : List KeyedCoreOp), (pushKeys xs).Nodup →
        ∀ (w i j : ℕ) (hi : i < xs.length) (hj : j < xs.length),
          xs[i] = .push w → xs[j] = .push w → i = j := by
      intro xs
      induction xs with
      | nil => intro _ _ _ _ hi; simp at hi
      | cons op rest ih =>
        intro hnd w i j hi hj hxi hxj
        have hnd_rest : (pushKeys rest).Nodup := by
          rcases op with w0 | s0 | d0
          · exact (List.nodup_cons.mp hnd).2
          · exact hnd
          · exact hnd
        rcases i with _ | i' <;> rcases j with _ | j'
        · rfl
        · simp at hxi hxj
          subst hxi
          have ha : w ∉ pushKeys rest := (List.nodup_cons.mp hnd).1
          have hmem : .push w ∈ rest := hxj ▸ List.getElem_mem (by simp at hj; omega)
          exact absurd ((h_mem_pushKeys rest w).mpr hmem) ha
        · simp at hxi hxj
          subst hxj
          have ha : w ∉ pushKeys rest := (List.nodup_cons.mp hnd).1
          have hmem : .push w ∈ rest := hxi ▸ List.getElem_mem (by simp at hi; omega)
          exact absurd ((h_mem_pushKeys rest w).mpr hmem) ha
        · simp at hi hj hxi hxj
          exact congrArg (· + 1) (ih hnd_rest w i' j' (by omega) (by omega) hxi hxj)

    have h_pop_inj : ∀ (xs : List KeyedCoreOp), (popKeys xs).Nodup →
        ∀ (s i j : ℕ) (hi : i < xs.length) (hj : j < xs.length),
          xs[i] = .pop s → xs[j] = .pop s → i = j := by
      intro xs
      induction xs with
      | nil => intro _ _ _ _ hi; simp at hi
      | cons op rest ih =>
        intro hnd s i j hi hj hxi hxj
        have hnd_rest : (popKeys rest).Nodup := by
          rcases op with w0 | s0 | d0
          · exact hnd
          · exact (List.nodup_cons.mp hnd).2
          · exact hnd
        rcases i with _ | i' <;> rcases j with _ | j'
        · rfl
        · simp at hxi hxj
          subst hxi
          have ha : s ∉ popKeys rest := (List.nodup_cons.mp hnd).1
          have hmem : .pop s ∈ rest := hxj ▸ List.getElem_mem (by simp at hj; omega)
          exact absurd ((h_mem_popKeys rest s).mpr hmem) ha
        · simp at hxi hxj
          subst hxj
          have ha : s ∉ popKeys rest := (List.nodup_cons.mp hnd).1
          have hmem : .pop s ∈ rest := hxi ▸ List.getElem_mem (by simp at hi; omega)
          exact absurd ((h_mem_popKeys rest s).mpr hmem) ha
        · simp at hi hj hxi hxj
          exact congrArg (· + 1) (ih hnd_rest s i' j' (by omega) (by omega) hxi hxj)

    have h_push_nd : (pushKeys kops).Nodup := (hk_push.nodup_iff).mpr List.nodup_range
    have h_pop_nd : (popKeys kops).Nodup := hk_pop ▸ List.nodup_range

    have h_push_at : ∀ (t : ℕ) (ht : t < kops.length) (w : ℕ),
        kops[t] = .push w → w < P ∧ birthStep kops w = t := by
      intro t ht w hop
      have hmem : .push w ∈ kops := hop ▸ List.getElem_mem ht
      have hwP : w < P := List.mem_range.mp (hk_push.mem_iff.mp ((h_mem_pushKeys kops w).mpr hmem))
      refine ⟨hwP, ?_⟩
      unfold birthStep
      rw [List.findIdx_eq ht]
      refine ⟨by simp [hop], ?_⟩
      intro j hjt
      by_contra htrue
      simp only [Bool.not_eq_false, beq_iff_eq] at htrue
      have heq := h_push_inj kops h_push_nd w j t (lt_trans hjt ht) ht htrue hop
      omega

    have h_birth_of_lt : ∀ w < P,
        ∃ ht : birthStep kops w < kops.length, kops[birthStep kops w]'ht = .push w := by
      intro w hwP
      have hmem : .push w ∈ kops :=
        (h_mem_pushKeys kops w).mp (hk_push.mem_iff.mpr (List.mem_range.mpr hwP))
      obtain ⟨t, ht, hop⟩ := List.mem_iff_getElem.mp hmem
      have hbt := (h_push_at t ht w hop).2
      exact ⟨hbt ▸ ht, by simp [hbt, hop]⟩

    have h_birth_op : ∀ w < P, kops[birthStep kops w]? = some (.push w) := by
      intro w hwP
      obtain ⟨hlt, heq⟩ := h_birth_of_lt w hwP
      rw [List.getElem?_eq_getElem hlt, heq]

    have h_pop_at : ∀ (t : ℕ) (ht : t < kops.length) (s : ℕ),
        kops[t] = .pop s → s < P ∧ popStep kops s = t := by
      intro t ht s hop
      have hmem : .pop s ∈ kops := hop ▸ List.getElem_mem ht
      have hsP : s < P := by
        have hm := (h_mem_popKeys kops s).mpr hmem
        rw [hk_pop, List.mem_range] at hm
        exact hm
      refine ⟨hsP, ?_⟩
      unfold popStep
      rw [List.findIdx_eq ht]
      refine ⟨by simp [hop], ?_⟩
      intro j hjt
      by_contra htrue
      simp only [Bool.not_eq_false, beq_iff_eq] at htrue
      have heq := h_pop_inj kops h_pop_nd s j t (lt_trans hjt ht) ht htrue hop
      omega

    have h_pop_of_lt : ∀ s < P,
        ∃ ht : popStep kops s < kops.length, kops[popStep kops s]'ht = .pop s := by
      intro s hsP
      have hmem : .pop s ∈ kops := by
        apply (h_mem_popKeys kops s).mp
        rw [hk_pop, List.mem_range]
        exact hsP
      obtain ⟨t, ht, hop⟩ := List.mem_iff_getElem.mp hmem
      have hpt := (h_pop_at t ht s hop).2
      exact ⟨hpt ▸ ht, by simp [hpt, hop]⟩

    have h_pop_op : ∀ s < P, kops[popStep kops s]? = some (.pop s) := by
      intro s hsP
      obtain ⟨hlt, heq⟩ := h_pop_of_lt s hsP
      rw [List.getElem?_eq_getElem hlt, heq]

    have h_popKeys_append : ∀ xs ys : List KeyedCoreOp,
        popKeys (xs ++ ys) = popKeys xs ++ popKeys ys := by
      intro xs ys
      induction xs with
      | nil => rfl
      | cons op rest ih => rcases op <;> simp [popKeys, ih]

    have h_popKeys_len : ∀ xs : List KeyedCoreOp,
        (popKeys xs).length = xs.countP isKeyedPop := by
      intro xs
      induction xs with
      | nil => rfl
      | cons op rest ih => rcases op <;> simp [popKeys, isKeyedPop, ih]

    have h_append_mid_getElem? : ∀ (as bs : List ℕ) (s : ℕ),
        (as ++ s :: bs)[as.length]? = some s := by
      intro as bs s
      induction as with
      | nil => rfl
      | cons a as' _ => simp

    have h_popIdx_step : ∀ (t : ℕ) (ht : t < kops.length),
        popIdx kops (t + 1) = popIdx kops t + (if isKeyedPop kops[t] then 1 else 0) := by
      intro t ht
      unfold popIdx
      rw [List.take_add_one, List.getElem?_eq_getElem ht]
      simp only [Option.toList_some, List.countP_append, List.countP_cons, List.countP_nil]
      cases isKeyedPop kops[t] <;> simp

    have h_popIdx_eq_s : ∀ (t : ℕ) (ht : t < kops.length) (s : ℕ),
        kops[t] = .pop s → popIdx kops t = s := by
      intro t ht s hop
      have hsplit : kops.take t ++ (kops[t] :: kops.drop (t + 1)) = kops := by
        rw [← List.drop_eq_getElem_cons ht, List.take_append_drop]
      have hp := congrArg popKeys hsplit
      rw [hop, hk_pop, h_popKeys_append] at hp
      simp only [popKeys] at hp
      let idx := (popKeys (kops.take t)).length
      have hidx_lt : idx < P := by
        have hlen := congrArg List.length hp
        simp only [List.length_append, List.length_cons, List.length_range] at hlen
        omega
      have h1 : (popKeys (kops.take t) ++ s :: popKeys (kops.drop (t + 1)))[idx]? = some s :=
        h_append_mid_getElem? (popKeys (kops.take t)) (popKeys (kops.drop (t + 1))) s
      rw [hp, List.getElem?_eq_getElem (by simp [hidx_lt]), List.getElem_range] at h1
      injection h1 with hs_eq
      unfold popIdx
      rw [← h_popKeys_len]
      exact hs_eq

    have h_popIdx_at_popStep : ∀ s < P, popIdx kops (popStep kops s) = s := by
      intro s hsP
      obtain ⟨hlt, heq⟩ := h_pop_of_lt s hsP
      exact h_popIdx_eq_s (popStep kops s) hlt s heq

    have h_popIdx_after_popStep : ∀ s < P, popIdx kops (popStep kops s + 1) = s + 1 := by
      intro s hsP
      obtain ⟨hlt, heq⟩ := h_pop_of_lt s hsP
      rw [h_popIdx_step (popStep kops s) hlt, heq, h_popIdx_eq_s (popStep kops s) hlt s heq]
      rfl

    have h_countP_take_mono : ∀ (xs : List KeyedCoreOp) (t : ℕ),
        (xs.take t).countP isKeyedPop ≤ (xs.take (t + 1)).countP isKeyedPop := by
      intro xs
      induction xs with
      | nil => intro _; simp
      | cons op rest ih =>
        intro t
        rcases t with _ | t'
        · simp [List.countP_cons]
        · simp only [List.take_succ_cons, List.countP_cons]
          have := ih t'
          omega

    have h_popIdx_mono : ∀ t1 t2 : ℕ, t1 ≤ t2 → popIdx kops t1 ≤ popIdx kops t2 := by
      intro t1 t2 hle
      exact Nat.le_induction le_rfl
        (fun m _ ihm => le_trans ihm (h_countP_take_mono kops m)) t2 hle

    have h_popStep_mono : ∀ u v : ℕ, u < v → v < P → popStep kops u < popStep kops v := by
      intro u v huv hvP
      have huP : u < P := lt_trans huv hvP
      obtain ⟨htu, hequ⟩ := h_pop_of_lt u huP
      obtain ⟨htv, heqv⟩ := h_pop_of_lt v hvP
      by_contra hnot
      have hle : popStep kops v ≤ popStep kops u := by omega
      rcases Nat.eq_or_lt_of_le hle with heq_t | hlt_t
      · have : KeyedCoreOp.pop v = KeyedCoreOp.pop u := by
          rw [← heqv, ← hequ]; simp [heq_t]
        injection this with hvu
        omega
      · have h1 := h_popIdx_mono (popStep kops v + 1) (popStep kops u) hlt_t
        rw [h_popIdx_after_popStep v hvP, h_popIdx_at_popStep u huP] at h1
        omega

    have h_bwd : ∀ (k : ℕ) (t : ℕ), t + k = kops.length →
        List.Pairwise (· < ·) (inorderNat (keyedState kops t)) ∧
          (∀ w ∈ inorderNat (keyedState kops t), popIdx kops t ≤ w ∧ w < P) := by
      intro k
      induction k with
      | zero =>
        intro t htk
        have ht_eq : t = kops.length := by omega
        subst ht_eq
        rw [h_end_empty]
        simp [inorderNat]
      | succ k' ih =>
        intro t htk
        have ht : t < kops.length := by omega
        obtain ⟨hpw1, hbd1⟩ := ih (t + 1) (by omega)
        have hst := h_step_trace t ht
        have hpidx := h_popIdx_step t ht
        rcases hop : kops[t] with w | s | d
        · rw [hop] at hst hpidx
          simp [isKeyedPop] at hpidx
          rw [hst] at hpw1 hbd1
          obtain ⟨_, hpw0⟩ := List.pairwise_cons.mp hpw1
          refine ⟨hpw0, ?_⟩
          intro u hu
          have hb := hbd1 u (List.mem_cons_of_mem w hu)
          omega
        · rw [hop] at hst hpidx
          obtain ⟨_, _, hin_eq⟩ := hst
          have hsP : s < P := (h_pop_at t ht s hop).1
          have hp0 : popIdx kops t = s := h_popIdx_eq_s t ht s hop
          simp [isKeyedPop] at hpidx
          rw [hin_eq]
          refine ⟨List.pairwise_cons.mpr ⟨?_, hpw1⟩, ?_⟩
          · intro u hu
            have hb := hbd1 u hu
            omega
          · intro u hu
            rcases List.mem_cons.mp hu with rfl | hu'
            · omega
            · have hb := hbd1 u hu'
              omega
        · rw [hop] at hst hpidx
          simp [isKeyedPop] at hpidx
          rw [← hst.2]
          refine ⟨hpw1, ?_⟩
          intro u hu
          have hb := hbd1 u hu
          omega

    have h_inorder_pw : ∀ t ≤ kops.length,
        List.Pairwise (· < ·) (inorderNat (keyedState kops t)) :=
      fun t ht => (h_bwd (kops.length - t) t (by omega)).1

    have h_popIdx_bound : ∀ t ≤ kops.length, ∀ w ∈ inorderNat (keyedState kops t),
        popIdx kops t ≤ w ∧ w < P :=
      fun t ht => (h_bwd (kops.length - t) t (by omega)).2

    have h_forall_of_inorder : ∀ (p : ℕ → Prop) (B : _root_.BinaryTree ℕ),
        (∀ x ∈ inorderNat B, p x) → _root_.SplayDeque.Direct.ForallTree p B := by
      intro p B
      induction B with
      | nil => intro _; exact .left
      | node k l r ihl ihr =>
        intro hall
        simp only [inorderNat, List.mem_append, List.mem_singleton] at hall
        exact .node l k r
          (ihl (fun x hx => hall x (Or.inl (Or.inl hx))))
          (hall k (Or.inl (Or.inr rfl)))
          (ihr (fun x hx => hall x (Or.inr hx)))

    have h_bst_of_pw : ∀ B : _root_.BinaryTree ℕ,
        List.Pairwise (· < ·) (inorderNat B) → _root_.BinaryTree.IsBST B := by
      intro B
      induction B with
      | nil => intro _; exact .left
      | node k l r ihl ihr =>
        intro hpw
        simp only [inorderNat] at hpw
        obtain ⟨hpw_lk, hpw_r, h_lk_r⟩ := List.pairwise_append.mp hpw
        obtain ⟨hpw_l, _, h_l_k⟩ := List.pairwise_append.mp hpw_lk
        refine .node k l r ?_ ?_ (ihl hpw_l) (ihr hpw_r)
        · exact h_forall_of_inorder _ l (fun x hx => h_l_k x hx k (List.mem_singleton_self k))
        · exact h_forall_of_inorder _ r (fun y hy =>
            h_lk_r k (List.mem_append_right _ (List.mem_singleton_self k)) y hy)

    have h_isBST_state : ∀ t ≤ kops.length, _root_.BinaryTree.IsBST (keyedState kops t) :=
      fun t ht => h_bst_of_pw (keyedState kops t) (h_inorder_pw t ht)

    have h_step_valid : ∀ t (ht : t < kops.length),
        match kops[t] with
        | .push w =>
            w < P ∧ birthStep kops w = t ∧
              _root_.SplayDeque.Direct.ForallTree (fun k => w < k) (keyedState kops t)
        | .pop s =>
            s < P ∧ popStep kops s = t ∧ s = popIdx kops t ∧
              keyedState kops t ≠ .nil ∧
              (leftSpineBottomUpNat (keyedState kops t)).head? = some s
        | .rslr d =>
            d + 2 ≤ (rightSpineTopDownNat (keyedState kops t)).length := by
      intro t ht
      have hst := h_step_trace t ht
      rcases hop : kops[t] with w | s | d
      · rw [hop] at hst
        obtain ⟨hwP, hbw⟩ := h_push_at t ht w hop
        have hpw1 := h_inorder_pw (t + 1) (by omega)
        rw [hst] at hpw1
        have hall := (List.pairwise_cons.mp hpw1).1
        exact ⟨hwP, hbw, h_forall_of_inorder _ _ hall⟩
      · rw [hop] at hst
        obtain ⟨hsP, hps⟩ := h_pop_at t ht s hop
        have hp0 := h_popIdx_eq_s t ht s hop
        exact ⟨hsP, hps, hp0.symm, hst.1, hst.2.1⟩
      · rw [hop] at hst
        exact hst.1

    have h_mem_step_other : ∀ (w : ℕ), w < P →
        ∀ (t : ℕ), t < kops.length → t ≠ birthStep kops w → t ≠ popStep kops w →
        (w ∈ inorderNat (keyedState kops (t + 1)) ↔ w ∈ inorderNat (keyedState kops t)) := by
      intro w hwP t ht hne_b hne_p
      have hst := h_step_trace t ht
      rcases hop : kops[t] with w' | s' | d
      · rw [hop] at hst
        have hw_ne : w ≠ w' := by
          intro heq; subst heq
          exact hne_b ((h_push_at t ht w hop).2).symm
        rw [hst, List.mem_cons]
        exact ⟨fun h => h.resolve_left hw_ne, fun h => Or.inr h⟩
      · rw [hop] at hst
        have hw_ne : w ≠ s' := by
          intro heq; subst heq
          exact hne_p ((h_pop_at t ht w hop).2).symm
        rw [hst.2.2, List.mem_cons]
        exact ⟨fun h => Or.inr h, fun h => h.resolve_left hw_ne⟩
      · rw [hop] at hst
        rw [hst.2]

    have h_mem_prop : ∀ (w : ℕ), w < P →
        ∀ (a b : ℕ), a ≤ b → b ≤ kops.length →
        (∀ t, a ≤ t → t < b → t ≠ birthStep kops w ∧ t ≠ popStep kops w) →
        (w ∈ inorderNat (keyedState kops a) ↔ w ∈ inorderNat (keyedState kops b)) := by
      intro w hwP a b hab hb_le hall
      induction b with
      | zero =>
        have ha0 : a = 0 := by omega
        subst ha0; exact Iff.rfl
      | succ b' ih =>
        rcases Nat.eq_or_lt_of_le hab with rfl | hab'
        · exact Iff.rfl
        · have ih1 := ih (by omega) (by omega) (fun t hat htb' => hall t hat (by omega))
          obtain ⟨h1, h2⟩ := hall b' (by omega) (by omega)
          exact ih1.trans (h_mem_step_other w hwP b' (by omega) h1 h2).symm

    have h_birth_mem : ∀ w < P,
        w ∉ inorderNat (keyedState kops (birthStep kops w)) ∧
          w ∈ inorderNat (keyedState kops (birthStep kops w + 1)) := by
      intro w hwP
      obtain ⟨htb, hop⟩ := h_birth_of_lt w hwP
      have hst := h_step_trace (birthStep kops w) htb
      rw [hop] at hst
      have hpw := h_inorder_pw (birthStep kops w + 1) (by omega)
      rw [hst] at hpw
      have hall := (List.pairwise_cons.mp hpw).1
      refine ⟨fun hm => Nat.lt_irrefl w (hall w hm), ?_⟩
      rw [hst]
      exact List.mem_cons_self

    have h_pop_mem : ∀ w < P,
        w ∈ inorderNat (keyedState kops (popStep kops w)) ∧
          w ∉ inorderNat (keyedState kops (popStep kops w + 1)) := by
      intro w hwP
      obtain ⟨htp, hop⟩ := h_pop_of_lt w hwP
      have hst := h_step_trace (popStep kops w) htp
      rw [hop] at hst
      have hpw := h_inorder_pw (popStep kops w) (by omega)
      rw [hst.2.2] at hpw
      have hall := (List.pairwise_cons.mp hpw).1
      refine ⟨?_, fun hm => Nat.lt_irrefl w (hall w hm)⟩
      rw [hst.2.2]
      exact List.mem_cons_self

    have h_birth_lt_pop : ∀ w < P,
        birthStep kops w < popStep kops w ∧ popStep kops w < kops.length := by
      intro w hwP
      obtain ⟨htb, _⟩ := h_birth_of_lt w hwP
      obtain ⟨htp, _⟩ := h_pop_of_lt w hwP
      refine ⟨?_, htp⟩
      by_contra hnot
      have hp := h_mem_prop w hwP (birthStep kops w + 1) kops.length (by omega) le_rfl
        (fun t hat _ => ⟨by omega, by omega⟩)
      have hm := hp.mp (h_birth_mem w hwP).2
      rw [h_end_empty] at hm
      simp [inorderNat] at hm

    have h_mem_inorder_iff : ∀ t ≤ kops.length, ∀ w,
        (w ∈ inorderNat (keyedState kops t) ↔
          w < P ∧ birthStep kops w < t ∧ t ≤ popStep kops w) := by
      intro t ht_le w
      by_cases hwP : w < P
      · obtain ⟨hbp, htp_lt⟩ := h_birth_lt_pop w hwP
        by_cases h1 : t ≤ birthStep kops w
        · have hp := h_mem_prop w hwP 0 t (Nat.zero_le t) ht_le
            (fun s _ hst => ⟨by omega, by omega⟩)
          have h0 : w ∉ inorderNat (keyedState kops 0) := by
            simp [keyedState, execKeyedList, inorderNat]
          exact ⟨fun hm => absurd (hp.mpr hm) h0, fun ⟨_, hlt, _⟩ => by omega⟩
        · by_cases h2 : t ≤ popStep kops w
          · have hp := h_mem_prop w hwP (birthStep kops w + 1) t (by omega) ht_le
              (fun s has hst => ⟨by omega, by omega⟩)
            have hm : w ∈ inorderNat (keyedState kops t) := hp.mp (h_birth_mem w hwP).2
            exact ⟨fun _ => ⟨hwP, by omega, h2⟩, fun _ => hm⟩
          · have hp := h_mem_prop w hwP (popStep kops w + 1) t (by omega) ht_le
              (fun s has _ => ⟨by omega, by omega⟩)
            have hnm : w ∉ inorderNat (keyedState kops t) :=
              fun hm => (h_pop_mem w hwP).2 (hp.mpr hm)
            exact ⟨fun hm => absurd hm hnm, fun ⟨_, _, hle⟩ => by omega⟩
      · exact ⟨fun hm => absurd (h_popIdx_bound t ht_le w hm).2 hwP,
          fun ⟨h, _, _⟩ => absurd h hwP⟩

    have hkvalid : ValidKeyedCoreSeq P kops :=
      { end_empty := h_end_empty
        push_perm := hk_push
        pop_eq := hk_pop
        birth_lt_pop := h_birth_lt_pop
        birth_op := h_birth_op
        pop_op := h_pop_op
        popStep_mono := h_popStep_mono
        mem_inorder_iff := h_mem_inorder_iff
        popIdx_at_popStep := h_popIdx_at_popStep
        popIdx_after_popStep := h_popIdx_after_popStep
        popIdx_bound := h_popIdx_bound
        isBST_state := h_isBST_state
        inorder_strictMono := h_inorder_pw
        step_valid := h_step_valid }

    have h_ls_sublist : ∀ T : _root_.BinaryTree ℕ, (leftSpineBottomUpNat T).Sublist (inorderNat T) := by
      intro T
      induction T with
      | nil => exact .slnil
      | node k l r ihl _ =>
        rw [h_ls_node]
        simp only [inorderNat]
        exact (ihl.append (List.Sublist.refl [k])).trans
          (List.sublist_append_left (inorderNat l ++ [k]) (inorderNat r))

    have h_jaux_step_bounds : ∀ (rest : List KeyedCoreOp) (nextId step : ℕ) (H : _root_.BinaryTree ℕ)
        (k : ℕ) (hk : k < (jumpsAux nextId step H rest).length),
        step ≤ ((jumpsAux nextId step H rest)[k]).step ∧
          ((jumpsAux nextId step H rest)[k]).step < step + rest.length := by
      intro rest
      induction rest with
      | nil => intro _ _ _ _ hk; simp [jumpsAux] at hk
      | cons op rest' ih =>
        intro nextId step H k hk
        rcases op with w | s | d
        · simp only [jumpsAux] at hk ⊢
          obtain ⟨h1, h2⟩ := ih nextId (step + 1) (execKeyedOp H (.push w)) k hk
          simp only [List.length_cons]; omega
        · simp only [jumpsAux] at hk ⊢
          by_cases hkj : k < (popJumpsAt nextId step s (leftSpineBottomUpNat H)).length
          · rw [List.getElem_append_left hkj]
            simp only [popJumpsAt, List.getElem_map, List.getElem_range, List.length_cons]
            omega
          · have hk' : k - (popJumpsAt nextId step s (leftSpineBottomUpNat H)).length <
                (jumpsAux (nextId + (popJumpsAt nextId step s (leftSpineBottomUpNat H)).length)
                  (step + 1) (execKeyedOp H (.pop s)) rest').length := by
              rw [List.length_append] at hk; omega
            rw [List.getElem_append_right (by omega)]
            obtain ⟨h1, h2⟩ :=
              ih (nextId + (popJumpsAt nextId step s (leftSpineBottomUpNat H)).length)
                (step + 1) (execKeyedOp H (.pop s))
                (k - (popJumpsAt nextId step s (leftSpineBottomUpNat H)).length) hk'
            simp only [List.length_cons]; omega
        · simp only [jumpsAux] at hk ⊢
          obtain ⟨h1, h2⟩ := ih nextId (step + 1) (execKeyedOp H (.rslr d)) k hk
          simp only [List.length_cons]; omega

    have h_jaux_slice : ∀ (rest : List KeyedCoreOp) (nextId step : ℕ) (H : _root_.BinaryTree ℕ)
        (r : ℕ) (_hr : r < rest.length) (s : ℕ),
        rest[r] = .pop s →
          ∃ baseId,
            baseId + ((leftSpineBottomUpNat (execKeyedList H (rest.take r))).length - 2) / 2 ≤
              (jumpsAux nextId step H rest).length ∧
            ∀ k (hk : k < (jumpsAux nextId step H rest).length),
              (((jumpsAux nextId step H rest)[k]).step = step + r ↔
                baseId ≤ k ∧
                  k < baseId + ((leftSpineBottomUpNat (execKeyedList H (rest.take r))).length - 2) / 2) := by
      intro rest
      induction rest with
      | nil => intro _ _ _ _ hr; simp at hr
      | cons op rest' ih =>
        intro nextId step H r hr s hop
        rcases r with _ | r'
        · simp at hop
          subst hop
          simp only [jumpsAux, List.take_zero, execKeyedList, Nat.add_zero]
          have hjs_len : (popJumpsAt nextId step s (leftSpineBottomUpNat H)).length =
              ((leftSpineBottomUpNat H).length - 2) / 2 := by
            simp [popJumpsAt]
          refine ⟨0, by rw [List.length_append, ← hjs_len]; omega, ?_⟩
          intro k hk
          by_cases hkj : k < (popJumpsAt nextId step s (leftSpineBottomUpNat H)).length
          · rw [List.getElem_append_left hkj]
            have hst_eq : ((popJumpsAt nextId step s (leftSpineBottomUpNat H))[k]'hkj).step = step := by
              simp [popJumpsAt]
            rw [hst_eq]
            rw [hjs_len] at hkj
            omega
          · rw [List.getElem_append_right (by omega)]
            have hk' : k - (popJumpsAt nextId step s (leftSpineBottomUpNat H)).length <
                (jumpsAux (nextId + (popJumpsAt nextId step s (leftSpineBottomUpNat H)).length)
                  (step + 1) (execKeyedOp H (.pop s)) rest').length := by
              rw [List.length_append] at hk; omega
            have hge := (h_jaux_step_bounds rest'
              (nextId + (popJumpsAt nextId step s (leftSpineBottomUpNat H)).length) (step + 1)
              (execKeyedOp H (.pop s))
              (k - (popJumpsAt nextId step s (leftSpineBottomUpNat H)).length) hk').1
            omega
        · have hr' : r' < rest'.length := by simp at hr; omega
          simp at hop
          rcases op with w | s0 | d
          · obtain ⟨bId, hb_le, hb_iff⟩ := ih nextId (step + 1) (execKeyedOp H (.push w)) r' hr' s hop
            refine ⟨bId, hb_le, ?_⟩
            intro k hk
            have h1 := hb_iff k hk
            have heq : step + (r' + 1) = step + 1 + r' := by omega
            rw [heq]; exact h1
          · simp only [jumpsAux, List.take_succ_cons, execKeyedList]
            obtain ⟨bId, hb_le, hb_iff⟩ :=
              ih (nextId + (popJumpsAt nextId step s0 (leftSpineBottomUpNat H)).length)
                (step + 1) (execKeyedOp H (.pop s0)) r' hr' s hop
            refine ⟨(popJumpsAt nextId step s0 (leftSpineBottomUpNat H)).length + bId,
              by rw [List.length_append]; omega, ?_⟩
            intro k hk
            by_cases hkj : k < (popJumpsAt nextId step s0 (leftSpineBottomUpNat H)).length
            · rw [List.getElem_append_left hkj]
              have hst_eq : ((popJumpsAt nextId step s0 (leftSpineBottomUpNat H))[k]'hkj).step = step := by
                simp [popJumpsAt]
              rw [hst_eq]
              omega
            · rw [List.getElem_append_right (by omega)]
              have hk' : k - (popJumpsAt nextId step s0 (leftSpineBottomUpNat H)).length <
                  (jumpsAux (nextId + (popJumpsAt nextId step s0 (leftSpineBottomUpNat H)).length)
                    (step + 1) (execKeyedOp H (.pop s0)) rest').length := by
                rw [List.length_append] at hk; omega
              have h1 := hb_iff
                (k - (popJumpsAt nextId step s0 (leftSpineBottomUpNat H)).length) hk'
              have heq : step + (r' + 1) = step + 1 + r' := by omega
              rw [heq, h1]
              omega
          · obtain ⟨bId, hb_le, hb_iff⟩ := ih nextId (step + 1) (execKeyedOp H (.rslr d)) r' hr' s hop
            refine ⟨bId, hb_le, ?_⟩
            intro k hk
            have h1 := hb_iff k hk
            have heq : step + (r' + 1) = step + 1 + r' := by omega
            rw [heq]; exact h1

    have h_jaux_order : ∀ (rest : List KeyedCoreOp) (nextId step : ℕ) (H : _root_.BinaryTree ℕ)
        (k1 : ℕ) (hk1 : k1 < (jumpsAux nextId step H rest).length)
        (k2 : ℕ) (hk2 : k2 < (jumpsAux nextId step H rest).length),
        k1 < k2 →
          ((jumpsAux nextId step H rest)[k1]).step < ((jumpsAux nextId step H rest)[k2]).step ∨
            (((jumpsAux nextId step H rest)[k1]).step = ((jumpsAux nextId step H rest)[k2]).step ∧
              ((jumpsAux nextId step H rest)[k1]).j < ((jumpsAux nextId step H rest)[k2]).j) := by
      intro rest
      induction rest with
      | nil => intro _ _ _ _ hk1; simp [jumpsAux] at hk1
      | cons op rest' ih =>
        intro nextId step H k1 hk1 k2 hk2 hlt
        rcases op with w | s | d
        · exact ih nextId (step + 1) (execKeyedOp H (.push w)) k1 hk1 k2 hk2 hlt
        · simp only [jumpsAux] at hk1 hk2 ⊢
          by_cases hk2j : k2 < (popJumpsAt nextId step s (leftSpineBottomUpNat H)).length
          · have hk1j : k1 < (popJumpsAt nextId step s (leftSpineBottomUpNat H)).length :=
              lt_trans hlt hk2j
            rw [List.getElem_append_left hk1j, List.getElem_append_left hk2j]
            right
            simp [popJumpsAt, hlt]
          · by_cases hk1j : k1 < (popJumpsAt nextId step s (leftSpineBottomUpNat H)).length
            · rw [List.getElem_append_left hk1j, List.getElem_append_right (by omega)]
              left
              have hk2' : k2 - (popJumpsAt nextId step s (leftSpineBottomUpNat H)).length <
                  (jumpsAux (nextId + (popJumpsAt nextId step s (leftSpineBottomUpNat H)).length)
                    (step + 1) (execKeyedOp H (.pop s)) rest').length := by
                rw [List.length_append] at hk2; omega
              have hge := (h_jaux_step_bounds rest'
                (nextId + (popJumpsAt nextId step s (leftSpineBottomUpNat H)).length) (step + 1)
                (execKeyedOp H (.pop s))
                (k2 - (popJumpsAt nextId step s (leftSpineBottomUpNat H)).length) hk2').1
              have hst_eq : ((popJumpsAt nextId step s (leftSpineBottomUpNat H))[k1]'hk1j).step = step := by
                simp [popJumpsAt]
              rw [hst_eq]
              omega
            · rw [List.getElem_append_right (by omega), List.getElem_append_right (by omega)]
              have hk1' : k1 - (popJumpsAt nextId step s (leftSpineBottomUpNat H)).length <
                  (jumpsAux (nextId + (popJumpsAt nextId step s (leftSpineBottomUpNat H)).length)
                    (step + 1) (execKeyedOp H (.pop s)) rest').length := by
                rw [List.length_append] at hk1; omega
              have hk2' : k2 - (popJumpsAt nextId step s (leftSpineBottomUpNat H)).length <
                  (jumpsAux (nextId + (popJumpsAt nextId step s (leftSpineBottomUpNat H)).length)
                    (step + 1) (execKeyedOp H (.pop s)) rest').length := by
                rw [List.length_append] at hk2; omega
              exact ih (nextId + (popJumpsAt nextId step s (leftSpineBottomUpNat H)).length)
                (step + 1) (execKeyedOp H (.pop s))
                (k1 - (popJumpsAt nextId step s (leftSpineBottomUpNat H)).length) hk1'
                (k2 - (popJumpsAt nextId step s (leftSpineBottomUpNat H)).length) hk2' (by omega)
        · exact ih nextId (step + 1) (execKeyedOp H (.rslr d)) k1 hk1 k2 hk2 hlt

    have h_jaux_anat : ∀ (rest : List KeyedCoreOp) (nextId step : ℕ) (H : _root_.BinaryTree ℕ)
        (k : ℕ) (hk : k < (jumpsAux nextId step H rest).length),
        ∃ (r : ℕ) (hr : r < rest.length),
          ((jumpsAux nextId step H rest)[k]).id = nextId + k ∧
          ((jumpsAux nextId step H rest)[k]).step = step + r ∧
          rest[r] = .pop ((jumpsAux nextId step H rest)[k]).s ∧
          (let ls := leftSpineBottomUpNat (execKeyedList H (rest.take r))
           ((jumpsAux nextId step H rest)[k]).m = (ls.length - 2) / 2 ∧
             ((jumpsAux nextId step H rest)[k]).j < ((jumpsAux nextId step H rest)[k]).m ∧
             ((jumpsAux nextId step H rest)[k]).x =
               ls.getD (2 * ((jumpsAux nextId step H rest)[k]).j + 1) 0 ∧
             ((jumpsAux nextId step H rest)[k]).y =
               ls.getD (2 * ((jumpsAux nextId step H rest)[k]).j + 2) 0 ∧
             ((jumpsAux nextId step H rest)[k]).z =
               ls.getD (2 * ((jumpsAux nextId step H rest)[k]).j + 3) 0) ∧
          (((jumpsAux nextId step H rest)[k]).j + 1 < ((jumpsAux nextId step H rest)[k]).m →
            ∃ hk' : k + 1 < (jumpsAux nextId step H rest).length,
              ((jumpsAux nextId step H rest)[k + 1]).step = ((jumpsAux nextId step H rest)[k]).step ∧
              ((jumpsAux nextId step H rest)[k + 1]).s = ((jumpsAux nextId step H rest)[k]).s ∧
              ((jumpsAux nextId step H rest)[k + 1]).j = ((jumpsAux nextId step H rest)[k]).j + 1 ∧
              ((jumpsAux nextId step H rest)[k + 1]).m = ((jumpsAux nextId step H rest)[k]).m ∧
              ((jumpsAux nextId step H rest)[k + 1]).x = ((jumpsAux nextId step H rest)[k]).z) := by
      intro rest
      induction rest with
      | nil => intro _ _ _ _ hk; simp [jumpsAux] at hk
      | cons op rest' ih =>
        intro nextId step H k hk
        rcases op with w | s | d
        · simp only [jumpsAux] at hk ⊢
          obtain ⟨r', hr', hid, hst, hop, hls, hnx⟩ :=
            ih nextId (step + 1) (execKeyedOp H (.push w)) k hk
          exact ⟨r' + 1, by simp; omega, hid, by omega, hop, hls, hnx⟩
        · simp only [jumpsAux] at hk ⊢
          by_cases hkj : k < (popJumpsAt nextId step s (leftSpineBottomUpNat H)).length
          · have hjs_len : (popJumpsAt nextId step s (leftSpineBottomUpNat H)).length =
                ((leftSpineBottomUpNat H).length - 2) / 2 := by
              simp [popJumpsAt]
            refine ⟨0, by simp, ?_, ?_, ?_, ?_, ?_⟩
            · rw [List.getElem_append_left hkj]
              simp [popJumpsAt]
            · rw [List.getElem_append_left hkj]
              simp [popJumpsAt]
            · rw [List.getElem_append_left hkj]
              simp [popJumpsAt]
            · rw [List.getElem_append_left hkj]
              simp [popJumpsAt, execKeyedList]
              omega
            · intro hj1
              have hk1j : k + 1 < (popJumpsAt nextId step s (leftSpineBottomUpNat H)).length := by
                rw [List.getElem_append_left hkj] at hj1
                simp only [popJumpsAt, List.getElem_map, List.getElem_range] at hj1
                omega
              have hk1J : k + 1 < (popJumpsAt nextId step s (leftSpineBottomUpNat H) ++
                  jumpsAux (nextId + (popJumpsAt nextId step s (leftSpineBottomUpNat H)).length)
                    (step + 1) (execKeyedOp H (.pop s)) rest').length := by
                rw [List.length_append]; omega
              refine ⟨hk1J, ?_⟩
              rw [List.getElem_append_left hk1j, List.getElem_append_left hkj]
              simp [popJumpsAt]
              have h2k : 2 * (k + 1) + 1 = 2 * k + 3 := by omega
              rw [h2k]
          · obtain ⟨idx, rfl⟩ : ∃ idx,
                k = (popJumpsAt nextId step s (leftSpineBottomUpNat H)).length + idx :=
              ⟨k - (popJumpsAt nextId step s (leftSpineBottomUpNat H)).length, by omega⟩
            have hk' : idx <
                (jumpsAux (nextId + (popJumpsAt nextId step s (leftSpineBottomUpNat H)).length)
                  (step + 1) (execKeyedOp H (.pop s)) rest').length := by
              rw [List.length_append] at hk; omega
            obtain ⟨r', hr', hid, hst, hop, hls, hnx⟩ :=
              ih (nextId + (popJumpsAt nextId step s (leftSpineBottomUpNat H)).length)
                (step + 1) (execKeyedOp H (.pop s)) idx hk'
            have hget : (popJumpsAt nextId step s (leftSpineBottomUpNat H) ++
                jumpsAux (nextId + (popJumpsAt nextId step s (leftSpineBottomUpNat H)).length)
                  (step + 1) (execKeyedOp H (.pop s))
                  rest')[(popJumpsAt nextId step s (leftSpineBottomUpNat H)).length + idx] =
                (jumpsAux (nextId + (popJumpsAt nextId step s (leftSpineBottomUpNat H)).length)
                  (step + 1) (execKeyedOp H (.pop s)) rest')[idx] := by
              rw [List.getElem_append_right (Nat.le_add_right _ _)]
              simp only [Nat.add_sub_cancel_left]
            refine ⟨r' + 1, by simp; omega, ?_, ?_, ?_, ?_, ?_⟩
            · rw [hget, hid, Nat.add_assoc]
            · rw [hget, hst]; omega
            · rw [hget]; exact hop
            · simp only [List.take_succ_cons, execKeyedList]
              rw [hget]; exact hls
            · rw [hget]
              intro hj1
              obtain ⟨hk1', hnx_eq⟩ := hnx hj1
              have hk1J : (popJumpsAt nextId step s (leftSpineBottomUpNat H)).length + idx + 1 <
                  (popJumpsAt nextId step s (leftSpineBottomUpNat H) ++
                    jumpsAux (nextId + (popJumpsAt nextId step s (leftSpineBottomUpNat H)).length)
                      (step + 1) (execKeyedOp H (.pop s)) rest').length := by
                rw [List.length_append]; omega
              refine ⟨hk1J, ?_⟩
              have hget1 : (popJumpsAt nextId step s (leftSpineBottomUpNat H) ++
                  jumpsAux (nextId + (popJumpsAt nextId step s (leftSpineBottomUpNat H)).length)
                    (step + 1) (execKeyedOp H (.pop s))
                    rest')[(popJumpsAt nextId step s (leftSpineBottomUpNat H)).length + idx + 1] =
                  (jumpsAux (nextId + (popJumpsAt nextId step s (leftSpineBottomUpNat H)).length)
                    (step + 1) (execKeyedOp H (.pop s)) rest')[idx + 1] := by
                rw [List.getElem_append_right (by omega)]
                have hsub : (popJumpsAt nextId step s (leftSpineBottomUpNat H)).length + idx + 1 -
                    (popJumpsAt nextId step s (leftSpineBottomUpNat H)).length = idx + 1 := by omega
                simp only [hsub]
              rw [hget1]
              exact hnx_eq
        · simp only [jumpsAux] at hk ⊢
          obtain ⟨r', hr', hid, hst, hop, hls, hnx⟩ :=
            ih nextId (step + 1) (execKeyedOp H (.rslr d)) k hk
          exact ⟨r' + 1, by simp; omega, hid, by omega, hop, hls, hnx⟩

    have h_jump_laws : PrimalJumpLaws P kops := by
      refine { pop_step_jumps := ?_, jump_order := ?_, jump_anatomies := ?_ }
      · intro t ht s hop
        obtain ⟨bId, hb_le, hb_iff⟩ := h_jaux_slice kops 0 0 .nil t ht s hop
        refine ⟨bId, hb_le, ?_⟩
        intro id hid
        simpa [jumps, keyedState] using hb_iff id hid
      · intro id1 hid1 id2 hid2 hlt
        exact h_jaux_order kops 0 0 .nil id1 hid1 id2 hid2 hlt
      · intro id hid
        obtain ⟨r, hr, hid_eq, hst_eq, hop_r, hls_eq, hnx⟩ := h_jaux_anat kops 0 0 .nil id hid
        simp only [Nat.zero_add] at hid_eq hst_eq
        cases hst_eq
        let e := (jumps kops)[id]
        let ls := leftSpineBottomUpNat (keyedState kops e.step)
        have he_step : e.step < kops.length := hr
        have hop_e : kops[e.step] = .pop e.s := hop_r
        have hop_opt : kops[e.step]? = some (.pop e.s) := by
          rw [List.getElem?_eq_getElem he_step, hop_e]
        obtain ⟨hem0, hejm0, hex0, hey0, hez0⟩ := hls_eq
        have hem : e.m = (ls.length - 2) / 2 := hem0
        have hejm : e.j < e.m := hejm0
        have hex : e.x = ls.getD (2 * e.j + 1) 0 := hex0
        have hey : e.y = ls.getD (2 * e.j + 2) 0 := hey0
        have hez : e.z = ls.getD (2 * e.j + 3) 0 := hez0
        have hlen_gt : 2 * e.j + 3 < ls.length := by omega
        have hx_idx : 2 * e.j + 1 < ls.length := by omega
        have hy_idx : 2 * e.j + 2 < ls.length := by omega
        have h0_idx : 0 < ls.length := by omega
        have hx_elem : ls[2 * e.j + 1] = e.x := by
          rw [hex, List.getD_eq_getElem?_getD, List.getElem?_eq_getElem hx_idx]; rfl
        have hy_elem : ls[2 * e.j + 2] = e.y := by
          rw [hey, List.getD_eq_getElem?_getD, List.getElem?_eq_getElem hy_idx]; rfl
        have hz_elem : ls[2 * e.j + 3] = e.z := by
          rw [hez, List.getD_eq_getElem?_getD, List.getElem?_eq_getElem hlen_gt]; rfl
        have hls0_opt : ls[0]? = some e.s := by
          have hsv := h_step_valid e.step he_step
          rw [hop_e] at hsv
          rw [← List.head?_eq_getElem?]
          exact hsv.2.2.2.2
        have hs_elem : ls[0] = e.s := by
          rw [List.getElem?_eq_getElem h0_idx] at hls0_opt
          injection hls0_opt
        have hpw_ls : List.Pairwise (· < ·) ls :=
          List.Pairwise.sublist (h_ls_sublist (keyedState kops e.step))
            (h_inorder_pw e.step (Nat.le_of_lt he_step))
        have hpw_get := List.pairwise_iff_getElem.mp hpw_ls
        have hsx : e.s < e.x := by
          rw [← hs_elem, ← hx_elem]
          exact hpw_get 0 (2 * e.j + 1) h0_idx hx_idx (by omega)
        have hxy : e.x < e.y := by
          rw [← hx_elem, ← hy_elem]
          exact hpw_get (2 * e.j + 1) (2 * e.j + 2) hx_idx hy_idx (by omega)
        have hyz : e.y < e.z := by
          rw [← hy_elem, ← hz_elem]
          exact hpw_get (2 * e.j + 2) (2 * e.j + 3) hy_idx hlen_gt (by omega)
        have hzP : e.z < P := by
          have hz_ls : e.z ∈ ls := hz_elem ▸ List.getElem_mem hlen_gt
          have hz_in : e.z ∈ inorderNat (keyedState kops e.step) :=
            (h_ls_sublist (keyedState kops e.step)).subset hz_ls
          exact (h_popIdx_bound e.step (Nat.le_of_lt he_step) e.z hz_in).2
        refine ⟨hid_eq, he_step, hop_opt, hejm, hsx, hxy, hyz, hzP,
          ⟨hem, hls0_opt, ?_, ?_, ?_⟩, hnx⟩
        · rw [List.getElem?_eq_getElem hx_idx, hx_elem]
        · rw [List.getElem?_eq_getElem hy_idx, hy_elem]
        · rw [List.getElem?_eq_getElem hlen_gt, hz_elem]

    exact ⟨hkvalid, h_jump_laws⟩

  obtain ⟨hpush_P, hpop_P, hval_empty⟩ := hvalid
  have hval_e : ValidCoreSeqAux (eraseNatKeys .nil) ops := hval_empty
  obtain ⟨hb_map, hb_tr, hb_push, hb_perm⟩ := h_pass1 ops .nil 0 hval_e
  rw [hpush_P, ← List.range_eq_range'] at hb_push hb_perm
  simp only [inorderNat, List.nil_append] at hb_perm
  let popOrder := popKeys (pklBuildBirthOps .nil 0 ops)
  let σ : ℕ → ℕ := fun x => popOrder.idxOf x
  let bops := pklBuildBirthOps .nil 0 ops
  let kops := bops.map (pklMapKeyedOp σ)
  have hpo_nd : popOrder.Nodup := (hb_perm.nodup_iff).mp List.nodup_range
  have hpo_len : popOrder.length = P := by
    have := hb_perm.length_eq
    rw [List.length_range] at this
    exact this.symm
  have hpo_map : popOrder.map σ = List.range P := by
    rw [h_nodup_idxOf popOrder hpo_nd, hpo_len]
  have hk_map : kops.map eraseKeyedOp = ops := by
    rw [h_erase_map, hb_map]
  have hk_tr : pklValidTrace .nil kops := h_trace_map σ bops .nil hb_tr
  have hk_pop : popKeys kops = List.range P := by
    rw [h_popKeys_map, hpo_map]
  have hk_push : (pushKeys kops).Perm (List.range P) := by
    rw [h_pushKeys_map, hb_push]
    exact (hb_perm.map σ).trans (by rw [hpo_map])
  have hk_rslr : countKeyedRslr kops ≤ 2 * P := by
    rw [h_count_rslr_erase, hk_map]
    have ht := h_rslr_telescoping ops .nil hval_empty
    simp only [rightSpineLen, hpush_P, hpop_P] at ht
    omega
  have hk_cost : coreCascadeCost ops ≤ P + (jumps kops).length := by
    have hc := h_cost_jumps kops 0 0 .nil
    rw [hk_map, hpop_P] at hc
    exact hc
  obtain ⟨hkvalid, h_jump_laws⟩ := h_cd kops hk_tr hk_push hk_pop
  exact ⟨kops, hk_map, hkvalid, h_jump_laws, hk_rslr, hk_cost⟩

theorem folded_dual_laws_and_mbase_bound (P : ℕ) (kops : List KeyedCoreOp) (hP : 1 ≤ P)
    (hkvalid : ValidKeyedCoreSeq P kops) (hjump : PrimalJumpLaws P kops) :
    ValidFoldedCoreLaws P kops ∧
    (MBaseSet kops).card ≤ 2 * P + countKeyedRslr kops :=
by
  let _ := hP




  have h_forall_iff : ∀ (p : ℕ → Prop) (T : _root_.BinaryTree ℕ),
      _root_.SplayDeque.Direct.ForallTree p T ↔ ∀ w ∈ inorderNat T, p w := by
    intro p T
    induction T with
    | nil =>
      simp only [inorderNat, List.not_mem_nil, false_implies, implies_true, iff_true]
      exact .left
    | node k l r ihl ihr =>
      constructor
      · intro hft w hw
        cases hft with
        | node _ _ _ hl hk hr =>
          simp only [inorderNat, List.mem_append, List.mem_singleton] at hw
          rcases hw with (hw | rfl) | hw
          · exact ihl.mp hl w hw
          · exact hk
          · exact ihr.mp hr w hw
      · intro h
        refine .node l k r (ihl.mpr fun w hw => h w ?_) (h k ?_) (ihr.mpr fun w hw => h w ?_)
        · simp [inorderNat, hw]
        · simp [inorderNat]
        · simp [inorderNat, hw]

  have h_ls_aux : ∀ (T : _root_.BinaryTree ℕ) (acc : List ℕ),
      leftSpineBottomUpAux T acc = leftSpineBottomUpAux T [] ++ acc := by
    intro T
    induction T with
    | nil => intro acc; rfl
    | node k l r ihl _ =>
      intro acc
      simp only [leftSpineBottomUpAux]
      rw [ihl (k :: acc), ihl [k], List.append_assoc]
      rfl

  have h_ls_node : ∀ (l : _root_.BinaryTree ℕ) (k : ℕ) (r : _root_.BinaryTree ℕ),
      leftSpineBottomUpNat (.node k l r) = leftSpineBottomUpNat l ++ [k] := by
    intro l k r
    exact h_ls_aux l [k]

  have h_ls_mem_inorder : ∀ (T : _root_.BinaryTree ℕ) (u : ℕ),
      u ∈ leftSpineBottomUpNat T → u ∈ inorderNat T := by
    intro T
    induction T with
    | nil => intro u hu; nomatch hu
    | node k l r ihl _ =>
      intro u hu
      rw [h_ls_node] at hu
      simp only [List.mem_append, List.mem_singleton] at hu
      simp only [inorderNat, List.mem_append, List.mem_singleton]
      rcases hu with hu | rfl
      · exact Or.inl (Or.inl (ihl u hu))
      · exact Or.inl (Or.inr rfl)

  have h_foldRightSpine_eq_attach : ∀ (r acc : _root_.BinaryTree ℕ) (k : ℕ),
      foldRightSpine acc k r = twAttachPoly acc (fdmRightSpineFrames k r) := by
    intro r
    induction r with
    | nil => intro acc k; rfl
    | node k2 l2 r2 _ ihr =>
      intro acc k
      exact ihr (.node k acc l2) k2

  have h_fdFrames_fst : ∀ (r : _root_.BinaryTree ℕ) (k : ℕ),
      (fdmRightSpineFrames k r).map Prod.fst = k :: rightSpineTopDownNat r := by
    intro r
    induction r with
    | nil => intro k; rfl
    | node k2 l2 r2 _ ihr =>
      intro k
      simp only [fdmRightSpineFrames, List.map_cons, rightSpineTopDownNat, ihr k2]

  have h_foldRightSpine_spec : ∀ (r acc : _root_.BinaryTree ℕ) (k : ℕ),
      _root_.BinaryTree.IsBST acc → _root_.BinaryTree.IsBST r →
      _root_.SplayDeque.Direct.ForallTree (· < k) acc → _root_.SplayDeque.Direct.ForallTree (k < ·) r →
      _root_.BinaryTree.IsBST (foldRightSpine acc k r) ∧
      inorderNat (foldRightSpine acc k r) = inorderNat acc ++ [k] ++ inorderNat r ∧
      leftSpineBottomUpNat (foldRightSpine acc k r) =
        leftSpineBottomUpNat acc ++ [k] ++ rightSpineTopDownNat r := by
    intro r
    induction r with
    | nil =>
      intro acc k hbst_acc _ hlt_acc _
      refine ⟨.node k acc .nil hlt_acc .left hbst_acc .left, ?_, ?_⟩
      · simp [foldRightSpine, inorderNat]
      · simp [foldRightSpine, rightSpineTopDownNat, h_ls_node]
    | node k2 l2 r2 _ ihr =>
      intro acc k hbst_acc hbst_r hlt_acc hgt_r
      cases hbst_r using isBSTCases with
      | node _ _ _ hl2_lt hr2_gt hbst_l2 hbst_r2 =>
        cases hgt_r with
        | node _ _ _ hl2_gt hk_lt_k2 _ =>
          have hbst_acc' : _root_.BinaryTree.IsBST (.node k acc l2) :=
            .node k acc l2 hlt_acc hl2_gt hbst_acc hbst_l2
          have hlt_acc' : _root_.SplayDeque.Direct.ForallTree (· < k2) (.node k acc l2) := by
            rw [h_forall_iff] at hlt_acc hl2_lt ⊢
            intro w hw
            simp only [inorderNat, List.mem_append, List.mem_singleton] at hw
            rcases hw with (hw | rfl) | hw
            · exact lt_trans (hlt_acc w hw) hk_lt_k2
            · exact hk_lt_k2
            · exact hl2_lt w hw
          obtain ⟨h1, h2, h3⟩ := ihr (.node k acc l2) k2 hbst_acc' hbst_r2 hlt_acc' hr2_gt
          refine ⟨h1, ?_, ?_⟩
          · simp only [foldRightSpine, inorderNat] at h2 ⊢
            rw [h2]
            simp only [List.append_assoc]
          · simp only [foldRightSpine, rightSpineTopDownNat] at h3 ⊢
            rw [h3, h_ls_node]
            simp

  have h_lcrs_absent : ∀ (T : _root_.BinaryTree ℕ) (curP v : ℕ),
      v ∉ inorderNat T → lcrsParentAux P curP v T = P := by
    intro T
    induction T with
    | nil => intro curP v _; rfl
    | node k l r ihl ihr =>
      intro curP v hv
      simp only [inorderNat, List.mem_append, List.mem_singleton, not_or] at hv
      obtain ⟨⟨hvl, hvk⟩, hvr⟩ := hv
      simp only [lcrsParentAux]
      split_ifs with h1 h2
      · exact ihl k v hvl
      · exact ihr curP v hvr
      · omega

  have h_lcrs_bounds_aux : ∀ (T : _root_.BinaryTree ℕ) (curP v : ℕ),
      _root_.BinaryTree.IsBST T → (∀ w ∈ inorderNat T, w < curP) → curP ≤ P → v ∈ inorderNat T →
      v < lcrsParentAux P curP v T ∧ lcrsParentAux P curP v T ≤ curP ∧
        (lcrsParentAux P curP v T = curP ∨ lcrsParentAux P curP v T ∈ inorderNat T) := by
    intro T
    induction T with
    | nil => intro _ _ _ _ _ hv; nomatch hv
    | node k l r ihl ihr =>
      intro curP v hbst hall hcurP hv
      cases hbst using isBSTCases with
      | node _ _ _ hl_lt hr_gt hbst_l hbst_r =>
        rw [h_forall_iff] at hl_lt hr_gt
        have hk_lt : k < curP := hall k (by simp [inorderNat])
        simp only [inorderNat, List.mem_append, List.mem_singleton] at hv
        simp only [lcrsParentAux]
        split_ifs with h1 h2
        · have hvl : v ∈ inorderNat l := by
            rcases hv with (hv | rfl) | hv
            · exact hv
            · omega
            · have := hr_gt v hv; omega
          obtain ⟨ha, hb, hc⟩ := ihl k v hbst_l hl_lt (by omega) hvl
          refine ⟨ha, by omega, Or.inr ?_⟩
          simp only [inorderNat, List.mem_append, List.mem_singleton]
          rcases hc with heq | hc
          · exact Or.inl (Or.inr heq)
          · exact Or.inl (Or.inl hc)
        · have hvr : v ∈ inorderNat r := by
            rcases hv with (hv | rfl) | hv
            · have := hl_lt v hv; omega
            · omega
            · exact hv
          have hr_all : ∀ w ∈ inorderNat r, w < curP := fun w hw =>
            hall w (by simp [inorderNat, hw])
          obtain ⟨ha, hb, hc⟩ := ihr curP v hbst_r hr_all hcurP hvr
          refine ⟨ha, hb, ?_⟩
          rcases hc with heq | hc
          · exact Or.inl heq
          · exact Or.inr (by simp [inorderNat, hc])
        · have hvk : v = k := by omega
          subst hvk
          exact ⟨hk_lt, le_rfl, Or.inl rfl⟩

  have h_lcrs_le_ls_aux : ∀ (T : _root_.BinaryTree ℕ) (curP x u : ℕ),
      _root_.BinaryTree.IsBST T → x ∈ inorderNat T → x < u →
      (u ∈ leftSpineBottomUpNat T ∨ (curP ≤ u ∧ ∀ w ∈ inorderNat T, w < curP)) →
      lcrsParentAux P curP x T ≤ u := by
    intro T
    induction T with
    | nil => intro _ _ _ _ hx _ _; nomatch hx
    | node k l r ihl ihr =>
      intro curP x u hbst hx hxu hcond
      cases hbst using isBSTCases with
      | node _ _ _ hl_lt hr_gt hbst_l hbst_r =>
        rw [h_forall_iff] at hl_lt hr_gt
        simp only [inorderNat, List.mem_append, List.mem_singleton] at hx
        rcases hcond with hls | ⟨hcurP_le, hall⟩
        · rw [h_ls_node] at hls
          simp only [List.mem_append, List.mem_singleton] at hls
          rcases hls with hls | rfl
          · have huk : u < k := hl_lt u (h_ls_mem_inorder l u hls)
            have hxk : x < k := lt_trans hxu huk
            have hxl : x ∈ inorderNat l := by
              rcases hx with (hx | rfl) | hx
              · exact hx
              · omega
              · have := hr_gt x hx; omega
            simp only [lcrsParentAux, if_pos hxk]
            exact ihl k x u hbst_l hxl hxu (Or.inl hls)
          · have hxl : x ∈ inorderNat l := by
              rcases hx with (hx | rfl) | hx
              · exact hx
              · omega
              · have := hr_gt x hx; omega
            simp only [lcrsParentAux, if_pos hxu]
            exact ihl u x u hbst_l hxl hxu (Or.inr ⟨le_rfl, hl_lt⟩)
        · have hk_lt : k < curP := hall k (by simp [inorderNat])
          simp only [lcrsParentAux]
          split_ifs with h1 h2
          · have hxl : x ∈ inorderNat l := by
              rcases hx with (hx | rfl) | hx
              · exact hx
              · omega
              · have := hr_gt x hx; omega
            exact ihl k x u hbst_l hxl hxu (Or.inr ⟨by omega, hl_lt⟩)
          · have hxr : x ∈ inorderNat r := by
              rcases hx with (hx | rfl) | hx
              · have := hl_lt x hx; omega
              · omega
              · exact hx
            exact ihr curP x u hbst_r hxr hxu
              (Or.inr ⟨hcurP_le, fun w hw => hall w (by simp [inorderNat, hw])⟩)
          · exact hcurP_le

  have hs1 : ∀ H : _root_.BinaryTree ℕ, _root_.BinaryTree.IsBST H →
      _root_.BinaryTree.IsBST (foldBST P H).1 ∧
      inorderNat (foldBST P H).1 = inorderNat H ∧
      ((H = .nil ∧ (foldBST P H).2 = P) ∨
        (H ≠ .nil ∧ (rightSpineTopDownNat H).head? = some (foldBST P H).2 ∧
          (leftSpineBottomUpNat H).getLast? = some (foldBST P H).2)) ∧
      leftSpineBottomUpNat (foldBST P H).1 =
        leftSpineBottomUpNat H ++ (rightSpineTopDownNat H).tail ∧
      ((∀ w ∈ inorderNat H, w < P) →
        lcrsParent P (foldBST P H).1 P = P ∧
        ∀ v ∈ inorderNat H,
          v < lcrsParent P (foldBST P H).1 v ∧
          lcrsParent P (foldBST P H).1 v ≤ P ∧
          (lcrsParent P (foldBST P H).1 v = P ∨
            lcrsParent P (foldBST P H).1 v ∈ inorderNat H)) ∧
      (∀ x u : ℕ, x ∈ inorderNat H → u ∈ leftSpineBottomUpNat (foldBST P H).1 → x < u →
        lcrsParent P (foldBST P H).1 x ≤ u) := by
    intro H hbst
    have h_main : _root_.BinaryTree.IsBST (foldBST P H).1 ∧
        inorderNat (foldBST P H).1 = inorderNat H ∧
        ((H = .nil ∧ (foldBST P H).2 = P) ∨
          (H ≠ .nil ∧ (rightSpineTopDownNat H).head? = some (foldBST P H).2 ∧
            (leftSpineBottomUpNat H).getLast? = some (foldBST P H).2)) ∧
        leftSpineBottomUpNat (foldBST P H).1 =
          leftSpineBottomUpNat H ++ (rightSpineTopDownNat H).tail := by
      cases hbst using isBSTCases with
      | left =>
        simp [foldBST, inorderNat, leftSpineBottomUpNat, leftSpineBottomUpAux, rightSpineTopDownNat,
          _root_.BinaryTree.IsBST.left]
      | node b0 l0 r0 hl0 hr0 hbst_l0 hbst_r0 =>
        obtain ⟨hfb, hfi, hfls⟩ := h_foldRightSpine_spec r0 l0 b0 hbst_l0 hbst_r0 hl0 hr0
        refine ⟨hfb, hfi, Or.inr ⟨by simp, rfl, ?_⟩, ?_⟩
        · rw [h_ls_node, List.getLast?_concat]; rfl
        · simp only [foldBST, hfls, h_ls_node, rightSpineTopDownNat, List.tail_cons,
            List.append_assoc]
    obtain ⟨hfb, hfi, hcur, hfls⟩ := h_main
    refine ⟨hfb, hfi, hcur, hfls, ?_, ?_⟩
    · intro hallP
      have hallT : ∀ w ∈ inorderNat (foldBST P H).1, w < P := by rw [hfi]; exact hallP
      have hP_not : P ∉ inorderNat (foldBST P H).1 := fun h => Nat.lt_irrefl P (hallT P h)
      refine ⟨h_lcrs_absent (foldBST P H).1 P P hP_not, fun v hv => ?_⟩
      rw [← hfi] at hv
      have hb := h_lcrs_bounds_aux (foldBST P H).1 P v hfb hallT le_rfl hv
      rw [hfi] at hb
      exact hb
    · intro x u hx hu hxu
      rw [← hfi] at hx
      exact h_lcrs_le_ls_aux (foldBST P H).1 P x u hfb hx hxu (Or.inl hu)




  have h_attach_append : ∀ (p1 p2 : List (ℕ × _root_.BinaryTree ℕ)) (u : _root_.BinaryTree ℕ),
      twAttachPoly u (p1 ++ p2) = twAttachPoly (twAttachPoly u p1) p2 := by
    intro p1
    induction p1 with
    | nil => intro p2 u; rfl
    | cons kr rest ih => intro p2 u; exact ih p2 (.node kr.1 u kr.2)

  have h_attach_ls : ∀ (F : List (ℕ × _root_.BinaryTree ℕ)) (u : _root_.BinaryTree ℕ),
      leftSpineBottomUpNat (twAttachPoly u F) = leftSpineBottomUpNat u ++ F.map Prod.fst := by
    intro F
    induction F with
    | nil => intro u; simp [twAttachPoly]
    | cons kr rest ih =>
      intro u
      simp only [twAttachPoly, ih (.node kr.1 u kr.2), h_ls_node, List.map_cons,
        List.append_assoc, List.singleton_append]

  have h_attach_bst_bot : ∀ (F : List (ℕ × _root_.BinaryTree ℕ)) (u : _root_.BinaryTree ℕ),
      _root_.BinaryTree.IsBST (twAttachPoly u F) → _root_.BinaryTree.IsBST u := by
    intro F
    induction F with
    | nil => intro u h; exact h
    | cons kr rest ih =>
      intro u h
      have h1 := ih (.node kr.1 u kr.2) h
      cases h1 using isBSTCases with
      | node _ _ _ _ _ hu _ => exact hu

  have h_attach_bst_replace : ∀ (F : List (ℕ × _root_.BinaryTree ℕ)) (u u' : _root_.BinaryTree ℕ),
      _root_.BinaryTree.IsBST (twAttachPoly u F) → _root_.BinaryTree.IsBST u' →
      (∀ w ∈ inorderNat u', w ∈ inorderNat u) →
      _root_.BinaryTree.IsBST (twAttachPoly u' F) := by
    intro F
    induction F with
    | nil => intro _ _ _ hu' _; exact hu'
    | cons kr rest ih =>
      intro u u' h hu' hsub
      have hnode := h_attach_bst_bot rest (.node kr.1 u kr.2) h
      cases hnode using isBSTCases with
      | node _ _ _ hlt hgt _ hr_bst =>
        have hlt' : _root_.SplayDeque.Direct.ForallTree (· < kr.1) u' := by
          rw [h_forall_iff] at hlt ⊢
          exact fun w hw => hlt w (hsub w hw)
        have hnode' : _root_.BinaryTree.IsBST (.node kr.1 u' kr.2) :=
          .node kr.1 u' kr.2 hlt' hgt hu' hr_bst
        refine ih (.node kr.1 u kr.2) (.node kr.1 u' kr.2) h hnode' ?_
        intro w hw
        simp only [inorderNat, List.mem_append, List.mem_singleton] at hw ⊢
        rcases hw with (hw | rfl) | hw
        · exact Or.inl (Or.inl (hsub w hw))
        · exact Or.inl (Or.inr rfl)
        · exact Or.inr hw

  have h_attach_keys_gt : ∀ (F : List (ℕ × _root_.BinaryTree ℕ)) (u : _root_.BinaryTree ℕ),
      _root_.BinaryTree.IsBST (twAttachPoly u F) →
      ∀ w ∈ inorderNat u, ∀ k ∈ F.map Prod.fst, w < k := by
    intro F
    induction F with
    | nil => intro _ _ _ _ _ hk; nomatch hk
    | cons kr rest ih =>
      intro u h w hw k hk
      have hnode := h_attach_bst_bot rest (.node kr.1 u kr.2) h
      cases hnode using isBSTCases with
      | node _ _ _ hlt _ _ _ =>
        rw [h_forall_iff] at hlt
        simp only [List.map_cons, List.mem_cons] at hk
        rcases hk with rfl | hk
        · exact hlt w hw
        · exact ih (.node kr.1 u kr.2) h w (by simp [inorderNat, hw]) k hk

  have h_splice_attach : ∀ (F : List (ℕ × _root_.BinaryTree ℕ)) (u : _root_.BinaryTree ℕ),
      u ≠ .nil → spliceMinNat (twAttachPoly u F) = twAttachPoly (spliceMinNat u) F := by
    intro F
    induction F with
    | nil => intro _ _; rfl
    | cons kr rest ih =>
      intro u hu
      rcases u with _ | ⟨uk, ul, ur⟩
      · exact absurd rfl hu
      · simp only [twAttachPoly]
        rw [ih (.node kr.1 (.node uk ul ur) kr.2) (by simp)]
        simp [spliceMinNat]

  have h_rotR_attach : ∀ (F : List (ℕ × _root_.BinaryTree ℕ)) (a b : _root_.BinaryTree ℕ) (u_key x : ℕ),
      u_key < x → _root_.BinaryTree.IsBST (twAttachPoly (.node x a b) F) →
      rotateRightOnLeftSpine u_key (twAttachPoly (.node x a b) F) =
        twAttachPoly (rotateRightOnLeftSpine u_key (.node x a b)) F := by
    intro F
    induction F with
    | nil => intro _ _ _ _ _ _; rfl
    | cons kr rest ih =>
      intro a b u_key x hux hbst
      have hnode := h_attach_bst_bot rest (.node kr.1 (.node x a b) kr.2) hbst
      cases hnode using isBSTCases with
      | node _ _ _ hlt _ _ _ =>
        rw [h_forall_iff] at hlt
        have hx_lt_k : x < kr.1 := hlt x (by simp [inorderNat])
        simp only [twAttachPoly]
        rw [ih (.node x a b) kr.2 u_key kr.1 (lt_trans hux hx_lt_k) hbst]
        have hne : x ≠ u_key := by omega
        simp only [rotateRightOnLeftSpine, if_neg hne]

  have h_lcrs_attach_congr : ∀ (F : List (ℕ × _root_.BinaryTree ℕ)) (T1 T2 : _root_.BinaryTree ℕ) (curP v : ℕ),
      (∀ c, lcrsParentAux P c v T1 = lcrsParentAux P c v T2) →
      lcrsParentAux P curP v (twAttachPoly T1 F) = lcrsParentAux P curP v (twAttachPoly T2 F) := by
    intro F
    induction F with
    | nil => intro T1 T2 curP v h; exact h curP
    | cons kr rest ih =>
      intro T1 T2 curP v h
      refine ih (.node kr.1 T1 kr.2) (.node kr.1 T2 kr.2) curP v (fun c => ?_)
      simp only [lcrsParentAux]
      split_ifs
      · exact h kr.1
      · rfl
      · rfl

  have h_lcrs_attach_lt : ∀ (rest : List (ℕ × _root_.BinaryTree ℕ)) (T r : _root_.BinaryTree ℕ) (k curP v : ℕ),
      _root_.BinaryTree.IsBST (twAttachPoly (.node k T r) rest) → v < k →
      lcrsParentAux P curP v (twAttachPoly T ((k, r) :: rest)) = lcrsParentAux P k v T := by
    intro rest
    induction rest with
    | nil =>
      intro T r k curP v _ hvk
      simp only [twAttachPoly, lcrsParentAux, if_pos hvk]
    | cons kr2 rest2 ih =>
      rcases kr2 with ⟨k2, r2⟩
      intro T r k curP v hbst hvk
      have hnode := h_attach_bst_bot rest2 (.node k2 (.node k T r) r2) hbst
      cases hnode using isBSTCases with
      | node _ _ _ hlt _ _ _ =>
        rw [h_forall_iff] at hlt
        have hk_lt : k < k2 := hlt k (by simp [inorderNat])
        change lcrsParentAux P curP v (twAttachPoly (.node k T r) ((k2, r2) :: rest2)) =
          lcrsParentAux P k v T
        rw [ih (.node k T r) r2 k2 curP v hbst (lt_trans hvk hk_lt)]
        simp only [lcrsParentAux, if_pos hvk]

  have h_lcrs_foldRightSpine_lt : ∀ (r T : _root_.BinaryTree ℕ) (k curP v : ℕ),
      v < k → _root_.SplayDeque.Direct.ForallTree (v < ·) r →
      lcrsParentAux P curP v (foldRightSpine T k r) = lcrsParentAux P k v T := by
    intro r
    induction r with
    | nil =>
      intro T k curP v hvk _
      simp only [foldRightSpine, lcrsParentAux, if_pos hvk]
    | node k2 l2 r2 _ ihr =>
      intro T k curP v hvk hvr
      cases hvr with
      | node _ _ _ _ hvk2 hvr2 =>
        simp only [foldRightSpine]
        rw [ihr (.node k T l2) k2 curP v hvk2 hvr2]
        simp only [lcrsParentAux, if_pos hvk]

  have h_lcrs_rot_local : ∀ (a b d : _root_.BinaryTree ℕ) (u p c w : ℕ),
      u < p → w ≠ u →
      lcrsParentAux P c w (.node u a (.node p b d)) =
        lcrsParentAux P c w (.node p (.node u a b) d) := by
    intro a b d u p c w hup hwu
    by_cases h1 : w < u
    · have h2 : w < p := lt_trans h1 hup
      simp only [lcrsParentAux, if_pos h1, if_pos h2]
    · have huw : u < w := by omega
      have hnu : ¬ w < u := h1
      by_cases h2 : w < p
      · simp only [lcrsParentAux, if_neg hnu, if_pos huw, if_pos h2]
      · by_cases h3 : p < w
        · simp only [lcrsParentAux, if_neg hnu, if_pos huw, if_neg h2, if_pos h3]
        · have hwp : w = p := by omega
          subst hwp
          have hnp : ¬ w < w := Nat.lt_irrefl w
          simp only [lcrsParentAux, if_neg hnu, if_pos hup, if_neg hnp]

  have h_insertPush_foldRightSpine : ∀ (r T : _root_.BinaryTree ℕ) (b0 w k : ℕ),
      b0 < k → _root_.SplayDeque.Direct.ForallTree (b0 < ·) r →
      insertPushFolded b0 w (foldRightSpine T k r) = foldRightSpine (insertPushFolded b0 w T) k r := by
    intro r
    induction r with
    | nil =>
      intro T b0 w k hbk _
      have hne : k ≠ b0 := by omega
      simp only [foldRightSpine, insertPushFolded, if_neg hne]
    | node k2 l2 r2 _ ihr =>
      intro T b0 w k hbk hgt
      cases hgt with
      | node _ _ _ _ hbk2 hr2 =>
        have hne : k ≠ b0 := by omega
        simp only [foldRightSpine]
        rw [ihr (.node k T l2) b0 w k2 hbk2 hr2]
        simp only [insertPushFolded, if_neg hne]

  have hs2 : ∀ H : _root_.BinaryTree ℕ, _root_.BinaryTree.IsBST H →
      (∀ w : ℕ, _root_.SplayDeque.Direct.ForallTree (fun k => w < k) H →
        (foldBST P (.node w .nil H)).1 =
          insertPushFolded (foldBST P H).2 w (foldBST P H).1 ∧
        lcrsParent P (foldBST P (.node w .nil H)).1 w = (foldBST P H).2 ∧
        ∀ v : ℕ, v ≠ w →
          lcrsParent P (foldBST P (.node w .nil H)).1 v = lcrsParent P (foldBST P H).1 v) ∧
      (2 ≤ (rightSpineTopDownNat H).length →
        (foldBST P (rotateLeftAtRightDepthNat H 0)).1 = (foldBST P H).1) ∧
      (∀ d : ℕ, d + 3 ≤ (rightSpineTopDownNat H).length →
        let rs := rightSpineTopDownNat H
        let u := rs.getD d 0
        let p := rs.getD (d + 1) 0
        u ∈ inorderNat H ∧ p ∈ inorderNat H ∧ u < p ∧
        (foldBST P (rotateLeftAtRightDepthNat H (d + 1))).1 =
          rotateRightOnLeftSpine u (foldBST P H).1 ∧
        lcrsParent P (foldBST P H).1 u = p ∧
        lcrsParent P (foldBST P (rotateLeftAtRightDepthNat H (d + 1))).1 u =
          lcrsParent P (foldBST P H).1 p ∧
        ∀ v : ℕ, v ≠ u →
          lcrsParent P (foldBST P (rotateLeftAtRightDepthNat H (d + 1))).1 v =
            lcrsParent P (foldBST P H).1 v) := by
    intro H hbst
    refine ⟨?_, ?_, ?_⟩
    · intro w hw_lt
      cases hbst using isBSTCases with
      | left =>
        refine ⟨rfl, ?_, ?_⟩
        · simp [foldBST, foldRightSpine, lcrsParent, lcrsParentAux]
        · intro v hv
          simp only [foldBST, foldRightSpine, lcrsParent, lcrsParentAux]
          split_ifs with h1 h2
          · rfl
          · rfl
          · omega
      | node b0 l0 r0 hl0 hr0 hbst_l0 hbst_r0 =>
        cases hw_lt with
        | node _ _ _ hwl0 hwb0 hwr0 =>
          refine ⟨?_, ?_, ?_⟩
          · rcases r0 with _ | ⟨k2, l2, r2⟩
            · simp [foldBST, foldRightSpine, insertPushFolded]
            · cases hr0 with
              | node _ _ _ _ hb0_k2 hr2 =>
                simp only [foldBST, foldRightSpine]
                rw [h_insertPush_foldRightSpine r2 (.node b0 l0 l2) b0 w k2 hb0_k2 hr2]
                simp [insertPushFolded]
          · change lcrsParentAux P P w (foldRightSpine (.node w .nil l0) b0 r0) = b0
            rw [h_lcrs_foldRightSpine_lt r0 (.node w .nil l0) b0 P w hwb0 hwr0]
            simp [lcrsParentAux]
          · intro v hvw
            change lcrsParentAux P P v (foldRightSpine (.node w .nil l0) b0 r0) =
              lcrsParentAux P P v (foldRightSpine l0 b0 r0)
            rw [h_foldRightSpine_eq_attach, h_foldRightSpine_eq_attach]
            refine h_lcrs_attach_congr (fdmRightSpineFrames b0 r0) (.node w .nil l0) l0 P v (fun c => ?_)
            by_cases h1 : v < w
            · have hv_not : v ∉ inorderNat l0 := by
                rw [h_forall_iff] at hwl0
                intro hv_in
                have := hwl0 v hv_in
                omega
              simp only [lcrsParentAux, if_pos h1]
              exact (h_lcrs_absent l0 c v hv_not).symm
            · have hwv : w < v := by omega
              have hnw : ¬ v < w := h1
              simp only [lcrsParentAux, if_neg hnw, if_pos hwv]
    · intro hlen
      rcases H with _ | ⟨b0, a, _ | ⟨k1, b, c⟩⟩
      · simp [rightSpineTopDownNat] at hlen
      · simp [rightSpineTopDownNat] at hlen
      · rfl
    · have h_rslr_ind : ∀ (d : ℕ) (acc r0 : _root_.BinaryTree ℕ) (k0 : ℕ),
          _root_.BinaryTree.IsBST (.node k0 acc r0) →
          d + 3 ≤ (rightSpineTopDownNat (.node k0 acc r0)).length →
          let rs := rightSpineTopDownNat (.node k0 acc r0)
          let u := rs.getD d 0
          let p := rs.getD (d + 1) 0
          u ∈ inorderNat (.node k0 acc r0) ∧
          p ∈ inorderNat (.node k0 acc r0) ∧
          u < p ∧
          foldRightSpine acc k0 (rotateLeftAtRightDepthNat r0 d) =
            rotateRightOnLeftSpine u (foldRightSpine acc k0 r0) ∧
          lcrsParent P (foldRightSpine acc k0 r0) u = p ∧
          lcrsParent P (foldRightSpine acc k0 (rotateLeftAtRightDepthNat r0 d)) u =
            lcrsParent P (foldRightSpine acc k0 r0) p ∧
          ∀ v : ℕ, v ≠ u →
            lcrsParent P (foldRightSpine acc k0 (rotateLeftAtRightDepthNat r0 d)) v =
              lcrsParent P (foldRightSpine acc k0 r0) v := by
        intro d
        induction d with
        | zero =>
          intro acc r0 u hbst0 hlen0
          rcases r0 with _ | ⟨p, b, _ | ⟨q, cl, cr⟩⟩
          · simp [rightSpineTopDownNat] at hlen0
          · simp [rightSpineTopDownNat] at hlen0
          · cases hbst0 using isBSTCases with
            | node _ _ _ hacc_lt hr0_gt hbst_acc hbst_r0 =>
              cases hbst_r0 using isBSTCases with
              | node _ _ _ hb_lt hr1_gt hbst_b hbst_r1 =>
                cases hr0_gt with
                | node _ _ _ hb_gt_u hup hcr_gt_u_all =>
                  cases hbst_r1 using isBSTCases with
                  | node _ _ _ hcl_lt hcr_gt hbst_cl hbst_cr =>
                    cases hr1_gt with
                    | node _ _ _ hcl_gt_p hpq hcr_gt_p =>
                      cases hcr_gt_u_all with
                      | node _ _ _ _ huq hcr_gt_u =>
                        have hbst_pre_base : _root_.BinaryTree.IsBST (.node p (.node u acc b) cl) := by
                          refine .node p (.node u acc b) cl ?_ hcl_gt_p
                            (.node u acc b hacc_lt hb_gt_u hbst_acc hbst_b) hbst_cl
                          rw [h_forall_iff] at hacc_lt hb_lt ⊢
                          intro w hw
                          simp only [inorderNat, List.mem_append, List.mem_singleton] at hw
                          rcases hw with (hw | rfl) | hw
                          · exact lt_trans (hacc_lt w hw) hup
                          · exact hup
                          · exact hb_lt w hw
                        have hlt_pre_q : _root_.SplayDeque.Direct.ForallTree (· < q) (.node p (.node u acc b) cl) := by
                          rw [h_forall_iff] at hacc_lt hb_lt hcl_lt ⊢
                          intro w hw
                          simp only [inorderNat, List.mem_append, List.mem_singleton] at hw
                          rcases hw with (((hw | rfl) | hw) | rfl) | hw
                          · exact lt_trans (lt_trans (hacc_lt w hw) hup) hpq
                          · exact lt_trans hup hpq
                          · exact lt_trans (hb_lt w hw) hpq
                          · exact hpq
                          · exact hcl_lt w hw
                        have hbst_pre : _root_.BinaryTree.IsBST
                            (foldRightSpine (.node p (.node u acc b) cl) q cr) :=
                          (h_foldRightSpine_spec cr (.node p (.node u acc b) cl) q
                            hbst_pre_base hbst_cr hlt_pre_q hcr_gt).1
                        refine ⟨by simp [rightSpineTopDownNat, inorderNat],
                          by simp [rightSpineTopDownNat, inorderNat],
                          by simpa [rightSpineTopDownNat] using hup, ?_, ?_, ?_, ?_⟩
                        · change foldRightSpine (.node u acc (.node p b cl)) q cr =
                            rotateRightOnLeftSpine u
                              (foldRightSpine (.node p (.node u acc b) cl) q cr)
                          rw [h_foldRightSpine_eq_attach] at hbst_pre ⊢
                          rw [h_foldRightSpine_eq_attach]
                          rw [h_rotR_attach (fdmRightSpineFrames q cr) (.node u acc b) cl u p hup hbst_pre]
                          simp [rotateRightOnLeftSpine]
                        · change lcrsParentAux P P u
                            (foldRightSpine (.node p (.node u acc b) cl) q cr) = p
                          rw [h_lcrs_foldRightSpine_lt cr (.node p (.node u acc b) cl) q P u huq hcr_gt_u]
                          simp [lcrsParentAux, hup]
                        · change lcrsParentAux P P u
                            (foldRightSpine (.node u acc (.node p b cl)) q cr) =
                            lcrsParentAux P P p
                              (foldRightSpine (.node p (.node u acc b) cl) q cr)
                          rw [h_lcrs_foldRightSpine_lt cr (.node u acc (.node p b cl)) q P u huq hcr_gt_u]
                          rw [h_lcrs_foldRightSpine_lt cr (.node p (.node u acc b) cl) q P p hpq hcr_gt_p]
                          simp [lcrsParentAux]
                        · intro v hvu
                          have hvu' : v ≠ u := by simpa [rightSpineTopDownNat] using hvu
                          change lcrsParentAux P P v
                            (foldRightSpine (.node u acc (.node p b cl)) q cr) =
                            lcrsParentAux P P v
                              (foldRightSpine (.node p (.node u acc b) cl) q cr)
                          rw [h_foldRightSpine_eq_attach, h_foldRightSpine_eq_attach]
                          exact h_lcrs_attach_congr (fdmRightSpineFrames q cr)
                            (.node u acc (.node p b cl)) (.node p (.node u acc b) cl) P v
                            (fun c => h_lcrs_rot_local acc b cl u p c v hup hvu')
        | succ d' ih =>
          intro acc r0 k0 hbst0 hlen0
          rcases r0 with _ | ⟨k1, l1, r1⟩
          · simp [rightSpineTopDownNat] at hlen0
          · cases hbst0 using isBSTCases with
            | node _ _ _ hacc_lt hr0_gt hbst_acc hbst_r0 =>
              cases hbst_r0 using isBSTCases with
              | node _ _ _ hl1_lt hr1_gt hbst_l1 hbst_r1 =>
                cases hr0_gt with
                | node _ _ _ hl1_gt hk0_k1 _ =>
                  have hbst' : _root_.BinaryTree.IsBST (.node k1 (.node k0 acc l1) r1) := by
                    refine .node k1 (.node k0 acc l1) r1 ?_ hr1_gt
                      (.node k0 acc l1 hacc_lt hl1_gt hbst_acc hbst_l1) hbst_r1
                    rw [h_forall_iff] at hacc_lt hl1_lt ⊢
                    intro w hw
                    simp only [inorderNat, List.mem_append, List.mem_singleton] at hw
                    rcases hw with (hw | rfl) | hw
                    · exact lt_trans (hacc_lt w hw) hk0_k1
                    · exact hk0_k1
                    · exact hl1_lt w hw
                  have hlen' : d' + 3 ≤ (rightSpineTopDownNat (.node k1 (.node k0 acc l1) r1)).length := by
                    simp only [rightSpineTopDownNat, List.length_cons] at hlen0 ⊢
                    omega
                  have h_res := ih (.node k0 acc l1) r1 k1 hbst' hlen'
                  have hin_eq : inorderNat (.node k1 (.node k0 acc l1) r1) =
                      inorderNat (.node k0 acc (.node k1 l1 r1)) := by
                    simp only [inorderNat, List.append_assoc]
                  dsimp (config := { failIfUnchanged := false }) only [rightSpineTopDownNat, List.getD_cons_succ] at h_res ⊢
                  rw [hin_eq] at h_res
                  exact h_res
      intro d hlen
      rcases H with _ | ⟨k0, l0, r0⟩
      · simp [rightSpineTopDownNat] at hlen
      · exact h_rslr_ind d l0 r0 k0 hbst hlen




  have h_descend_append : ∀ (u : _root_.BinaryTree ℕ) (a1 a2 : List (ℕ × _root_.BinaryTree ℕ)),
      u ≠ .nil →
      descendLeftNat u (a1 ++ a2) = ((descendLeftNat u a1).1, (descendLeftNat u a1).2 ++ a2) := by
    intro u
    induction u with
    | nil => intro _ _ h; exact absurd rfl h
    | node k l r ihl _ =>
      intro a1 a2 _
      rcases l with _ | ⟨lk, ll, lr⟩
      · simp [descendLeftNat]
      · simp only [descendLeftNat]
        rw [← List.cons_append]
        exact ihl ((k, r) :: a1) a2 (by simp)

  have h_descend_spec : ∀ (u : _root_.BinaryTree ℕ), u ≠ .nil →
      ∃ s0 : ℕ,
        leftSpineBottomUpNat u = s0 :: (descendLeftNat u []).2.map Prod.fst ∧
        u = twAttachPoly (.node s0 .nil (descendLeftNat u []).1) (descendLeftNat u []).2 := by
    intro u
    induction u with
    | nil => intro h; exact absurd rfl h
    | node k l r ihl _ =>
      intro _
      rcases l with _ | ⟨lk, ll, lr⟩
      · refine ⟨k, ?_, ?_⟩
        · simp [leftSpineBottomUpNat, leftSpineBottomUpAux, descendLeftNat]
        · simp [descendLeftNat, twAttachPoly]
      · obtain ⟨s0, hls0, heq0⟩ := ihl (by simp)
        have happ := h_descend_append (.node lk ll lr) [] [(k, r)] (by simp)
        simp only [List.nil_append] at happ
        refine ⟨s0, ?_, ?_⟩
        · rw [h_ls_node, hls0]
          simp only [descendLeftNat, happ, List.map_append, List.map_cons, List.map_nil,
            List.cons_append]
        · simp only [descendLeftNat, happ]
          rw [h_attach_append, ← heq0]
          rfl

  have h_splay_keep_ls : ∀ (n : ℕ) (rest : List (ℕ × _root_.BinaryTree ℕ)) (u : _root_.BinaryTree ℕ)
      (b0 : ℕ) (r0 : _root_.BinaryTree ℕ),
      rest.length ≤ n →
      ∀ w ∈ leftSpineBottomUpNat u,
        w ∈ leftSpineBottomUpNat (foldBST P (splayLeftSpineNat u (rest ++ [(b0, r0)]))).1 := by
    intro n
    induction n with
    | zero =>
      intro rest u b0 r0 hlen w hw
      rcases rest with _ | ⟨kr1, rest'⟩
      · simp [splayLeftSpineNat, foldBST, h_foldRightSpine_eq_attach, h_attach_ls, hw]
      · simp at hlen
    | succ n ih =>
      intro rest u b0 r0 hlen w hw
      rcases rest with _ | ⟨⟨k1, s1⟩, _ | ⟨⟨k2, s2⟩, rest2⟩⟩
      · simp [splayLeftSpineNat, foldBST, h_foldRightSpine_eq_attach, h_attach_ls, hw]
      · simp [splayLeftSpineNat, foldBST, h_foldRightSpine_eq_attach, h_attach_ls, hw]
      · simp only [List.cons_append, splayLeftSpineNat]
        refine ih rest2 (.node k1 u (.node k2 s1 s2)) b0 r0 (by simp at hlen; omega) w ?_
        rw [h_ls_node, List.mem_append]
        exact Or.inl hw

  have h_lcrs_attach_adj : ∀ (F : List (ℕ × _root_.BinaryTree ℕ)) (c : _root_.BinaryTree ℕ) (idx : ℕ),
      _root_.BinaryTree.IsBST (twAttachPoly c F) → idx + 1 < F.length →
      lcrsParent P (twAttachPoly c F) ((F.map Prod.fst).getD idx 0) =
        (F.map Prod.fst).getD (idx + 1) 0 := by
    intro F c idx hbst hidx
    have hidx0 : idx < F.length := by omega
    have hsplit : F = F.take idx ++ F[idx] :: F[idx + 1] :: F.drop (idx + 2) := by
      have h1 := (List.take_append_drop idx F).symm
      have h2 : F.drop idx = F[idx] :: F.drop (idx + 1) := List.drop_eq_getElem_cons hidx0
      have h3 : F.drop (idx + 1) = F[idx + 1] :: F.drop (idx + 2) := List.drop_eq_getElem_cons hidx
      rw [h2, h3] at h1
      exact h1
    have hget0 : (F.map Prod.fst).getD idx 0 = F[idx].1 := by
      rw [List.getD_eq_getElem?_getD, List.getElem?_eq_getElem (by simp [hidx0])]
      simp
    have hget1 : (F.map Prod.fst).getD (idx + 1) 0 = F[idx + 1].1 := by
      rw [List.getD_eq_getElem?_getD, List.getElem?_eq_getElem (by simp [hidx])]
      simp
    rw [hget0, hget1]
    set u_pair := F[idx]
    set p_pair := F[idx + 1]
    set F_lo := F.take idx
    set F_hi := F.drop (idx + 2)
    have hT_eq : twAttachPoly c F =
        twAttachPoly (.node u_pair.1 (twAttachPoly c F_lo) u_pair.2)
          ((p_pair.1, p_pair.2) :: F_hi) := by
      conv => lhs; arg 2; rw [hsplit]
      rw [h_attach_append]
      rfl
    rw [hT_eq] at hbst ⊢
    have hbst_mid := h_attach_bst_bot F_hi
      (.node p_pair.1 (.node u_pair.1 (twAttachPoly c F_lo) u_pair.2) p_pair.2) hbst
    cases hbst_mid using isBSTCases with
    | node _ _ _ hlt _ _ _ =>
      rw [h_forall_iff] at hlt
      have hlt_keys : u_pair.1 < p_pair.1 := hlt u_pair.1 (by simp [inorderNat])
      rw [lcrsParent]
      rw [h_lcrs_attach_lt F_hi (.node u_pair.1 (twAttachPoly c F_lo) u_pair.2)
        p_pair.2 p_pair.1 P u_pair.1 hbst hlt_keys]
      simp [lcrsParentAux]

  have h_pop_splay_ind : ∀ (n : ℕ) (initPath : List (ℕ × _root_.BinaryTree ℕ)) (c : _root_.BinaryTree ℕ)
      (b0 : ℕ) (r0 : _root_.BinaryTree ℕ),
      initPath.length ≤ n →
      let F := initPath ++ fdmRightSpineFrames b0 r0
      _root_.BinaryTree.IsBST (twAttachPoly c F) →
      let T_start := twAttachPoly c F
      let T_end := (foldBST P (splayLeftSpineNat c (initPath ++ [(b0, r0)]))).1
      let m := initPath.length / 2
      T_end = ((List.range m).map (fun j => (initPath.map Prod.fst).getD (2 * j) 0)).foldl
          (fun T x => rotateRightOnLeftSpine x T) T_start ∧
        (∀ v : ℕ, (∀ j < m, v ≠ (initPath.map Prod.fst).getD (2 * j) 0) →
          lcrsParent P T_end v = lcrsParent P T_start v) ∧
        (∀ j < m,
          lcrsParent P T_end ((initPath.map Prod.fst).getD (2 * j) 0) =
            (F.map Prod.fst).getD (2 * j + 2) 0) ∧
        (∀ j < m, (initPath.map Prod.fst).getD (2 * j) 0 ∈ leftSpineBottomUpNat T_end) := by
    intro n
    induction n with
    | zero =>
      intro initPath c b0 r0 hlen F hbst
      rcases initPath with _ | ⟨kr, rest⟩
      · refine ⟨?_, fun _ _ => ?_, fun j hj => by simp at hj, fun j hj => by simp at hj⟩
        · simp [splayLeftSpineNat, foldBST, h_foldRightSpine_eq_attach, F]
        · simp [splayLeftSpineNat, foldBST, h_foldRightSpine_eq_attach, F]
      · simp at hlen
    | succ n ih =>
      intro initPath c b0 r0 hlen F hbst
      rcases initPath with _ | ⟨⟨x, r1⟩, _ | ⟨⟨y, r2⟩, rest⟩⟩
      · refine ⟨?_, fun _ _ => ?_, fun j hj => by simp at hj, fun j hj => by simp at hj⟩
        · simp [splayLeftSpineNat, foldBST, h_foldRightSpine_eq_attach, F]
        · simp [splayLeftSpineNat, foldBST, h_foldRightSpine_eq_attach, F]
      · have hm0 : ([(x, r1)] : List (ℕ × _root_.BinaryTree ℕ)).length / 2 = 0 := by simp
        refine ⟨?_, fun _ _ => ?_, fun j hj => by omega, fun j hj => by omega⟩
        · simp [splayLeftSpineNat, foldBST, foldRightSpine, h_foldRightSpine_eq_attach, F,
            twAttachPoly]
        · simp [splayLeftSpineNat, foldBST, foldRightSpine, h_foldRightSpine_eq_attach, F,
            twAttachPoly]
      · set F' := rest ++ fdmRightSpineFrames b0 r0
        set c' := _root_.BinaryTree.node x c (.node y r1 r2)
        have hF_eq : twAttachPoly c F = twAttachPoly (.node y (.node x c r1) r2) F' := rfl
        rw [hF_eq] at hbst
        have hbst_old := h_attach_bst_bot F' (.node y (.node x c r1) r2) hbst
        have hxy : x < y := by
          cases hbst_old using isBSTCases with
          | node _ _ _ hlt _ _ _ =>
            rw [h_forall_iff] at hlt
            exact hlt x (by simp [inorderNat])
        have hbst_c' : _root_.BinaryTree.IsBST c' := by
          cases hbst_old using isBSTCases with
          | node _ _ _ hlt hr2_gt hbst_cx hbst_r2 =>
            cases hbst_cx using isBSTCases with
            | node _ _ _ hc_lt hr1_gt hbst_c hbst_r1 =>
              have hr1_lt_y : _root_.SplayDeque.Direct.ForallTree (· < y) r1 := by
                rw [h_forall_iff] at hlt ⊢
                exact fun w hw => hlt w (by simp [inorderNat, hw])
              refine .node x c (.node y r1 r2) hc_lt ?_ hbst_c
                (.node y r1 r2 hr1_lt_y hr2_gt hbst_r1 hbst_r2)
              rw [h_forall_iff] at hr1_gt hr2_gt ⊢
              intro w hw
              simp only [inorderNat, List.mem_append, List.mem_singleton] at hw
              rcases hw with (hw | rfl) | hw
              · exact hr1_gt w hw
              · exact hxy
              · exact lt_trans hxy (hr2_gt w hw)
        have hbst_mid : _root_.BinaryTree.IsBST (twAttachPoly c' F') := by
          refine h_attach_bst_replace F' (.node y (.node x c r1) r2) c' hbst hbst_c' ?_
          intro w hw
          simp only [c', inorderNat, List.mem_append, List.mem_singleton] at hw ⊢
          tauto
        have hrot1 : rotateRightOnLeftSpine x (twAttachPoly (.node y (.node x c r1) r2) F') =
            twAttachPoly c' F' := by
          rw [h_rotR_attach F' (.node x c r1) r2 x y hxy hbst]
          simp [rotateRightOnLeftSpine, c']
        have hrest_len : rest.length ≤ n := by simp at hlen; omega
        obtain ⟨ih_tree, ih_other, ih_x, ih_ls⟩ := ih rest c' b0 r0 hrest_len hbst_mid
        have hm_eq : ((x, r1) :: (y, r2) :: rest).length / 2 = rest.length / 2 + 1 := by
          simp only [List.length_cons]
          omega
        have hmap_eq :
            (List.range (((x, r1) :: (y, r2) :: rest).length / 2)).map
              (fun j => (((x, r1) :: (y, r2) :: rest).map Prod.fst).getD (2 * j) 0) =
            x :: (List.range (rest.length / 2)).map
              (fun j => (rest.map Prod.fst).getD (2 * j) 0) := by
          rw [hm_eq, List.range_succ_eq_map, List.map_cons, List.map_map]
          congr 1
        refine ⟨?_, ?_, ?_, ?_⟩
        · rw [hmap_eq, List.foldl_cons, hF_eq, hrot1]
          exact ih_tree
        · intro v hv
          have hvx : v ≠ x := by
            have := hv 0 (by rw [hm_eq]; omega)
            simpa using this
          have hv_rest : ∀ j < rest.length / 2, v ≠ (rest.map Prod.fst).getD (2 * j) 0 := by
            intro j hj
            have := hv (j + 1) (by rw [hm_eq]; omega)
            have h2j : 2 * (j + 1) = 2 * j + 2 := by omega
            simp only [List.map_cons, h2j, List.getD_cons_succ] at this
            exact this
          simp only [List.cons_append, splayLeftSpineNat]
          rw [ih_other v hv_rest, hF_eq]
          exact h_lcrs_attach_congr F' c' (.node y (.node x c r1) r2) P v
            (fun cur => h_lcrs_rot_local c r1 r2 x y cur v hxy hvx)
        · intro j hj
          rw [hm_eq] at hj
          rcases j with _ | j'
          · have hx_not_in_rest : ∀ r < rest.length / 2,
                x ≠ (rest.map Prod.fst).getD (2 * r) 0 := by
              intro r hr
              have h2r : 2 * r < rest.length := by omega
              have hget : (rest.map Prod.fst).getD (2 * r) 0 = rest[2 * r].1 := by
                rw [List.getD_eq_getElem?_getD, List.getElem?_eq_getElem (by simp [h2r])]
                simp
              rw [hget]
              have hmemF' : rest[2 * r].1 ∈ F'.map Prod.fst := by
                simp only [F', List.map_append, List.mem_append]
                exact Or.inl (List.mem_map_of_mem (List.getElem_mem h2r))
              have hlt_x := h_attach_keys_gt F' c' hbst_mid x
                (by simp [c', inorderNat]) rest[2 * r].1 hmemF'
              omega
            simp only [Nat.mul_zero, List.map_cons, List.getD_cons_zero]
            change lcrsParent P (foldBST P (splayLeftSpineNat c' (rest ++ [(b0, r0)]))).1 x =
              (F.map Prod.fst).getD 2 0
            rw [ih_other x hx_not_in_rest]
            cases hF' : F' with
            | nil =>
              simp only [F', List.append_eq_nil_iff] at hF'
              rcases r0 with _ | _ <;> simp [fdmRightSpineFrames] at hF'
            | cons zkr restF' =>
              rcases zkr with ⟨z0, rz0⟩
              rw [hF'] at hbst_mid
              have hxz : x < z0 :=
                h_attach_keys_gt ((z0, rz0) :: restF') c' hbst_mid x (by simp [c', inorderNat])
                  z0 (by simp)
              have hF_get : (F.map Prod.fst).getD 2 0 = z0 := by
                simp [F, F', hF']
              have hF'_unfold : rest ++ fdmRightSpineFrames b0 r0 = (z0, rz0) :: restF' := hF'
              rw [hF_get, lcrsParent, hF'_unfold]
              rw [h_lcrs_attach_lt restF' c' rz0 z0 P x hbst_mid hxz]
              simp [c', lcrsParentAux]
          · have hj' : j' < rest.length / 2 := by omega
            have h1 := ih_x j' hj'
            have h2j : 2 * (j' + 1) = 2 * j' + 2 := by omega
            simp only [List.map_cons, h2j, F, List.cons_append, List.getD_cons_succ]
            exact h1
        · intro j hj
          rw [hm_eq] at hj
          rcases j with _ | j'
          · simp only [Nat.mul_zero, List.map_cons, List.getD_cons_zero, List.cons_append,
              splayLeftSpineNat]
            refine h_splay_keep_ls n rest c' b0 r0 hrest_len x ?_
            simp [c', h_ls_node]
          · have hj' : j' < rest.length / 2 := by omega
            have h1 := ih_ls j' hj'
            have h2j : 2 * (j' + 1) = 2 * j' + 2 := by omega
            simp only [List.map_cons, h2j, List.getD_cons_succ]
            exact h1

  have hs3 : ∀ (t s : ℕ) (H : _root_.BinaryTree ℕ), _root_.BinaryTree.IsBST H → H ≠ .nil →
      (leftSpineBottomUpNat H).head? = some s →
      let ls := leftSpineBottomUpNat H
      let m := (ls.length - 2) / 2
      (foldBST P (popNat H)).1 =
        (popJumpsAt 0 t s ls).foldl (fun T e => rotateRightOnLeftSpine e.x T)
          (spliceMinNat (foldBST P H).1) ∧
      (∀ v : ℕ, s < v → (∀ j < m, v ≠ ls.getD (2 * j + 1) 0) →
        lcrsParent P (foldBST P (popNat H)).1 v = lcrsParent P (foldBST P H).1 v) ∧
      (∀ j < m,
        let x := ls.getD (2 * j + 1) 0
        let y := ls.getD (2 * j + 2) 0
        let z := ls.getD (2 * j + 3) 0
        lcrsParent P (foldBST P H).1 x = y ∧
        lcrsParent P (foldBST P H).1 y = z ∧
        lcrsParent P (foldBST P (popNat H)).1 x = z ∧
        x ∈ leftSpineBottomUpNat (foldBST P (popNat H)).1) := by
    intro t s H hbst hne hhead
    obtain ⟨s0, hls_eq, hH_eq⟩ := h_descend_spec H hne
    have hs0_eq : s0 = s := by
      rw [hls_eq] at hhead
      simpa using hhead
    rw [hs0_eq] at hls_eq hH_eq
    set c := (descendLeftNat H []).1
    rcases hrev : (descendLeftNat H []).2.reverse with _ | ⟨⟨b0, r0⟩, revInit⟩
    · have hpath_nil : (descendLeftNat H []).2 = [] := List.reverse_eq_nil_iff.mp hrev
      have hpop_c : popNat H = c := by
        unfold popNat
        change splayLeftSpineNat c (descendLeftNat H []).2 = c
        rw [hpath_nil]
        rfl
      have hH_node : H = .node s .nil c := by
        rw [hpath_nil] at hH_eq
        exact hH_eq
      have hls_s : leftSpineBottomUpNat H = [s] := by
        rw [hpath_nil] at hls_eq
        exact hls_eq
      have hm0 : ((leftSpineBottomUpNat H).length - 2) / 2 = 0 := by rw [hls_s]; simp
      refine ⟨?_, ?_, fun j hj => by omega⟩
      · dsimp (config := { failIfUnchanged := false }) only
        rw [popJumpsAt, hm0, List.range_zero, List.map_nil, List.foldl_nil, hpop_c, hH_node]
        rcases c with _ | ⟨k1, l1, r1⟩
        · simp [foldBST, foldRightSpine, spliceMinNat]
        · simp only [foldBST, foldRightSpine, h_foldRightSpine_eq_attach]
          rw [h_splice_attach (fdmRightSpineFrames k1 r1) (.node s .nil l1) (by simp)]
          simp [spliceMinNat]
      · intro v hsv _
        rw [hpop_c, hH_node]
        rcases c with _ | ⟨k1, l1, r1⟩
        · have hns : ¬ v < s := by omega
          simp [foldBST, foldRightSpine, lcrsParent, lcrsParentAux, hns, hsv]
        · simp only [foldBST, foldRightSpine, lcrsParent, h_foldRightSpine_eq_attach]
          refine h_lcrs_attach_congr (fdmRightSpineFrames k1 r1) l1 (.node s .nil l1) P v
            (fun cur => ?_)
          have hns : ¬ v < s := by omega
          simp [lcrsParentAux, hns, hsv]
    · set initPath := revInit.reverse
      have hpath_eq : (descendLeftNat H []).2 = initPath ++ [(b0, r0)] := by
        have h1 := congrArg List.reverse hrev
        simpa [initPath] using h1
      have hpop_eq : popNat H = splayLeftSpineNat c (initPath ++ [(b0, r0)]) := by
        unfold popNat
        change splayLeftSpineNat c (descendLeftNat H []).2 = _
        rw [hpath_eq]
      set F := initPath ++ fdmRightSpineFrames b0 r0
      have hH_top : H = .node b0 (twAttachPoly (.node s .nil c) initPath) r0 := by
        rw [hpath_eq, h_attach_append] at hH_eq
        exact hH_eq
      have hfoldH : (foldBST P H).1 = twAttachPoly (.node s .nil c) F := by
        rw [hH_top]
        simp only [foldBST, h_foldRightSpine_eq_attach, F, h_attach_append]
      have hspliceH : spliceMinNat (foldBST P H).1 = twAttachPoly c F := by
        rw [hfoldH, h_splice_attach F (.node s .nil c) (by simp)]
        simp [spliceMinNat]
      have hbst_foldH : _root_.BinaryTree.IsBST (twAttachPoly (.node s .nil c) F) := by
        rw [← hfoldH]
        exact (hs1 H hbst).1
      have hbst_sc : _root_.BinaryTree.IsBST (.node s .nil c) :=
        h_attach_bst_bot F (.node s .nil c) hbst_foldH
      have hbst_c : _root_.BinaryTree.IsBST c := by
        cases hbst_sc using isBSTCases with
        | node _ _ _ _ _ _ hc => exact hc
      have hbst_F : _root_.BinaryTree.IsBST (twAttachPoly c F) := by
        refine h_attach_bst_replace F (.node s .nil c) c hbst_foldH hbst_c ?_
        intro w hw
        simp [inorderNat, hw]
      have hls_full : leftSpineBottomUpNat H = s :: (initPath.map Prod.fst ++ [b0]) := by
        rw [hls_eq, hpath_eq, List.map_append, List.map_singleton]
      have hm_eq : ((leftSpineBottomUpNat H).length - 2) / 2 = initPath.length / 2 := by
        rw [hls_full]
        simp
      have hlcrs_splice : ∀ v : ℕ, s < v →
          lcrsParent P (twAttachPoly c F) v = lcrsParent P (foldBST P H).1 v := by
        intro v hsv
        rw [hfoldH, lcrsParent, lcrsParent]
        refine h_lcrs_attach_congr F c (.node s .nil c) P v (fun cur => ?_)
        have hns : ¬ v < s := by omega
        simp [lcrsParentAux, hns, hsv]
      have hls_get_init : ∀ i : ℕ, i < initPath.length →
          (leftSpineBottomUpNat H).getD (i + 1) 0 = (initPath.map Prod.fst).getD i 0 := by
        intro i hi
        rw [hls_full, List.getD_cons_succ, List.getD_eq_getElem?_getD, List.getD_eq_getElem?_getD]
        rw [List.getElem?_append_left (by simp [hi])]
      have hls_get_F : ∀ i : ℕ, i ≤ initPath.length →
          (leftSpineBottomUpNat H).getD (i + 1) 0 = (F.map Prod.fst).getD i 0 := by
        intro i hi
        rw [hls_full, List.getD_cons_succ]
        simp only [F, List.map_append, h_fdFrames_fst]
        rcases Nat.eq_or_lt_of_le hi with rfl | hlt
        · rw [List.getD_eq_getElem?_getD, List.getD_eq_getElem?_getD]
          have hl : (initPath.map Prod.fst).length = initPath.length := List.length_map _
          rw [List.getElem?_append_right (by omega), List.getElem?_append_right (by omega)]
          simp [hl]
        · rw [List.getD_eq_getElem?_getD, List.getD_eq_getElem?_getD]
          rw [List.getElem?_append_left (by simp [hlt]), List.getElem?_append_left (by simp [hlt])]
      obtain ⟨hp_tree, hp_other, hp_x, hp_ls⟩ :=
        h_pop_splay_ind initPath.length initPath c b0 r0 le_rfl hbst_F
      rw [hpop_eq]
      refine ⟨?_, ?_, ?_⟩
      · dsimp (config := { failIfUnchanged := false }) only
        have hrhs : (popJumpsAt 0 t s (leftSpineBottomUpNat H)).foldl
            (fun T e => rotateRightOnLeftSpine e.x T) (twAttachPoly c F) =
          ((List.range (((leftSpineBottomUpNat H).length - 2) / 2)).map
            (fun j => (leftSpineBottomUpNat H).getD (2 * j + 1) 0)).foldl
            (fun T x => rotateRightOnLeftSpine x T) (twAttachPoly c F) := by
          simp only [popJumpsAt, List.foldl_map]
        have hmap_eq :
            (List.range (((leftSpineBottomUpNat H).length - 2) / 2)).map
              (fun j => (leftSpineBottomUpNat H).getD (2 * j + 1) 0) =
            (List.range (initPath.length / 2)).map
              (fun j => (initPath.map Prod.fst).getD (2 * j) 0) := by
          rw [hm_eq]
          apply List.map_congr_left
          intro j hj
          rw [List.mem_range] at hj
          exact hls_get_init (2 * j) (by omega)
        rw [hspliceH, hp_tree, hrhs, hmap_eq]
      · intro v hsv hv_no
        have hv_no' : ∀ j < initPath.length / 2, v ≠ (initPath.map Prod.fst).getD (2 * j) 0 := by
          intro j hj
          have h := hv_no j (by omega)
          rwa [hls_get_init (2 * j) (by omega)] at h
        rw [hp_other v hv_no', hlcrs_splice v hsv]
      · intro j hj
        have hj' : j < initPath.length / 2 := by omega
        have hF_len : 2 * j + 2 < F.length := by
          simp only [F, List.length_append]
          have : 1 ≤ (fdmRightSpineFrames b0 r0).length := by
            rcases r0 with _ | _ <;> simp [fdmRightSpineFrames]
          omega
        have hx_eq : (leftSpineBottomUpNat H).getD (2 * j + 1) 0 =
            (initPath.map Prod.fst).getD (2 * j) 0 := hls_get_init (2 * j) (by omega)
        have hx_F : (leftSpineBottomUpNat H).getD (2 * j + 1) 0 =
            (F.map Prod.fst).getD (2 * j) 0 := hls_get_F (2 * j) (by omega)
        have hy_F : (leftSpineBottomUpNat H).getD (2 * j + 2) 0 =
            (F.map Prod.fst).getD (2 * j + 1) 0 := hls_get_F (2 * j + 1) (by omega)
        have hz_F : (leftSpineBottomUpNat H).getD (2 * j + 3) 0 =
            (F.map Prod.fst).getD (2 * j + 2) 0 := hls_get_F (2 * j + 2) (by omega)
        have hs_lt_F : ∀ idx < F.length, s < (F.map Prod.fst).getD idx 0 := by
          intro idx hidx
          have hget : (F.map Prod.fst).getD idx 0 = F[idx].1 := by
            rw [List.getD_eq_getElem?_getD, List.getElem?_eq_getElem (by simp [hidx])]
            simp
          rw [hget]
          exact h_attach_keys_gt F (.node s .nil c) hbst_foldH s (by simp [inorderNat])
            F[idx].1 (List.mem_map_of_mem (List.getElem_mem hidx))
        have hs_lt_x : s < (leftSpineBottomUpNat H).getD (2 * j + 1) 0 := by
          rw [hx_F]; exact hs_lt_F (2 * j) (by omega)
        have hs_lt_y : s < (leftSpineBottomUpNat H).getD (2 * j + 2) 0 := by
          rw [hy_F]; exact hs_lt_F (2 * j + 1) (by omega)
        refine ⟨?_, ?_, ?_, ?_⟩
        · dsimp (config := { failIfUnchanged := false }) only
          rw [← hlcrs_splice _ hs_lt_x, hx_F, hy_F]
          exact h_lcrs_attach_adj F c (2 * j) hbst_F (by omega)
        · dsimp (config := { failIfUnchanged := false }) only
          rw [← hlcrs_splice _ hs_lt_y, hy_F, hz_F]
          exact h_lcrs_attach_adj F c (2 * j + 1) hbst_F hF_len
        · dsimp (config := { failIfUnchanged := false }) only
          rw [hx_eq, hz_F]
          exact hp_x j hj'
        · dsimp (config := { failIfUnchanged := false }) only
          rw [hx_eq]
          exact hp_ls j hj'




  have h_step_mono : ∀ id1 (hid1 : id1 < (jumps kops).length)
      id2 (hid2 : id2 < (jumps kops).length),
      id1 ≤ id2 → ((jumps kops)[id1]).step ≤ ((jumps kops)[id2]).step := by
    intro id1 hid1 id2 hid2 hle
    rcases Nat.eq_or_lt_of_le hle with rfl | hlt
    · exact le_rfl
    · rcases hjump.jump_order id1 hid1 id2 hid2 hlt with h | ⟨h, _⟩ <;> omega

  have h_prev_none : ∀ id (hid : id < (jumps kops).length),
      prevWinOpt kops id = none →
      ∀ id' (hid' : id' < id),
        ((jumps kops)[id']'(lt_trans hid' hid)).x ≠ ((jumps kops)[id]).x := by
    intro id hid hnone id' hid'
    unfold prevWinOpt at hnone
    rw [List.getElem?_eq_getElem hid] at hnone
    dsimp (config := { failIfUnchanged := false }) only at hnone
    have hall := List.find?_eq_none.mp hnone
    have hmem_take : (jumps kops)[id']'(lt_trans hid' hid) ∈ (jumps kops).take id := by
      have hlen : ((jumps kops).take id).length = id := List.length_take_of_le (le_of_lt hid)
      have heq : ((jumps kops).take id)[id']'(by omega) =
          (jumps kops)[id']'(lt_trans hid' hid) := List.getElem_take
      rw [← heq]
      exact List.getElem_mem (by omega)
    have hmem_rev : (jumps kops)[id']'(lt_trans hid' hid) ∈ ((jumps kops).take id).reverse :=
      List.mem_reverse.mpr hmem_take
    have hnot := hall _ hmem_rev
    intro hx
    exact hnot (beq_iff_eq.mpr hx)

  have h_prev_some : ∀ id (hid : id < (jumps kops).length) (eL : JumpRecord),
      prevWinOpt kops id = some eL →
      ∃ (hidL_lt : prevWin kops id < id),
        (jumps kops)[prevWin kops id]'(lt_trans hidL_lt hid) = eL ∧
        eL.x = ((jumps kops)[id]).x ∧
        eL.step < ((jumps kops)[id]).step ∧
        ∀ id' (hid' : id' < id),
          ((jumps kops)[id']'(lt_trans hid' hid)).x = ((jumps kops)[id]).x →
          id' ≤ prevWin kops id := by
    intro id hid eL hsome
    have hpw_eq : prevWin kops id = eL.id := by simp [prevWin, hsome]
    unfold prevWinOpt at hsome
    rw [List.getElem?_eq_getElem hid] at hsome
    dsimp (config := { failIfUnchanged := false }) only at hsome
    obtain ⟨hx_beq, as, bs, hrev_eq, has_false⟩ := List.find?_eq_some_iff_append.mp hsome
    have hx_eq : eL.x = ((jumps kops)[id]).x := beq_iff_eq.mp hx_beq
    have htake_eq : (jumps kops).take id = bs.reverse ++ (eL :: as.reverse) := by
      have h1 := congrArg List.reverse hrev_eq
      simp only [List.reverse_reverse, List.reverse_append, List.reverse_cons,
        List.append_assoc, List.singleton_append] at h1
      exact h1
    have htake_len : ((jumps kops).take id).length = id := List.length_take_of_le (le_of_lt hid)
    have hlen_sum : id = bs.reverse.length + (1 + as.reverse.length) := by
      have h1 := congrArg List.length htake_eq
      rw [htake_len, List.length_append, List.length_cons] at h1
      omega
    set idx := bs.reverse.length
    have hidx_lt : idx < id := by omega
    have heL_at : (jumps kops)[idx]'(lt_trans hidx_lt hid) = eL := by
      have h1 : ((jumps kops).take id)[idx]'(by omega) = (jumps kops)[idx]'(lt_trans hidx_lt hid) :=
        List.getElem_take
      rw [← h1]
      conv => lhs; arg 1; rw [htake_eq]
      rw [List.getElem_append_right (le_refl idx)]
      simp [idx]
    have heL_id : eL.id = idx := by
      rw [← heL_at]
      exact (hjump.jump_anatomies idx (lt_trans hidx_lt hid)).1
    have hpw_idx : prevWin kops id = idx := by rw [hpw_eq, heL_id]
    have hpw_lt : prevWin kops id < id := by omega
    have heL_pw : (jumps kops)[prevWin kops id]'(lt_trans hpw_lt hid) = eL := by
      simp [hpw_idx, heL_at]
    have h_max : ∀ id' (hid' : id' < id),
        ((jumps kops)[id']'(lt_trans hid' hid)).x = ((jumps kops)[id]).x →
        id' ≤ prevWin kops id := by
      intro id' hid' hx'
      rw [hpw_idx]
      by_contra hgt
      have hidx_lt_id' : idx < id' := by omega
      have hmem_as : (jumps kops)[id']'(lt_trans hid' hid) ∈ as := by
        have h1 : ((jumps kops).take id)[id']'(by omega) =
            (jumps kops)[id']'(lt_trans hid' hid) := List.getElem_take
        rw [← h1]
        have h2 : ((jumps kops).take id)[id']'(by omega) =
            (bs.reverse ++ (eL :: as.reverse))[id']'(by rw [← htake_eq]; omega) := by
          congr 1
        rw [h2, List.getElem_append_right (by omega)]
        set k := id' - idx - 1
        have hk : id' - idx = k + 1 := by omega
        have hk_lt : k < as.reverse.length := by omega
        have hcons_len : (eL :: as.reverse).length = as.reverse.length + 1 := List.length_cons
        have h3 : (eL :: as.reverse)[id' - idx]'(by omega) = as.reverse[k]'hk_lt := by
          simp [hk]
        rw [h3]
        exact List.mem_reverse.mp (List.getElem_mem hk_lt)
      have hf := has_false _ hmem_as
      simp [hx'] at hf
    have hstep_lt : eL.step < ((jumps kops)[id]).step := by
      have hle := h_step_mono idx (lt_trans hidx_lt hid) id hid (le_of_lt hidx_lt)
      rw [heL_at] at hle
      rcases Nat.eq_or_lt_of_le hle with hstep_eq | hlt
      · exfalso
        have hgrow : ∀ d : ℕ, (hd : idx + d ≤ id) →
            ((jumps kops)[idx]'(lt_trans hidx_lt hid)).x + d ≤
              ((jumps kops)[idx + d]'(lt_of_le_of_lt hd hid)).x := by
          intro d
          induction d with
          | zero => intro _; simp
          | succ d ih =>
            intro hd
            have hd0 : idx + d < id := by omega
            have hprev := ih (le_of_lt hd0)
            have hst_ge := h_step_mono idx (lt_trans hidx_lt hid) (idx + d)
              (lt_trans hd0 hid) (by omega)
            rw [heL_at, hstep_eq] at hst_ge
            rcases hjump.jump_order (idx + d) (lt_trans hd0 hid) id hid hd0 with hlt_s | ⟨heq_s, hj_lt⟩
            · omega
            · obtain ⟨_, _, _, _, _, hxy, hyz, _, ⟨hm_q, _⟩, hnext_q⟩ :=
                hjump.jump_anatomies (idx + d) (lt_trans hd0 hid)
              obtain ⟨_, _, _, hj_id, _, _, _, _, ⟨hm_id, _⟩, _⟩ :=
                hjump.jump_anatomies id hid
              have hm_eq : ((jumps kops)[idx + d]'(lt_trans hd0 hid)).m = ((jumps kops)[id]).m := by
                rw [hm_q, hm_id, heq_s]
              have hj_lt_m : ((jumps kops)[idx + d]'(lt_trans hd0 hid)).j + 1 <
                  ((jumps kops)[idx + d]'(lt_trans hd0 hid)).m := by omega
              obtain ⟨_, _, _, _, _, hx_next⟩ := hnext_q hj_lt_m
              have hidx_succ : idx + (d + 1) = (idx + d) + 1 := by omega
              have hnext_x : ((jumps kops)[idx + (d + 1)]'(lt_of_le_of_lt hd hid)).x =
                  ((jumps kops)[idx + d]'(lt_trans hd0 hid)).z := by
                simpa [hidx_succ] using hx_next
              omega
        have hfin := hgrow (id - idx) (by omega)
        have hsum : idx + (id - idx) = id := by omega
        simp only [heL_at, hsum] at hfin
        omega
      · exact hlt
    exact ⟨hpw_lt, heL_pw, hx_eq, hstep_lt, h_max⟩

  have h_prev_inj_some : ∀ id1 (hid1 : id1 < (jumps kops).length) (eL1 : JumpRecord),
      prevWinOpt kops id1 = some eL1 →
      ∀ id2 (hid2 : id2 < (jumps kops).length) (eL2 : JumpRecord),
      prevWinOpt kops id2 = some eL2 →
      prevWin kops id1 = prevWin kops id2 → id1 = id2 := by
    intro id1 hid1 eL1 hs1' id2 hid2 eL2 hs2' hpw
    obtain ⟨hlt1, heL1, hx1, _, hmax1⟩ := h_prev_some id1 hid1 eL1 hs1'
    obtain ⟨hlt2, heL2, hx2, _, hmax2⟩ := h_prev_some id2 hid2 eL2 hs2'
    have heL_same : eL1 = eL2 := by
      rw [← heL1, ← heL2]
      simp [hpw]
    subst heL_same
    have hx12 : ((jumps kops)[id1]).x = ((jumps kops)[id2]).x := by omega
    by_contra hne
    rcases Nat.lt_or_gt_of_ne hne with h12 | h21
    · have := hmax2 id1 h12 hx12
      omega
    · have := hmax1 id2 h21 hx12.symm
      omega

  have h_out_primal : ∀ id (hid : id < (jumps kops).length), id ∉ MBaseSet kops →
      ∃ (hidL : prevWin kops id < (jumps kops).length)
        (hidR : upperPrevWin kops id < (jumps kops).length),
        prevWin kops id + 1 = upperPrevWin kops id ∧
        upperPrevWin kops id < id ∧
        let e := (jumps kops)[id]
        let eL := (jumps kops)[prevWin kops id]
        let eR := (jumps kops)[upperPrevWin kops id]
        eL.x = e.x ∧ eR.x = eL.z ∧
        eL.step = eR.step ∧ eL.s = eR.s ∧ eL.step < e.step ∧
        (∀ t, eL.step + 1 ≤ t → t < e.step → isRmergeOnAt kops t e.x = false) ∧
        (∀ id' (hid' : id' < id),
          ((jumps kops)[id']'(lt_trans hid' hid)).x = e.x → id' ≤ prevWin kops id) := by
    intro id hid hnot
    have h_ismb_false : isMBase kops id = false := by
      by_contra htr
      have htr' : isMBase kops id = true := by
        cases h : isMBase kops id <;> simp_all
      exact hnot (Finset.mem_filter.mpr ⟨Finset.mem_range.mpr hid, htr'⟩)
    unfold isMBase at h_ismb_false
    rw [List.getElem?_eq_getElem hid] at h_ismb_false
    dsimp (config := { failIfUnchanged := false }) only at h_ismb_false
    cases hpw_opt : prevWinOpt kops id with
    | none => simp [hpw_opt] at h_ismb_false
    | some eL =>
      rw [hpw_opt] at h_ismb_false
      simp only [Bool.or_eq_false_iff, decide_eq_false_iff_not] at h_ismb_false
      obtain ⟨hj_ne, hany_false⟩ := h_ismb_false
      obtain ⟨hpw_lt, heL_pw, hx_eq, hstep_lt, hmax⟩ := h_prev_some id hid eL hpw_opt
      have hidL : prevWin kops id < (jumps kops).length := lt_trans hpw_lt hid
      obtain ⟨_, _, _, hj_lt, _, _, _, _, _, hnextL⟩ := hjump.jump_anatomies (prevWin kops id) hidL
      have hj_lt_m : ((jumps kops)[prevWin kops id]).j + 1 < ((jumps kops)[prevWin kops id]).m := by
        rw [heL_pw] at hj_lt ⊢
        omega
      obtain ⟨hidR, heR_step, heR_s, _, _, heR_x⟩ := hnextL hj_lt_m
      have hidR' : upperPrevWin kops id < (jumps kops).length := hidR
      have hup_lt_id : upperPrevWin kops id < id := by
        unfold upperPrevWin
        by_contra hge
        have heq_id : prevWin kops id + 1 = id := by omega
        have hst_eq : ((jumps kops)[id]).step = eL.step := by
          rw [← heL_pw, ← heR_step]
          congr 2
          exact heq_id.symm
        omega
      refine ⟨hidL, hidR', rfl, hup_lt_id, ?_⟩
      dsimp (config := { failIfUnchanged := false }) only
      refine ⟨by rw [heL_pw]; exact hx_eq, heR_x, heR_step.symm, heR_s.symm,
        by rw [heL_pw]; exact hstep_lt, ?_, hmax⟩
      intro t ht_lo ht_hi
      rw [heL_pw] at ht_lo
      cases hrm : isRmergeOnAt kops t ((jumps kops)[id]).x with
      | false => rfl
      | true =>
        exfalso
        have hany_true :
            (List.Ico (eL.step + 1) ((jumps kops)[id]).step).any
              (fun t => isRmergeOnAt kops t ((jumps kops)[id]).x) = true := by
          rw [List.any_eq_true]
          exact ⟨t, List.Ico.mem.mpr ⟨ht_lo, ht_hi⟩, hrm⟩
        rw [hany_true] at hany_false
        cases hany_false

  have h_pwin_inj : ∀ id1 < (jumps kops).length, id1 ∉ MBaseSet kops →
      ∀ id2 < (jumps kops).length, id2 ∉ MBaseSet kops →
        prevWin kops id1 = prevWin kops id2 → id1 = id2 := by
    intro id1 hid1 hnot1 id2 hid2 hnot2 hpw
    have hs1' : ∃ eL1, prevWinOpt kops id1 = some eL1 := by
      cases h : prevWinOpt kops id1 with
      | some eL1 => exact ⟨eL1, rfl⟩
      | none =>
        exfalso; apply hnot1
        exact Finset.mem_filter.mpr ⟨Finset.mem_range.mpr hid1, by
          simp [isMBase, List.getElem?_eq_getElem hid1, h]⟩
    have hs2' : ∃ eL2, prevWinOpt kops id2 = some eL2 := by
      cases h : prevWinOpt kops id2 with
      | some eL2 => exact ⟨eL2, rfl⟩
      | none =>
        exfalso; apply hnot2
        exact Finset.mem_filter.mpr ⟨Finset.mem_range.mpr hid2, by
          simp [isMBase, List.getElem?_eq_getElem hid2, h]⟩
    obtain ⟨eL1, hs1'⟩ := hs1'
    obtain ⟨eL2, hs2'⟩ := hs2'
    exact h_prev_inj_some id1 hid1 eL1 hs1' id2 hid2 eL2 hs2' hpw

  have h_upwin_inj : ∀ id1 < (jumps kops).length, id1 ∉ MBaseSet kops →
      ∀ id2 < (jumps kops).length, id2 ∉ MBaseSet kops →
        upperPrevWin kops id1 = upperPrevWin kops id2 → id1 = id2 := by
    intro id1 hid1 hnot1 id2 hid2 hnot2 hup
    unfold upperPrevWin at hup
    exact h_pwin_inj id1 hid1 hnot1 id2 hid2 hnot2 (by omega)

  have h_card : (MBaseSet kops).card ≤ 2 * P + countKeyedRslr kops := by
    let M_first := (MBaseSet kops).filter (fun id => (prevWinOpt kops id).isNone)
    let M_top := (MBaseSet kops).filter (fun id =>
      (match prevWinOpt kops id with
      | some eL => decide (eL.j + 1 = eL.m)
      | none => false : Bool))
    let M_rmerge := (MBaseSet kops).filter (fun id =>
      (match (jumps kops)[id]?, prevWinOpt kops id with
      | some e, some eL =>
          (List.Ico (eL.step + 1) e.step).any (fun t => isRmergeOnAt kops t e.x)
      | _, _ => false : Bool))
    have h_sub : MBaseSet kops ⊆ M_first ∪ M_top ∪ M_rmerge := by
      intro id hid_mb
      obtain ⟨hid_rng, hismb⟩ := Finset.mem_filter.mp hid_mb
      have hid : id < (jumps kops).length := Finset.mem_range.mp hid_rng
      unfold isMBase at hismb
      rw [List.getElem?_eq_getElem hid] at hismb
      dsimp (config := { failIfUnchanged := false }) only at hismb
      simp only [Finset.mem_union, M_first, M_top, M_rmerge, Finset.mem_filter, hid_mb, true_and]
      cases hpw : prevWinOpt kops id with
      | none => exact Or.inl (Or.inl (by simp))
      | some eL =>
        rw [hpw] at hismb
        simp only [Bool.or_eq_true] at hismb
        rcases hismb with h1 | h2
        · exact Or.inl (Or.inr (by simp [h1]))
        · exact Or.inr (by simp [List.getElem?_eq_getElem hid, h2])

    have h_card_first : M_first.card ≤ P := by
      let f1 : ℕ → ℕ := fun id => ((jumps kops)[id]?).elim 0 (·.x)
      have hle : M_first.card ≤ (Finset.range P).card := by
        refine Finset.card_le_card_of_injOn f1 ?_ ?_
        · intro id hid_f
          obtain ⟨hid_mb, _⟩ := Finset.mem_filter.mp (Finset.mem_coe.mp hid_f)
          have hid : id < (jumps kops).length := Finset.mem_range.mp (Finset.mem_filter.mp hid_mb).1
          obtain ⟨_, _, _, _, _, hxy, hyz, hzP, _⟩ := hjump.jump_anatomies id hid
          simp only [Finset.mem_coe, Finset.mem_range, f1, List.getElem?_eq_getElem hid,
            Option.elim_some]
          omega
        · intro id1 hid1_f id2 hid2_f hf_eq
          obtain ⟨hid1_mb, hnone1⟩ := Finset.mem_filter.mp (Finset.mem_coe.mp hid1_f)
          obtain ⟨hid2_mb, hnone2⟩ := Finset.mem_filter.mp (Finset.mem_coe.mp hid2_f)
          have hid1 : id1 < (jumps kops).length :=
            Finset.mem_range.mp (Finset.mem_filter.mp hid1_mb).1
          have hid2 : id2 < (jumps kops).length :=
            Finset.mem_range.mp (Finset.mem_filter.mp hid2_mb).1
          simp only [f1, List.getElem?_eq_getElem hid1, List.getElem?_eq_getElem hid2,
            Option.elim_some] at hf_eq
          have hn1 : prevWinOpt kops id1 = none := Option.isNone_iff_eq_none.mp hnone1
          have hn2 : prevWinOpt kops id2 = none := Option.isNone_iff_eq_none.mp hnone2
          by_contra hne
          rcases Nat.lt_or_gt_of_ne hne with h12 | h21
          · exact h_prev_none id2 hid2 hn2 id1 h12 hf_eq
          · exact h_prev_none id1 hid1 hn1 id2 h21 hf_eq.symm
      simpa using hle

    have h_card_top : M_top.card ≤ P := by
      let f2 : ℕ → ℕ := fun id => (prevWinOpt kops id).elim 0 (·.s)
      have hle : M_top.card ≤ (Finset.range P).card := by
        refine Finset.card_le_card_of_injOn f2 ?_ ?_
        · intro id hid_t
          obtain ⟨hid_mb, htop⟩ := Finset.mem_filter.mp (Finset.mem_coe.mp hid_t)
          have hid : id < (jumps kops).length := Finset.mem_range.mp (Finset.mem_filter.mp hid_mb).1
          cases hpw : prevWinOpt kops id with
          | none => simp [hpw] at htop
          | some eL =>
            obtain ⟨hpw_lt, heL_pw, _, _, _⟩ := h_prev_some id hid eL hpw
            have hidL : prevWin kops id < (jumps kops).length := lt_trans hpw_lt hid
            obtain ⟨_, _, _, _, hsx, hxy, hyz, hzP, _⟩ := hjump.jump_anatomies (prevWin kops id) hidL
            simp only [Finset.mem_coe, Finset.mem_range, f2, hpw, Option.elim_some]
            rw [← heL_pw]
            omega
        · intro id1 hid1_t id2 hid2_t hf_eq
          obtain ⟨hid1_mb, htop1⟩ := Finset.mem_filter.mp (Finset.mem_coe.mp hid1_t)
          obtain ⟨hid2_mb, htop2⟩ := Finset.mem_filter.mp (Finset.mem_coe.mp hid2_t)
          have hid1 : id1 < (jumps kops).length :=
            Finset.mem_range.mp (Finset.mem_filter.mp hid1_mb).1
          have hid2 : id2 < (jumps kops).length :=
            Finset.mem_range.mp (Finset.mem_filter.mp hid2_mb).1
          cases hpw1 : prevWinOpt kops id1 with
          | none => simp [hpw1] at htop1
          | some eL1 =>
            cases hpw2 : prevWinOpt kops id2 with
            | none => simp [hpw2] at htop2
            | some eL2 =>
              rw [hpw1] at htop1
              rw [hpw2] at htop2
              simp only [decide_eq_true_eq] at htop1 htop2
              simp only [f2, hpw1, hpw2, Option.elim_some] at hf_eq
              obtain ⟨hpw1_lt, heL1_pw, _, _, _⟩ := h_prev_some id1 hid1 eL1 hpw1
              obtain ⟨hpw2_lt, heL2_pw, _, _, _⟩ := h_prev_some id2 hid2 eL2 hpw2
              have hidL1 : prevWin kops id1 < (jumps kops).length := lt_trans hpw1_lt hid1
              have hidL2 : prevWin kops id2 < (jumps kops).length := lt_trans hpw2_lt hid2
              obtain ⟨_, hst1_lt0, hop1_0, _, _, _, _, _, ⟨hm1_0, _⟩, _⟩ :=
                hjump.jump_anatomies (prevWin kops id1) hidL1
              obtain ⟨_, hst2_lt0, hop2_0, _, _, _, _, _, ⟨hm2_0, _⟩, _⟩ :=
                hjump.jump_anatomies (prevWin kops id2) hidL2
              have hst1_lt : eL1.step < kops.length := by rwa [heL1_pw] at hst1_lt0
              have hst2_lt : eL2.step < kops.length := by rwa [heL2_pw] at hst2_lt0
              have hop1 : kops[eL1.step] = .pop eL1.s := by
                rw [heL1_pw, List.getElem?_eq_getElem hst1_lt] at hop1_0
                exact Option.some.inj hop1_0
              have hop2 : kops[eL2.step] = .pop eL2.s := by
                rw [heL2_pw, List.getElem?_eq_getElem hst2_lt] at hop2_0
                exact Option.some.inj hop2_0
              have hpstep1 : popStep kops eL1.s = eL1.step := by
                have hsv := hkvalid.step_valid eL1.step hst1_lt
                rw [hop1] at hsv
                exact hsv.2.1
              have hpstep2 : popStep kops eL2.s = eL2.step := by
                have hsv := hkvalid.step_valid eL2.step hst2_lt
                rw [hop2] at hsv
                exact hsv.2.1
              have hstep_same : eL1.step = eL2.step := by rw [← hpstep1, ← hpstep2, hf_eq]
              have hm_same : eL1.m = eL2.m := by
                rw [heL1_pw] at hm1_0
                rw [heL2_pw] at hm2_0
                rw [hm1_0, hm2_0, hstep_same]
              have hj_same : eL1.j = eL2.j := by omega
              have hpw_same : prevWin kops id1 = prevWin kops id2 := by
                by_contra hne_pw
                rcases Nat.lt_or_gt_of_ne hne_pw with hlt | hgt
                · have ho := hjump.jump_order (prevWin kops id1) hidL1 (prevWin kops id2) hidL2 hlt
                  rw [heL1_pw, heL2_pw] at ho
                  rcases ho with h | ⟨_, h⟩ <;> omega
                · have ho := hjump.jump_order (prevWin kops id2) hidL2 (prevWin kops id1) hidL1 hgt
                  rw [heL1_pw, heL2_pw] at ho
                  rcases ho with h | ⟨_, h⟩ <;> omega
              exact h_prev_inj_some id1 hid1 eL1 hpw1 id2 hid2 eL2 hpw2 hpw_same
      simpa using hle

    have h_rslr_append : ∀ (xs : List KeyedCoreOp) (op : KeyedCoreOp),
        countKeyedRslr (xs ++ [op]) =
          countKeyedRslr xs + (match op with | .rslr _ => 1 | _ => 0) := by
      intro xs op
      induction xs with
      | nil => cases op <;> simp [countKeyedRslr]
      | cons head tail ih =>
        cases head
        · simp only [List.cons_append, countKeyedRslr, ih]
        · simp only [List.cons_append, countKeyedRslr, ih]
        · simp only [List.cons_append, countKeyedRslr, ih]; omega

    let isRslrAt (xs : List KeyedCoreOp) (t : ℕ) : Bool :=
      match xs[t]? with
      | some (.rslr _) => true
      | _ => false
    have h_rslr_card : ∀ (xs : List KeyedCoreOp),
        ((Finset.range xs.length).filter (fun t => isRslrAt xs t = true)).card =
          countKeyedRslr xs := by
      intro xs
      induction xs using List.reverseRecOn with
      | nil => simp [countKeyedRslr]
      | append_singleton ys op ih =>
        rw [List.length_append, List.length_singleton, Finset.range_add_one, Finset.filter_insert,
          h_rslr_append]
        have h_congr :
            (Finset.range ys.length).filter (fun t => isRslrAt (ys ++ [op]) t = true) =
              (Finset.range ys.length).filter (fun t => isRslrAt ys t = true) := by
          refine Finset.filter_congr (fun t ht => ?_)
          have ht_lt : t < ys.length := Finset.mem_range.mp ht
          simp only [isRslrAt, List.getElem?_append_left ht_lt]
        rw [h_congr]
        have hnot_mem : ys.length ∉ (Finset.range ys.length).filter
            (fun t => isRslrAt ys t = true) := by
          simp
        cases op <;> simp [isRslrAt, Finset.card_insert_of_notMem hnot_mem, ih]

    have h_card_rmerge : M_rmerge.card ≤ countKeyedRslr kops := by
      let RslrSteps := (Finset.range kops.length).filter (fun t => isRslrAt kops t = true)
      let f3 : ℕ → ℕ := fun id =>
        match (jumps kops)[id]?, prevWinOpt kops id with
        | some e, some eL =>
            ((List.Ico (eL.step + 1) e.step).find? (fun t => isRmergeOnAt kops t e.x)).getD 0
        | _, _ => 0
      have h_f3_spec : ∀ id ∈ M_rmerge,
          ∃ (hid : id < (jumps kops).length) (eL : JumpRecord),
            prevWinOpt kops id = some eL ∧
            eL.step + 1 ≤ f3 id ∧ f3 id < ((jumps kops)[id]).step ∧
            isRmergeOnAt kops (f3 id) ((jumps kops)[id]).x = true := by
        intro id hid_rm
        obtain ⟨hid_mb, hany⟩ := Finset.mem_filter.mp hid_rm
        have hid : id < (jumps kops).length := Finset.mem_range.mp (Finset.mem_filter.mp hid_mb).1
        rw [List.getElem?_eq_getElem hid] at hany
        cases hpw : prevWinOpt kops id with
        | none => simp [hpw] at hany
        | some eL =>
          rw [hpw] at hany
          dsimp (config := { failIfUnchanged := false }) only at hany
          cases hfind : (List.Ico (eL.step + 1) ((jumps kops)[id]).step).find?
              (fun t => isRmergeOnAt kops t ((jumps kops)[id]).x) with
          | none =>
            exfalso
            have hall := List.find?_eq_none.mp hfind
            obtain ⟨t0, ht0_mem, ht0_rm⟩ := List.any_eq_true.mp hany
            exact hall t0 ht0_mem ht0_rm
          | some t =>
            have ht_mem := List.mem_of_find?_eq_some hfind
            obtain ⟨ht_lo, ht_hi⟩ := List.Ico.mem.mp ht_mem
            have ht_rm := List.find?_some hfind
            have hf3_eq : f3 id = t := by
              simp [f3, List.getElem?_eq_getElem hid, hpw, hfind]
            exact ⟨hid, eL, rfl, hf3_eq ▸ ht_lo, hf3_eq ▸ ht_hi, hf3_eq ▸ ht_rm⟩
      have hle : M_rmerge.card ≤ RslrSteps.card := by
        refine Finset.card_le_card_of_injOn f3 ?_ ?_
        · intro id hid_rm
          obtain ⟨hid, _, _, _, ht_hi, ht_rm⟩ := h_f3_spec id (Finset.mem_coe.mp hid_rm)
          have hstep_lt : ((jumps kops)[id]).step < kops.length :=
            (hjump.jump_anatomies id hid).2.1
          have ht_lt : f3 id < kops.length := lt_trans ht_hi hstep_lt
          unfold isRmergeOnAt at ht_rm
          simp only [Finset.mem_coe, RslrSteps, Finset.mem_filter, Finset.mem_range]
          refine ⟨ht_lt, ?_⟩
          cases hkop : kops[f3 id]? with
          | none => simp [hkop] at ht_rm
          | some op =>
            cases op with
            | push _ => simp [hkop] at ht_rm
            | pop _ => simp [hkop] at ht_rm
            | rslr d => simp [isRslrAt, hkop]
        · intro id1 hid1_rm id2 hid2_rm hf_eq
          obtain ⟨hid1, eL1, hpw1, ht1_lo, ht1_hi, ht1_rm⟩ :=
            h_f3_spec id1 (Finset.mem_coe.mp hid1_rm)
          obtain ⟨hid2, eL2, hpw2, ht2_lo, ht2_hi, ht2_rm⟩ :=
            h_f3_spec id2 (Finset.mem_coe.mp hid2_rm)
          set t := f3 id1
          have ht2 : f3 id2 = t := hf_eq.symm
          rw [ht2] at ht2_lo ht2_hi ht2_rm
          have ht_lt : t < kops.length :=
            lt_trans ht1_hi (hjump.jump_anatomies id1 hid1).2.1
          unfold isRmergeOnAt at ht1_rm ht2_rm
          rw [List.getElem?_eq_getElem ht_lt] at ht1_rm ht2_rm
          cases hop : kops[t] with
          | push _ => simp [hop] at ht1_rm
          | pop _ => simp [hop] at ht1_rm
          | rslr d0 =>
            cases d0 with
            | zero => simp [hop] at ht1_rm
            | succ d =>
              rw [hop] at ht1_rm ht2_rm
              dsimp (config := { failIfUnchanged := false }) only at ht1_rm ht2_rm
              have hsv := hkvalid.step_valid t ht_lt
              rw [hop] at hsv
              have hd_lt : d < (rightSpineTopDownNat (keyedState kops t)).length := by omega
              have hget1 : (rightSpineTopDownNat (keyedState kops t)).getD d
                  (((jumps kops)[id1]).x + 1) =
                  (rightSpineTopDownNat (keyedState kops t))[d] := by
                rw [List.getD_eq_getElem?_getD, List.getElem?_eq_getElem hd_lt]; rfl
              have hget2 : (rightSpineTopDownNat (keyedState kops t)).getD d
                  (((jumps kops)[id2]).x + 1) =
                  (rightSpineTopDownNat (keyedState kops t))[d] := by
                rw [List.getD_eq_getElem?_getD, List.getElem?_eq_getElem hd_lt]; rfl
              simp only [Nat.add_one d] at ht1_rm ht2_rm
              rw [hget1, beq_iff_eq] at ht1_rm
              rw [hget2, beq_iff_eq] at ht2_rm
              have hx12 : ((jumps kops)[id1]).x = ((jumps kops)[id2]).x := by omega
              by_contra hne
              obtain ⟨hpw1_lt, heL1_pw, _, _, hmax1⟩ := h_prev_some id1 hid1 eL1 hpw1
              obtain ⟨hpw2_lt, heL2_pw, _, _, hmax2⟩ := h_prev_some id2 hid2 eL2 hpw2
              rcases Nat.lt_or_gt_of_ne hne with h12 | h21
              · have hid1_le := hmax2 id1 h12 hx12
                have hst_le := h_step_mono id1 hid1 (prevWin kops id2) (lt_trans hpw2_lt hid2) hid1_le
                rw [heL2_pw] at hst_le
                omega
              · have hid2_le := hmax1 id2 h21 hx12.symm
                have hst_le := h_step_mono id2 hid2 (prevWin kops id1) (lt_trans hpw1_lt hid1) hid2_le
                rw [heL1_pw] at hst_le
                omega
      rw [← h_rslr_card kops]
      exact hle

    have h1 := Finset.card_le_card h_sub
    have h2 := Finset.card_union_le (M_first ∪ M_top) M_rmerge
    have h3 := Finset.card_union_le M_first M_top
    omega




  have h_exec_append : ∀ (xs ys : List KeyedCoreOp) (H : _root_.BinaryTree ℕ),
      execKeyedList H (xs ++ ys) = execKeyedList (execKeyedList H xs) ys := by
    intro xs
    induction xs with
    | nil => intro ys H; rfl
    | cons x xs ih => intro ys H; exact ih ys (execKeyedOp H x)

  have h_take_succ : ∀ (xs : List KeyedCoreOp) (t : ℕ) (ht : t < xs.length),
      xs.take (t + 1) = xs.take t ++ [xs[t]] := by
    intro xs
    induction xs with
    | nil => intro t ht; simp at ht
    | cons x xs ih =>
      intro t ht
      rcases t with _ | t'
      · rfl
      · exact congrArg (x :: ·) (ih t' (by simp at ht; omega))

  have h_state_succ : ∀ t (ht : t < kops.length),
      keyedState kops (t + 1) = execKeyedOp (keyedState kops t) kops[t] := by
    intro t ht
    unfold keyedState
    rw [h_take_succ kops t ht, h_exec_append]
    rfl

  have h_mem_of_getElem? : ∀ (l : List ℕ) (idx val : ℕ),
      l[idx]? = some val → val ∈ l ∧ l.getD idx 0 = val := by
    intro l idx val hget
    by_cases hlt : idx < l.length
    · rw [List.getElem?_eq_getElem hlt] at hget
      have heq : l[idx] = val := Option.some.inj hget
      refine ⟨heq ▸ List.getElem_mem hlt, ?_⟩
      rw [List.getD_eq_getElem?_getD, List.getElem?_eq_getElem hlt, Option.getD_some, heq]
    · rw [List.getElem?_eq_none (by omega)] at hget
      nomatch hget

  have h_pop_jump_bij : ∀ t (ht : t < kops.length) (s : ℕ),
      kops[t] = .pop s →
      ∀ j < ((leftSpineBottomUpNat (keyedState kops t)).length - 2) / 2,
        ∃ id, ∃ (hid : id < (jumps kops).length),
          ((jumps kops)[id]).step = t ∧
          ((jumps kops)[id]).x = (leftSpineBottomUpNat (keyedState kops t)).getD (2 * j + 1) 0 := by
    intro t ht s hop j hj
    obtain ⟨baseId, hbase_le, hstep_iff⟩ := hjump.pop_step_jumps t ht s hop
    have h_j_grow : ∀ (d k : ℕ)
        (hkd : k + d < ((leftSpineBottomUpNat (keyedState kops t)).length - 2) / 2),
        ((jumps kops)[baseId + k]'(by omega)).j + d ≤
          ((jumps kops)[baseId + (k + d)]'(by omega)).j := by
      intro d
      induction d with
      | zero => intro k _; simp
      | succ d ih =>
        intro k hkd
        have hprev := ih k (by omega)
        have h1_lt : baseId + (k + d) < (jumps kops).length := by omega
        have h2_lt : baseId + (k + (d + 1)) < (jumps kops).length := by omega
        have hst1 : ((jumps kops)[baseId + (k + d)]).step = t :=
          (hstep_iff (baseId + (k + d)) h1_lt).mpr ⟨by omega, by omega⟩
        have hst2 : ((jumps kops)[baseId + (k + (d + 1))]).step = t :=
          (hstep_iff (baseId + (k + (d + 1))) h2_lt).mpr ⟨by omega, by omega⟩
        rcases hjump.jump_order (baseId + (k + d)) h1_lt (baseId + (k + (d + 1))) h2_lt (by omega) with
          hlt_s | ⟨_, hj_lt⟩ <;> omega
    have hid_j : baseId + j < (jumps kops).length := by omega
    have hj_lo : j ≤ ((jumps kops)[baseId + j]).j := by
      have h0 := h_j_grow j 0 (by omega)
      simp only [Nat.zero_add] at h0
      omega
    have hj_hi : ((jumps kops)[baseId + j]).j ≤ j := by
      have htop_lt : baseId +
          (j + (((leftSpineBottomUpNat (keyedState kops t)).length - 2) / 2 - 1 - j)) <
          (jumps kops).length := by omega
      have h1 := h_j_grow
        (((leftSpineBottomUpNat (keyedState kops t)).length - 2) / 2 - 1 - j) j (by omega)
      obtain ⟨_, _, _, hj_top_lt0, _, _, _, _, ⟨hm_top0, _⟩, _⟩ :=
        hjump.jump_anatomies
          (baseId + (j + (((leftSpineBottomUpNat (keyedState kops t)).length - 2) / 2 - 1 - j)))
          htop_lt
      have hst_top :
          ((jumps kops)[baseId +
            (j + (((leftSpineBottomUpNat (keyedState kops t)).length - 2) / 2 - 1 - j))]).step = t :=
        (hstep_iff _ htop_lt).mpr ⟨by omega, by omega⟩
      rw [hst_top] at hm_top0
      omega
    have hj_eq : ((jumps kops)[baseId + j]).j = j := by omega
    have hst_j : ((jumps kops)[baseId + j]).step = t :=
      (hstep_iff (baseId + j) hid_j).mpr ⟨by omega, by omega⟩
    obtain ⟨_, _, _, _, _, _, _, _, ⟨_, _, hx_opt, _⟩, _⟩ :=
      hjump.jump_anatomies (baseId + j) hid_j
    rw [hst_j, hj_eq] at hx_opt
    exact ⟨baseId + j, hid_j, hst_j,
      ((h_mem_of_getElem? (leftSpineBottomUpNat (keyedState kops t)) (2 * j + 1) _ hx_opt).2).symm⟩

  have h_fold_bst_inorder : ∀ t ≤ kops.length,
      _root_.BinaryTree.IsBST (foldBST P (keyedState kops t)).1 ∧
        inorderNat (foldBST P (keyedState kops t)).1 = inorderNat (keyedState kops t) := by
    intro t ht
    obtain ⟨h1, h2, _⟩ := hs1 (keyedState kops t) (hkvalid.isBST_state t ht)
    exact ⟨h1, h2⟩

  have h_fold_cursor : ∀ t ≤ kops.length,
      (keyedState kops t = .nil ∧ (foldBST P (keyedState kops t)).2 = P) ∨
        (keyedState kops t ≠ .nil ∧
          (rightSpineTopDownNat (keyedState kops t)).head? =
            some (foldBST P (keyedState kops t)).2 ∧
          (leftSpineBottomUpNat (keyedState kops t)).getLast? =
            some (foldBST P (keyedState kops t)).2) := by
    intro t ht
    exact (hs1 (keyedState kops t) (hkvalid.isBST_state t ht)).2.2.1

  have h_fold_leftSpine : ∀ t ≤ kops.length,
      leftSpineBottomUpNat (foldBST P (keyedState kops t)).1 =
        leftSpineBottomUpNat (keyedState kops t) ++
          (rightSpineTopDownNat (keyedState kops t)).tail := by
    intro t ht
    exact (hs1 (keyedState kops t) (hkvalid.isBST_state t ht)).2.2.2.1

  have h_lcrs_top : ∀ t ≤ kops.length, lcrsParent P (foldBST P (keyedState kops t)).1 P = P := by
    intro t ht
    exact ((hs1 (keyedState kops t) (hkvalid.isBST_state t ht)).2.2.2.2.1
      (fun w hw => (hkvalid.popIdx_bound t ht w hw).2)).1

  have h_lcrs_bounds : ∀ t ≤ kops.length, ∀ v ∈ inorderNat (keyedState kops t),
      v < lcrsParent P (foldBST P (keyedState kops t)).1 v ∧
        lcrsParent P (foldBST P (keyedState kops t)).1 v ≤ P ∧
        (lcrsParent P (foldBST P (keyedState kops t)).1 v = P ∨
          lcrsParent P (foldBST P (keyedState kops t)).1 v ∈ inorderNat (keyedState kops t)) := by
    intro t ht
    exact ((hs1 (keyedState kops t) (hkvalid.isBST_state t ht)).2.2.2.2.1
      (fun w hw => (hkvalid.popIdx_bound t ht w hw).2)).2

  have h_fold_step_push : ∀ t (ht : t < kops.length) (w : ℕ),
      kops[t] = .push w →
        (foldBST P (keyedState kops (t + 1))).1 =
          insertPushFolded (foldBST P (keyedState kops t)).2 w
            (foldBST P (keyedState kops t)).1 ∧
        lcrsParent P (foldBST P (keyedState kops (t + 1))).1 w =
          (foldBST P (keyedState kops t)).2 ∧
        ∀ v, v ≠ w →
          lcrsParent P (foldBST P (keyedState kops (t + 1))).1 v =
            lcrsParent P (foldBST P (keyedState kops t)).1 v := by
    intro t ht w hop
    have hsucc := h_state_succ t ht
    rw [hop] at hsucc
    have hsv := hkvalid.step_valid t ht
    rw [hop] at hsv
    rw [hsucc]
    exact (hs2 (keyedState kops t) (hkvalid.isBST_state t (le_of_lt ht))).1 w hsv.2.2

  have h_fold_step_rslr_zero : ∀ t (ht : t < kops.length),
      kops[t] = .rslr 0 →
        (foldBST P (keyedState kops (t + 1))).1 = (foldBST P (keyedState kops t)).1 := by
    intro t ht hop
    have hsucc := h_state_succ t ht
    rw [hop] at hsucc
    have hsv := hkvalid.step_valid t ht
    rw [hop] at hsv
    rw [hsucc]
    exact (hs2 (keyedState kops t) (hkvalid.isBST_state t (le_of_lt ht))).2.1 hsv

  have h_fold_step_rslr_succ : ∀ t (ht : t < kops.length) (d : ℕ),
      kops[t] = .rslr (d + 1) →
        let rs := rightSpineTopDownNat (keyedState kops t)
        let u := rs.getD d 0
        let p := rs.getD (d + 1) 0
        u ∈ inorderNat (keyedState kops t) ∧
          p ∈ inorderNat (keyedState kops t) ∧
          u < p ∧
          (foldBST P (keyedState kops (t + 1))).1 =
            rotateRightOnLeftSpine u (foldBST P (keyedState kops t)).1 ∧
          lcrsParent P (foldBST P (keyedState kops t)).1 u = p ∧
          lcrsParent P (foldBST P (keyedState kops (t + 1))).1 u =
            lcrsParent P (foldBST P (keyedState kops t)).1 p ∧
          ∀ w, w ≠ u →
            lcrsParent P (foldBST P (keyedState kops (t + 1))).1 w =
              lcrsParent P (foldBST P (keyedState kops t)).1 w := by
    intro t ht d hop
    have hsucc := h_state_succ t ht
    rw [hop] at hsucc
    have hsv := hkvalid.step_valid t ht
    rw [hop] at hsv
    rw [hsucc]
    exact (hs2 (keyedState kops t) (hkvalid.isBST_state t (le_of_lt ht))).2.2 d (by omega)

  have h_fold_step_pop : ∀ t (ht : t < kops.length) (s : ℕ),
      kops[t] = .pop s →
        (foldBST P (keyedState kops (t + 1))).1 =
          (popJumpsAt 0 t s (leftSpineBottomUpNat (keyedState kops t))).foldl
            (fun T e => rotateRightOnLeftSpine e.x T)
            (spliceMinNat (foldBST P (keyedState kops t)).1) ∧
        ∀ v ∈ inorderNat (keyedState kops (t + 1)),
          (∀ id (hid : id < (jumps kops).length),
            ((jumps kops)[id]).step = t → v ≠ ((jumps kops)[id]).x) →
          lcrsParent P (foldBST P (keyedState kops (t + 1))).1 v =
            lcrsParent P (foldBST P (keyedState kops t)).1 v := by
    intro t ht s hop
    have hsucc := h_state_succ t ht
    rw [hop] at hsucc
    have hsv := hkvalid.step_valid t ht
    rw [hop] at hsv
    obtain ⟨hsP, hpstep_s, _, hH_ne, hhead⟩ := hsv
    obtain ⟨hp1, hp2, _⟩ :=
      hs3 t s (keyedState kops t) (hkvalid.isBST_state t (le_of_lt ht)) hH_ne hhead
    refine ⟨by rw [hsucc]; exact hp1, ?_⟩
    intro v hv_in hv_no
    have hpidx : popIdx kops (t + 1) = s + 1 := by
      rw [← hpstep_s]
      exact hkvalid.popIdx_after_popStep s hsP
    have hv_ge : popIdx kops (t + 1) ≤ v := (hkvalid.popIdx_bound (t + 1) (by omega) v hv_in).1
    have hs_lt_v : s < v := by omega
    rw [hsucc]
    refine hp2 v hs_lt_v (fun j hj => ?_)
    obtain ⟨id, hid, hst_id, hx_id⟩ := h_pop_jump_bij t ht s hop j hj
    rw [← hx_id]
    exact hv_no id hid hst_id

  have h_jump_lcrs_and_ls : ∀ id (hid : id < (jumps kops).length),
      let e := (jumps kops)[id]
      lcrsParent P (foldBST P (keyedState kops e.step)).1 e.x = e.y ∧
        lcrsParent P (foldBST P (keyedState kops e.step)).1 e.y = e.z ∧
        lcrsParent P (foldBST P (keyedState kops (e.step + 1))).1 e.x = e.z ∧
        e.x ∈ leftSpineBottomUpNat (foldBST P (keyedState kops (e.step + 1))).1 := by
    intro id hid
    dsimp (config := { failIfUnchanged := false }) only
    obtain ⟨_, hst_lt, hop?, hj_lt, _, _, _, _, ⟨hm_eq, _, hlsx, hlsy, hlsz⟩, _⟩ :=
      hjump.jump_anatomies id hid
    rw [List.getElem?_eq_getElem hst_lt] at hop?
    have hop : kops[((jumps kops)[id]).step] = .pop ((jumps kops)[id]).s := Option.some.inj hop?
    have hsucc : keyedState kops (((jumps kops)[id]).step + 1) =
        popNat (keyedState kops ((jumps kops)[id]).step) := by
      rw [h_state_succ ((jumps kops)[id]).step hst_lt, hop]
      rfl
    have hsv := hkvalid.step_valid ((jumps kops)[id]).step hst_lt
    rw [hop] at hsv
    obtain ⟨_, _, _, hH_ne, hhead⟩ := hsv
    obtain ⟨_, _, hp3⟩ :=
      hs3 ((jumps kops)[id]).step ((jumps kops)[id]).s (keyedState kops ((jumps kops)[id]).step)
        (hkvalid.isBST_state ((jumps kops)[id]).step (le_of_lt hst_lt)) hH_ne hhead
    have hj_lt' : ((jumps kops)[id]).j <
        ((leftSpineBottomUpNat (keyedState kops ((jumps kops)[id]).step)).length - 2) / 2 :=
      hm_eq ▸ hj_lt
    have hres := hp3 ((jumps kops)[id]).j hj_lt'
    have hx_get := (h_mem_of_getElem? _ _ _ hlsx).2
    have hy_get := (h_mem_of_getElem? _ _ _ hlsy).2
    have hz_get := (h_mem_of_getElem? _ _ _ hlsz).2
    dsimp (config := { failIfUnchanged := false }) only at hres
    rw [hx_get, hy_get, hz_get, ← hsucc] at hres
    exact hres

  have h_jump_lcrs : ∀ id (hid : id < (jumps kops).length),
      let e := (jumps kops)[id]
      lcrsParent P (foldBST P (keyedState kops e.step)).1 e.x = e.y ∧
        lcrsParent P (foldBST P (keyedState kops e.step)).1 e.y = e.z ∧
        lcrsParent P (foldBST P (keyedState kops (e.step + 1))).1 e.x = e.z := by
    intro id hid
    obtain ⟨h1, h2, h3, _⟩ := h_jump_lcrs_and_ls id hid
    exact ⟨h1, h2, h3⟩

  have h_lcrs_mono : ∀ t < kops.length, ∀ v ∈ inorderNat (keyedState kops t),
      v ∈ inorderNat (keyedState kops (t + 1)) →
        lcrsParent P (foldBST P (keyedState kops t)).1 v ≤
          lcrsParent P (foldBST P (keyedState kops (t + 1))).1 v := by
    intro t ht v hv0 hv1
    cases hop : kops[t] with
    | push w =>
      have hsv := hkvalid.step_valid t ht
      rw [hop] at hsv
      have hw_lt_v : w < v := (h_forall_iff _ _).mp hsv.2.2 v hv0
      rw [(h_fold_step_push t ht w hop).2.2 v (by omega)]
    | rslr d0 =>
      cases d0 with
      | zero => rw [h_fold_step_rslr_zero t ht hop]
      | succ d =>
        obtain ⟨_, hp_in, _, _, hu_p, hu_next, hw_other⟩ := h_fold_step_rslr_succ t ht d hop
        by_cases hvu : v = (rightSpineTopDownNat (keyedState kops t)).getD d 0
        · rw [hvu, hu_p, hu_next]
          exact le_of_lt (h_lcrs_bounds t (le_of_lt ht) _ hp_in).1
        · rw [hw_other v hvu]
    | pop s =>
      by_cases hex : ∃ id, ∃ (hid : id < (jumps kops).length),
          ((jumps kops)[id]).step = t ∧ v = ((jumps kops)[id]).x
      · obtain ⟨id, hid, hst_id, hvx⟩ := hex
        obtain ⟨h1, _, h3⟩ := h_jump_lcrs id hid
        obtain ⟨_, _, _, _, _, _, hyz, _⟩ := hjump.jump_anatomies id hid
        rw [hvx, ← hst_id, h1, h3]
        omega
      · push_neg at hex
        rw [(h_fold_step_pop t ht s hop).2 v hv1 (fun id hid hst => hex id hid hst)]

  have h_spine_lock : ∀ id (hid : id < (jumps kops).length),
      let e := (jumps kops)[id]
      e.x ∈ leftSpineBottomUpNat (foldBST P (keyedState kops (e.step + 1))).1 ∧
        ∀ t, e.step + 1 ≤ t → t ≤ popStep kops e.x →
          (∀ u ∈ leftSpineBottomUpNat (foldBST P (keyedState kops t)).1,
            ¬(e.x < u ∧ u < e.z)) ∧
          (∀ w, kops[t]? = some (.push w) → w < e.x) := by
    intro id hid
    dsimp (config := { failIfUnchanged := false }) only
    obtain ⟨_, hst_lt, _, _, _, hxy, hyz, hzP, ⟨_, _, hlsx, _⟩, _⟩ :=
      hjump.jump_anatomies id hid
    have hxP : ((jumps kops)[id]).x < P := by omega
    have hx_in_step : ((jumps kops)[id]).x ∈ inorderNat (keyedState kops ((jumps kops)[id]).step) :=
      h_ls_mem_inorder _ _ (h_mem_of_getElem? _ _ _ hlsx).1
    obtain ⟨_, hbirth_lt, _⟩ :=
      (hkvalid.mem_inorder_iff ((jumps kops)[id]).step (le_of_lt hst_lt)
        ((jumps kops)[id]).x).mp hx_in_step
    have hpop_lt_len : popStep kops ((jumps kops)[id]).x < kops.length :=
      (hkvalid.birth_lt_pop ((jumps kops)[id]).x hxP).2
    have hx_alive : ∀ t, ((jumps kops)[id]).step + 1 ≤ t → t ≤ popStep kops ((jumps kops)[id]).x →
        ((jumps kops)[id]).x ∈ inorderNat (keyedState kops t) := by
      intro t ht_lo ht_hi
      exact (hkvalid.mem_inorder_iff t (by omega) ((jumps kops)[id]).x).mpr ⟨hxP, by omega, ht_hi⟩
    have hz_le_parent : ∀ d : ℕ,
        ((jumps kops)[id]).step + 1 + d ≤ popStep kops ((jumps kops)[id]).x →
        ((jumps kops)[id]).z ≤
          lcrsParent P (foldBST P (keyedState kops (((jumps kops)[id]).step + 1 + d))).1
            ((jumps kops)[id]).x := by
      intro d
      induction d with
      | zero =>
        intro _
        simp only [Nat.add_zero]
        exact le_of_eq (h_jump_lcrs id hid).2.2.symm
      | succ d ih =>
        intro hd
        have hprev := ih (by omega)
        have hmono := h_lcrs_mono (((jumps kops)[id]).step + 1 + d) (by omega) ((jumps kops)[id]).x
          (hx_alive (((jumps kops)[id]).step + 1 + d) (by omega) (by omega))
          (hx_alive (((jumps kops)[id]).step + 1 + d + 1) (by omega) hd)
        have hadd : ((jumps kops)[id]).step + 1 + (d + 1) =
            ((jumps kops)[id]).step + 1 + d + 1 := by omega
        rw [hadd]
        exact le_trans hprev hmono
    refine ⟨(h_jump_lcrs_and_ls id hid).2.2.2, ?_⟩
    intro t ht_lo ht_hi
    have ht_lt : t < kops.length := by omega
    have hx_in_t : ((jumps kops)[id]).x ∈ inorderNat (keyedState kops t) := hx_alive t ht_lo ht_hi
    have hz_le_t : ((jumps kops)[id]).z ≤
        lcrsParent P (foldBST P (keyedState kops t)).1 ((jumps kops)[id]).x := by
      have h := hz_le_parent (t - (((jumps kops)[id]).step + 1)) (by omega)
      have heq : ((jumps kops)[id]).step + 1 + (t - (((jumps kops)[id]).step + 1)) = t := by omega
      rwa [heq] at h
    refine ⟨?_, ?_⟩
    · intro u hu ⟨hxu, huz⟩
      have hle_u := (hs1 (keyedState kops t) (hkvalid.isBST_state t (le_of_lt ht_lt))).2.2.2.2.2
        ((jumps kops)[id]).x u hx_in_t hu hxu
      omega
    · intro w hkop_w
      rw [List.getElem?_eq_getElem ht_lt] at hkop_w
      have hop_w : kops[t] = .push w := Option.some.inj hkop_w
      have hsv := hkvalid.step_valid t ht_lt
      rw [hop_w] at hsv
      exact (h_forall_iff _ _).mp hsv.2.2 ((jumps kops)[id]).x hx_in_t

  have h_outside_mbase : ∀ id (hid : id < (jumps kops).length),
      id ∉ MBaseSet kops →
        ∃ (hidL : prevWin kops id < (jumps kops).length)
          (hidR : upperPrevWin kops id < (jumps kops).length),
          prevWin kops id + 1 = upperPrevWin kops id ∧
            upperPrevWin kops id < id ∧
            let e := (jumps kops)[id]
            let eL := (jumps kops)[prevWin kops id]
            let eR := (jumps kops)[upperPrevWin kops id]
            eL.x = e.x ∧ eL.z = e.y ∧ eR.x = e.y ∧
              eL.step = eR.step ∧ eL.s = eR.s ∧ eL.step < e.step ∧
              (∀ id' (hid' : id' < id),
                ((jumps kops)[id']'(lt_trans hid' hid)).x = e.x → id' ≤ prevWin kops id) := by
    intro id hid hnot
    obtain ⟨hidL, hidR, hp1, hp2, hx_eq, heR_x, hst_LR, hs_LR, hst_lt, hno_rm, hmax⟩ :=
      h_out_primal id hid hnot
    obtain ⟨_, hst_e_lt, _, _, _, _, _, _, ⟨_, _, hlsx_e, _⟩, _⟩ :=
      hjump.jump_anatomies id hid
    obtain ⟨_, hst_eL_lt, _, _, _, _, _, _, ⟨_, _, hlsx_eL, _⟩, _⟩ :=
      hjump.jump_anatomies (prevWin kops id) hidL
    have hx_in_e : ((jumps kops)[id]).x ∈ inorderNat (keyedState kops ((jumps kops)[id]).step) :=
      h_ls_mem_inorder _ _ (h_mem_of_getElem? _ _ _ hlsx_e).1
    have hx_in_eL :
        ((jumps kops)[id]).x ∈
          inorderNat (keyedState kops ((jumps kops)[prevWin kops id]).step) := by
      rw [← hx_eq]
      exact h_ls_mem_inorder _ _ (h_mem_of_getElem? _ _ _ hlsx_eL).1
    obtain ⟨hxP, _, hpop_ge⟩ :=
      (hkvalid.mem_inorder_iff ((jumps kops)[id]).step (le_of_lt hst_e_lt)
        ((jumps kops)[id]).x).mp hx_in_e
    obtain ⟨_, hbirth_lt, _⟩ :=
      (hkvalid.mem_inorder_iff ((jumps kops)[prevWin kops id]).step (le_of_lt hst_eL_lt)
        ((jumps kops)[id]).x).mp hx_in_eL
    have hx_alive : ∀ t, ((jumps kops)[prevWin kops id]).step + 1 ≤ t →
        t ≤ ((jumps kops)[id]).step →
        ((jumps kops)[id]).x ∈ inorderNat (keyedState kops t) := by
      intro t ht_lo ht_hi
      exact (hkvalid.mem_inorder_iff t (by omega) ((jumps kops)[id]).x).mpr ⟨hxP, by omega, by omega⟩
    have h_const_parent : ∀ d : ℕ,
        ((jumps kops)[prevWin kops id]).step + 1 + d ≤ ((jumps kops)[id]).step →
        lcrsParent P
          (foldBST P (keyedState kops (((jumps kops)[prevWin kops id]).step + 1 + d))).1
          ((jumps kops)[id]).x = ((jumps kops)[prevWin kops id]).z := by
      intro d
      induction d with
      | zero =>
        intro _
        simp only [Nat.add_zero]
        rw [← hx_eq]
        exact (h_jump_lcrs (prevWin kops id) hidL).2.2
      | succ d ih =>
        intro hd
        have ht_lt : ((jumps kops)[prevWin kops id]).step + 1 + d < kops.length := by omega
        have hprev :
            lcrsParent P
              (foldBST P (keyedState kops (((jumps kops)[prevWin kops id]).step + 1 + d))).1
              ((jumps kops)[id]).x = ((jumps kops)[prevWin kops id]).z := ih (by omega)
        have hadd : ((jumps kops)[prevWin kops id]).step + 1 + (d + 1) =
            (((jumps kops)[prevWin kops id]).step + 1 + d) + 1 := by omega
        rw [hadd, ← hprev]
        cases hop : kops[((jumps kops)[prevWin kops id]).step + 1 + d] with
        | push w =>
          have hsv := hkvalid.step_valid (((jumps kops)[prevWin kops id]).step + 1 + d) ht_lt
          rw [hop] at hsv
          have hw_lt : w < ((jumps kops)[id]).x :=
            (h_forall_iff _ _).mp hsv.2.2 ((jumps kops)[id]).x
              (hx_alive (((jumps kops)[prevWin kops id]).step + 1 + d) (by omega) (by omega))
          exact (h_fold_step_push (((jumps kops)[prevWin kops id]).step + 1 + d) ht_lt w hop).2.2
            ((jumps kops)[id]).x (by omega)
        | rslr d0 =>
          cases d0 with
          | zero =>
            rw [h_fold_step_rslr_zero (((jumps kops)[prevWin kops id]).step + 1 + d) ht_lt hop]
          | succ rd =>
            have hrm_f := hno_rm (((jumps kops)[prevWin kops id]).step + 1 + d) (by omega) (by omega)
            unfold isRmergeOnAt at hrm_f
            rw [List.getElem?_eq_getElem ht_lt, hop] at hrm_f
            dsimp (config := { failIfUnchanged := false }) only at hrm_f
            have hsv := hkvalid.step_valid (((jumps kops)[prevWin kops id]).step + 1 + d) ht_lt
            rw [hop] at hsv
            have hrd_lt : rd < (rightSpineTopDownNat
                (keyedState kops (((jumps kops)[prevWin kops id]).step + 1 + d))).length := by omega
            have hget_eq :
                (rightSpineTopDownNat
                  (keyedState kops (((jumps kops)[prevWin kops id]).step + 1 + d))).getD
                  rd (((jumps kops)[id]).x + 1) =
                (rightSpineTopDownNat
                  (keyedState kops (((jumps kops)[prevWin kops id]).step + 1 + d))).getD
                  rd 0 := by
              rw [List.getD_eq_getElem?_getD, List.getD_eq_getElem?_getD,
                List.getElem?_eq_getElem hrd_lt]
              rfl
            simp only [Nat.add_one rd] at hrm_f
            rw [hget_eq, beq_eq_false_iff_ne] at hrm_f
            exact (h_fold_step_rslr_succ
              (((jumps kops)[prevWin kops id]).step + 1 + d) ht_lt rd hop).2.2.2.2.2.2
              ((jumps kops)[id]).x (Ne.symm hrm_f)
        | pop s' =>
          refine (h_fold_step_pop (((jumps kops)[prevWin kops id]).step + 1 + d) ht_lt s' hop).2
            ((jumps kops)[id]).x
            (hx_alive ((((jumps kops)[prevWin kops id]).step + 1 + d) + 1) (by omega) hd) ?_
          intro id' hid' hst_id' hx_id'
          have hid'_lt_id : id' < id := by
            by_contra hge
            have hle_st := h_step_mono id hid id' hid' (by omega)
            omega
          have hid'_le_pw := hmax id' hid'_lt_id hx_id'.symm
          have hst_le := h_step_mono id' hid' (prevWin kops id) hidL hid'_le_pw
          omega
    have heL_z_eq_ey : ((jumps kops)[prevWin kops id]).z = ((jumps kops)[id]).y := by
      have h1 := h_const_parent
        (((jumps kops)[id]).step - (((jumps kops)[prevWin kops id]).step + 1)) (by omega)
      have hsum : ((jumps kops)[prevWin kops id]).step + 1 +
          (((jumps kops)[id]).step - (((jumps kops)[prevWin kops id]).step + 1)) =
          ((jumps kops)[id]).step := by omega
      rw [hsum] at h1
      have h2 := (h_jump_lcrs id hid).1
      exact h1.symm.trans h2
    refine ⟨hidL, hidR, hp1, hp2, ?_⟩
    dsimp (config := { failIfUnchanged := false }) only
    exact ⟨hx_eq, heL_z_eq_ey, by rw [heR_x, heL_z_eq_ey], hst_LR, hs_LR, hst_lt, hmax⟩

  exact ⟨{
    fold_bst_inorder := h_fold_bst_inorder
    fold_cursor := h_fold_cursor
    fold_leftSpine := h_fold_leftSpine
    fold_step_push := h_fold_step_push
    fold_step_rslr_zero := h_fold_step_rslr_zero
    fold_step_rslr_succ := h_fold_step_rslr_succ
    fold_step_pop := h_fold_step_pop
    jump_lcrs := h_jump_lcrs
    lcrs_bounds := h_lcrs_bounds
    lcrs_top := h_lcrs_top
    lcrs_mono := h_lcrs_mono
    spine_lock := h_spine_lock
    outside_mbase := h_outside_mbase
    prevWin_inj := h_pwin_inj
    upperPrevWin_inj := h_upwin_inj
  }, h_card⟩


-- === BEGIN SolPart3 ===
theorem folded_spine_lock_and_confinement_buckets (P L : ℕ) (S : ℕ → ℕ) (kops : List KeyedCoreOp)
    (_hP : 1 ≤ P) (hL : 1 ≤ L) (hS0 : S 0 = P) (_hSL : L ≤ S L)
    (_hS_step : ∀ ℓ : ℕ, ℓ < L → 2 * S (ℓ + 1) ≤ S ℓ)
    (hkvalid : ValidKeyedCoreSeq P kops) (hjump : PrimalJumpLaws P kops)
    (hfold : ValidFoldedCoreLaws P kops) (hpart : ScalePartitionLaws S P L) :
    (B_fin_pre S P L kops).card ≤ P ∧
    (B_1 S P L kops).card ≤
      P + 2 * (L * (scaleBlocks S P L).length) + (B_fin_pre S P L kops).card ∧
    (B_3_intra S P L kops).card ≤
      2 * P + countKeyedRslr kops + (B_1 S P L kops).card +
        (B_fin_pre S P L kops).card ∧
    (B_2 S P L kops).card ≤
      2 * P + 2 * (L * (scaleBlocks S P L).length) +
        (B_fin_pre S P L kops).card + (B_1 S P L kops).card +
        (B_3_intra S P L kops).card + (B_3_post S P L kops).card +
        (B_3_act S P L kops).card :=
by
  have h_ls_aux : ∀ (T : _root_.BinaryTree ℕ) (acc : List ℕ) (u : ℕ),
      u ∈ leftSpineBottomUpAux T acc → u ∈ inorderNat T ∨ u ∈ acc := by
    intro T
    induction T with
    | nil =>
      intro acc u hu
      exact Or.inr hu
    | node k l r ihl _ =>
      intro acc u hu
      simp only [leftSpineBottomUpAux] at hu
      rcases ihl (k :: acc) u hu with hl | hacc
      · left
        simp only [inorderNat, List.mem_append]
        exact Or.inl (Or.inl hl)
      · rcases List.mem_cons.mp hacc with rfl | hacc'
        · left
          simp [inorderNat]
        · exact Or.inr hacc'

  have h_ls_mem_inorder : ∀ (T : _root_.BinaryTree ℕ) (u : ℕ),
      u ∈ leftSpineBottomUpNat T → u ∈ inorderNat T := by
    intro T u hu
    rcases h_ls_aux T [] u hu with h | h
    · exact h
    · simp at h

  have h_primal_ls : ∀ t ≤ kops.length, ∀ (i u : ℕ),
      (leftSpineBottomUpNat (keyedState kops t))[i]? = some u →
      u ∈ leftSpineBottomUpNat (foldBST P (keyedState kops t)).1 := by
    intro t ht i u hget
    rw [hfold.fold_leftSpine t ht]
    exact List.mem_append_left _ (List.mem_of_getElem? hget)

  have h_jump_bounds : ∀ id (hid : id < (jumps kops).length),
      let e := (jumps kops)[id]
      e.step < kops.length ∧ e.j < e.m ∧
        e.s < e.x ∧ e.x < e.y ∧ e.y < e.z ∧ e.z < P := by
    intro id hid
    obtain ⟨_, hstep, _, hjm, hsx, hxy, hyz, hzP, _, _⟩ := hjump.jump_anatomies id hid
    exact ⟨hstep, hjm, hsx, hxy, hyz, hzP⟩

  have h_jump_popStep : ∀ id (hid : id < (jumps kops).length),
      popStep kops ((jumps kops)[id]).s = ((jumps kops)[id]).step := by
    intro id hid
    obtain ⟨_, hstep, hpop_opt, _, _, _, _, _, _, _⟩ := hjump.jump_anatomies id hid
    have hget : kops[((jumps kops)[id]).step] = .pop ((jumps kops)[id]).s := by
      rw [List.getElem?_eq_getElem hstep] at hpop_opt
      exact Option.some.inj hpop_opt
    have hsv := hkvalid.step_valid ((jumps kops)[id]).step hstep
    rw [hget] at hsv
    exact hsv.2.1

  have h_jump_ls : ∀ id (hid : id < (jumps kops).length),
      let e := (jumps kops)[id]
      e.x ∈ leftSpineBottomUpNat (foldBST P (keyedState kops e.step)).1 ∧
        e.y ∈ leftSpineBottomUpNat (foldBST P (keyedState kops e.step)).1 ∧
        e.z ∈ leftSpineBottomUpNat (foldBST P (keyedState kops e.step)).1 := by
    intro id hid
    obtain ⟨_, hstep, _, _, _, _, _, _, ⟨_, _, hx, hy, hz⟩, _⟩ := hjump.jump_anatomies id hid
    have hle : ((jumps kops)[id]).step ≤ kops.length := Nat.le_of_lt hstep
    exact ⟨h_primal_ls _ hle _ _ hx, h_primal_ls _ hle _ _ hy, h_primal_ls _ hle _ _ hz⟩

  have h_jump_succ : ∀ id (hid : id < (jumps kops).length),
      ((jumps kops)[id]).j + 1 < ((jumps kops)[id]).m →
      ∃ hid' : id + 1 < (jumps kops).length,
        let e := (jumps kops)[id]
        let e' := (jumps kops)[id + 1]
        e'.step = e.step ∧ e'.s = e.s ∧ e'.j = e.j + 1 ∧ e'.m = e.m ∧ e'.x = e.z := by
    intro id hid hjm
    obtain ⟨_, _, _, _, _, _, _, _, _, hsucc⟩ := hjump.jump_anatomies id hid
    exact hsucc hjm

  have h_adj_step : ∀ id1 (h2 : id1 + 1 < (jumps kops).length),
      ((jumps kops)[id1]).step = ((jumps kops)[id1 + 1]).step →
      ((jumps kops)[id1]).j + 1 < ((jumps kops)[id1]).m ∧
        ((jumps kops)[id1]).z = ((jumps kops)[id1 + 1]).x := by
    intro id1 h2 hst
    have h1 : id1 < (jumps kops).length := by omega
    have hord := hjump.jump_order id1 h1 (id1 + 1) h2 (by omega)
    have hj_lt : ((jumps kops)[id1]).j < ((jumps kops)[id1 + 1]).j := by
      rcases hord with hlt | ⟨_, hj⟩
      · omega
      · exact hj
    obtain ⟨_, _, _, _, _, _, _, _, ⟨hm1, _⟩, hsucc1⟩ := hjump.jump_anatomies id1 h1
    obtain ⟨_, _, _, hj2m2, _, _, _, _, ⟨hm2, _⟩, _⟩ := hjump.jump_anatomies (id1 + 1) h2
    have hm_eq : ((jumps kops)[id1]).m = ((jumps kops)[id1 + 1]).m := by
      rw [hm1, hm2, hst]
    have hjm1 : ((jumps kops)[id1]).j + 1 < ((jumps kops)[id1]).m := by omega
    obtain ⟨_, _, _, _, _, hx_eq⟩ := hsucc1 hjm1
    exact ⟨hjm1, hx_eq.symm⟩

  have h_same_step : ∀ id1 (hid1 : id1 < (jumps kops).length)
      id2 (hid2 : id2 < (jumps kops).length),
      id1 < id2 →
      ((jumps kops)[id1]).step = ((jumps kops)[id2]).step →
      ((jumps kops)[id1]).z ≤ ((jumps kops)[id2]).x := by
    have h_ind : ∀ id2 (hid2 : id2 < (jumps kops).length)
        id1 (hid1 : id1 < (jumps kops).length),
        id1 < id2 →
        ((jumps kops)[id1]).step = ((jumps kops)[id2]).step →
        ((jumps kops)[id1]).z ≤ ((jumps kops)[id2]).x := by
      intro id2
      induction id2 with
      | zero =>
        intro _ _ _ hlt
        omega
      | succ id2 ih =>
        intro hid2 id1 hid1 hlt hst
        by_cases heq : id1 = id2
        · subst heq
          have hadj := (h_adj_step id1 hid2 hst).2
          omega
        · have hlt' : id1 < id2 := by omega
          have hid2' : id2 < (jumps kops).length := by omega
          have hord1 := hjump.jump_order id1 hid1 id2 hid2' hlt'
          have hord2 := hjump.jump_order id2 hid2' (id2 + 1) hid2 (by omega)
          have hst1 : ((jumps kops)[id1]).step = ((jumps kops)[id2]).step := by
            rcases hord1 with h1 | ⟨h1, _⟩ <;> rcases hord2 with h2 | ⟨h2, _⟩ <;> omega
          have hst2 : ((jumps kops)[id2]).step = ((jumps kops)[id2 + 1]).step := by
            omega
          have hrec := ih hid2' id1 hid1 hlt' hst1
          have hadj := (h_adj_step id2 hid2 hst2).2
          have hb2 := h_jump_bounds id2 hid2'
          dsimp (config := { failIfUnchanged := false }) only at hb2
          omega
    intro id1 hid1 id2 hid2 hlt hst
    exact h_ind id2 hid2 id1 hid1 hlt hst

  have h_lock_contra : ∀ id1 (hid1 : id1 < (jumps kops).length)
      id2 (hid2 : id2 < (jumps kops).length),
      ((jumps kops)[id1]).step < ((jumps kops)[id2]).step →
      ((jumps kops)[id2]).s < ((jumps kops)[id1]).x →
      ∀ u ∈ leftSpineBottomUpNat (foldBST P (keyedState kops ((jumps kops)[id2]).step)).1,
        ((jumps kops)[id1]).x < u → u < ((jumps kops)[id1]).z → False := by
    intro id1 hid1 id2 hid2 hst_lt hs_lt u hu_ls hux huz
    have hb1 := h_jump_bounds id1 hid1
    dsimp (config := { failIfUnchanged := false }) only at hb1
    have hx1P : ((jumps kops)[id1]).x < P := by omega
    have hp2 := h_jump_popStep id2 hid2
    have hpmono := hkvalid.popStep_mono ((jumps kops)[id2]).s ((jumps kops)[id1]).x hs_lt hx1P
    exact ((hfold.spine_lock id1 hid1).2 ((jumps kops)[id2]).step (by omega) (by omega)).1
      u hu_ls ⟨hux, huz⟩

  have h_last_jump_contra : ∀ id1 (hid1 : id1 < (jumps kops).length)
      id2 (hid2 : id2 < (jumps kops).length),
      id1 < id2 →
      ((jumps kops)[id1]).s = ((jumps kops)[id2]).s →
      ¬(((jumps kops)[id1]).j + 1 < ((jumps kops)[id1]).m) → False := by
    intro id1 hid1 id2 hid2 hlt hs_eq hnot
    have hst1 := h_jump_popStep id1 hid1
    have hst2 := h_jump_popStep id2 hid2
    rw [hs_eq] at hst1
    have hst_eq : ((jumps kops)[id1]).step = ((jumps kops)[id2]).step := hst1.symm.trans hst2
    have hord := hjump.jump_order id1 hid1 id2 hid2 hlt
    have hj_lt : ((jumps kops)[id1]).j < ((jumps kops)[id2]).j := by
      rcases hord with h | ⟨_, hj⟩
      · omega
      · exact hj
    obtain ⟨_, _, _, _, _, _, _, _, ⟨hm1, _⟩, _⟩ := hjump.jump_anatomies id1 hid1
    obtain ⟨_, _, _, hj2m2, _, _, _, _, ⟨hm2, _⟩, _⟩ := hjump.jump_anatomies id2 hid2
    have hm_eq : ((jumps kops)[id1]).m = ((jumps kops)[id2]).m := by
      rw [hm1, hm2, hst_eq]
    omega

  have h_block_bounds_of : ∀ ℓ ≤ L, ∀ u < P,
      (blockOf S P ℓ u).1 ≤ u ∧ u < (blockOf S P ℓ u).2 ∧
        (blockOf S P ℓ u).2 ≤ P ∧ blockIdx S P ℓ u < (scaleBlocks S P ℓ).length := by
    intro ℓ hℓ u hu
    obtain ⟨hidx, hlo, hhi, hget⟩ := hpart.blocks_partition ℓ hℓ u hu
    have hmem : blockOf S P ℓ u ∈ scaleBlocks S P ℓ := List.mem_of_getElem? hget
    obtain ⟨_, hP_le, _, _⟩ := hpart.blocks_bounds ℓ hℓ (blockOf S P ℓ u) hmem
    exact ⟨hlo, hhi, hP_le, hidx⟩

  have h_block_disj : ∀ ℓ ≤ L, ∀ u v, u < v → v < P →
      blockIdx S P ℓ u ≠ blockIdx S P ℓ v →
      u < (blockOf S P ℓ v).1 ∧ (blockOf S P ℓ u).2 ≤ v := by
    intro ℓ hℓ u v huv hvP hne
    have huP : u < P := by omega
    obtain ⟨hlo_u, _, _, _⟩ := h_block_bounds_of ℓ hℓ u huP
    obtain ⟨_, hhi_v, _, _⟩ := h_block_bounds_of ℓ hℓ v hvP
    refine ⟨?_, ?_⟩
    · by_contra hcon
      have hv_u : (blockOf S P ℓ v).1 ≤ u ∧ u < (blockOf S P ℓ v).2 := ⟨by omega, by omega⟩
      exact hne ((hpart.blocks_eq_iff ℓ hℓ v hvP u huP).mpr hv_u).symm
    · by_contra hcon
      have hu_v : (blockOf S P ℓ u).1 ≤ v ∧ v < (blockOf S P ℓ u).2 := ⟨by omega, by omega⟩
      exact hne ((hpart.blocks_eq_iff ℓ hℓ u huP v hvP).mpr hu_v)

  have h_block_nest : ∀ m n, m ≤ n → n ≤ L → ∀ y < P,
      (blockOf S P m y).1 ≤ (blockOf S P n y).1 ∧
        (blockOf S P n y).2 ≤ (blockOf S P m y).2 := by
    intro m n hmn hnL y hy
    by_cases hmeq : m = n
    · subst hmeq
      exact ⟨le_rfl, le_rfl⟩
    · have hm_lt : m < n := by omega
      have hmL : m ≤ L := by omega
      obtain ⟨hlo_m, hhi_m, _, _⟩ := h_block_bounds_of m hmL y hy
      obtain ⟨hlo_n, hhi_n, hP_n, _⟩ := h_block_bounds_of n hnL y hy
      refine ⟨?_, ?_⟩
      · by_contra hcon
        set v := (blockOf S P n y).1
        have hvP : v < P := by omega
        have hidx_n : blockIdx S P n y = blockIdx S P n v :=
          (hpart.blocks_eq_iff n hnL y hy v hvP).mpr ⟨le_rfl, by omega⟩
        have hsep_n : n < sepScale S P L y v :=
          (hpart.sep_gt_iff n hnL y hy v hvP).mpr hidx_n
        have hidx_m : blockIdx S P m y = blockIdx S P m v :=
          (hpart.sep_gt_iff m hmL y hy v hvP).mp (by omega)
        have hmem_m := (hpart.blocks_eq_iff m hmL y hy v hvP).mp hidx_m
        omega
      · by_contra hcon
        set w := (blockOf S P m y).2
        have hwP : w < P := by omega
        have hidx_n : blockIdx S P n y = blockIdx S P n w :=
          (hpart.blocks_eq_iff n hnL y hy w hwP).mpr ⟨by omega, by omega⟩
        have hsep_n : n < sepScale S P L y w :=
          (hpart.sep_gt_iff n hnL y hy w hwP).mpr hidx_n
        have hidx_m : blockIdx S P m y = blockIdx S P m w :=
          (hpart.sep_gt_iff m hmL y hy w hwP).mp (by omega)
        have hmem_m := (hpart.blocks_eq_iff m hmL y hy w hwP).mp hidx_m
        omega

  have h_anc_eq : ∀ m ≤ L, ∀ u < P, ∀ v < P,
      blockIdx S P L u = blockIdx S P L v →
      blockIdx S P m u = blockIdx S P m v ∧ blockOf S P m u = blockOf S P m v := by
    intro m hm u hu v hv hidxL
    have hsep : L < sepScale S P L u v := (hpart.sep_gt_iff L le_rfl u hu v hv).mpr hidxL
    have hidx_m : blockIdx S P m u = blockIdx S P m v :=
      (hpart.sep_gt_iff m hm u hu v hv).mp (by omega)
    exact ⟨hidx_m, by simp only [blockOf, hidx_m]⟩

  have h_card_inj : ∀ {β : Type} (A : Finset ℕ) (B : Finset β) (f : ℕ → β),
      (∀ a ∈ A, f a ∈ B) →
      (∀ a ∈ A, ∀ b ∈ A, a < b → f a = f b → False) →
      A.card ≤ B.card := by
    intro β A B f hmap hlt_ne
    refine Finset.card_le_card_of_injOn f (fun a ha => hmap a (Finset.mem_coe.mp ha)) ?_
    intro a ha b hb heq
    have ha' := Finset.mem_coe.mp ha
    have hb' := Finset.mem_coe.mp hb
    rcases lt_trichotomy a b with hlt | rfl | hgt
    · exact False.elim (hlt_ne a ha' b hb' hlt heq)
    · rfl
    · exact False.elim (hlt_ne b hb' a ha' hgt heq.symm)

  have h_split_card : ∀ (A : Finset ℕ) (p : ℕ → Prop) [DecidablePred p],
      A.card = (A.filter p).card + (A.filter (fun x => ¬p x)).card := by
    intro A p _
    exact (Finset.card_filter_add_card_filter_not (s := A) p).symm

  have h_prod_card :
      ((Finset.range (scaleBlocks S P L).length) ×ˢ (Finset.Icc 1 L)).card =
        L * (scaleBlocks S P L).length := by
    rw [Finset.card_product, Finset.card_range, Nat.card_Icc]
    have : L + 1 - 1 = L := by omega
    rw [this, Nat.mul_comm]




  have h_conj1 : (B_fin_pre S P L kops).card ≤ P := by
    have hle := h_card_inj (B_fin_pre S P L kops) (Finset.range P)
      (fun id => ((jumps kops).getD id default).y)
      (fun id hid => by
        simp only [B_fin_pre, Finset.mem_filter, Finset.mem_range] at hid
        obtain ⟨hid_lt, _⟩ := hid
        dsimp (config := { failIfUnchanged := false }) only
        rw [List.getD_eq_getElem _ _ hid_lt, Finset.mem_range]
        have hb := h_jump_bounds id hid_lt
        dsimp (config := { failIfUnchanged := false }) only at hb
        omega)
      (fun id1 hid1 id2 hid2 hlt heq => by
        simp only [B_fin_pre, Finset.mem_filter, Finset.mem_range] at hid1 hid2
        obtain ⟨h1_lt, his1⟩ := hid1
        obtain ⟨h2_lt, his2⟩ := hid2
        dsimp (config := { failIfUnchanged := false }) only at heq
        rw [List.getD_eq_getElem _ _ h1_lt, List.getD_eq_getElem _ _ h2_lt] at heq
        simp only [isBFinPre, List.getElem?_eq_getElem h1_lt,
          List.getElem?_eq_getElem h2_lt, decide_eq_true_eq] at his1 his2
        have hb1 := h_jump_bounds id1 h1_lt
        have hb2 := h_jump_bounds id2 h2_lt
        dsimp (config := { failIfUnchanged := false }) only at hb1 hb2
        rcases hjump.jump_order id1 h1_lt id2 h2_lt hlt with hst_lt | ⟨hst_eq, _⟩
        · have hx1P : ((jumps kops)[id1]).x < P := by omega
          have hy1P : ((jumps kops)[id1]).y < P := by omega
          have hx2P : ((jumps kops)[id2]).x < P := by omega
          have hy2P : ((jumps kops)[id2]).y < P := by omega
          have hidx1 : blockIdx S P L ((jumps kops)[id1]).x =
              blockIdx S P L ((jumps kops)[id1]).y :=
            (hpart.sep_gt_iff L le_rfl _ hx1P _ hy1P).mp (by omega)
          have hidx2 : blockIdx S P L ((jumps kops)[id2]).x =
              blockIdx S P L ((jumps kops)[id2]).y :=
            (hpart.sep_gt_iff L le_rfl _ hx2P _ hy2P).mp (by omega)
          have hbo_eq : blockOf S P L ((jumps kops)[id2]).x =
              blockOf S P L ((jumps kops)[id1]).x := by
            simp only [blockOf, hidx1, hidx2, heq]
          have hlo1 := (h_block_bounds_of L le_rfl _ hx1P).1
          have hs2x1 : ((jumps kops)[id2]).s < ((jumps kops)[id1]).x := by
            rw [hbo_eq] at his2
            omega
          have hy2_ls := (h_jump_ls id2 h2_lt).2.1
          exact h_lock_contra id1 h1_lt id2 h2_lt hst_lt hs2x1
            ((jumps kops)[id2]).y hy2_ls (by omega) (by omega)
        · have hchain := h_same_step id1 h1_lt id2 h2_lt hlt hst_eq
          omega)
    simpa only [Finset.card_range] using hle




  have h_conj2 : (B_1 S P L kops).card ≤
      P + 2 * (L * (scaleBlocks S P L).length) + (B_fin_pre S P L kops).card := by
    have h_b1_chain : ∀ id, id ∈ B_1 S P L kops →
        ∃ hid : id < (jumps kops).length,
          let e := (jumps kops)[id]
          let ℓ := sepScale S P L e.x e.y
          let X := blockOf S P (ℓ - 1) e.y
          let Q2 := blockOf S P L e.y
          1 ≤ ℓ ∧ ℓ ≤ L ∧ sepScale S P L e.s e.x < ℓ ∧
            e.s < X.1 ∧ X.1 ≤ e.x ∧ e.x < Q2.1 ∧ Q2.1 ≤ e.y ∧ e.y < Q2.2 ∧
            X.1 ≤ Q2.1 ∧ blockIdx S P L e.y < (scaleBlocks S P L).length := by
      intro id hid
      simp only [B_1, Finset.mem_filter, Finset.mem_range] at hid
      obtain ⟨hlt, his⟩ := hid
      refine ⟨hlt, ?_⟩
      simp only [isB1, List.getElem?_eq_getElem hlt, decide_eq_true_eq] at his
      obtain ⟨hℓ1, hℓL, hsep_sx⟩ := his
      have hb := h_jump_bounds id hlt
      dsimp (config := { failIfUnchanged := false }) only at hb
      set e := (jumps kops)[id]
      set ℓ := sepScale S P L e.x e.y
      have hsP : e.s < P := by omega
      have hxP : e.x < P := by omega
      have hyP : e.y < P := by omega
      have hidx_prev : blockIdx S P (ℓ - 1) e.x = blockIdx S P (ℓ - 1) e.y :=
        (hpart.sep_gt_iff (ℓ - 1) (by omega) e.x hxP e.y hyP).mp (by omega)
      have hbo_prev : blockOf S P (ℓ - 1) e.x = blockOf S P (ℓ - 1) e.y := by
        simp only [blockOf, hidx_prev]
      have hx_lo : (blockOf S P (ℓ - 1) e.y).1 ≤ e.x := by
        rw [← hbo_prev]
        exact (h_block_bounds_of (ℓ - 1) (by omega) e.x hxP).1
      have hne_sx : blockIdx S P (ℓ - 1) e.s ≠ blockIdx S P (ℓ - 1) e.x := by
        intro heq
        have := (hpart.sep_gt_iff (ℓ - 1) (by omega) e.s hsP e.x hxP).mpr heq
        omega
      have hs_lt : e.s < (blockOf S P (ℓ - 1) e.y).1 := by
        rw [← hbo_prev]
        exact (h_block_disj (ℓ - 1) (by omega) e.s e.x hb.2.2.1 hxP hne_sx).1
      have hne_xy : blockIdx S P ℓ e.x ≠ blockIdx S P ℓ e.y := by
        intro heq
        have := (hpart.sep_gt_iff ℓ hℓL e.x hxP e.y hyP).mpr heq
        omega
      have hx_lt_B : e.x < (blockOf S P ℓ e.y).1 :=
        (h_block_disj ℓ hℓL e.x e.y hb.2.2.2.1 hyP hne_xy).1
      have hnest1 := (h_block_nest (ℓ - 1) ℓ (by omega) hℓL e.y hyP).1
      have hnest2 := (h_block_nest ℓ L hℓL le_rfl e.y hyP).1
      obtain ⟨hq_lo, hq_hi, _, hq_idx⟩ := h_block_bounds_of L le_rfl e.y hyP
      dsimp (config := { failIfUnchanged := false }) only [e, ℓ] at *
      exact ⟨hℓ1, hℓL, hsep_sx, hs_lt, hx_lo, by omega, hq_lo, hq_hi, by omega, hq_idx⟩

    let pA1 : ℕ → Prop := fun id =>
      (blockOf S P L ((jumps kops).getD id default).y).2 ≤ ((jumps kops).getD id default).z
    let pJm : ℕ → Prop := fun id =>
      ((jumps kops).getD id default).j + 1 < ((jumps kops).getD id default).m
    let pNextHi : ℕ → Prop := fun id =>
      (blockOf S P L ((jumps kops).getD id default).y).2 ≤
        ((jumps kops).getD (id + 1) default).y

    let A1 := (B_1 S P L kops).filter pA1
    let R1 := (B_1 S P L kops).filter (fun id => ¬pA1 id)
    let R2 := R1.filter pJm
    let B11 := R1.filter (fun id => ¬pJm id)
    let B12a := R2.filter pNextHi
    let B12b := R2.filter (fun id => ¬pNextHi id)

    have hsp1 : (B_1 S P L kops).card = A1.card + R1.card := h_split_card _ pA1
    have hsp2 : R1.card = R2.card + B11.card := h_split_card _ pJm
    have hsp3 : R2.card = B12a.card + B12b.card := h_split_card _ pNextHi

    have hA1_le : A1.card ≤ L * (scaleBlocks S P L).length := by
      have hle := h_card_inj A1
        ((Finset.range (scaleBlocks S P L).length) ×ˢ (Finset.Icc 1 L))
        (fun id =>
          let e := (jumps kops).getD id default
          (blockIdx S P L e.y, sepScale S P L e.x e.y))
        (fun id hid => by
          obtain ⟨hb1, _⟩ := Finset.mem_filter.mp hid
          obtain ⟨hlt, hℓ1, hℓL, _, _, _, _, _, _, _, hq_idx⟩ := h_b1_chain id hb1
          simp only [List.getD_eq_getElem _ _ hlt, Finset.mem_product, Finset.mem_range,
            Finset.mem_Icc]
          exact ⟨hq_idx, hℓ1, hℓL⟩)
        (fun id1 hid1 id2 hid2 hlt heq => by
          obtain ⟨hb1_1, hp1⟩ := Finset.mem_filter.mp hid1
          obtain ⟨hb1_2, _⟩ := Finset.mem_filter.mp hid2
          obtain ⟨h1_lt, hℓ1_1, hℓL_1, _, _, hx_lo1, hx_lt_Q1, _, _, _, _⟩ := h_b1_chain id1 hb1_1
          obtain ⟨h2_lt, _, _, _, hs_lt2, _, hx_lt_Q2, hq_lo2, hq_hi2, _, _⟩ :=
            h_b1_chain id2 hb1_2
          simp only [pA1, List.getD_eq_getElem _ _ h1_lt, List.getD_eq_getElem _ _ h2_lt,
            Prod.mk.injEq] at hp1 heq
          obtain ⟨hq_eq, hℓ_eq⟩ := heq
          have hb_j1 := h_jump_bounds id1 h1_lt
          have hb_j2 := h_jump_bounds id2 h2_lt
          dsimp (config := { failIfUnchanged := false }) only at hb_j1 hb_j2
          have hQ_eq : blockOf S P L ((jumps kops)[id1]).y =
              blockOf S P L ((jumps kops)[id2]).y := by
            simp only [blockOf, hq_eq]
          have hX_eq : blockOf S P (sepScale S P L ((jumps kops)[id1]).x ((jumps kops)[id1]).y - 1)
              ((jumps kops)[id1]).y =
              blockOf S P (sepScale S P L ((jumps kops)[id2]).x ((jumps kops)[id2]).y - 1)
              ((jumps kops)[id2]).y := by
            rw [← hℓ_eq]
            exact (h_anc_eq _ (by omega) _ (by omega) _ (by omega) hq_eq).2
          rcases hjump.jump_order id1 h1_lt id2 h2_lt hlt with hst_lt | ⟨hst_eq, _⟩
          · rw [hQ_eq] at hp1 hx_lt_Q1
            have hs2x1 : ((jumps kops)[id2]).s < ((jumps kops)[id1]).x := by
              rw [← hX_eq] at hs_lt2
              omega
            have hy2_ls := (h_jump_ls id2 h2_lt).2.1
            exact h_lock_contra id1 h1_lt id2 h2_lt hst_lt hs2x1
              ((jumps kops)[id2]).y hy2_ls (by omega) (by omega)
          · have hchain := h_same_step id1 h1_lt id2 h2_lt hlt hst_eq
            rw [hQ_eq] at hp1
            omega)
      simpa only [h_prod_card] using hle

    have hB11_le : B11.card ≤ P := by
      have hle := h_card_inj B11 (Finset.range P)
        (fun id => ((jumps kops).getD id default).s)
        (fun id hid => by
          obtain ⟨hr1, _⟩ := Finset.mem_filter.mp hid
          obtain ⟨hb1, _⟩ := Finset.mem_filter.mp hr1
          obtain ⟨hlt, _⟩ := h_b1_chain id hb1
          dsimp (config := { failIfUnchanged := false }) only
          rw [List.getD_eq_getElem _ _ hlt, Finset.mem_range]
          have hb := h_jump_bounds id hlt
          dsimp (config := { failIfUnchanged := false }) only at hb
          omega)
        (fun id1 hid1 id2 hid2 hlt heq => by
          obtain ⟨hr1_1, hnot1⟩ := Finset.mem_filter.mp hid1
          obtain ⟨hb1_1, _⟩ := Finset.mem_filter.mp hr1_1
          obtain ⟨hr1_2, _⟩ := Finset.mem_filter.mp hid2
          obtain ⟨hb1_2, _⟩ := Finset.mem_filter.mp hr1_2
          obtain ⟨h1_lt, _⟩ := h_b1_chain id1 hb1_1
          obtain ⟨h2_lt, _⟩ := h_b1_chain id2 hb1_2
          simp only [pJm, List.getD_eq_getElem _ _ h1_lt, List.getD_eq_getElem _ _ h2_lt]
            at hnot1 heq
          exact h_last_jump_contra id1 h1_lt id2 h2_lt hlt heq hnot1)
      simpa only [Finset.card_range] using hle

    have hB12a_le : B12a.card ≤ L * (scaleBlocks S P L).length := by
      have hle := h_card_inj B12a
        ((Finset.range (scaleBlocks S P L).length) ×ˢ (Finset.Icc 1 L))
        (fun id =>
          let e := (jumps kops).getD id default
          (blockIdx S P L e.y, sepScale S P L e.x e.y))
        (fun id hid => by
          obtain ⟨hr2, _⟩ := Finset.mem_filter.mp hid
          obtain ⟨hr1, _⟩ := Finset.mem_filter.mp hr2
          obtain ⟨hb1, _⟩ := Finset.mem_filter.mp hr1
          obtain ⟨hlt, hℓ1, hℓL, _, _, _, _, _, _, _, hq_idx⟩ := h_b1_chain id hb1
          simp only [List.getD_eq_getElem _ _ hlt, Finset.mem_product, Finset.mem_range,
            Finset.mem_Icc]
          exact ⟨hq_idx, hℓ1, hℓL⟩)
        (fun id1 hid1 id2 hid2 hlt heq => by
          obtain ⟨hr2_1, hnh1⟩ := Finset.mem_filter.mp hid1
          obtain ⟨hr1_1, hjm1⟩ := Finset.mem_filter.mp hr2_1
          obtain ⟨hb1_1, hna1⟩ := Finset.mem_filter.mp hr1_1
          obtain ⟨hr2_2, _⟩ := Finset.mem_filter.mp hid2
          obtain ⟨hr1_2, _⟩ := Finset.mem_filter.mp hr2_2
          obtain ⟨hb1_2, hna2⟩ := Finset.mem_filter.mp hr1_2
          obtain ⟨h1_lt, _, hℓL_1, _, _, hx_lo1, hx_lt_Q1, hq_lo1, _, _, _⟩ := h_b1_chain id1 hb1_1
          obtain ⟨h2_lt, _, _, _, hs_lt2, _, hx_lt_Q2, hq_lo2, hq_hi2, _, _⟩ :=
            h_b1_chain id2 hb1_2
          simp only [pA1, pJm, List.getD_eq_getElem _ _ h1_lt, List.getD_eq_getElem _ _ h2_lt,
            Prod.mk.injEq] at hna1 hna2 hjm1 heq
          obtain ⟨h1_succ_lt, hst_s1, _, _, _, hx_s1⟩ := h_jump_succ id1 h1_lt hjm1
          simp only [pNextHi, List.getD_eq_getElem _ _ h1_lt,
            List.getD_eq_getElem _ _ h1_succ_lt] at hnh1
          obtain ⟨hq_eq, hℓ_eq⟩ := heq
          have hb_j1 := h_jump_bounds id1 h1_lt
          have hb_j1s := h_jump_bounds (id1 + 1) h1_succ_lt
          have hb_j2 := h_jump_bounds id2 h2_lt
          dsimp (config := { failIfUnchanged := false }) only at hb_j1 hb_j1s hb_j2
          have hQ_eq : blockOf S P L ((jumps kops)[id1]).y =
              blockOf S P L ((jumps kops)[id2]).y := by
            simp only [blockOf, hq_eq]
          have hX_eq : blockOf S P (sepScale S P L ((jumps kops)[id1]).x ((jumps kops)[id1]).y - 1)
              ((jumps kops)[id1]).y =
              blockOf S P (sepScale S P L ((jumps kops)[id2]).x ((jumps kops)[id2]).y - 1)
              ((jumps kops)[id2]).y := by
            rw [← hℓ_eq]
            exact (h_anc_eq _ (by omega) _ (by omega) _ (by omega) hq_eq).2
          rcases hjump.jump_order id1 h1_lt id2 h2_lt hlt with hst_lt | ⟨hst_eq, _⟩
          · rw [← hX_eq] at hs_lt2
            rw [hQ_eq] at hna1 hnh1 hq_lo1 hx_lt_Q1
            have hs2x1 : ((jumps kops)[id2]).s < ((jumps kops)[id1]).x := by omega
            have hs2x1s : ((jumps kops)[id2]).s < ((jumps kops)[id1 + 1]).x := by omega
            have hst_lt_s : ((jumps kops)[id1 + 1]).step < ((jumps kops)[id2]).step := by omega
            obtain ⟨_, hy2_ls, hz2_ls⟩ := h_jump_ls id2 h2_lt
            rcases lt_trichotomy ((jumps kops)[id2]).y ((jumps kops)[id1]).z with hy_lt | hy_eq | hy_gt
            · exact h_lock_contra id1 h1_lt id2 h2_lt hst_lt hs2x1
                ((jumps kops)[id2]).y hy2_ls (by omega) hy_lt
            · exact h_lock_contra (id1 + 1) h1_succ_lt id2 h2_lt hst_lt_s hs2x1s
                ((jumps kops)[id2]).z hz2_ls (by omega) (by omega)
            · exact h_lock_contra (id1 + 1) h1_succ_lt id2 h2_lt hst_lt_s hs2x1s
                ((jumps kops)[id2]).y hy2_ls (by omega) (by omega)
          · rw [hQ_eq] at hnh1 hq_lo1
            by_cases hid_adj : id2 = id1 + 1
            · subst hid_adj
              omega
            · have hlt_s : id1 + 1 < id2 := by omega
              have hchain := h_same_step (id1 + 1) h1_succ_lt id2 h2_lt hlt_s (by omega)
              omega)
      simpa only [h_prod_card] using hle

    have hB12b_le : B12b.card ≤ (B_fin_pre S P L kops).card := by
      refine h_card_inj B12b (B_fin_pre S P L kops) (fun id => id + 1)
        (fun id hid => by
          obtain ⟨hr2, hnnh⟩ := Finset.mem_filter.mp hid
          obtain ⟨hr1, hjm⟩ := Finset.mem_filter.mp hr2
          obtain ⟨hb1, hna⟩ := Finset.mem_filter.mp hr1
          obtain ⟨hlt, _, _, _, hs_lt, _, _, hq_lo, _, hX_le_Q, _⟩ := h_b1_chain id hb1
          simp only [pA1, pJm, List.getD_eq_getElem _ _ hlt] at hna hjm
          obtain ⟨h_succ_lt, _, hs_eq, _, _, hx_eq⟩ := h_jump_succ id hlt hjm
          simp only [pNextHi, List.getD_eq_getElem _ _ hlt,
            List.getD_eq_getElem _ _ h_succ_lt] at hnnh
          have hb := h_jump_bounds id hlt
          have hbs := h_jump_bounds (id + 1) h_succ_lt
          dsimp (config := { failIfUnchanged := false }) only at hb hbs
          have hyP : ((jumps kops)[id]).y < P := by omega
          have hxsP : ((jumps kops)[id + 1]).x < P := by omega
          have hysP : ((jumps kops)[id + 1]).y < P := by omega
          have hidx_x : blockIdx S P L ((jumps kops)[id]).y =
              blockIdx S P L ((jumps kops)[id + 1]).x :=
            (hpart.blocks_eq_iff L le_rfl _ hyP _ hxsP).mpr ⟨by omega, by omega⟩
          have hidx_y : blockIdx S P L ((jumps kops)[id]).y =
              blockIdx S P L ((jumps kops)[id + 1]).y :=
            (hpart.blocks_eq_iff L le_rfl _ hyP _ hysP).mpr ⟨by omega, by omega⟩
          have hsepL : L < sepScale S P L ((jumps kops)[id + 1]).x ((jumps kops)[id + 1]).y :=
            (hpart.sep_gt_iff L le_rfl _ hxsP _ hysP).mpr (hidx_x.symm.trans hidx_y)
          have hsep_rng := hpart.sep_range _ hxsP _ hysP (by omega)
          have hbo_x : blockOf S P L ((jumps kops)[id + 1]).x =
              blockOf S P L ((jumps kops)[id]).y := by
            simp only [blockOf, ← hidx_x]
          simp only [B_fin_pre, Finset.mem_filter, Finset.mem_range, isBFinPre,
            List.getElem?_eq_getElem h_succ_lt, decide_eq_true_eq]
          refine ⟨h_succ_lt, by omega, ?_⟩
          rw [hbo_x]
          omega)
        (fun _ _ _ _ _ heq => by dsimp (config := { failIfUnchanged := false }) only at heq; omega)

    omega




  have h_conj3 : (B_3_intra S P L kops).card ≤
      2 * P + countKeyedRslr kops + (B_1 S P L kops).card +
        (B_fin_pre S P L kops).card := by
    have h_len_aux : ∀ xs : List KeyedCoreOp,
        xs.length = (pushKeys xs).length + (popKeys xs).length + countKeyedRslr xs := by
      intro xs
      induction xs with
      | nil => rfl
      | cons op rest ih =>
        rcases op with w | s | d <;>
          (simp only [List.length_cons, pushKeys, popKeys, countKeyedRslr]; omega)
    have h_kops_len : kops.length = 2 * P + countKeyedRslr kops := by
      have h1 := h_len_aux kops
      have h2 : (pushKeys kops).length = P := by
        simpa using hkvalid.push_perm.length_eq
      have h3 : (popKeys kops).length = P := by
        simpa using congrArg List.length hkvalid.pop_eq
      omega

    let V : ℕ → Finset ℕ := fun t => (inorderNat (keyedState kops t)).toFinset
    let pi : ℕ → ℕ → ℕ := fun t v => lcrsParent P (foldBST P (keyedState kops t)).1 v
    let phi : ℕ → ℕ → ℕ := fun t v =>
      if 1 ≤ sepScale S P L v (pi t v) ∧
          sepScale S P L v (pi t v) ≤ L ∧
          sepScale S P L v (pi t v) < sepScale S P L (pi t v) (pi t (pi t v))
      then 1 else 0
    let Phi : ℕ → ℕ := fun t => (V t).sum (fun v => phi t v)
    let Bpre : Finset ℕ := B_1 S P L kops ∪ B_fin_pre S P L kops
    let b3t : ℕ → ℕ := fun t =>
      ((B_3_intra S P L kops).filter (fun id => ((jumps kops).getD id default).step = t)).card
    let bpret : ℕ → ℕ := fun t =>
      (Bpre.filter (fun id => ((jumps kops).getD id default).step = t)).card

    have h_phi_le_one : ∀ t v, phi t v ≤ 1 := by
      intro t v
      dsimp (config := { failIfUnchanged := false }) only [phi]
      split_ifs <;> omega

    have h_V_iff : ∀ t ≤ kops.length, ∀ v,
        v ∈ V t ↔ v < P ∧ birthStep kops v < t ∧ t ≤ popStep kops v := by
      intro t ht v
      simp only [V, List.mem_toFinset, hkvalid.mem_inorder_iff t ht v]

    have h_birth_eq : ∀ t (ht : t < kops.length) v, v < P →
        (birthStep kops v = t ↔ kops[t] = .push v) := by
      intro t ht v hv
      constructor
      · intro hb
        have hopt := hkvalid.birth_op v hv
        rw [hb, List.getElem?_eq_getElem ht] at hopt
        exact Option.some.inj hopt
      · intro hop
        have hsv := hkvalid.step_valid t ht
        rw [hop] at hsv
        exact hsv.2.1

    have h_pop_eq : ∀ t (ht : t < kops.length) v, v < P →
        (popStep kops v = t ↔ kops[t] = .pop v) := by
      intro t ht v hv
      constructor
      · intro hp
        have hopt := hkvalid.pop_op v hv
        rw [hp, List.getElem?_eq_getElem ht] at hopt
        exact Option.some.inj hopt
      · intro hop
        have hsv := hkvalid.step_valid t ht
        rw [hop] at hsv
        exact hsv.2.1

    have h_no_jumps_nonpop : ∀ t (ht : t < kops.length),
        (∀ s, kops[t] ≠ .pop s) → b3t t = 0 ∧ bpret t = 0 := by
      intro t ht hnp
      have hempty : ∀ A : Finset ℕ, A ⊆ Finset.range (jumps kops).length →
          (A.filter (fun id => ((jumps kops).getD id default).step = t)).card = 0 := by
        intro A hsub
        rw [Finset.card_eq_zero, Finset.filter_eq_empty_iff]
        intro id hid hst
        have hlt : id < (jumps kops).length := Finset.mem_range.mp (hsub hid)
        rw [List.getD_eq_getElem _ _ hlt] at hst
        obtain ⟨_, hstep, hopt, _⟩ := hjump.jump_anatomies id hlt
        rw [hst, List.getElem?_eq_getElem ht] at hopt
        exact hnp _ (Option.some.inj hopt)
      refine ⟨hempty _ (fun id hid => (Finset.mem_filter.mp hid).1), hempty _ ?_⟩
      intro id hid
      rcases Finset.mem_union.mp hid with h1 | h2
      · exact (Finset.mem_filter.mp h1).1
      · exact (Finset.mem_filter.mp h2).1

    have h_step_bound : ∀ t < kops.length,
        b3t t + Phi (t + 1) ≤ Phi t + 1 + bpret t := by
      intro t ht
      rcases hop : kops[t] with w | s | d0
      ·
        obtain ⟨hb3_0, hbpre_0⟩ := h_no_jumps_nonpop t ht (by simp [hop])
        have hsv := hkvalid.step_valid t ht
        rw [hop] at hsv
        obtain ⟨hwP, hbw, _⟩ := hsv
        have hw_lt_pop := (hkvalid.birth_lt_pop w hwP).1
        have hw_not_Vt : w ∉ V t := by
          rw [h_V_iff t (by omega) w]
          omega
        have hV_next : V (t + 1) = insert w (V t) := by
          ext v
          simp only [Finset.mem_insert, h_V_iff t (by omega) v, h_V_iff (t + 1) (by omega) v]
          by_cases hvw : v = w
          · subst hvw
            omega
          · by_cases hvP : v < P
            · have hne_b : birthStep kops v ≠ t := by
                intro hb
                have hpush := (h_birth_eq t ht v hvP).mp hb
                rw [hop] at hpush
                exact hvw (KeyedCoreOp.push.inj hpush).symm
              have hne_p : popStep kops v ≠ t := by
                intro hp
                have hpop := (h_pop_eq t ht v hvP).mp hp
                rw [hop] at hpop
                cases hpop
              omega
            · omega
        obtain ⟨_, _, hpi_other⟩ := hfold.fold_step_push t ht w hop
        have hsum_eq : (V t).sum (fun v => phi (t + 1) v) = Phi t := by
          refine Finset.sum_congr rfl ?_
          intro v hv
          have hvw : v ≠ w := fun heq => hw_not_Vt (heq ▸ hv)
          have hpi1 : pi (t + 1) v = pi t v := hpi_other v hvw
          have hv_in : v ∈ inorderNat (keyedState kops t) := List.mem_toFinset.mp hv
          obtain ⟨_, _, hp_cases⟩ := hfold.lcrs_bounds t (by omega) v hv_in
          have hpw : pi t v ≠ w := by
            rcases hp_cases with hpP | hp_in
            · dsimp (config := { failIfUnchanged := false }) only [pi]
              rw [hpP]
              omega
            · intro heq
              exact hw_not_Vt (List.mem_toFinset.mpr (heq ▸ hp_in))
          have hpi2 : pi (t + 1) (pi t v) = pi t (pi t v) := hpi_other (pi t v) hpw
          dsimp (config := { failIfUnchanged := false }) only [phi]
          rw [hpi1, hpi2]
        have hPhi_next : Phi (t + 1) = phi (t + 1) w + Phi t := by
          dsimp (config := { failIfUnchanged := false }) only [Phi]
          rw [hV_next, Finset.sum_insert hw_not_Vt, hsum_eq]
        have hphi_w := h_phi_le_one (t + 1) w
        omega

      ·
        have hsv := hkvalid.step_valid t ht
        rw [hop] at hsv
        obtain ⟨hsP, hps, _⟩ := hsv
        have hV_next : V (t + 1) = (V t).erase s := by
          ext v
          simp only [Finset.mem_erase, h_V_iff t (by omega) v, h_V_iff (t + 1) (by omega) v]
          by_cases hvs : v = s
          · subst hvs
            omega
          · by_cases hvP : v < P
            · have hne_b : birthStep kops v ≠ t := by
                intro hb
                have hpush := (h_birth_eq t ht v hvP).mp hb
                rw [hop] at hpush
                cases hpush
              have hne_p : popStep kops v ≠ t := by
                intro hp
                have hpop := (h_pop_eq t ht v hvP).mp hp
                rw [hop] at hpop
                exact hvs (KeyedCoreOp.pop.inj hpop).symm
              omega
            · omega
        have hV_sub : V (t + 1) ⊆ V t := by
          rw [hV_next]
          exact Finset.erase_subset s (V t)
        obtain ⟨baseId, hbase_le, hbase_iff⟩ := hjump.pop_step_jumps t ht s hop
        set m := ((leftSpineBottomUpNat (keyedState kops t)).length - 2) / 2
        let Jt : Finset ℕ := Finset.Ico baseId (baseId + m)
        let mu : ℕ → ℕ := fun id => ((jumps kops).getD id default).x
        let Mt : Finset ℕ := Jt.image mu

        have h_Jt_mem : ∀ id, id ∈ Jt ↔
            ∃ hid : id < (jumps kops).length, ((jumps kops)[id]).step = t := by
          intro id
          simp only [Jt, Finset.mem_Ico]
          constructor
          · intro hico
            have hid : id < (jumps kops).length := by omega
            exact ⟨hid, (hbase_iff id hid).mpr hico⟩
          · rintro ⟨hid, hst⟩
            exact (hbase_iff id hid).mp hst

        have h_sub_filter : ∀ A : Finset ℕ, A ⊆ Finset.range (jumps kops).length →
            A.filter (fun id => ((jumps kops).getD id default).step = t) =
              Jt.filter (fun id => id ∈ A) := by
          intro A hA
          ext id
          simp only [Finset.mem_filter, h_Jt_mem]
          constructor
          · rintro ⟨ha, hst⟩
            have hid : id < (jumps kops).length := Finset.mem_range.mp (hA ha)
            rw [List.getD_eq_getElem _ _ hid] at hst
            exact ⟨⟨hid, hst⟩, ha⟩
          · rintro ⟨⟨hid, hst⟩, ha⟩
            rw [List.getD_eq_getElem _ _ hid]
            exact ⟨ha, hst⟩

        have hb3t_eq : b3t t = (Jt.filter (fun id => id ∈ B_3_intra S P L kops)).card := by
          dsimp (config := { failIfUnchanged := false }) only [b3t]
          exact congrArg Finset.card (h_sub_filter _ (fun id hid => (Finset.mem_filter.mp hid).1))
        have hbpret_eq : bpret t = (Jt.filter (fun id => id ∈ Bpre)).card := by
          dsimp (config := { failIfUnchanged := false }) only [bpret]
          refine congrArg Finset.card (h_sub_filter _ ?_)
          intro id hid
          rcases Finset.mem_union.mp hid with h1 | h2
          · exact (Finset.mem_filter.mp h1).1
          · exact (Finset.mem_filter.mp h2).1

        have h_mu_inj : Set.InjOn mu ↑Jt := by
          intro id1 hid1 id2 hid2 heq
          obtain ⟨h1_lt, hst1⟩ := (h_Jt_mem id1).mp (Finset.mem_coe.mp hid1)
          obtain ⟨h2_lt, hst2⟩ := (h_Jt_mem id2).mp (Finset.mem_coe.mp hid2)
          simp only [mu, List.getD_eq_getElem _ _ h1_lt, List.getD_eq_getElem _ _ h2_lt] at heq
          have hb1 := h_jump_bounds id1 h1_lt
          have hb2 := h_jump_bounds id2 h2_lt
          dsimp (config := { failIfUnchanged := false }) only at hb1 hb2
          rcases lt_trichotomy id1 id2 with hlt | rfl | hgt
          · have := h_same_step id1 h1_lt id2 h2_lt hlt (hst1.trans hst2.symm)
            omega
          · rfl
          · have := h_same_step id2 h2_lt id1 h1_lt hgt (hst2.trans hst1.symm)
            omega

        have h_Mt_sub : Mt ⊆ V (t + 1) := by
          intro v hv
          obtain ⟨id, hid_Jt, rfl⟩ := Finset.mem_image.mp hv
          obtain ⟨hid, hst⟩ := (h_Jt_mem id).mp hid_Jt
          simp only [mu, List.getD_eq_getElem _ _ hid]
          have hls1 := (hfold.spine_lock id hid).1
          rw [hst] at hls1
          have hin_f := h_ls_mem_inorder _ _ hls1
          rw [(hfold.fold_bst_inorder (t + 1) (by omega)).2] at hin_f
          exact List.mem_toFinset.mpr hin_f

        have h_nonmover : ∀ v ∈ V (t + 1) \ Mt, phi (t + 1) v ≤ phi t v := by
          intro v hv_sdiff
          obtain ⟨hv_t1, hv_not_Mt⟩ := Finset.mem_sdiff.mp hv_sdiff
          have hv_in1 : v ∈ inorderNat (keyedState kops (t + 1)) := List.mem_toFinset.mp hv_t1
          have hnot_x : ∀ id (hid : id < (jumps kops).length),
              ((jumps kops)[id]).step = t → v ≠ ((jumps kops)[id]).x := by
            intro id hid hst heq
            apply hv_not_Mt
            refine Finset.mem_image.mpr ⟨id, (h_Jt_mem id).mpr ⟨hid, hst⟩, ?_⟩
            simp only [mu, List.getD_eq_getElem _ _ hid, heq]
          have hpi_v : pi (t + 1) v = pi t v :=
            (hfold.fold_step_pop t ht s hop).2 v hv_in1 hnot_x
          dsimp (config := { failIfUnchanged := false }) only [phi]
          split_ifs with hc1 hc0
          · rfl
          · exfalso
            apply hc0
            rw [hpi_v] at hc1
            obtain ⟨h1_le, hL_ge, hgt⟩ := hc1
            refine ⟨h1_le, hL_ge, ?_⟩
            set u := pi t v
            have hu_ne_P : u ≠ P := by
              intro huP
              rw [huP, (hpart.sep_top v).1] at h1_le
              omega
            obtain ⟨_, _, hu_cases⟩ := hfold.lcrs_bounds (t + 1) (by omega) v hv_in1
            have hlcrs_u : lcrsParent P (foldBST P (keyedState kops (t + 1))).1 v = u := hpi_v
            have hu_in1 : u ∈ inorderNat (keyedState kops (t + 1)) := by
              rcases hu_cases with hP_eq | hin
              · exfalso
                exact hu_ne_P (hlcrs_u.symm.trans hP_eq)
              · rwa [hlcrs_u] at hin
            have hu_in0 : u ∈ inorderNat (keyedState kops t) :=
              List.mem_toFinset.mp (hV_sub (List.mem_toFinset.mpr hu_in1))
            set p := pi t u
            set q := pi (t + 1) u
            have hup : u < p := (hfold.lcrs_bounds t (by omega) u hu_in0).1
            have hpq : p ≤ q := hfold.lcrs_mono t ht u hu_in0 hu_in1
            have hq_le_P : q ≤ P := (hfold.lcrs_bounds (t + 1) (by omega) u hu_in1).2.1
            have hq_ne_P : q ≠ P := by
              intro hqP
              rw [hqP, (hpart.sep_top u).1] at hgt
              omega
            have hult := hpart.sep_ultrametric u p q (by omega) hpq (by omega)
            rw [hult] at hgt
            exact lt_of_lt_of_le hgt (Nat.min_le_left _ _)
          · exact Nat.zero_le _
          · exact le_rfl

        have h_precancel : ∀ id ∈ Jt,
            (if id ∈ B_3_intra S P L kops then 1 else 0) ≤ phi t (mu id) := by
          intro id hid_Jt
          split_ifs with hb3
          · obtain ⟨hid, hst⟩ := (h_Jt_mem id).mp hid_Jt
            simp only [mu, List.getD_eq_getElem _ _ hid]
            simp only [B_3_intra, Finset.mem_filter, Finset.mem_range, isB3Intra,
              List.getElem?_eq_getElem hid, decide_eq_true_eq] at hb3
            obtain ⟨_, hℓ1, hℓL, _, hz_lt⟩ := hb3
            obtain ⟨hlcrs_x, hlcrs_y, _⟩ := hfold.jump_lcrs id hid
            rw [hst] at hlcrs_x hlcrs_y
            have hpi_x : pi t ((jumps kops)[id]).x = ((jumps kops)[id]).y := hlcrs_x
            have hpi_y : pi t ((jumps kops)[id]).y = ((jumps kops)[id]).z := hlcrs_y
            have hb := h_jump_bounds id hid
            dsimp (config := { failIfUnchanged := false }) only at hb
            have hyP : ((jumps kops)[id]).y < P := by omega
            have hzP : ((jumps kops)[id]).z < P := by omega
            set ℓ := sepScale S P L ((jumps kops)[id]).x ((jumps kops)[id]).y
            have hy_lo := (h_block_bounds_of ℓ hℓL _ hyP).1
            have hidx_yz : blockIdx S P ℓ ((jumps kops)[id]).y =
                blockIdx S P ℓ ((jumps kops)[id]).z :=
              (hpart.blocks_eq_iff ℓ hℓL _ hyP _ hzP).mpr ⟨by omega, hz_lt⟩
            have hsep_yz : ℓ < sepScale S P L ((jumps kops)[id]).y ((jumps kops)[id]).z :=
              (hpart.sep_gt_iff ℓ hℓL _ hyP _ hzP).mpr hidx_yz
            dsimp (config := { failIfUnchanged := false }) only [phi]
            rw [hpi_x, hpi_y]
            rw [if_pos ⟨hℓ1, hℓL, hsep_yz⟩]
          · exact Nat.zero_le _

        have h_post_movers : Jt.sum (fun id => phi (t + 1) (mu id)) ≤ 1 + bpret t := by
          rcases hm_cases : m with _ | m'
          · have hJt_emp : Jt = ∅ := by
              simp only [Jt, hm_cases, Nat.add_zero, Finset.Ico_self]
            rw [hJt_emp, Finset.sum_empty]
            omega
          · let Jlow : Finset ℕ := Finset.Ico baseId (baseId + m')
            have hJt_ins : Jt = insert (baseId + m') Jlow := by
              ext id
              simp only [Jt, Jlow, hm_cases, Finset.mem_insert, Finset.mem_Ico]
              omega
            have hnot_mem : baseId + m' ∉ Jlow := by
              simp only [Jlow, Finset.mem_Ico]
              omega
            have hsum_ins : Jt.sum (fun id => phi (t + 1) (mu id)) =
                phi (t + 1) (mu (baseId + m')) + Jlow.sum (fun id => phi (t + 1) (mu id)) := by
              rw [hJt_ins, Finset.sum_insert hnot_mem]
            let pOne : ℕ → Prop := fun id =>
              1 ≤ sepScale S P L (mu id) (pi (t + 1) (mu id)) ∧
                sepScale S P L (mu id) (pi (t + 1) (mu id)) ≤ L ∧
                sepScale S P L (mu id) (pi (t + 1) (mu id)) <
                  sepScale S P L (pi (t + 1) (mu id)) (pi (t + 1) (pi (t + 1) (mu id)))
            have hJlow_boole : Jlow.sum (fun id => phi (t + 1) (mu id)) =
                (Jlow.filter pOne).card := by
              simpa only [Nat.cast_id] using (Finset.sum_boole (R := ℕ) pOne Jlow)
            have hJlow_le : (Jlow.filter pOne).card ≤ bpret t := by
              rw [hbpret_eq]
              refine h_card_inj (Jlow.filter pOne) (Jt.filter (fun id => id ∈ Bpre))
                (fun id => id + 1)
                (fun id hid_f => by
                  obtain ⟨hid_low, hp1⟩ := Finset.mem_filter.mp hid_f
                  have hico_low := Finset.mem_Ico.mp hid_low
                  have hid_Jt : id ∈ Jt := by
                    simp only [Jt, hm_cases, Finset.mem_Ico]
                    omega
                  have hid1_Jt : id + 1 ∈ Jt := by
                    simp only [Jt, hm_cases, Finset.mem_Ico]
                    omega
                  obtain ⟨hid, hst⟩ := (h_Jt_mem id).mp hid_Jt
                  obtain ⟨hid1, hst1⟩ := (h_Jt_mem (id + 1)).mp hid1_Jt
                  obtain ⟨hjm, _⟩ := h_adj_step id hid1 (hst.trans hst1.symm)
                  obtain ⟨_, _, hs_eq, _, _, hx_eq⟩ := h_jump_succ id hid hjm
                  obtain ⟨_, _, hlcrs_x1⟩ := hfold.jump_lcrs id hid
                  obtain ⟨_, _, hlcrs_z1⟩ := hfold.jump_lcrs (id + 1) hid1
                  rw [hst] at hlcrs_x1
                  rw [hst1, hx_eq] at hlcrs_z1
                  simp only [pOne, mu, List.getD_eq_getElem _ _ hid] at hp1
                  dsimp (config := { failIfUnchanged := false }) only [pi] at hp1
                  rw [hlcrs_x1] at hp1
                  rw [hlcrs_z1] at hp1
                  obtain ⟨hℓ1_lo, hℓ1_hi, hsep_gt⟩ := hp1
                  have hb := h_jump_bounds id hid
                  have hb1 := h_jump_bounds (id + 1) hid1
                  dsimp (config := { failIfUnchanged := false }) only at hb hb1
                  set ℓ1 := sepScale S P L ((jumps kops)[id]).x ((jumps kops)[id]).z
                  set ℓ' := sepScale S P L ((jumps kops)[id + 1]).x ((jumps kops)[id + 1]).y
                  have hult1 := hpart.sep_ultrametric ((jumps kops)[id]).z
                    ((jumps kops)[id + 1]).y ((jumps kops)[id + 1]).z
                    (by omega) (by omega) (by omega)
                  have hℓ'_gt : ℓ1 < ℓ' := by
                    dsimp (config := { failIfUnchanged := false }) only [ℓ']
                    rw [hx_eq]
                    rw [hult1] at hsep_gt
                    exact lt_of_lt_of_le hsep_gt (Nat.min_le_left _ _)
                  have hult2 := hpart.sep_ultrametric ((jumps kops)[id]).s
                    ((jumps kops)[id]).x ((jumps kops)[id]).z
                    (by omega) (by omega) (by omega)
                  have hsx'_le : sepScale S P L ((jumps kops)[id + 1]).s
                      ((jumps kops)[id + 1]).x ≤ ℓ1 := by
                    rw [hs_eq, hx_eq, hult2]
                    exact Nat.min_le_right _ _
                  have hℓ'_rng := hpart.sep_range ((jumps kops)[id + 1]).x (by omega)
                    ((jumps kops)[id + 1]).y (by omega) (by omega)
                  refine Finset.mem_filter.mpr ⟨hid1_Jt, ?_⟩
                  by_cases hℓ'_L : ℓ' ≤ L
                  · refine Finset.mem_union.mpr (Or.inl ?_)
                    simp only [B_1, Finset.mem_filter, Finset.mem_range, isB1,
                      List.getElem?_eq_getElem hid1, decide_eq_true_eq]
                    dsimp (config := { failIfUnchanged := false }) only [ℓ1, ℓ'] at *
                    exact ⟨hid1, by omega, hℓ'_L, by omega⟩
                  · have hℓ'_eq : ℓ' = L + 1 := by omega
                    refine Finset.mem_union.mpr (Or.inr ?_)
                    simp only [B_fin_pre, Finset.mem_filter, Finset.mem_range, isBFinPre,
                      List.getElem?_eq_getElem hid1, decide_eq_true_eq]
                    dsimp (config := { failIfUnchanged := false }) only [ℓ1, ℓ'] at *
                    have hne_L : blockIdx S P L ((jumps kops)[id + 1]).s ≠
                        blockIdx S P L ((jumps kops)[id + 1]).x := by
                      intro heq
                      have := (hpart.sep_gt_iff L le_rfl _ (by omega) _ (by omega)).mpr heq
                      omega
                    have hs_lt_bo := (h_block_disj L le_rfl _ _ hb1.2.2.1 (by omega) hne_L).1
                    exact ⟨hid1, hℓ'_eq, hs_lt_bo⟩)
                (fun _ _ _ _ _ heq => by dsimp (config := { failIfUnchanged := false }) only at heq; omega)
            have htop := h_phi_le_one (t + 1) (mu (baseId + m'))
            omega

        have hb3_sum : b3t t ≤ Jt.sum (fun id => phi t (mu id)) := by
          rw [hb3t_eq]
          have hboole : Jt.sum (fun id => if id ∈ B_3_intra S P L kops then 1 else 0) =
              (Jt.filter (fun id => id ∈ B_3_intra S P L kops)).card := by
            simpa only [Nat.cast_id] using
              (Finset.sum_boole (R := ℕ) (fun id => id ∈ B_3_intra S P L kops) Jt)
          rw [← hboole]
          exact Finset.sum_le_sum h_precancel

        have hMt_sum0 : Mt.sum (fun v => phi t v) = Jt.sum (fun id => phi t (mu id)) :=
          Finset.sum_image h_mu_inj
        have hMt_sum1 : Mt.sum (fun v => phi (t + 1) v) = Jt.sum (fun id => phi (t + 1) (mu id)) :=
          Finset.sum_image h_mu_inj
        have hsdiff1 : (V (t + 1) \ Mt).sum (fun v => phi (t + 1) v) +
            Mt.sum (fun v => phi (t + 1) v) = Phi (t + 1) :=
          Finset.sum_sdiff h_Mt_sub
        have hsdiff0 : (V (t + 1) \ Mt).sum (fun v => phi t v) +
            Mt.sum (fun v => phi t v) = (V (t + 1)).sum (fun v => phi t v) :=
          Finset.sum_sdiff h_Mt_sub
        have hsdiff_le : (V (t + 1) \ Mt).sum (fun v => phi (t + 1) v) ≤
            (V (t + 1) \ Mt).sum (fun v => phi t v) :=
          Finset.sum_le_sum h_nonmover
        have hVt1_le : (V (t + 1)).sum (fun v => phi t v) ≤ Phi t :=
          Finset.sum_le_sum_of_subset hV_sub
        omega

      ·
        obtain ⟨hb3_0, hbpre_0⟩ := h_no_jumps_nonpop t ht (by simp [hop])
        have hV_next : V (t + 1) = V t := by
          ext v
          simp only [h_V_iff t (by omega) v, h_V_iff (t + 1) (by omega) v]
          by_cases hvP : v < P
          · have hne_b : birthStep kops v ≠ t := by
              intro hb
              have hpush := (h_birth_eq t ht v hvP).mp hb
              rw [hop] at hpush
              cases hpush
            have hne_p : popStep kops v ≠ t := by
              intro hp
              have hpop := (h_pop_eq t ht v hvP).mp hp
              rw [hop] at hpop
              cases hpop
            omega
          · omega
        rcases d0 with _ | d
        · have hf_eq := hfold.fold_step_rslr_zero t ht hop
          have hPhi_eq : Phi (t + 1) = Phi t := by
            dsimp (config := { failIfUnchanged := false }) only [Phi]
            rw [hV_next]
            refine Finset.sum_congr rfl ?_
            intro v _
            dsimp (config := { failIfUnchanged := false }) only [phi, pi]
            rw [hf_eq]
          omega
        · obtain ⟨hu_in, hp_in, hup, _, hpi_u0, hpi_u1, hpi_other⟩ :=
            hfold.fold_step_rslr_succ t ht d hop
          set rs := rightSpineTopDownNat (keyedState kops t)
          set u := rs.getD d 0
          set p := rs.getD (d + 1) 0
          have hu_Vt : u ∈ V t := List.mem_toFinset.mpr hu_in
          have herase_le : ((V t).erase u).sum (fun v => phi (t + 1) v) ≤
              ((V t).erase u).sum (fun v => phi t v) := by
            refine Finset.sum_le_sum ?_
            intro v hv_er
            obtain ⟨hv_ne_u, _⟩ := Finset.mem_erase.mp hv_er
            have hpi_v : pi (t + 1) v = pi t v := hpi_other v hv_ne_u
            dsimp (config := { failIfUnchanged := false }) only [phi]
            split_ifs with hc1 hc0
            · rfl
            · exfalso
              apply hc0
              rw [hpi_v] at hc1
              obtain ⟨h1_le, hL_ge, hgt⟩ := hc1
              refine ⟨h1_le, hL_ge, ?_⟩
              by_cases hpv_u : pi t v = u
              · rw [hpv_u] at h1_le hgt ⊢
                have hpi1_u : pi (t + 1) u = pi t p := hpi_u1
                have hpi0_u : pi t u = p := hpi_u0
                rw [hpi1_u] at hgt
                rw [hpi0_u]
                set q := pi t p
                have hp_lt_q : p < q := (hfold.lcrs_bounds t (by omega) p hp_in).1
                have hq_le_P : q ≤ P := (hfold.lcrs_bounds t (by omega) p hp_in).2.1
                have hq_ne_P : q ≠ P := by
                  intro hqP
                  rw [hqP, (hpart.sep_top u).1] at hgt
                  omega
                have hult := hpart.sep_ultrametric u p q (by omega) (by omega) (by omega)
                rw [hult] at hgt
                exact lt_of_lt_of_le hgt (Nat.min_le_left _ _)
              · have hpi2 : pi (t + 1) (pi t v) = pi t (pi t v) := hpi_other (pi t v) hpv_u
                rw [hpi2] at hgt
                exact hgt
            · exact Nat.zero_le _
            · exact le_rfl
          have hPhi1_split : phi (t + 1) u + ((V t).erase u).sum (fun v => phi (t + 1) v) =
              Phi (t + 1) := by
            dsimp (config := { failIfUnchanged := false }) only [Phi]
            rw [hV_next]
            exact Finset.add_sum_erase (V t) (fun v => phi (t + 1) v) hu_Vt
          have hPhi0_split : phi t u + ((V t).erase u).sum (fun v => phi t v) = Phi t :=
            Finset.add_sum_erase (V t) (fun v => phi t v) hu_Vt
          have hphi_u := h_phi_le_one (t + 1) u
          omega

    have h_telescope : ∀ N ≤ kops.length,
        (Finset.range N).sum b3t + Phi N ≤ Phi 0 + N + (Finset.range N).sum bpret := by
      intro N
      induction N with
      | zero => simp
      | succ N ih =>
        intro hN
        have hrec := ih (by omega)
        have hst := h_step_bound N (by omega)
        rw [Finset.sum_range_succ, Finset.sum_range_succ]
        dsimp (config := { failIfUnchanged := false }) only [b3t, bpret] at hrec hst ⊢
        omega

    have hPhi0 : Phi 0 = 0 := by
      have h0 : keyedState kops 0 = .nil := rfl
      simp [Phi, V, h0, inorderNat]
    have hPhi_end : Phi kops.length = 0 := by
      simp [Phi, V, hkvalid.end_empty, inorderNat]

    have h_fiber_card : ∀ A : Finset ℕ, A ⊆ Finset.range (jumps kops).length →
        A.card = (Finset.range kops.length).sum
          (fun t => (A.filter (fun id => ((jumps kops).getD id default).step = t)).card) := by
      intro A hsub
      refine Finset.card_eq_sum_card_fiberwise ?_
      intro id hid
      have hlt : id < (jumps kops).length := Finset.mem_range.mp (hsub (Finset.mem_coe.mp hid))
      dsimp (config := { failIfUnchanged := false }) only
      rw [Finset.mem_coe, Finset.mem_range, List.getD_eq_getElem _ _ hlt]
      exact (h_jump_bounds id hlt).1

    have hb3_tot : (B_3_intra S P L kops).card = (Finset.range kops.length).sum b3t :=
      h_fiber_card _ (fun id hid => (Finset.mem_filter.mp hid).1)
    have hbpre_tot : Bpre.card = (Finset.range kops.length).sum bpret := by
      refine h_fiber_card _ ?_
      intro id hid
      rcases Finset.mem_union.mp hid with h1 | h2
      · exact (Finset.mem_filter.mp h1).1
      · exact (Finset.mem_filter.mp h2).1
    have hbpre_le : Bpre.card ≤ (B_1 S P L kops).card + (B_fin_pre S P L kops).card :=
      Finset.card_union_le _ _
    have htel := h_telescope kops.length le_rfl
    omega




  have h_conj4 : (B_2 S P L kops).card ≤
      2 * P + 2 * (L * (scaleBlocks S P L).length) +
        (B_fin_pre S P L kops).card + (B_1 S P L kops).card +
        (B_3_intra S P L kops).card + (B_3_post S P L kops).card +
        (B_3_act S P L kops).card := by
    have h_b2_shell : ∀ id, id ∈ B_2 S P L kops →
        ∃ hid : id < (jumps kops).length,
          let e := (jumps kops)[id]
          let ℓ := sepScale S P L e.x e.y
          let Qs := blockOf S P L e.s
          let Bℓ := blockOf S P ℓ e.s
          let Bp := blockOf S P (ℓ - 1) e.s
          1 ≤ ℓ ∧ ℓ ≤ L ∧ ℓ < sepScale S P L e.s e.x ∧
            Bp.1 ≤ Bℓ.1 ∧ Bℓ.1 ≤ Qs.1 ∧ Qs.1 ≤ e.s ∧ e.s < Qs.2 ∧
            Qs.2 ≤ Bℓ.2 ∧ e.x < Bℓ.2 ∧ Bℓ.2 ≤ e.y ∧ e.y < Bp.2 ∧
            blockIdx S P L e.s < (scaleBlocks S P L).length := by
      intro id hid
      simp only [B_2, Finset.mem_filter, Finset.mem_range] at hid
      obtain ⟨hlt, his⟩ := hid
      refine ⟨hlt, ?_⟩
      simp only [isB2, List.getElem?_eq_getElem hlt, decide_eq_true_eq] at his
      obtain ⟨hℓ1, hℓL, hsep_sx⟩ := his
      have hb := h_jump_bounds id hlt
      dsimp (config := { failIfUnchanged := false }) only at hb
      set e := (jumps kops)[id]
      set ℓ := sepScale S P L e.x e.y
      have hsP : e.s < P := by omega
      have hxP : e.x < P := by omega
      have hyP : e.y < P := by omega
      have hidx_sx : blockIdx S P ℓ e.s = blockIdx S P ℓ e.x :=
        (hpart.sep_gt_iff ℓ hℓL e.s hsP e.x hxP).mp hsep_sx
      have hbo_sx : blockOf S P ℓ e.x = blockOf S P ℓ e.s := by
        simp only [blockOf, hidx_sx]
      have hx_hi : e.x < (blockOf S P ℓ e.s).2 :=
        ((hpart.blocks_eq_iff ℓ hℓL e.s hsP e.x hxP).mp hidx_sx).2
      have hne_xy : blockIdx S P ℓ e.x ≠ blockIdx S P ℓ e.y := by
        intro heq
        have := (hpart.sep_gt_iff ℓ hℓL e.x hxP e.y hyP).mpr heq
        omega
      have hy_lo : (blockOf S P ℓ e.s).2 ≤ e.y := by
        rw [← hbo_sx]
        exact (h_block_disj ℓ hℓL e.x e.y hb.2.2.2.1 hyP hne_xy).2
      have hidx_psx : blockIdx S P (ℓ - 1) e.s = blockIdx S P (ℓ - 1) e.x :=
        (hpart.sep_gt_iff (ℓ - 1) (by omega) e.s hsP e.x hxP).mp (by omega)
      have hidx_pxy : blockIdx S P (ℓ - 1) e.x = blockIdx S P (ℓ - 1) e.y :=
        (hpart.sep_gt_iff (ℓ - 1) (by omega) e.x hxP e.y hyP).mp (by omega)
      have hy_hi : e.y < (blockOf S P (ℓ - 1) e.s).2 :=
        ((hpart.blocks_eq_iff (ℓ - 1) (by omega) e.s hsP e.y hyP).mp
          (hidx_psx.trans hidx_pxy)).2
      obtain ⟨hn1_lo, _⟩ := h_block_nest (ℓ - 1) ℓ (by omega) hℓL e.s hsP
      obtain ⟨hn2_lo, hn2_hi⟩ := h_block_nest ℓ L hℓL le_rfl e.s hsP
      obtain ⟨hq_lo, hq_hi, _, hq_idx⟩ := h_block_bounds_of L le_rfl e.s hsP
      exact ⟨hℓ1, hℓL, hsep_sx, hn1_lo, hn2_lo, hq_lo, hq_hi, hn2_hi,
        hx_hi, hy_lo, hy_hi, hq_idx⟩

    let pC1 : ℕ → Prop := fun id =>
      ((jumps kops).getD id default).x < (blockOf S P L ((jumps kops).getD id default).s).2
    let pC2A : ℕ → Prop := fun id =>
      let e := (jumps kops).getD id default
      (blockOf S P (sepScale S P L e.x e.y - 1) e.s).2 ≤ e.z
    let pJm : ℕ → Prop := fun id =>
      ((jumps kops).getD id default).j + 1 < ((jumps kops).getD id default).m
    let pNextBp : ℕ → Prop := fun id =>
      let e := (jumps kops).getD id default
      (blockOf S P (sepScale S P L e.x e.y - 1) e.s).2 ≤
        ((jumps kops).getD (id + 1) default).y

    let C1 := (B_2 S P L kops).filter pC1
    let R1 := (B_2 S P L kops).filter (fun id => ¬pC1 id)
    let C2A := R1.filter pC2A
    let R2 := R1.filter (fun id => ¬pC2A id)
    let R3 := R2.filter pJm
    let C2B1 := R2.filter (fun id => ¬pJm id)
    let C2B2a := R3.filter pNextBp
    let C2B2b := R3.filter (fun id => ¬pNextBp id)

    have hsp1 : (B_2 S P L kops).card = C1.card + R1.card := h_split_card _ pC1
    have hsp2 : R1.card = C2A.card + R2.card := h_split_card _ pC2A
    have hsp3 : R2.card = R3.card + C2B1.card := h_split_card _ pJm
    have hsp4 : R3.card = C2B2a.card + C2B2b.card := h_split_card _ pNextBp

    have hC1_le : C1.card ≤ P := by
      have hle := h_card_inj C1 (Finset.range P)
        (fun id => ((jumps kops).getD id default).s)
        (fun id hid => by
          obtain ⟨hb2, _⟩ := Finset.mem_filter.mp hid
          obtain ⟨hlt, _⟩ := h_b2_shell id hb2
          dsimp (config := { failIfUnchanged := false }) only
          rw [List.getD_eq_getElem _ _ hlt, Finset.mem_range]
          have hb := h_jump_bounds id hlt
          dsimp (config := { failIfUnchanged := false }) only at hb
          omega)
        (fun id1 hid1 id2 hid2 hlt heq => by
          obtain ⟨hb2_1, _⟩ := Finset.mem_filter.mp hid1
          obtain ⟨hb2_2, hc1_2⟩ := Finset.mem_filter.mp hid2
          obtain ⟨h1_lt, _, _, _, _, _, _, _, hq_le_B1, _, hy_lo1, _, _⟩ := h_b2_shell id1 hb2_1
          obtain ⟨h2_lt, _⟩ := h_b2_shell id2 hb2_2
          simp only [pC1, List.getD_eq_getElem _ _ h1_lt, List.getD_eq_getElem _ _ h2_lt]
            at hc1_2 heq
          have hb_j1 := h_jump_bounds id1 h1_lt
          dsimp (config := { failIfUnchanged := false }) only at hb_j1
          have hst1 := h_jump_popStep id1 h1_lt
          have hst2 := h_jump_popStep id2 h2_lt
          rw [heq] at hst1
          have hchain := h_same_step id1 h1_lt id2 h2_lt hlt (hst1.symm.trans hst2)
          rw [← heq] at hc1_2
          omega)
      simpa only [Finset.card_range] using hle

    have hC2A_le : C2A.card ≤ L * (scaleBlocks S P L).length := by
      have hle := h_card_inj C2A
        ((Finset.range (scaleBlocks S P L).length) ×ˢ (Finset.Icc 1 L))
        (fun id =>
          let e := (jumps kops).getD id default
          (blockIdx S P L e.s, sepScale S P L e.x e.y))
        (fun id hid => by
          obtain ⟨hr1, _⟩ := Finset.mem_filter.mp hid
          obtain ⟨hb2, _⟩ := Finset.mem_filter.mp hr1
          obtain ⟨hlt, hℓ1, hℓL, _, _, _, _, _, _, _, _, _, hq_idx⟩ := h_b2_shell id hb2
          simp only [List.getD_eq_getElem _ _ hlt, Finset.mem_product, Finset.mem_range,
            Finset.mem_Icc]
          exact ⟨hq_idx, hℓ1, hℓL⟩)
        (fun id1 hid1 id2 hid2 hlt heq => by
          obtain ⟨hr1_1, hc2a_1⟩ := Finset.mem_filter.mp hid1
          obtain ⟨hb2_1, hnc1_1⟩ := Finset.mem_filter.mp hr1_1
          obtain ⟨hr1_2, _⟩ := Finset.mem_filter.mp hid2
          obtain ⟨hb2_2, _⟩ := Finset.mem_filter.mp hr1_2
          obtain ⟨h1_lt, _, hℓL_1, _, _, _, _, _, _, hx_hi1, _, _, _⟩ := h_b2_shell id1 hb2_1
          obtain ⟨h2_lt, _, _, _, _, _, _, hs_hi2, _, hx_hi2, hy_lo2, hy_hi2, _⟩ :=
            h_b2_shell id2 hb2_2
          simp only [pC1, pC2A, List.getD_eq_getElem _ _ h1_lt, List.getD_eq_getElem _ _ h2_lt,
            Prod.mk.injEq] at hnc1_1 hc2a_1 heq
          obtain ⟨hq_eq, hℓ_eq⟩ := heq
          have hb_j1 := h_jump_bounds id1 h1_lt
          have hb_j2 := h_jump_bounds id2 h2_lt
          dsimp (config := { failIfUnchanged := false }) only at hb_j1 hb_j2
          have hQ_eq : blockOf S P L ((jumps kops)[id1]).s =
              blockOf S P L ((jumps kops)[id2]).s := by
            simp only [blockOf, hq_eq]
          have hB_eq : blockOf S P (sepScale S P L ((jumps kops)[id1]).x ((jumps kops)[id1]).y)
              ((jumps kops)[id1]).s =
              blockOf S P (sepScale S P L ((jumps kops)[id2]).x ((jumps kops)[id2]).y)
              ((jumps kops)[id2]).s := by
            rw [← hℓ_eq]
            exact (h_anc_eq _ hℓL_1 _ (by omega) _ (by omega) hq_eq).2
          have hBp_eq : blockOf S P
              (sepScale S P L ((jumps kops)[id1]).x ((jumps kops)[id1]).y - 1)
              ((jumps kops)[id1]).s =
              blockOf S P
              (sepScale S P L ((jumps kops)[id2]).x ((jumps kops)[id2]).y - 1)
              ((jumps kops)[id2]).s := by
            rw [← hℓ_eq]
            exact (h_anc_eq _ (by omega) _ (by omega) _ (by omega) hq_eq).2
          rcases hjump.jump_order id1 h1_lt id2 h2_lt hlt with hst_lt | ⟨hst_eq, _⟩
          · rw [hQ_eq] at hnc1_1
            rw [hB_eq] at hx_hi1
            rw [hBp_eq] at hc2a_1
            have hy2_ls := (h_jump_ls id2 h2_lt).2.1
            exact h_lock_contra id1 h1_lt id2 h2_lt hst_lt (by omega)
              ((jumps kops)[id2]).y hy2_ls (by omega) (by omega)
          · have hchain := h_same_step id1 h1_lt id2 h2_lt hlt hst_eq
            rw [hB_eq] at hx_hi1
            rw [hBp_eq] at hc2a_1
            omega)
      simpa only [h_prod_card] using hle

    have hC2B1_le : C2B1.card ≤ P := by
      have hle := h_card_inj C2B1 (Finset.range P)
        (fun id => ((jumps kops).getD id default).s)
        (fun id hid => by
          obtain ⟨hr2, _⟩ := Finset.mem_filter.mp hid
          obtain ⟨hr1, _⟩ := Finset.mem_filter.mp hr2
          obtain ⟨hb2, _⟩ := Finset.mem_filter.mp hr1
          obtain ⟨hlt, _⟩ := h_b2_shell id hb2
          dsimp (config := { failIfUnchanged := false }) only
          rw [List.getD_eq_getElem _ _ hlt, Finset.mem_range]
          have hb := h_jump_bounds id hlt
          dsimp (config := { failIfUnchanged := false }) only at hb
          omega)
        (fun id1 hid1 id2 hid2 hlt heq => by
          obtain ⟨hr2_1, hnot1⟩ := Finset.mem_filter.mp hid1
          obtain ⟨hr1_1, _⟩ := Finset.mem_filter.mp hr2_1
          obtain ⟨hb2_1, _⟩ := Finset.mem_filter.mp hr1_1
          obtain ⟨hr2_2, _⟩ := Finset.mem_filter.mp hid2
          obtain ⟨hr1_2, _⟩ := Finset.mem_filter.mp hr2_2
          obtain ⟨hb2_2, _⟩ := Finset.mem_filter.mp hr1_2
          obtain ⟨h1_lt, _⟩ := h_b2_shell id1 hb2_1
          obtain ⟨h2_lt, _⟩ := h_b2_shell id2 hb2_2
          simp only [pJm, List.getD_eq_getElem _ _ h1_lt, List.getD_eq_getElem _ _ h2_lt]
            at hnot1 heq
          exact h_last_jump_contra id1 h1_lt id2 h2_lt hlt heq hnot1)
      simpa only [Finset.card_range] using hle

    have hC2B2a_le : C2B2a.card ≤ L * (scaleBlocks S P L).length := by
      have hle := h_card_inj C2B2a
        ((Finset.range (scaleBlocks S P L).length) ×ˢ (Finset.Icc 1 L))
        (fun id =>
          let e := (jumps kops).getD id default
          (blockIdx S P L e.s, sepScale S P L e.x e.y))
        (fun id hid => by
          obtain ⟨hr3, _⟩ := Finset.mem_filter.mp hid
          obtain ⟨hr2, _⟩ := Finset.mem_filter.mp hr3
          obtain ⟨hr1, _⟩ := Finset.mem_filter.mp hr2
          obtain ⟨hb2, _⟩ := Finset.mem_filter.mp hr1
          obtain ⟨hlt, hℓ1, hℓL, _, _, _, _, _, _, _, _, _, hq_idx⟩ := h_b2_shell id hb2
          simp only [List.getD_eq_getElem _ _ hlt, Finset.mem_product, Finset.mem_range,
            Finset.mem_Icc]
          exact ⟨hq_idx, hℓ1, hℓL⟩)
        (fun id1 hid1 id2 hid2 hlt heq => by
          obtain ⟨hr3_1, hnh1⟩ := Finset.mem_filter.mp hid1
          obtain ⟨hr2_1, hjm1⟩ := Finset.mem_filter.mp hr3_1
          obtain ⟨hr1_1, hnc2a_1⟩ := Finset.mem_filter.mp hr2_1
          obtain ⟨hb2_1, hnc1_1⟩ := Finset.mem_filter.mp hr1_1
          obtain ⟨hr3_2, _⟩ := Finset.mem_filter.mp hid2
          obtain ⟨hr2_2, _⟩ := Finset.mem_filter.mp hr3_2
          obtain ⟨hr1_2, hnc2a_2⟩ := Finset.mem_filter.mp hr2_2
          obtain ⟨hb2_2, _⟩ := Finset.mem_filter.mp hr1_2
          obtain ⟨h1_lt, _, hℓL_1, _, _, _, _, _, _, hx_hi1, hy_lo1, _, _⟩ :=
            h_b2_shell id1 hb2_1
          obtain ⟨h2_lt, _, _, _, _, _, _, hs_hi2, _, hx_hi2, hy_lo2, hy_hi2, _⟩ :=
            h_b2_shell id2 hb2_2
          simp only [pC1, pC2A, pJm, List.getD_eq_getElem _ _ h1_lt,
            List.getD_eq_getElem _ _ h2_lt, Prod.mk.injEq]
            at hnc1_1 hnc2a_1 hnc2a_2 hjm1 heq
          obtain ⟨h1_succ_lt, hst_s1, _, _, _, hx_s1⟩ := h_jump_succ id1 h1_lt hjm1
          simp only [pNextBp, List.getD_eq_getElem _ _ h1_lt,
            List.getD_eq_getElem _ _ h1_succ_lt] at hnh1
          obtain ⟨hq_eq, hℓ_eq⟩ := heq
          have hb_j1 := h_jump_bounds id1 h1_lt
          have hb_j1s := h_jump_bounds (id1 + 1) h1_succ_lt
          have hb_j2 := h_jump_bounds id2 h2_lt
          dsimp (config := { failIfUnchanged := false }) only at hb_j1 hb_j1s hb_j2
          have hQ_eq : blockOf S P L ((jumps kops)[id1]).s =
              blockOf S P L ((jumps kops)[id2]).s := by
            simp only [blockOf, hq_eq]
          have hB_eq : blockOf S P (sepScale S P L ((jumps kops)[id1]).x ((jumps kops)[id1]).y)
              ((jumps kops)[id1]).s =
              blockOf S P (sepScale S P L ((jumps kops)[id2]).x ((jumps kops)[id2]).y)
              ((jumps kops)[id2]).s := by
            rw [← hℓ_eq]
            exact (h_anc_eq _ hℓL_1 _ (by omega) _ (by omega) hq_eq).2
          have hBp_eq : blockOf S P
              (sepScale S P L ((jumps kops)[id1]).x ((jumps kops)[id1]).y - 1)
              ((jumps kops)[id1]).s =
              blockOf S P
              (sepScale S P L ((jumps kops)[id2]).x ((jumps kops)[id2]).y - 1)
              ((jumps kops)[id2]).s := by
            rw [← hℓ_eq]
            exact (h_anc_eq _ (by omega) _ (by omega) _ (by omega) hq_eq).2
          rcases hjump.jump_order id1 h1_lt id2 h2_lt hlt with hst_lt | ⟨hst_eq, _⟩
          · rw [hQ_eq] at hnc1_1
            rw [hB_eq] at hx_hi1 hy_lo1
            rw [hBp_eq] at hnc2a_1 hnh1
            have hs2x1 : ((jumps kops)[id2]).s < ((jumps kops)[id1]).x := by omega
            have hs2x1s : ((jumps kops)[id2]).s < ((jumps kops)[id1 + 1]).x := by omega
            have hst_lt_s : ((jumps kops)[id1 + 1]).step < ((jumps kops)[id2]).step := by omega
            obtain ⟨_, hy2_ls, hz2_ls⟩ := h_jump_ls id2 h2_lt
            rcases lt_trichotomy ((jumps kops)[id2]).y ((jumps kops)[id1]).z with hy_lt | hy_eq | hy_gt
            · exact h_lock_contra id1 h1_lt id2 h2_lt hst_lt hs2x1
                ((jumps kops)[id2]).y hy2_ls (by omega) hy_lt
            · exact h_lock_contra (id1 + 1) h1_succ_lt id2 h2_lt hst_lt_s hs2x1s
                ((jumps kops)[id2]).z hz2_ls (by omega) (by omega)
            · exact h_lock_contra (id1 + 1) h1_succ_lt id2 h2_lt hst_lt_s hs2x1s
                ((jumps kops)[id2]).y hy2_ls (by omega) (by omega)
          · rw [hB_eq] at hy_lo1
            rw [hBp_eq] at hnh1
            by_cases hid_adj : id2 = id1 + 1
            · subst hid_adj
              omega
            · have hlt_s : id1 + 1 < id2 := by omega
              have hchain := h_same_step (id1 + 1) h1_succ_lt id2 h2_lt hlt_s (by omega)
              omega)
      simpa only [h_prod_card] using hle

    let U5 : Finset ℕ :=
      B_fin_pre S P L kops ∪ B_1 S P L kops ∪ B_3_intra S P L kops ∪
        B_3_post S P L kops ∪ B_3_act S P L kops

    have hC2B2b_le : C2B2b.card ≤ U5.card := by
      refine h_card_inj C2B2b U5 (fun id => id + 1)
        (fun id hid => by
          obtain ⟨hr3, hnnh⟩ := Finset.mem_filter.mp hid
          obtain ⟨hr2, hjm⟩ := Finset.mem_filter.mp hr3
          obtain ⟨hr1, hnc2a⟩ := Finset.mem_filter.mp hr2
          obtain ⟨hb2, hnc1⟩ := Finset.mem_filter.mp hr1
          obtain ⟨hlt, hℓ1, hℓL, _, hBp_B, hB_Q, hQ_s, _, _, hx_hi, hy_lo, _, _⟩ :=
            h_b2_shell id hb2
          simp only [pC1, pC2A, pJm, List.getD_eq_getElem _ _ hlt] at hnc1 hnc2a hjm
          obtain ⟨h_succ_lt, _, hs_eq, _, _, hx_eq⟩ := h_jump_succ id hlt hjm
          simp only [pNextBp, List.getD_eq_getElem _ _ hlt,
            List.getD_eq_getElem _ _ h_succ_lt] at hnnh
          have hb := h_jump_bounds id hlt
          have hbs := h_jump_bounds (id + 1) h_succ_lt
          dsimp (config := { failIfUnchanged := false }) only at hb hbs
          set e := (jumps kops)[id]
          set e' := (jumps kops)[id + 1]
          set ℓ := sepScale S P L e.x e.y
          set ℓ' := sepScale S P L e'.x e'.y
          have hsP : e.s < P := by omega
          have hxsP : e'.x < P := by omega
          have hysP : e'.y < P := by omega
          have hidx_px : blockIdx S P (ℓ - 1) e.s = blockIdx S P (ℓ - 1) e'.x :=
            (hpart.blocks_eq_iff (ℓ - 1) (by omega) e.s hsP e'.x hxsP).mpr ⟨by omega, by omega⟩
          have hidx_py : blockIdx S P (ℓ - 1) e.s = blockIdx S P (ℓ - 1) e'.y :=
            (hpart.blocks_eq_iff (ℓ - 1) (by omega) e.s hsP e'.y hysP).mpr ⟨by omega, by omega⟩
          have hℓ'_gt_prev : ℓ - 1 < ℓ' :=
            (hpart.sep_gt_iff (ℓ - 1) (by omega) e'.x hxsP e'.y hysP).mpr
              (hidx_px.symm.trans hidx_py)
          have hsx'_gt_prev : ℓ - 1 < sepScale S P L e'.s e'.x := by
            rw [hs_eq]
            exact (hpart.sep_gt_iff (ℓ - 1) (by omega) e.s hsP e'.x hxsP).mpr hidx_px
          have hsx'_not_gt : ¬(ℓ < sepScale S P L e'.s e'.x) := by
            rw [hs_eq]
            intro hgt
            have hidx_ℓ := (hpart.sep_gt_iff ℓ hℓL e.s hsP e'.x hxsP).mp hgt
            have hhi_ℓ := ((hpart.blocks_eq_iff ℓ hℓL e.s hsP e'.x hxsP).mp hidx_ℓ).2
            omega
          have hsx'_eq : sepScale S P L e'.s e'.x = ℓ := by omega
          have hℓ'_rng := hpart.sep_range e'.x hxsP e'.y hysP (by omega)
          simp only [U5, Finset.mem_union]
          by_cases hℓ'_L1 : ℓ' = L + 1
          · left; left; left; left
            have hne_L : blockIdx S P L e'.s ≠ blockIdx S P L e'.x := by
              intro heq
              have := (hpart.sep_gt_iff L le_rfl _ (by omega) _ hxsP).mpr heq
              omega
            have hs_lt_bo := (h_block_disj L le_rfl _ _ hbs.2.2.1 hxsP hne_L).1
            simp only [B_fin_pre, Finset.mem_filter, Finset.mem_range, isBFinPre,
              List.getElem?_eq_getElem h_succ_lt, decide_eq_true_eq]
            exact ⟨h_succ_lt, hℓ'_L1, hs_lt_bo⟩
          · have hℓ'_le_L : ℓ' ≤ L := by omega
            by_cases hℓ'_gt : ℓ < ℓ'
            · left; left; left; right
              simp only [B_1, Finset.mem_filter, Finset.mem_range, isB1,
                List.getElem?_eq_getElem h_succ_lt, decide_eq_true_eq]
              dsimp (config := { failIfUnchanged := false }) only [e, e', ℓ, ℓ'] at *
              exact ⟨h_succ_lt, by omega, hℓ'_le_L, by omega⟩
            · have hℓ'_eq : ℓ' = ℓ := by omega
              by_cases hz_intra : e'.z < (blockOf S P ℓ' e'.y).2
              · left; left; right
                simp only [B_3_intra, Finset.mem_filter, Finset.mem_range, isB3Intra,
                  List.getElem?_eq_getElem h_succ_lt, decide_eq_true_eq]
                dsimp (config := { failIfUnchanged := false }) only [e, e', ℓ, ℓ'] at *
                exact ⟨h_succ_lt, by omega, hℓ'_le_L, by omega, hz_intra⟩
              · by_cases ht_post :
                    tEmpty kops (blockOf S P ℓ' e'.s).1 (blockOf S P ℓ' e'.s).2 ≤ e'.step
                · left; right
                  simp only [B_3_post, Finset.mem_filter, Finset.mem_range, isB3Post,
                    List.getElem?_eq_getElem h_succ_lt, decide_eq_true_eq]
                  dsimp (config := { failIfUnchanged := false }) only [e, e', ℓ, ℓ'] at *
                  exact ⟨h_succ_lt, by omega, hℓ'_le_L, by omega, by omega, ht_post⟩
                · right
                  simp only [B_3_act, Finset.mem_filter, Finset.mem_range, isB3Act,
                    List.getElem?_eq_getElem h_succ_lt, decide_eq_true_eq]
                  dsimp (config := { failIfUnchanged := false }) only [e, e', ℓ, ℓ'] at *
                  exact ⟨h_succ_lt, by omega, hℓ'_le_L, by omega, by omega, by omega⟩)
        (fun _ _ _ _ _ heq => by dsimp (config := { failIfUnchanged := false }) only at heq; omega)

    have hU5_card : U5.card ≤
        (B_fin_pre S P L kops).card + (B_1 S P L kops).card +
          (B_3_intra S P L kops).card + (B_3_post S P L kops).card +
          (B_3_act S P L kops).card := by
      have u1 := Finset.card_union_le
        (B_fin_pre S P L kops ∪ B_1 S P L kops ∪ B_3_intra S P L kops ∪ B_3_post S P L kops)
        (B_3_act S P L kops)
      have u2 := Finset.card_union_le
        (B_fin_pre S P L kops ∪ B_1 S P L kops ∪ B_3_intra S P L kops)
        (B_3_post S P L kops)
      have u3 := Finset.card_union_le
        (B_fin_pre S P L kops ∪ B_1 S P L kops)
        (B_3_intra S P L kops)
      have u4 := Finset.card_union_le (B_fin_pre S P L kops) (B_1 S P L kops)
      dsimp (config := { failIfUnchanged := false }) only [U5]
      omega

    omega

  exact ⟨h_conj1, h_conj2, h_conj3, h_conj4⟩


-- === BEGIN SolPart4 ===
theorem plug_unborn_trajectory_laws (P : ℕ) (kops : List KeyedCoreOp)
    (hP : 1 ≤ P) (hkvalid : ValidKeyedCoreSeq P kops)
    (hjump : PrimalJumpLaws P kops) (hfold : ValidFoldedCoreLaws P kops) :
    PuqPlugUnbornLaws P kops :=
by
  have _ := hP

  have h_inord_left :
      ∀ (l : _root_.BinaryTree ℕ) (k : ℕ) (r : _root_.BinaryTree ℕ) (x : ℕ),
        x ∈ inorderNat l → x ∈ inorderNat (.node k l r) := by
    intro l k r x hx
    rw [inorderNat]
    exact List.mem_append_left _ (List.mem_append_left _ hx)

  have h_inord_key :
      ∀ (l : _root_.BinaryTree ℕ) (k : ℕ) (r : _root_.BinaryTree ℕ),
        k ∈ inorderNat (.node k l r) := by
    intro l k r
    rw [inorderNat]
    exact List.mem_append_left _ (List.mem_append_right _ (List.mem_singleton_self k))

  have h_inord_right :
      ∀ (l : _root_.BinaryTree ℕ) (k : ℕ) (r : _root_.BinaryTree ℕ) (x : ℕ),
        x ∈ inorderNat r → x ∈ inorderNat (.node k l r) := by
    intro l k r x hx
    rw [inorderNat]
    exact List.mem_append_right _ hx

  have h_forall_inord :
      ∀ (p : ℕ → Prop) (T : _root_.BinaryTree ℕ),
        _root_.SplayDeque.Direct.ForallTree p T ↔ ∀ k ∈ inorderNat T, p k := by
    intro p T
    induction T with
    | nil =>
      simp only [inorderNat, List.not_mem_nil, false_implies, implies_true, iff_true]
      exact _root_.SplayDeque.Direct.ForallTree.left
    | node key l r ihl ihr =>
      constructor
      · intro hft x hx
        cases hft with
        | node _ _ _ hl hk hr =>
          rw [inorderNat, List.mem_append, List.mem_append, List.mem_singleton] at hx
          rcases hx with (hxl | rfl) | hxr
          · exact ihl.mp hl x hxl
          · exact hk
          · exact ihr.mp hr x hxr
      · intro hall
        exact _root_.SplayDeque.Direct.ForallTree.node l key r
          (ihl.mpr fun x hx => hall x (h_inord_left l key r x hx))
          (hall key (h_inord_key l key r))
          (ihr.mpr fun x hx => hall x (h_inord_right l key r x hx))

  have h_ls_aux :
      ∀ (T : _root_.BinaryTree ℕ) (acc : List ℕ),
        leftSpineBottomUpAux T acc = leftSpineBottomUpNat T ++ acc := by
    intro T
    induction T with
    | nil =>
      intro acc
      rfl
    | node k l r ihl _ =>
      intro acc
      calc
        leftSpineBottomUpAux (.node k l r) acc
            = leftSpineBottomUpAux l (k :: acc) := rfl
        _ = leftSpineBottomUpNat l ++ (k :: acc) := ihl (k :: acc)
        _ = (leftSpineBottomUpNat l ++ [k]) ++ acc := by simp
        _ = (leftSpineBottomUpAux l [k]) ++ acc := by rw [← ihl [k]]
        _ = leftSpineBottomUpNat (.node k l r) ++ acc := rfl

  have h_ls_node :
      ∀ (l : _root_.BinaryTree ℕ) (k : ℕ) (r : _root_.BinaryTree ℕ),
        leftSpineBottomUpNat (.node k l r) = leftSpineBottomUpNat l ++ [k] := by
    intro l k r
    simpa [leftSpineBottomUpNat, leftSpineBottomUpAux] using h_ls_aux l [k]

  have h_nonempty_lists :
      ∀ (T : _root_.BinaryTree ℕ), T ≠ .nil →
        leftSpineBottomUpNat T ≠ [] ∧ inorderNat T ≠ [] := by
    rintro (_ | ⟨k, l, r⟩) hne
    · exact absurd rfl hne
    · refine ⟨?_, ?_⟩
      · rw [h_ls_node]
        simp
      · rw [inorderNat]
        simp

  have h_rot_not_mem :
      ∀ (u : ℕ) (T : _root_.BinaryTree ℕ),
        u ∉ inorderNat T → rotateRightOnLeftSpine u T = T := by
    intro u T
    induction T with
    | nil =>
      intro _
      rfl
    | node y l c ihl _ =>
      intro hu
      rcases l with _ | ⟨x, a, b⟩
      · rfl
      · have hxu : x ≠ u := by
          intro h_eq
          subst h_eq
          exact hu (h_inord_left (.node x a b) y c x (h_inord_key a x b))
        have hu_l : u ∉ inorderNat (.node x a b) :=
          fun hmem => hu (h_inord_left (.node x a b) y c u hmem)
        simp only [rotateRightOnLeftSpine, hxu, ↓reduceIte, ihl hu_l]

  have h_rot_left_not_mem :
      ∀ (u : ℕ) (L : _root_.BinaryTree ℕ) (y : ℕ) (R : _root_.BinaryTree ℕ),
        u ∉ inorderNat L → rotateRightOnLeftSpine u (.node y L R) = .node y L R := by
    intro u L y R huL
    rcases L with _ | ⟨x, a, b⟩
    · rfl
    · have hxu : x ≠ u := by
        intro h_eq
        subst h_eq
        exact huL (h_inord_key a x b)
      simp only [rotateRightOnLeftSpine, hxu, ↓reduceIte, h_rot_not_mem u (.node x a b) huL]

  have h_rot_bst_inord :
      ∀ (T : _root_.BinaryTree ℕ) (u : ℕ),
        _root_.BinaryTree.IsBST T →
          _root_.BinaryTree.IsBST (rotateRightOnLeftSpine u T) ∧
            inorderNat (rotateRightOnLeftSpine u T) = inorderNat T := by
    intro T u
    induction T with
    | nil =>
      intro hbst
      exact ⟨hbst, rfl⟩
    | node y l c ihl _ =>
      intro hbst
      cases hbst using isBSTCases with
      | node _ _ _ hl_lt hc_gt hbst_l hbst_c =>
        rcases l with _ | ⟨x, a, b⟩
        · exact ⟨_root_.BinaryTree.IsBST.node y .nil c hl_lt hc_gt hbst_l hbst_c, rfl⟩
        · by_cases hxu : x = u
          · subst hxu
            simp only [rotateRightOnLeftSpine, ↓reduceIte]
            cases hbst_l using isBSTCases with
            | node _ _ _ ha_lt hb_gt hbst_a hbst_b =>
              cases hl_lt with
              | node _ _ _ _ hx_lt_y hb_lt_y =>
                have hbst_byc : _root_.BinaryTree.IsBST (.node y b c) :=
                  _root_.BinaryTree.IsBST.node y b c hb_lt_y hc_gt hbst_b hbst_c
                have h_gt_x : _root_.SplayDeque.Direct.ForallTree (fun k => x < k) (.node y b c) := by
                  refine _root_.SplayDeque.Direct.ForallTree.node b y c hb_gt hx_lt_y ?_
                  rw [h_forall_inord] at hc_gt ⊢
                  intro z hz
                  have hyz := hc_gt z hz
                  omega
                refine ⟨_root_.BinaryTree.IsBST.node x a (.node y b c) ha_lt h_gt_x hbst_a hbst_byc, ?_⟩
                simp [inorderNat, List.append_assoc]
          · simp only [rotateRightOnLeftSpine, hxu, ↓reduceIte]
            obtain ⟨hbst_l', hinord_l'⟩ := ihl hbst_l
            have hl'_lt : _root_.SplayDeque.Direct.ForallTree (fun k => k < y)
                (rotateRightOnLeftSpine u (.node x a b)) := by
              rw [h_forall_inord, hinord_l', ← h_forall_inord]
              exact hl_lt
            refine ⟨_root_.BinaryTree.IsBST.node y _ c hl'_lt hc_gt hbst_l' hbst_c, ?_⟩
            rw [inorderNat, inorderNat, hinord_l']

  have h_cart_bst_inord :
      ∀ (birth : ℕ → ℕ) (fuel a b : ℕ),
        a ≤ b → b - a ≤ fuel →
          _root_.BinaryTree.IsBST (cartesianRangeAux birth fuel a b) ∧
            inorderNat (cartesianRangeAux birth fuel a b) = List.Ico a b := by
    intro birth fuel
    induction fuel with
    | zero =>
      intro a b hab hfuel
      have heq : a = b := by omega
      subst heq
      simp [cartesianRangeAux, inorderNat, _root_.BinaryTree.IsBST.left]
    | succ fuel ih =>
      intro a b hab hfuel
      by_cases hlt : a < b
      · simp only [cartesianRangeAux, hlt, ↓reduceIte]
        set w := min (max a (minBirthKey birth a b)) (b - 1)
        have haw : a ≤ w := by omega
        have hwb : w < b := by omega
        obtain ⟨hbst_l, hinord_l⟩ := ih a w haw (by omega)
        obtain ⟨hbst_r, hinord_r⟩ := ih (w + 1) b (by omega) (by omega)
        have hl_lt : _root_.SplayDeque.Direct.ForallTree (fun k => k < w) (cartesianRangeAux birth fuel a w) := by
          rw [h_forall_inord, hinord_l]
          intro k hk
          exact (List.Ico.mem.mp hk).2
        have hr_gt : _root_.SplayDeque.Direct.ForallTree (fun k => w < k)
            (cartesianRangeAux birth fuel (w + 1) b) := by
          rw [h_forall_inord, hinord_r]
          intro k hk
          have := (List.Ico.mem.mp hk).1
          omega
        refine ⟨_root_.BinaryTree.IsBST.node w _ _ hl_lt hr_gt hbst_l hbst_r, ?_⟩
        simp only [inorderNat, hinord_l, hinord_r, List.append_assoc, List.singleton_append]
        rw [← List.Ico.eq_cons hwb, List.Ico.append_consecutive haw (le_of_lt hwb)]
      · have heq : a = b := by omega
        subst heq
        simp [cartesianRangeAux, inorderNat, _root_.BinaryTree.IsBST.left]

  have h_plug_bst_inord :
      ∀ (birth : ℕ → ℕ) (F : _root_.BinaryTree ℕ) (lo hi : ℕ),
        lo ≤ hi → _root_.BinaryTree.IsBST F → (∀ k ∈ inorderNat F, lo ≤ k ∧ k < hi) →
          _root_.BinaryTree.IsBST (plugUnbornNat birth lo hi F) ∧
            inorderNat (plugUnbornNat birth lo hi F) = List.Ico lo hi := by
    intro birth F
    induction F with
    | nil =>
      intro lo hi hlo _ _
      exact h_cart_bst_inord birth (hi - lo) lo hi hlo le_rfl
    | node k l r ihl ihr =>
      intro lo hi _ hbst hinord
      cases hbst using isBSTCases with
      | node _ _ _ hl_lt hr_gt hbst_l hbst_r =>
        have hk_in : lo ≤ k ∧ k < hi := hinord k (h_inord_key l k r)
        have hl_in : ∀ x ∈ inorderNat l, lo ≤ x ∧ x < k := fun x hx =>
          ⟨(hinord x (h_inord_left l k r x hx)).1, (h_forall_inord _ l).mp hl_lt x hx⟩
        have hr_in : ∀ x ∈ inorderNat r, k + 1 ≤ x ∧ x < hi := by
          intro x hx
          have hkx := (h_forall_inord _ r).mp hr_gt x hx
          exact ⟨by omega, (hinord x (h_inord_right l k r x hx)).2⟩
        obtain ⟨hbst_pl, hinord_pl⟩ := ihl lo k hk_in.1 hbst_l hl_in
        obtain ⟨hbst_pr, hinord_pr⟩ := ihr (k + 1) hi (by omega) hbst_r hr_in
        have hpl_lt : _root_.SplayDeque.Direct.ForallTree (fun x => x < k) (plugUnbornNat birth lo k l) := by
          rw [h_forall_inord, hinord_pl]
          intro x hx
          exact (List.Ico.mem.mp hx).2
        have hpr_gt : _root_.SplayDeque.Direct.ForallTree (fun x => k < x)
            (plugUnbornNat birth (k + 1) hi r) := by
          rw [h_forall_inord, hinord_pr]
          intro x hx
          have := (List.Ico.mem.mp hx).1
          omega
        refine ⟨_root_.BinaryTree.IsBST.node k _ _ hpl_lt hpr_gt hbst_pl hbst_pr, ?_⟩
        rw [plugUnbornNat, inorderNat, hinord_pl, hinord_pr,
          List.append_assoc, List.singleton_append,
          ← List.Ico.eq_cons hk_in.2, List.Ico.append_consecutive hk_in.1 (le_of_lt hk_in.2)]

  have h_s1 : ∀ (birth : ℕ → ℕ) (P0 lo hi : ℕ) (F : _root_.BinaryTree ℕ),
      lo ≤ hi → _root_.BinaryTree.IsBST F → (∀ k ∈ inorderNat F, lo ≤ k ∧ k < hi) →
        (_root_.BinaryTree.IsBST (plugUnbornNat birth lo hi F) ∧
          inorderNat (plugUnbornNat birth lo hi F) = List.Ico lo hi) ∧
        (∀ v ∈ inorderNat F,
          lcrsParent P0 (plugUnbornNat birth lo hi F) v = lcrsParent P0 F v) ∧
        (∀ m0, (leftSpineBottomUpNat F).head? = some m0 →
          leftSpineBottomUpNat (plugUnbornNat birth lo hi F) =
            leftSpineBottomUpNat (cartesianRangeNat birth lo m0) ++ leftSpineBottomUpNat F) ∧
        ((leftSpineBottomUpNat F).head? = some lo →
          spliceMinNat (plugUnbornNat birth lo hi F) =
            plugUnbornNat birth (lo + 1) hi (spliceMinNat F)) ∧
        (∀ us : List ℕ, (∀ u ∈ us, u ∈ inorderNat F) →
          plugUnbornNat birth lo hi (us.foldl (fun T u => rotateRightOnLeftSpine u T) F) =
            us.foldl (fun T u => rotateRightOnLeftSpine u T) (plugUnbornNat birth lo hi F)) := by
    intro birth P0 lo hi F hlo hbst hinord
    have h_lcrs_aux :
        ∀ (G : _root_.BinaryTree ℕ) (a b curP v : ℕ),
          _root_.BinaryTree.IsBST G → v ∈ inorderNat G →
            lcrsParentAux P0 curP v (plugUnbornNat birth a b G) = lcrsParentAux P0 curP v G := by
      intro G
      induction G with
      | nil =>
        intro _ _ _ _ _ hv
        simp [inorderNat] at hv
      | node k l r ihl ihr =>
        intro a b curP v hbstG hv
        cases hbstG using isBSTCases with
        | node _ _ _ hl_lt hr_gt hbst_l hbst_r =>
          rw [plugUnbornNat]
          simp only [lcrsParentAux]
          by_cases hvk : v < k
          · simp only [hvk, ↓reduceIte]
            have hv_l : v ∈ inorderNat l := by
              rw [inorderNat, List.mem_append, List.mem_append, List.mem_singleton] at hv
              rcases hv with (hvl | rfl) | hvr
              · exact hvl
              · omega
              · have := (h_forall_inord _ r).mp hr_gt v hvr
                omega
            exact ihl a k k v hbst_l hv_l
          · simp only [hvk, ↓reduceIte]
            by_cases hkv : k < v
            · simp only [hkv, ↓reduceIte]
              have hv_r : v ∈ inorderNat r := by
                rw [inorderNat, List.mem_append, List.mem_append, List.mem_singleton] at hv
                rcases hv with (hvl | rfl) | hvr
                · have := (h_forall_inord _ l).mp hl_lt v hvl
                  omega
                · omega
                · exact hvr
              exact ihr (k + 1) b curP v hbst_r hv_r
            · simp only [hkv, ↓reduceIte]
    have h_ls_plug :
        ∀ (G : _root_.BinaryTree ℕ) (a b m0 : ℕ),
          (leftSpineBottomUpNat G).head? = some m0 →
            leftSpineBottomUpNat (plugUnbornNat birth a b G) =
              leftSpineBottomUpNat (cartesianRangeNat birth a m0) ++ leftSpineBottomUpNat G := by
      intro G
      induction G with
      | nil =>
        intro _ _ _ h
        simp [leftSpineBottomUpNat, leftSpineBottomUpAux] at h
      | node k l r ihl _ =>
        intro a b m0 hhead
        rcases l with _ | ⟨lk, ll, lr⟩
        · rw [h_ls_node] at hhead
          simp only [leftSpineBottomUpNat, leftSpineBottomUpAux, List.nil_append,
            List.head?_cons, Option.some.injEq] at hhead
          subst hhead
          rw [plugUnbornNat, h_ls_node, h_ls_node]
          simp [plugUnbornNat, leftSpineBottomUpNat, leftSpineBottomUpAux]
        · have hne : leftSpineBottomUpNat (.node lk ll lr) ≠ [] :=
            (h_nonempty_lists (.node lk ll lr) (by simp)).1
          rw [h_ls_node, List.head?_append_of_ne_nil _ hne] at hhead
          conv_lhs => rw [plugUnbornNat]
          rw [h_ls_node, h_ls_node, ihl a k m0 hhead, List.append_assoc]
    have h_splice_plug :
        ∀ (G : _root_.BinaryTree ℕ) (b : ℕ),
          (leftSpineBottomUpNat G).head? = some lo →
            spliceMinNat (plugUnbornNat birth lo b G) =
              plugUnbornNat birth (lo + 1) b (spliceMinNat G) := by
      intro G
      induction G with
      | nil =>
        intro _ h
        simp [leftSpineBottomUpNat, leftSpineBottomUpAux] at h
      | node k l r ihl _ =>
        intro b hhead
        rcases l with _ | ⟨lk, ll, lr⟩
        · rw [h_ls_node] at hhead
          simp only [leftSpineBottomUpNat, leftSpineBottomUpAux, List.nil_append,
            List.head?_cons, Option.some.injEq] at hhead
          subst hhead
          have hcart_empty : cartesianRangeNat birth k k = .nil := by
            simp [cartesianRangeNat, cartesianRangeAux]
          simp [plugUnbornNat, hcart_empty, spliceMinNat]
        · have hne : leftSpineBottomUpNat (.node lk ll lr) ≠ [] :=
            (h_nonempty_lists (.node lk ll lr) (by simp)).1
          rw [h_ls_node, List.head?_append_of_ne_nil _ hne] at hhead
          have h_lhs :
              spliceMinNat (plugUnbornNat birth lo b (.node k (.node lk ll lr) r)) =
                .node k (spliceMinNat (plugUnbornNat birth lo k (.node lk ll lr)))
                  (plugUnbornNat birth (k + 1) b r) := by
            simp [plugUnbornNat, spliceMinNat]
          have h_rhs :
              plugUnbornNat birth (lo + 1) b (spliceMinNat (.node k (.node lk ll lr) r)) =
                .node k (plugUnbornNat birth (lo + 1) k (spliceMinNat (.node lk ll lr)))
                  (plugUnbornNat birth (k + 1) b r) := by
            simp [plugUnbornNat, spliceMinNat]
          rw [h_lhs, h_rhs, ihl k hhead]
    have h_rot_one :
        ∀ (G : _root_.BinaryTree ℕ) (a b u : ℕ),
          a ≤ b → _root_.BinaryTree.IsBST G → (∀ k ∈ inorderNat G, a ≤ k ∧ k < b) →
          u ∈ inorderNat G →
            plugUnbornNat birth a b (rotateRightOnLeftSpine u G) =
              rotateRightOnLeftSpine u (plugUnbornNat birth a b G) := by
      intro G
      induction G with
      | nil =>
        intro _ _ _ _ _ _ hu
        simp [inorderNat] at hu
      | node y l c ihl _ =>
        intro a b u hab hbstG hinordG hu
        cases hbstG using isBSTCases with
        | node _ _ _ hl_lt hc_gt hbst_l _ =>
          have hy_in : a ≤ y ∧ y < b := hinordG y (h_inord_key l y c)
          by_cases hyu : y ≤ u
          · have hu_not_l : u ∉ inorderNat l := by
              intro hmem
              have := (h_forall_inord _ l).mp hl_lt u hmem
              omega
            have hl_in : ∀ k ∈ inorderNat l, a ≤ k ∧ k < y := fun k hk =>
              ⟨(hinordG k (h_inord_left l y c k hk)).1,
                (h_forall_inord _ l).mp hl_lt k hk⟩
            have hinord_pl := (h_plug_bst_inord birth l a y hy_in.1 hbst_l hl_in).2
            have hu_not_pl : u ∉ inorderNat (plugUnbornNat birth a y l) := by
              rw [hinord_pl, List.Ico.mem]
              omega
            rw [h_rot_left_not_mem u l y c hu_not_l]
            conv_rhs => rw [plugUnbornNat]
            rw [h_rot_left_not_mem u (plugUnbornNat birth a y l) y _ hu_not_pl]
            rfl
          · have huy : u < y := by omega
            have hu_l : u ∈ inorderNat l := by
              rw [inorderNat, List.mem_append, List.mem_append, List.mem_singleton] at hu
              rcases hu with (hul | rfl) | huc
              · exact hul
              · omega
              · have := (h_forall_inord _ c).mp hc_gt u huc
                omega
            rcases l with _ | ⟨x, la, lb⟩
            · simp [inorderNat] at hu_l
            · by_cases hxu : x = u
              · subst hxu
                simp [rotateRightOnLeftSpine, plugUnbornNat]
              · have hl_in : ∀ k ∈ inorderNat (.node x la lb), a ≤ k ∧ k < y := fun k hk =>
                  ⟨(hinordG k (h_inord_left (.node x la lb) y c k hk)).1,
                    (h_forall_inord _ (.node x la lb)).mp hl_lt k hk⟩
                have h_ih := ihl a y u hy_in.1 hbst_l hl_in hu_l
                have h_lhs :
                    plugUnbornNat birth a b (rotateRightOnLeftSpine u (.node y (.node x la lb) c)) =
                      .node y (plugUnbornNat birth a y (rotateRightOnLeftSpine u (.node x la lb)))
                        (plugUnbornNat birth (y + 1) b c) := by
                  simp [rotateRightOnLeftSpine, hxu, plugUnbornNat]
                have h_rhs :
                    rotateRightOnLeftSpine u (plugUnbornNat birth a b (.node y (.node x la lb) c)) =
                      .node y (rotateRightOnLeftSpine u (plugUnbornNat birth a y (.node x la lb)))
                        (plugUnbornNat birth (y + 1) b c) := by
                  simp [plugUnbornNat, rotateRightOnLeftSpine, hxu]
                rw [h_lhs, h_rhs, h_ih]
    have h_rot_foldl :
        ∀ (us : List ℕ) (G : _root_.BinaryTree ℕ),
          _root_.BinaryTree.IsBST G → (∀ k ∈ inorderNat G, lo ≤ k ∧ k < hi) →
          (∀ u ∈ us, u ∈ inorderNat G) →
            plugUnbornNat birth lo hi (us.foldl (fun T u => rotateRightOnLeftSpine u T) G) =
              us.foldl (fun T u => rotateRightOnLeftSpine u T) (plugUnbornNat birth lo hi G) := by
      intro us
      induction us with
      | nil =>
        intro G _ _ _
        rfl
      | cons u rest ih =>
        intro G hbstG hinordG hus
        have hu : u ∈ inorderNat G := hus u (by simp)
        obtain ⟨hbstG', hinordG'⟩ := h_rot_bst_inord G u hbstG
        simp only [List.foldl_cons]
        rw [← h_rot_one G lo hi u hlo hbstG hinordG hu]
        refine ih (rotateRightOnLeftSpine u G) hbstG' ?_ ?_
        · rw [hinordG']
          exact hinordG
        · intro v hv
          rw [hinordG']
          exact hus v (List.mem_cons_of_mem u hv)
    exact ⟨h_plug_bst_inord birth F lo hi hlo hbst hinord,
      fun v hv => h_lcrs_aux F lo hi P0 v hbst hv,
      fun m0 hm0 => h_ls_plug F lo hi m0 hm0,
      fun hhead => h_splice_plug F hi hhead,
      fun us hus => h_rot_foldl us F hbst hinord hus⟩

  have h_bst_props :
      ∀ T : _root_.BinaryTree ℕ, _root_.BinaryTree.IsBST T →
        List.Pairwise (· < ·) (inorderNat T) ∧
          List.Pairwise (· < ·) (leftSpineBottomUpNat T) ∧
          (leftSpineBottomUpNat T).head? = (inorderNat T).head? ∧
          (∀ u ∈ leftSpineBottomUpNat T, u ∈ inorderNat T) := by
    intro T
    induction T with
    | nil =>
      intro _
      simp [inorderNat, leftSpineBottomUpNat, leftSpineBottomUpAux]
    | node k l r ihl ihr =>
      intro hbst
      cases hbst using isBSTCases with
      | node _ _ _ hl_lt hr_gt hbst_l hbst_r =>
        obtain ⟨hpl_in, hpl_ls, hhead_l, hsub_l⟩ := ihl hbst_l
        obtain ⟨hpr_in, _, _, _⟩ := ihr hbst_r
        have hl_lt' := (h_forall_inord _ l).mp hl_lt
        have hr_gt' := (h_forall_inord _ r).mp hr_gt
        have hsub : ∀ u ∈ leftSpineBottomUpNat (.node k l r), u ∈ inorderNat (.node k l r) := by
          intro u hu
          rw [h_ls_node, List.mem_append, List.mem_singleton] at hu
          rcases hu with hul | huk
          · exact h_inord_left l k r u (hsub_l u hul)
          · rw [huk]
            exact h_inord_key l k r
        have hp_in : List.Pairwise (· < ·) (inorderNat (.node k l r)) := by
          rw [inorderNat, List.append_assoc, List.singleton_append, List.pairwise_append]
          refine ⟨hpl_in, List.Pairwise.cons hr_gt' hpr_in, ?_⟩
          intro a ha b hb
          have hak := hl_lt' a ha
          simp only [List.mem_cons] at hb
          rcases hb with rfl | hbr
          · exact hak
          · have := hr_gt' b hbr
            omega
        have hp_ls : List.Pairwise (· < ·) (leftSpineBottomUpNat (.node k l r)) := by
          rw [h_ls_node, List.pairwise_append]
          refine ⟨hpl_ls, by simp, ?_⟩
          intro a ha b hb
          simp only [List.mem_singleton] at hb
          subst hb
          exact hl_lt' a (hsub_l a ha)
        have hhead :
            (leftSpineBottomUpNat (.node k l r)).head? = (inorderNat (.node k l r)).head? := by
          rcases l with _ | ⟨lk, ll, lr⟩
          · rw [h_ls_node]
            simp [leftSpineBottomUpNat, leftSpineBottomUpAux, inorderNat]
          · obtain ⟨hne_ls, hne_in⟩ := h_nonempty_lists (.node lk ll lr) (by simp)
            rw [h_ls_node, List.head?_append_of_ne_nil _ hne_ls]
            conv_rhs => rw [inorderNat, List.append_assoc]
            rw [List.head?_append_of_ne_nil _ hne_in]
            exact hhead_l
        exact ⟨hp_in, hp_ls, hhead, hsub⟩

  have h_splice_props :
      ∀ T : _root_.BinaryTree ℕ, _root_.BinaryTree.IsBST T →
        _root_.BinaryTree.IsBST (spliceMinNat T) ∧
          inorderNat (spliceMinNat T) = (inorderNat T).tail ∧
          (∃ r_ls : List ℕ,
            leftSpineBottomUpNat (spliceMinNat T) = r_ls ++ (leftSpineBottomUpNat T).tail) ∧
          (∀ P0 s v : ℕ, (inorderNat T).head? = some s → s < v →
            lcrsParent P0 (spliceMinNat T) v = lcrsParent P0 T v) := by
    have h_lcrs_splice :
        ∀ (T : _root_.BinaryTree ℕ) (P0 curP s v : ℕ),
          _root_.BinaryTree.IsBST T → (inorderNat T).head? = some s → s < v →
            lcrsParentAux P0 curP v (spliceMinNat T) = lcrsParentAux P0 curP v T := by
      intro T
      induction T with
      | nil =>
        intro _ _ _ _ _ hmin _
        simp [inorderNat] at hmin
      | node k l r ihl _ =>
        intro P0 curP s v hbst hmin hsv
        have hbst_l : _root_.BinaryTree.IsBST l := by cases hbst using isBSTCases; assumption
        rcases l with _ | ⟨lk, ll, lr⟩
        · simp [inorderNat] at hmin
          subst hmin
          have hnot_vk : ¬ (v < k) := by omega
          simp [spliceMinNat, lcrsParentAux, hnot_vk, hsv]
        · have hne_in : inorderNat (.node lk ll lr) ≠ [] :=
            (h_nonempty_lists (.node lk ll lr) (by simp)).2
          rw [inorderNat, List.append_assoc, List.head?_append_of_ne_nil _ hne_in] at hmin
          simp only [spliceMinNat, lcrsParentAux]
          by_cases hvk : v < k
          · simp only [hvk, ↓reduceIte]
            exact ihl P0 k s v hbst_l hmin hsv
          · simp only [hvk, ↓reduceIte]
    intro T
    induction T with
    | nil =>
      intro hbst
      refine ⟨by simpa [spliceMinNat] using hbst,
        by simp [spliceMinNat, inorderNat],
        ⟨[], by simp [spliceMinNat, leftSpineBottomUpNat, leftSpineBottomUpAux]⟩, ?_⟩
      intro P0 s v _ _
      simp [spliceMinNat]
    | node k l r ihl _ =>
      intro hbst
      have hl_lt : _root_.SplayDeque.Direct.ForallTree (fun x => x < k) l := by cases hbst using isBSTCases; assumption
      have hr_gt : _root_.SplayDeque.Direct.ForallTree (fun x => k < x) r := by cases hbst using isBSTCases; assumption
      have hbst_l : _root_.BinaryTree.IsBST l := by cases hbst using isBSTCases; assumption
      have hbst_r : _root_.BinaryTree.IsBST r := by cases hbst using isBSTCases; assumption
      rcases l with _ | ⟨lk, ll, lr⟩
      · refine ⟨by simpa [spliceMinNat] using hbst_r, ?_, ⟨leftSpineBottomUpNat r, ?_⟩, ?_⟩
        · simp [spliceMinNat, inorderNat]
        · rw [h_ls_node]
          simp [spliceMinNat, leftSpineBottomUpNat, leftSpineBottomUpAux]
        · intro P0 s v hmin hsv
          exact h_lcrs_splice (.node k .nil r) P0 P0 s v hbst hmin hsv
      · obtain ⟨hbst_sl, hinord_sl, ⟨r_ls, hls_sl⟩, _⟩ := ihl hbst_l
        obtain ⟨hne_ls, hne_in⟩ := h_nonempty_lists (.node lk ll lr) (by simp)
        have hsl_lt : _root_.SplayDeque.Direct.ForallTree (fun x => x < k) (spliceMinNat (.node lk ll lr)) := by
          rw [h_forall_inord, hinord_sl]
          intro x hx
          exact (h_forall_inord _ _).mp hl_lt x (List.mem_of_mem_tail hx)
        have hsp_eq : spliceMinNat (.node k (.node lk ll lr) r) =
            .node k (spliceMinNat (.node lk ll lr)) r := by
          simp [spliceMinNat]
        rw [hsp_eq]
        refine ⟨_root_.BinaryTree.IsBST.node k _ r hsl_lt hr_gt hbst_sl hbst_r, ?_, ⟨r_ls, ?_⟩, ?_⟩
        · conv_lhs => rw [inorderNat, List.append_assoc]
          conv_rhs => rw [inorderNat, List.append_assoc]
          rw [hinord_sl, List.tail_append_of_ne_nil hne_in]
        · rw [h_ls_node, h_ls_node, hls_sl, List.append_assoc, List.tail_append_of_ne_nil hne_ls]
        · intro P0 s v hmin hsv
          rw [← hsp_eq]
          exact h_lcrs_splice (.node k (.node lk ll lr) r) P0 P0 s v hbst hmin hsv

  have h_snoc_inj :
      ∀ (xs ys : List ℕ) (a b : ℕ), xs ++ [a] = ys ++ [b] → xs = ys ∧ a = b := by
    intro xs ys a b h
    have hlen : xs.length = ys.length := by
      have := congrArg List.length h
      simp at this
      omega
    obtain ⟨h1, h2⟩ := List.append_inj h hlen
    exact ⟨h1, by simpa using h2⟩

  have h_rot_evict :
      ∀ (T : _root_.BinaryTree ℕ) (u y : ℕ) (pre suf : List ℕ),
        _root_.BinaryTree.IsBST T →
        leftSpineBottomUpNat T = pre ++ u :: y :: suf →
          leftSpineBottomUpNat (rotateRightOnLeftSpine u T) = pre ++ u :: suf := by
    intro T u y pre
    induction T with
    | nil =>
      intro suf _ h
      have := congrArg List.length h
      simp [leftSpineBottomUpNat, leftSpineBottomUpAux] at this
    | node k l r ihl _ =>
      intro suf hbst hls
      rcases l with _ | ⟨x, a, b⟩
      · rw [h_ls_node] at hls
        have := congrArg List.length hls
        simp [leftSpineBottomUpNat, leftSpineBottomUpAux] at this
        omega
      · have hp_ls := (h_bst_props (.node k (.node x a b) r) hbst).2.1
        rw [hls, List.pairwise_append] at hp_ls
        have hp_uys : List.Pairwise (· < ·) (u :: y :: suf) := hp_ls.2.1
        rw [List.pairwise_cons] at hp_uys
        have huy : u < y := hp_uys.1 y (by simp)
        have hp_ys := hp_uys.2
        rw [List.pairwise_cons] at hp_ys
        have hy_suf : ∀ z ∈ suf, y < z := hp_ys.1
        cases hbst using isBSTCases with
        | node _ _ _ _ _ hbst_l _ =>
          rw [h_ls_node, h_ls_node] at hls
          induction suf using List.reverseRecOn with
          | nil =>
            have h1 : (leftSpineBottomUpNat a ++ [x]) ++ [k] = (pre ++ [u]) ++ [y] := by
              simpa [List.append_assoc] using hls
            obtain ⟨h2, rfl⟩ := h_snoc_inj _ _ _ _ h1
            obtain ⟨rfl, rfl⟩ := h_snoc_inj _ _ _ _ h2
            simp only [rotateRightOnLeftSpine, ↓reduceIte, h_ls_node]
          | append_singleton suf_init last _ =>
            have h1 : (leftSpineBottomUpNat a ++ [x]) ++ [k] =
                (pre ++ u :: y :: suf_init) ++ [last] := by
              simpa [List.append_assoc] using hls
            obtain ⟨h2, rfl⟩ := h_snoc_inj _ _ _ _ h1
            have hxu : x ≠ u := by
              cases suf_init using List.reverseRecOn with
              | nil =>
                have h3 : leftSpineBottomUpNat a ++ [x] = (pre ++ [u]) ++ [y] := by
                  simpa [List.append_assoc] using h2
                obtain ⟨_, rfl⟩ := h_snoc_inj _ _ _ _ h3
                omega
              | append_singleton s0 z =>
                have h3 : leftSpineBottomUpNat a ++ [x] = (pre ++ u :: y :: s0) ++ [z] := by
                  simpa [List.append_assoc] using h2
                obtain ⟨_, rfl⟩ := h_snoc_inj _ _ _ _ h3
                have hyx : y < x := hy_suf x (by simp)
                omega
            have hls_l : leftSpineBottomUpNat (.node x a b) = pre ++ u :: y :: suf_init := by
              rw [h_ls_node]
              exact h2
            simp only [rotateRightOnLeftSpine, hxu, ↓reduceIte]
            rw [h_ls_node, ihl suf_init hbst_l hls_l]
            simp [List.append_assoc]

  have h_rot_lcrs_step :
      ∀ (T : _root_.BinaryTree ℕ) (P0 curP u v : ℕ),
        _root_.BinaryTree.IsBST T → (∀ k ∈ inorderNat T, k < curP) →
          lcrsParentAux P0 curP v T ≤ lcrsParentAux P0 curP v (rotateRightOnLeftSpine u T) := by
    intro T P0
    induction T with
    | nil =>
      intro _ _ _ _ _
      exact le_rfl
    | node y l c ihl _ =>
      intro curP u v hbst hlt
      cases hbst using isBSTCases with
      | node _ _ _ hl_lt _ hbst_l _ =>
        rcases l with _ | ⟨x, a, b⟩
        · exact le_rfl
        · have hy_cur : y < curP := hlt y (h_inord_key (.node x a b) y c)
          have hxy : x < y := (h_forall_inord _ (.node x a b)).mp hl_lt x (h_inord_key a x b)
          by_cases hxu : x = u
          · subst hxu
            simp only [rotateRightOnLeftSpine, ↓reduceIte, lcrsParentAux]
            by_cases hvx : v < x
            · have hvy : v < y := by omega
              simp [hvx, hvy]
            · by_cases hxv : x < v
              · by_cases hvy : v < y
                · simp [hvx, hxv, hvy]
                · by_cases hyv : y < v
                  · simp [hvx, hxv, hvy, hyv]
                  · have hveqy : v = y := by omega
                    subst hveqy
                    have hnot_yx : ¬ (v < x) := by omega
                    simp [hnot_yx, hxy]
              · have hveqx : v = x := by omega
                subst hveqx
                simp [hxy]
                omega
          · simp only [rotateRightOnLeftSpine, hxu, ↓reduceIte, lcrsParentAux]
            by_cases hvy : v < y
            · simp only [hvy, ↓reduceIte]
              exact ihl y u v hbst_l ((h_forall_inord _ (.node x a b)).mp hl_lt)
            · simp only [hvy, ↓reduceIte]
              exact le_rfl

  have h_s2_part3 :
      ∀ T : _root_.BinaryTree ℕ, _root_.BinaryTree.IsBST T →
        (∀ u : ℕ,
          _root_.BinaryTree.IsBST (rotateRightOnLeftSpine u T) ∧
            inorderNat (rotateRightOnLeftSpine u T) = inorderNat T) ∧
        (∀ (u y : ℕ) (pre suf : List ℕ),
          leftSpineBottomUpNat T = pre ++ u :: y :: suf →
            leftSpineBottomUpNat (rotateRightOnLeftSpine u T) = pre ++ u :: suf) ∧
        (∀ P0 : ℕ, (∀ k ∈ inorderNat T, k < P0) →
          (∀ (us : List ℕ) (v : ℕ),
            lcrsParent P0 T v ≤
              lcrsParent P0 (us.foldl (fun G u => rotateRightOnLeftSpine u G) T) v) ∧
          (∀ (w N v : ℕ),
            lcrsParent P0 T v ≤ lcrsParent P0 ((rotateRightOnLeftSpine w)^[N] T) v)) ∧
        (∀ (t s : ℕ) (ls pre0 suf0 : List ℕ),
          ls ≠ [] →
          leftSpineBottomUpNat T = pre0 ++ ls.tail ++ suf0 →
          let js := popJumpsAt 0 t s ls
          ∀ j (hj : j < js.length),
            let Tj := (js.take j).foldl (fun G e => rotateRightOnLeftSpine e.x G) T
            _root_.BinaryTree.IsBST Tj ∧
              ∃ pre suf, leftSpineBottomUpNat Tj = pre ++ (js[j]'hj).x :: (js[j]'hj).y :: suf) := by
    have h_foldl_mono :
        ∀ (us : List ℕ) (G : _root_.BinaryTree ℕ) (P0 v : ℕ),
          _root_.BinaryTree.IsBST G → (∀ k ∈ inorderNat G, k < P0) →
            lcrsParent P0 G v ≤
              lcrsParent P0 (us.foldl (fun H u => rotateRightOnLeftSpine u H) G) v := by
      intro us
      induction us with
      | nil =>
        intro _ _ _ _ _
        exact le_rfl
      | cons u rest ih =>
        intro G P0 v hbstG hltG
        simp only [List.foldl_cons]
        obtain ⟨hbstG', hinordG'⟩ := h_rot_bst_inord G u hbstG
        have hstep := h_rot_lcrs_step G P0 P0 u v hbstG hltG
        have hrest := ih (rotateRightOnLeftSpine u G) P0 v hbstG' (by rw [hinordG']; exact hltG)
        exact le_trans hstep hrest
    have h_iter_bst :
        ∀ (N w : ℕ) (G : _root_.BinaryTree ℕ),
          _root_.BinaryTree.IsBST G →
            _root_.BinaryTree.IsBST ((rotateRightOnLeftSpine w)^[N] G) ∧
              inorderNat ((rotateRightOnLeftSpine w)^[N] G) = inorderNat G := by
      intro N w G hbstG
      induction N with
      | zero => exact ⟨hbstG, rfl⟩
      | succ n ih =>
        rw [Function.iterate_succ_apply']
        obtain ⟨hbst_n, hinord_n⟩ := ih
        obtain ⟨hbst_n1, hinord_n1⟩ := h_rot_bst_inord _ w hbst_n
        exact ⟨hbst_n1, hinord_n1.trans hinord_n⟩
    have h_iter_mono :
        ∀ (N w P0 v : ℕ) (G : _root_.BinaryTree ℕ),
          _root_.BinaryTree.IsBST G → (∀ k ∈ inorderNat G, k < P0) →
            lcrsParent P0 G v ≤ lcrsParent P0 ((rotateRightOnLeftSpine w)^[N] G) v := by
      intro N w P0 v G hbstG hltG
      induction N with
      | zero => exact le_rfl
      | succ n ih =>
        rw [Function.iterate_succ_apply']
        obtain ⟨hbst_n, hinord_n⟩ := h_iter_bst n w G hbstG
        have hstep := h_rot_lcrs_step ((rotateRightOnLeftSpine w)^[n] G) P0 P0 w v hbst_n
          (by rw [hinord_n]; exact hltG)
        exact le_trans ih hstep
    intro T hbstT
    refine ⟨fun u => h_rot_bst_inord T u hbstT,
      fun u y pre suf hls => h_rot_evict T u y pre suf hbstT hls,
      fun P0 hltP => ⟨fun us v => h_foldl_mono us T P0 v hbstT hltP,
        fun w N v => h_iter_mono N w P0 v T hbstT hltP⟩,
      ?_⟩
    intro t s ls pre0 suf0 _ hls_init js
    have hjs_len : js.length = (ls.length - 2) / 2 := by
      simp [js, popJumpsAt]
    have h_inv :
        ∀ j ≤ js.length,
          let Tj := (js.take j).foldl (fun G e => rotateRightOnLeftSpine e.x G) T
          _root_.BinaryTree.IsBST Tj ∧
            leftSpineBottomUpNat Tj =
              (pre0 ++ (List.range j).map (fun i => ls.getD (2 * i + 1) 0)) ++
                ls.drop (2 * j + 1) ++ suf0 := by
      intro j
      induction j with
      | zero =>
        intro _
        simp only [List.take_zero, List.foldl_nil, List.range_zero, List.map_nil,
          List.append_nil, Nat.mul_zero, Nat.zero_add, List.drop_one]
        exact ⟨hbstT, hls_init⟩
      | succ j ih =>
        intro hj_le
        have hj_lt : j < js.length := Nat.lt_of_succ_le hj_le
        obtain ⟨hbst_j, hls_j⟩ := ih (le_of_lt hj_lt)
        have h2j2 : 2 * j + 2 < ls.length := by omega
        have h2j1 : 2 * j + 1 < ls.length := by omega
        have hget1 : ls.getD (2 * j + 1) 0 = ls[2 * j + 1] := by
          rw [List.getD_eq_getElem?_getD, List.getElem?_eq_getElem h2j1]
          rfl
        have hget2 : ls.getD (2 * j + 2) 0 = ls[2 * j + 2] := by
          rw [List.getD_eq_getElem?_getD, List.getElem?_eq_getElem h2j2]
          rfl
        have hdrop :
            ls.drop (2 * j + 1) =
              ls.getD (2 * j + 1) 0 :: ls.getD (2 * j + 2) 0 :: ls.drop (2 * j + 3) := by
          rw [List.drop_eq_getElem_cons h2j1, List.drop_eq_getElem_cons h2j2, hget1, hget2]
        have hjsx : (js[j]'hj_lt).x = ls.getD (2 * j + 1) 0 := by
          simp [js, popJumpsAt]
        set Tj := (js.take j).foldl (fun G e => rotateRightOnLeftSpine e.x G) T
        have htake : js.take (j + 1) = js.take j ++ [js[j]'hj_lt] :=
          List.take_succ_eq_append_getElem hj_lt
        have hfold_step :
            (js.take (j + 1)).foldl (fun G e => rotateRightOnLeftSpine e.x G) T =
              rotateRightOnLeftSpine (ls.getD (2 * j + 1) 0) Tj := by
          rw [htake, List.foldl_append, List.foldl_cons, List.foldl_nil, hjsx]
        rw [hfold_step]
        refine ⟨(h_rot_bst_inord Tj _ hbst_j).1, ?_⟩
        have hls_j' :
            leftSpineBottomUpNat Tj =
              (pre0 ++ (List.range j).map (fun i => ls.getD (2 * i + 1) 0)) ++
                ls.getD (2 * j + 1) 0 :: ls.getD (2 * j + 2) 0 ::
                  (ls.drop (2 * j + 3) ++ suf0) := by
          rw [hls_j, hdrop]
          simp [List.append_assoc]
        rw [h_rot_evict Tj _ _ _ _ hbst_j hls_j']
        have h2j3 : 2 * (j + 1) + 1 = 2 * j + 3 := by omega
        rw [List.range_succ, List.map_append, List.map_singleton, h2j3]
        simp [List.append_assoc]
    intro j hj
    obtain ⟨hbst_j, hls_j⟩ := h_inv j (le_of_lt hj)
    have h2j2 : 2 * j + 2 < ls.length := by omega
    have h2j1 : 2 * j + 1 < ls.length := by omega
    have hget1 : ls.getD (2 * j + 1) 0 = ls[2 * j + 1] := by
      rw [List.getD_eq_getElem?_getD, List.getElem?_eq_getElem h2j1]
      rfl
    have hget2 : ls.getD (2 * j + 2) 0 = ls[2 * j + 2] := by
      rw [List.getD_eq_getElem?_getD, List.getElem?_eq_getElem h2j2]
      rfl
    have hdrop :
        ls.drop (2 * j + 1) =
          (js[j]'hj).x :: (js[j]'hj).y :: ls.drop (2 * j + 3) := by
      have hx : (js[j]'hj).x = ls.getD (2 * j + 1) 0 := by simp [js, popJumpsAt]
      have hy : (js[j]'hj).y = ls.getD (2 * j + 2) 0 := by simp [js, popJumpsAt]
      rw [hx, hy, List.drop_eq_getElem_cons h2j1, List.drop_eq_getElem_cons h2j2, hget1, hget2]
    refine ⟨hbst_j, pre0 ++ (List.range j).map (fun i => ls.getD (2 * i + 1) 0),
      ls.drop (2 * j + 3) ++ suf0, ?_⟩
    rw [hls_j, hdrop]
    simp [List.append_assoc]

  have h_s3 :
      ∀ (birth : ℕ → ℕ) (P0 lo w : ℕ) (H : _root_.BinaryTree ℕ),
        _root_.BinaryTree.IsBST H →
        _root_.SplayDeque.Direct.ForallTree (fun k => w < k ∧ k < P0) H →
        lo ≤ w → w < P0 →
        (∀ k, lo ≤ k → k < P0 → _root_.SplayDeque.Direct.ForallTree (fun z => k < z) H → k ≠ w →
          birth w < birth k) →
        ∃ N : ℕ,
          plugUnbornNat birth lo P0 (insertPushFolded (foldBST P0 H).2 w (foldBST P0 H).1) =
            (rotateRightOnLeftSpine w)^[N] (plugUnbornNat birth lo P0 (foldBST P0 H).1) := by
    intro birth P0 lo w H hbst hbounds hlo_w hw_P hmin_birth
    have h_fuel_irrel :
        ∀ (f1 f2 a b : ℕ), b - a ≤ f1 → b - a ≤ f2 →
          cartesianRangeAux birth f1 a b = cartesianRangeAux birth f2 a b := by
      intro f1
      induction f1 with
      | zero =>
        intro f2 a b hf1 _
        have hnot : ¬ (a < b) := by omega
        rcases f2 with _ | f2' <;> simp [cartesianRangeAux, hnot]
      | succ f1 ih =>
        intro f2 a b hf1 hf2
        by_cases hlt : a < b
        · rcases f2 with _ | f2'
          · omega
          · simp only [cartesianRangeAux, hlt, ↓reduceIte]
            set m := min (max a (minBirthKey birth a b)) (b - 1)
            have ham : a ≤ m := by omega
            have hmb : m < b := by omega
            rw [ih f2' a m (by omega) (by omega), ih f2' (m + 1) b (by omega) (by omega)]
        · rcases f2 with _ | f2' <;> simp [cartesianRangeAux, hlt]
    have h_cart_split :
        ∀ (m0 : ℕ), lo ≤ w → w < m0 →
          (∀ k, lo ≤ k → k < m0 → k ≠ w → birth w < birth k) →
          cartesianRangeNat birth lo m0 =
            .node w (cartesianRangeNat birth lo w) (cartesianRangeNat birth (w + 1) m0) := by
      intro m0 hlw hwm0 hm
      let step : ℕ → ℕ → ℕ := fun best k => if birth k < birth best then k else best
      have h_stay :
          ∀ (xs : List ℕ), (∀ k ∈ xs, lo ≤ k ∧ k < m0 ∧ k ≠ w) → xs.foldl step w = w := by
        intro xs
        induction xs with
        | nil => intro _; rfl
        | cons k rest ih =>
          intro hxs
          obtain ⟨hkl, hkm0, hkw⟩ := hxs k (by simp)
          have hbw : birth w < birth k := hm k hkl hkm0 hkw
          have hnot : ¬ (birth k < birth w) := by omega
          simp only [List.foldl_cons, step, hnot, ↓reduceIte]
          exact ih (fun x hx => hxs x (List.mem_cons_of_mem k hx))
      have h_lt_w :
          ∀ (xs : List ℕ) (acc : ℕ),
            lo ≤ acc → acc < w → (∀ k ∈ xs, lo ≤ k ∧ k < w) →
              lo ≤ xs.foldl step acc ∧ xs.foldl step acc < w := by
        intro xs
        induction xs with
        | nil =>
          intro acc h1 h2 _
          exact ⟨h1, h2⟩
        | cons k rest ih =>
          intro acc h1 h2 hxs
          obtain ⟨hkl, hkw⟩ := hxs k (by simp)
          simp only [List.foldl_cons]
          by_cases hcmp : birth k < birth acc
          · simp only [step, hcmp, ↓reduceIte]
            exact ih k hkl hkw (fun x hx => hxs x (List.mem_cons_of_mem k hx))
          · simp only [step, hcmp, ↓reduceIte]
            exact ih acc h1 h2 (fun x hx => hxs x (List.mem_cons_of_mem k hx))
      have h_mbk : minBirthKey birth lo m0 = w := by
        change (List.Ico (lo + 1) m0).foldl step lo = w
        by_cases h_eq : w = lo
        · subst h_eq
          refine h_stay (List.Ico (w + 1) m0) ?_
          intro k hk
          rw [List.Ico.mem] at hk
          exact ⟨by omega, hk.2, by omega⟩
        · have hlt_lw : lo < w := by omega
          rw [← List.Ico.append_consecutive (by omega : lo + 1 ≤ w) (le_of_lt hwm0),
            List.Ico.eq_cons hwm0, List.foldl_append, List.foldl_cons]
          set best0 := (List.Ico (lo + 1) w).foldl step lo
          have hb0 : lo ≤ best0 ∧ best0 < w := by
            refine h_lt_w (List.Ico (lo + 1) w) lo le_rfl hlt_lw ?_
            intro k hk
            rw [List.Ico.mem] at hk
            exact ⟨by omega, hk.2⟩
          have hbw0 : birth w < birth best0 := hm best0 hb0.1 (by omega) (by omega)
          have hstep_w : step best0 w = w := by
            simp [step, hbw0]
          rw [hstep_w]
          refine h_stay (List.Ico (w + 1) m0) ?_
          intro k hk
          rw [List.Ico.mem] at hk
          exact ⟨by omega, hk.2, by omega⟩
      have hfuel_eq : m0 - lo = (m0 - lo - 1) + 1 := by omega
      have hlo_lt_m0 : lo < m0 := by omega
      unfold cartesianRangeNat
      conv_lhs => rw [hfuel_eq]
      simp only [cartesianRangeAux, hlo_lt_m0, ↓reduceIte, h_mbk]
      have hw_clamp : min (max lo w) (m0 - 1) = w := by omega
      rw [hw_clamp]
      congr 1
      · exact h_fuel_irrel (m0 - lo - 1) (w - lo) lo w (by omega) le_rfl
      · exact h_fuel_irrel (m0 - lo - 1) (m0 - (w + 1)) (w + 1) m0 (by omega) le_rfl
    have h_iter_lift :
        ∀ (n m : ℕ) (V0 Rm : _root_.BinaryTree ℕ),
          (∀ i < n, ∃ a x b, (rotateRightOnLeftSpine w)^[i] V0 = .node x a b ∧ w < x) →
          ∀ i ≤ n,
            (rotateRightOnLeftSpine w)^[i] (.node m V0 Rm) =
              .node m ((rotateRightOnLeftSpine w)^[i] V0) Rm := by
      intro n m V0 Rm hroot i
      induction i with
      | zero => intro _; rfl
      | succ i ih =>
        intro hi_le
        obtain ⟨a, x, b, hVi, hwx⟩ := hroot i (Nat.lt_of_succ_le hi_le)
        have hxw : x ≠ w := by omega
        rw [Function.iterate_succ_apply', ih (le_of_lt (Nat.lt_of_succ_le hi_le)), hVi]
        simp only [rotateRightOnLeftSpine, hxw, ↓reduceIte]
        rw [← hVi, ← Function.iterate_succ_apply' (rotateRightOnLeftSpine w) i V0]
    rcases H with _ | ⟨b0, l0, r0⟩
    · refine ⟨0, ?_⟩
      simp only [foldBST, insertPushFolded, plugUnbornNat, Function.iterate_zero_apply]
      refine (h_cart_split P0 hlo_w hw_P ?_).symm
      intro k hkl hkP hkw
      exact hmin_birth k hkl hkP _root_.SplayDeque.Direct.ForallTree.left hkw
    · cases hbst using isBSTCases with
      | node _ _ _ hl0_lt hr0_gt hbst_l0 _ =>
        cases hbounds with
        | node _ _ _ hl0_b hb0_b hr0_b =>
          have h_ins_frs :
              ∀ (r acc acc' : _root_.BinaryTree ℕ) (k : ℕ),
                insertPushFolded b0 w acc = acc' → k ≠ b0 →
                _root_.SplayDeque.Direct.ForallTree (fun z => b0 < z) r →
                  insertPushFolded b0 w (foldRightSpine acc k r) = foldRightSpine acc' k r := by
            intro r
            induction r with
            | nil =>
              intro acc acc' k hacc hk _
              simp [foldRightSpine, insertPushFolded, hk, hacc]
            | node k2 l2 r2 _ ihr2 =>
              intro acc acc' k hacc hk hr
              cases hr with
              | node _ _ _ _ hk2 hr2 =>
                have hk2_ne : k2 ≠ b0 := by omega
                simp only [foldRightSpine]
                refine ihr2 (.node k acc l2) (.node k acc' l2) k2 ?_ hk2_ne hr2
                simp [insertPushFolded, hk, hacc]
          have h_ins_eq :
              insertPushFolded b0 w (foldRightSpine l0 b0 r0) =
                foldRightSpine (.node w .nil l0) b0 r0 := by
            rcases r0 with _ | ⟨k2, l2, r2⟩
            · simp [foldRightSpine, insertPushFolded]
            · cases hr0_gt with
              | node _ _ _ _ hk2 hr2 =>
                simp only [foldRightSpine]
                exact h_ins_frs r2 (.node b0 l0 l2) (.node b0 (.node w .nil l0) l2) k2
                  (by simp [insertPushFolded]) (by omega) hr2
          have h_left_rot :
              ∀ (l : _root_.BinaryTree ℕ) (hi : ℕ),
                _root_.BinaryTree.IsBST l → w < hi → hi ≤ P0 →
                _root_.SplayDeque.Direct.ForallTree (fun k => w < k ∧ k < hi) l →
                (∀ k, lo ≤ k → k < hi → _root_.SplayDeque.Direct.ForallTree (fun z => k < z) l → k ≠ w →
                  birth w < birth k) →
                let Nl := leftSpineLen (eraseNatKeys l)
                let U0 := plugUnbornNat birth lo hi l
                (rotateRightOnLeftSpine w)^[Nl] U0 =
                  .node w (cartesianRangeNat birth lo w) (plugUnbornNat birth (w + 1) hi l) ∧
                (∀ i < Nl, ∃ a x b, (rotateRightOnLeftSpine w)^[i] U0 = .node x a b ∧ w < x) := by
            intro l
            induction l with
            | nil =>
              intro hi _ hwhi _ _ hmin_l
              refine ⟨?_, fun i hi0 => by simp [eraseNatKeys, leftSpineLen] at hi0⟩
              simp only [eraseNatKeys, leftSpineLen, Function.iterate_zero_apply, plugUnbornNat]
              exact h_cart_split hi hlo_w hwhi fun k h1 h2 h3 =>
                hmin_l k h1 h2 _root_.SplayDeque.Direct.ForallTree.left h3
            | node m ll rl ihll _ =>
              intro hi hbst_l _ hhiP hbounds_l hmin_l
              cases hbst_l using isBSTCases with
              | node _ _ _ hll_lt hrl_gt hbst_ll _ =>
                cases hbounds_l with
                | node _ _ _ hll_b hm_b _ =>
                  have hll_bounds : _root_.SplayDeque.Direct.ForallTree (fun k => w < k ∧ k < m) ll := by
                    rw [h_forall_inord]
                    intro k hk
                    exact ⟨((h_forall_inord _ ll).mp hll_b k hk).1,
                      (h_forall_inord _ ll).mp hll_lt k hk⟩
                  have hmin_ll :
                      ∀ k, lo ≤ k → k < m → _root_.SplayDeque.Direct.ForallTree (fun z => k < z) ll → k ≠ w →
                        birth w < birth k := by
                    intro k h1 h2 hk_ll hkw
                    refine hmin_l k h1 (by omega) ?_ hkw
                    refine _root_.SplayDeque.Direct.ForallTree.node ll m rl hk_ll h2 ?_
                    rw [h_forall_inord] at hrl_gt ⊢
                    intro z hz
                    have := hrl_gt z hz
                    omega
                  obtain ⟨h_ih_eq, h_ih_roots⟩ := ihll m hbst_ll hm_b.1 (by omega) hll_bounds hmin_ll
                  set Nll := leftSpineLen (eraseNatKeys ll)
                  set V0 := plugUnbornNat birth lo m ll
                  set Rm := plugUnbornNat birth (m + 1) hi rl
                  have hNl_eq : leftSpineLen (eraseNatKeys (.node m ll rl)) = Nll + 1 := by
                    simp [eraseNatKeys, leftSpineLen, Nll, Nat.add_comm]
                  have h_lift := h_iter_lift Nll m V0 Rm h_ih_roots
                  refine ⟨?_, ?_⟩
                  · change (rotateRightOnLeftSpine w)^[leftSpineLen (eraseNatKeys (.node m ll rl))]
                      (.node m V0 Rm) = _
                    rw [hNl_eq, Function.iterate_succ_apply', h_lift Nll le_rfl, h_ih_eq]
                    simp [rotateRightOnLeftSpine, plugUnbornNat, Rm]
                  · intro i hi_lt
                    rw [hNl_eq] at hi_lt
                    change ∃ a x b, (rotateRightOnLeftSpine w)^[i] (.node m V0 Rm) = .node x a b ∧ w < x
                    rw [h_lift i (by omega)]
                    exact ⟨_, m, Rm, rfl, hm_b.1⟩
          have hl0_bounds : _root_.SplayDeque.Direct.ForallTree (fun k => w < k ∧ k < b0) l0 := by
            rw [h_forall_inord]
            intro k hk
            exact ⟨((h_forall_inord _ l0).mp hl0_b k hk).1,
              (h_forall_inord _ l0).mp hl0_lt k hk⟩
          have hmin_l0 :
              ∀ k, lo ≤ k → k < b0 → _root_.SplayDeque.Direct.ForallTree (fun z => k < z) l0 → k ≠ w →
                birth w < birth k := by
            intro k h1 h2 hk_l0 hkw
            refine hmin_birth k h1 (by omega) ?_ hkw
            refine _root_.SplayDeque.Direct.ForallTree.node l0 b0 r0 hk_l0 h2 ?_
            rw [h_forall_inord] at hr0_gt ⊢
            intro z hz
            have := hr0_gt z hz
            omega
          obtain ⟨h_l0_eq, h_l0_roots⟩ := h_left_rot l0 b0 hbst_l0 hb0_b.1 (le_of_lt hb0_b.2)
            hl0_bounds hmin_l0
          set N := leftSpineLen (eraseNatKeys l0)
          have h_frs_lift :
              ∀ (r acc1 acc2 : _root_.BinaryTree ℕ) (k : ℕ),
                w < k → _root_.SplayDeque.Direct.ForallTree (fun z => w < z) r →
                plugUnbornNat birth lo k acc2 =
                  (rotateRightOnLeftSpine w)^[N] (plugUnbornNat birth lo k acc1) →
                (∀ i < N, ∃ a x b,
                  (rotateRightOnLeftSpine w)^[i] (plugUnbornNat birth lo k acc1) = .node x a b ∧
                  w < x) →
                plugUnbornNat birth lo P0 (foldRightSpine acc2 k r) =
                  (rotateRightOnLeftSpine w)^[N]
                    (plugUnbornNat birth lo P0 (foldRightSpine acc1 k r)) := by
            intro r
            induction r with
            | nil =>
              intro acc1 acc2 k _ _ hacc hroots
              simp only [foldRightSpine, plugUnbornNat]
              rw [h_iter_lift N k _ _ hroots N le_rfl, hacc]
            | node k2 l2 r2 _ ihr2 =>
              intro acc1 acc2 k hwk hr hacc hroots
              cases hr with
              | node _ _ _ _ hwk2 hr2 =>
                simp only [foldRightSpine]
                refine ihr2 (.node k acc1 l2) (.node k acc2 l2) k2 hwk2 hr2 ?_ ?_
                · simp only [plugUnbornNat]
                  rw [h_iter_lift N k _ _ hroots N le_rfl, hacc]
                · intro i hi
                  simp only [plugUnbornNat]
                  rw [h_iter_lift N k _ _ hroots i (le_of_lt hi)]
                  exact ⟨_, k, _, rfl, hwk⟩
          have hr0_w : _root_.SplayDeque.Direct.ForallTree (fun z => w < z) r0 := by
            rw [h_forall_inord] at hr0_b ⊢
            intro z hz
            exact (hr0_b z hz).1
          refine ⟨N, ?_⟩
          simp only [foldBST, h_ins_eq]
          exact h_frs_lift r0 l0 (.node w .nil l0) b0 hb0_b.1 hr0_w
            (by simpa [plugUnbornNat] using h_l0_eq.symm) h_l0_roots

  have h_take_countP :
      ∀ (xs : List KeyedCoreOp) (i : ℕ),
        (xs.take i).countP isKeyedPop ≤ xs.countP isKeyedPop := by
    intro xs i
    have h := congrArg (List.countP isKeyedPop) (List.take_append_drop i xs)
    rw [List.countP_append] at h
    omega

  have h_popKeys_len :
      ∀ (xs : List KeyedCoreOp), xs.countP isKeyedPop = (popKeys xs).length := by
    intro xs
    induction xs with
    | nil => rfl
    | cons op rest ih =>
      rcases op with w | s | d <;> simp [popKeys, isKeyedPop, ih]

  have h_popIdx_bound : ∀ t ≤ kops.length, popIdx kops t ≤ P := by
    intro t _
    calc
      popIdx kops t ≤ kops.countP isKeyedPop := h_take_countP kops t
      _ = (popKeys kops).length := h_popKeys_len kops
      _ = (List.range P).length := by rw [hkvalid.pop_eq]
      _ = P := List.length_range

  have h_popIdx_mono : ∀ t1 t2, t1 ≤ t2 → popIdx kops t1 ≤ popIdx kops t2 := by
    intro t1 t2 ht
    have htake : (kops.take t2).take t1 = kops.take t1 := by
      rw [List.take_take, Nat.min_eq_left ht]
    unfold popIdx
    rw [← htake]
    exact h_take_countP (kops.take t2) t1

  have h_popIdx_nonpop :
      ∀ t (ht : t < kops.length),
        (∀ s, kops[t]'ht ≠ .pop s) → popIdx kops (t + 1) = popIdx kops t := by
    intro t ht hno
    unfold popIdx
    rw [List.take_succ_eq_append_getElem ht, List.countP_append]
    rcases h_op : kops[t]'ht with w | s | d
    · simp [isKeyedPop]
    · exact absurd h_op (hno s)
    · simp [isKeyedPop]

  have h_c9 :
      ∀ t (ht : t < kops.length) (s : ℕ),
        kops[t]'ht = .pop s →
          let ls := leftSpineBottomUpNat (keyedState kops t)
          let m := (ls.length - 2) / 2
          ∃ baseId,
            baseId + m ≤ (jumps kops).length ∧
              ∀ j < m,
                ∃ hid : baseId + j < (jumps kops).length,
                  let ej := (jumps kops)[baseId + j]'hid
                  ej.step = t ∧ ej.s = s ∧ ej.j = j ∧ ej.m = m ∧
                    ej.x = ls.getD (2 * j + 1) 0 ∧
                    ej.y = ls.getD (2 * j + 2) 0 ∧
                    ej.z = ls.getD (2 * j + 3) 0 := by
    intro t ht s h_op
    dsimp (config := { failIfUnchanged := false }) only
    set ls := leftSpineBottomUpNat (keyedState kops t)
    set m := (ls.length - 2) / 2
    obtain ⟨baseId, hbase_len, hbase_iff⟩ := hjump.pop_step_jumps t ht s h_op
    change baseId + m ≤ (jumps kops).length at hbase_len
    change ∀ id (hid : id < (jumps kops).length),
      (((jumps kops)[id]).step = t ↔ baseId ≤ id ∧ id < baseId + m) at hbase_iff
    refine ⟨baseId, hbase_len, ?_⟩
    have h_step_eq :
        ∀ j (hj : j < m), ((jumps kops)[baseId + j]'(by omega)).step = t := by
      intro j hj
      exact (hbase_iff (baseId + j) (by omega)).mpr ⟨by omega, by omega⟩
    let f : ℕ → ℕ := fun j =>
      if hj : j < m then ((jumps kops)[baseId + j]'(by omega)).j else j
    have hf_lt : ∀ j < m, f j < m := by
      intro j hj
      simp only [f, hj, ↓reduceDIte]
      have hanat := hjump.jump_anatomies (baseId + j) (by omega)
      dsimp (config := { failIfUnchanged := false }) only at hanat
      have hst := h_step_eq j hj
      have hm_eq : ((jumps kops)[baseId + j]'(by omega)).m = m := by
        have h1 := hanat.2.2.2.2.2.2.2.2.1.1
        rw [hst] at h1
        exact h1
      have hjm := hanat.2.2.2.1
      omega
    have hf_strict : ∀ j1 j2, j1 < j2 → j2 < m → f j1 < f j2 := by
      intro j1 j2 hj12 hj2
      have hj1 : j1 < m := by omega
      simp only [f, hj1, hj2, ↓reduceDIte]
      have hord := hjump.jump_order (baseId + j1) (by omega) (baseId + j2) (by omega) (by omega)
      rw [h_step_eq j1 hj1, h_step_eq j2 hj2] at hord
      rcases hord with hlt | ⟨_, hlt_j⟩
      · omega
      · exact hlt_j
    have hf_ge : ∀ j < m, j ≤ f j := by
      intro j
      induction j with
      | zero => intro _; omega
      | succ j ih =>
        intro hj1
        have := ih (by omega)
        have := hf_strict j (j + 1) (by omega) hj1
        omega
    have hf_le : ∀ k j, j < m → m - 1 - j = k → f j ≤ j := by
      intro k
      induction k with
      | zero =>
        intro j hj hk
        have hjeq : j = m - 1 := by omega
        have := hf_lt j hj
        omega
      | succ k ih =>
        intro j hj hk
        have hj1 : j + 1 < m := by omega
        have h1 := ih (j + 1) hj1 (by omega)
        have h2 := hf_strict j (j + 1) (by omega) hj1
        omega
    intro j hj
    have hid : baseId + j < (jumps kops).length := by omega
    refine ⟨hid, ?_⟩
    have hfj : f j = j := le_antisymm (hf_le (m - 1 - j) j hj rfl) (hf_ge j hj)
    have hej_j : ((jumps kops)[baseId + j]'hid).j = j := by
      simpa [f, hj] using hfj
    have hst : ((jumps kops)[baseId + j]'hid).step = t := h_step_eq j hj
    have hanat := hjump.jump_anatomies (baseId + j) hid
    dsimp (config := { failIfUnchanged := false }) only at hanat
    obtain ⟨_, _, hkop_s, _, _, _, _, _, ⟨hm_eq, _, hx_opt, hy_opt, hz_opt⟩, _⟩ := hanat
    rw [hst] at hkop_s hm_eq hx_opt hy_opt hz_opt
    rw [hej_j] at hx_opt hy_opt hz_opt
