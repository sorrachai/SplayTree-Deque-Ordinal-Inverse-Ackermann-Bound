        have hChildForce : ∀ k < 2 * mStar,
            C_q < alphaHierarchy qSub (S_seq k) ∧
            2 * S_seq (k + 1) ≤ (alphaHierarchy qSub (S_seq k)) ^ (6 ^ qSub) := by
          intro k hk
          have hkK : k < K := by omega
          have hcontr_k := (hseqStep k hkK).2
          have hWc_le : 4 * (1 + k) ^ 2 * W ≤ M_floor := by
