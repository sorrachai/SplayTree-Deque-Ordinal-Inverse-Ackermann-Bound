/-- **Lemma 6.1** (`lem:build-scale-tree`, Contraction and Empty-Return Bounds for
`BuildScaleTree`), parameterized by `lem_A_1_ack_basic`. -/
theorem lem_6_1_build_scale_tree_of_deps
    (h_A_1 :
      -- Part (1)
      ((∀ i j : ℕ, 1 ≤ j → j < ackermann i j) ∧
       (∀ i j₁ j₂ : ℕ, 1 ≤ j₁ → j₁ < j₂ → ackermann i j₁ < ackermann i j₂) ∧
       (∀ i j : ℕ, 1 ≤ i → 1 ≤ j →
         ackermann (i - 1) j ≤ ackermann i j ∧ 2 ^ j ≤ ackermann i j) ∧
       (∀ k : ℕ, 1 ≤ k → 2 ^ k ≤ ackermann k 1) ∧
       (∀ m n : ℕ, 1 ≤ m → m ≤ n → alpha0 m ≤ alpha0 n) ∧
       alpha0 1 = 1 ∧
       (∀ n : ℕ, 2 ≤ n →
         alpha0 n ≤ Nat.clog 2 n ∧ (alpha0 n : ℝ) < Real.logb 2 (n : ℝ) + 1) ∧
       (∀ n : ℕ, 3 ≤ n → alpha0 n < n)) ∧
      -- Part (2)
      ((∀ r k : ℕ, 1 ≤ k → 2 ^ k ≤ ackTower r k) ∧
       (∀ r k₁ k₂ : ℕ, 1 ≤ k₁ → k₁ < k₂ → ackTower r k₁ < ackTower r k₂) ∧
       (∀ r₁ r₂ k : ℕ, 1 ≤ r₁ → r₁ ≤ r₂ → 1 ≤ k → ackTower r₁ k ≤ ackTower r₂ k) ∧
       (∀ r m n : ℕ, 1 ≤ r → 1 ≤ m → m ≤ n → alphaHierarchy r m ≤ alphaHierarchy r n) ∧
       (∀ r n : ℕ, 1 ≤ r → 4 < n → alphaHierarchy r n < n) ∧
       (∀ r k n : ℕ, 1 ≤ r → 1 ≤ k → 1 ≤ n →
         (alphaHierarchy r n ≤ k ↔ n ≤ ackTower r k)) ∧
       (∀ n : ℕ, 1 ≤ n → alphaHierarchy 1 (2 * n) ≤ alphaHierarchy 1 n + 1) ∧
       (∀ r n : ℕ, 1 ≤ r → 1 ≤ n →
         alphaHierarchy r n ≤ alphaHierarchy 1 n ∧
         alphaHierarchy 1 n ≤ Nat.log 2 (Nat.log 2 (n + 16)) + 2 ∧
         (alphaHierarchy 1 n : ℝ) ≤ Real.logb 2 (Real.logb 2 ((n : ℝ) + 16)) + 2) ∧
       (∀ n : ℕ, 1 ≤ n → alphaOmega n = sInf {r : ℕ | 1 ≤ r ∧ n ≤ ackTower r 2})) ∧
      -- Part (3)
      ((∀ n : ℕ, 1 ≤ n → alpha0 (n + 2) ≤ alpha0 n + 1) ∧
       (∀ m u : ℕ, 1 ≤ m → 1 ≤ u →
         ((fun x : ℕ => alpha0 x + 1)^[m] u) ≤ (alpha0^[m] u) + 2) ∧
       (∀ u : ℕ, 5 ≤ u → alpha0 (2 ^ 20 * u ^ 6) ≤ alpha0 u + 1)))
    (r P : ℕ) (hr : 1 ≤ r) (hP : 1 ≤ P) :
    -- Part (1): Empty-return bound
    (∀ δ' W' S' : ℕ, δ' < r → 1 ≤ W' → 1 ≤ S' →
      (buildScaleTree r δ' W' S').1 = none →
      let q' := r - δ'
      let w := 2 * S'
      (buildScaleTree r δ' W' S').2 = S' ∧
      w < 4 ^ (q' + 1) * W' * (alpha0 w + 1) ^ 2) ∧
    -- Part (2): Degree-6 contraction and root structural validity
    (∀ δ W S_in : ℕ, δ < r → 1 ≤ W → 1 ≤ S_in →
      let q := r - δ
      let C_q := 2 ^ (36 ^ q)
      let S_out := (buildScaleTree r δ W S_in).2
      1 ≤ S_out ∧ S_out ≤ S_in ∧
      2 * S_out ≤ (max W (max (alphaHierarchy q S_in) C_q)) ^ (6 ^ q)) ∧
    (match buildScaleTreeRoot r P with
     | (none, S_out, M) => M = 0 ∧ S_out = P ∧ (buildScaleTree r 0 1 P).1 = none
     | (some T, S_out, M) =>
       1 ≤ M ∧ ValidScaleTree P r M T ∧
       scaleS T P M = S_out ∧ S_out = (buildScaleTree r 0 1 P).2) := by
  refine ⟨?_, ?_, ?_⟩
  · -- Part (1): Empty-return bound
    intro δ' W' S' hδ' hW' hS' hNone
    have hq' : 1 ≤ r - δ' := by omega
    have hMaster := buildScaleTreeAtQ_master_of_A1 h_A_1 (r - δ') hq' W' S' 0 hW' hS'
    have hCall : buildScaleTree r δ' W' S' =
        ((buildScaleTreeAtQ (r - δ') W' S' 0).1, (buildScaleTreeAtQ (r - δ') W' S' 0).2.1) := by
      unfold buildScaleTree buildScaleTreeCall
      simp [hδ']
    rw [hCall] at hNone ⊢
    dsimp only at hNone ⊢
    rcases hEq : buildScaleTreeAtQ (r - δ') W' S' 0 with ⟨τ?, S_out, M_out⟩
    rw [hEq] at hNone hMaster
    dsimp only at hNone hMaster ⊢
    subst hNone
    obtain ⟨⟨hSout, _, hBound⟩, _⟩ := hMaster
    exact ⟨hSout, hBound⟩
  · -- Part (2): Degree-6 contraction
    intro δ W S_in hδ hW hSin
    have hq : 1 ≤ r - δ := by omega
    have hMaster := buildScaleTreeAtQ_master_of_A1 h_A_1 (r - δ) hq W S_in 0 hW hSin
    have hCall : (buildScaleTree r δ W S_in).2 =
        (buildScaleTreeAtQ (r - δ) W S_in 0).2.1 := by
      unfold buildScaleTree buildScaleTreeCall
      simp [hδ]
    dsimp only
    rw [hCall]
    exact hMaster.2
  · -- Root structural validity
    have hMaster := buildScaleTreeAtQ_master_of_A1 h_A_1 r hr 1 P 0 le_rfl hP
    have hRootEq : buildScaleTreeRoot r P = buildScaleTreeAtQ r 1 P 0 := by
      unfold buildScaleTreeRoot buildScaleTreeCall
      have h0r : 0 < r := hr
      simp [h0r]
    have hTreeEq : buildScaleTree r 0 1 P =
        ((buildScaleTreeAtQ r 1 P 0).1, (buildScaleTreeAtQ r 1 P 0).2.1) := by
      unfold buildScaleTree buildScaleTreeCall
      have h0r : 0 < r := hr
      simp [h0r]
    rw [hRootEq]
    rcases hAtQ : buildScaleTreeAtQ r 1 P 0 with ⟨τ?, S_out, M⟩
    rw [hAtQ] at hMaster hTreeEq
    dsimp only at hMaster hTreeEq ⊢
    rcases τ? with _ | T
    · obtain ⟨⟨hSout, hM, _⟩, _⟩ := hMaster
      exact ⟨hM, hSout, by simp [hTreeEq]⟩
    · obtain ⟨⟨hMpos, hNE, hLen, hAddr, hSteps⟩, _⟩ := hMaster
      have hM1 : 1 ≤ M := by omega
      have hLenM : T.leafEntries.length = M := by omega
      have hLeaves : T.leaves = List.range' 1 M := by
        unfold ScaleTree.leaves
        rw [ValidScaleSteps.map_fst hSteps, hLenM]
      have hIsTree : IsScaleTree r M T := by
        refine ⟨hr, hM1, hNE, hLeaves, ?_⟩
        intro entry hentry
        have hlen_eq := hAddr entry hentry
        omega
      obtain ⟨hScaleM, hHalf⟩ :=
        validScaleSteps_root_scaleS T P hSteps [] (by simp) rfl rfl rfl
      simp only [List.length_nil, Nat.zero_add, hLenM] at hScaleM hHalf
      have hValid : ValidScaleTree P r M T :=
        ⟨hP, hIsTree, fun ℓ => hHalf ℓ.val (Nat.zero_le _) ℓ.isLt⟩
      exact ⟨hM1, hValid, hScaleM, by simp [hTreeEq]⟩

/-! ## 7. Exported Theorem 2.6 (`thm_2_6_mod4_contraction_of_deps`) -/

mutual
  private theorem leafEntries_pos :
      ∀ (T : ScaleTree) (entry : ℕ × List ℕ), entry ∈ T.leafEntries → ∀ c ∈ entry.2, 1 ≤ c
    | .leaf s, entry, hentry, c, hc => by
      simp [ScaleTree.leafEntries] at hentry
      rcases hentry with ⟨_, rfl⟩
      cases hc
    | .internal cs, entry, hentry, c, hc =>
      leafEntriesChildren_pos 1 cs (by omega) entry hentry c hc

  private theorem leafEntriesChildren_pos :
      ∀ (c₀ : ℕ) (cs : List ScaleTree), 1 ≤ c₀ →
        ∀ entry ∈ ScaleTree.leafEntriesChildren c₀ cs, ∀ c ∈ entry.2, 1 ≤ c
    | _, [], _, _, hentry, _, _ => by
      simp [ScaleTree.leafEntriesChildren] at hentry
    | c₀, child :: cs, hc₀, entry, hentry, c, hc => by
      simp only [ScaleTree.leafEntriesChildren, List.mem_append, List.mem_map] at hentry
      rcases hentry with ⟨⟨s, rest⟩, hmem, rfl⟩ | hrest
      · simp only [List.mem_cons] at hc
        rcases hc with rfl | hcrest
        · exact hc₀
        · exact leafEntries_pos child (s, rest) hmem c hcrest
      · exact leafEntriesChildren_pos (c₀ + 1) cs (by omega) entry hrest c hc
end

private theorem pathWeight_pos (ξ : List ℕ) (hξ : ∀ c ∈ ξ, 1 ≤ c) : 1 ≤ pathWeight ξ := by
  unfold pathWeight
  suffices ∀ (xs : List ℕ), (∀ c ∈ xs, 1 ≤ c) → ∀ (init : ℕ), 1 ≤ init →
      1 ≤ xs.foldl (fun w c => w * (4 * c ^ 2)) init from
    this ξ hξ 1 (by omega)
  intro xs
  induction xs with
  | nil => intro _ init hinit; exact hinit
  | cons c rest ih =>
    intro hcons init hinit
    simp only [List.foldl_cons]
    have hc : 1 ≤ c := hcons c List.mem_cons_self
    have hrest : ∀ x ∈ rest, 1 ≤ x := fun x hx => hcons x (List.mem_cons_of_mem c hx)
    apply ih hrest
    nlinarith

private theorem scaleS_pos (T : ScaleTree) (P : ℕ) (hP : 1 ≤ P) : ∀ ℓ : ℕ, 1 ≤ scaleS T P ℓ
  | 0 => hP
  | ℓ + 1 => by
    unfold scaleS
    have hw : 1 ≤ leafWeight T (ℓ + 1) := by
      unfold leafWeight leafAddr
      split
      · next s addr hfind =>
        have hmem := List.mem_of_find?_eq_some hfind
        exact pathWeight_pos addr (leafEntries_pos T (s, addr) hmem)
      · exact pathWeight_pos [] (by intro c hc; cases hc)
    have hsq : 1 ≤ (alpha0 (2 * scaleS T P ℓ) + 1) ^ 2 := Nat.one_le_pow 2 _ (by omega)
    exact Nat.mul_le_mul hw hsq

private theorem splitIntervalBySize_sizes (X : IntervalBlock) (S : ℕ)
    (hXlo : 1 ≤ X.lo) (hS : 1 ≤ S) (h2S : 2 * S ≤ X.size) :
    ∀ Y ∈ splitIntervalBySize X S,
      X.lo ≤ Y.lo ∧ Y.lo ≤ Y.hi ∧ Y.hi ≤ X.hi ∧ S ≤ Y.size ∧ Y.size < 2 * S := by
  have hXle : X.lo ≤ X.hi := by
    unfold IntervalBlock.size at h2S
    split at h2S <;> omega
  have hXsz : X.size = X.hi - X.lo + 1 := by
    simp [IntervalBlock.size, hXle]
  unfold splitIntervalBySize
  have hcond : ¬ (S = 0 ∨ X.size < 2 * S) := by omega
  simp only [hcond, ↓reduceIte]
  set K := X.size / S
  have hK2 : 2 ≤ K := (Nat.le_div_iff_mul_le hS).mpr h2S
  have hdiv : S * K + X.size % S = X.size := Nat.div_add_mod X.size S
  have hmod : X.size % S < S := Nat.mod_lt X.size hS
  have hKS_comm : K * S = S * K := Nat.mul_comm K S
  intro Y hY
  rw [List.mem_map] at hY
  obtain ⟨idx, hidx, rfl⟩ := hY
  rw [List.mem_range] at hidx
  by_cases hlt : idx + 1 < K
  · simp only [hlt, ↓reduceIte]
    have hmul : (idx + 1) * S ≤ K * S := Nat.mul_le_mul_right S (by omega)
    have hstepS : idx * S + S = (idx + 1) * S := by ring
    have hlo_le_hi : X.lo + idx * S ≤ X.lo + (idx + 1) * S - 1 := by omega
    refine ⟨by omega, hlo_le_hi, by omega, ?_, ?_⟩
    · simp only [IntervalBlock.size, hlo_le_hi, ↓reduceIte]
      omega
    · simp only [IntervalBlock.size, hlo_le_hi, ↓reduceIte]
      omega
  · simp only [hlt, ↓reduceIte]
    have hidx_eq : idx = K - 1 := by omega
    subst hidx_eq
    have hK1S : (K - 1) * S + S = K * S := by
      have : (K - 1) + 1 = K := by omega
      calc (K - 1) * S + S = ((K - 1) + 1) * S := by ring
        _ = K * S := by rw [this]
    have hlo_le_hi : X.lo + (K - 1) * S ≤ X.hi := by omega
    refine ⟨by omega, hlo_le_hi, le_rfl, ?_, ?_⟩
    · simp only [IntervalBlock.size, hlo_le_hi, ↓reduceIte]
      omega
    · simp only [IntervalBlock.size, hlo_le_hi, ↓reduceIte]
      omega

private theorem validScaleTree_leaf_sizes (P r M : ℕ) (T : ScaleTree)
    (hValid : ValidScaleTree P r M T) :
    ∀ Q ∈ scaleTreePartitionChain T P M (Fin.last M),
      1 ≤ Q.size ∧ Q.size < 2 * scaleS T P M := by
  rcases hValid with ⟨hP, hScale, hHalf⟩
  have hM1 : 1 ≤ M := hScale.2.1
  have hLevel : ∀ ℓ : ℕ, ℓ ≤ M →
      ∀ X ∈ scaleTreePartitionLevel T P ℓ,
        1 ≤ X.lo ∧ scaleS T P ℓ ≤ X.size ∧ (1 ≤ ℓ → X.size < 2 * scaleS T P ℓ) := by
    intro ℓ
    induction ℓ with
    | zero =>
      intro _ X hX
      have hPne : P ≠ 0 := by omega
      simp only [scaleTreePartitionLevel, hPne, ↓reduceIte, List.mem_singleton] at hX
      subst hX
      refine ⟨le_rfl, ?_, by intro h; omega⟩
      change P ≤ (if 1 ≤ P then P - 1 + 1 else 0)
      split_ifs; omega
    | succ ℓ ih =>
      intro hℓM X hX
      simp only [scaleTreePartitionLevel, List.mem_flatMap] at hX
      obtain ⟨parent, hparent, hchild⟩ := hX
      obtain ⟨hplo, hpsz, _⟩ := ih (by omega) parent hparent
      have hSpos : 1 ≤ scaleS T P (ℓ + 1) := scaleS_pos T P hP (ℓ + 1)
      have h2S : 2 * scaleS T P (ℓ + 1) ≤ parent.size :=
        le_trans (hHalf ⟨ℓ, hℓM⟩) hpsz
      obtain ⟨h1, _, _, h4, h5⟩ :=
        splitIntervalBySize_sizes parent (scaleS T P (ℓ + 1)) hplo hSpos h2S X hchild
      exact ⟨le_trans hplo h1, h4, fun _ => h5⟩
  intro Q hQ
  have hSpos : 1 ≤ scaleS T P M := scaleS_pos T P hP M
  obtain ⟨_, hge, hlt⟩ := hLevel M le_rfl Q hQ
  exact ⟨le_trans hSpos hge, hlt hM1⟩

private theorem mul_216_le_pow (r : ℕ) (hr : 1 ≤ r) : 216 * r ≤ 216 ^ r := by
  obtain ⟨d, rfl⟩ := Nat.exists_eq_add_of_le hr
  clear hr
  induction d with
  | zero => norm_num
  | succ d ih =>
    have h1 : 1 ≤ 216 ^ (1 + d) := Nat.one_le_pow _ _ (by omega)
    calc 216 * (1 + (d + 1)) = 216 * (1 + d) + 216 := by ring
      _ ≤ 216 ^ (1 + d) + 215 * 216 ^ (1 + d) := Nat.add_le_add ih (by omega)
      _ = 216 ^ (1 + d) * 216 := by ring
      _ = 216 ^ (1 + (d + 1)) := by rw [← Nat.pow_succ]; rfl

private theorem sq_2m3_le_two_pow (m : ℕ) (hm : 15 ≤ m) : (2 * m + 3) ^ 2 ≤ 2 ^ m := by
  obtain ⟨d, rfl⟩ := Nat.exists_eq_add_of_le hm
  clear hm
  induction d with
  | zero => norm_num
  | succ d ih =>
    have hstep : (2 * (15 + (d + 1)) + 3) ^ 2 ≤ 2 * (2 * (15 + d) + 3) ^ 2 := by
      have hlin : 8 * d + 136 ≤ 4 * d ^ 2 + 132 * d + 1089 := by omega
      have hsq_eq : 4 * d ^ 2 + 132 * d + 1089 = (2 * (15 + d) + 3) ^ 2 := by ring
      rw [hsq_eq] at hlin
      calc (2 * (15 + (d + 1)) + 3) ^ 2
          = (2 * (15 + d) + 3) ^ 2 + (8 * d + 136) := by ring
        _ ≤ (2 * (15 + d) + 3) ^ 2 + (2 * (15 + d) + 3) ^ 2 := Nat.add_le_add_left hlin _
        _ = 2 * (2 * (15 + d) + 3) ^ 2 := by ring
    calc (2 * (15 + (d + 1)) + 3) ^ 2 ≤ 2 * (2 * (15 + d) + 3) ^ 2 := hstep
      _ ≤ 2 * 2 ^ (15 + d) := Nat.mul_le_mul_left 2 ih
      _ = 2 ^ (15 + (d + 1)) := by rw [← Nat.add_assoc, Nat.pow_succ, Nat.mul_comm]

/-- **Theorem 2.6** (`thm:mod4-contraction`, Variable-Depth Scale-Tree Contraction),
parameterized by `lem_A_1_ack_basic`. -/
theorem thm_2_6_mod4_contraction_of_deps
    (h_A_1 :
      -- Part (1)
      ((∀ i j : ℕ, 1 ≤ j → j < ackermann i j) ∧
       (∀ i j₁ j₂ : ℕ, 1 ≤ j₁ → j₁ < j₂ → ackermann i j₁ < ackermann i j₂) ∧
       (∀ i j : ℕ, 1 ≤ i → 1 ≤ j →
         ackermann (i - 1) j ≤ ackermann i j ∧ 2 ^ j ≤ ackermann i j) ∧
       (∀ k : ℕ, 1 ≤ k → 2 ^ k ≤ ackermann k 1) ∧
       (∀ m n : ℕ, 1 ≤ m → m ≤ n → alpha0 m ≤ alpha0 n) ∧
       alpha0 1 = 1 ∧
       (∀ n : ℕ, 2 ≤ n →
         alpha0 n ≤ Nat.clog 2 n ∧ (alpha0 n : ℝ) < Real.logb 2 (n : ℝ) + 1) ∧
       (∀ n : ℕ, 3 ≤ n → alpha0 n < n)) ∧
      -- Part (2)
      ((∀ r k : ℕ, 1 ≤ k → 2 ^ k ≤ ackTower r k) ∧
       (∀ r k₁ k₂ : ℕ, 1 ≤ k₁ → k₁ < k₂ → ackTower r k₁ < ackTower r k₂) ∧
       (∀ r₁ r₂ k : ℕ, 1 ≤ r₁ → r₁ ≤ r₂ → 1 ≤ k → ackTower r₁ k ≤ ackTower r₂ k) ∧
       (∀ r m n : ℕ, 1 ≤ r → 1 ≤ m → m ≤ n → alphaHierarchy r m ≤ alphaHierarchy r n) ∧
       (∀ r n : ℕ, 1 ≤ r → 4 < n → alphaHierarchy r n < n) ∧
       (∀ r k n : ℕ, 1 ≤ r → 1 ≤ k → 1 ≤ n →
         (alphaHierarchy r n ≤ k ↔ n ≤ ackTower r k)) ∧
       (∀ n : ℕ, 1 ≤ n → alphaHierarchy 1 (2 * n) ≤ alphaHierarchy 1 n + 1) ∧
       (∀ r n : ℕ, 1 ≤ r → 1 ≤ n →
         alphaHierarchy r n ≤ alphaHierarchy 1 n ∧
         alphaHierarchy 1 n ≤ Nat.log 2 (Nat.log 2 (n + 16)) + 2 ∧
         (alphaHierarchy 1 n : ℝ) ≤ Real.logb 2 (Real.logb 2 ((n : ℝ) + 16)) + 2) ∧
       (∀ n : ℕ, 1 ≤ n → alphaOmega n = sInf {r : ℕ | 1 ≤ r ∧ n ≤ ackTower r 2})) ∧
      -- Part (3)
      ((∀ n : ℕ, 1 ≤ n → alpha0 (n + 2) ≤ alpha0 n + 1) ∧
       (∀ m u : ℕ, 1 ≤ m → 1 ≤ u →
         ((fun x : ℕ => alpha0 x + 1)^[m] u) ≤ (alpha0^[m] u) + 2) ∧
       (∀ u : ℕ, 5 ≤ u → alpha0 (2 ^ 20 * u ^ 6) ≤ alpha0 u + 1))) :
    ∃ C₀ : ℕ, 6 ≤ C₀ ∧
      ∀ P r : ℕ, 1 ≤ P → 1 ≤ r →
        let bound := (max (alphaHierarchy r P) (2 ^ (C₀ ^ (2 * r)))) ^ (6 ^ r)
        (2 * P < bound ∨
          ∃ (M : ℕ) (T : ScaleTree), ValidScaleTree P r M T ∧ 2 * scaleS T P M ≤ bound) ∧
        (r = alphaOmega P →
          P < 2 ^ (C₀ ^ (3 * r)) ∨
          ∃ (M : ℕ) (T : ScaleTree), ValidScaleTree P r M T ∧
            ∀ Q ∈ scaleTreePartitionChain T P M (Fin.last M),
              Q.size < 2 ^ (C₀ ^ (3 * r))) ∧
        (r = 1 →
          2 * P < (max (alphaHierarchy 1 P) (2 ^ (C₀ ^ 2))) ^ 6 ∨
          ∃ (M : ℕ) (T : ScaleTree), ValidScaleTree P 1 M T ∧
            ∀ Q ∈ scaleTreePartitionChain T P M (Fin.last M),
              Q.size < (max (alphaHierarchy 1 P) (2 ^ (C₀ ^ 2))) ^ 6) := by
  have h61 := lem_6_1_build_scale_tree_of_deps h_A_1
  rcases h_A_1 with ⟨⟨_, _, _, _, _, _, hAlpha0Clog, _⟩,
    ⟨hTowerPow, hTowerStrict, _, _, _, hAlphaIff, _, _, hAlphaOmegaSInf⟩, _⟩
  refine ⟨6, le_rfl, ?_⟩
  intro P r hP hr
  let bound := (max (alphaHierarchy r P) (2 ^ (6 ^ (2 * r)))) ^ (6 ^ r)
  have h61_inst := h61 r P hr hP
  have hMainDichotomy :
      2 * P < bound ∨
        ∃ (M : ℕ) (T : ScaleTree), ValidScaleTree P r M T ∧ 2 * scaleS T P M ≤ bound := by
    rcases hRoot : buildScaleTreeRoot r P with ⟨τ?, S_out, M⟩
    rw [hRoot] at h61_inst
    cases τ? with
    | none =>
      left
      obtain ⟨_, _, hNone⟩ := h61_inst.2.2
      have hEmpty := (h61_inst.1 0 1 P hr (by omega) hP hNone).2
      dsimp at hEmpty
      have h216_eq : (2 ^ (6 ^ (2 * r))) ^ (6 ^ r) = 2 ^ (216 ^ r) := by
        rw [← Nat.pow_mul]
        congr 1
        calc 6 ^ (2 * r) * 6 ^ r = (6 ^ 2) ^ r * 6 ^ r := by rw [Nat.pow_mul]
          _ = (6 ^ 2 * 6) ^ r := by rw [← Nat.mul_pow]
          _ = 216 ^ r := by norm_num
      have hPowLeBound : 2 ^ (216 ^ r) ≤ bound := by
        rw [← h216_eq]
        exact Nat.pow_le_pow_left (le_max_right _ _) (6 ^ r)
      suffices hlt : 2 * P < 2 ^ (216 ^ r) from lt_of_lt_of_le hlt hPowLeBound
      by_contra hge
      have hle_w : 2 ^ (216 ^ r) ≤ 2 * P := Nat.le_of_not_lt hge
      set w := 2 * P
      have h216r : 216 * r ≤ 216 ^ r := mul_216_le_pow r hr
      have hw_ge2 : 2 ≤ w := by omega
      set t := Nat.log 2 w
      have ht_ge : 216 ^ r ≤ t := (Nat.le_log_iff_pow_le (by omega) (by omega)).mpr hle_w
      have ht_216r : 216 * r ≤ t := le_trans h216r ht_ge
      have hw_pow : 2 ^ t ≤ w := Nat.pow_log_le_self 2 (by omega)
      have hw_lt_succ : w < 2 ^ (t + 1) := Nat.lt_pow_succ_log_self (by omega) w
      have hclog : Nat.clog 2 w ≤ t + 1 :=
        (Nat.clog_le_iff_le_pow (by omega)).mpr (le_of_lt hw_lt_succ)
      have ha0 : alpha0 w ≤ t + 1 := le_trans (hAlpha0Clog w hw_ge2).1 hclog
      have hw_upper : w < 2 ^ (2 * r + 2) * (t + 2) ^ 2 := by
        have h4 : 4 ^ (r + 1) = 2 ^ (2 * r + 2) := by
          calc 4 ^ (r + 1) = (2 ^ 2) ^ (r + 1) := rfl
            _ = 2 ^ (2 * (r + 1)) := (Nat.pow_mul 2 2 (r + 1)).symm
            _ = 2 ^ (2 * r + 2) := by ring
        have hsq : (alpha0 w + 1) ^ 2 ≤ (t + 2) ^ 2 := Nat.pow_le_pow_left (by omega) 2
        have h1 : 4 ^ (r + 1) * 1 * (alpha0 w + 1) ^ 2 ≤ 2 ^ (2 * r + 2) * (t + 2) ^ 2 := by
          rw [h4, Nat.mul_one]
          exact Nat.mul_le_mul_left _ hsq
        exact lt_of_lt_of_le hEmpty h1
      set m := t / 2
      have hm15 : 15 ≤ m := by omega
      have hsq_pow : (2 * m + 3) ^ 2 ≤ 2 ^ m := sq_2m3_le_two_pow m hm15
      have ht2_sq : (t + 2) ^ 2 ≤ 2 ^ m :=
        le_trans (Nat.pow_le_pow_left (by omega : t + 2 ≤ 2 * m + 3) 2) hsq_pow
      have hexp_le : 2 * r + 2 + m ≤ t := by omega
      have hcontr : 2 ^ (2 * r + 2) * (t + 2) ^ 2 ≤ w := by
        calc 2 ^ (2 * r + 2) * (t + 2) ^ 2
            ≤ 2 ^ (2 * r + 2) * 2 ^ m := Nat.mul_le_mul_left _ ht2_sq
          _ = 2 ^ (2 * r + 2 + m) := (Nat.pow_add 2 (2 * r + 2) m).symm
          _ ≤ 2 ^ t := Nat.pow_le_pow_right (by omega) hexp_le
          _ ≤ w := hw_pow
      omega
    | some T =>
      right
      obtain ⟨_, hValid, hSM_eq, hSout_eq⟩ := h61_inst.2.2
      have hContr := (h61_inst.2.1 0 1 P hr (by omega) hP).2.2
      dsimp at hContr
      have h36 : 36 ^ r = 6 ^ (2 * r) := by
        calc 36 ^ r = (6 ^ 2) ^ r := rfl
          _ = 6 ^ (2 * r) := (Nat.pow_mul 6 2 r).symm
      rw [h36] at hContr
      have hmax1 : max 1 (max (alphaHierarchy r P) (2 ^ (6 ^ (2 * r)))) =
          max (alphaHierarchy r P) (2 ^ (6 ^ (2 * r))) := by
        apply max_eq_right
        exact le_trans (Nat.one_le_pow _ _ (by omega)) (le_max_right _ _)
      rw [hmax1, ← hSout_eq, ← hSM_eq] at hContr
      exact ⟨M, T, hValid, hContr⟩
  refine ⟨hMainDichotomy, ?_, ?_⟩
  · -- Specialization `r = alphaOmega P`:
    intro hr_eq
    have h_nonempty : ({r' : ℕ | 1 ≤ r' ∧ P ≤ ackTower r' 2}).Nonempty := by
      have hgrow : ∀ m : ℕ, m + 1 ≤ ackTower (m + 1) 2 := by
        intro m; induction m with
        | zero =>
          change 1 ≤ ackTower 1 2
          exact le_trans (by norm_num : 1 ≤ 2 ^ 2) (hTowerPow 1 2 (by omega))
        | succ m ih =>
          have hstep : ackTower (m + 1) 2 < ackTower (m + 2) 2 := by
            have heq : ackTower (m + 2) 2 = ackTower (m + 1) 4 := by simp [ackTower]
            rw [heq]
            exact hTowerStrict (m + 1) 2 4 (by omega) (by omega)
          change m + 2 ≤ ackTower (m + 2) 2
          omega
      have hPP := hgrow (P - 1)
      have hP1 : P - 1 + 1 = P := by omega
      rw [hP1] at hPP
      exact ⟨P, hP, hPP⟩
    have hmem : 1 ≤ alphaOmega P ∧ P ≤ ackTower (alphaOmega P) 2 := by
      have h := Nat.sInf_mem h_nonempty
      rwa [← hAlphaOmegaSInf P hP] at h
    have hPr2 : P ≤ ackTower r 2 := hr_eq.symm ▸ hmem.2
    have ha_le2 : alphaHierarchy r P ≤ 2 := (hAlphaIff r 2 P hr (by omega) hP).mpr hPr2
    have h2_le_pow : 2 ≤ 2 ^ (6 ^ (2 * r)) := by
      calc 2 = 2 ^ 1 := rfl
        _ ≤ 2 ^ (6 ^ (2 * r)) := Nat.pow_le_pow_right (by omega) (Nat.one_le_pow _ _ (by omega))
    have hbound_eq : bound = 2 ^ (6 ^ (3 * r)) := by
      dsimp [bound]
      rw [max_eq_right (le_trans ha_le2 h2_le_pow), ← Nat.pow_mul]
      congr 1
      calc 6 ^ (2 * r) * 6 ^ r = 6 ^ (2 * r + r) := (Nat.pow_add 6 (2 * r) r).symm
        _ = 6 ^ (3 * r) := by ring_nf
    rcases hMainDichotomy with hSmall | ⟨M, T, hValid, hSM⟩
    · left
      have hSmall' : 2 * P < 2 ^ (6 ^ (3 * r)) := hbound_eq ▸ hSmall
      omega
    · right
      refine ⟨M, T, hValid, ?_⟩
      intro Q hQ
      have hQlt := (validScaleTree_leaf_sizes P r M T hValid Q hQ).2
      have hSM' : 2 * scaleS T P M ≤ 2 ^ (6 ^ (3 * r)) := hbound_eq ▸ hSM
      omega
  · -- Specialization `r = 1`:
    rintro rfl
    have hbound1 : bound = (max (alphaHierarchy 1 P) (2 ^ (6 ^ 2))) ^ 6 := by
      dsimp [bound]
    rcases hMainDichotomy with hSmall | ⟨M, T, hValid, hSM⟩
    · left; exact hbound1 ▸ hSmall
    · right
      refine ⟨M, T, hValid, ?_⟩
      intro Q hQ
      have hQlt := (validScaleTree_leaf_sizes P 1 M T hValid Q hQ).2
      have hSM' : 2 * scaleS T P M ≤ (max (alphaHierarchy 1 P) (2 ^ (6 ^ 2))) ^ 6 :=
        hbound1 ▸ hSM
      omega

end Solution.Contraction
