/-!
# Section 6 / Module 4: Variable-Depth Scale-Tree Contraction

Formalization of Lemma 6.1 (`lem_6_1_build_scale_tree`) and Theorem 2.6
(`thm_2_6_mod4_contraction`), parameterized solely by Layer-0 `lem_A_1_ack_basic`.
-/

/-- Exact proposition type of `Challenge.lem_A_1_ack_basic` (Layer 0 dependency). -/
abbrev LemA1Type : Prop :=
  -- Part (1)
  ((∀ i j : ℕ, 1 ≤ j → j < ackermann i j) ∧
   (∀ i j₁ j₂ : ℕ, 1 ≤ j₁ → j₁ < j₂ → ackermann i j₁ < ackermann i j₂) ∧
   (∀ i j : ℕ, 1 ≤ i → 1 ≤ j →
     ackermann (i - 1) j ≤ ackermann i j ∧ 2 ^ j ≤ ackermann i j) ∧
   (∀ k : ℕ, 1 ≤ k → 2 ^ k ≤ ackermann k 1) ∧
   (∀ m n : ℕ, 1 ≤ m → m ≤ n → alpha0 m ≤ alpha0 n) ∧
   alpha0 1 = 1 ∧
   (∀ n : ℕ, 2 ≤ n →
     alpha0 n ≤ Nat.clog 2 n ∧ (alpha0 n : ℝ) < Real.logb 2 (n : ℝ) + 1) ∧
   (∀ n : ℕ, 3 ≤ n → alpha0 n < n)) ∧
  -- Part (2)
  ((∀ r k : ℕ, 1 ≤ k → 2 ^ k ≤ ackTower r k) ∧
   (∀ r k₁ k₂ : ℕ, 1 ≤ k₁ → k₁ < k₂ → ackTower r k₁ < ackTower r k₂) ∧
   (∀ r₁ r₂ k : ℕ, 1 ≤ r₁ → r₁ ≤ r₂ → 1 ≤ k → ackTower r₁ k ≤ ackTower r₂ k) ∧
   (∀ r m n : ℕ, 1 ≤ r → 1 ≤ m → m ≤ n → alphaHierarchy r m ≤ alphaHierarchy r n) ∧
   (∀ r n : ℕ, 1 ≤ r → 4 < n → alphaHierarchy r n < n) ∧
   (∀ r k n : ℕ, 1 ≤ r → 1 ≤ k → 1 ≤ n →
     (alphaHierarchy r n ≤ k ↔ n ≤ ackTower r k)) ∧
   (∀ n : ℕ, 1 ≤ n → alphaHierarchy 1 (2 * n) ≤ alphaHierarchy 1 n + 1) ∧
   (∀ r n : ℕ, 1 ≤ r → 1 ≤ n →
     alphaHierarchy r n ≤ alphaHierarchy 1 n ∧
     alphaHierarchy 1 n ≤ Nat.log 2 (Nat.log 2 (n + 16)) + 2 ∧
     (alphaHierarchy 1 n : ℝ) ≤ Real.logb 2 (Real.logb 2 ((n : ℝ) + 16)) + 2) ∧
   (∀ n : ℕ, 1 ≤ n → alphaOmega n = sInf {r : ℕ | 1 ≤ r ∧ n ≤ ackTower r 2})) ∧
  -- Part (3)
  ((∀ n : ℕ, 1 ≤ n → alpha0 (n + 2) ≤ alpha0 n + 1) ∧
   (∀ m u : ℕ, 1 ≤ m → 1 ≤ u →
     ((fun x : ℕ => alpha0 x + 1)^[m] u) ≤ (alpha0^[m] u) + 2) ∧
   (∀ u : ℕ, 5 ≤ u → alpha0 (2 ^ 20 * u ^ 6) ≤ alpha0 u + 1))

private theorem LemA1Type.alphaMono (hA : LemA1Type) :
    ∀ r m n : ℕ, 1 ≤ r → 1 ≤ m → m ≤ n → alphaHierarchy r m ≤ alphaHierarchy r n :=
  hA.2.1.2.2.2.1

private theorem LemA1Type.alphaLt (hA : LemA1Type) :
    ∀ r n : ℕ, 1 ≤ r → 4 < n → alphaHierarchy r n < n :=
  hA.2.1.2.2.2.2.1

private theorem LemA1Type.alphaIff (hA : LemA1Type) :
    ∀ r k n : ℕ, 1 ≤ r → 1 ≤ k → 1 ≤ n → (alphaHierarchy r n ≤ k ↔ n ≤ ackTower r k) :=
  hA.2.1.2.2.2.2.2.1

private theorem LemA1Type.alpha1Double (hA : LemA1Type) :
    ∀ n : ℕ, 1 ≤ n → alphaHierarchy 1 (2 * n) ≤ alphaHierarchy 1 n + 1 :=
  hA.2.1.2.2.2.2.2.2.1

private theorem LemA1Type.alphaLogLog (hA : LemA1Type) :
    ∀ r n : ℕ, 1 ≤ r → 1 ≤ n →
      alphaHierarchy r n ≤ alphaHierarchy 1 n ∧
      alphaHierarchy 1 n ≤ Nat.log 2 (Nat.log 2 (n + 16)) + 2 := by
  intro r n hr hn
  obtain ⟨h1, h2, _⟩ := hA.2.1.2.2.2.2.2.2.2.1 r n hr hn
  exact ⟨h1, h2⟩

private theorem ackTower_one (q : ℕ) (hq : 1 ≤ q) : ackTower q 1 = 4 := by
  obtain ⟨r', rfl⟩ : ∃ r', q = r' + 1 := ⟨q - 1, by omega⟩
  simp [ackTower]

/-! ## 1. Structural Helpers on `pathWeight`, `ScaleTree`, and `ValidScaleSteps` -/

private theorem range'_snoc (a n : ℕ) :
    List.range' a n ++ [a + n] = List.range' a (n + 1) := by
  induction n generalizing a with
  | zero =>
    simp
  | succ n ih =>
    simp only [List.range'_succ, List.cons_append]
    congr 1
    have h : a + 1 + n = a + (n + 1) := by omega
    rw [← h]
    exact ih (a + 1)

private theorem foldl_pathWeight (init : ℕ) (ξ : List ℕ) :
    ξ.foldl (fun w c => w * (4 * c ^ 2)) init = init * pathWeight ξ := by
  induction ξ generalizing init with
  | nil =>
    simp [pathWeight]
  | cons c rest ih =>
    unfold pathWeight
    simp only [List.foldl_cons]
    rw [ih (init * (4 * c ^ 2)), ih (1 * (4 * c ^ 2))]
    ring

private theorem pathWeight_cons (c : ℕ) (rest : List ℕ) :
    pathWeight (c :: rest) = 4 * c ^ 2 * pathWeight rest := by
  conv_lhs => unfold pathWeight
  simp only [List.foldl_cons, Nat.one_mul]
  rw [foldl_pathWeight]

/-- Relational invariant describing the sequence of leaf scale updates generated by a subtree
under ambient path-weight multiplier `W`. -/
private inductive ValidScaleSteps (W : ℕ) : ℕ → ℕ → List (ℕ × List ℕ) → ℕ → Prop where
  | nil (S M : ℕ) : ValidScaleSteps W S M [] S
  | cons {S M S_next S_end : ℕ} {addr : List ℕ} {rest : List (ℕ × List ℕ)}
      (heq : S_next = (W * pathWeight addr) * (alpha0 (2 * S) + 1) ^ 2)
      (hpos : 1 ≤ S_next)
      (hhalf : 2 * S_next ≤ S)
      (hrest : ValidScaleSteps W S_next (M + 1) rest S_end) :
      ValidScaleSteps W S M ((M + 1, addr) :: rest) S_end

private theorem ValidScaleSteps.append {W S₁ M₁ S₂ S₃ : ℕ}
    {es₁ es₂ : List (ℕ × List ℕ)}
    (h₁ : ValidScaleSteps W S₁ M₁ es₁ S₂)
    (h₂ : ValidScaleSteps W S₂ (M₁ + es₁.length) es₂ S₃) :
    ValidScaleSteps W S₁ M₁ (es₁ ++ es₂) S₃ := by
  induction h₁ with
  | nil S M =>
    simpa using h₂
  | @cons S M S_next S_mid addr rest heq hpos hhalf _ ih =>
    simp only [List.cons_append]
    refine ValidScaleSteps.cons heq hpos hhalf (ih ?_)
    have hm : M + 1 + rest.length = M + (rest.length + 1) := by omega
    simpa [hm] using h₂

private theorem ValidScaleSteps.prepend_coord {W c S₁ M₁ S₂ : ℕ}
    {es : List (ℕ × List ℕ)}
    (h : ValidScaleSteps (4 * c ^ 2 * W) S₁ M₁ es S₂) :
    ValidScaleSteps W S₁ M₁ (es.map (fun (s, rest) => (s, c :: rest))) S₂ := by
  induction h with
  | nil S M =>
    exact ValidScaleSteps.nil S M
  | @cons S M S_next S_end addr rest heq hpos hhalf _ ih =>
    simp only [List.map_cons]
    refine ValidScaleSteps.cons ?_ hpos hhalf ih
    rw [heq, pathWeight_cons]
    ring

private theorem ValidScaleSteps.map_fst {W S₁ M₁ S₂ : ℕ}
    {es : List (ℕ × List ℕ)}
    (h : ValidScaleSteps W S₁ M₁ es S₂) :
    es.map Prod.fst = List.range' (M₁ + 1) es.length := by
  induction h with
  | nil _ _ => rfl
  | cons _ _ _ _ ih =>
    simp only [List.map_cons, List.length_cons, List.range'_succ]
    rw [ih]

private theorem ValidScaleSteps.bounds {W S₁ M₁ S₂ : ℕ}
    {es : List (ℕ × List ℕ)}
    (hS₁ : 1 ≤ S₁) (h : ValidScaleSteps W S₁ M₁ es S₂) :
    1 ≤ S₂ ∧ S₂ ≤ S₁ := by
  induction h with
  | nil _ _ =>
    exact ⟨hS₁, le_rfl⟩
  | cons _ hpos hhalf _ ih =>
    obtain ⟨h1, hle⟩ := ih hpos
    exact ⟨h1, by omega⟩

private theorem ValidScaleSteps.nil_eq {W S₁ M₁ S₂ : ℕ}
    (h : ValidScaleSteps W S₁ M₁ [] S₂) : S₂ = S₁ := by
  cases h
  rfl

private theorem find?_after_prefix {pref rest : List (ℕ × List ℕ)} {k : ℕ} {addr : List ℕ}
    (hpref : pref.map Prod.fst = List.range' 1 pref.length)
    (hk : k = pref.length + 1) :
    (pref ++ (k, addr) :: rest).find? (fun entry => entry.1 == k) = some (k, addr) := by
  have hnone : ∀ e ∈ pref, (e.1 == k) = false := by
    intro e he
    have hmem : e.1 ∈ List.range' 1 pref.length := by
      rw [← hpref]
      exact List.mem_map_of_mem he
    rw [List.mem_range'] at hmem
    obtain ⟨i, hi, he1⟩ := hmem
    have hne : e.1 ≠ k := by omega
    exact beq_eq_false_iff_ne.mpr hne
  clear hpref hk
  induction pref with
  | nil =>
    simp
  | cons x xs ih =>
    have hx : (x.1 == k) = false := hnone x List.mem_cons_self
    have hxs : ∀ e ∈ xs, (e.1 == k) = false := fun e he => hnone e (List.mem_cons_of_mem x he)
    simp only [List.cons_append, List.find?_cons, hx]
    exact ih hxs

private theorem validScaleSteps_root_scaleS (T : ScaleTree) (P : ℕ) :
    ∀ {S_curr M_curr S_out : ℕ} {suff : List (ℕ × List ℕ)},
      ValidScaleSteps 1 S_curr M_curr suff S_out →
      ∀ (pref : List (ℕ × List ℕ)),
        T.leafEntries = pref ++ suff →
        M_curr = pref.length →
        pref.map Prod.fst = List.range' 1 pref.length →
        scaleS T P pref.length = S_curr →
        scaleS T P (pref.length + suff.length) = S_out ∧
          ∀ ℓ : ℕ, pref.length ≤ ℓ → ℓ < pref.length + suff.length →
            2 * scaleS T P (ℓ + 1) ≤ scaleS T P ℓ := by
  intro S_curr M_curr S_out suff hsteps
  induction hsteps with
  | nil S M =>
    intro pref _ _ _ hS
    simp only [List.length_nil, Nat.add_zero]
    refine ⟨hS, fun ℓ hge hlt => by omega⟩
  | @cons S M S_next S_end addr rest heq hpos hhalf _ ih =>
    intro pref hentries hM hpref hS
    subst hM
    have hfind : T.leafEntries.find? (fun entry => entry.1 == (pref.length + 1)) =
        some (pref.length + 1, addr) := by
      rw [hentries]
      exact find?_after_prefix hpref rfl
    have haddr : leafAddr T (pref.length + 1) = addr := by
      unfold leafAddr
      rw [hfind]
    have hw : leafWeight T (pref.length + 1) = pathWeight addr := by
      unfold leafWeight
      rw [haddr]
    have hS_next : scaleS T P (pref.length + 1) = S_next := by
      simp only [scaleS, hS, hw]
      rw [heq, Nat.one_mul]
    set pref' := pref ++ [(pref.length + 1, addr)]
    have hentries' : T.leafEntries = pref' ++ rest := by
      simp [pref', hentries, List.append_assoc]
    have hlen' : pref.length + 1 = pref'.length := by
      simp [pref']
    have hpref' : pref'.map Prod.fst = List.range' 1 pref'.length := by
      simp only [pref', List.map_append, List.map_cons, List.map_nil, List.length_append,
        List.length_singleton]
      rw [hpref]
      have h1 : 1 + pref.length = pref.length + 1 := by omega
      simpa [h1] using range'_snoc 1 pref.length
    have hS' : scaleS T P pref'.length = S_next := by
      simpa [← hlen'] using hS_next
    obtain ⟨hend, hhalf_rest⟩ := ih pref' hentries' hlen' hpref' hS'
    have htot : pref.length + ((pref.length + 1, addr) :: rest).length =
        pref'.length + rest.length := by
      simp [pref']
      omega
    refine ⟨htot ▸ hend, ?_⟩
    intro ℓ hge hlt
    by_cases heqℓ : ℓ = pref.length
    · subst heqℓ
      rw [hS_next, hS]
      exact hhalf
    · apply hhalf_rest ℓ
      · simp [pref']; omega
      · rw [← htot]; exact hlt

/-! ## 2. Pure Integer Exponential & Logarithm Inequalities -/

private theorem sq_6k7_lt_two_pow (k : ℕ) (hk : 36 ≤ k) : (6 * k + 7) ^ 2 < 2 ^ k := by
  obtain ⟨d, rfl⟩ := Nat.exists_eq_add_of_le hk
  clear hk
  induction d with
  | zero => norm_num
  | succ d ih =>
    have hstep : (6 * (36 + (d + 1)) + 7) ^ 2 ≤ 2 * (6 * (36 + d) + 7) ^ 2 := by
      have hlin : 72 * d + 2712 ≤ (6 * (36 + d) + 7) ^ 2 := by
        have hexp : (6 * (36 + d) + 7) ^ 2 = 36 * d ^ 2 + 2676 * d + 49729 := by ring
        rw [hexp]
        omega
      calc (6 * (36 + (d + 1)) + 7) ^ 2
          = (6 * (36 + d) + 7) ^ 2 + (72 * d + 2712) := by ring
        _ ≤ (6 * (36 + d) + 7) ^ 2 + (6 * (36 + d) + 7) ^ 2 := Nat.add_le_add_left hlin _
        _ = 2 * (6 * (36 + d) + 7) ^ 2 := by ring
    calc (6 * (36 + (d + 1)) + 7) ^ 2
        ≤ 2 * (6 * (36 + d) + 7) ^ 2 := hstep
      _ < 2 * 2 ^ (36 + d) := Nat.mul_lt_mul_of_pos_left ih (by omega)
      _ = 2 ^ (36 + (d + 1)) := by rw [← Nat.add_assoc, Nat.pow_succ, Nat.mul_comm]

/-- Integer counterpart of paper eq. (14) (`(α_0(w) + 1)^2 < w^{1/6}` for `w ≥ 2^216`):
whenever `2^36 ≤ B`, `M ≤ B^5`, and `w < M * (α_0(w) + 1)^2`, we have `w < B^6`. -/
private theorem w_lt_pow6_of_lt_mul_alpha0_sq
    (hA0Clog : ∀ n : ℕ, 2 ≤ n → alpha0 n ≤ Nat.clog 2 n)
    (w B M : ℕ) (hB : 2 ^ 36 ≤ B) (hM : M ≤ B ^ 5)
    (hw : w < M * (alpha0 w + 1) ^ 2) :
    w < B ^ 6 := by
  by_cases hw216 : w < 2 ^ 216
  · have h216 : 2 ^ 216 ≤ B ^ 6 := by
      have heq : (2 ^ 36) ^ 6 = 2 ^ 216 := by norm_num
      rw [← heq]
      exact Nat.pow_le_pow_left hB 6
    exact lt_of_lt_of_le hw216 h216
  · have hge216 : 2 ^ 216 ≤ w := Nat.le_of_not_lt hw216
    have hw_ge2 : 2 ≤ w := by
      have : 2 ≤ 2 ^ 216 := by norm_num
      omega
    set t := Nat.log 2 w
    have ht216 : 216 ≤ t := (Nat.le_log_iff_pow_le (by omega) (by omega)).mpr hge216
    have hw_pow : 2 ^ t ≤ w := Nat.pow_log_le_self 2 (by omega)
    have hw_lt_succ : w < 2 ^ (t + 1) := Nat.lt_pow_succ_log_self (by omega) w
    have hclog : Nat.clog 2 w ≤ t + 1 :=
      (Nat.clog_le_iff_le_pow (by omega)).mpr (le_of_lt hw_lt_succ)
    have ha0 : alpha0 w ≤ t + 1 := le_trans (hA0Clog w hw_ge2) hclog
    set k := t / 6
    have hk36 : 36 ≤ k := by omega
    have h6k_le_t : 6 * k ≤ t := by omega
    have ht2_le : t + 2 ≤ 6 * k + 7 := by omega
    set A := (alpha0 w + 1) ^ 2
    have hA_pos : 1 ≤ A := Nat.one_le_pow 2 _ (by omega)
    have hA_lt_pow : A < 2 ^ k := by
      have hle1 : A ≤ (6 * k + 7) ^ 2 := Nat.pow_le_pow_left (by omega) 2
      exact lt_of_le_of_lt hle1 (sq_6k7_lt_two_pow k hk36)
    have hA6_lt_w : A ^ 6 < w := by
      have hpow6 : A ^ 6 < (2 ^ k) ^ 6 := Nat.pow_lt_pow_left hA_lt_pow (by omega)
      have heq : (2 ^ k) ^ 6 = 2 ^ (6 * k) := by
        rw [← Nat.pow_mul, Nat.mul_comm]
      rw [heq] at hpow6
      exact lt_of_lt_of_le hpow6 (le_trans (Nat.pow_le_pow_right (by omega) h6k_le_t) hw_pow)
    have hw_le_B5A : w ≤ B ^ 5 * A :=
      le_trans (le_of_lt hw) (Nat.mul_le_mul_right A hM)
    have hw6_le : w ^ 6 ≤ B ^ 30 * A ^ 6 := by
      calc w ^ 6 ≤ (B ^ 5 * A) ^ 6 := Nat.pow_le_pow_left hw_le_B5A 6
        _ = B ^ 30 * A ^ 6 := by ring
    have hB_pos : 1 ≤ B := le_trans (by norm_num : 1 ≤ 2 ^ 36) hB
    have hB30_pos : 0 < B ^ 30 := Nat.one_le_pow 30 B hB_pos
    have hw6_lt : w ^ 6 < (B ^ 6) ^ 5 * w := by
      have hlt : B ^ 30 * A ^ 6 < B ^ 30 * w := Nat.mul_lt_mul_of_pos_left hA6_lt_w hB30_pos
      have heq : B ^ 30 * w = (B ^ 6) ^ 5 * w := by ring
      omega
    by_contra hge
    have hB6_le_w : B ^ 6 ≤ w := Nat.le_of_not_lt hge
    have hpow5 : (B ^ 6) ^ 5 ≤ w ^ 5 := Nat.pow_le_pow_left hB6_le_w 5
    have hmul : (B ^ 6) ^ 5 * w ≤ w ^ 5 * w := Nat.mul_le_mul_right w hpow5
    have hw6_eq : w ^ 5 * w = w ^ 6 := by ring
    omega

private theorem mul_36_le_pow (q : ℕ) (hq : 1 ≤ q) : 36 * q ≤ 36 ^ q := by
  obtain ⟨d, rfl⟩ := Nat.exists_eq_add_of_le hq
  clear hq
  induction d with
  | zero => norm_num
  | succ d ih =>
    have h1 : 1 ≤ 36 ^ (1 + d) := Nat.one_le_pow _ _ (by omega)
    calc 36 * (1 + (d + 1)) = 36 * (1 + d) + 36 := by ring
      _ ≤ 36 ^ (1 + d) + 35 * 36 ^ (1 + d) := Nat.add_le_add ih (by omega)
      _ = 36 ^ (1 + d) * 36 := by ring
      _ = 36 ^ (1 + (d + 1)) := by rw [← Nat.pow_succ]; rfl

private theorem add_two_le_two_pow (u : ℕ) (hu : 2 ≤ u) : u + 2 ≤ 2 ^ u := by
  obtain ⟨d, rfl⟩ := Nat.exists_eq_add_of_le hu
  clear hu
  induction d with
  | zero => norm_num
  | succ d ih =>
    have h1 : 1 ≤ 2 ^ (2 + d) := Nat.one_le_pow _ _ (by omega)
    calc 2 + (d + 1) + 2 = (2 + d + 2) + 1 := by ring
      _ ≤ 2 ^ (2 + d) + 2 ^ (2 + d) := Nat.add_le_add ih h1
      _ = 2 * 2 ^ (2 + d) := by ring
      _ = 2 ^ (2 + (d + 1)) := by rw [← Nat.add_assoc, Nat.pow_succ, Nat.mul_comm]

private theorem sq_le_two_pow_of_ge4 (r : ℕ) (hr : 4 ≤ r) : r ^ 2 ≤ 2 ^ r := by
  obtain ⟨d, rfl⟩ := Nat.exists_eq_add_of_le hr
  clear hr
  induction d with
  | zero => norm_num
  | succ d ih =>
    have hstep : (4 + (d + 1)) ^ 2 ≤ 2 * (4 + d) ^ 2 := by
      have hlin : 2 * d + 9 ≤ (4 + d) ^ 2 := by
        have hexp : (4 + d) ^ 2 = d ^ 2 + 8 * d + 16 := by ring
        rw [hexp]
        omega
      calc (4 + (d + 1)) ^ 2 = (4 + d) ^ 2 + (2 * d + 9) := by ring
        _ ≤ (4 + d) ^ 2 + (4 + d) ^ 2 := Nat.add_le_add_left hlin _
        _ = 2 * (4 + d) ^ 2 := by ring
    calc (4 + (d + 1)) ^ 2 ≤ 2 * (4 + d) ^ 2 := hstep
      _ ≤ 2 * 2 ^ (4 + d) := Nat.mul_le_mul_left 2 ih
      _ = 2 ^ (4 + (d + 1)) := by rw [← Nat.add_assoc, Nat.pow_succ, Nat.mul_comm]

private theorem nat_log2_lt_of_lt_pow {x k : ℕ} (hk : 1 ≤ k) (hlt : x < 2 ^ k) :
    Nat.log 2 x < k := by
  rcases Nat.eq_zero_or_pos x with rfl | hx
  · simp; omega
  · by_contra hge
    have hkle : k ≤ Nat.log 2 x := Nat.le_of_not_lt hge
    have hpow : 2 ^ k ≤ x := (Nat.le_log_iff_pow_le (by omega) (by omega)).mp hkle
    omega

/-! ## 3. Ackermann & `alphaHierarchy` Consequences from `LemA1Type` -/

private theorem alpha0_le_of_le_ackermann (n k : ℕ) (hk : 1 ≤ k) (hn : n ≤ ackermann k 1) :
    alpha0 n ≤ k :=
  Nat.sInf_le ⟨hk, hn⟩

private theorem alpha0_four_le_two : alpha0 4 ≤ 2 := by
  apply alpha0_le_of_le_ackermann 4 2 (by omega)
  decide

private theorem alpha0_pos_of_A1 (hA : LemA1Type) (n : ℕ) (hn : 1 ≤ n) : 1 ≤ alpha0 n := by
  have hmono := hA.1.2.2.2.2.1 1 n le_rfl hn
  rw [hA.1.2.2.2.2.2.1] at hmono
  exact hmono

private theorem alpha0_iterate_pos_of_A1 (hA : LemA1Type) :
    ∀ (m n : ℕ), 1 ≤ n → 1 ≤ (alpha0^[m] n)
  | 0, n, hn => hn
  | m + 1, n, hn => by
    rw [Function.iterate_succ_apply]
    exact alpha0_iterate_pos_of_A1 hA m (alpha0 n) (alpha0_pos_of_A1 hA n hn)

private theorem alpha0_iterate_ackTower1_of_A1 (hA : LemA1Type) :
    ∀ (m n : ℕ), 1 ≤ n → n ≤ ackTower 1 (m + 1) → (alpha0^[m] n) ≤ 4
  | 0, n, _, hn => by
    simpa [ackTower] using hn
  | m + 1, n, hn1, hn => by
    rw [Function.iterate_succ_apply]
    have hK_pow : 2 ^ (m + 1) ≤ ackTower 1 (m + 1) := hA.2.1.1 1 (m + 1) (by omega)
    have hK_pos : 1 ≤ ackTower 1 (m + 1) :=
      le_trans (Nat.one_le_pow (m + 1) 2 (by omega)) hK_pow
    obtain ⟨k', hk'⟩ := Nat.exists_eq_succ_of_ne_zero (by omega : ackTower 1 (m + 1) ≠ 0)
    have hF : ackTower 1 (m + 2) = ackermann (ackTower 1 (m + 1)) 1 := by
      have hstep : ackTower 1 (m + 2) = ackTower 0 (ackTower 1 (m + 1)) := by simp [ackTower]
      rw [hstep, hk']
      simp [ackTower]
    rw [hF] at hn
    have ha0_le : alpha0 n ≤ ackTower 1 (m + 1) :=
      alpha0_le_of_le_ackermann n (ackTower 1 (m + 1)) hK_pos hn
    exact alpha0_iterate_ackTower1_of_A1 hA m (alpha0 n) (alpha0_pos_of_A1 hA n hn1) ha0_le

private theorem alphaHierarchy_pos : ∀ (q n : ℕ), 1 ≤ q → 1 ≤ alphaHierarchy q n
  | 0, _, hq => by omega
  | r' + 1, n, _ => by
    unfold alphaHierarchy
    rw [starIterate]
    split_ifs <;> omega

private theorem alphaHierarchy_step_gt4_of_A1 (hA : LemA1Type)
    (q n : ℕ) (hq : 2 ≤ q) (hn : 4 < n) :
    alphaHierarchy q n = 1 + alphaHierarchy q (alphaHierarchy (q - 1) n) := by
  obtain ⟨r', rfl⟩ : ∃ r', q = r' + 2 := ⟨q - 2, by omega⟩
  have hlt : alphaHierarchy (r' + 1) n < n := hA.alphaLt (r' + 1) n (by omega) hn
  have hnotle : ¬ (n ≤ 4) := by omega
  change starIterate (alphaHierarchy (r' + 1)) n =
    1 + starIterate (alphaHierarchy (r' + 1)) (alphaHierarchy (r' + 1) n)
  conv_lhs => rw [starIterate]
  simp [hnotle, hlt]

/-- Two-child double-exponential log collapse at height `q ≥ 2` (paper Lemma 6.1, L1138–1153). -/
private theorem pair_step_collapse_of_A1 (hA : LemA1Type)
    (q X0 X1 X2 : ℕ) (hq : 2 ≤ q)
    (hX0_gt4 : 4 < X0) (hX1_pos : 1 ≤ X1) (hX2_pos : 1 ≤ X2)
    (hs_gt : 2 ^ (36 ^ q) < alphaHierarchy (q - 1) X0)
    (hX1 : X1 ≤ (alphaHierarchy (q - 1) X0) ^ (6 ^ (q - 1)))
    (hX2 : X2 ≤ (alphaHierarchy (q - 1) X1) ^ (6 ^ (q - 1))) :
    alphaHierarchy q X2 + 1 ≤ alphaHierarchy q X0 := by
  set s := alphaHierarchy (q - 1) X0
  have h36_eq : 36 ^ q = 6 ^ (2 * q) := by
    calc 36 ^ q = (6 ^ 2) ^ q := rfl
      _ = 6 ^ (2 * q) := (Nat.pow_mul 6 2 q).symm
  have hs_ge_pow : 2 ^ (6 ^ (2 * q)) ≤ s := by
    rw [← h36_eq]; exact le_of_lt hs_gt
  have hs_pos : 1 ≤ s :=
    le_trans (Nat.one_le_pow _ 2 (by omega)) hs_ge_pow
  set t := Nat.log 2 s
  have ht_ge_6 : 6 ^ (2 * q) ≤ t :=
    (Nat.le_log_iff_pow_le (by omega) (by omega)).mpr hs_ge_pow
  have h2t_le_s : 2 ^ t ≤ s := Nat.pow_log_le_self 2 (by omega)
  have hs_lt_2t1 : s < 2 ^ (t + 1) := Nat.lt_pow_succ_log_self (by omega) s
  have h5q_le_6 : 2 ^ (5 * q) ≤ 6 ^ (2 * q) := by
    calc 2 ^ (5 * q) = (2 ^ 5) ^ q := Nat.pow_mul 2 5 q
      _ ≤ (6 ^ 2) ^ q := Nat.pow_le_pow_left (by norm_num) q
      _ = 6 ^ (2 * q) := (Nat.pow_mul 6 2 q).symm
  have ht_ge_2_5q : 2 ^ (5 * q) ≤ t := le_trans h5q_le_6 ht_ge_6
  have ht_pos : 1 ≤ t := le_trans (Nat.one_le_pow _ 2 (by omega)) ht_ge_2_5q
  set r_log := Nat.log 2 t
  have hr_ge_5q : 5 * q ≤ r_log :=
    (Nat.le_log_iff_pow_le (by omega) (by omega)).mpr ht_ge_2_5q
  have h2r_le_t : 2 ^ r_log ≤ t := Nat.pow_log_le_self 2 (by omega)
  have ht_lt_2r1 : t < 2 ^ (r_log + 1) := Nat.lt_pow_succ_log_self (by omega) t
  have hX1_tower : X1 ≤ 2 ^ (2 ^ (r_log + 3 * q)) := by
    have hs_2t : s ≤ 2 ^ (2 * t) :=
      le_trans (le_of_lt hs_lt_2t1) (Nat.pow_le_pow_right (by omega) (by omega))
    have hp1 : s ^ (6 ^ (q - 1)) ≤ 2 ^ (2 * t * 6 ^ (q - 1)) := by
      calc s ^ (6 ^ (q - 1)) ≤ (2 ^ (2 * t)) ^ (6 ^ (q - 1)) := Nat.pow_le_pow_left hs_2t _
        _ = 2 ^ (2 * t * 6 ^ (q - 1)) := (Nat.pow_mul 2 (2 * t) _).symm
    have h6_pow : 6 ^ (q - 1) ≤ 2 ^ (3 * (q - 1)) := by
      calc 6 ^ (q - 1) ≤ (2 ^ 3) ^ (q - 1) := Nat.pow_le_pow_left (by norm_num) _
        _ = 2 ^ (3 * (q - 1)) := (Nat.pow_mul 2 3 _).symm
    have h2t_pow : 2 * t ≤ 2 ^ (r_log + 2) := by
      have hpow : 2 ^ (r_log + 2) = 2 * 2 ^ (r_log + 1) := by
        rw [Nat.pow_succ, Nat.mul_comm]
      omega
    have hexp_le : 2 * t * 6 ^ (q - 1) ≤ 2 ^ (r_log + 3 * q) := by
      calc 2 * t * 6 ^ (q - 1)
          ≤ 2 ^ (r_log + 2) * 2 ^ (3 * (q - 1)) := Nat.mul_le_mul h2t_pow h6_pow
        _ = 2 ^ (r_log + 2 + 3 * (q - 1)) := (Nat.pow_add 2 _ _).symm
        _ ≤ 2 ^ (r_log + 3 * q) := Nat.pow_le_pow_right (by omega) (by omega)
    exact le_trans hX1 (le_trans hp1 (Nat.pow_le_pow_right (by omega) hexp_le))
  have ha1_X1 : alphaHierarchy (q - 1) X1 ≤ 2 * r_log := by
    set E := r_log + 3 * q
    have hE_ge4 : 4 ≤ E := by omega
    have h2E_ge16 : 16 ≤ 2 ^ E := by
      calc 16 = 2 ^ 4 := by norm_num
        _ ≤ 2 ^ E := Nat.pow_le_pow_right (by omega) hE_ge4
    have h16_lt_tower : 16 < 2 ^ (2 ^ E) := by
      calc 16 < 2 ^ 16 := by norm_num
        _ ≤ 2 ^ (2 ^ E) := Nat.pow_le_pow_right (by omega) h2E_ge16
    have hX1_16_lt : X1 + 16 < 2 ^ (2 ^ (E + 1)) := by
      have hlt1 : X1 + 16 < 2 * 2 ^ (2 ^ E) := by omega
      have heq1 : 2 * 2 ^ (2 ^ E) = 2 ^ (2 ^ E + 1) := by
        rw [Nat.pow_succ, Nat.mul_comm]
      have hle2 : 2 ^ E + 1 ≤ 2 ^ (E + 1) := by
        have hposE : 1 ≤ 2 ^ E := Nat.one_le_pow E 2 (by omega)
        have heqE : 2 ^ (E + 1) = 2 ^ E + 2 ^ E := by rw [Nat.pow_succ]; ring
        omega
      exact lt_of_lt_of_le (heq1 ▸ hlt1) (Nat.pow_le_pow_right (by omega) hle2)
    have hlog1 : Nat.log 2 (X1 + 16) < 2 ^ (E + 1) :=
      nat_log2_lt_of_lt_pow (Nat.one_le_pow _ 2 (by omega)) hX1_16_lt
    have hlog2 : Nat.log 2 (Nat.log 2 (X1 + 16)) < E + 1 :=
      nat_log2_lt_of_lt_pow (by omega) hlog1
    obtain ⟨h_anti, h_ll⟩ := hA.alphaLogLog (q - 1) X1 (by omega) hX1_pos
    omega
  set u := Nat.log 2 r_log
  have hr_ge8 : 2 ^ 3 ≤ r_log := by
    have : 2 ^ 3 = 8 := by norm_num
    omega
  have hu_ge3 : 3 ≤ u := (Nat.le_log_iff_pow_le (by omega) (by omega)).mpr hr_ge8
  have h2u_le_r : 2 ^ u ≤ r_log := Nat.pow_log_le_self 2 (by omega)
  have hr_lt_2u1 : r_log < 2 ^ (u + 1) := Nat.lt_pow_succ_log_self (by omega) r_log
  have h2r_2u2 : 2 * r_log ≤ 2 ^ (u + 2) := by
    have hpow : 2 ^ (u + 2) = 2 * 2 ^ (u + 1) := by rw [Nat.pow_succ, Nat.mul_comm]
    omega
  have hu2_le_r : u + 2 ≤ r_log :=
    le_trans (add_two_le_two_pow u (by omega)) h2u_le_r
  have hr_sq_le_t : r_log ^ 2 ≤ t :=
    le_trans (sq_le_two_pow_of_ge4 r_log (by omega)) h2r_le_t
  have hu2_sq_le_t : (u + 2) ^ 2 ≤ t :=
    le_trans (Nat.pow_le_pow_left hu2_le_r 2) hr_sq_le_t
  have h6_sq_le_t : (6 ^ (q - 1)) ^ 2 ≤ t := by
    have hid : 6 ^ (2 * q) = 36 * (6 ^ (q - 1)) ^ 2 := by
      have hq_eq : 2 * q = 2 + 2 * (q - 1) := by omega
      rw [hq_eq, Nat.pow_add, Nat.mul_comm 2 (q - 1), Nat.pow_mul]
    omega
  have hprod_le_t : (u + 2) * 6 ^ (q - 1) ≤ t := by
    have hsq : ((u + 2) * 6 ^ (q - 1)) ^ 2 ≤ t ^ 2 := by
      calc ((u + 2) * 6 ^ (q - 1)) ^ 2
          = (u + 2) ^ 2 * (6 ^ (q - 1)) ^ 2 := by ring
        _ ≤ t * t := Nat.mul_le_mul hu2_sq_le_t h6_sq_le_t
        _ = t ^ 2 := by ring
    by_contra hlt
    have hge : t + 1 ≤ (u + 2) * 6 ^ (q - 1) := by omega
    nlinarith
  have hX2_le_s : X2 ≤ s := by
    have ha_u : alphaHierarchy (q - 1) X1 ≤ 2 ^ (u + 2) := le_trans ha1_X1 h2r_2u2
    calc X2 ≤ (alphaHierarchy (q - 1) X1) ^ (6 ^ (q - 1)) := hX2
      _ ≤ (2 ^ (u + 2)) ^ (6 ^ (q - 1)) := Nat.pow_le_pow_left ha_u _
      _ = 2 ^ ((u + 2) * 6 ^ (q - 1)) := (Nat.pow_mul 2 (u + 2) _).symm
      _ ≤ 2 ^ t := Nat.pow_le_pow_right (by omega) hprod_le_t
      _ ≤ s := h2t_le_s
  have hstep : alphaHierarchy q X0 = 1 + alphaHierarchy q s :=
    alphaHierarchy_step_gt4_of_A1 hA q X0 hq hX0_gt4
  have hmono : alphaHierarchy q X2 ≤ alphaHierarchy q s :=
    hA.alphaMono q X2 s (by omega) hX2_pos hX2_le_s
  omega

/-! ## 4. Base Loop (`q = 1`) Structural & Contraction Analysis -/

private theorem buildScaleBaseLoop_spec (W : ℕ) (hW : 1 ≤ W) :
    ∀ (S_curr : ℕ), 1 ≤ S_curr →
      ∀ (c M_curr : ℕ) (accLeaves : List ScaleTree), 1 ≤ c →
        let res := buildScaleBaseLoop W c S_curr M_curr accLeaves
        ∃ (newLeaves : List ScaleTree) (S_seq : ℕ → ℕ),
          let L := newLeaves.length
          res.2.2 = M_curr + L ∧
          res.1 = (match accLeaves ++ newLeaves with
            | [] => none
            | cs => some (ScaleTree.internal cs)) ∧
          (∀ child ∈ newLeaves, child.AllInternalNonempty) ∧
          (ScaleTree.leafEntriesChildren c newLeaves).length = L ∧
          (∀ e ∈ ScaleTree.leafEntriesChildren c newLeaves, e.2.length = 1) ∧
          ValidScaleSteps W S_curr M_curr (ScaleTree.leafEntriesChildren c newLeaves) res.2.1 ∧
          S_seq 0 = S_curr ∧
          S_seq L = res.2.1 ∧
          (∀ j ≤ L, 1 ≤ S_seq j) ∧
          (∀ j < L,
            S_seq (j + 1) = 4 * (c + j) ^ 2 * W * (alpha0 (2 * S_seq j) + 1) ^ 2 ∧
            2 * S_seq (j + 1) ≤ S_seq j) ∧
          2 * res.2.1 < 16 * (c + L) ^ 2 * W * (alpha0 (2 * res.2.1) + 1) ^ 2 := by
  intro S_curr hS_init
  induction S_curr using Nat.strongRecOn with
  | ind S_curr ih =>
    intro c M_curr accLeaves hc
    dsimp only
    rw [SplayTree.buildScaleBaseLoop.eq_def]
    set w_cand := 4 * c ^ 2 * W
    set i_cand := alpha0 (2 * S_curr) + 1
    set S_cand := w_cand * i_cand ^ 2
    have hScand_pos : 1 ≤ S_cand := by
      have hw : 1 ≤ w_cand := by
        dsimp [w_cand]
        have hc2 : 1 ≤ c ^ 2 := Nat.one_le_pow 2 c hc
        nlinarith
      have hi : 1 ≤ i_cand ^ 2 := Nat.one_le_pow 2 i_cand (by omega)
      exact Nat.mul_le_mul hw hi
    dsimp only
    split_ifs with hguard
    · have hlt_S : S_cand < S_curr := by omega
      obtain ⟨newLeaves', S_seq', hM', hτ', hne', hlen', haddr', hsteps',
          hseq0', hseqL', hseqPos', hseqStep', hstop'⟩ :=
        ih S_cand hlt_S hScand_pos (c + 1) (M_curr + 1)
          (accLeaves ++ [ScaleTree.leaf (M_curr + 1)]) (by omega)
      set newLeaves := ScaleTree.leaf (M_curr + 1) :: newLeaves'
      let S_seq : ℕ → ℕ
        | 0 => S_curr
        | j + 1 => S_seq' j
      have happ : (accLeaves ++ [ScaleTree.leaf (M_curr + 1)]) ++ newLeaves' =
          accLeaves ++ newLeaves := by
        simp [newLeaves, List.append_assoc]
      have hlec : ScaleTree.leafEntriesChildren c newLeaves =
          (M_curr + 1, [c]) :: ScaleTree.leafEntriesChildren (c + 1) newLeaves' := by
        simp [newLeaves, ScaleTree.leafEntriesChildren, ScaleTree.leafEntries]
      refine ⟨newLeaves, S_seq, ?_, ?_, ?_, ?_, ?_, ?_, rfl, ?_, ?_, ?_, ?_⟩
      · simp only [newLeaves, List.length_cons]
        dsimp [S_cand] at hM' ⊢
        omega
      · rw [← happ]
        exact hτ'
      · intro child hmem
        simp only [newLeaves, List.mem_cons] at hmem
        rcases hmem with rfl | hmem'
        · simp [ScaleTree.AllInternalNonempty]
        · exact hne' child hmem'
      · rw [hlec]
        simp only [List.length_cons, newLeaves, hlen']
      · intro e he
        rw [hlec, List.mem_cons] at he
        rcases he with rfl | he'
        · rfl
        · exact haddr' e he'
      · rw [hlec]
        refine ValidScaleSteps.cons ?_ hScand_pos hguard.2 hsteps'
        have hpw : pathWeight [c] = 4 * c ^ 2 := by
          rw [pathWeight_cons]
          simp [pathWeight]
        rw [hpw]
        dsimp [S_cand, w_cand, i_cand]
        ring
      · simpa [newLeaves, S_seq] using hseqL'
      · intro j hj
        rcases j with _ | j'
        · exact hS_init
        · simp only [newLeaves, List.length_cons] at hj
          exact hseqPos' j' (by omega)
      · intro j hj
        simp only [newLeaves, List.length_cons] at hj
        rcases j with _ | j'
        · simp only [S_seq, Nat.add_zero]
          rw [hseq0']
          exact ⟨rfl, hguard.2⟩
        · simp only [S_seq]
          obtain ⟨hs1, hs2⟩ := hseqStep' j' (by omega)
          have hcj : c + (j' + 1) = c + 1 + j' := by omega
          rw [hcj]
          exact ⟨hs1, hs2⟩
      · simp only [newLeaves, List.length_cons]
        have hcL : c + (newLeaves'.length + 1) = c + 1 + newLeaves'.length := by omega
        rw [hcL]
        exact hstop'
    · have hnot2 : ¬ (2 * S_cand ≤ S_curr) := fun h2 => hguard ⟨hScand_pos, h2⟩
      refine ⟨[], fun _ => S_curr, ?_, ?_, ?_, ?_, ?_, ?_, rfl, ?_, ?_, ?_, ?_⟩
      · cases accLeaves <;> simp
      · simp only [List.append_nil]
        cases accLeaves <;> rfl
      · intro _ h; cases h
      · simp [ScaleTree.leafEntriesChildren]
      · intro _ h; simp [ScaleTree.leafEntriesChildren] at h
      · cases accLeaves <;>
          simpa [ScaleTree.leafEntriesChildren] using ValidScaleSteps.nil S_curr M_curr
      · cases accLeaves <;> rfl
      · intro _ _; exact hS_init
      · intro _ h; simp at h
      · have h4 : 4 * S_cand = 16 * c ^ 2 * W * (alpha0 (2 * S_curr) + 1) ^ 2 := by
          dsimp [S_cand, w_cand, i_cand]
          ring
        cases accLeaves <;> (simp only [List.length_nil, Nat.add_zero]; omega)

private theorem buildScaleBase_contraction_of_A1 (hA : LemA1Type)
    (W S_in M_in : ℕ) (hW : 1 ≤ W) (hSin : 1 ≤ S_in) :
    let res := buildScaleTreeAtQ 1 W S_in M_in
    let B := max W (max (alphaHierarchy 1 S_in) (2 ^ 36))
    2 * res.2.1 ≤ B ^ 6 := by
  dsimp only [buildScaleTreeAtQ]
  obtain ⟨newLeaves, S_seq, _, _, _, _, _, hsteps, hseq0, hseqL, hseqPos, hseqStep, hstop⟩ :=
    buildScaleBaseLoop_spec W hW S_in hSin 1 M_in [] le_rfl
  set res := buildScaleBaseLoop W 1 S_in M_in []
  set L := newLeaves.length
  set S_out := res.2.1
  set B := max W (max (alphaHierarchy 1 S_in) (2 ^ 36))
  have hW_B : W ≤ B := le_max_left _ _
  have ha1_B : alphaHierarchy 1 S_in ≤ B := le_trans (le_max_left _ _) (le_max_right _ _)
  have hC_B : 2 ^ 36 ≤ B := le_trans (le_max_right _ _) (le_max_right _ _)
  have hSout_bounds : 1 ≤ S_out ∧ S_out ≤ S_in := ValidScaleSteps.bounds hSin hsteps
  have h_anti_seq : ∀ b ≤ L, ∀ a ≤ b, S_seq b ≤ S_seq a := by
    intro b
    induction b with
    | zero =>
      intro _ a ha
      rw [show a = 0 by omega]
    | succ b ih =>
      intro hbL a hab
      by_cases heq : a = b + 1
      · subst heq; exact le_rfl
      · have hstep := (hseqStep b (by omega)).2
        have hih := ih (by omega) a (by omega)
        omega
  set Mstar := alphaHierarchy 1 (2 * S_in)
  have hMstar_pos : 1 ≤ Mstar := alphaHierarchy_pos 1 (2 * S_in) le_rfl
  have hMstar_le_B1 : Mstar ≤ B + 1 := by
    have hd' : alphaHierarchy 1 (2 * S_in) ≤ alphaHierarchy 1 S_in + 1 :=
      hA.alpha1Double S_in hSin
    omega
  by_cases hM1 : Mstar = 1
  · have h2Sin_le4 : 2 * S_in ≤ 4 := by
      have hle1 : alphaHierarchy 1 (2 * S_in) ≤ 1 := by omega
      have hF : 2 * S_in ≤ ackTower 1 1 :=
        (hA.alphaIff 1 1 (2 * S_in) le_rfl le_rfl (by omega)).mp hle1
      simpa [ackTower] using hF
    have h4_le : 4 ≤ B ^ 6 := by
      have : 4 ≤ (2 ^ 36) ^ 6 := by norm_num
      exact le_trans this (Nat.pow_le_pow_left hC_B 6)
    omega
  · have hM2 : 2 ≤ Mstar := by omega
    by_cases hCase : L < Mstar
    · -- Case 2 (`L ≤ M^* - 1`): stopped at `c = 1 + L ≤ M^* ≤ B + 1`.
      have hc_le : 1 + L ≤ B + 1 := by omega
      have hM_bound : 16 * (1 + L) ^ 2 * W ≤ B ^ 5 := by
        have hB64 : 64 ≤ B := le_trans (by norm_num : 64 ≤ 2 ^ 36) hC_B
        have hc2 : (1 + L) ^ 2 ≤ (2 * B) ^ 2 := Nat.pow_le_pow_left (by omega) 2
        calc 16 * (1 + L) ^ 2 * W
            ≤ 16 * (2 * B) ^ 2 * B :=
              Nat.mul_le_mul (Nat.mul_le_mul_left 16 hc2) hW_B
          _ = 64 * B ^ 3 := by ring
          _ ≤ B * B ^ 3 := Nat.mul_le_mul_right _ hB64
          _ = B ^ 4 * 1 := by ring
          _ ≤ B ^ 4 * B := Nat.mul_le_mul_left _ (by omega)
          _ = B ^ 5 := by ring
      have hlt6 : 2 * S_out < B ^ 6 :=
        w_lt_pow6_of_lt_mul_alpha0_sq (fun n hn => (hA.1.2.2.2.2.2.2.1 n hn).1)
          (2 * S_out) B (16 * (1 + L) ^ 2 * W) hC_B hM_bound hstop
      exact le_of_lt hlt6
    · -- Case 1 (`M^* ≤ L`): find `j < M^*` with `u_j ≤ max(W, j + 1, 4)`.
      have hML : Mstar ≤ L := Nat.le_of_not_lt hCase
      let uSeq : ℕ → ℕ := fun j => alpha0 (2 * S_seq j)
      let f : ℕ → ℕ := fun x => alpha0 x + 1
      have hA0Mono := hA.1.2.2.2.2.1
      have hu_pos : ∀ j ≤ L, 1 ≤ uSeq j := by
        intro j hj
        have hSj := hseqPos j hj
        exact alpha0_pos_of_A1 hA (2 * S_seq j) (by omega)
      have hf_pos : ∀ k u : ℕ, 1 ≤ u → 1 ≤ (f^[k] u) := by
        intro k
        induction k with
        | zero => intro u hu; exact hu
        | succ k ih =>
          intro u hu
          rw [Function.iterate_succ_apply']
          dsimp [f]
          omega
      have hf_mono : ∀ {a b : ℕ}, 1 ≤ a → a ≤ b → f a ≤ f b := by
        intro a b ha hab
        exact Nat.add_le_add_right (hA0Mono a b ha hab) 1
      have hu_step : ∀ j < L, max W (max (j + 1) 5) ≤ uSeq j → uSeq (j + 1) ≤ f (uSeq j) := by
        intro j hjL hj
        have hWj : W ≤ uSeq j := le_trans (le_max_left _ _) hj
        have hj1 : 1 + j ≤ uSeq j := by
          have : j + 1 ≤ uSeq j := le_trans (le_max_left _ _) (le_trans (le_max_right _ _) hj)
          omega
        have hj5 : 5 ≤ uSeq j := le_trans (le_max_right _ _) (le_trans (le_max_right _ _) hj)
        have hp_j : (1 + j) ^ 2 ≤ (uSeq j) ^ 2 := Nat.pow_le_pow_left hj1 2
        have hp_u : (uSeq j + 1) ^ 2 ≤ (2 * uSeq j) ^ 2 := Nat.pow_le_pow_left (by omega) 2
        have hmul : 2 * S_seq (j + 1) ≤ 2 ^ 20 * (uSeq j) ^ 6 := by
          have hs_eq := (hseqStep j hjL).1
          have h2s : 2 * S_seq (j + 1) = 8 * (1 + j) ^ 2 * W * (uSeq j + 1) ^ 2 := by
            rw [hs_eq]; dsimp [uSeq]; ring
          have hm1 : 8 * (1 + j) ^ 2 * W * (uSeq j + 1) ^ 2 ≤
              8 * (uSeq j) ^ 2 * uSeq j * (2 * uSeq j) ^ 2 :=
            Nat.mul_le_mul (Nat.mul_le_mul (Nat.mul_le_mul_left 8 hp_j) hWj) hp_u
          have hid : 8 * (uSeq j) ^ 2 * uSeq j * (2 * uSeq j) ^ 2 = 32 * (uSeq j) ^ 5 := by ring
          have h56 : (uSeq j) ^ 5 ≤ (uSeq j) ^ 6 := by
            calc (uSeq j) ^ 5 = (uSeq j) ^ 5 * 1 := by ring
              _ ≤ (uSeq j) ^ 5 * uSeq j := Nat.mul_le_mul_left _ (by omega)
              _ = (uSeq j) ^ 6 := by ring
          have hc32 : 32 * (uSeq j) ^ 5 ≤ 2 ^ 20 * (uSeq j) ^ 6 :=
            le_trans (Nat.mul_le_mul_left 32 h56) (Nat.mul_le_mul_right _ (by norm_num))
          omega
        have h2Sj1_pos : 1 ≤ 2 * S_seq (j + 1) := by
          have := hseqPos (j + 1) (by omega)
          omega
        exact le_trans (hA0Mono _ _ h2Sj1_pos hmul) (hA.2.2.2.2 (uSeq j) hj5)
      have hexists_small : ∃ c₀ : ℕ, c₀ < Mstar ∧ uSeq c₀ ≤ max W (max (c₀ + 1) 4) := by
        by_contra hno
        have h_all : ∀ j < Mstar, max W (max (j + 1) 5) ≤ uSeq j := by
          intro j hjM
          have hgt : max W (max (j + 1) 4) < uSeq j := by
            by_contra hle
            exact hno ⟨j, hjM, Nat.le_of_not_lt hle⟩
          have hW_lt : W < uSeq j := lt_of_le_of_lt (le_max_left _ _) hgt
          have hj1_lt : j + 1 < uSeq j :=
            lt_of_le_of_lt (le_trans (le_max_left _ _) (le_max_right _ _)) hgt
          have h4_lt : 4 < uSeq j :=
            lt_of_le_of_lt (le_trans (le_max_right _ _) (le_max_right _ _)) hgt
          exact max_le (by omega) (max_le (by omega) (by omega))
        set m := Mstar - 1
        have hm1 : 1 ≤ m := by omega
        have hm_eq : m + 1 = Mstar := by omega
        have hu_iter : ∀ k ≤ m, uSeq k ≤ (f^[k] (uSeq 0)) := by
          intro k
          induction k with
          | zero => intro _; simp
          | succ k ih =>
            intro hkm
            have hstep := hu_step k (by omega) (h_all k (by omega))
            have hih := ih (by omega)
            have hpos_uk : 1 ≤ uSeq k := hu_pos k (by omega)
            rw [Function.iterate_succ_apply']
            exact le_trans hstep (hf_mono hpos_uk hih)
        have hf_bound : (f^[m] (uSeq 0)) ≤ (alpha0^[m] (uSeq 0)) + 2 :=
          hA.2.2.2.1 m (uSeq 0) hm1 (hu_pos 0 (by omega))
        have h2Sin_F : 2 * S_in ≤ ackTower 1 (m + 1) := by
          have hleM : alphaHierarchy 1 (2 * S_in) ≤ m + 1 := by omega
          exact (hA.alphaIff 1 (m + 1) (2 * S_in) le_rfl (by omega) (by omega)).mp hleM
        have hiter4 : (alpha0^[m] (2 * S_in)) ≤ 4 :=
          alpha0_iterate_ackTower1_of_A1 hA m (2 * S_in) (by omega) h2Sin_F
        have hiter_pos : 1 ≤ (alpha0^[m] (2 * S_in)) :=
          alpha0_iterate_pos_of_A1 hA m (2 * S_in) (by omega)
        have hu0_eq : uSeq 0 = alpha0 (2 * S_in) := by
          dsimp [uSeq]; rw [hseq0]
        have hcomm : (alpha0^[m] (uSeq 0)) = alpha0 (alpha0^[m] (2 * S_in)) := by
          rw [hu0_eq, ← Function.iterate_succ_apply, Function.iterate_succ_apply']
        have ha0_iter_le2 : (alpha0^[m] (uSeq 0)) ≤ 2 := by
          rw [hcomm]
          exact le_trans (hA0Mono _ 4 hiter_pos hiter4) alpha0_four_le_two
        have hum_le4 : uSeq m ≤ 4 := le_trans (hu_iter m le_rfl) (by omega)
        have h5_le_um : 5 ≤ uSeq m :=
          le_trans (le_trans (le_max_right _ _) (le_max_right _ _)) (h_all m (by omega))
        omega
      obtain ⟨c₀, hc₀M, huc₀⟩ := hexists_small
      have hc₀L : c₀ < L := lt_of_lt_of_le hc₀M hML
      have hout_le : S_out ≤ S_seq (c₀ + 1) := by
        rw [← hseqL]
        exact h_anti_seq L le_rfl (c₀ + 1) (by omega)
      have hB128 : 128 ≤ B := le_trans (by norm_num : 128 ≤ 2 ^ 36) hC_B
      have hc₀_2B : 1 + c₀ ≤ 2 * B := by omega
      have hu_2B : uSeq c₀ + 1 ≤ 2 * B := by
        have hmax : max W (max (c₀ + 1) 4) ≤ B + 1 :=
          max_le (by omega) (max_le (by omega) (by omega))
        omega
      have hp_c : (1 + c₀) ^ 2 ≤ (2 * B) ^ 2 := Nat.pow_le_pow_left hc₀_2B 2
      have hp_u : (uSeq c₀ + 1) ^ 2 ≤ (2 * B) ^ 2 := Nat.pow_le_pow_left hu_2B 2
      have hs_eq := (hseqStep c₀ hc₀L).1
      have h2s : 2 * S_seq (c₀ + 1) ≤ 128 * B ^ 5 := by
        have hdef : 2 * S_seq (c₀ + 1) = 8 * (1 + c₀) ^ 2 * W * (uSeq c₀ + 1) ^ 2 := by
          rw [hs_eq]; dsimp [uSeq]; ring
        have hm := Nat.mul_le_mul (Nat.mul_le_mul (Nat.mul_le_mul_left 8 hp_c) hW_B) hp_u
        have hid : 8 * (2 * B) ^ 2 * B * (2 * B) ^ 2 = 128 * B ^ 5 := by ring
        omega
      have h128_B6 : 128 * B ^ 5 ≤ B ^ 6 := by
        calc 128 * B ^ 5 ≤ B * B ^ 5 := Nat.mul_le_mul_right _ hB128
          _ = B ^ 6 := by ring
      omega

/-! ## 5. Internal Loop (`q ≥ 2`) & Full Master Theorem for `buildScaleTreeAtQ` -/

/-- Combined inductive invariant of `buildScaleTreeAtQ q W S_in M_in` for `q ≥ 1`. -/
private def MasterAtQ (q : ℕ) : Prop :=
  ∀ (W S_in M_in : ℕ), 1 ≤ W → 1 ≤ S_in →
    let res := buildScaleTreeAtQ q W S_in M_in
    let τ? := res.1
    let S_out := res.2.1
    let M_out := res.2.2
    -- (1) Empty vs non-empty structural validity
    (match τ? with
      | none =>
        S_out = S_in ∧ M_out = M_in ∧
        2 * S_in < 4 ^ (q + 1) * W * (alpha0 (2 * S_in) + 1) ^ 2
      | some T =>
        M_in < M_out ∧
        T.AllInternalNonempty ∧
        T.leafEntries.length = M_out - M_in ∧
        (∀ e ∈ T.leafEntries, e.2.length = q) ∧
        ValidScaleSteps W S_in M_in T.leafEntries S_out) ∧
    -- (2) Scale bounds & degree-6 contraction
    1 ≤ S_out ∧ S_out ≤ S_in ∧
    2 * S_out ≤ (max W (max (alphaHierarchy q S_in) (2 ^ (36 ^ q)))) ^ (6 ^ q)

private theorem buildScaleInternalLoop_spec
    (qSub : ℕ) (_hqSub : 1 ≤ qSub) (hIH : MasterAtQ qSub)
    (W : ℕ) (hW : 1 ≤ W) :
    ∀ (num c S_curr M_curr : ℕ) (accChildren : List ScaleTree),
      1 ≤ c → 1 ≤ S_curr →
      let res := buildScaleInternalLoop (buildScaleTreeAtQ qSub) W S_curr M_curr accChildren
        (List.range' c num)
      ∃ (newChildren : List ScaleTree) (S_seq : ℕ → ℕ),
        let K := newChildren.length
        K ≤ num ∧
        res.1 = (match accChildren ++ newChildren with
          | [] => none
          | chs => some (ScaleTree.internal chs)) ∧
        (∀ child ∈ newChildren, child.AllInternalNonempty) ∧
        M_curr ≤ res.2.2 ∧
        (K = 0 → res.2.2 = M_curr ∧ res.2.1 = S_curr) ∧
        (0 < K → M_curr < res.2.2) ∧
        (ScaleTree.leafEntriesChildren c newChildren).length = res.2.2 - M_curr ∧
        (∀ e ∈ ScaleTree.leafEntriesChildren c newChildren, e.2.length = qSub + 1) ∧
        ValidScaleSteps W S_curr M_curr (ScaleTree.leafEntriesChildren c newChildren) res.2.1 ∧
        S_seq 0 = S_curr ∧
        S_seq K = res.2.1 ∧
        (∀ j ≤ K, 1 ≤ S_seq j) ∧
        (∀ j < K,
          S_seq (j + 1) ≤ S_seq j ∧
          2 * S_seq (j + 1) ≤
            (max (4 * (c + j) ^ 2 * W)
              (max (alphaHierarchy qSub (S_seq j)) (2 ^ (36 ^ qSub)))) ^ (6 ^ qSub)) ∧
        (K = num ∨
          (K < num ∧
            2 * res.2.1 <
              4 ^ (qSub + 1) * (4 * (c + K) ^ 2 * W) * (alpha0 (2 * res.2.1) + 1) ^ 2)) := by
  intro num
  induction num with
  | zero =>
    intro c S_curr M_curr accChildren _ hS
    simp only [List.range'_zero, buildScaleInternalLoop]
    refine ⟨[], fun _ => S_curr, le_rfl, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_,
      rfl, ?_, ?_, ?_, Or.inl rfl⟩
    · simp only [List.append_nil]
      cases accChildren <;> rfl
    · intro _ h; cases h
    · cases accChildren <;> exact le_rfl
    · intro _; cases accChildren <;> exact ⟨rfl, rfl⟩
    · intro h; simp at h
    · cases accChildren <;> simp [ScaleTree.leafEntriesChildren]
    · intro _ h; simp [ScaleTree.leafEntriesChildren] at h
    · cases accChildren <;>
        simpa [ScaleTree.leafEntriesChildren] using ValidScaleSteps.nil S_curr M_curr
    · cases accChildren <;> rfl
    · intro _ _; exact hS
    · intro _ h; simp at h
  | succ num ih =>
    intro c S_curr M_curr accChildren hc hS
    simp only [List.range'_succ, buildScaleInternalLoop]
    have hWc : 1 ≤ 4 * c ^ 2 * W := by
      have hc2 : 1 ≤ c ^ 2 := Nat.one_le_pow 2 c hc
      nlinarith
    have hChildSpec := hIH (4 * c ^ 2 * W) S_curr M_curr hWc hS
    rcases hChildEq : buildScaleTreeAtQ qSub (4 * c ^ 2 * W) S_curr M_curr with
      ⟨child?, S_next, M_next⟩
    simp only [hChildEq] at hChildSpec ⊢
    rcases child? with _ | child
    · -- Child returned `none`: loop stops immediately.
      dsimp only at hChildSpec ⊢
      obtain ⟨⟨hSn, hMn, hEmpty⟩, _, _, _⟩ := hChildSpec
      refine ⟨[], fun _ => S_curr, Nat.zero_le _, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_,
        rfl, ?_, ?_, ?_, Or.inr ⟨by simp, ?_⟩⟩
      · simp only [List.append_nil]
        cases accChildren <;> rfl
      · intro _ h; cases h
      · cases accChildren <;> exact le_rfl
      · intro _; cases accChildren <;> exact ⟨rfl, rfl⟩
      · intro h; simp at h
      · cases accChildren <;> simp [ScaleTree.leafEntriesChildren]
      · intro _ h; simp [ScaleTree.leafEntriesChildren] at h
      · cases accChildren <;>
          simpa [ScaleTree.leafEntriesChildren] using ValidScaleSteps.nil S_curr M_curr
      · cases accChildren <;> rfl
      · intro _ _; exact hS
      · intro _ h; simp at h
      · cases accChildren <;> simp only [List.length_nil, Nat.add_zero] <;> exact hEmpty
    · -- Child returned `some child`: recurse on `List.range' (c + 1) num`.
      dsimp only at hChildSpec ⊢
      obtain ⟨⟨hMlt, hChildNE, hChildLen, hChildAddr, hChildSteps⟩,
        hSn_pos, hSn_le, hSn_contr⟩ := hChildSpec
      obtain ⟨newChildren', S_seq', hK', hτ', hne', hMle', hK0', hKpos',
          hlen', haddr', hsteps', hseq0', hseqK', hseqPos', hseqStep', hstop'⟩ :=
        ih (c + 1) S_next M_next (accChildren ++ [child]) (by omega) hSn_pos
      set newChildren := child :: newChildren'
      let S_seq : ℕ → ℕ
        | 0 => S_curr
        | j + 1 => S_seq' j
      have happ : (accChildren ++ [child]) ++ newChildren' = accChildren ++ newChildren := by
        simp [newChildren, List.append_assoc]
      have hlec : ScaleTree.leafEntriesChildren c newChildren =
          (child.leafEntries.map (fun (s, rest) => (s, c :: rest))) ++
            ScaleTree.leafEntriesChildren (c + 1) newChildren' := rfl
      refine ⟨newChildren, S_seq, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_,
        rfl, ?_, ?_, ?_, ?_⟩
      · simp only [newChildren, List.length_cons]
        omega
      · rw [← happ]; exact hτ'
      · intro ch hmem
        simp only [newChildren, List.mem_cons] at hmem
        rcases hmem with rfl | hmem'
        · exact hChildNE
        · exact hne' ch hmem'
      · omega
      · intro h; simp [newChildren] at h
      · intro _; omega
      · rw [hlec, List.length_append, List.length_map, hChildLen, hlen']
        omega
      · intro e he
        rw [hlec, List.mem_append, List.mem_map] at he
        rcases he with ⟨⟨s, rest⟩, hmem, rfl⟩ | he'
        · simp only [List.length_cons]
          have hlen_sr : rest.length = qSub := hChildAddr (s, rest) hmem
          omega
        · exact haddr' e he'
      · rw [hlec]
        have h1 : ValidScaleSteps W S_curr M_curr
            (child.leafEntries.map (fun (s, rest) => (s, c :: rest))) S_next :=
          ValidScaleSteps.prepend_coord hChildSteps
        have hm_eq : M_curr + (child.leafEntries.map (fun (s, rest) => (s, c :: rest))).length =
            M_next := by
          rw [List.length_map, hChildLen]
          omega
        exact ValidScaleSteps.append h1 (hm_eq.symm ▸ hsteps')
      · simpa [newChildren, S_seq] using hseqK'
      · intro j hj
        rcases j with _ | j'
        · exact hS
        · simp only [newChildren, List.length_cons] at hj
          exact hseqPos' j' (by omega)
      · intro j hj
        simp only [newChildren, List.length_cons] at hj
        rcases j with _ | j'
        · simp only [S_seq, Nat.add_zero]
          rw [hseq0']
          exact ⟨hSn_le, hSn_contr⟩
        · simp only [S_seq]
          obtain ⟨hs1, hs2⟩ := hseqStep' j' (by omega)
          have hcj : c + (j' + 1) = c + 1 + j' := by omega
          rw [hcj]
          exact ⟨hs1, hs2⟩
      · simp only [newChildren, List.length_cons]
        rcases hstop' with hfull | ⟨hlt', hbound'⟩
        · left; omega
        · right
          refine ⟨by omega, ?_⟩
          have hcK : c + (newChildren'.length + 1) = c + 1 + newChildren'.length := by omega
          rw [hcK]
          exact hbound'

private theorem buildScaleTreeAtQ_master_of_A1 (hA : LemA1Type) :
    ∀ (q : ℕ), 1 ≤ q → MasterAtQ q := by
  intro q hq
  obtain ⟨d, rfl⟩ := Nat.exists_eq_add_of_le hq
  clear hq
  induction d with
  | zero =>
    -- Base case `q = 1`:
    intro W S_in M_in hW hSin
    have hContr := buildScaleBase_contraction_of_A1 hA W S_in M_in hW hSin
    dsimp only [buildScaleTreeAtQ] at hContr ⊢
    obtain ⟨newLeaves, _, hM, hτ, hne, hlen, haddr, hsteps, _, _, _, _, hstop⟩ :=
      buildScaleBaseLoop_spec W hW S_in hSin 1 M_in [] le_rfl
    set res := buildScaleBaseLoop W 1 S_in M_in []
    have hSout_bounds := ValidScaleSteps.bounds hSin hsteps
    refine ⟨?_, hSout_bounds.1, hSout_bounds.2, ?_⟩
    · simp only [List.nil_append] at hτ
      cases hnl : newLeaves with
      | nil =>
        simp only [hnl] at hτ hM hsteps hstop
        rw [hτ]
        have hSout_eq : res.2.1 = S_in := ValidScaleSteps.nil_eq (by simpa [ScaleTree.leafEntriesChildren] using hsteps)
        refine ⟨hSout_eq, ?_, ?_⟩
        · simp at hM; exact hM
        · simp only [List.length_nil, Nat.add_zero, one_pow, mul_one] at hstop
          rw [hSout_eq] at hstop
          have h16 : (4 : ℕ) ^ (1 + 1) = 16 := by norm_num
          rw [h16]
          exact hstop
      | cons first rest =>
        simp only [hnl] at hτ hM hlen
        rw [hτ]
        have hANE : (ScaleTree.internal (first :: rest)).AllInternalNonempty := by
          unfold ScaleTree.AllInternalNonempty
          exact ⟨by simp, fun ch hch => hne ch (hnl ▸ hch)⟩
        refine ⟨by simp at hM; omega, hANE, ?_, ?_, ?_⟩
        · change (ScaleTree.leafEntriesChildren 1 (first :: rest)).length = res.2.2 - M_in
          omega
        · intro e he
          exact haddr e (hnl ▸ he)
        · simpa [ScaleTree.leafEntries, hnl] using hsteps
    · simpa using hContr
  | succ d ih =>
    -- Inductive step `q = 1 + (d + 1) = d + 2 ≥ 2`:
    set qSub := d + 1
    have hqSub : 1 ≤ qSub := by omega
    have hqSubEq : 1 + d = qSub := by omega
    rw [hqSubEq] at ih
    set q := qSub + 1
    have hq2 : 2 ≤ q := by omega
    have hEqQ : 1 + (d + 1) = q := by omega
    rw [hEqQ]
    intro W S_in M_in hW hSin
    have hDef : buildScaleTreeAtQ q W S_in M_in =
        buildScaleInternalLoop (buildScaleTreeAtQ qSub) W S_in M_in []
          (List.range' 1 (2 * alphaHierarchy q S_in)) := rfl
    set mStar := alphaHierarchy q S_in
    have hmStar_pos : 1 ≤ mStar := alphaHierarchy_pos q S_in (by omega)
    obtain ⟨newChildren, S_seq, hK_le, hτ, hne, hMle, hK0, hKpos,
        hlen, haddr, hsteps, hseq0, hseqK, hseqPos, hseqStep, hstop⟩ :=
      buildScaleInternalLoop_spec qSub hqSub ih W hW (2 * mStar) 1 S_in M_in [] le_rfl hSin
    rw [hDef]
    set res := buildScaleInternalLoop (buildScaleTreeAtQ qSub) W S_in M_in []
      (List.range' 1 (2 * mStar))
    set K := newChildren.length
    set S_out := res.2.1
    set M_out := res.2.2
    have hSout_bounds := ValidScaleSteps.bounds hSin hsteps
    have hStruct :
        match res.1 with
        | none =>
          S_out = S_in ∧ M_out = M_in ∧
          2 * S_in < 4 ^ (q + 1) * W * (alpha0 (2 * S_in) + 1) ^ 2
        | some T =>
          M_in < M_out ∧
          T.AllInternalNonempty ∧
          T.leafEntries.length = M_out - M_in ∧
          (∀ e ∈ T.leafEntries, e.2.length = q) ∧
          ValidScaleSteps W S_in M_in T.leafEntries S_out := by
      simp only [List.nil_append] at hτ
      cases hnc : newChildren with
      | nil =>
        have hK_eq0 : K = 0 := by simp [K, hnc]
        obtain ⟨hM_eq, hS_eq⟩ := hK0 hK_eq0
        simp only [hnc] at hτ
        rw [hτ]
        refine ⟨hS_eq, hM_eq, ?_⟩
        rcases hstop with hfull | ⟨_, hbound⟩
        · omega
        · rw [hK_eq0, hS_eq] at hbound
          have hpow4 : 4 ^ (qSub + 1) * (4 * (1 + 0) ^ 2 * W) = 4 ^ (q + 1) * W := by
            have hq_succ : q + 1 = (qSub + 1) + 1 := rfl
            rw [hq_succ, Nat.pow_succ]
            ring
          rw [hpow4] at hbound
          exact hbound
      | cons first rest =>
        have hK_gt0 : 0 < K := by simp [K, hnc]
        have hM_lt : M_in < M_out := hKpos hK_gt0
        simp only [hnc] at hτ
        rw [hτ]
        have hANE : (ScaleTree.internal (first :: rest)).AllInternalNonempty := by
          unfold ScaleTree.AllInternalNonempty
          exact ⟨by simp, fun ch hch => hne ch (hnc ▸ hch)⟩
        refine ⟨hM_lt, hANE, ?_, ?_, ?_⟩
        · simpa [ScaleTree.leafEntries, hnc] using hlen
        · intro e he
          exact haddr e (hnc ▸ he)
        · simpa [ScaleTree.leafEntries, hnc] using hsteps
    refine ⟨hStruct, hSout_bounds.1, hSout_bounds.2, ?_⟩
    -- Degree-6 contraction at `q ≥ 2`:
    set C_q := 2 ^ (36 ^ q)
    set U := max W (max mStar C_q)
    have hW_U : W ≤ U := le_max_left _ _
    have hm_U : mStar ≤ U := le_trans (le_max_left _ _) (le_max_right _ _)
    have hCq_U : C_q ≤ U := le_trans (le_max_right _ _) (le_max_right _ _)
    have h36_ge : 36 ≤ 36 ^ q := by
      calc 36 = 36 * 1 := by ring
        _ ≤ 36 * q := Nat.mul_le_mul_left 36 (by omega)
        _ ≤ 36 ^ q := mul_36_le_pow q (by omega)
    have h2_36_U : 2 ^ 36 ≤ U :=
      le_trans (Nat.pow_le_pow_right (by omega) h36_ge) hCq_U
    have hU_pos : 1 ≤ U := le_trans (by norm_num : 1 ≤ 2 ^ 36) h2_36_U
    have h6_le_6q : 6 ≤ 6 ^ q := by
      calc 6 = 6 ^ 1 := by norm_num
        _ ≤ 6 ^ q := Nat.pow_le_pow_right (by omega) (by omega)
    by_cases hm1 : mStar = 1
    · -- Subcase `m^* = 1`: `S_in ≤ ackTower q 1 = 4`, so `2 * S_out ≤ 8 ≤ U^(6^q)`.
      have hSin_le4 : S_in ≤ 4 := by
        have hle1 : alphaHierarchy q S_in ≤ 1 := by omega
        have hF : S_in ≤ ackTower q 1 :=
          (hA.alphaIff q 1 S_in (by omega) le_rfl hSin).mp hle1
        have hFq1 : ackTower q 1 = 4 := ackTower_one q (by omega)
        omega
      have h8_U : 8 ≤ U ^ (6 ^ q) := by
        have h8 : 8 ≤ 2 ^ 36 := by norm_num
        exact le_trans (le_trans h8 h2_36_U) (Nat.le_self_pow (by omega) U)
      omega
    · have hm2 : 2 ≤ mStar := by omega
      rcases hstop with hfull | ⟨hlt_num, hearly⟩
      · -- Full-run case: `K = 2 * mStar`, all children returned `some`.
        set M_floor := max (16 * W * mStar ^ 2) C_q
        have hMfloor_U6 : M_floor ≤ U ^ 6 := by
          apply max_le
          · have h16_U : 16 ≤ U := le_trans (by norm_num : 16 ≤ 2 ^ 36) h2_36_U
            have hm2_U : mStar ^ 2 ≤ U ^ 2 := Nat.pow_le_pow_left hm_U 2
            calc 16 * W * mStar ^ 2
                ≤ U * U * U ^ 2 := Nat.mul_le_mul (Nat.mul_le_mul h16_U hW_U) hm2_U
              _ = U ^ 4 * 1 := by ring
              _ ≤ U ^ 4 * U ^ 2 := Nat.mul_le_mul_left _ (Nat.one_le_pow 2 U hU_pos)
              _ = U ^ 6 := by ring
          · exact le_trans hCq_U (Nat.le_self_pow (by omega) U)
        have hMfloor_pow : M_floor ^ (6 ^ qSub) ≤ U ^ (6 ^ q) := by
          calc M_floor ^ (6 ^ qSub)
              ≤ (U ^ 6) ^ (6 ^ qSub) := Nat.pow_le_pow_left hMfloor_U6 _
            _ = U ^ (6 * 6 ^ qSub) := (Nat.pow_mul U 6 _).symm
            _ = U ^ (6 ^ q) := by
              congr 1
              calc 6 * 6 ^ qSub = 6 ^ qSub * 6 := Nat.mul_comm _ _
                _ = 6 ^ (qSub + 1) := (Nat.pow_succ 6 qSub).symm
        suffices hgoal : 2 * S_out ≤ M_floor ^ (6 ^ qSub) from le_trans hgoal hMfloor_pow
        by_contra hgt_out
        have hgt : M_floor ^ (6 ^ qSub) < 2 * S_out := Nat.lt_of_not_le hgt_out
        have h_anti : ∀ b ≤ K, ∀ a ≤ b, S_seq b ≤ S_seq a := by
          intro b
          induction b with
          | zero => intro _ a ha; rw [show a = 0 by omega]
          | succ b ih_b =>
            intro hbK a hab
            by_cases heq : a = b + 1
            · subst heq; exact le_rfl
            · have hs := (hseqStep b (by omega)).1
              have hih := ih_b (by omega) a (by omega)
              omega
        have hSk_large : ∀ k ≤ 2 * mStar, M_floor ^ (6 ^ qSub) < 2 * S_seq k ∧ 4 < S_seq k := by
          intro k hk
          have hkK : k ≤ K := by omega
          have hle_k : S_out ≤ S_seq k := by
            rw [← hseqK]
            exact h_anti K le_rfl k hkK
          have h1 : M_floor ^ (6 ^ qSub) < 2 * S_seq k := lt_of_lt_of_le hgt (by omega)
          have hMf_ge : 2 ^ 36 ≤ M_floor :=
            le_trans (Nat.pow_le_pow_right (by omega) h36_ge) (le_max_right _ _)
          have hpow_ge : M_floor ≤ M_floor ^ (6 ^ qSub) :=
            Nat.le_self_pow (by positivity) M_floor
          have h9 : 9 ≤ M_floor ^ (6 ^ qSub) :=
