            max_eq_right (le_of_lt ha_gt)
          rw [hmax_eq_a] at h2Sk1_le
          exact ⟨lt_of_le_of_lt (le_max_right _ _) ha_gt, h2Sk1_le⟩
        have hPairIter : ∀ j ≤ mStar - 1,
            alphaHierarchy q (S_seq (2 * j)) + j ≤ mStar := by
          intro j
          induction j with
          | zero =>
            intro _
            simp only [Nat.mul_zero, Nat.add_zero, hseq0]
